@model AashanaFashion.Models.Pricelist
@{
    ViewData["Title"] = $"Pricelist: {Model.Name}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Pricelists</a>
        <h1 class="page-title d-flex align-items-center gap-2">
            @Model.Name
            <span class="af-badge @(Model.IsActive ? "b-green" : "b-gray")">@(Model.IsActive ? "Active" : "Inactive")</span>
        </h1>
        <p class="page-sub">Created on @Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <div class="page-actions">
        <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary">
                <i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i> @(Model.IsActive ? "Deactivate" : "Activate")
            </button>
        </form>
        @if (Model.Customers.Count == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this pricelist?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger-ghost"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit Pricelist</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Price rules</div>
        <div class="metric-value">@Model.Items.Count</div>
        <div class="metric-meta">evaluated by specificity</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Assigned customers</div>
        <div class="metric-value">@Model.Customers.Count</div>
        <div class="metric-meta info">via Customer Master</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Currency</div>
        <div class="metric-value">@Model.Currency</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Overview</span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-ghost"><i class="bi bi-pencil"></i> Edit</a>
            </div>
            <div class="data-card-body">
                <div class="info-grid" style="grid-template-columns: minmax(0, 1fr);">
                    <div class="info-item">
                        <div class="info-label">Status</div>
                        <span class="af-badge @(Model.IsActive ? "b-green" : "b-gray")">@(Model.IsActive ? "Active" : "Inactive")</span>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Discount policy</div>
                        @if (Model.DiscountPolicy == AashanaFashion.Models.PricelistDiscountPolicy.DiscountIncluded)
                        {
                            <span class="af-badge b-blue">Discount included in price</span>
                        }
                        else
                        {
                            <span class="af-badge b-purple">Show public price &amp; discount to customer</span>
                        }
                    </div>
                    <div class="info-item">
                        <div class="info-label">Description</div>
                        <div class="info-value @(string.IsNullOrWhiteSpace(Model.Description) ? "muted" : "")">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="table-card mb-4">
            <div class="data-card-header">
                <span class="data-card-title">Price calculation rules <span class="count-pill">@Model.Items.Count</span></span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary"><i class="bi bi-sliders"></i> Manage rules</a>
            </div>
            @if (Model.Items.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Applied On</th>
                                <th>Target</th>
                                <th class="text-end">Min Qty</th>
                                <th>Computation</th>
                                <th>Validity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int idx = 1; }
                            @foreach (var rule in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted">@idx</td>
                                    <td>
                                        @switch (rule.AppliedOn)
                                        {
                                            case AashanaFashion.Models.PricelistAppliedOn.Product:
                                                <span class="af-badge b-indigo">Product / Design</span>
                                                break;
                                            case AashanaFashion.Models.PricelistAppliedOn.Category:
                                                <span class="af-badge b-blue">Category</span>
                                                break;
                                            default:
                                                <span class="af-badge b-gray">All Products</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (rule.AppliedOn == AashanaFashion.Models.PricelistAppliedOn.Product && rule.Design != null)
                                        {
                                            <a asp-controller="Design" asp-action="Details" asp-route-id="@rule.DesignId" class="cell-title text-reset">@rule.Design.DesignNumber</a>
                                            <span class="cell-sub">Base ₹@rule.Design.SalesPrice.ToString("N2")</span>
                                        }
                                        else if (rule.AppliedOn == AashanaFashion.Models.PricelistAppliedOn.Category && !string.IsNullOrEmpty(rule.Category))
                                        {
                                            <span class="cell-title">@rule.Category</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Global (all inventory)</span>
                                        }
                                    </td>
                                    <td class="cell-num">@rule.MinQuantity.ToString("N0") pcs</td>
                                    <td>
                                        @switch (rule.ComputationMethod)
                                        {
                                            case AashanaFashion.Models.PricelistComputeMethod.FixedPrice:
                                                <span class="text-foreground fw-medium">Fixed ₹@((rule.FixedPrice ?? 0m).ToString("N2"))</span>
                                                break;
                                            case AashanaFashion.Models.PricelistComputeMethod.Percentage:
                                                <span class="text-foreground fw-medium">@((rule.DiscountPercentage ?? 0m).ToString("N1"))% discount</span>
                                                break;
                                            case AashanaFashion.Models.PricelistComputeMethod.Formula:
                                                <span class="text-foreground fw-medium">−@((rule.DiscountPercentage ?? 0m).ToString("N1"))% + ₹@((rule.Surcharge ?? 0m).ToString("N2"))</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-xs">
                                        @if (rule.StartDate.HasValue || rule.EndDate.HasValue)
                                        {
                                            <span>@(rule.StartDate?.ToString("dd/MM/yyyy") ?? "Any") → @(rule.EndDate?.ToString("dd/MM/yyyy") ?? "Any")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Always valid</span>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-5">
                    <div class="es-icon"><i class="bi bi-sliders"></i></div>
                    <div class="es-title">No rules configured</div>
                    <p>Default design prices apply until you add a rule.</p>
                </div>
            }
        </div>

        <div class="table-card">
            <div class="data-card-header">
                <span class="data-card-title">Assigned customers <span class="count-pill">@Model.Customers.Count</span></span>
            </div>
            @if (Model.Customers.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>City / State</th>
                                <th>GSTIN</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Customers)
                            {
                                <tr>
                                    <td>
                                        <span class="cell-title">@c.CustomerName</span>
                                        @if (!string.IsNullOrEmpty(c.CustomerCompany))
                                        {
                                            <span class="cell-sub">@c.CustomerCompany</span>
                                        }
                                    </td>
                                    <td>@(c.City ?? "—"), @(c.State ?? "—")</td>
                                    <td><span class="font-monospace text-xs">@(c.GstNumber ?? "Unregistered")</span></td>
                                    <td class="cell-actions">
                                        <a asp-controller="Customer" asp-action="Edit" asp-route-id="@c.Id" class="row-action" title="Edit customer" aria-label="Edit customer"><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-5">
                    <div class="es-icon"><i class="bi bi-people"></i></div>
                    <div class="es-title">No customers assigned</div>
                    <p>Assign this pricelist to customers from Customer Master.</p>
                </div>
            }
        </div>
    </div>
</div>
