@model IEnumerable<AashanaFashion.Models.Pricelist>
@{
    ViewData["Title"] = "Pricelist Master";
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ActiveOnly == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Pricelist Master</h1>
        <p class="page-sub">Manage customer pricing rules, volume-tiered rates, and wholesale discount structures.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Pricelist</a>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search by name or description…" value="@ViewBag.Search" />
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeFilter" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label" for="activeFilter">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 28%;">Pricelist</th>
                        <th>Currency</th>
                        <th>Discount Policy</th>
                        <th class="text-center">Rules</th>
                        <th class="text-center">Customers</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pl in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@pl.Id" class="cell-title text-reset">@pl.Name</a>
                                @if (!string.IsNullOrEmpty(pl.Description))
                                {
                                    <span class="cell-sub text-truncate" style="max-width: 320px;">@pl.Description</span>
                                }
                            </td>
                            <td><span class="mono-id">@pl.Currency</span></td>
                            <td>
                                @if (pl.DiscountPolicy == AashanaFashion.Models.PricelistDiscountPolicy.DiscountIncluded)
                                {
                                    <span class="af-badge b-blue">Included in price</span>
                                }
                                else
                                {
                                    <span class="af-badge b-purple">Shown to customer</span>
                                }
                            </td>
                            <td class="text-center"><span class="count-pill">@pl.Items.Count</span></td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@pl.Id" class="count-pill @(pl.Customers.Count > 0 ? "text-primary" : "")" title="View assigned customers">@pl.Customers.Count</a>
                            </td>
                            <td>
                                <span class="af-badge @(pl.IsActive ? "b-green" : "b-gray")">@(pl.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@pl.Id" class="row-action" title="View details &amp; rules" aria-label="View details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@pl.Id" class="row-action" title="Edit pricelist" aria-label="Edit pricelist"><i class="bi bi-pencil"></i></a>
                                    <div class="dropdown">
                                        <button class="row-action" type="button" data-bs-toggle="dropdown" aria-label="More actions"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-action="ToggleActive" asp-route-id="@pl.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="bi @(pl.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i> @(pl.IsActive ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>
                                            </li>
                                            @if (pl.Customers.Count == 0)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@pl.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this pricelist?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "pricelist" : "pricelists")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-tags")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No pricelists yet")</div>
            <p>@(filtered ? "No pricelists match your search." : "Create your first custom pricelist to offer special discounts to customers.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-secondary">New Pricelist</a>
            }
        </div>
    }
</div>
