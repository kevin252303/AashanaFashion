@model AashanaFashion.Models.Employee
@{
    ViewData["Title"] = $"Enroll Face — {Model.FullName}";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
                <li class="breadcrumb-item"><a asp-action="Edit" asp-route-id="@Model.Id">@Model.FullName</a></li>
                <li class="breadcrumb-item active">Face enrollment</li>
            </ol>
        </nav>
        <h1 class="page-title">Biometric Face Enrollment</h1>
        <p class="page-sub">Capture and register a face embedding for automatic floor attendance.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Camera & Detection Viewport -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Live Camera Feed</h5>
                <span id="detectionStatusBadge" class="badge bg-secondary">Camera Offline</span>
            </div>
            <div class="card-body text-center">
                <!-- Video Container -->
                <div class="position-relative d-inline-block bg-dark rounded-3 overflow-hidden shadow-inner" style="min-width: 320px; max-width: 100%; min-height: 360px;">
                    <video id="webcamVideo" autoplay muted playsinline style="width: 100%; max-width: 520px; height: auto; transform: scaleX(-1); display: none;"></video>
                    <canvas id="overlayCanvas" class="position-absolute top-0 start-0" style="width: 100%; height: 100%; transform: scaleX(-1);"></canvas>
                    
                    <!-- Placeholder before camera starts -->
                    <div id="cameraPlaceholder" class="p-5 text-white d-flex flex-column align-items-center justify-content-center" style="min-height: 360px;">
                        <div class="mb-3" style="font-size: 32px; opacity: .6;"><i class="bi bi-camera-video"></i></div>
                        <div class="fw-semibold mb-1">Camera is stopped</div>
                        <p class="text-white-50 text-sm mb-4">Start the camera to activate face detection.</p>
                        <button type="button" id="btnStartCamera" class="btn btn-primary">
                            <i class="bi bi-camera-video"></i> Start camera
                        </button>
                    </div>

                    <!-- Target Face Guide Oval -->
                    <div id="faceGuide" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle d-none pointer-events-none" 
                         style="width: 220px; height: 270px; opacity: 0.6; box-shadow: 0 0 20px rgba(79,70,229,0.4); pointer-events: none;">
                    </div>
                </div>

                <!-- Controls -->
                <div class="mt-3 d-flex justify-content-center gap-2">
                    <button type="button" id="btnCaptureFace" class="btn btn-primary" disabled>
                        <i class="bi bi-person-bounding-box"></i> Capture &amp; register face
                    </button>
                    <button type="button" id="btnStopCamera" class="btn btn-secondary" style="display: none;">
                        Stop camera
                    </button>
                </div>

                <div class="mt-3">
                    <div class="text-sm text-muted" id="statusMessage">
                        Initializing neural models... Please wait.
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row align-items-end g-2">
                    <div class="col-sm-7">
                        <label class="form-label" for="filePhotoInput">Or upload a face photo</label>
                        <input type="file" id="filePhotoInput" accept="image/*" class="form-control" />
                    </div>
                    <div class="col-sm-5 text-sm-end">
                        <small class="form-text">Make sure the face is well lit and looking straight at the camera.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Employee Information & Result Card -->
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Employee Details</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div id="photoPreviewContainer">
                        @if (!string.IsNullOrEmpty(Model.FacePhotoPath))
                        {
                            <img id="currentFacePhoto" src="@Model.FacePhotoPath" alt="@Model.FullName" class="rounded-circle border shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <div id="currentFacePlaceholder" class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted fs-2" style="width: 70px; height: 70px;">
                                </div>
                        }
                    </div>
                    <div>
                        <div class="ql-title">@Model.FullName</div>
                        <span class="mono-id">@Model.EmployeeCode</span>
                        <div class="text-xs text-muted mt-1">@Model.Department · @Model.Designation</div>
                    </div>
                </div>

                <hr />

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="info-label">Registration status</div>
                        <div>
                            @if (Model.IsFaceRegistered)
                            {
                                <span id="regStatusBadge" class="badge bg-success">Registered</span>
                            }
                            else
                            {
                                <span id="regStatusBadge" class="badge bg-warning text-dark">Pending</span>
                            }
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="info-label">Salary type</div>
                        <div class="info-value">@Model.SalaryType.Humanize()</div>
                    </div>
                </div>

                <!-- Last Detected Information -->
                <div class="panel-inset">
                    <div class="micro-label">Live detection status</div>
                    <div class="kv-row"><span class="k">Face detected</span><span id="dispFaceDetected" class="fw-semibold text-danger">No</span></div>
                    <div class="kv-row"><span class="k">Detection score</span><span id="dispDetectScore" class="fw-semibold">—</span></div>
                    <div class="kv-row"><span class="k">Feature embedding</span><span id="dispVectorStatus" class="text-xs font-monospace text-muted">Pending</span></div>
                </div>

                <!-- Success Alert (Hidden initially) -->
                <div id="enrollSuccessAlert" class="alert alert-success d-none mb-3" role="alert">
                    <span class="alert-title">Face profile saved</span>
                    <p class="text-sm mb-2" id="enrollSuccessMsg">Face descriptor registered successfully.</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="Attendance" asp-action="Kiosk" class="btn btn-sm btn-secondary">Test in face kiosk</a>
                        <a asp-action="Index" class="btn btn-sm btn-ghost">Employee list</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- face-api.js neural network library -->
    <script src="https://cdn.jsdelivr.net/npm/@@vladmandic/face-api@1.7.12/dist/face-api.js"></script>
    <script src="~/js/face-attendance.js"></script>

    <script>
        const employeeId = @Model.Id;
        const video = document.getElementById('webcamVideo');
        const canvas = document.getElementById('overlayCanvas');
        const placeholder = document.getElementById('cameraPlaceholder');
        const faceGuide = document.getElementById('faceGuide');
        const btnStart = document.getElementById('btnStartCamera');
        const btnStop = document.getElementById('btnStopCamera');
        const btnCapture = document.getElementById('btnCaptureFace');
        const statusMsg = document.getElementById('statusMessage');
        const statusBadge = document.getElementById('detectionStatusBadge');
        
        let detectionInterval = null;
        let lastDetection = null;

        // 1. Initialize Models
        $(document).ready(async function () {
            statusMsg.textContent = 'Loading neural network models...';
            const loaded = await FaceAttendanceEngine.loadModels((msg) => {
                statusMsg.textContent = msg;
            });
            if (loaded) {
                statusMsg.textContent = 'Models ready. Click "Start Camera" to begin.';
                btnStart.disabled = false;
            } else {
                statusMsg.innerHTML = '<span class="text-danger">Failed to load models. Check network connection.</span>';
            }
        });

        // 2. Start Camera
        async function startCameraStream() {
            try {
                statusMsg.textContent = 'Starting camera...';
                await FaceAttendanceEngine.startCamera(video);
                
                video.style.display = 'block';
                placeholder.style.display = 'none';
                faceGuide.classList.remove('d-none');
                btnStop.style.display = 'inline-block';
                btnStart.style.display = 'none';
                
                statusBadge.className = 'badge bg-success';
                statusBadge.textContent = 'Camera Active';

                // Size overlay canvas to video
                canvas.width = video.videoWidth || 640;
                canvas.height = video.videoHeight || 480;

                // Start detection loop
                startDetectionLoop();
            } catch (err) {
                alert('Could not start camera: ' + err.message);
                statusBadge.className = 'badge bg-danger';
                statusBadge.textContent = 'Camera Error';
            }
        }

        btnStart.addEventListener('click', startCameraStream);

        // 3. Stop Camera
        btnStop.addEventListener('click', function () {
            if (detectionInterval) clearInterval(detectionInterval);
            FaceAttendanceEngine.stopCamera(video);
            video.style.display = 'none';
            placeholder.style.display = 'flex';
            faceGuide.classList.add('d-none');
            btnStop.style.display = 'none';
            btnStart.style.display = 'inline-block';
            btnCapture.disabled = true;
            statusBadge.className = 'badge bg-secondary';
            statusBadge.textContent = 'Camera Offline';
            
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        });

        // 4. Detection Loop
        function startDetectionLoop() {
            if (detectionInterval) clearInterval(detectionInterval);
            
            detectionInterval = setInterval(async () => {
                if (video.paused || video.ended || !FaceAttendanceEngine.modelsLoaded) return;

                const detection = await FaceAttendanceEngine.detectFace(video);
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                if (detection) {
                    lastDetection = detection;
                    const dims = { width: canvas.width, height: canvas.height };
                    const resizedDetection = faceapi.resizeResults(detection, dims);
                    
                    // Draw bounding box
                    faceapi.draw.drawDetections(canvas, resizedDetection);
                    faceapi.draw.drawFaceLandmarks(canvas, resizedDetection);

                    const score = Math.round(detection.detection.score * 100);
                    $('#dispFaceDetected').text('Yes').removeClass('text-danger').addClass('text-success');
                    $('#dispDetectScore').text(score + '%');
                    $('#dispVectorStatus').text('128-D Vector Ready').removeClass('text-muted').addClass('text-primary fw-bold');
                    
                    btnCapture.disabled = false;
                    statusMsg.innerHTML = '<span class="text-success fw-bold">Face detected cleanly! Click "Capture & Register Face".</span>';
                } else {
                    lastDetection = null;
                    $('#dispFaceDetected').text('Looking...').removeClass('text-success').addClass('text-warning');
                    $('#dispDetectScore').text('—');
                    $('#dispVectorStatus').text('Waiting for face').removeClass('text-primary fw-bold').addClass('text-muted');
                    btnCapture.disabled = true;
                    statusMsg.textContent = 'Align face inside the guide frame.';
                }
            }, 300);
        }

        // 5. Capture & Send to Server
        btnCapture.addEventListener('click', async function () {
            if (!lastDetection || !lastDetection.descriptor) {
                alert('No face detected. Please face the camera directly.');
                return;
            }

            btnCapture.disabled = true;
            statusMsg.textContent = 'Saving face profile...';

            const descriptorArray = Array.from(lastDetection.descriptor);
            const snapshot = FaceAttendanceEngine.captureSnapshot(video);

            const payload = {
                employeeId: employeeId,
                faceDescriptor: JSON.stringify(descriptorArray),
                faceImageBase64: snapshot
            };

            try {
                const response = await fetch('@Url.Action("SaveFaceData", "Employee")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const res = await response.json();

                if (res.success) {
                    FaceAttendanceEngine.playSuccessSound();
                    $('#regStatusBadge').removeClass('bg-warning text-dark').addClass('bg-success').text('Registered');
                    $('#enrollSuccessMsg').text(res.message);
                    $('#enrollSuccessAlert').removeClass('d-none');
                    statusMsg.innerHTML = '<span class="text-success fw-bold">Face registered successfully!</span>';

                    // Update photo preview
                    if (res.photoPath) {
                        $('#photoPreviewContainer').html(`<img src="${res.photoPath}?t=${Date.now()}" class="rounded-circle border shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />`);
                    }
                } else {
                    FaceAttendanceEngine.playErrorSound();
                    alert('Error: ' + res.message);
                    btnCapture.disabled = false;
                }
            } catch (err) {
                FaceAttendanceEngine.playErrorSound();
                alert('Network error while saving face profile: ' + err.message);
                btnCapture.disabled = false;
            }
        });

        // 6. Optional Photo File Upload Fallback
        $('#filePhotoInput').on('change', async function (e) {
            const file = e.target.files[0];
            if (!file) return;

            statusMsg.textContent = 'Processing uploaded photo...';
            const img = await faceapi.bufferToImage(file);
            const detection = await faceapi.detectSingleFace(img, new faceapi.TinyFaceDetectorOptions({ scoreThreshold: 0.5 }))
                .withFaceLandmarks()
                .withFaceDescriptor();

            if (!detection) {
                FaceAttendanceEngine.playErrorSound();
                alert('Could not find a clear face in the uploaded image. Please try a clearer portrait.');
                return;
            }

            // Convert image to base64
            const reader = new FileReader();
            reader.onload = async function (evt) {
                const base64 = evt.target.result;
                const descriptorArray = Array.from(detection.descriptor);

                const payload = {
                    employeeId: employeeId,
                    faceDescriptor: JSON.stringify(descriptorArray),
                    faceImageBase64: base64
                };

                const response = await fetch('@Url.Action("SaveFaceData", "Employee")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const res = await response.json();
                if (res.success) {
                    FaceAttendanceEngine.playSuccessSound();
                    $('#regStatusBadge').removeClass('bg-warning text-dark').addClass('bg-success').text('Registered');
                    $('#enrollSuccessMsg').text(res.message);
                    $('#enrollSuccessAlert').removeClass('d-none');
                    if (res.photoPath) {
                        $('#photoPreviewContainer').html(`<img src="${res.photoPath}?t=${Date.now()}" class="rounded-circle border shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />`);
                    }
                } else {
                    FaceAttendanceEngine.playErrorSound();
                    alert('Error: ' + res.message);
                }
            };
            reader.readAsDataURL(file);
        });
    </script>
}
