@model IEnumerable<AashanaFashion.Models.Employee>
@{
    ViewData["Title"] = "Employee Directory";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string currentDept = ViewBag.Department ?? "";
    string currentSearch = ViewBag.Search ?? "";
    bool activeOnly = ViewBag.ActiveOnly ?? true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Employee Directory</h1>
        <p class="page-sub">Manage factory personnel, wage structures, and biometric face registration.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Attendance" asp-action="Kiosk" class="btn btn-secondary"><i class="bi bi-camera"></i> Open face kiosk</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Employee</a>
    </div>
</div>

@if (ViewBag.AllowedEmployeeRecords != null)
{
    var activeWorkers = (int)ViewBag.ActiveEmployeeCount;
    var allowedWorkers = (int)ViewBag.AllowedEmployeeRecords;
    var isFull = (bool)ViewBag.IsQuotaFull;

    <div class="af-alert @(isFull ? "af-alert-warning" : "af-alert-info")">
        <div class="alert-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <span class="alert-title">Floor worker capacity (HRMS &amp; face kiosk): @activeWorkers of @allowedWorkers workers active</span>
                @(isFull ? "Quota full — add worker packs in the SaaS portal to register more tailors and cutters." : $"{ViewBag.RecordsRemaining} worker slots available.")
            </div>
            <a asp-controller="Subscription" asp-action="Index" class="btn btn-sm btn-secondary"><i class="bi bi-cloud"></i> Manage capacity</a>
        </div>
    </div>
}

<div class="table-card">
    <form method="get" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@currentSearch" class="af-input" placeholder="Search name, code, designation…" />
            </div>
            <select name="department" class="af-input af-select" onchange="this.form.submit()">
                <option value="">All departments</option>
                @foreach (var d in departments)
                {
                    <option value="@d" selected="@(d == currentDept)">@d</option>
                }
            </select>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="chkActive" checked="@activeOnly" onchange="this.form.submit()" />
                <label class="form-check-label" for="chkActive">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-person-badge"></i></div>
            <div class="es-title">No employees found</div>
            <p>No employees match the criteria.</p>
            <a asp-action="Create" class="btn btn-secondary">Add Employee</a>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Code</th>
                        <th>Department &amp; Role</th>
                        <th>Salary Structure</th>
                        <th>Face Scan</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(emp.FacePhotoPath))
                                    {
                                        <img src="@emp.FacePhotoPath" alt="@emp.FullName" class="thumb rounded-circle" />
                                    }
                                    else
                                    {
                                        <span class="u-avatar avatar-lg">@(emp.FullName.Length > 0 ? emp.FullName[0].ToString() : "E")</span>
                                    }
                                    <div>
                                        <span class="cell-title">@emp.FullName</span>
                                        <span class="cell-sub">@(emp.ContactNumber ?? "N/A")</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="mono-id">@emp.EmployeeCode</span></td>
                            <td>
                                <span class="text-foreground">@emp.Department</span>
                                <span class="cell-sub">@emp.Designation</span>
                            </td>
                            <td>
                                <span class="tag">@emp.SalaryType.Humanize()</span>
                                <span class="cell-sub tabular">
                                    ₹@emp.BaseRate.ToString("N2")
                                    @(emp.SalaryType == AashanaFashion.Models.SalaryType.MonthlySalary ? "/ mo" : emp.SalaryType == AashanaFashion.Models.SalaryType.DailyWage ? "/ day" : "/ hr")
                                </span>
                            </td>
                            <td>
                                @if (emp.IsFaceRegistered)
                                {
                                    <span class="af-badge b-green"><i class="bi bi-check2"></i> Registered</span>
                                }
                                else
                                {
                                    <span class="af-badge b-yellow">Pending</span>
                                }
                            </td>
                            <td>
                                <span class="af-badge @(emp.IsActive ? "b-green" : "b-gray")">@(emp.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="EnrollFace" asp-route-id="@emp.Id" class="row-action primary" title="Enroll / update face" aria-label="Enroll face"><i class="bi bi-camera"></i></a>
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="row-action" title="Edit profile" aria-label="Edit profile"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="ToggleActive" asp-route-id="@emp.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="row-action @(emp.IsActive ? "warning" : "success")" title="@(emp.IsActive ? "Deactivate" : "Activate")" aria-label="@(emp.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(emp.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "employee" : "employees")</span>
        </div>
    }
</div>
