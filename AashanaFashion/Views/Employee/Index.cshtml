@model IEnumerable<AashanaFashion.Models.Employee>
@{
    ViewData["Title"] = "Employee Directory";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string currentDept = ViewBag.Department ?? "";
    string currentSearch = ViewBag.Search ?? "";
    bool activeOnly = ViewBag.ActiveOnly ?? true;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold">👥 Employee Management</h2>
        <p class="text-muted mb-0">Manage factory personnel, wage structures, and biometric face registration.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            ➕ Add New Employee
        </a>
        <a asp-controller="Attendance" asp-action="Kiosk" class="btn btn-outline-success">
            📷 Open Face Kiosk
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show af-alert mb-4" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">🔍</span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" placeholder="Search by name, employee code, designation..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == currentDept)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check pt-2">
                    <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="chkActive" checked="@activeOnly" />
                    <label class="form-check-label small" for="chkActive">Active Only</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Employees Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Employee</th>
                    <th>Code</th>
                    <th>Department & Role</th>
                    <th>Salary Structure</th>
                    <th>Face Scan</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="fs-1 mb-2">👤</div>
                            <p class="mb-2">No employees found matching the criteria.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary">Add First Employee</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(emp.FacePhotoPath))
                                    {
                                        <img src="@emp.FacePhotoPath" alt="@emp.FullName" class="rounded-circle border" style="width: 44px; height: 44px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted fw-bold" style="width: 44px; height: 44px;">
                                            @(emp.FullName.Length > 0 ? emp.FullName[0].ToString() : "E")
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@emp.FullName</div>
                                        <small class="text-muted">📞 @(emp.ContactNumber ?? "N/A")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@emp.EmployeeCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold">@emp.Department</div>
                                <small class="text-muted">@emp.Designation</small>
                            </td>
                            <td>
                                <div>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        @emp.SalaryType.ToString()
                                    </span>
                                </div>
                                <small class="fw-bold text-dark">
                                    ₹@emp.BaseRate:N2
                                    @(emp.SalaryType == AashanaFashion.Models.SalaryType.MonthlySalary ? "/ mo" : emp.SalaryType == AashanaFashion.Models.SalaryType.DailyWage ? "/ day" : "/ hr")
                                </small>
                            </td>
                            <td>
                                @if (emp.IsFaceRegistered)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                        <span>📷</span> Registered
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle d-inline-flex align-items-center gap-1">
                                        <span>⚠️</span> Pending
                                    </span>
                                }
                            </td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EnrollFace" asp-route-id="@emp.Id" class="btn btn-outline-primary" title="Enroll / Update Face">
                                        📷 Face
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-outline-secondary" title="Edit Profile">
                                        ✏️ Edit
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@emp.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(emp.IsActive ? "warning" : "success")" title="@(emp.IsActive ? "Deactivate" : "Activate")">
                                            @(emp.IsActive ? "⏸️" : "▶️")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
