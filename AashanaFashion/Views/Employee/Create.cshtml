@model AashanaFashion.Models.Employee
@{
    ViewData["Title"] = "Add Employee";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Employees</a></li>
            <li class="breadcrumb-item active">New Employee</li>
        </ol>
    </nav>
    <h2 class="mb-0 fw-bold">➕ Add New Employee</h2>
    <p class="text-muted">Enter employee information and configure their compensation structure.</p>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Basic Information -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold">👤 Personal & Job Details</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="EmployeeCode" class="form-label fw-semibold">Employee Code <span class="text-danger">*</span></label>
                            <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. EMP-001" required />
                            <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Kumar" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                            <select asp-for="Department" class="form-select" required>
                                <option value="">Select Department...</option>
                                <option value="Cutting">Cutting</option>
                                <option value="Stitching">Stitching</option>
                                <option value="Finishing">Finishing & Pressing</option>
                                <option value="Quality">Quality Control</option>
                                <option value="Dying">Dying & Washing</option>
                                <option value="Packing">Packing & Dispatch</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Management">Management & Floor Super</option>
                                <option value="Accounts">Accounts & Office</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label fw-semibold">Designation / Role <span class="text-danger">*</span></label>
                            <input asp-for="Designation" class="form-control" placeholder="e.g. Master Tailor, Stitcher, Cutter" required />
                            <span asp-validation-for="Designation" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label fw-semibold">Contact / Mobile</label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 9876543210" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. ramesh@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label fw-semibold">Date of Joining</label>
                            <input asp-for="JoiningDate" type="date" class="form-control" />
                            <span asp-validation-for="JoiningDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Address / Location</label>
                            <input asp-for="Address" class="form-control" placeholder="City, State" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Wage & Salary Setup -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold">💵 Wage & Compensation Setup</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SalaryType" class="form-label fw-semibold">Salary Calculation Mode</label>
                            <select asp-for="SalaryType" class="form-select" id="salaryTypeSelect" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.SalaryType>()">
                            </select>
                            <small class="text-muted" id="salaryTypeHelp">Select how this worker is paid.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BaseRate" class="form-label fw-semibold">Base Rate / Salary (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseRate" type="number" step="0.01" class="form-control" id="baseRateInput" placeholder="600.00" required />
                            </div>
                            <span asp-validation-for="BaseRate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StandardDailyHours" class="form-label fw-semibold">Standard Shift Working Hours</label>
                            <input asp-for="StandardDailyHours" type="number" step="0.5" class="form-control" placeholder="8.0" />
                            <small class="text-muted">Standard daily work shift (default 8 hours).</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OvertimeHourlyRate" class="form-label fw-semibold">Overtime Hourly Rate (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="OvertimeHourlyRate" type="number" step="0.01" class="form-control" id="overtimeInput" placeholder="Auto-calculated if 0" />
                            </div>
                            <small class="text-muted">Rate paid per overtime hour beyond standard shift.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Bank & Payout Details -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold">🏦 Bank & Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="UpiId" class="form-label fw-semibold">UPI ID / PhonePe / GPay</label>
                        <input asp-for="UpiId" class="form-control" placeholder="user@okhdfcbank" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankName" class="form-label fw-semibold">Bank Name</label>
                        <input asp-for="BankName" class="form-control" placeholder="State Bank of India" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankAccountNumber" class="form-label fw-semibold">Account Number</label>
                        <input asp-for="BankAccountNumber" class="form-control" placeholder="123456789012" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankIFSC" class="form-label fw-semibold">IFSC Code</label>
                        <input asp-for="BankIFSC" class="form-control" placeholder="SBIN0001234" />
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3 bg-light p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fs-4">📷</span>
                    <h6 class="fw-bold mb-0">Biometric Face Enrollment</h6>
                </div>
                <p class="small text-muted mb-3">After creating this employee, you will be redirected to the face scanner to capture their biometric face scan.</p>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        💾 Save & Register Face
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#salaryTypeSelect').on('change', function () {
            const val = $(this).val();
            if (val === '0' || val === 'MonthlySalary') {
                $('#salaryTypeHelp').text('Fixed monthly salary paid at end of month (e.g. ₹25,000 / month).');
            } else if (val === '1' || val === 'DailyWage') {
                $('#salaryTypeHelp').text('Daily wage paid per present working day (e.g. ₹600 / day).');
            } else {
                $('#salaryTypeHelp').text('Hourly rate paid per logged working hour (e.g. ₹90 / hour).');
            }
        });
    </script>
}
