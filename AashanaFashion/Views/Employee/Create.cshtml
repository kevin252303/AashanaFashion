@model AashanaFashion.Models.Employee
@{
    ViewData["Title"] = "Add Employee";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Employees</a>
        <h1 class="page-title">Add New Employee</h1>
        <p class="page-sub">Enter employee information and configure their compensation structure.</p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Basic Information -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Personal & Job Details</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="EmployeeCode" class="form-label">Employee Code <span class="req">*</span></label>
                            <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. EMP-001" required />
                            <span asp-validation-for="EmployeeCode" class="af-error"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label">Full Name <span class="req">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Ramesh Kumar" required />
                            <span asp-validation-for="FullName" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department <span class="req">*</span></label>
                            <select asp-for="Department" class="form-select" required>
                                <option value="">Select Department...</option>
                                <option value="Cutting">Cutting</option>
                                <option value="Stitching">Stitching</option>
                                <option value="Finishing">Finishing & Pressing</option>
                                <option value="Quality">Quality Control</option>
                                <option value="Dying">Dying & Washing</option>
                                <option value="Packing">Packing & Dispatch</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Management">Management & Floor Super</option>
                                <option value="Accounts">Accounts & Office</option>
                            </select>
                            <span asp-validation-for="Department" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label">Designation / Role <span class="req">*</span></label>
                            <input asp-for="Designation" class="form-control" placeholder="e.g. Master Tailor, Stitcher, Cutter" required />
                            <span asp-validation-for="Designation" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label">Contact / Mobile</label>
                            <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 9876543210" />
                            <span asp-validation-for="ContactNumber" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. ramesh@example.com" />
                            <span asp-validation-for="Email" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label">Date of Joining</label>
                            <input asp-for="JoiningDate" type="date" class="form-control" />
                            <span asp-validation-for="JoiningDate" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label">Address / Location</label>
                            <input asp-for="Address" class="form-control" placeholder="City, State" />
                            <span asp-validation-for="Address" class="af-error"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Wage & Salary Setup -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Wage & Compensation Setup</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SalaryType" class="form-label">Salary Calculation Mode</label>
                            <select asp-for="SalaryType" class="form-select" id="salaryTypeSelect" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.SalaryType>()">
                            </select>
                            <small class="form-text" id="salaryTypeHelp">Select how this worker is paid.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BaseRate" class="form-label">Base Rate / Salary (₹) <span class="req">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseRate" type="number" step="0.01" class="form-control" id="baseRateInput" placeholder="600.00" required />
                            </div>
                            <span asp-validation-for="BaseRate" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StandardDailyHours" class="form-label">Standard Shift Working Hours</label>
                            <input asp-for="StandardDailyHours" type="number" step="0.5" class="form-control" placeholder="8.0" />
                            <small class="form-text">Standard daily work shift (default 8 hours).</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OvertimeHourlyRate" class="form-label">Overtime Hourly Rate (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="OvertimeHourlyRate" type="number" step="0.01" class="form-control" id="overtimeInput" placeholder="Auto-calculated if 0" />
                            </div>
                            <small class="form-text">Rate paid per overtime hour beyond standard shift.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Bank & Payout Details -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Bank & Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="BankIFSC" class="form-label">IFSC Code</label>
                        <div class="input-group">
                            <input asp-for="BankIFSC" id="empIfscInput" class="form-control text-uppercase font-monospace" placeholder="SBIN0001234" maxlength="11" />
                            <button type="button" class="btn btn-secondary btn-sm" id="btnFetchEmpIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                <i class="bi bi-search"></i> Fetch
                            </button>
                        </div>
                        <div id="empIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankName" class="form-label">Bank Name</label>
                        <input asp-for="BankName" id="empBankName" class="form-control" placeholder="State Bank of India" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankBranch" class="form-label">Branch Name</label>
                        <input asp-for="BankBranch" id="empBankBranch" class="form-control" placeholder="e.g. Surat Main Branch" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankAccountNumber" class="form-label">Account Number</label>
                        <input asp-for="BankAccountNumber" class="form-control font-monospace" placeholder="123456789012" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="UpiId" class="form-label">UPI ID / PhonePe / GPay</label>
                        <input asp-for="UpiId" class="form-control font-monospace" placeholder="user@okhdfcbank" />
                    </div>
                </div>
            </div>

            <div class="af-alert af-alert-info">
                <div class="alert-body">
                    <span class="alert-title">Biometric face enrollment</span>
                    After saving, you'll be taken to the face scanner to capture this employee's face.
                </div>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save &amp; register face</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#salaryTypeSelect').on('change', function () {
            const val = $(this).val();
            if (val === '0' || val === 'MonthlySalary') {
                $('#salaryTypeHelp').text('Fixed monthly salary paid at end of month (e.g. ₹25,000 / month).');
            } else if (val === '1' || val === 'DailyWage') {
                $('#salaryTypeHelp').text('Daily wage paid per present working day (e.g. ₹600 / day).');
            } else {
                $('#salaryTypeHelp').text('Hourly rate paid per logged working hour (e.g. ₹90 / hour).');
            }
        });

        initIfscLookup({
            ifscInput: '#empIfscInput',
            bankNameInput: '#empBankName',
            branchInput: '#empBankBranch',
            fetchBtn: '#btnFetchEmpIfsc',
            statusContainer: '#empIfscStatus'
        });
    </script>
}
