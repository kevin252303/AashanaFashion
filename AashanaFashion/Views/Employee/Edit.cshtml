@model AashanaFashion.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Employees</a>
        <h1 class="page-title">Edit Employee — @Model.FullName</h1>
        <p class="page-sub">Code <span class="mono-id">@Model.EmployeeCode</span></p>
    </div>
    <div class="page-actions">
        <a asp-action="EnrollFace" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-camera"></i> Update face profile</a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="FaceDescriptor" />
    <input type="hidden" asp-for="FacePhotoPath" />
    <input type="hidden" asp-for="IsFaceRegistered" />

    <div class="row g-4">
        <!-- Basic Information -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Personal & Job Details</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="EmployeeCode" class="form-label">Employee Code <span class="req">*</span></label>
                            <input asp-for="EmployeeCode" class="form-control" required />
                            <span asp-validation-for="EmployeeCode" class="af-error"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label">Full Name <span class="req">*</span></label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department <span class="req">*</span></label>
                            <select asp-for="Department" class="form-select" required>
                                <option value="Cutting">Cutting</option>
                                <option value="Stitching">Stitching</option>
                                <option value="Finishing">Finishing & Pressing</option>
                                <option value="Quality">Quality Control</option>
                                <option value="Dying">Dying & Washing</option>
                                <option value="Packing">Packing & Dispatch</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Management">Management & Floor Super</option>
                                <option value="Accounts">Accounts & Office</option>
                            </select>
                            <span asp-validation-for="Department" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label">Designation / Role <span class="req">*</span></label>
                            <input asp-for="Designation" class="form-control" required />
                            <span asp-validation-for="Designation" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label">Contact / Mobile</label>
                            <input asp-for="ContactNumber" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label">Date of Joining</label>
                            <input asp-for="JoiningDate" type="date" class="form-control" />
                            <span asp-validation-for="JoiningDate" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label">Address / Location</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="af-error"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch pt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch">Active Employee</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Wage & Salary Setup -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Wage & Compensation Setup</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SalaryType" class="form-label">Salary Calculation Mode</label>
                            <select asp-for="SalaryType" class="form-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.SalaryType>()">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BaseRate" class="form-label">Base Rate / Salary (₹) <span class="req">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseRate" type="number" step="0.01" class="form-control" required />
                            </div>
                            <span asp-validation-for="BaseRate" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StandardDailyHours" class="form-label">Standard Shift Working Hours</label>
                            <input asp-for="StandardDailyHours" type="number" step="0.5" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OvertimeHourlyRate" class="form-label">Overtime Hourly Rate (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="OvertimeHourlyRate" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Bank & Payout Details -->
        <div class="col-lg-4">
            <!-- Current Face Profile Card -->
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title">Biometric face record</span>
                    <span class="af-badge @(Model.IsFaceRegistered ? "b-green" : "b-yellow")">@(Model.IsFaceRegistered ? "Registered" : "Not registered")</span>
                </div>
                <div class="data-card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.FacePhotoPath))
                    {
                        <img src="@Model.FacePhotoPath" alt="@Model.FullName" class="rounded-circle border mb-3" style="width: 110px; height: 110px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-raised border d-inline-flex align-items-center justify-content-center text-placeholder mb-3" style="width: 110px; height: 110px; font-size: 40px;">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                    <div>
                        <a asp-action="EnrollFace" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary">
                            <i class="bi bi-camera"></i> @(Model.IsFaceRegistered ? "Re-scan / update face" : "Register face now")
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Bank & Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="BankIFSC" class="form-label">IFSC Code</label>
                        <div class="input-group">
                            <input asp-for="BankIFSC" id="empIfscInput" class="form-control text-uppercase font-monospace" maxlength="11" />
                            <button type="button" class="btn btn-secondary btn-sm" id="btnFetchEmpIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                <i class="bi bi-search"></i> Fetch
                            </button>
                        </div>
                        <div id="empIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankName" class="form-label">Bank Name</label>
                        <input asp-for="BankName" id="empBankName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankBranch" class="form-label">Branch Name</label>
                        <input asp-for="BankBranch" id="empBankBranch" class="form-control" placeholder="e.g. Surat Main Branch" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="BankAccountNumber" class="form-label">Account Number</label>
                        <input asp-for="BankAccountNumber" class="form-control font-monospace" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="UpiId" class="form-label">UPI ID / PhonePe / GPay</label>
                        <input asp-for="UpiId" class="form-control font-monospace" />
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        initIfscLookup({
            ifscInput: '#empIfscInput',
            bankNameInput: '#empBankName',
            branchInput: '#empBankBranch',
            fetchBtn: '#btnFetchEmpIfsc',
            statusContainer: '#empIfscStatus'
        });
    </script>
}
