@model AashanaFashion.Controllers.RawMaterialViewModel
@{
    ViewData["Title"] = "Raw Material";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin = role == "Admin" || role == "SuperAdmin";
    bool canRaise = isAdmin || User.HasClaim("Permission.RawMaterial.CanCreate", "true");
    bool canApprove = isAdmin || User.HasClaim("Permission.RawMaterial.CanEdit", "true");
}

<div class="page-header">
    <div>
        <h1 class="page-title">Raw Material</h1>
        <p class="page-sub">Manage inventory and requirements</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Inventory Summary -->
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Inventory</span>
                @if (role == "Admin")
                {
                    <a asp-action="CreateMaterial" class="btn-af btn-af-primary btn-af-sm">+ Add Material</a>
                }
            </div>
            
            @if (!Model.Materials.Any())
            {
                <div class="empty-state">
                    <div class="es-icon">🧵</div>
                    <p>No materials in inventory</p>
                </div>
            }
            else
            {
                <table class="af-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Stock</th>
                            <th>Unit</th>
                            <th>Min Stock</th>
                            <th>Rate</th>
                            @if (role == "Admin")
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Materials)
                        {
                            <tr class="@(m.CurrentStock <= m.MinimumStock ? "low-stock" : "")">
                                <td><strong>@m.Name</strong></td>
                                <td><strong>@m.CurrentStock</strong></td>
                                <td>@m.Unit</td>
                                <td>@m.MinimumStock</td>
                                <td>₹@m.Rate</td>
                                @if (role == "Admin")
                                {
                                    <td>
                                        <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
                                            <a asp-action="InOut" asp-route-materialId="@m.Id" class="btn-af btn-af-sm" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;" title="Stock Entry">In/Out</a>
                                            <a asp-action="EditMaterial" asp-route-id="@m.Id" class="btn-af btn-af-ghost btn-af-sm">Edit</a>
                                            <form asp-action="DeleteMaterial" asp-route-id="@m.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-af btn-af-danger btn-af-sm" onclick="return confirm('Delete?')">×</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Requirements -->
    <div class="col-lg-6">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Requirements</span>
                @if (canRaise)
                {
                    <button type="button" class="btn-af btn-af-primary btn-af-sm" data-bs-toggle="modal" data-bs-target="#raiseRequirementModal">+ Raise Requirement</button>
                }
            </div>
            
            @if (!Model.Requirements.Any())
            {
                <div class="empty-state">
                    <div class="es-icon">📋</div>
                    <p>No requirements raised</p>
                </div>
            }
            else
            {
                <table class="af-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Qty</th>
                            <th>Required By</th>
                            <th>Status</th>
                            @if (canApprove || canRaise)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Requirements)
                        {
                            <tr>
                                <td><strong>@r.MaterialName</strong></td>
                                <td>@r.Quantity @r.Unit</td>
                                <td>@r.RequiredDate.ToString("dd MMM")</td>
                                <td><span class="af-badge @GetStatusBadge(r.Status)">@r.Status</span></td>
                                @if (canApprove || canRaise)
                                {
                                    <td>
                                        @if (r.Status == "Pending" && canApprove)
                                        {
                                            <form asp-action="UpdateRequirementStatus" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <input type="hidden" name="status" value="Approved" />
                                                <button type="submit" class="btn-af btn-af-sm" title="Approve">✓</button>
                                            </form>
                                            <form asp-action="UpdateRequirementStatus" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <input type="hidden" name="status" value="Purchased" />
                                                <button type="submit" class="btn-af btn-af-success btn-af-sm" title="Mark Purchased">P</button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<!-- Add Material Modal -->
@if (role == "Admin")
{
    <div class="modal fade" id="addMaterialModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Material</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="CreateMaterial" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="af-form-group">
                            <label class="af-label">Material Name</label>
                            <input name="Name" class="af-input" required />
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="af-form-group">
                                    <label class="af-label">Current Stock</label>
                                    <input name="CurrentStock" type="number" step="0.01" class="af-input" value="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="af-form-group">
                                    <label class="af-label">Unit</label>
                                    <input name="Unit" class="af-input" placeholder="e.g. meters, kg" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="af-form-group">
                                    <label class="af-label">Min Stock</label>
                                    <input name="MinimumStock" type="number" step="0.01" class="af-input" value="0" />
                                </div>
                            </div>
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Rate</label>
                            <input name="Rate" type="number" step="0.01" class="af-input" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-af btn-af-ghost" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-af btn-af-primary">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}
@if (canRaise)
{
    <!-- Raise Requirement Modal -->
    <div class="modal fade" id="raiseRequirementModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Raise Requirement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="RaiseRequirement" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="af-form-group">
                            <label class="af-label">Material Name</label>
                            <input name="MaterialName" class="af-input" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="af-form-group">
                                    <label class="af-label">Quantity</label>
                                    <input name="Quantity" type="number" step="0.01" class="af-input" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="af-form-group">
                                    <label class="af-label">Unit</label>
                                    <input name="Unit" class="af-input" required />
                                </div>
                            </div>
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Required Date</label>
                            <input name="RequiredDate" type="date" class="af-input" required />
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Remarks</label>
                            <input name="Remarks" class="af-input" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-af btn-af-ghost" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-af btn-af-primary">Raise</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .low-stock { background: #fef2f2; }
</style>

@functions {
    string GetStatusBadge(string status) => status switch
    {
        "Pending" => "b-yellow",
        "Approved" => "b-blue",
        "Purchased" => "b-green",
        _ => "b-gray"
    };
}
