@model AashanaFashion.Controllers.RawMaterialViewModel
@{
    ViewData["Title"] = "Raw Material Inventory";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin = role == "Admin" || role == "SuperAdmin";
    bool canManage = isAdmin || role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Raw Material Inventory</h1>
        <p class="page-sub">Real-time stock ledger, valuation &amp; inventory tracking</p>
    </div>
    <div class="page-actions">
        <a asp-action="Ledger" class="btn btn-secondary"><i class="bi bi-journal-text"></i> Stock Ledger</a>
        @if (canManage)
        {
            <a asp-action="AdjustStock" class="btn btn-secondary"><i class="bi bi-clipboard-check"></i> Audit / Adjust</a>
            <a asp-action="InOut" class="btn btn-secondary"><i class="bi bi-arrow-left-right"></i> Quick In/Out</a>
        }
        @if (isAdmin)
        {
            <a asp-action="CreateMaterial" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Material</a>
        }
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total materials</div>
        <div class="metric-value">@Model.Materials.Count</div>
        <div class="metric-meta">active catalog items</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Inventory valuation</div>
        <div class="metric-value">₹@Model.TotalValuation.ToString("N2")</div>
        <div class="metric-meta">total asset value on hand</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Low stock</div>
        <div class="metric-value">@Model.LowStockCount</div>
        <div class="metric-meta warning">at or below reorder level</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Out of stock</div>
        <div class="metric-value">@Model.OutOfStockCount</div>
        <div class="metric-meta @(Model.OutOfStockCount > 0 ? "danger" : "")">zero or negative quantity</div>
    </div>
</div>

<div class="table-card mb-4">
    <div class="table-toolbar">
        <div class="toolbar-filters">
            <span class="data-card-title me-2">Current stock</span>
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" id="inventorySearch" class="af-input" placeholder="Search material…" />
            </div>
            <select id="stockFilter" class="af-input af-select">
                <option value="all">All items</option>
                <option value="low">Low stock</option>
                <option value="out">Out of stock</option>
                <option value="in">Healthy stock</option>
            </select>
        </div>
    </div>

    @if (!Model.Materials.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-boxes"></i></div>
            <div class="es-title">No materials yet</div>
            <p>Add fabrics, linings and trims to start tracking stock.</p>
            @if (isAdmin)
            {
                <a asp-action="CreateMaterial" class="btn btn-secondary">Add Material</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table" id="materialsTable">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th class="text-end">Current Stock</th>
                        <th>Unit</th>
                        <th class="text-end">Min Stock</th>
                        <th class="text-end">Rate / Cost</th>
                        <th class="text-end">Asset Value</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Materials)
                    {
                        var isOut = m.CurrentStock <= 0;
                        var isLow = !isOut && m.CurrentStock <= m.MinimumStock;
                        var rowCategory = isOut ? "out" : (isLow ? "low" : "in");
                        var valuation = m.CurrentStock * m.Rate;

                        <tr class="material-row" data-category="@rowCategory">
                            <td>
                                <span class="cell-title">@m.Name</span>
                                @if (!string.IsNullOrEmpty(m.Description))
                                {
                                    <span class="cell-sub">@m.Description</span>
                                }
                            </td>
                            <td class="cell-num">
                                <span class="fw-semibold @(isOut ? "text-danger" : (isLow ? "text-warning" : "text-foreground"))">@m.CurrentStock.ToString("N2")</span>
                            </td>
                            <td>@m.Unit</td>
                            <td class="cell-num text-muted">@m.MinimumStock.ToString("N2")</td>
                            <td class="cell-num">₹@m.Rate.ToString("N2")</td>
                            <td class="cell-num text-foreground fw-medium">₹@valuation.ToString("N2")</td>
                            <td>
                                @if (isOut)
                                {
                                    <span class="af-badge b-red">Out of stock</span>
                                }
                                else if (isLow)
                                {
                                    <span class="af-badge b-yellow">Low stock</span>
                                }
                                else
                                {
                                    <span class="af-badge b-green">In stock</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Ledger" asp-route-materialId="@m.Id" class="row-action" title="Transaction ledger" aria-label="Transaction ledger"><i class="bi bi-journal-text"></i></a>
                                    @if (canManage)
                                    {
                                        <a asp-action="InOut" asp-route-materialId="@m.Id" class="row-action success" title="Quick in / out" aria-label="Quick in / out"><i class="bi bi-arrow-left-right"></i></a>
                                        <a asp-action="AdjustStock" asp-route-materialId="@m.Id" class="row-action" title="Stock adjustment" aria-label="Stock adjustment"><i class="bi bi-sliders"></i></a>
                                    }
                                    @if (isAdmin)
                                    {
                                        <a asp-action="EditMaterial" asp-route-id="@m.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="DeleteMaterial" asp-route-id="@m.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action danger" title="Delete" aria-label="Delete" onclick="return confirm('Delete material \'@m.Name\'?')"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Materials.Count</strong> @(Model.Materials.Count == 1 ? "material" : "materials")</span>
        </div>
    }
</div>

@if (Model.RecentTransactions.Any())
{
    <div class="table-card">
        <div class="data-card-header">
            <span class="data-card-title">Recent stock activity</span>
            <a asp-action="Ledger" class="btn btn-sm btn-ghost">View full ledger <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Material</th>
                        <th>Movement</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Balance After</th>
                        <th>Reference</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        var isIn = tx.Type == "Inward";
                        var isAdj = tx.Type == "Adjustment";
                        <tr>
                            <td class="text-muted text-nowrap">@tx.CreatedDate.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td><span class="cell-title">@(tx.RawMaterial?.Name ?? $"Material #{tx.RawMaterialId}")</span></td>
                            <td>
                                @if (isIn)
                                {
                                    <span class="af-badge b-green"><i class="bi bi-arrow-down-left"></i> Inward</span>
                                }
                                else if (isAdj)
                                {
                                    <span class="af-badge b-indigo">Adjustment</span>
                                }
                                else
                                {
                                    <span class="af-badge b-red"><i class="bi bi-arrow-up-right"></i> Outward</span>
                                }
                            </td>
                            <td class="cell-num fw-medium @(isIn ? "text-success" : (isAdj ? "text-primary" : "text-danger"))">
                                @(isIn ? "+" : (isAdj && tx.Quantity > 0 ? "+" : ""))@tx.Quantity.ToString("N2") @tx.RawMaterial?.Unit
                            </td>
                            <td class="cell-num text-foreground fw-semibold">@tx.BalanceAfter.ToString("N2") @tx.RawMaterial?.Unit</td>
                            <td>
                                @if (!string.IsNullOrEmpty(tx.ReferenceType))
                                {
                                    <span class="mono-id">@tx.ReferenceType @(tx.ReferenceId.HasValue ? $"#{tx.ReferenceId}" : "")</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="text-muted">@(tx.Remarks ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('inventorySearch');
        const filterSelect = document.getElementById('stockFilter');
        const rows = document.querySelectorAll('.material-row');

        function filterTable() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            const filter = filterSelect?.value || 'all';

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const category = row.getAttribute('data-category');

                const matchesQuery = !query || text.includes(query);
                const matchesFilter = (filter === 'all') || (category === filter);

                row.style.display = (matchesQuery && matchesFilter) ? '' : 'none';
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterTable);
        if (filterSelect) filterSelect.addEventListener('change', filterTable);
    });
</script>
