@model AashanaFashion.Models.RawMaterialLedgerViewModel
@{
    ViewData["Title"] = "Stock Ledger";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="page-title">Stock Ledger</h1>
        <p class="page-sub">Audit trail of all raw material inward, outward & adjustments</p>
    </div>
    <div style="display:flex;gap:.5rem;">
        <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back to Inventory</a>
        <a asp-action="InOut" class="btn-af btn-af-sm" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">+ Quick In/Out</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><span class="alert-body">@TempData["Success"]</span><button class="alert-close">&times;</button></div>
}

<!-- Filter Form -->
<div class="data-card mb-4 p-3">
    <form method="get" asp-action="Ledger">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="af-label" style="font-size: 0.8rem;">Search</label>
                <input type="text" name="search" class="af-input" placeholder="Search reference, notes, material..." value="@ViewBag.Search" style="font-size: 0.85rem;" />
            </div>
            <div class="col-md-2">
                <label class="af-label" style="font-size: 0.8rem;">Material</label>
                <select name="materialId" class="af-input af-select" style="font-size: 0.85rem;">
                    <option value="">— All Materials —</option>
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id" selected="@(m.Id == Model.MaterialId ? "selected" : null)">
                            @m.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="af-label" style="font-size: 0.8rem;">Movement Type</label>
                <select name="type" class="af-input af-select" style="font-size: 0.85rem;">
                    <option value="">— All Types —</option>
                    <option value="Inward" selected="@(Model.Type == "Inward" ? "selected" : null)">Inward (+)</option>
                    <option value="Outward" selected="@(Model.Type == "Outward" ? "selected" : null)">Outward (-)</option>
                    <option value="Adjustment" selected="@(Model.Type == "Adjustment" ? "selected" : null)">Adjustment (⚖)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="af-label" style="font-size: 0.8rem;">From Date</label>
                <input type="date" name="fromDate" class="af-input" style="font-size: 0.85rem;" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-1">
                <label class="af-label" style="font-size: 0.8rem;">To Date</label>
                <input type="date" name="toDate" class="af-input" style="font-size: 0.85rem;" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2" style="display:flex;gap:.5rem;">
                <button type="submit" class="btn-af btn-af-primary btn-af-sm flex-fill">Filter</button>
                <a asp-action="Ledger" class="btn-af btn-af-ghost btn-af-sm">Reset</a>
            </div>
        </div>
    </form>
</div>

<!-- Ledger Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="data-card p-3" style="border-left: 4px solid #16a34a;">
            <div style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Total Inward</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: #16a34a; margin-top: 4px;">+@Model.TotalInward.ToString("N2")</div>
            <div style="font-size: 0.75rem; color: #94a3b8;">Receipts & Inwards in period</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="data-card p-3" style="border-left: 4px solid #dc2626;">
            <div style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Total Outward</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: #dc2626; margin-top: 4px;">-@Model.TotalOutward.ToString("N2")</div>
            <div style="font-size: 0.75rem; color: #94a3b8;">Issues & Consumptions in period</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="data-card p-3" style="border-left: 4px solid #4f46e5;">
            <div style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Net Adjustments</div>
            <div style="font-size: 1.4rem; font-weight: 700; color: #4f46e5; margin-top: 4px;">@(Model.TotalAdjustment >= 0 ? "+" : "")@Model.TotalAdjustment.ToString("N2")</div>
            <div style="font-size: 0.75rem; color: #94a3b8;">Audit counts & reconciliations</div>
        </div>
    </div>
</div>

<!-- Ledger Table -->
<div class="data-card">
    <div class="data-card-header d-flex justify-content-between align-items-center">
        <span class="data-card-title">Transactions (@Model.Transactions.Count entries)</span>
    </div>
    
    @if (!Model.Transactions.Any())
    {
        <div class="empty-state p-5 text-center">
            <div class="es-icon" style="font-size: 2.5rem;">📜</div>
            <p style="color: #64748b; margin-top: 1rem;">No transactions recorded for the selected filter.</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="af-table" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th style="width: 140px;">Date & Time</th>
                        <th>Material</th>
                        <th class="text-center" style="width: 110px;">Type</th>
                        <th class="text-end" style="width: 100px;">Inward</th>
                        <th class="text-end" style="width: 100px;">Outward</th>
                        <th class="text-end" style="width: 110px;">Balance After</th>
                        <th class="text-end" style="width: 90px;">Rate</th>
                        <th style="width: 130px;">Reference</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        var isIn = tx.Type == "Inward";
                        var isOut = tx.Type == "Outward";
                        var isAdj = tx.Type == "Adjustment";
                        <tr>
                            <td style="color: #64748b;">@tx.CreatedDate.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td>
                                <strong>@(tx.RawMaterial?.Name ?? $"Material #{tx.RawMaterialId}")</strong>
                                @if (tx.RawMaterial != null)
                                {
                                    <span style="font-size: 0.75rem; color: #94a3b8;">(@tx.RawMaterial.Unit)</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (isIn)
                                {
                                    <span class="af-badge" style="background:#dcfce7;color:#16a34a;">+ Inward</span>
                                }
                                else if (isAdj)
                                {
                                    <span class="af-badge" style="background:#e0e7ff;color:#4f46e5;">⚖ Adjust</span>
                                }
                                else
                                {
                                    <span class="af-badge" style="background:#fee2e2;color:#dc2626;">- Outward</span>
                                }
                            </td>
                            <td class="text-end" style="font-weight: 600; color: #16a34a;">
                                @if (isIn || (isAdj && tx.Quantity > 0))
                                {
                                    <span>+@tx.Quantity.ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color: #cbd5e1;">—</span>
                                }
                            </td>
                            <td class="text-end" style="font-weight: 600; color: #dc2626;">
                                @if (isOut || (isAdj && tx.Quantity < 0))
                                {
                                    <span>@Math.Abs(tx.Quantity).ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color: #cbd5e1;">—</span>
                                }
                            </td>
                            <td class="text-end" style="font-weight: 700; color: #0f172a;">
                                @tx.BalanceAfter.ToString("N2")
                            </td>
                            <td class="text-end" style="color: #64748b;">
                                @(tx.UnitPrice.HasValue && tx.UnitPrice > 0 ? $"₹{tx.UnitPrice.Value:N2}" : "—")
                            </td>
                            <td>
                                @if (tx.ReferenceType == "PurchaseOrder" && tx.ReferenceId.HasValue)
                                {
                                    <a asp-controller="Purchase" asp-action="Details" asp-route-id="@tx.ReferenceId.Value" class="af-badge b-blue" style="text-decoration:none;">
                                        PO #@tx.ReferenceId.Value
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(tx.ReferenceType))
                                {
                                    <span class="af-badge b-gray">@tx.ReferenceType @(tx.ReferenceId.HasValue ? $"#{tx.ReferenceId.Value}" : "")</span>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">—</span>
                                }
                            </td>
                            <td style="color: #475569;">@(tx.Remarks ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
