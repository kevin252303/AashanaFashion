@model AashanaFashion.Models.RawMaterialLedgerViewModel
@{
    ViewData["Title"] = "Stock Ledger";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Inventory</a>
        <h1 class="page-title">Stock Ledger</h1>
        <p class="page-sub">Audit trail of all raw material inward, outward &amp; adjustments</p>
    </div>
    <div class="page-actions">
        <a asp-action="InOut" class="btn btn-primary"><i class="bi bi-arrow-left-right"></i> Quick In/Out</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total inward</div>
        <div class="metric-value">+@Model.TotalInward.ToString("N2")</div>
        <div class="metric-meta success">receipts &amp; inwards in period</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total outward</div>
        <div class="metric-value">−@Model.TotalOutward.ToString("N2")</div>
        <div class="metric-meta danger">issues &amp; consumption in period</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Net adjustments</div>
        <div class="metric-value">@(Model.TotalAdjustment >= 0 ? "+" : "")@Model.TotalAdjustment.ToString("N2")</div>
        <div class="metric-meta info">audit counts &amp; reconciliations</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Ledger" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="ledgerSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="ledgerSearch" name="search" class="af-input" placeholder="Reference, notes, material…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="ledgerMaterial">Material</label>
                <select id="ledgerMaterial" name="materialId" class="af-input af-select">
                    <option value="">All materials</option>
                    @foreach (var m in Model.Materials)
                    {
                        <option value="@m.Id" selected="@(m.Id == Model.MaterialId ? "selected" : null)">
                            @m.Name
                        </option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="ledgerType">Movement</label>
                <select id="ledgerType" name="type" class="af-input af-select">
                    <option value="">All types</option>
                    <option value="Inward" selected="@(Model.Type == "Inward" ? "selected" : null)">Inward (+)</option>
                    <option value="Outward" selected="@(Model.Type == "Outward" ? "selected" : null)">Outward (−)</option>
                    <option value="Adjustment" selected="@(Model.Type == "Adjustment" ? "selected" : null)">Adjustment</option>
                </select>
            </div>
            <div class="toolbar-field">
                <label for="ledgerFrom">From</label>
                <input type="date" id="ledgerFrom" name="fromDate" class="af-input" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="toolbar-field">
                <label for="ledgerTo">To</label>
                <input type="date" id="ledgerTo" name="toDate" class="af-input" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Ledger" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Transactions.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-journal-x"></i></div>
            <div class="es-title">No transactions</div>
            <p>Nothing recorded for the selected filter.</p>
            <a asp-action="Ledger" class="btn btn-secondary">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 150px;">Date &amp; Time</th>
                        <th>Material</th>
                        <th style="width: 110px;">Type</th>
                        <th class="text-end" style="width: 100px;">Inward</th>
                        <th class="text-end" style="width: 100px;">Outward</th>
                        <th class="text-end" style="width: 120px;">Balance After</th>
                        <th class="text-end" style="width: 90px;">Rate</th>
                        <th style="width: 130px;">Reference</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        var isIn = tx.Type == "Inward";
                        var isOut = tx.Type == "Outward";
                        var isAdj = tx.Type == "Adjustment";
                        <tr>
                            <td class="text-muted text-nowrap">@tx.CreatedDate.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td>
                                <span class="cell-title">@(tx.RawMaterial?.Name ?? $"Material #{tx.RawMaterialId}")</span>
                                @if (tx.RawMaterial != null)
                                {
                                    <span class="text-xs text-placeholder">(@tx.RawMaterial.Unit)</span>
                                }
                            </td>
                            <td>
                                @if (isIn)
                                {
                                    <span class="af-badge b-green">Inward</span>
                                }
                                else if (isAdj)
                                {
                                    <span class="af-badge b-indigo">Adjust</span>
                                }
                                else
                                {
                                    <span class="af-badge b-red">Outward</span>
                                }
                            </td>
                            <td class="cell-num">
                                @if (isIn || (isAdj && tx.Quantity > 0))
                                {
                                    <span class="text-success fw-medium">+@tx.Quantity.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="cell-num">
                                @if (isOut || (isAdj && tx.Quantity < 0))
                                {
                                    <span class="text-danger fw-medium">@Math.Abs(tx.Quantity).ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="cell-num text-foreground fw-semibold">@tx.BalanceAfter.ToString("N2")</td>
                            <td class="cell-num text-muted">@(tx.UnitPrice.HasValue && tx.UnitPrice > 0 ? $"₹{tx.UnitPrice.Value:N2}" : "—")</td>
                            <td>
                                @if (tx.ReferenceType == "PurchaseOrder" && tx.ReferenceId.HasValue)
                                {
                                    <a asp-controller="Purchase" asp-action="Details" asp-route-id="@tx.ReferenceId.Value" class="af-badge b-blue">PO #@tx.ReferenceId.Value</a>
                                }
                                else if (!string.IsNullOrEmpty(tx.ReferenceType))
                                {
                                    <span class="mono-id">@tx.ReferenceType @(tx.ReferenceId.HasValue ? $"#{tx.ReferenceId.Value}" : "")</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="text-muted">@(tx.Remarks ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Transactions.Count</strong> @(Model.Transactions.Count == 1 ? "entry" : "entries")</span>
        </div>
    }
</div>
