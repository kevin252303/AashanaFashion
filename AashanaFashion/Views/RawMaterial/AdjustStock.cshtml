@model AashanaFashion.Models.RawMaterialAdjustmentViewModel
@{
    ViewData["Title"] = "Stock Adjustment & Reconciliation";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Inventory</a>
        <h1 class="page-title">Stock Adjustment &amp; Reconciliation</h1>
        <p class="page-sub">Perform physical audit adjustments and stock corrections</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="AdjustStock" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="af-alert af-alert-danger mb-3">
                    <div class="alert-body">
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        { <div>@e.ErrorMessage</div> }
                    </div>
                    <button class="alert-close">&times;</button>
                </div>
            }

            <div class="data-card mb-3">
                <div class="data-card-header">
                    <span class="data-card-title">Adjustment</span>
                </div>
                <div class="data-card-body">
                <div class="mb-3">
                    <label class="af-label">Raw Material <span class="req">*</span></label>
                    <select name="MaterialId" class="af-input af-select" id="adjMaterialSelect" required>
                        <option value="">— Select Material —</option>
                        @foreach (var m in Model.AvailableMaterials)
                        {
                            <option value="@m.Id" data-stock="@m.CurrentStock" data-unit="@m.Unit" selected="@(m.Id == Model.MaterialId ? "selected" : null)">
                                @m.Name (Current: @m.CurrentStock @m.Unit)
                            </option>
                        }
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="af-label">Current Book Stock</label>
                        <input class="af-input fw-semibold" id="adjCurrentStock" value="@Model.CurrentStock @Model.Unit" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="af-label">Adjustment Mode <span class="req">*</span></label>
                        <select name="AdjustmentType" id="adjTypeSelect" class="af-input af-select">
                            <option value="Count" selected>Set Physical Count (Audit)</option>
                            <option value="Add">Add Quantity (+ Found / Bonus)</option>
                            <option value="Subtract">Subtract Quantity (- Damage / Loss)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3" id="countSection">
                    <label class="af-label">Actual Physical Count On-Hand <span class="req">*</span></label>
                    <input type="number" step="0.01" min="0" name="NewQuantity" id="adjNewQty" class="af-input" value="@Model.NewQuantity" />
                    <span class="af-hint">The system automatically records the difference in the Stock Ledger.</span>
                </div>

                <div class="mb-3" id="deltaSection" style="display:none;">
                    <label class="af-label" id="deltaLabel">Adjustment Quantity <span class="req">*</span></label>
                    <input type="number" step="0.01" min="0.01" name="Quantity" id="adjDeltaQty" class="af-input" value="@Model.Quantity" />
                </div>

                <div class="mb-3">
                    <label class="af-label">Reason / Remarks <span class="req">*</span></label>
                    <input type="text" name="Reason" class="af-input" placeholder="e.g., Annual physical audit, damaged fabric discarded, cutting floor scrap" required />
                </div>

                </div>
                <div class="data-card-footer d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Adjustment</button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title"><i class="bi bi-info-circle"></i> Reconciliation guidelines</span>
            </div>
            <div class="data-card-body">
                <p class="text-sm text-muted">Use this screen when verifying physical stock in the storeroom or warehouse against the software balance.</p>
                <ul class="activity-list">
                    <li class="activity-item"><div class="activity-text"><strong>Physical count</strong> — enter the exact meters or units counted. The system computes the +/− variance and updates the ledger.</div></li>
                    <li class="activity-item"><div class="activity-text"><strong>Damage / scrap</strong> — use <em>Subtract</em> when rolls are discarded due to colour bleeding, tears, or shrinkage.</div></li>
                    <li class="activity-item"><div class="activity-text"><strong>Found stock</strong> — use <em>Add</em> when unaccounted material or surplus is returned to storage.</div></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const matSelect = document.getElementById('adjMaterialSelect');
        const stockDisplay = document.getElementById('adjCurrentStock');
        const typeSelect = document.getElementById('adjTypeSelect');
        const countSection = document.getElementById('countSection');
        const deltaSection = document.getElementById('deltaSection');
        const newQtyInput = document.getElementById('adjNewQty');

        function updateMaterial() {
            const opt = matSelect.selectedOptions[0];
            if (opt && opt.value) {
                const stock = parseFloat(opt.getAttribute('data-stock')) || 0;
                const unit = opt.getAttribute('data-unit') || '';
                stockDisplay.value = stock + ' ' + unit;
                if (!newQtyInput.value || parseFloat(newQtyInput.value) === 0) {
                    newQtyInput.value = stock;
                }
            } else {
                stockDisplay.value = '—';
            }
        }

        function updateMode() {
            const mode = typeSelect.value;
            if (mode === 'Count') {
                countSection.style.display = '';
                deltaSection.style.display = 'none';
            } else {
                countSection.style.display = 'none';
                deltaSection.style.display = '';
            }
        }

        matSelect.addEventListener('change', updateMaterial);
        typeSelect.addEventListener('change', updateMode);
        updateMode();
    });
</script>
