@model AashanaFashion.Models.JobSlip
@{
    ViewData["Title"] = $"Job Slip Details — {Model.SlipNumber}";
    var order = Model.ProductionOrder;
    var design = order?.Design;
    var statusBadge = Model.Status switch {
        "Issued" => "b-blue",
        "In Process" => "b-yellow",
        "Received" => "b-green",
        "Cancelled" => "b-red",
        _ => "b-gray"
    };
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Job slips</a>
        <h1 class="page-title d-flex align-items-center gap-2">
            Job Slip #@Model.SlipNumber
            <span class="af-badge @statusBadge">@Model.Status</span>
        </h1>
        <p class="page-sub">@Model.ProcessName · Lot <strong class="text-foreground">@(order?.LotNo)</strong> · Design <strong class="text-foreground">@(design?.DesignNumber)</strong></p>
    </div>
    <div class="page-actions">
        @if (order != null)
        {
            <a asp-controller="Production" asp-action="Edit" asp-route-id="@order.Id" class="btn btn-secondary"><i class="bi bi-clipboard-data"></i> Edit lot</a>
            <a asp-action="PrintAll" asp-route-lotId="@order.Id" target="_blank" class="btn btn-secondary"><i class="bi bi-files"></i> Print all for lot</a>
        }
        <a asp-controller="WhatsApp" asp-action="JobSlip" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary">
            <i class="bi bi-whatsapp text-success"></i> WhatsApp slip
        </a>
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-primary"><i class="bi bi-printer"></i> Print challan</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="data-card mb-4">
            <div class="data-card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="micro-label">Vendor / job worker</div>
                        <div class="ql-title mb-1">@(Model.Vendor?.VendorName ?? $"Vendor #{Model.VendorId}")</div>
                        <div class="text-sm text-muted d-flex flex-column gap-1">
                            @if (!string.IsNullOrEmpty(Model.Vendor?.ContactPerson))
                            {
                                <span><i class="bi bi-person text-placeholder"></i> @Model.Vendor.ContactPerson</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Vendor?.Phone))
                            {
                                <span><i class="bi bi-telephone text-placeholder"></i> @Model.Vendor.Phone</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Vendor?.Address))
                            {
                                <span><i class="bi bi-geo-alt text-placeholder"></i> @Model.Vendor.Address</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Vendor?.GstNumber))
                            {
                                <span class="font-monospace text-xs">GSTIN @Model.Vendor.GstNumber</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="micro-label">Order &amp; process</div>
                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">Lot number</div>
                                <div class="info-value font-monospace text-sm">@(order?.LotNo ?? "—")</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Design</div>
                                <div class="info-value">@(design?.DesignNumber ?? "—")</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Process</div>
                                <span class="tag">@Model.ProcessName</span>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Rate / pc</div>
                                <div class="info-value">@(Model.Rate.HasValue ? $"₹{Model.Rate.Value:N2}" : "—")</div>
                            </div>
                            <div class="info-item" style="grid-column: 1 / -1;">
                                <div class="info-label">Components</div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var c in Model.GetComponentsList())
                                    {
                                        <span class="tag">@c</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="data-card-header">
                <span class="data-card-title">Component &amp; variant breakdown</span>
                <span class="af-badge b-indigo">@Model.TotalQuantity total pcs</span>
            </div>
            <div class="table-scroll">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">#</th>
                            <th>Component</th>
                            <th>Colour</th>
                            <th style="width:90px;">Size</th>
                            <th class="text-end" style="width:100px;">Quantity</th>
                            @if (Model.Rate.HasValue && Model.Rate.Value > 0)
                            {
                                <th class="text-end" style="width:110px;">Rate</th>
                                <th class="text-end" style="width:120px;">Amount</th>
                            }
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int idx = 1;
                            decimal sumAmount = 0;
                        }
                        @foreach (var item in Model.Items.OrderBy(i => i.ComponentName).ThenBy(i => i.Colour).ThenBy(i => i.Size))
                        {
                            var r = item.Rate ?? Model.Rate ?? 0;
                            var amt = item.Quantity * r;
                            sumAmount += amt;

                            <tr>
                                <td class="text-muted">@idx</td>
                                <td class="cell-title">@item.ComponentName</td>
                                <td>@item.Colour</td>
                                <td><span class="tag">@item.Size</span></td>
                                <td class="cell-num text-foreground fw-medium">@item.Quantity</td>
                                @if (Model.Rate.HasValue && Model.Rate.Value > 0)
                                {
                                    <td class="cell-num">₹@r.ToString("N2")</td>
                                    <td class="cell-num">₹@amt.ToString("N2")</td>
                                }
                                <td class="text-muted">@item.Remarks</td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end">Total</td>
                            <td class="cell-num">@Model.TotalQuantity</td>
                            @if (Model.Rate.HasValue && Model.Rate.Value > 0)
                            {
                                <td class="cell-num text-muted">—</td>
                                <td class="cell-num">₹@sumAmount.ToString("N2")</td>
                            }
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <form asp-action="UpdateStatus" method="post" class="data-card mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="data-card-header">
                <span class="data-card-title">Update slip status</span>
            </div>
            <div class="data-card-body">
                <div class="af-form-group">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="Issued" selected="@(Model.Status == "Issued" ? "selected" : null)">Issued (challan given to vendor)</option>
                        <option value="In Process" selected="@(Model.Status == "In Process" ? "selected" : null)">In Process (work ongoing)</option>
                        <option value="Received" selected="@(Model.Status == "Received" ? "selected" : null)">Received (goods returned from vendor)</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                    </select>
                </div>

                <div class="af-form-group">
                    <label class="form-label">Received date</label>
                    <input type="date" name="receivedDate" value="@(Model.ReceivedDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>

                <div class="af-form-group mb-0">
                    <label class="form-label">Remarks / notes</label>
                    <textarea name="remarks" rows="3" class="form-control" placeholder="Any comments or verification notes…">@Model.Remarks</textarea>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Save status</button>
            </div>
        </form>

        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Challan details</span>
            </div>
            <div class="data-card-body">
                <div class="kv-row"><span class="k">Issue date</span><span class="v">@Model.IssueDate.ToString("dd-MMM-yyyy")</span></div>
                <div class="kv-row"><span class="k">Expected return</span><span class="v">@(Model.ExpectedReturnDate.HasValue ? Model.ExpectedReturnDate.Value.ToString("dd-MMM-yyyy") : "—")</span></div>
                <div class="kv-row"><span class="k">Received date</span><span class="v">@(Model.ReceivedDate.HasValue ? Model.ReceivedDate.Value.ToString("dd-MMM-yyyy") : "—")</span></div>
                <div class="kv-row"><span class="k">Created by</span><span class="v">@(Model.CreatedBy ?? "System")</span></div>
                <div class="kv-row"><span class="k">Created on</span><span class="v">@Model.CreatedDate.ToString("dd-MMM-yyyy HH:mm")</span></div>
            </div>
        </div>
    </div>
</div>
