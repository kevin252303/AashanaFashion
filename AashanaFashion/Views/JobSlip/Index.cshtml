@model List<AashanaFashion.Models.JobSlip>
@{
    ViewData["Title"] = "Job Slips (Vendor Challans)";
    var processes = ViewBag.Processes as List<string> ?? new List<string>();
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new List<AashanaFashion.Models.Vendor>();
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="page-title mb-1">Job Work Slips (Challans)</h1>
        <p class="page-sub mb-0">Track and issue job work slips for external vendor processes & garment components.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Production" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            📋 Order Lots
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><span class="alert-body">@TempData["Success"]</span><button class="alert-close">&times;</button></div>
}
@if (TempData["Error"] != null)
{
    <div class="af-alert af-alert-danger mb-3"><span class="alert-body">@TempData["Error"]</span><button class="alert-close">&times;</button></div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card p-3 border rounded-3 bg-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Slips</div>
                    <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalSlips ?? Model.Count)</div>
                </div>
                <div class="p-2 bg-light rounded text-muted fs-4">📑</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card p-3 border rounded-3 bg-white shadow-sm border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Issued</div>
                    <div class="fs-4 fw-bold text-primary">@(ViewBag.IssuedSlips ?? 0)</div>
                </div>
                <div class="p-2 bg-primary-subtle text-primary rounded fs-4">📤</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card p-3 border rounded-3 bg-white shadow-sm border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">In Process</div>
                    <div class="fs-4 fw-bold text-warning">@(ViewBag.InProcessSlips ?? 0)</div>
                </div>
                <div class="p-2 bg-warning-subtle text-warning rounded fs-4">⚡</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card p-3 border rounded-3 bg-white shadow-sm border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Received Back</div>
                    <div class="fs-4 fw-bold text-success">@(ViewBag.ReceivedSlips ?? 0)</div>
                </div>
                <div class="p-2 bg-success-subtle text-success rounded fs-4">📥</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Toolbar -->
<div class="card p-3 border rounded-3 bg-white shadow-sm mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3 col-sm-6">
            <label class="form-label small text-muted mb-1">Search Keyword</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Slip #, Lot #, Design, Vendor..." class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1">Process</label>
            <select name="process" class="form-select form-select-sm">
                <option value="">— All Processes —</option>
                @foreach (var proc in processes)
                {
                    <option value="@proc" selected="@(ViewBag.SelectedProcess == proc ? "selected" : null)">@proc</option>
                }
            </select>
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label small text-muted mb-1">Vendor / Job Worker</label>
            <select name="vendorId" class="form-select form-select-sm">
                <option value="">— All Vendors —</option>
                @foreach (var v in vendors)
                {
                    <option value="@v.Id" selected="@(ViewBag.SelectedVendorId == v.Id ? "selected" : null)">@v.VendorName</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small text-muted mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">— All Statuses —</option>
                <option value="Issued" selected="@(ViewBag.SelectedStatus == "Issued" ? "selected" : null)">Issued</option>
                <option value="In Process" selected="@(ViewBag.SelectedStatus == "In Process" ? "selected" : null)">In Process</option>
                <option value="Received" selected="@(ViewBag.SelectedStatus == "Received" ? "selected" : null)">Received</option>
                <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled" ? "selected" : null)">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2 col-sm-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </form>
</div>

<!-- Job Slips Table -->
<div class="card border rounded-3 bg-white shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <div style="font-size:2.5rem;" class="mb-2">📑</div>
            <h6>No Job Slips Found</h6>
            <p class="small mb-0">Job slips are automatically created when processes are assigned to external vendors in production order lots.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Slip #</th>
                        <th>Lot No.</th>
                        <th>Design</th>
                        <th>Process</th>
                        <th>Vendor (Job Worker)</th>
                        <th>Assigned Component(s)</th>
                        <th class="text-center">Total Pcs</th>
                        <th class="text-end">Rate / Total</th>
                        <th class="text-center">Status</th>
                        <th>Issue Date</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slip in Model)
                    {
                        var statusBadge = slip.Status switch {
                            "Issued" => "bg-primary text-white",
                            "In Process" => "bg-warning text-dark",
                            "Received" => "bg-success text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };

                        <tr>
                            <td class="ps-3 fw-bold font-monospace">
                                <a asp-action="Details" asp-route-id="@slip.Id" class="text-decoration-none">
                                    @slip.SlipNumber
                                </a>
                            </td>
                            <td>
                                @if (slip.ProductionOrder != null)
                                {
                                    <a asp-controller="Production" asp-action="Edit" asp-route-id="@slip.ProductionOrderId" class="fw-semibold text-dark text-decoration-none">
                                        @slip.ProductionOrder.LotNo
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted font-monospace">Lot #@slip.ProductionOrderId</span>
                                }
                            </td>
                            <td>
                                <strong>@(slip.ProductionOrder?.Design?.DesignNumber ?? "—")</strong>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@slip.ProcessName</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(slip.Vendor?.VendorName ?? $"Vendor #{slip.VendorId}")</div>
                                @if (!string.IsNullOrEmpty(slip.Vendor?.Phone))
                                {
                                    <small class="text-muted">📞 @slip.Vendor.Phone</small>
                                }
                            </td>
                            <td>
                                @foreach (var comp in slip.GetComponentsList())
                                {
                                    <span class="badge bg-light text-secondary border me-1">@comp</span>
                                }
                            </td>
                            <td class="text-center fw-bold">
                                @slip.TotalQuantity <span class="text-muted fw-normal" style="font-size:0.75rem;">pcs</span>
                            </td>
                            <td class="text-end">
                                @if (slip.Rate.HasValue && slip.Rate > 0)
                                {
                                    <span class="font-monospace">₹@slip.Rate.Value.ToString("N2")/pc</span>
                                    @if (slip.TotalAmount.HasValue && slip.TotalAmount > 0)
                                    {
                                        <br /><small class="text-muted fw-bold">₹@slip.TotalAmount.Value.ToString("N2")</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge px-2 py-1">@slip.Status</span>
                            </td>
                            <td style="font-size:0.8rem; color:#64748b;">
                                @slip.IssueDate.ToString("dd-MMM-yyyy")
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Print" asp-route-id="@slip.Id" target="_blank" class="btn btn-outline-primary" title="Print Challan">
                                        🖨️
                                    </a>
                                    <a asp-action="Details" asp-route-id="@slip.Id" class="btn btn-outline-secondary" title="View Details / Update Status">
                                        👁️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
