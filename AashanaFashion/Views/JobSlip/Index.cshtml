@model List<AashanaFashion.Models.JobSlip>
@{
    ViewData["Title"] = "Job Slips (Vendor Challans)";
    var processes = ViewBag.Processes as List<string> ?? new List<string>();
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new List<AashanaFashion.Models.Vendor>();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Job Work Slips (Challans)</h1>
        <p class="page-sub">Track and issue job work slips for external vendor processes &amp; garment components.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Production" asp-action="Index" class="btn btn-secondary"><i class="bi bi-clipboard-data"></i> Order lots</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total slips</div>
        <div class="metric-value">@(ViewBag.TotalSlips ?? Model.Count)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Issued</div>
        <div class="metric-value">@(ViewBag.IssuedSlips ?? 0)</div>
        <div class="metric-meta info">sent to vendors</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">In process</div>
        <div class="metric-value">@(ViewBag.InProcessSlips ?? 0)</div>
        <div class="metric-meta warning">work underway</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Received back</div>
        <div class="metric-value">@(ViewBag.ReceivedSlips ?? 0)</div>
        <div class="metric-meta success">returned from vendors</div>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="jsSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="jsSearch" name="search" value="@ViewBag.Search" placeholder="Slip #, lot #, design, vendor…" class="af-input" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="jsProcess">Process</label>
                <select id="jsProcess" name="process" class="af-input af-select">
                    <option value="">All processes</option>
                    @foreach (var proc in processes)
                    {
                        <option value="@proc" selected="@(ViewBag.SelectedProcess == proc ? "selected" : null)">@proc</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="jsVendor">Vendor / job worker</label>
                <select id="jsVendor" name="vendorId" class="af-input af-select">
                    <option value="">All vendors</option>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.Id" selected="@(ViewBag.SelectedVendorId == v.Id ? "selected" : null)">@v.VendorName</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="jsStatus">Status</label>
                <select id="jsStatus" name="status" class="af-input af-select">
                    <option value="">All statuses</option>
                    <option value="Issued" selected="@(ViewBag.SelectedStatus == "Issued" ? "selected" : null)">Issued</option>
                    <option value="In Process" selected="@(ViewBag.SelectedStatus == "In Process" ? "selected" : null)">In Process</option>
                    <option value="Received" selected="@(ViewBag.SelectedStatus == "Received" ? "selected" : null)">Received</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled" ? "selected" : null)">Cancelled</option>
                </select>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" class="btn btn-ghost">Clear</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-files"></i></div>
            <div class="es-title">No job slips found</div>
            <p>Job slips are created automatically when processes are assigned to external vendors in production order lots.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Slip #</th>
                        <th>Lot</th>
                        <th>Design</th>
                        <th>Process</th>
                        <th>Vendor (Job Worker)</th>
                        <th>Component(s)</th>
                        <th class="text-end">Total Pcs</th>
                        <th class="text-end">Rate / Total</th>
                        <th>Status</th>
                        <th>Issue Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slip in Model)
                    {
                        var statusBadge = slip.Status switch {
                            "Issued" => "b-blue",
                            "In Process" => "b-yellow",
                            "Received" => "b-green",
                            "Cancelled" => "b-red",
                            _ => "b-gray"
                        };

                        <tr>
                            <td><a asp-action="Details" asp-route-id="@slip.Id" class="font-monospace fw-medium">@slip.SlipNumber</a></td>
                            <td>
                                @if (slip.ProductionOrder != null)
                                {
                                    <a asp-controller="Production" asp-action="Edit" asp-route-id="@slip.ProductionOrderId" class="mono-id">@slip.ProductionOrder.LotNo</a>
                                }
                                else
                                {
                                    <span class="mono-id">Lot #@slip.ProductionOrderId</span>
                                }
                            </td>
                            <td><span class="cell-title">@(slip.ProductionOrder?.Design?.DesignNumber ?? "—")</span></td>
                            <td><span class="tag">@slip.ProcessName</span></td>
                            <td>
                                <span class="cell-title">@(slip.Vendor?.VendorName ?? $"Vendor #{slip.VendorId}")</span>
                                @if (!string.IsNullOrEmpty(slip.Vendor?.Phone))
                                {
                                    <span class="cell-sub">@slip.Vendor.Phone</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var comp in slip.GetComponentsList())
                                    {
                                        <span class="tag">@comp</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-num"><span class="text-foreground fw-medium">@slip.TotalQuantity</span> <span class="text-xs text-muted">pcs</span></td>
                            <td class="cell-num">
                                @if (slip.Rate.HasValue && slip.Rate > 0)
                                {
                                    <span>₹@slip.Rate.Value.ToString("N2")/pc</span>
                                    @if (slip.TotalAmount.HasValue && slip.TotalAmount > 0)
                                    {
                                        <span class="cell-sub">₹@slip.TotalAmount.Value.ToString("N2")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td><span class="af-badge @statusBadge">@slip.Status</span></td>
                            <td class="text-muted text-nowrap">@slip.IssueDate.ToString("dd-MMM-yyyy")</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Print" asp-route-id="@slip.Id" target="_blank" class="row-action" title="Print challan" aria-label="Print challan"><i class="bi bi-printer"></i></a>
                                    <a asp-action="Details" asp-route-id="@slip.Id" class="row-action primary" title="View details / update status" aria-label="View details"><i class="bi bi-box-arrow-up-right"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count</strong> @(Model.Count == 1 ? "slip" : "slips")</span>
        </div>
    }
</div>
