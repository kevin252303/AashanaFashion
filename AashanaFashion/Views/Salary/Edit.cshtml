@model AashanaFashion.Models.SalaryRecord
@{
    ViewData["Title"] = $"Adjust Salary — {Model.Employee?.FullName}";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Payroll</a></li>
            <li class="breadcrumb-item active">Adjust Salary</li>
        </ol>
    </nav>
    <h2 class="mb-0 fw-bold">✏️ Adjust Salary Record — @Model.Employee?.FullName</h2>
    <p class="text-muted">Month: @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year • Code: @Model.Employee?.EmployeeCode</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm rounded-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EmployeeId" />
            <input type="hidden" asp-for="Year" />
            <input type="hidden" asp-for="Month" />

            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">Earnings & Deductions Breakdown</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="BaseSalaryEarned" class="form-label fw-semibold">Base Salary Earned (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="BaseSalaryEarned" type="number" step="0.01" class="form-control" id="baseEarnedInput" />
                        </div>
                        <small class="text-muted">Attendance: @Model.DaysPresent / @Model.TotalWorkingDays days (@Model.TotalHoursWorked hrs)</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OvertimePay" class="form-label fw-semibold">Overtime Pay (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="OvertimePay" type="number" step="0.01" class="form-control" id="otPayInput" />
                        </div>
                        <small class="text-muted">Logged OT: @Model.TotalOvertimeHours hours</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BonusAllowance" class="form-label fw-semibold">Bonus / Performance Allowance (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text text-success">+₹</span>
                            <input asp-for="BonusAllowance" type="number" step="0.01" class="form-control" id="bonusInput" />
                        </div>
                        <small class="text-muted">Additional incentives or festive bonus.</small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Deductions" class="form-label fw-semibold">Deductions / Salary Advance (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text text-danger">-₹</span>
                            <input asp-for="Deductions" type="number" step="0.01" class="form-control" id="deductionsInput" />
                        </div>
                        <small class="text-muted">Advances taken, damage, or penalties.</small>
                    </div>

                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase">Calculated Net Payable:</span>
                                <h3 class="fw-bold my-0 text-primary" id="netSalaryDisplay">₹@Model.NetSalary.ToString("N2")</h3>
                            </div>
                            <span class="badge bg-secondary fs-6">Status: @Model.PaymentStatus</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label fw-semibold">Adjustment Remarks / Notes</label>
                        <textarea asp-for="Remarks" rows="2" class="form-control" placeholder="Reason for adjustments..."></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white py-3 border-top d-flex justify-content-between">
                <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    💾 Save Salary Adjustments
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateNet() {
            const base = parseFloat($('#baseEarnedInput').val()) || 0;
            const ot = parseFloat($('#otPayInput').val()) || 0;
            const bonus = parseFloat($('#bonusInput').val()) || 0;
            const ded = parseFloat($('#deductionsInput').val()) || 0;
            const net = base + ot + bonus - ded;
            $('#netSalaryDisplay').text('₹' + net.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        $('#baseEarnedInput, #otPayInput, #bonusInput, #deductionsInput').on('input', updateNet);
    </script>
}
