@model AashanaFashion.Models.SalaryRecord
@{
    ViewData["Title"] = $"Adjust Salary — {Model.Employee?.FullName}";
    string monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month);
}

<div class="page-header">
    <div>
        <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="page-back"><i class="bi bi-arrow-left"></i> Payroll</a>
        <h1 class="page-title">Adjust salary — @Model.Employee?.FullName</h1>
        <p class="page-sub">@monthName @Model.Year · <span class="font-monospace">@Model.Employee?.EmployeeCode</span></p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EmployeeId" />
    <input type="hidden" asp-for="Year" />
    <input type="hidden" asp-for="Month" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="data-card">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Earnings &amp; deductions</div>
                        <div class="data-card-sub">Attendance: @Model.DaysPresent / @Model.TotalWorkingDays days · @Model.TotalHoursWorked hrs · OT @Model.TotalOvertimeHours hrs</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BaseSalaryEarned" class="form-label">Base salary earned</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BaseSalaryEarned" type="number" step="0.01" class="af-input" id="baseEarnedInput" />
                            </div>
                            <div class="form-text">From @Model.DaysPresent days present.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OvertimePay" class="form-label">Overtime pay</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="OvertimePay" type="number" step="0.01" class="af-input" id="otPayInput" />
                            </div>
                            <div class="form-text">Logged OT: @Model.TotalOvertimeHours hours.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BonusAllowance" class="form-label">Bonus / performance allowance</label>
                            <div class="input-group">
                                <span class="input-group-text text-success">+₹</span>
                                <input asp-for="BonusAllowance" type="number" step="0.01" class="af-input" id="bonusInput" />
                            </div>
                            <div class="form-text">Additional incentives or festive bonus.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Deductions" class="form-label">Deductions / salary advance</label>
                            <div class="input-group">
                                <span class="input-group-text text-danger">−₹</span>
                                <input asp-for="Deductions" type="number" step="0.01" class="af-input" id="deductionsInput" />
                            </div>
                            <div class="form-text">Advances taken, damage or penalties.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label">Adjustment remarks</label>
                            <textarea asp-for="Remarks" rows="2" class="af-input" placeholder="Reason for adjustments…"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save adjustments</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="metric-card">
                <div class="metric-label">Net payable</div>
                <div class="metric-value" id="netSalaryDisplay">₹@Model.NetSalary.ToString("N2")</div>
                <div class="metric-meta">base + overtime + bonus − deductions</div>
                <div class="mt-3">
                    <span class="af-badge @(Model.PaymentStatus == AashanaFashion.Models.PayrollStatus.Paid ? "b-green" : "b-yellow")">@Model.PaymentStatus.Humanize()</span>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updateNet() {
            const base = parseFloat($('#baseEarnedInput').val()) || 0;
            const ot = parseFloat($('#otPayInput').val()) || 0;
            const bonus = parseFloat($('#bonusInput').val()) || 0;
            const ded = parseFloat($('#deductionsInput').val()) || 0;
            const net = base + ot + bonus - ded;
            $('#netSalaryDisplay').text('₹' + net.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        $('#baseEarnedInput, #otPayInput, #bonusInput, #deductionsInput').on('input', updateNet);
    </script>
}
