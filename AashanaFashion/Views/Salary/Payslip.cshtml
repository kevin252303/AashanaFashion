@model AashanaFashion.Models.SalaryRecord
@{
    ViewData["Title"] = $"Payslip — {Model.Employee?.FullName} — {ViewBag.MonthName} {Model.Year}";
    var emp = Model.Employee!;
    string monthName = ViewBag.MonthName ?? "";
    bool paid = Model.PaymentStatus == AashanaFashion.Models.PayrollStatus.Paid;
}

<div class="page-header d-print-none">
    <div>
        <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="page-back"><i class="bi bi-arrow-left"></i> Payroll</a>
        <h1 class="page-title">Payslip — @emp.FullName</h1>
        <p class="page-sub">@monthName @Model.Year · <span class="font-monospace">@emp.EmployeeCode</span></p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Adjust</a>
        <button type="button" onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer"></i> Print / save PDF</button>
    </div>
</div>

<div class="data-card payslip">
    <div class="payslip-watermark" aria-hidden="true">
        <img src="/images/aashana_watermark.png" alt="" />
    </div>

    <div class="payslip-head">
        <div class="payslip-brand">
            <span class="brand-mark">AF</span>
            <div>
                <div class="payslip-company">Aashana Fashion</div>
                <div class="text-xs text-muted">Apparel Manufacturing, Job Work &amp; Export House</div>
                <div class="text-xs text-muted">Plot 14-16, Garment Industrial Zone, Surat, Gujarat</div>
            </div>
        </div>
        <div class="payslip-period">
            <span class="micro-label">Salary slip</span>
            <strong>@monthName @Model.Year</strong>
            <span class="text-xs text-muted">Generated @Model.GeneratedDate.ToString("dd MMM yyyy")</span>
        </div>
    </div>

    <div class="info-grid cols-4 panel-inset mb-4">
        <div>
            <div class="info-label">Employee name</div>
            <div class="info-value">@emp.FullName</div>
        </div>
        <div>
            <div class="info-label">Employee code</div>
            <div class="info-value font-monospace">@emp.EmployeeCode</div>
        </div>
        <div>
            <div class="info-label">Department</div>
            <div class="info-value">@emp.Department</div>
        </div>
        <div>
            <div class="info-label">Designation</div>
            <div class="info-value">@emp.Designation</div>
        </div>
        <div>
            <div class="info-label">Salary mode</div>
            <div class="info-value">@emp.SalaryType.Humanize() · ₹@emp.BaseRate.ToString("N2")</div>
        </div>
        <div>
            <div class="info-label">Joining date</div>
            <div class="info-value">@emp.JoiningDate.ToString("dd/MM/yyyy")</div>
        </div>
        <div>
            <div class="info-label">Bank / UPI</div>
            <div class="info-value">@(string.IsNullOrWhiteSpace(emp.UpiId) ? (emp.BankName ?? "Cash") : emp.UpiId)</div>
        </div>
        <div>
            <div class="info-label">Payment status</div>
            <div class="info-value"><span class="af-badge @(paid ? "b-green" : "b-yellow")">@Model.PaymentStatus.Humanize()</span></div>
        </div>
    </div>

    <div class="section-label">Attendance &amp; shift summary</div>
    <div class="payslip-stats">
        <div><div class="info-label">Month days</div><div class="info-value">@Model.TotalWorkingDays</div></div>
        <div><div class="info-label">Present</div><div class="info-value text-success">@Model.DaysPresent</div></div>
        <div><div class="info-label">Half days</div><div class="info-value text-warning">@Model.HalfDays</div></div>
        <div><div class="info-label">Absent</div><div class="info-value text-danger">@Model.DaysAbsent</div></div>
        <div><div class="info-label">Total hours</div><div class="info-value">@Model.TotalHoursWorked</div></div>
        <div><div class="info-label">OT hours</div><div class="info-value text-success">+@Model.TotalOvertimeHours</div></div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="payslip-ledger">
                <table class="af-table">
                    <thead>
                        <tr><th>Earnings</th><th class="text-end">Amount (₹)</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Base wages earned</td>
                            <td class="cell-num">@Model.BaseSalaryEarned.ToString("N2")</td>
                        </tr>
                        @if (Model.OvertimePay > 0)
                        {
                            <tr>
                                <td>Overtime pay (@Model.TotalOvertimeHours hrs)</td>
                                <td class="cell-num text-success">+@Model.OvertimePay.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.BonusAllowance > 0)
                        {
                            <tr>
                                <td>Performance bonus / allowance</td>
                                <td class="cell-num text-success">+@Model.BonusAllowance.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Gross earnings</td>
                            <td class="cell-num">₹@((Model.BaseSalaryEarned + Model.OvertimePay + Model.BonusAllowance).ToString("N2"))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <div class="payslip-ledger">
                <table class="af-table">
                    <thead>
                        <tr><th>Deductions</th><th class="text-end">Amount (₹)</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Salary advance / floor cash</td>
                            <td class="cell-num">@Model.Deductions.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>TDS / professional tax</td>
                            <td class="cell-num">0.00</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Total deductions</td>
                            <td class="cell-num text-danger">₹@Model.Deductions.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="payslip-net">
        <div>
            <span class="micro-label">Net salary payable</span>
            <div class="net-amount">₹@Model.NetSalary.ToString("N2")</div>
            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <div class="text-xs text-muted">Remarks: @Model.Remarks</div>
            }
        </div>
        <div class="text-end">
            @if (paid)
            {
                <span class="af-badge b-green">Paid via @(Model.PaymentMethod ?? "Cash")</span>
                @if (!string.IsNullOrWhiteSpace(Model.PaymentReference))
                {
                    <div class="text-xs text-muted mt-1 font-monospace">Ref: @Model.PaymentReference</div>
                }
                @if (Model.PaidDate.HasValue)
                {
                    <div class="text-xs text-muted">Paid on @Model.PaidDate.Value.ToString("dd/MM/yyyy")</div>
                }
            }
            else
            {
                <span class="af-badge b-yellow">Payment pending</span>
            }
        </div>
    </div>

    <div class="payslip-signs">
        <div>Employee signature</div>
        <div>Authorized signatory<br />Aashana Fashion</div>
    </div>
</div>
