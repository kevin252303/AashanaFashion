@model AashanaFashion.Models.PayrollSummaryViewModel
@{
    ViewData["Title"] = $"Payroll — {Model.MonthName} {Model.Year}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold">💵 Employee Salary & Payroll</h2>
        <p class="text-muted mb-0">Automatic wage computation based on biometric attendance, overtime, and deductions.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="GeneratePayroll" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="month" value="@Model.Month" />
            <button type="submit" class="btn btn-primary" onclick="return confirm('Calculate payroll for @Model.MonthName @Model.Year based on logged attendance?');">
                ⚡ Calculate / Run Payroll
            </button>
        </form>
        <a asp-controller="Attendance" asp-action="MonthlyReport" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">
            📊 Attendance Grid
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show af-alert mb-4" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}

<!-- Filters & Month Selection -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="small text-muted fw-semibold">Select Month:</label>
                <select name="month" class="form-select" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="small text-muted fw-semibold">Select Year:</label>
                <select name="year" class="form-select" onchange="this.form.submit()">
                    @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">Load Month</button>
            </div>
        </form>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center border-start border-primary border-4">
            <span class="text-muted small text-uppercase">Total Net Payroll</span>
            <h3 class="fw-bold my-1 text-primary">₹@Model.TotalNetPayable.ToString("N2")</h3>
            <small class="text-muted">For @Model.TotalEmployees Employees</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center border-start border-success border-4">
            <span class="text-muted small text-uppercase">Base Wages Earned</span>
            <h3 class="fw-bold my-1 text-success">₹@Model.TotalGrossSalary.ToString("N2")</h3>
            <small class="text-muted">Standard Working Hours</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center border-start border-info border-4">
            <span class="text-muted small text-uppercase">Overtime Pay</span>
            <h3 class="fw-bold my-1 text-info">₹@Model.TotalOvertimePay.ToString("N2")</h3>
            <small class="text-muted">Extra Shifts Worked</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center border-start border-warning border-4">
            <span class="text-muted small text-uppercase">Deductions / Advances</span>
            <h3 class="fw-bold my-1 text-danger">-₹@Model.TotalDeductions.ToString("N2")</h3>
            <small class="text-muted">Taxes & Floor Advances</small>
        </div>
    </div>
</div>

<!-- Payroll Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
            📋 Payroll Register — @Model.MonthName @Model.Year
        </h5>
        <div>
            <span class="badge bg-success me-1">Paid: @Model.PaidCount</span>
            <span class="badge bg-warning text-dark">Pending: @Model.PendingCount</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Employee</th>
                    <th>Salary Mode</th>
                    <th>Attendance</th>
                    <th>Base Earned</th>
                    <th>Overtime</th>
                    <th>Bonus / Ded.</th>
                    <th>Net Payable</th>
                    <th>Status</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <div class="fs-1 mb-2">💵</div>
                            <p class="mb-2">No payroll records generated for @Model.MonthName @Model.Year yet.</p>
                            <form asp-action="GeneratePayroll" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="year" value="@Model.Year" />
                                <input type="hidden" name="month" value="@Model.Month" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    Calculate Payroll Now
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model.Records)
                    {
                        var emp = r.Employee!;
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">@emp.FullName</div>
                                <small class="text-muted font-monospace">@emp.EmployeeCode • @emp.Department</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@emp.SalaryType</span>
                                <div class="small text-muted">₹@emp.BaseRate:N2</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@r.DaysPresent / @r.TotalWorkingDays Days</div>
                                <small class="text-muted">@r.TotalHoursWorked hrs (OT: @r.TotalOvertimeHours hrs)</small>
                            </td>
                            <td class="fw-bold">
                                ₹@r.BaseSalaryEarned.ToString("N2")
                            </td>
                            <td>
                                @if (r.OvertimePay > 0)
                                {
                                    <span class="text-success fw-bold">+₹@r.OvertimePay.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">₹0.00</span>
                                }
                            </td>
                            <td>
                                @if (r.BonusAllowance > 0)
                                {
                                    <div class="text-success small">+₹@r.BonusAllowance:N2 Bonus</div>
                                }
                                @if (r.Deductions > 0)
                                {
                                    <div class="text-danger small">-₹@r.Deductions:N2 Ded.</div>
                                }
                                @if (r.BonusAllowance == 0 && r.Deductions == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold fs-6 text-primary">₹@r.NetSalary.ToString("N2")</span>
                            </td>
                            <td>
                                @if (r.PaymentStatus == AashanaFashion.Models.PayrollStatus.Paid)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        ✅ Paid (@(r.PaymentMethod ?? "Cash"))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        ⏳ Pending
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Payslip" asp-route-id="@r.Id" class="btn btn-outline-dark" title="View & Print Payslip">
                                        📄 Payslip
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-secondary" title="Adjust Bonus / Deductions">
                                        ✏️ Adjust
                                    </a>
                                    @if (r.PaymentStatus != AashanaFashion.Models.PayrollStatus.Paid)
                                    {
                                        <button type="button" class="btn btn-outline-success btnMarkPaidModal"
                                                data-id="@r.Id"
                                                data-name="@emp.FullName"
                                                data-amount="@r.NetSalary.ToString("N2")"
                                                data-upi="@emp.UpiId"
                                                data-bank="@emp.BankName @emp.BankAccountNumber">
                                            💵 Pay
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Mark as Paid -->
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="MarkPaid" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="paidRecordId" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold">💵 Record Salary Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="text-muted small">Employee:</div>
                    <h5 class="fw-bold mb-1" id="paidEmpName">—</h5>
                    <div class="text-muted small">Payable Amount:</div>
                    <h4 class="fw-bold text-success mb-1" id="paidAmount">₹0.00</h4>
                    <div class="small text-muted" id="paidDetails"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Payment Method <span class="text-danger">*</span></label>
                    <select name="paymentMethod" class="form-select" required>
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI (PhonePe / GPay / Paytm)</option>
                        <option value="Bank Transfer">Bank Transfer (NEFT / IMPS)</option>
                        <option value="Cheque">Cheque</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Transaction Reference / Cheque No</label>
                    <input type="text" name="paymentRef" class="form-control" placeholder="e.g. UTR12345678 or Cash Voucher #42" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success">Confirm Payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $('.btnMarkPaidModal').on('click', function () {
            const btn = $(this);
            $('#paidRecordId').val(btn.data('id'));
            $('#paidEmpName').text(btn.data('name'));
            $('#paidAmount').text('₹' + btn.data('amount'));
            
            let det = '';
            if (btn.data('upi')) det += `UPI: ${btn.data('upi')} `;
            if (btn.data('bank')) det += `Bank: ${btn.data('bank')}`;
            $('#paidDetails').text(det);

            $('#markPaidModal').modal('show');
        });
    </script>
}
