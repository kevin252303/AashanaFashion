@model AashanaFashion.Models.PayrollSummaryViewModel
@{
    ViewData["Title"] = $"Payroll — {Model.MonthName} {Model.Year}";
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Department as string) || ViewBag.Status != null;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Salary &amp; Payroll</h1>
        <p class="page-sub">Wages computed from biometric attendance, overtime and deductions for @Model.MonthName @Model.Year.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Attendance" asp-action="MonthlyReport" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-secondary">
            <i class="bi bi-grid-3x3"></i> Attendance grid
        </a>
        <form asp-action="GeneratePayroll" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="year" value="@Model.Year" />
            <input type="hidden" name="month" value="@Model.Month" />
            <button type="submit" class="btn btn-primary" onclick="return confirm('Calculate payroll for @Model.MonthName @Model.Year based on logged attendance?');">
                <i class="bi bi-lightning-charge"></i> Run payroll
            </button>
        </form>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total net payroll</div>
        <div class="metric-value">₹@Model.TotalNetPayable.ToString("N2")</div>
        <div class="metric-meta">for @Model.TotalEmployees employees</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Base wages earned</div>
        <div class="metric-value">₹@Model.TotalGrossSalary.ToString("N2")</div>
        <div class="metric-meta">standard working hours</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Overtime pay</div>
        <div class="metric-value">₹@Model.TotalOvertimePay.ToString("N2")</div>
        <div class="metric-meta success">extra shifts worked</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Deductions / advances</div>
        <div class="metric-value">−₹@Model.TotalDeductions.ToString("N2")</div>
        <div class="metric-meta danger">taxes &amp; floor advances</div>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="pySearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="pySearch" name="search" value="@ViewBag.Search" placeholder="Code, name, role…" class="af-input" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="pyMonth">Month</label>
                <select id="pyMonth" name="month" class="af-input af-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="pyYear">Year</label>
                <select id="pyYear" name="year" class="af-input af-select">
                    @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="pyDept">Department</label>
                <select id="pyDept" name="department" class="af-input af-select">
                    <option value="">All departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == ViewBag.Department)">@d</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="pyStatus">Status</label>
                <select id="pyStatus" name="status" class="af-input af-select">
                    <option value="">All statuses</option>
                    @foreach (AashanaFashion.Models.PayrollStatus st in Enum.GetValues(typeof(AashanaFashion.Models.PayrollStatus)))
                    {
                        <option value="@st" selected="@(ViewBag.Status != null && (AashanaFashion.Models.PayrollStatus)ViewBag.Status == st)">@st.Humanize()</option>
                    }
                </select>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    <div class="data-card-header">
        <span class="data-card-title">Payroll register — @Model.MonthName @Model.Year</span>
        <div class="d-flex gap-2">
            <span class="af-badge b-green">Paid @Model.PaidCount</span>
            <span class="af-badge b-yellow">Pending @Model.PendingCount</span>
        </div>
    </div>

    @if (!Model.Records.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="es-title">No payroll records yet</div>
            <p>No payroll has been generated for @Model.MonthName @Model.Year.</p>
            <form asp-action="GeneratePayroll" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <button type="submit" class="btn btn-secondary">Calculate payroll now</button>
            </form>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Salary mode</th>
                        <th>Attendance</th>
                        <th class="text-end">Base earned</th>
                        <th class="text-end">Overtime</th>
                        <th class="text-end">Bonus / ded.</th>
                        <th class="text-end">Net payable</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Records)
                    {
                        var emp = r.Employee!;
                        <tr>
                            <td>
                                <span class="cell-title">@emp.FullName</span>
                                <span class="cell-sub"><span class="font-monospace">@emp.EmployeeCode</span> · @emp.Department</span>
                            </td>
                            <td>
                                <span class="af-badge b-gray">@emp.SalaryType.Humanize()</span>
                                <span class="cell-sub tabular">₹@emp.BaseRate.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="text-foreground fw-medium tabular">@r.DaysPresent / @r.TotalWorkingDays days</span>
                                <span class="cell-sub">@r.TotalHoursWorked hrs · OT @r.TotalOvertimeHours hrs</span>
                            </td>
                            <td class="cell-num text-foreground">₹@r.BaseSalaryEarned.ToString("N2")</td>
                            <td class="cell-num">
                                @if (r.OvertimePay > 0)
                                {
                                    <span class="text-success">+₹@r.OvertimePay.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="cell-num">
                                @if (r.BonusAllowance > 0)
                                {
                                    <span class="d-block text-success">+₹@r.BonusAllowance.ToString("N2")</span>
                                }
                                @if (r.Deductions > 0)
                                {
                                    <span class="d-block text-danger">−₹@r.Deductions.ToString("N2")</span>
                                }
                                @if (r.BonusAllowance == 0 && r.Deductions == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="cell-num"><span class="text-foreground fw-semibold">₹@r.NetSalary.ToString("N2")</span></td>
                            <td>
                                @if (r.PaymentStatus == AashanaFashion.Models.PayrollStatus.Paid)
                                {
                                    <span class="af-badge b-green">Paid · @(r.PaymentMethod ?? "Cash")</span>
                                }
                                else
                                {
                                    <span class="af-badge b-yellow">Pending</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (r.PaymentStatus != AashanaFashion.Models.PayrollStatus.Paid)
                                    {
                                        <button type="button" class="btn btn-sm btn-secondary me-1 btnMarkPaidModal"
                                                data-id="@r.Id"
                                                data-name="@emp.FullName"
                                                data-amount="@r.NetSalary.ToString("N2")"
                                                data-upi="@emp.UpiId"
                                                data-bank="@emp.BankName @emp.BankAccountNumber">
                                            <i class="bi bi-cash"></i> Pay
                                        </button>
                                    }
                                    <a asp-action="Payslip" asp-route-id="@r.Id" class="row-action" title="View &amp; print payslip" aria-label="Payslip"><i class="bi bi-file-earmark-text"></i></a>
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="row-action" title="Adjust bonus / deductions" aria-label="Adjust"><i class="bi bi-pencil"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Records.Count()</strong> @(Model.Records.Count() == 1 ? "record" : "records")</span>
        </div>
    }
</div>

<div class="modal fade" id="markPaidModal" tabindex="-1" aria-labelledby="markPaidTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="MarkPaid" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="paidRecordId" />
            <div class="modal-header">
                <h5 class="modal-title" id="markPaidTitle">Record salary payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="panel-inset">
                    <div class="kv-row"><span class="k">Employee</span><span class="v" id="paidEmpName">—</span></div>
                    <div class="kv-row"><span class="k">Payable amount</span><span class="v text-success" id="paidAmount">₹0.00</span></div>
                    <div class="text-xs text-muted" id="paidDetails"></div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="paidMethod">Payment method <span class="req">*</span></label>
                    <select name="paymentMethod" id="paidMethod" class="af-input af-select" required>
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI (PhonePe / GPay / Paytm)</option>
                        <option value="Bank Transfer">Bank transfer (NEFT / IMPS)</option>
                        <option value="Cheque">Cheque</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="paidRef">Transaction reference / cheque no.</label>
                    <input type="text" name="paymentRef" id="paidRef" class="af-input" placeholder="e.g. UTR12345678 or Cash Voucher #42" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Confirm payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $('.btnMarkPaidModal').on('click', function () {
            const btn = $(this);
            $('#paidRecordId').val(btn.data('id'));
            $('#paidEmpName').text(btn.data('name'));
            $('#paidAmount').text('₹' + btn.data('amount'));
            
            let det = '';
            if (btn.data('upi')) det += `UPI: ${btn.data('upi')} `;
            if (btn.data('bank')) det += `Bank: ${btn.data('bank')}`;
            $('#paidDetails').text(det);

            $('#markPaidModal').modal('show');
        });
    </script>
}
