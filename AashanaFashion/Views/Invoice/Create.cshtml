@model AashanaFashion.Models.CreateInvoiceViewModel
@{
    ViewData["Title"] = "Create GST Tax Invoice";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Tax invoices</a>
        <h1 class="page-title">New GST tax invoice</h1>
        <p class="page-sub">Generate a GST-compliant tax invoice auto-fetched from delivered quantities.</p>
    </div>
</div>

<form asp-action="Create" method="post" id="invoiceForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Invoice &amp; order linkage</div>
                        <div class="data-card-sub">Select a sales order or shipment to auto-fetch delivered quantities.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="InvoiceNumber" class="form-label"></label>
                            <input asp-for="InvoiceNumber" class="af-input font-monospace" />
                            <span asp-validation-for="InvoiceNumber" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InvoiceDate" class="form-label"></label>
                            <input asp-for="InvoiceDate" class="af-input" />
                            <span asp-validation-for="InvoiceDate" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" class="af-input" id="dueDateInput" />
                            <span asp-validation-for="DueDate" class="af-error"></span>
                            <div class="form-text text-xs text-muted" id="termsCalcBadge"><i class="bi bi-clock me-1"></i>Credit terms: 15 days</div>
                        </div>

                        <!-- Sales Order Selector -->
                        <div class="col-md-6">
                            <label asp-for="SalesOrderId" class="form-label">Sales order <span class="text-muted fw-normal">(optional)</span></label>
                            <select asp-for="SalesOrderId" class="af-input af-select" id="soSelect">
                                <option value="">Manual invoice (no sales order)</option>
                                @foreach (var so in (List<AashanaFashion.Models.SalesOrder>)ViewBag.SalesOrders)
                                {
                                    int deliveredCount = so.Challans?.Sum(c => c.TotalQuantity) ?? 0;
                                    int orderedCount = so.Details?.Sum(d => d.Quantity) ?? 0;
                                    <option value="@so.Id" selected="@(Model.SalesOrderId == so.Id)">
                                        @so.SoNumber — @(so.Customer?.CustomerName ?? "") (Delivered: @deliveredCount / @orderedCount pcs)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Delivery Challan Selector -->
                        <div class="col-md-6">
                            <label asp-for="DeliveryChallanId" class="form-label">Delivery challan shipment <span class="text-muted fw-normal">(optional filter)</span></label>
                            <select asp-for="DeliveryChallanId" class="af-input af-select" id="challanSelect">
                                <option value="">All delivered shipments (Auto-fetch all delivered)</option>
                                @if (ViewBag.OrderChallans != null)
                                {
                                    foreach (var ch in (List<AashanaFashion.Models.DeliveryChallan>)ViewBag.OrderChallans)
                                    {
                                        <option value="@ch.Id" selected="@(Model.DeliveryChallanId == ch.Id)">
                                            @ch.ChallanNumber (@ch.TotalQuantity pcs — @ch.ChallanDate.ToString("dd/MM/yyyy"))
                                        </option>
                                    }
                                }
                            </select>
                            <input type="hidden" asp-for="DeliveryChallanNumber" id="hiddenChallanNumber" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label d-flex justify-content-between align-items-center">
                                <span>Customer <span class="req">*</span></span>
                                <span id="invCustCreditBadge" class="af-badge b-green text-2xs d-none" style="font-size: 0.72rem; padding: 2px 6px;"></span>
                            </label>
                            <select asp-for="CustomerId" class="af-input af-select" id="customerSelect" required>
                                <option value="">Select customer</option>
                                @foreach (var c in (List<AashanaFashion.Models.Customer>)ViewBag.Customers)
                                {
                                    <option value="@c.Id" selected="@(Model.CustomerId == c.Id)">@c.CustomerName</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="af-input" id="custName" />
                            <span asp-validation-for="CustomerName" class="af-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerGstin" class="form-label"></label>
                            <input asp-for="CustomerGstin" class="af-input font-monospace" id="custGst" placeholder="e.g. 24AAAAA0000A1Z5" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CustomerPan" class="form-label"></label>
                            <input asp-for="CustomerPan" class="af-input font-monospace" id="custPan" placeholder="PAN number" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PlaceOfSupply" class="form-label"></label>
                            <input asp-for="PlaceOfSupply" class="af-input" id="placeOfSupply" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BillingAddress" class="form-label"></label>
                            <textarea asp-for="BillingAddress" class="af-input" rows="2" id="billAddr"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShippingAddress" class="form-label"></label>
                            <textarea asp-for="ShippingAddress" class="af-input" rows="2" id="shipAddr"></textarea>
                        </div>

                        <div class="col-12 d-flex align-items-center justify-content-between pt-1">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsInterState" class="form-check-input" type="checkbox" role="switch" id="interStateCheck">
                                <label class="form-check-label text-sm fw-medium" for="interStateCheck">Inter-state supply <span class="text-muted">(IGST 5% instead of CGST 2.5% + SGST 2.5%)</span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logistics & Shipment Details -->
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Logistics &amp; transport details</div>
                        <div class="data-card-sub">Auto-filled from the delivery challan for E-way bill and GST compliance.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="TransporterName" class="form-label">Transporter</label>
                            <input asp-for="TransporterName" class="af-input" id="transporterName" placeholder="e.g. VRL Logistics" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="VehicleNumber" class="form-label">Vehicle number</label>
                            <input asp-for="VehicleNumber" class="af-input font-monospace" id="vehicleNumber" placeholder="e.g. GJ05AB1234" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="LrNumber" class="form-label">LR / Bilty no</label>
                            <input asp-for="LrNumber" class="af-input font-monospace" id="lrNumber" placeholder="LR tracking no" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="EwayBillNumber" class="form-label">E-way bill no</label>
                            <input asp-for="EwayBillNumber" class="af-input font-monospace" id="ewayBillNumber" placeholder="12-digit e-way bill" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Live Credit Limit Warning Banner -->
            <div id="invCreditLimitAlert" class="af-alert af-alert-warning mb-4 d-none">
                <div class="alert-body">
                    <span class="alert-title"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Customer Credit Limit Warning</span>
                    <div id="invCreditLimitAlertMsg" class="text-sm mt-1"></div>
                </div>
            </div>

            <!-- Line Items Card with Invoicing Basis Banner -->
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Line items</div>
                        <div class="data-card-sub">Quantities auto-fetched from delivered shipments.</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" id="addItemBtn"><i class="bi bi-plus-lg"></i> Add row</button>
                </div>

                <!-- Invoicing Basis Banner -->
                <div class="px-4 pt-3">
                    <div id="invoicingBasisBanner" class="p-3 rounded border @(Model.TotalDeliveredQuantity > 0 ? "bg-success-subtle border-success-subtle text-success" : "bg-light border text-secondary")">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @(Model.TotalDeliveredQuantity > 0 ? "bi-check-circle-fill" : "bi-info-circle") fs-5"></i>
                                <div>
                                    <div class="fw-semibold text-sm" id="invoicingBasisTitle">
                                        @(Model.TotalDeliveredQuantity > 0 ? "Invoicing Basis: Auto-fetched Delivered Quantity" : "Invoicing Basis: Standard Order / Manual")
                                    </div>
                                    <div class="text-xs text-muted" id="invoicingBasisSubtitle">
                                        @(Model.InvoicingBasisMessage ?? "Invoice quantities are auto-fetched from goods delivered via Delivery Challans.")
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-xs">
                                <span class="badge bg-white text-secondary border">Ordered: <strong id="sumOrderedPcs">@Model.TotalOrderedQuantity</strong> pcs</span>
                                <span class="badge @(Model.TotalDeliveredQuantity > 0 ? "bg-success text-white" : "bg-secondary text-white")">Delivered: <strong id="sumDeliveredPcs">@Model.TotalDeliveredQuantity</strong> pcs</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-scroll">
                    <table class="af-table table-edit" id="itemsTable" style="min-width: 950px;">
                        <thead>
                            <tr>
                                <th style="min-width: 200px;">Description</th>
                                <th style="width: 80px;">HSN</th>
                                <th style="width: 150px;">Colour / size</th>
                                <th style="width: 70px;" class="text-center text-muted">Ordered</th>
                                <th style="width: 75px;" class="text-center text-success">Delivered</th>
                                <th style="width: 85px;" class="text-center">Invoice Qty</th>
                                <th style="width: 100px;" class="text-end">Rate (₹)</th>
                                <th style="width: 85px;" class="text-end">Disc (₹)</th>
                                <th style="width: 105px;" class="text-end">Amount</th>
                                <th style="width: 40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" name="Items[@i].DesignId" value="@Model.Items[i].DesignId" />
                                            <input type="hidden" name="Items[@i].SalesOrderDetailId" value="@Model.Items[i].SalesOrderDetailId" />
                                            <input type="text" name="Items[@i].Description" class="af-input af-input-sm" value="@Model.Items[i].Description" required />
                                        </td>
                                        <td>
                                            <input type="text" name="Items[@i].HsnCode" class="af-input af-input-sm font-monospace" value="@Model.Items[i].HsnCode" />
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <input type="text" name="Items[@i].Colour" class="af-input af-input-sm" value="@Model.Items[i].Colour" placeholder="Colour" />
                                                <input type="text" name="Items[@i].Size" class="af-input af-input-sm" value="@Model.Items[i].Size" placeholder="Size" />
                                            </div>
                                        </td>
                                        <td class="text-center tabular text-muted cell-ordered-qty">
                                            <input type="hidden" name="Items[@i].OrderedQuantity" value="@Model.Items[i].OrderedQuantity" />
                                            <span>@Model.Items[i].OrderedQuantity</span>
                                        </td>
                                        <td class="text-center tabular text-success fw-semibold cell-delivered-qty">
                                            <input type="hidden" name="Items[@i].DeliveredQuantity" value="@Model.Items[i].DeliveredQuantity" />
                                            <span>@Model.Items[i].DeliveredQuantity</span>
                                        </td>
                                        <td>
                                            <input type="number" name="Items[@i].Quantity" class="af-input af-input-sm item-qty text-center fw-bold" value="@Model.Items[i].Quantity" min="0" title="Delivered quantity to invoice" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="Items[@i].UnitPrice" class="af-input af-input-sm item-rate text-end" value="@Model.Items[i].UnitPrice" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="Items[@i].DiscountAmount" class="af-input af-input-sm item-disc text-end" value="@Model.Items[i].DiscountAmount" />
                                        </td>
                                        <td class="cell-num text-foreground fw-semibold item-total">₹0.00</td>
                                        <td class="text-center">
                                            <button type="button" class="row-action danger remove-item-btn" title="Remove" aria-label="Remove row"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Bank & Terms Card -->
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Bank &amp; payment terms</div>
                        <div class="data-card-sub">Printed on the invoice for payment remittance.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BankIfsc" class="form-label">IFSC Code</label>
                            <div class="input-group">
                                <input asp-for="BankIfsc" id="invoiceIfscInput" class="af-input font-monospace text-uppercase" maxlength="11" />
                                <button type="button" class="btn btn-secondary btn-sm" id="btnFetchInvoiceIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                    <i class="bi bi-search"></i> Fetch
                                </button>
                            </div>
                            <div id="invoiceIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label">Bank Name</label>
                            <input asp-for="BankName" id="invoiceBankName" class="af-input" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankBranch" class="form-label">Branch Name</label>
                            <input asp-for="BankBranch" id="invoiceBankBranch" class="af-input" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankAccountNumber" class="form-label">Account Number</label>
                            <input asp-for="BankAccountNumber" class="af-input font-monospace" />
                        </div>
                        <div class="col-12">
                            <label asp-for="TermsAndConditions" class="form-label"></label>
                            <textarea asp-for="TermsAndConditions" class="af-input" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="data-card sticky-side">
                <div class="data-card-header">
                    <div class="data-card-title">Invoice summary</div>
                </div>
                <div class="data-card-body">
                    <div class="kv-row"><span class="k">Sub-total</span><span class="v" id="sumSubTotal">₹0.00</span></div>
                    <div class="kv-row"><span class="k">Discount</span><span class="v text-danger" id="sumDiscount">−₹0.00</span></div>
                    <div class="kv-row total"><span class="k">Taxable amount</span><span class="v" id="sumTaxable">₹0.00</span></div>

                    <div id="intraStateTaxSection">
                        <div class="kv-row"><span class="k">CGST (@Model.CgstRate%)</span><span class="v" id="sumCgst">₹0.00</span></div>
                        <div class="kv-row"><span class="k">SGST (@Model.SgstRate%)</span><span class="v" id="sumSgst">₹0.00</span></div>
                    </div>
                    <div id="interStateTaxSection" class="d-none">
                        <div class="kv-row"><span class="k">IGST (@Model.IgstRate%)</span><span class="v" id="sumIgst">₹0.00</span></div>
                    </div>
                    <div class="kv-row"><span class="k">Round off</span><span class="v text-muted" id="sumRoundOff">₹0.00</span></div>

                    <div class="bill-total mb-4"><span class="k">Grand total</span><span class="v" id="sumGrandTotal">₹0.00</span></div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Internal notes / Challan reference</label>
                        <textarea asp-for="Notes" class="af-input" rows="2" id="invoiceNotes" placeholder="Payment terms, transport reference…"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-receipt"></i> Generate tax invoice</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let itemIndex = @(Model.Items?.Count ?? 0);

        function recalcInvoice() {
            let subtotal = 0;
            let discount = 0;

            $('#itemsBody tr').each(function () {
                const qty = parseFloat($(this).find('.item-qty').val()) || 0;
                const rate = parseFloat($(this).find('.item-rate').val()) || 0;
                const disc = parseFloat($(this).find('.item-disc').val()) || 0;

                const lineGross = qty * rate;
                const lineNet = Math.max(0, lineGross - disc);

                subtotal += lineGross;
                discount += disc;

                $(this).find('.item-total').text('₹' + lineNet.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            });

            const taxable = Math.max(0, subtotal - discount);
            const isInterState = $('#interStateCheck').is(':checked');

            let cgst = 0;
            let sgst = 0;
            let igst = 0;

            if (isInterState) {
                $('#intraStateTaxSection').addClass('d-none');
                $('#interStateTaxSection').removeClass('d-none');
                igst = taxable * 0.05; // 5% IGST
                $('#sumIgst').text('₹' + igst.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            } else {
                $('#intraStateTaxSection').removeClass('d-none');
                $('#interStateTaxSection').addClass('d-none');
                cgst = taxable * 0.025; // 2.5% CGST
                sgst = taxable * 0.025; // 2.5% SGST
                $('#sumCgst').text('₹' + cgst.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#sumSgst').text('₹' + sgst.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }

            const rawTotal = taxable + cgst + sgst + igst;
            const grandTotal = Math.round(rawTotal);
            const roundOff = grandTotal - rawTotal;

            $('#sumSubTotal').text('₹' + subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#sumDiscount').text('−₹' + discount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#sumTaxable').text('₹' + taxable.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#sumRoundOff').text('₹' + roundOff.toFixed(2));
            $('#sumGrandTotal').text('₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            evaluateInvoiceCreditLimit(grandTotal);
        }

        function evaluateInvoiceCreditLimit(invTotal) {
            const alertBox = $('#invCreditLimitAlert');
            const alertMsg = $('#invCreditLimitAlertMsg');
            const badge = $('#invCustCreditBadge');

            if (!window.invCustomerCreditData || !window.invCustomerCreditData.hasCreditLimit) {
                alertBox.addClass('d-none');
                return;
            }

            const limit = window.invCustomerCreditData.creditLimit;
            const currentOut = window.invCustomerCreditData.currentOutstanding;
            const totalExposure = currentOut + (invTotal || 0);

            if (totalExposure > limit) {
                const excess = totalExposure - limit;
                alertMsg.html(`Customer credit limit is <strong>₹${limit.toLocaleString('en-IN', {minimumFractionDigits: 2})}</strong> · Current outstanding is <strong>₹${currentOut.toLocaleString('en-IN', {minimumFractionDigits: 2})}</strong> · Invoice total is <strong>₹${(invTotal||0).toLocaleString('en-IN', {minimumFractionDigits: 2})}</strong>.<br/>Total customer exposure will reach <strong>₹${totalExposure.toLocaleString('en-IN', {minimumFractionDigits: 2})}</strong>, <span class="text-danger fw-semibold">exceeding the credit limit by ₹${excess.toLocaleString('en-IN', {minimumFractionDigits: 2})}</span>.`);
                alertBox.removeClass('d-none');
                badge.attr('class', 'af-badge b-red text-2xs');
                badge.html(`<i class="bi bi-shield-exclamation me-1"></i>Limit: ₹${limit.toLocaleString('en-IN', {maximumFractionDigits: 0})} (Exceeded by ₹${excess.toLocaleString('en-IN', {maximumFractionDigits: 0})})`);
            } else {
                const remaining = limit - totalExposure;
                alertBox.addClass('d-none');
                badge.attr('class', 'af-badge b-green text-2xs');
                badge.html(`<i class="bi bi-shield-check me-1"></i>Limit: ₹${limit.toLocaleString('en-IN', {maximumFractionDigits: 0})} (Available: ₹${remaining.toLocaleString('en-IN', {maximumFractionDigits: 0})})`);
            }
        }

        $(document).on('input change', '.item-qty, .item-rate, .item-disc, #interStateCheck', recalcInvoice);

        // Add Manual Row
        $('#addItemBtn').on('click', function () {
            const row = `
                <tr>
                    <td>
                        <input type="text" name="Items[${itemIndex}].Description" class="af-input af-input-sm" placeholder="Garment description" required />
                    </td>
                    <td>
                        <input type="text" name="Items[${itemIndex}].HsnCode" class="af-input af-input-sm font-monospace" value="6204" />
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <input type="text" name="Items[${itemIndex}].Colour" class="af-input af-input-sm" placeholder="Colour" />
                            <input type="text" name="Items[${itemIndex}].Size" class="af-input af-input-sm" placeholder="Size" />
                        </div>
                    </td>
                    <td class="text-center tabular text-muted cell-ordered-qty">
                        <input type="hidden" name="Items[${itemIndex}].OrderedQuantity" value="1" />
                        <span>—</span>
                    </td>
                    <td class="text-center tabular text-success fw-semibold cell-delivered-qty">
                        <input type="hidden" name="Items[${itemIndex}].DeliveredQuantity" value="1" />
                        <span>—</span>
                    </td>
                    <td>
                        <input type="number" name="Items[${itemIndex}].Quantity" class="af-input af-input-sm item-qty text-center fw-bold" value="1" min="1" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[${itemIndex}].UnitPrice" class="af-input af-input-sm item-rate text-end" value="0" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[${itemIndex}].DiscountAmount" class="af-input af-input-sm item-disc text-end" value="0" />
                    </td>
                    <td class="cell-num text-foreground fw-semibold item-total">₹0.00</td>
                    <td class="text-center">
                        <button type="button" class="row-action danger remove-item-btn" title="Remove" aria-label="Remove row"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `;
            $('#itemsBody').append(row);
            itemIndex++;
            recalcInvoice();
        });

        // Remove Row
        $(document).on('click', '.remove-item-btn', function () {
            $(this).closest('tr').remove();
            recalcInvoice();
        });

        // Customer change AJAX autofill
        $('#customerSelect').on('change', function () {
            const custId = $(this).val();
            if (!custId) {
                window.invCustomerCreditData = null;
                $('#invCustCreditBadge').addClass('d-none');
                $('#invCreditLimitAlert').addClass('d-none');
                return;
            }

            $.getJSON('/Invoice/GetCustomerDetails?customerId=' + custId, function (data) {
                if (data) {
                    $('#custName').val(data.customerName);
                    $('#custGst').val(data.gstin);
                    $('#custPan').val(data.pan);
                    $('#billAddr').val(data.billingAddress);
                    $('#shipAddr').val(data.shippingAddress);
                    $('#placeOfSupply').val(data.placeOfSupply);
                    $('#interStateCheck').prop('checked', data.isInterState).trigger('change');

                    if (data.hasCreditLimit) {
                        window.invCustomerCreditData = data;
                        $('#invCustCreditBadge').removeClass('d-none');
                        recalcInvoice();
                    } else {
                        window.invCustomerCreditData = null;
                        $('#invCustCreditBadge').addClass('d-none');
                        $('#invCreditLimitAlert').addClass('d-none');
                    }
                }
            });
        });

        function populateInvoiceFromOrderDetails(data) {
            if (!data) return;

            // Fill customer & tax info
            if (data.customerId) {
                $('#customerSelect').val(data.customerId);
                $('#custName').val(data.customerName);
                $('#custGst').val(data.gstin);
                $('#custPan').val(data.pan);
                $('#billAddr').val(data.billingAddress);
                $('#shipAddr').val(data.shippingAddress);
                $('#placeOfSupply').val(data.placeOfSupply);
                $('#interStateCheck').prop('checked', data.isInterState).trigger('change');

                if (data.hasCreditLimit) {
                    window.invCustomerCreditData = data;
                    $('#invCustCreditBadge').removeClass('d-none');
                } else {
                    window.invCustomerCreditData = null;
                    $('#invCustCreditBadge').addClass('d-none');
                    $('#invCreditLimitAlert').addClass('d-none');
                }
            }

            // Fill logistics
            $('#transporterName').val(data.transporterName || '');
            $('#vehicleNumber').val(data.vehicleNumber || '');
            $('#lrNumber').val(data.lrNumber || '');
            $('#ewayBillNumber').val(data.ewayBillNumber || '');

            // Notes
            if (data.deliveryChallanNumber) {
                $('#invoiceNotes').val('Billed against Delivery Challan #' + data.deliveryChallanNumber + ' for SO #' + data.soNumber);
                $('#hiddenChallanNumber').val(data.deliveryChallanNumber);
            } else if (data.soNumber) {
                $('#invoiceNotes').val('Billed against Sales Order #' + data.soNumber);
            }

            // Update banner
            const banner = $('#invoicingBasisBanner');
            const title = $('#invoicingBasisTitle');
            const subtitle = $('#invoicingBasisSubtitle');
            $('#sumOrderedPcs').text(data.totalOrderedQuantity || 0);
            $('#sumDeliveredPcs').text(data.totalDeliveredQuantity || 0);

            if (data.totalDeliveredQuantity > 0) {
                banner.removeClass('bg-light text-secondary').addClass('bg-success-subtle border-success-subtle text-success');
                banner.find('i').removeClass('bi-info-circle').addClass('bi-check-circle-fill');
                title.text('Invoicing Basis: Auto-fetched Delivered Quantity');
                subtitle.text(data.invoicingBasisMessage || 'Quantities automatically fetched from delivered shipments.');
            } else {
                banner.removeClass('bg-success-subtle border-success-subtle text-success').addClass('bg-light border text-secondary');
                banner.find('i').removeClass('bi-check-circle-fill').addClass('bi-info-circle');
                title.text('Invoicing Basis: Order / Manual (0 pcs delivered)');
                subtitle.text(data.invoicingBasisMessage || 'No delivery challan found for this order yet.');
            }

            // Rebuild items
            $('#itemsBody').empty();
            itemIndex = 0;

            if (data.items && data.items.length > 0) {
                data.items.forEach(function (item) {
                    const row = `
                        <tr>
                            <td>
                                <input type="hidden" name="Items[${itemIndex}].DesignId" value="${item.designId || ''}" />
                                <input type="hidden" name="Items[${itemIndex}].SalesOrderDetailId" value="${item.salesOrderDetailId || ''}" />
                                <input type="text" name="Items[${itemIndex}].Description" class="af-input af-input-sm" value="${item.description}" required />
                            </td>
                            <td>
                                <input type="text" name="Items[${itemIndex}].HsnCode" class="af-input af-input-sm font-monospace" value="${item.hsnCode || '6204'}" />
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <input type="text" name="Items[${itemIndex}].Colour" class="af-input af-input-sm" value="${item.colour || ''}" placeholder="Colour" />
                                    <input type="text" name="Items[${itemIndex}].Size" class="af-input af-input-sm" value="${item.size || ''}" placeholder="Size" />
                                </div>
                            </td>
                            <td class="text-center tabular text-muted cell-ordered-qty">
                                <input type="hidden" name="Items[${itemIndex}].OrderedQuantity" value="${item.orderedQuantity}" />
                                <span>${item.orderedQuantity}</span>
                            </td>
                            <td class="text-center tabular text-success fw-semibold cell-delivered-qty">
                                <input type="hidden" name="Items[${itemIndex}].DeliveredQuantity" value="${item.deliveredQuantity}" />
                                <span>${item.deliveredQuantity}</span>
                            </td>
                            <td>
                                <input type="number" name="Items[${itemIndex}].Quantity" class="af-input af-input-sm item-qty text-center fw-bold" value="${item.quantity}" min="0" title="Delivered quantity to invoice" />
                            </td>
                            <td>
                                <input type="number" step="0.01" name="Items[${itemIndex}].UnitPrice" class="af-input af-input-sm item-rate text-end" value="${item.unitPrice}" />
                            </td>
                            <td>
                                <input type="number" step="0.01" name="Items[${itemIndex}].DiscountAmount" class="af-input af-input-sm item-disc text-end" value="${item.discountAmount}" />
                            </td>
                            <td class="cell-num text-foreground fw-semibold item-total">₹0.00</td>
                            <td class="text-center">
                                <button type="button" class="row-action danger remove-item-btn" title="Remove" aria-label="Remove row"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    `;
                    $('#itemsBody').append(row);
                    itemIndex++;
                });
            } else {
                $('#addItemBtn').trigger('click');
            }

            recalcInvoice();
        }

        // SO Select trigger AJAX to fetch delivered quantities dynamically
        $('#soSelect').on('change', function () {
            const soId = $(this).val();
            if (!soId) {
                $('#challanSelect').empty().append('<option value="">All delivered shipments (Auto-fetch all delivered)</option>');
                return;
            }

            $.getJSON('/Invoice/GetOrderDeliveryDetails?salesOrderId=' + soId, function (data) {
                // Populate challan dropdown
                const challanDropdown = $('#challanSelect');
                challanDropdown.empty();
                challanDropdown.append('<option value="">All delivered shipments (Auto-fetch all delivered)</option>');
                if (data.challans && data.challans.length > 0) {
                    data.challans.forEach(function (ch) {
                        challanDropdown.append(`<option value="${ch.id}">${ch.challanNumber} (${ch.totalQuantity} pcs — ${ch.challanDate})</option>`);
                    });
                }

                populateInvoiceFromOrderDetails(data);
            });
        });

        // Specific Challan Filter trigger
        $('#challanSelect').on('change', function () {
            const soId = $('#soSelect').val();
            const chId = $(this).val();
            if (!soId) return;

            let url = '/Invoice/GetOrderDeliveryDetails?salesOrderId=' + soId;
            if (chId) {
                url += '&deliveryChallanId=' + chId;
            }

            $.getJSON(url, function (data) {
                populateInvoiceFromOrderDetails(data);
            });
        });

        function updateTermsCalc() {
            const invVal = $('#InvoiceDate').val();
            const dueVal = $('#dueDateInput').val();
            const badge = $('#termsCalcBadge');
            if (!invVal || !dueVal || badge.length === 0) return;
            const invDate = new Date(invVal);
            const dueDate = new Date(dueVal);
            if (!isNaN(invDate.getTime()) && !isNaN(dueDate.getTime())) {
                const diffTime = dueDate.getTime() - invDate.getTime();
                const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
                if (diffDays >= 0) {
                    badge.html(`<i class="bi bi-calendar-check text-success me-1"></i>Credit terms: <strong>${diffDays} days</strong>`);
                    badge.attr('class', 'form-text text-xs text-success');
                } else {
                    badge.html(`<i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Due date is <strong>${Math.abs(diffDays)} days before</strong> invoice date!`);
                    badge.attr('class', 'form-text text-xs text-danger');
                }
            }
        }

        $('#InvoiceDate, #dueDateInput').on('change input', updateTermsCalc);

        $(document).ready(function () {
            if ($('#itemsBody tr').length === 0) {
                $('#addItemBtn').trigger('click');
            }
            recalcInvoice();
            updateTermsCalc();

            initIfscLookup({
                ifscInput: '#invoiceIfscInput',
                bankNameInput: '#invoiceBankName',
                branchInput: '#invoiceBankBranch',
                fetchBtn: '#btnFetchInvoiceIfsc',
                statusContainer: '#invoiceIfscStatus'
            });
        });
    </script>
}
