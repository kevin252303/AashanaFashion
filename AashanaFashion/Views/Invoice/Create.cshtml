@model AashanaFashion.Models.CreateInvoiceViewModel
@{
    ViewData["Title"] = "Create GST Tax Invoice";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Tax invoices</a>
        <h1 class="page-title">New GST tax invoice</h1>
        <p class="page-sub">Generate a GST-compliant tax invoice for customer billing.</p>
    </div>
</div>

<form asp-action="Create" method="post" id="invoiceForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Invoice &amp; customer</div>
                        <div class="data-card-sub">Pick a sales order to prefill, or bill a customer manually.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="InvoiceNumber" class="form-label"></label>
                            <input asp-for="InvoiceNumber" class="af-input font-monospace" />
                            <span asp-validation-for="InvoiceNumber" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="InvoiceDate" class="form-label"></label>
                            <input asp-for="InvoiceDate" class="af-input" />
                            <span asp-validation-for="InvoiceDate" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" class="af-input" />
                            <span asp-validation-for="DueDate" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SalesOrderId" class="form-label">Sales order <span class="text-muted fw-normal">(optional)</span></label>
                            <select asp-for="SalesOrderId" class="af-input af-select" id="soSelect">
                                <option value="">Manual invoice (no sales order)</option>
                                @foreach (var so in (List<AashanaFashion.Models.SalesOrder>)ViewBag.SalesOrders)
                                {
                                    <option value="@so.Id" selected="@(Model.SalesOrderId == so.Id)">
                                        @so.SoNumber — @(so.Customer?.CustomerName ?? "") (₹@so.TotalAmount.ToString("N0"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label">Customer <span class="req">*</span></label>
                            <select asp-for="CustomerId" class="af-input af-select" id="customerSelect" required>
                                <option value="">Select customer</option>
                                @foreach (var c in (List<AashanaFashion.Models.Customer>)ViewBag.Customers)
                                {
                                    <option value="@c.Id" selected="@(Model.CustomerId == c.Id)">@c.CustomerName</option>
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="af-error"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CustomerName" class="form-label"></label>
                            <input asp-for="CustomerName" class="af-input" id="custName" />
                            <span asp-validation-for="CustomerName" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CustomerGstin" class="form-label"></label>
                            <input asp-for="CustomerGstin" class="af-input font-monospace" id="custGst" placeholder="e.g. 24AAAAA0000A1Z5" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CustomerPan" class="form-label"></label>
                            <input asp-for="CustomerPan" class="af-input font-monospace" id="custPan" placeholder="PAN number" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BillingAddress" class="form-label"></label>
                            <textarea asp-for="BillingAddress" class="af-input" rows="2" id="billAddr"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShippingAddress" class="form-label"></label>
                            <textarea asp-for="ShippingAddress" class="af-input" rows="2" id="shipAddr"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PlaceOfSupply" class="form-label"></label>
                            <input asp-for="PlaceOfSupply" class="af-input" id="placeOfSupply" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsInterState" class="form-check-input" type="checkbox" role="switch" id="interStateCheck">
                                <label class="form-check-label" for="interStateCheck">Inter-state supply <span class="text-muted">(IGST instead of CGST + SGST)</span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Line items</div>
                        <div class="data-card-sub">HSN 6204 for women’s ethnic garments.</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" id="addItemBtn"><i class="bi bi-plus-lg"></i> Add row</button>
                </div>
                <div class="table-scroll">
                    <table class="af-table table-edit" id="itemsTable" style="min-width: 900px;">
                        <thead>
                            <tr>
                                <th style="min-width: 200px;">Description</th>
                                <th style="width: 86px;">HSN</th>
                                <th style="width: 190px;">Colour / size</th>
                                <th style="width: 76px;" class="text-center">Qty</th>
                                <th style="width: 104px;" class="text-end">Rate (₹)</th>
                                <th style="width: 92px;" class="text-end">Disc (₹)</th>
                                <th style="width: 110px;" class="text-end">Amount</th>
                                <th style="width: 44px;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="text" name="Items[@i].Description" class="af-input af-input-sm" value="@Model.Items[i].Description" required />
                                        </td>
                                        <td>
                                            <input type="text" name="Items[@i].HsnCode" class="af-input af-input-sm font-monospace" value="@Model.Items[i].HsnCode" />
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <input type="text" name="Items[@i].Colour" class="af-input af-input-sm" value="@Model.Items[i].Colour" placeholder="Colour" />
                                                <input type="text" name="Items[@i].Size" class="af-input af-input-sm" value="@Model.Items[i].Size" placeholder="Size" />
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" name="Items[@i].Quantity" class="af-input af-input-sm item-qty text-center" value="@Model.Items[i].Quantity" min="1" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="Items[@i].UnitPrice" class="af-input af-input-sm item-rate text-end" value="@Model.Items[i].UnitPrice" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="Items[@i].DiscountAmount" class="af-input af-input-sm item-disc text-end" value="@Model.Items[i].DiscountAmount" />
                                        </td>
                                        <td class="cell-num text-foreground fw-semibold item-total">₹0.00</td>
                                        <td class="text-center">
                                            <button type="button" class="row-action danger remove-item-btn" title="Remove" aria-label="Remove row"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Bank &amp; terms</div>
                        <div class="data-card-sub">Printed on the invoice for payment.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label"></label>
                            <input asp-for="BankName" class="af-input" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankAccountNumber" class="form-label"></label>
                            <input asp-for="BankAccountNumber" class="af-input font-monospace" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankIfsc" class="form-label"></label>
                            <input asp-for="BankIfsc" class="af-input font-monospace" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankBranch" class="form-label"></label>
                            <input asp-for="BankBranch" class="af-input" />
                        </div>
                        <div class="col-12">
                            <label asp-for="TermsAndConditions" class="form-label"></label>
                            <textarea asp-for="TermsAndConditions" class="af-input" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="data-card sticky-side">
                <div class="data-card-header">
                    <div class="data-card-title">Bill summary</div>
                </div>
                <div class="data-card-body">
                    <div class="kv-row"><span class="k">Sub-total</span><span class="v" id="sumSubTotal">₹0.00</span></div>
                    <div class="kv-row"><span class="k">Discount</span><span class="v text-danger" id="sumDiscount">−₹0.00</span></div>
                    <div class="kv-row total"><span class="k">Taxable amount</span><span class="v" id="sumTaxable">₹0.00</span></div>

                    <div id="intraStateTaxSection">
                        <div class="kv-row"><span class="k">CGST (@Model.CgstRate%)</span><span class="v" id="sumCgst">₹0.00</span></div>
                        <div class="kv-row"><span class="k">SGST (@Model.SgstRate%)</span><span class="v" id="sumSgst">₹0.00</span></div>
                    </div>
                    <div id="interStateTaxSection" class="d-none">
                        <div class="kv-row"><span class="k">IGST (@Model.IgstRate%)</span><span class="v" id="sumIgst">₹0.00</span></div>
                    </div>
                    <div class="kv-row"><span class="k">Round off</span><span class="v text-muted" id="sumRoundOff">₹0.00</span></div>

                    <div class="bill-total mb-4"><span class="k">Grand total</span><span class="v" id="sumGrandTotal">₹0.00</span></div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Internal notes</label>
                        <textarea asp-for="Notes" class="af-input" rows="2" placeholder="Payment terms, transport reference…"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-receipt"></i> Generate tax invoice</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let itemIndex = @(Model.Items?.Count ?? 0);

        function recalcInvoice() {
            let subtotal = 0;
            let discount = 0;

            $('#itemsBody tr').each(function () {
                const qty = parseFloat($(this).find('.item-qty').val()) || 0;
                const rate = parseFloat($(this).find('.item-rate').val()) || 0;
                const disc = parseFloat($(this).find('.item-disc').val()) || 0;

                const lineGross = qty * rate;
                const lineNet = Math.max(0, lineGross - disc);

                subtotal += lineGross;
                discount += disc;

                $(this).find('.item-total').text('₹' + lineNet.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            });

            const taxable = Math.max(0, subtotal - discount);
            const isInterState = $('#interStateCheck').is(':checked');

            let cgst = 0;
            let sgst = 0;
            let igst = 0;

            if (isInterState) {
                $('#intraStateTaxSection').addClass('d-none');
                $('#interStateTaxSection').removeClass('d-none');
                igst = taxable * 0.05; // 5% IGST
                $('#sumIgst').text('₹' + igst.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            } else {
                $('#intraStateTaxSection').removeClass('d-none');
                $('#interStateTaxSection').addClass('d-none');
                cgst = taxable * 0.025; // 2.5% CGST
                sgst = taxable * 0.025; // 2.5% SGST
                $('#sumCgst').text('₹' + cgst.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
                $('#sumSgst').text('₹' + sgst.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            }

            const rawTotal = taxable + cgst + sgst + igst;
            const grandTotal = Math.round(rawTotal);
            const roundOff = grandTotal - rawTotal;

            $('#sumSubTotal').text('₹' + subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            $('#sumDiscount').text('−₹' + discount.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            $('#sumTaxable').text('₹' + taxable.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            $('#sumRoundOff').text('₹' + roundOff.toFixed(2));
            $('#sumGrandTotal').text('₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
        }

        $(document).on('input change', '.item-qty, .item-rate, .item-disc, #interStateCheck', recalcInvoice);

        // Add Row
        $('#addItemBtn').on('click', function () {
            const row = `
                <tr>
                    <td>
                        <input type="text" name="Items[${itemIndex}].Description" class="af-input af-input-sm" placeholder="Garment description" required />
                    </td>
                    <td>
                        <input type="text" name="Items[${itemIndex}].HsnCode" class="af-input af-input-sm font-monospace" value="6204" />
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <input type="text" name="Items[${itemIndex}].Colour" class="af-input af-input-sm" placeholder="Colour" />
                            <input type="text" name="Items[${itemIndex}].Size" class="af-input af-input-sm" placeholder="Size" />
                        </div>
                    </td>
                    <td>
                        <input type="number" name="Items[${itemIndex}].Quantity" class="af-input af-input-sm item-qty text-center" value="1" min="1" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[${itemIndex}].UnitPrice" class="af-input af-input-sm item-rate text-end" value="0" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="Items[${itemIndex}].DiscountAmount" class="af-input af-input-sm item-disc text-end" value="0" />
                    </td>
                    <td class="cell-num text-foreground fw-semibold item-total">₹0.00</td>
                    <td class="text-center">
                        <button type="button" class="row-action danger remove-item-btn" title="Remove" aria-label="Remove row"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `;
            $('#itemsBody').append(row);
            itemIndex++;
            recalcInvoice();
        });

        // Remove Row
        $(document).on('click', '.remove-item-btn', function () {
            $(this).closest('tr').remove();
            recalcInvoice();
        });

        // Customer change AJAX autofill
        $('#customerSelect').on('change', function () {
            const custId = $(this).val();
            if (!custId) return;

            $.getJSON('/Invoice/GetCustomerDetails?customerId=' + custId, function (data) {
                if (data) {
                    $('#custName').val(data.customerName);
                    $('#custGst').val(data.gstin);
                    $('#custPan').val(data.pan);
                    $('#billAddr').val(data.billingAddress);
                    $('#shipAddr').val(data.shippingAddress);
                    $('#placeOfSupply').val(data.placeOfSupply);
                    $('#interStateCheck').prop('checked', data.isInterState).trigger('change');
                }
            });
        });

        // SO Select trigger redirect to prefill
        $('#soSelect').on('change', function () {
            const soId = $(this).val();
            if (soId) {
                window.location.href = '/Invoice/Create?salesOrderId=' + soId;
            }
        });

        $(document).ready(function () {
            if ($('#itemsBody tr').length === 0) {
                $('#addItemBtn').trigger('click');
            }
            recalcInvoice();
        });
    </script>
}
