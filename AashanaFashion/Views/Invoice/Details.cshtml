                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Approx. Distance (KM)</label>
                        <input type="number" name="DistanceKm" class="form-control" value="@(Model.DistanceKm ?? 50)" min="1" max="4000" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Transporter / Courier Name</label>
                    <input type="text" name="TransporterName" class="form-control" placeholder="e.g. VRL Logistics, SafeXpress" value="@Model.TransporterName" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Transporter ID (GSTIN / TRANSIN)</label>
                    <input type="text" name="TransporterId" class="form-control text-uppercase font-monospace" placeholder="15-digit GSTIN or TRANSIN (Optional)" value="@Model.TransporterId" />
