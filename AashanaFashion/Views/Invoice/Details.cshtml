                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Download E-Way Bill JSON -->
<div class="modal fade" id="ewayJsonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="DownloadEwayBillJson" method="get" class="modal-content">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold">🚚 Download Official NIC E-Way Bill JSON</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small mb-3">
                    <strong>💡 How to use:</strong> Download this JSON file and upload it directly to the official government portal at <a href="https://ewaybillgst.gov.in" target="_blank" class="fw-bold">ewaybillgst.gov.in</a> &rarr; <em>E-Waybill &rarr; Generate Bulk</em>.
