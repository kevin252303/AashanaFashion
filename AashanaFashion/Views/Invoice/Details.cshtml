<!-- Modal: Generate Government E-Invoice (IRN) -->
<div class="modal fade" id="generateEInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="GenerateEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">⚡ Generate Government E-Invoice (IRN)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    Generates the official 64-character Invoice Reference Number (IRN) and digitally signed QR Code according to Government GSTN / IRP standards (INV-01 schema).
                </p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Supply Type</label>
                    <select name="supplyType" class="form-select">
                        <option value="B2B" selected>B2B - Regular Business-to-Business</option>
                        <option value="SEZWP">SEZWP - SEZ with Payment of Tax</option>
                        <option value="SEZWOP">SEZWOP - SEZ without Payment of Tax</option>
                        <option value="EXPWP">EXPWP - Export with Payment of Tax</option>
                        <option value="EXPWOP">EXPWOP - Export without Payment of Tax</option>
                        <option value="DEXP">DEXP - Deemed Export</option>
                    </select>
                </div>

                <div class="p-2 bg-light border rounded mb-3 small">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Customer GSTIN:</span>
                        <span class="fw-bold font-monospace">@(string.IsNullOrWhiteSpace(Model.CustomerGstin) ? "Not Provided (URP)" : Model.CustomerGstin)</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted">Place of Supply:</span>
                        <span class="fw-bold">@Model.PlaceOfSupply</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted">Total Invoice Value:</span>
                        <span class="fw-bold text-primary">₹ @Model.GrandTotal.ToString("N2")</span>
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="chkGenEway" name="generateEwayBill" value="true" @(!string.IsNullOrWhiteSpace(Model.VehicleNumber) ? "checked" : "") onchange="$('#ewayFieldsSection').toggle(this.checked);" />
                    <label class="form-check-label fw-semibold" for="chkGenEway">Also Generate E-Way Bill Number</label>
                </div>

                <div id="ewayFieldsSection" style="display:@(!string.IsNullOrWhiteSpace(Model.VehicleNumber) ? "block" : "none");">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vehicle Number</label>
                            <input type="text" name="vehicleNumber" class="form-control form-control-sm text-uppercase font-monospace" placeholder="GJ05AB1234" value="@Model.VehicleNumber" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Distance (KM)</label>
                            <input type="number" name="distanceKm" class="form-control form-control-sm" value="@(Model.DistanceKm ?? 50)" min="1" max="4000" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Transporter ID</label>
                            <input type="text" name="transporterId" class="form-control form-control-sm text-uppercase font-monospace" placeholder="15-digit GSTIN" value="@Model.TransporterId" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Transporter Name</label>
                            <input type="text" name="transporterName" class="form-control form-control-sm" placeholder="Transport Name" value="@Model.TransporterName" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary fw-bold px-4">
                    ⚡ Register E-Invoice Now
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Cancel E-Invoice -->
<div class="modal fade" id="cancelEInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="CancelEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold">❌ Cancel E-Invoice (IRN)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small mb-3">
                    <strong>Notice:</strong> Under Government rules, an IRN can be cancelled within 24 hours of generation. Once cancelled, the same invoice number cannot be used again to generate a new IRN on the portal.
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Cancellation Reason <span class="text-danger">*</span></label>
                    <select name="cancelReason" class="form-select" required>
                        <option value="1">1 - Duplicate Invoice</option>
                        <option value="2">2 - Data Entry Mistake</option>
                        <option value="3">3 - Order Cancelled by Buyer</option>
                        <option value="4">4 - Other</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Detailed Remarks <span class="text-danger">*</span></label>
                    <textarea name="cancelRemarks" class="form-control" rows="3" placeholder="Provide detailed explanation for cancellation..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-danger fw-bold" onclick="return confirm('Are you sure you want to cancel this official E-Invoice IRN? This action cannot be undone.');">
                    Confirm E-Invoice Cancellation
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Record Manual E-Invoice -->
<div class="modal fade" id="recordManualEInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="RecordManualEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title fw-bold">📝 Record Externally Generated E-Invoice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">If you generated the e-invoice on the Government offline tool or third-party GSP, paste the details here to link them with this invoice.</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Invoice Reference Number (IRN) <span class="text-danger">*</span></label>
                    <input type="text" name="irn" class="form-control font-monospace" placeholder="64-character hex hash" maxlength="64" minlength="64" required />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Acknowledgment No <span class="text-danger">*</span></label>
                        <input type="text" name="ackNo" class="form-control font-monospace" placeholder="e.g. 112610012345678" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Ack Date & Time <span class="text-danger">*</span></label>
                        <input type="datetime-local" name="ackDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Signed QR Payload / Base64</label>
                    <textarea name="signedQr" class="form-control font-monospace small" rows="3" placeholder="Paste the Signed QRCode text from the portal (Optional, will auto-generate if empty)"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary fw-bold">Save E-Invoice Details</button>
            </div>
        </form>
    </div>
</div>

