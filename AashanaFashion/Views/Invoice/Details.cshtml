@model AashanaFashion.Models.TaxInvoice
@inject AashanaFashion.Services.ICommunicationService CommunicationService
@{
    ViewData["Title"] = $"Tax Invoice {Model.InvoiceNumber}";
    bool isOverdue = Model.DueDate < DateTime.Today && Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Paid;
    bool canPay = Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Paid && Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Cancelled;
    var commEntries = ViewBag.CommissionEntries as List<AashanaFashion.Models.SalesmanCommissionEntry>;
    var chatterVm = await CommunicationService.GetChatterViewModelAsync("TaxInvoice", Model.Id);
}

<div class="page-header">
    <div class="min-w-0">
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Tax invoices</a>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">Invoice @Model.InvoiceNumber</h1>
            @switch (Model.PaymentStatus)
            {
                case AashanaFashion.Models.InvoicePaymentStatus.Paid:
                    <span class="af-badge b-green">Paid</span>
                    break;
                case AashanaFashion.Models.InvoicePaymentStatus.PartiallyPaid:
                    <span class="af-badge b-yellow">Partially paid</span>
                    break;
                case AashanaFashion.Models.InvoicePaymentStatus.Unpaid:
                    <span class="af-badge b-red">Unpaid</span>
                    break;
                default:
                    <span class="af-badge b-gray">Cancelled</span>
                    break;
            }
            @if (Model.IsInterState)
            {
                <span class="af-badge b-cyan">IGST @Model.IgstRate%</span>
            }
            else
            {
                <span class="af-badge b-gray">CGST + SGST</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.EwayBillNumber))
            {
                <span class="af-badge b-indigo">EWB @Model.EwayBillNumber</span>
            }
        </div>
        <p class="page-sub">
            @Model.CustomerName
            · Issued @Model.InvoiceDate.ToString("dd MMM yyyy")
            · Due <span class="@(isOverdue ? "text-danger fw-semibold" : "")">@Model.DueDate.ToString("dd MMM yyyy")@(isOverdue ? " (overdue)" : "")</span>
            · @(Model.SalesOrder != null ? $"SO {Model.SalesOrder.SoNumber}" : "Direct invoice")
            @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
            {
                <text>· Vehicle <span class="font-monospace">@Model.VehicleNumber</span></text>
            }
        </p>
    </div>
    <div class="page-actions">
        @if (Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Cancelled)
        {
            <div class="dropdown">
                <button class="btn btn-secondary btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More actions" aria-label="More actions">
                    <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item text-danger" asp-action="ReturnGoods" asp-route-id="@Model.Id">
                            <i class="bi bi-arrow-return-left"></i> Return goods / credit note
                        </a>
                    </li>
                </ul>
            </div>
        }
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-truck"></i> E-Way bill
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">E-Way bill</h6></li>
                <li><a class="dropdown-item" asp-action="PrintEwayBill" asp-route-id="@Model.Id" target="_blank"><i class="bi bi-printer"></i> Print e-way bill</a></li>
                <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#ewayJsonModal"><i class="bi bi-filetype-json"></i> Download NIC EWB JSON</button></li>
                <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#ewaySaveModal"><i class="bi bi-pencil-square"></i> Record e-way bill number</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="https://ewaybillgst.gov.in" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> ewaybillgst.gov.in</a></li>
            </ul>
        </div>
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-qr-code"></i> E-Invoice
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Govt. e-invoice (INV-01)</h6></li>
                @if (Model.EInvoiceStatus != "Generated")
                {
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#generateEInvoiceModal"><i class="bi bi-lightning-charge"></i> Generate IRN</button></li>
                }
                <li><a class="dropdown-item" asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id"><i class="bi bi-filetype-json"></i> Download INV-01 JSON</a></li>
                @if (Model.EInvoiceStatus == "Generated")
                {
                    <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelEInvoiceModal"><i class="bi bi-x-circle"></i> Cancel IRN (24 h window)</button></li>
                }
                else
                {
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#recordManualEInvoiceModal"><i class="bi bi-pencil-square"></i> Record manual IRN / ack</button></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="https://einvoice1.gst.gov.in" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> einvoice1.gst.gov.in</a></li>
            </ul>
        </div>
        <div class="btn-group">
            <a asp-controller="WhatsApp" asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary">
                <i class="bi bi-whatsapp text-success"></i> WhatsApp
            </a>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalWa_chatter_TaxInvoice_@Model.Id" title="Edit message before sending">
                <i class="bi bi-sliders"></i>
            </button>
        </div>
        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalEmail_chatter_TaxInvoice_@Model.Id">
            <i class="bi bi-envelope text-primary"></i> Email invoice
        </button>
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary"><i class="bi bi-printer"></i> Print</a>
        @if (canPay)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal"><i class="bi bi-cash"></i> Record payment</button>
        }
    </div>
</div>

@if (Model.EInvoiceStatus == "Generated")
{
    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title"><i class="bi bi-patch-check-fill text-success me-1"></i> E-Invoice registered (INV-01)</div>
                <div class="data-card-sub">Supply type @(Model.EInvoiceSupplyType ?? "B2B")</div>
            </div>
            <div class="btn-row">
                <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary"><i class="bi bi-filetype-json"></i> INV-01 JSON</a>
                <button type="button" class="btn btn-sm btn-danger-ghost" data-bs-toggle="modal" data-bs-target="#cancelEInvoiceModal">Cancel IRN</button>
            </div>
        </div>
        <div class="data-card-body">
            <div class="row g-4 align-items-center">
                <div class="col-md-9">
                    <div class="info-label">Invoice reference number (IRN)</div>
                    <div class="hash-box">
                        <span id="irnValue">@Model.Irn</span>
                        <button type="button" class="btn btn-sm btn-secondary flex-shrink-0" data-copy-target="#irnValue"><i class="bi bi-clipboard"></i> Copy</button>
                    </div>
                    <div class="info-grid mt-3">
                        <div>
                            <div class="info-label">Acknowledgment no.</div>
                            <div class="info-value font-monospace">@Model.EInvoiceAckNo</div>
                        </div>
                        <div>
                            <div class="info-label">Ack date &amp; time</div>
                            <div class="info-value">@(Model.EInvoiceAckDate?.ToString("dd MMM yyyy, HH:mm:ss"))</div>
                        </div>
                    </div>
                </div>
                @if (ViewBag.EInvoiceQrSvg != null)
                {
                    <div class="col-md-3 text-center">
                        <div class="qr-frame">@Html.Raw(ViewBag.EInvoiceQrSvg)</div>
                        <div class="text-2xs text-muted mt-1">Signed QR code</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (Model.EInvoiceStatus == "Cancelled")
{
    <div class="af-alert af-alert-danger mb-4">
        <div class="alert-body">
            <span class="alert-title">E-Invoice cancelled on IRP · @(Model.EInvoiceCancelDate?.ToString("dd MMM yyyy, HH:mm") ?? "—")</span>
            <div>Reason: <strong>@(Model.EInvoiceCancelReason ?? "Not specified")</strong> · Remarks: @(Model.EInvoiceCancelRemarks ?? "None")</div>
            <div class="mt-1">Cancelled IRN: <span class="font-monospace text-break" id="irnValue">@Model.Irn</span></div>
            <div class="btn-row mt-2">
                <button type="button" class="btn btn-sm btn-secondary" data-copy-target="#irnValue"><i class="bi bi-clipboard"></i> Copy IRN</button>
                <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary"><i class="bi bi-filetype-json"></i> Original JSON</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="af-alert af-alert-info mb-4">
        <div class="alert-body">
            <span class="alert-title">E-Invoice pending</span>
            Mandatory for B2B supplies under GST Rule 48(4). Register this invoice to generate the 64-character IRN and signed QR code.
            <div class="btn-row mt-2">
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#generateEInvoiceModal"><i class="bi bi-lightning-charge"></i> Generate IRN</button>
                <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary"><i class="bi bi-filetype-json"></i> INV-01 JSON</a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#recordManualEInvoiceModal"><i class="bi bi-pencil-square"></i> Record IRN</button>
            </div>
        </div>
    </div>
}

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Grand total</div>
        <div class="metric-value">₹@Model.GrandTotal.ToString("N2")</div>
        <div class="metric-meta">tax inclusive</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total paid</div>
        <div class="metric-value">₹@Model.PaidAmount.ToString("N2")</div>
        <div class="metric-meta success">@Model.Receipts.Count @(Model.Receipts.Count == 1 ? "receipt" : "receipts") recorded</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Balance due</div>
        <div class="metric-value">₹@Model.BalanceDue.ToString("N2")</div>
        <div class="metric-meta @(Model.BalanceDue > 0 ? "warning" : "")">remaining receivable</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">GST amount</div>
        <div class="metric-value">₹@((Model.CgstAmount + Model.SgstAmount + Model.IgstAmount).ToString("N2"))</div>
        <div class="metric-meta">@(Model.IsInterState ? "IGST (inter-state)" : "CGST + SGST (intra-state)")</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="data-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Customer &amp; supply</div>
            </div>
            <div class="data-card-body">
                <div class="text-foreground fw-semibold">@Model.CustomerName</div>
                @if (!string.IsNullOrEmpty(Model.CustomerGstin))
                {
                    <div class="text-xs text-muted">GSTIN <span class="font-monospace">@Model.CustomerGstin</span></div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerPan))
                {
                    <div class="text-xs text-muted">PAN <span class="font-monospace">@Model.CustomerPan</span></div>
                }
                <div class="info-grid mt-3" style="grid-template-columns: 1fr;">
                    <div>
                        <div class="info-label">Billing address</div>
                        <div class="info-value text-sm">@(Model.BillingAddress ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Shipping address</div>
                        <div class="info-value text-sm">@(Model.ShippingAddress ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Place of supply</div>
                        <div class="info-value"><span class="af-badge b-gray">@Model.PlaceOfSupply</span></div>
                    </div>
                    @if (Model.SalesOrder != null)
                    {
                        <div>
                            <div class="info-label">Source sales order</div>
                            <div class="info-value"><a asp-controller="SalesOrder" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="fw-medium">@Model.SalesOrder.SoNumber</a></div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="data-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Bank account</div>
            </div>
            <div class="data-card-body">
                <div class="kv-row"><span class="k">Bank</span><span class="v">@Model.BankName</span></div>
                <div class="kv-row"><span class="k">A/C number</span><span class="v font-monospace">@Model.BankAccountNumber</span></div>
                <div class="kv-row"><span class="k">IFSC</span><span class="v font-monospace">@Model.BankIfsc</span></div>
                <div class="kv-row"><span class="k">Branch</span><span class="v">@Model.BankBranch</span></div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="table-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Invoiced items</div>
                <span class="text-xs text-muted">@Model.Items.Count @(Model.Items.Count == 1 ? "line" : "lines")</span>
            </div>
            <div class="table-scroll">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>HSN</th>
                            <th>Colour / size</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Taxable</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="cell-title">@item.Description</span>
                                    @if (item.Design != null)
                                    {
                                        <span class="cell-sub">Design @item.Design.DesignNumber</span>
                                    }
                                </td>
                                <td><span class="mono-id">@item.HsnCode</span></td>
                                <td>@(item.Colour ?? "—") / @(item.Size ?? "—")</td>
                                <td class="cell-num">@item.Quantity</td>
                                <td class="cell-num">₹@item.UnitPrice.ToString("N2")</td>
                                <td class="cell-num">₹@item.TaxableValue.ToString("N2")</td>
                                <td class="cell-num text-foreground fw-semibold">₹@item.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="totals-foot">
                        <tr>
                            <td colspan="5" class="text-end">Subtotal</td>
                            <td colspan="2" class="v">₹@Model.SubTotal.ToString("N2")</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="5" class="text-end">Discount</td>
                                <td colspan="2" class="v text-danger">−₹@Model.DiscountAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="5" class="text-end">Taxable value</td>
                            <td colspan="2" class="v">₹@Model.TaxableAmount.ToString("N2")</td>
                        </tr>
                        @if (Model.IsInterState)
                        {
                            <tr>
                                <td colspan="5" class="text-end">IGST (@Model.IgstRate%)</td>
                                <td colspan="2" class="v">₹@Model.IgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-end">CGST (@Model.CgstRate%)</td>
                                <td colspan="2" class="v">₹@Model.CgstAmount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="5" class="text-end">SGST (@Model.SgstRate%)</td>
                                <td colspan="2" class="v">₹@Model.SgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.RoundOff != 0)
                        {
                            <tr>
                                <td colspan="5" class="text-end">Round off</td>
                                <td colspan="2" class="v text-muted">₹@Model.RoundOff.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="grand">
                            <td colspan="5" class="text-end">Grand total</td>
                            <td colspan="2" class="v">₹@Model.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="table-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Payment receipts</div>
                <span class="text-xs text-muted">@Model.Receipts.Count recorded</span>
            </div>
            @if (Model.Receipts.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Receipt</th>
                                <th>Date</th>
                                <th>Mode</th>
                                <th>Reference / UTR</th>
                                <th class="text-end">Amount</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Receipts)
                            {
                                <tr>
                                    <td><span class="mono-id">@r.ReceiptNumber</span></td>
                                    <td class="text-nowrap tabular">@r.PaymentDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="af-badge b-gray">@r.PaymentMode.Humanize()</span></td>
                                    <td class="font-monospace text-xs">@(r.ReferenceNumber ?? "—")</td>
                                    <td class="cell-num text-success fw-semibold">₹@r.Amount.ToString("N2")</td>
                                    <td class="text-muted text-xs">@(r.Notes ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-4">
                    <div class="es-icon"><i class="bi bi-wallet2"></i></div>
                    <div class="es-title">No payments yet</div>
                    <p>Payments recorded against this invoice will appear here.</p>
                    @if (canPay)
                    {
                        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#paymentModal">Record payment</button>
                    }
                </div>
            }
        </div>

        @if (Model.Returns != null && Model.Returns.Any())
        {
            <div class="table-card mb-4">
                <div class="data-card-header">
                    <div class="data-card-title">Goods returns &amp; credit notes</div>
                    <span class="af-badge b-red">Total −₹@Model.Returns.Sum(r => r.GrandTotal).ToString("N2")</span>
                </div>
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Return</th>
                                <th>Date</th>
                                <th>Reason</th>
                                <th>Items returned</th>
                                <th class="text-end">Credit value</th>
                                <th class="text-end">Comm. deducted</th>
                                <th>Restocked</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ret in Model.Returns)
                            {
                                <tr>
                                    <td><span class="mono-id">@ret.ReturnNumber</span></td>
                                    <td class="text-nowrap tabular">@ret.ReturnDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="af-badge b-gray">@ret.Reason.Humanize()</span></td>
                                    <td>
                                        @foreach (var ri in ret.Items)
                                        {
                                            <span class="d-block text-xs">@ri.Quantity pcs × @ri.Description (@ri.Colour / @ri.Size)</span>
                                        }
                                    </td>
                                    <td class="cell-num text-danger fw-semibold">−₹@ret.GrandTotal.ToString("N2")</td>
                                    <td class="cell-num text-warning">−₹@ret.TotalCommissionDeducted.ToString("N2")</td>
                                    <td>
                                        @if (ret.RestockInventory)
                                        {
                                            <span class="af-badge b-green">Stock in</span>
                                        }
                                        else
                                        {
                                            <span class="af-badge b-gray">No</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (commEntries != null && commEntries.Any())
        {
            decimal netComm = commEntries.Sum(c => c.CommissionAmount);
            <div class="table-card mb-4">
                <div class="data-card-header">
                    <div class="data-card-title">Salesman commission</div>
                    <span class="af-badge @(netComm >= 0 ? "b-indigo" : "b-red")">Net ₹@netComm.ToString("N2")</span>
                </div>
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Salesman</th>
                                <th>Basis / target</th>
                                <th class="text-end">Eligible sales</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Commission</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comm in commEntries)
                            {
                                bool isDeduction = comm.CommissionAmount < 0;
                                <tr class="@(isDeduction ? "row-warning" : "")">
                                    <td>
                                        <span class="cell-title">@comm.SalesmanName</span>
                                        @if (isDeduction)
                                        {
                                            <span class="cell-sub text-danger">Return deduction</span>
                                        }
                                    </td>
                                    <td><span class="af-badge b-gray">@comm.Basis.Humanize(): @(comm.CategoryOrTarget ?? "All")</span></td>
                                    <td class="cell-num">@(isDeduction ? $"−₹{Math.Abs(comm.SalesAmount):N2}" : $"₹{comm.SalesAmount:N2}")</td>
                                    <td class="cell-num">@comm.CommissionRate@(comm.CalcType == AashanaFashion.Models.CommissionCalcType.FixedAmount ? " ₹/pc" : "%")</td>
                                    <td class="cell-num fw-semibold @(isDeduction ? "text-danger" : "text-success")">@(isDeduction ? $"−₹{Math.Abs(comm.CommissionAmount):N2}" : $"₹{comm.CommissionAmount:N2}")</td>
                                    <td>
                                        @if (comm.IsPaid)
                                        {
                                            <span class="af-badge b-green">Paid</span>
                                        }
                                        else if (isDeduction)
                                        {
                                            <span class="af-badge b-red">Pending clawback</span>
                                        }
                                        else
                                        {
                                            <span class="af-badge b-yellow">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

