@model AashanaFashion.Models.TaxInvoice
@{
    ViewData["Title"] = $"Tax Invoice {Model.InvoiceNumber}";
}

<!-- Top Invoice Card: Header, Meta & Actions -->
<div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        <!-- Top Navigation & Status Bar -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                    ← Back to Invoices
                </a>
                <span class="text-muted small">|</span>
                <span class="badge bg-light text-dark border">
                    @(Model.SalesOrder != null ? $"SO Ref: {Model.SalesOrder.SoNumber}" : "Direct Invoice")
                </span>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Payment Status Badge -->
                @if (Model.PaymentStatus == AashanaFashion.Models.InvoicePaymentStatus.Paid)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-3 fs-6">
                        ✔ Paid / Settled
                    </span>
                }
                else if (Model.PaymentStatus == AashanaFashion.Models.InvoicePaymentStatus.PartiallyPaid)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1.5 px-3 fs-6">
                        ⏳ Partially Paid
                    </span>
                }
                else if (Model.PaymentStatus == AashanaFashion.Models.InvoicePaymentStatus.Unpaid)
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1.5 px-3 fs-6">
                        ⚠️ Unpaid
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle py-1.5 px-3 fs-6">
                        ⛔ Cancelled
                    </span>
                }

                <!-- E-Invoice Status Badge -->
                @if (Model.EInvoiceStatus == "Generated")
                {
                    <span class="badge bg-success py-1.5 px-2.5 d-inline-flex align-items-center gap-1" title="IRN: @Model.Irn">
                        ⚡ IRN Active
                    </span>
                }
                else if (Model.EInvoiceStatus == "Cancelled")
                {
                    <span class="badge bg-danger py-1.5 px-2.5 d-inline-flex align-items-center gap-1" title="Cancelled on @Model.EInvoiceCancelDate?.ToString("dd/MM/yyyy")">
                        ❌ IRN Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark py-1.5 px-2.5 d-inline-flex align-items-center gap-1">
                        ⏳ E-Invoice Pending
                    </span>
                }

                <!-- E-Way Bill Status Badge if exists -->
                @if (!string.IsNullOrWhiteSpace(Model.EwayBillNumber))
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-1.5 px-2.5 d-inline-flex align-items-center gap-1">
                        🚚 EWB: @Model.EwayBillNumber
                    </span>
                }
            </div>
        </div>

        <!-- Middle Row: Invoice Title & Meta (Left) + Actions (Right) -->
        <div class="row align-items-center g-3">
            <div class="col-xl-5 col-lg-5">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="fw-bold text-dark mb-0">Invoice @Model.InvoiceNumber</h2>
                    @if (Model.IsInterState)
                    {
                        <span class="badge bg-info-subtle text-info border border-info-subtle">IGST (@Model.IgstRate%)</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border">CGST + SGST (5%)</span>
                    }
                </div>
                <div class="text-muted small mt-2 d-flex flex-wrap gap-x-3 gap-y-1 align-items-center">
                    <span><strong>Customer:</strong> <span class="text-dark fw-semibold">@Model.CustomerName</span></span>
                    <span class="text-muted">·</span>
                    <span><strong>Issued:</strong> @Model.InvoiceDate.ToString("dd MMM yyyy")</span>
                    <span class="text-muted">·</span>
                    <span><strong>Due:</strong> <span class="@(Model.DueDate < DateTime.Today && Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Paid ? "text-danger fw-bold" : "")">@Model.DueDate.ToString("dd MMM yyyy")</span></span>
                    @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
                    {
                        <span class="text-muted">·</span>
                        <span><strong>Vehicle:</strong> <span class="font-monospace">@Model.VehicleNumber</span></span>
                    }
                </div>
            </div>

            <!-- Action Toolbar (Right-aligned, uniform button heights, no vertical text wrap) -->
            <div class="col-xl-7 col-lg-7">
                <div class="d-flex justify-content-lg-end align-items-center gap-2 flex-wrap">
                    <!-- Primary CTA: Record Payment -->
                    @if (Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Paid && Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Cancelled)
                    {
                        <button type="button" class="btn btn-success d-inline-flex align-items-center gap-1.5 text-nowrap fw-semibold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
                            💵 Record Payment
                        </button>
                    }

                    <!-- Print GST Tax Invoice -->
                    <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark d-inline-flex align-items-center gap-1.5 text-nowrap fw-semibold px-3">
                        🖨️ Print Invoice
                    </a>

                    <!-- E-Invoice Compliance Dropdown -->
                    <div class="dropdown">
                        <button class="btn @(Model.EInvoiceStatus == "Generated" ? "btn-outline-primary" : (Model.EInvoiceStatus == "Cancelled" ? "btn-outline-danger" : "btn-primary")) dropdown-toggle d-inline-flex align-items-center gap-1.5 text-nowrap fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span>⚡ E-Invoice</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 250px;">
                            <li class="dropdown-header text-uppercase small fw-bold text-muted">Govt. E-Invoice (INV-01)</li>
                            @if (Model.EInvoiceStatus != "Generated")
                            {
                                <li>
                                    <a class="dropdown-item fw-bold text-primary py-2 rounded" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#generateEInvoiceModal">
                                        ⚡ Generate IRN (IRP Portal)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                            }
                            <li>
                                <a class="dropdown-item py-1.5 rounded" asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id">
                                    📄 Download Govt INV-01 JSON
                                </a>
                            </li>
                            @if (Model.EInvoiceStatus == "Generated")
                            {
                                <li>
                                    <a class="dropdown-item text-danger py-1.5 rounded" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#cancelEInvoiceModal">
                                        ❌ Cancel IRN (24hr Window)
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item py-1.5 rounded" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#recordManualEInvoiceModal">
                                        📝 Record Manual IRN / Ack
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-muted small py-1.5 rounded" href="https://einvoice1.gst.gov.in" target="_blank">
                                    ↗️ Open einvoice1.gst.gov.in
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- E-Way Bill Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1.5 text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span>🚚 E-Way Bill</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 240px;">
                            <li class="dropdown-header text-uppercase small fw-bold text-muted">E-Way Bill Actions</li>
                            <li>
                                <a class="dropdown-item fw-bold text-primary py-2 rounded" asp-action="PrintEwayBill" asp-route-id="@Model.Id" target="_blank">
                                    🖨️ Print Official E-Way Bill
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-1.5 rounded" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#ewayJsonModal">
                                    📄 Download NIC EWB JSON
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-1.5 rounded" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#ewaySaveModal">
                                    💾 Record E-Way Bill Number
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-muted small py-1.5 rounded" href="https://ewaybillgst.gov.in" target="_blank">
                                    ↗️ Open ewaybillgst.gov.in
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- More Options Dropdown -->
                    @if (Model.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Cancelled)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1 text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                ⋯ More
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 200px;">
                                <li>
                                    <a class="dropdown-item text-danger py-2 rounded d-flex align-items-center gap-2" asp-action="ReturnGoods" asp-route-id="@Model.Id">
                                        <span>↩️</span>
                                        <div>
                                            <div class="fw-semibold">Return Goods</div>
                                            <div class="small text-muted" style="font-size:0.75rem;">Issue Credit Note & Restock</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Government E-Invoice (IRP GSTN Standard INV-01) Section -->
@if (Model.EInvoiceStatus == "Generated")
{
    <div class="card border-success border-2 rounded-3 bg-white shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success py-2 px-3 fs-6">✔ Official GST E-Invoice Registered (INV-01)</span>
                    <span class="badge bg-light text-dark border">Supply: @(Model.EInvoiceSupplyType ?? "B2B")</span>
                    @if (!string.IsNullOrWhiteSpace(Model.EwayBillNumber))
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            🚚 E-Way Bill: <strong>@Model.EwayBillNumber</strong>
                        </span>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-dark">
                        🖨️ Print e-Invoice
                    </a>
                    <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                        📄 Download INV-01 JSON
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelEInvoiceModal">
                        Cancel IRN
                    </button>
                </div>
            </div>

            <div class="row g-3 align-items-center">
                <div class="col-md-9">
                    <div class="mb-2">
                        <span class="text-muted small fw-bold text-uppercase" style="letter-spacing:0.5px;">Invoice Reference Number (IRN):</span>
                        <div class="p-2 bg-light border rounded font-monospace fw-bold text-dark d-flex justify-content-between align-items-center mt-1" style="font-size:0.85rem; word-break: break-all;">
                            <span>@Model.Irn</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 ms-2" onclick="navigator.clipboard.writeText('@Model.Irn'); alert('IRN copied to clipboard!');" title="Copy IRN">📋 Copy</button>
                        </div>
                    </div>
                    <div class="row g-2 text-muted small">
                        <div class="col-sm-6">
                            <strong>Acknowledgment No:</strong> <span class="font-monospace text-dark fw-bold">@Model.EInvoiceAckNo</span>
                        </div>
                        <div class="col-sm-6">
                            <strong>Ack Date & Time:</strong> <span class="text-dark fw-bold">@(Model.EInvoiceAckDate?.ToString("dd-MMM-yyyy HH:mm:ss"))</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 text-center border-start">
                    @if (ViewBag.EInvoiceQrSvg != null)
                    {
                        <div class="d-inline-block p-1 bg-white border rounded shadow-sm">
                            @Html.Raw(ViewBag.EInvoiceQrSvg)
                        </div>
                        <div class="small text-muted mt-1" style="font-size:0.7rem;">Official Signed QR Code</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (Model.EInvoiceStatus == "Cancelled")
{
    <div class="card border-danger border-2 rounded-3 bg-white shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger py-2 px-3 fs-6">❌ E-Invoice Cancelled on IRP Portal</span>
                    <span class="badge bg-light text-danger border border-danger-subtle">
                        Cancelled: @(Model.EInvoiceCancelDate?.ToString("dd MMM yyyy, HH:mm") ?? "—")
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                        📄 Download Original JSON
                    </a>
                </div>
            </div>
            <div class="p-2.5 bg-danger-subtle border border-danger-subtle rounded text-dark small mt-2">
                <div class="row g-2">
                    <div class="col-md-4">
                        <strong class="text-danger">Cancellation Reason:</strong>
                        <div class="fw-semibold">@(Model.EInvoiceCancelReason ?? "Not specified")</div>
                    </div>
                    <div class="col-md-8">
                        <strong class="text-danger">Remarks:</strong>
                        <div>@(Model.EInvoiceCancelRemarks ?? "None")</div>
                    </div>
                    <div class="col-12 mt-1 pt-1 border-top border-danger-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="text-muted">Cancelled IRN: </span>
                            <span class="font-monospace fw-bold text-danger text-break">@Model.Irn</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="navigator.clipboard.writeText('@Model.Irn'); alert('Cancelled IRN copied!');">📋 Copy IRN</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border rounded-3 bg-light shadow-sm mb-4">
        <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-secondary">E-Invoice Pending</span>
                    <h6 class="fw-bold text-dark mb-0">Government E-Invoicing (GST INV-01 Standard)</h6>
                </div>
                <small class="text-muted">
                    Mandatory for B2B supplies under GST Rule 48(4). Register this invoice to generate 64-character IRN and digitally signed QR code.
                </small>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary btn-sm fw-bold px-3" data-bs-toggle="modal" data-bs-target="#generateEInvoiceModal">
                    ⚡ Generate E-Invoice (IRN)
                </button>
                <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                    📄 Download INV-01 JSON
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#recordManualEInvoiceModal">
                    📝 Record IRN
                </button>
            </div>
        </div>
    </div>
}


<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Grand Total</span>
                <h3 class="fw-bold my-1 text-primary">₹@Model.GrandTotal.ToString("N2")</h3>
                <small class="text-muted">Tax inclusive billing</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Total Paid</span>
                <h3 class="fw-bold my-1 text-success">₹@Model.PaidAmount.ToString("N2")</h3>
                <small class="text-success fw-semibold">@Model.Receipts.Count receipts recorded</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Balance Due</span>
                <h3 class="fw-bold my-1 @(Model.BalanceDue > 0 ? "text-warning" : "text-muted")">
                    ₹@Model.BalanceDue.ToString("N2")
                </h3>
                <small class="text-muted">Remaining receivable</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">GST Amount</span>
                <h3 class="fw-bold my-1 text-dark">
                    ₹@((Model.CgstAmount + Model.SgstAmount + Model.IgstAmount).ToString("N2"))
                </h3>
                <small class="text-muted">@(Model.IsInterState ? "IGST (Inter-State)" : "CGST + SGST (Intra-State)")</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer & Bank Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">👤 Customer & Place of Supply</h5>
            </div>
            <div class="card-body">
                <h6 class="fw-bold mb-1">@Model.CustomerName</h6>
                @if (!string.IsNullOrEmpty(Model.CustomerGstin))
                {
                    <div class="small text-muted mb-1"><strong>GSTIN:</strong> @Model.CustomerGstin</div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerPan))
                {
                    <div class="small text-muted mb-2"><strong>PAN:</strong> @Model.CustomerPan</div>
                }

                <div class="mb-2">
                    <span class="small text-muted d-block fw-semibold">Billing Address:</span>
                    <span class="small">@(Model.BillingAddress ?? "—")</span>
                </div>
                <div class="mb-2">
                    <span class="small text-muted d-block fw-semibold">Shipping Address:</span>
                    <span class="small">@(Model.ShippingAddress ?? "—")</span>
                </div>
                <div class="mb-2">
                    <span class="small text-muted d-block fw-semibold">Place of Supply:</span>
                    <span class="badge bg-light text-dark border">@Model.PlaceOfSupply</span>
                </div>
                @if (Model.SalesOrder != null)
                {
                    <div class="mt-3 pt-3 border-top">
                        <span class="small text-muted d-block">Source Sales Order:</span>
                        <a asp-controller="SalesOrder" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="fw-bold text-decoration-none">
                            @Model.SalesOrder.SoNumber
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">🏦 Bank Account Details</h5>
            </div>
            <div class="card-body small">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Bank Name:</span>
                    <strong>@Model.BankName</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">A/C Number:</span>
                    <strong>@Model.BankAccountNumber</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">IFSC Code:</span>
                    <strong>@Model.BankIfsc</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Branch:</span>
                    <span>@Model.BankBranch</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Line Items & Payment Receipts -->
    <div class="col-lg-8">
        <!-- Line Items Table -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">📦 Invoiced Items</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item / Description</th>
                                <th>HSN</th>
                                <th>Colour / Size</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Taxable</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.Description</div>
                                        @if (item.Design != null)
                                        {
                                            <small class="text-muted">Design: @item.Design.DesignNumber</small>
                                        }
                                    </td>
                                    <td><small class="badge bg-light text-dark border">@item.HsnCode</small></td>
                                    <td>@(item.Colour ?? "—") / @(item.Size ?? "—")</td>
                                    <td class="text-end fw-semibold">@item.Quantity</td>
                                    <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-end">₹@item.TaxableValue.ToString("N2")</td>
                                    <td class="text-end fw-bold text-primary">₹@item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="5" class="text-end">Subtotal:</td>
                                <td colspan="2" class="text-end fw-bold">₹@Model.SubTotal.ToString("N2")</td>
                            </tr>
                            @if (Model.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-end text-danger">Discount:</td>
                                    <td colspan="2" class="text-end text-danger fw-bold">- ₹@Model.DiscountAmount.ToString("N2")</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="5" class="text-end">Taxable Value:</td>
                                <td colspan="2" class="text-end fw-bold">₹@Model.TaxableAmount.ToString("N2")</td>
                            </tr>
                            @if (Model.IsInterState)
                            {
                                <tr>
                                    <td colspan="5" class="text-end">IGST (@Model.IgstRate%):</td>
                                    <td colspan="2" class="text-end fw-bold">₹@Model.IgstAmount.ToString("N2")</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-end">CGST (@Model.CgstRate%):</td>
                                    <td colspan="2" class="text-end fw-bold">₹@Model.CgstAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="5" class="text-end">SGST (@Model.SgstRate%):</td>
                                    <td colspan="2" class="text-end fw-bold">₹@Model.SgstAmount.ToString("N2")</td>
                                </tr>
                            }
                            @if (Model.RoundOff != 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-end text-muted small">Round Off:</td>
                                    <td colspan="2" class="text-end text-muted small">₹@Model.RoundOff.ToString("N2")</td>
                                </tr>
                            }
                            <tr class="fs-5">
                                <td colspan="5" class="text-end fw-bold">Grand Total:</td>
                                <td colspan="2" class="text-end fw-bold text-primary">₹@Model.GrandTotal.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Payment Receipts History -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">💵 Customer Payment Receipts</h5>
                <span class="badge bg-secondary-subtle text-secondary">@Model.Receipts.Count payments recorded</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Receipts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Receipt #</th>
                                    <th>Payment Date</th>
                                    <th>Payment Mode</th>
                                    <th>Reference / UTR</th>
                                    <th class="text-end">Amount</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Receipts)
                                {
                                    <tr>
                                        <td class="fw-bold">@r.ReceiptNumber</td>
                                        <td>@r.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@r.PaymentMode</span></td>
                                        <td>@(r.ReferenceNumber ?? "—")</td>
                                        <td class="text-end fw-bold text-success">₹@r.Amount.ToString("N2")</td>
                                        <td class="small text-muted">@(r.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <span>No payments received yet for this invoice.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Goods Returns & Credit Notes History -->
        @if (Model.Returns != null && Model.Returns.Any())
        {
            <div class="card border-0 shadow-sm rounded-3 mt-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">↩️ Goods Returns &amp; Credit Notes</h5>
                    <span class="badge bg-danger-subtle text-danger">Total Returns: ₹@Model.Returns.Sum(r => r.GrandTotal).ToString("N2")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Return #</th>
                                    <th>Date</th>
                                    <th>Reason</th>
                                    <th>Items Returned</th>
                                    <th class="text-end">Credit Value (₹)</th>
                                    <th class="text-end">Comm. Deducted (₹)</th>
                                    <th class="text-center">Restocked</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ret in Model.Returns)
                                {
                                    <tr>
                                        <td class="fw-bold text-danger">@ret.ReturnNumber</td>
                                        <td>@ret.ReturnDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@ret.Reason</span></td>
                                        <td>
                                            @foreach (var ri in ret.Items)
                                            {
                                                <div class="small">@ri.Quantity pcs × @ri.Description (@ri.Colour / @ri.Size)</div>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-danger">-₹@ret.GrandTotal.ToString("N2")</td>
                                        <td class="text-end fw-semibold text-warning">-₹@ret.TotalCommissionDeducted.ToString("N2")</td>
                                        <td class="text-center">
                                            @if (ret.RestockInventory)
                                            {
                                                <span class="badge bg-success">Yes (Stock In)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Salesman Commission Breakdown -->
        @{
            var commEntries = ViewBag.CommissionEntries as List<AashanaFashion.Models.SalesmanCommissionEntry>;
        }
        @if (commEntries != null && commEntries.Any())
        {
            decimal netComm = commEntries.Sum(c => c.CommissionAmount);
            <div class="card border-0 shadow-sm rounded-3 mt-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">🤝 Salesman Commission Breakdown</h5>
                    <div>
                        <span class="badge @(netComm >= 0 ? "bg-primary-subtle text-primary" : "bg-danger-subtle text-danger") fs-6">
                            Net Commission: ₹@netComm.ToString("N2")
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Salesman</th>
                                    <th>Basis / Target</th>
                                    <th class="text-end">Eligible Sales (₹)</th>
                                    <th class="text-center">Rate</th>
                                    <th class="text-end">Commission (₹)</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comm in commEntries)
                                {
                                    bool isDeduction = comm.CommissionAmount < 0;
                                    <tr class="@(isDeduction ? "table-warning bg-opacity-25" : "")">
                                        <td class="fw-bold">
                                            @comm.SalesmanName
                                            @if (isDeduction)
                                            {
                                                <span class="badge bg-danger ms-1" style="font-size:0.7rem;">↩️ Return Deduction</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@comm.Basis: @(comm.CategoryOrTarget ?? "All")</span>
                                        </td>
                                        <td class="text-end">
                                            @(isDeduction ? $"-₹{Math.Abs(comm.SalesAmount):N2}" : $"₹{comm.SalesAmount:N2}")
                                        </td>
                                        <td class="text-center">
                                            @comm.CommissionRate@(comm.CalcType == AashanaFashion.Models.CommissionCalcType.FixedAmount ? " ₹/pc" : "%")
                                        </td>
                                        <td class="text-end fw-bold @(isDeduction ? "text-danger" : "text-success")">
                                            @(isDeduction ? $"-₹{Math.Abs(comm.CommissionAmount):N2}" : $"₹{comm.CommissionAmount:N2}")
                                        </td>
                                        <td class="text-center">
                                            @if (comm.IsPaid)
                                            {
                                                <span class="badge bg-success">Paid</span>
                                            }
                                            else if (isDeduction)
                                            {
                                                <span class="badge bg-danger">Pending Clawback</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Record Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RecordPayment" method="post">
