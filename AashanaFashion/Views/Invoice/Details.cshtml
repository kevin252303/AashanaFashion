<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="InvoiceId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="paymentModalLabel">Record payment receipt</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="panel-inset">
                        <div class="kv-row"><span class="k">Invoice</span><span class="v font-monospace">@Model.InvoiceNumber</span></div>
                        <div class="kv-row"><span class="k">Balance due</span><span class="v text-warning">₹@Model.BalanceDue.ToString("N2")</span></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="payAmount">Amount (₹) <span class="req">*</span></label>
                            <input type="number" step="0.01" id="payAmount" name="Amount" class="af-input fw-semibold" value="@Model.BalanceDue" max="@Model.BalanceDue" min="0.01" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="payDate">Payment date <span class="req">*</span></label>
                            <input type="date" id="payDate" name="PaymentDate" class="af-input" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="payMode">Payment mode</label>
                            <select id="payMode" name="PaymentMode" class="af-input af-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.PaymentMode>()"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="payRef">Reference (UTR / cheque)</label>
                            <input type="text" id="payRef" name="ReferenceNumber" class="af-input font-monospace" placeholder="e.g. UTR12345678" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="payNotes">Notes</label>
                            <textarea id="payNotes" name="Notes" class="af-input" rows="2" placeholder="Optional payment remarks…"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="ewayJsonModal" tabindex="-1" aria-labelledby="ewayJsonTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="DownloadEwayBillJson" method="get" class="modal-content">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title" id="ewayJsonTitle">Download NIC e-way bill JSON</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="af-alert af-alert-info">
                    <div class="alert-body">Upload this file on <a href="https://ewaybillgst.gov.in" target="_blank" rel="noopener">ewaybillgst.gov.in</a> → E-Waybill → Generate Bulk.</div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Vehicle number</label>
                        <input type="text" name="VehicleNumber" class="af-input text-uppercase font-monospace" placeholder="e.g. GJ05AB1234" value="@Model.VehicleNumber" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Approx. distance (km) <span class="req">*</span></label>
                        <input type="number" name="DistanceKm" class="af-input" value="@(Model.DistanceKm ?? 50)" min="1" max="4000" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Transporter / courier name</label>
                        <input type="text" name="TransporterName" class="af-input" placeholder="e.g. VRL Logistics, SafeXpress" value="@Model.TransporterName" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Transporter ID (GSTIN / TRANSIN)</label>
                        <input type="text" name="TransporterId" class="af-input text-uppercase font-monospace" placeholder="15-digit GSTIN or TRANSIN (optional)" value="@Model.TransporterId" />
                        <div class="form-text">Enter when assigning to a registered transporter.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Vehicle type</label>
                        <select name="VehicleType" class="af-input af-select">
                            <option value="R">Regular</option>
                            <option value="O">Over dimensional cargo (ODC)</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Transport mode</label>
                        <select name="TransMode" class="af-input af-select">
                            <option value="1">1 — Road</option>
                            <option value="2">2 — Rail</option>
                            <option value="3">3 — Air</option>
                            <option value="4">4 — Ship</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-download"></i> Download JSON</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="ewaySaveModal" tabindex="-1" aria-labelledby="ewaySaveTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="SaveEwayBill" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title" id="ewaySaveTitle">Record e-way bill number</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-muted">The 12-digit number issued by the government portal. It is printed on the tax invoice and delivery challan.</p>
                <div class="row g-3">
                    <div class="col-7">
                        <label class="form-label">E-way bill number <span class="req">*</span></label>
                        <input type="text" name="EwayBillNumber" class="af-input font-monospace fw-semibold" placeholder="e.g. 123456789012" value="@Model.EwayBillNumber" maxlength="20" required />
                    </div>
                    <div class="col-5">
                        <label class="form-label">E-way bill date</label>
                        <input type="date" name="EwayBillDate" class="af-input" value="@((Model.EwayBillDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Vehicle number</label>
                        <input type="text" name="VehicleNumber" class="af-input text-uppercase font-monospace" value="@Model.VehicleNumber" placeholder="GJ05AB1234" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Transporter</label>
                        <input type="text" name="TransporterName" class="af-input" value="@Model.TransporterName" placeholder="Transporter name" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save e-way bill</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="generateEInvoiceModal" tabindex="-1" aria-labelledby="genEinvTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="GenerateEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title" id="genEinvTitle">Generate e-invoice (IRN)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-muted">Generates the 64-character Invoice Reference Number and signed QR code per GSTN / IRP standards (INV-01 schema).</p>
                <div class="mb-3">
                    <label class="form-label">Supply type</label>
                    <select name="supplyType" class="af-input af-select">
                        <option value="B2B" selected>B2B — Regular business-to-business</option>
                        <option value="SEZWP">SEZWP — SEZ with payment of tax</option>
                        <option value="SEZWOP">SEZWOP — SEZ without payment of tax</option>
                        <option value="EXPWP">EXPWP — Export with payment of tax</option>
                        <option value="EXPWOP">EXPWOP — Export without payment of tax</option>
                        <option value="DEXP">DEXP — Deemed export</option>
                    </select>
                </div>
                <div class="panel-inset">
                    <div class="kv-row"><span class="k">Customer GSTIN</span><span class="v font-monospace">@(string.IsNullOrWhiteSpace(Model.CustomerGstin) ? "Not provided (URP)" : Model.CustomerGstin)</span></div>
                    <div class="kv-row"><span class="k">Place of supply</span><span class="v">@Model.PlaceOfSupply</span></div>
                    <div class="kv-row"><span class="k">Invoice value</span><span class="v">₹@Model.GrandTotal.ToString("N2")</span></div>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="chkGenEway" name="generateEwayBill" value="true" @(!string.IsNullOrWhiteSpace(Model.VehicleNumber) ? "checked" : "") />
                    <label class="form-check-label" for="chkGenEway">Also generate e-way bill number</label>
                </div>
                <div id="ewayFieldsSection" class="row g-3 @(string.IsNullOrWhiteSpace(Model.VehicleNumber) ? "d-none" : "")">
                    <div class="col-6">
                        <label class="form-label">Vehicle number</label>
                        <input type="text" name="vehicleNumber" class="af-input text-uppercase font-monospace" placeholder="GJ05AB1234" value="@Model.VehicleNumber" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Distance (km)</label>
                        <input type="number" name="distanceKm" class="af-input" value="@(Model.DistanceKm ?? 50)" min="1" max="4000" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Transporter ID</label>
                        <input type="text" name="transporterId" class="af-input text-uppercase font-monospace" placeholder="15-digit GSTIN" value="@Model.TransporterId" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Transporter name</label>
                        <input type="text" name="transporterName" class="af-input" placeholder="Transporter name" value="@Model.TransporterName" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-lightning-charge"></i> Register e-invoice</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="cancelEInvoiceModal" tabindex="-1" aria-labelledby="cancelEinvTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="CancelEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title" id="cancelEinvTitle">Cancel e-invoice (IRN)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="af-alert af-alert-warning">
                    <div class="alert-body">An IRN can only be cancelled within 24 hours of generation. The same invoice number cannot be used again for a new IRN.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Cancellation reason <span class="req">*</span></label>
                    <select name="cancelReason" class="af-input af-select" required>
                        <option value="1">1 — Duplicate invoice</option>
                        <option value="2">2 — Data entry mistake</option>
                        <option value="3">3 — Order cancelled by buyer</option>
                        <option value="4">4 — Other</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Remarks <span class="req">*</span></label>
                    <textarea name="cancelRemarks" class="af-input" rows="3" placeholder="Explain the reason for cancellation…" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-danger" onclick="return confirm('Cancel this official e-invoice IRN? This cannot be undone.');">Cancel IRN</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="recordManualEInvoiceModal" tabindex="-1" aria-labelledby="manualEinvTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="RecordManualEInvoice" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header">
                <h5 class="modal-title" id="manualEinvTitle">Record external e-invoice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-muted">Generated the e-invoice on the government offline tool or a third-party GSP? Paste the details to link them to this invoice.</p>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Invoice reference number (IRN) <span class="req">*</span></label>
                        <input type="text" name="irn" class="af-input font-monospace" placeholder="64-character hex hash" maxlength="64" minlength="64" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Acknowledgment no. <span class="req">*</span></label>
                        <input type="text" name="ackNo" class="af-input font-monospace" placeholder="e.g. 112610012345678" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Ack date &amp; time <span class="req">*</span></label>
                        <input type="datetime-local" name="ackDate" class="af-input" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Signed QR payload</label>
                        <textarea name="signedQr" class="af-input font-monospace text-xs" rows="3" placeholder="Optional — generated automatically if empty"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save e-invoice</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $('#chkGenEway').on('change', function () {
            $('#ewayFieldsSection').toggleClass('d-none', !this.checked);
        });

        $('[data-copy-target]').on('click', function () {
            var text = $($(this).data('copy-target')).text().trim();
            navigator.clipboard.writeText(text).then(function () {
                window.afToast && afToast('IRN copied to clipboard.', 'success');
            });
        });
    </script>
}
