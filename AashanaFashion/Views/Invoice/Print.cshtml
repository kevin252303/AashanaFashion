@model AashanaFashion.Models.TaxInvoice
@{
    ViewData["Title"] = $"Print Invoice — {Model.InvoiceNumber}";
    Layout = null;

    // Amount to words converter helper
    string NumberToWords(decimal number)
    {
        long n = (long)Math.Floor(number);
        if (n == 0) return "Zero Rupees Only";
        
        string[] units = { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tens = { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        string ConvertPart(long val)
        {
            if (val == 0) return "";
            if (val < 20) return units[val] + " ";
            if (val < 100) return tens[val / 10] + " " + units[val % 10] + " ";
            return units[val / 100] + " Hundred " + ConvertPart(val % 100);
        }

        string result = "";
        if (n >= 10000000) { result += ConvertPart(n / 10000000) + "Crore "; n %= 10000000; }
        if (n >= 100000) { result += ConvertPart(n / 100000) + "Lakh "; n %= 100000; }
        if (n >= 1000) { result += ConvertPart(n / 1000) + "Thousand "; n %= 1000; }
        if (n > 0) { result += ConvertPart(n); }

        return "Rupees " + result.Trim() + " Only";
    }

    bool hasEInvoice = !string.IsNullOrEmpty(Model.Irn) || Model.EInvoiceStatus == "Generated";
    bool isCancelledEInvoice = Model.EInvoiceStatus == "Cancelled";

    var compName = Model.Company?.CompanyName ?? "AASHANA FASHION";
    var compGstin = Model.Company?.Gstin ?? "24AABCA1234F1Z8";
    var compState = Model.Company?.State ?? "Gujarat";
    var compStateCode = Model.Company?.StateCode ?? 24;
    var compAddress = Model.Company != null 
        ? $"{Model.Company.Address1} {Model.Company.Address2}, {Model.Company.City}, {Model.Company.State} - {Model.Company.PinCode}".Trim().Trim(',').Trim()
        : "101-104, Surat Textile Market, Ring Road, Surat, Gujarat - 395002";
    var compEmail = Model.Company?.Email ?? "sales@aashanafashion.com";
    var compPhone = Model.Company?.Phone ?? "+91 98765 43210";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #0f172a;
            margin: 0;
            padding: 0;
            font-size: 9pt;
        }

        .no-print-bar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 10px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .invoice-page {
            width: 210mm;
            min-height: 275mm;
            margin: 15px auto;
            background: #ffffff;
            padding: 8mm 10mm;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .invoice-watermark {
            position: absolute !important;
            top: 50% !important;
            left: 50% !important;
            transform: translate(-50%, -50%) !important;
            width: 70% !important;
            max-width: 480px !important;
            pointer-events: none !important;
            opacity: 0.10 !important;
            z-index: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .invoice-watermark img {
            width: 100% !important;
            height: auto !important;
            object-fit: contain !important;
            pointer-events: none !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Ensure all text and table contents sit cleanly above the watermark */
        .invoice-body, .invoice-footer {
            position: relative;
            z-index: 1;
        }

        .tax-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8pt;
        }

        .tax-table th, .tax-table td {
            border: 1px solid #000000;
            padding: 3px 5px;
        }

        .tax-table th {
            background-color: #f1f5f9;
            text-align: center;
            font-weight: 700;
        }

        @@page {
            size: A4 portrait;
            margin: 4mm 6mm;
        }

        @@media print {
            html, body {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
                font-size: 8.5pt !important;
                height: auto !important;
            }
            .no-print-bar { display: none !important; }
            .invoice-page {
                width: 100% !important;
                max-width: 100% !important;
                min-height: auto !important;
                height: auto !important;
                box-shadow: none !important;
                border: none !important;
                margin: 0 !important;
                padding: 2mm 0 !important;
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
                position: relative !important;
                display: block !important;
            }
            .invoice-body {
                position: relative !important;
                z-index: 1 !important;
                display: block !important;
            }
            .invoice-footer {
                position: relative !important;
                z-index: 1 !important;
                page-break-inside: avoid !important;
                page-break-before: avoid !important;
                margin-top: 6px !important;
                padding-top: 6px !important;
            }

            .invoice-watermark {
                position: absolute !important;
                top: 50% !important;
                left: 50% !important;
                transform: translate(-50%, -50%) !important;
                width: 65% !important;
                max-width: 450px !important;
                display: flex !important;
                opacity: 0.10 !important;
                z-index: 0 !important;
                pointer-events: none !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .invoice-watermark img {
                width: 100% !important;
                height: auto !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }
    </style>
</head>
<body>

    <div class="no-print-bar">
        <div class="d-flex align-items-center gap-3">
            <a href="/Invoice/Details/@Model.Id" class="btn btn-sm btn-outline-secondary">← Back to Invoice</a>
            <h5 class="mb-0 fw-bold">
                @(hasEInvoice ? "⚡ Govt. Standard E-Invoice" : "GST Tax Invoice") — @Model.InvoiceNumber
            </h5>
            @if (hasEInvoice)
            {
                <span class="badge @(isCancelledEInvoice ? "bg-danger" : "bg-success")">
                    @(isCancelledEInvoice ? "Cancelled IRN" : "IRN Verified")
                </span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (hasEInvoice)
            {
                <a asp-action="DownloadEInvoiceJson" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">
                    📥 Download INV-01 JSON
                </a>
            }
            <button type="button" class="btn btn-primary fw-bold px-4" onclick="window.print()">
                🖨️ Print Tax Invoice
            </button>
        </div>
    </div>

    <div class="invoice-page">
        <!-- Watermark centered inside the invoice page (Visible on Screen & in Print) -->
        <div class="invoice-watermark" aria-hidden="true">
            <img src="/images/aashana_watermark.png" alt="Aashana Fashion Watermark" />
        </div>
        <div class="invoice-body">
            <!-- Top Heading & Copy Type -->
            <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-1">
                <div class="text-muted small" style="font-size: 8pt;">
                    <strong>GSTIN:</strong> @compGstin &nbsp;|&nbsp; <strong>State:</strong> @compState (@compStateCode)
                </div>
                <div class="text-uppercase fw-bold border px-2 py-0 @(isCancelledEInvoice ? "bg-danger text-white border-danger" : (hasEInvoice ? "bg-dark text-white border-dark" : "bg-light text-dark"))" style="font-size: 8pt; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
                    @(isCancelledEInvoice ? "TAX INVOICE (CANCELLED e-INVOICE) / Recipient Copy" : (hasEInvoice ? "TAX INVOICE (e-Invoice) / Original for Recipient" : "Tax Invoice / Original for Recipient"))
                </div>
            </div>

            <!-- Company Info Header & QR Code Section -->
            <div class="row align-items-center pb-2 mb-1 border-bottom g-2">
                <div class="@(hasEInvoice && ViewBag.EInvoiceQrSvg != null ? "col-9" : "col-12 text-center")">
                    <h2 class="fw-bold mb-0 text-uppercase tracking-wide" style="font-size: 16pt; letter-spacing: 1px;">@compName</h2>
                    <div class="small fw-semibold text-muted" style="font-size: 8pt;">Manufacturer & Wholesaler of Exclusive Designer Ethnic Garments</div>
                    <div class="small" style="font-size: 8pt;">@compAddress</div>
                    <div class="small text-muted" style="font-size: 7.5pt;">Email: @compEmail | Phone: @compPhone</div>
                </div>
                @if (hasEInvoice && ViewBag.EInvoiceQrSvg != null)
                {
                    <div class="col-3 text-end d-flex flex-column align-items-end justify-content-center">
                        <div class="p-1 border rounded bg-white text-center shadow-sm" style="display: inline-block;">
                            <div style="width: 100px; height: 100px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                @Html.Raw(ViewBag.EInvoiceQrSvg)
                            </div>
                            <div class="text-uppercase fw-bold text-muted mt-1" style="font-size: 6pt; letter-spacing: 0.5px;">GST Signed QR</div>
                        </div>
                    </div>
                }
            </div>

            @if (hasEInvoice && !string.IsNullOrEmpty(Model.Irn))
            {
                <!-- Official Government e-Invoice IRN Banner -->
                <div class="border border-dark p-2 mb-2 bg-light text-dark" style="font-size: 8pt; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
                    <div class="row g-1 align-items-center">
                        <div class="col-12">
                            <span class="text-muted fw-bold">IRN: </span>
                            <span class="font-monospace fw-bold" style="word-break: break-all; font-size: 7.5pt; color: #0f172a;">@Model.Irn</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted fw-bold">Ack No: </span>
                            <span class="font-monospace fw-bold">@(Model.EInvoiceAckNo ?? "N/A")</span>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted fw-bold">Ack Date: </span>
                            <span class="fw-semibold">@(Model.EInvoiceAckDate?.ToString("dd-MMM-yyyy HH:mm:ss") ?? "N/A")</span>
                        </div>
                        @if (isCancelledEInvoice)
                        {
                            <div class="col-12 mt-1">
                                <div class="bg-danger text-white px-2 py-1 text-center fw-bold small rounded" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">
                                    ⚠ THIS E-INVOICE HAS BEEN CANCELLED ON IRP (Reason: @Model.EInvoiceCancelReason - @Model.EInvoiceCancelRemarks)
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Invoice & Customer Meta Grid -->
            <div class="row g-0 border mb-1">
                <div class="col-6 p-2 border-end">
                    <strong class="d-block mb-1 text-uppercase small text-muted">Billed To (Customer):</strong>
                    <div class="fw-bold fs-6">@Model.CustomerName</div>
                    <div class="small">@(Model.BillingAddress ?? "Address not provided")</div>
                    <div class="small mt-1"><strong>GSTIN:</strong> @(Model.CustomerGstin ?? "Unregistered")</div>
                    @if (!string.IsNullOrEmpty(Model.CustomerPan))
                    {
                        <div class="small"><strong>PAN:</strong> @Model.CustomerPan</div>
                    }
                    <div class="small"><strong>Place of Supply:</strong> @Model.PlaceOfSupply</div>
                </div>
                <div class="col-6 p-2">
                    <table class="table table-sm table-borderless mb-0 small">
                        <tr>
                            <td class="text-muted" style="width: 45%;">Invoice No:</td>
                            <td class="fw-bold fs-6 text-dark">@Model.InvoiceNumber</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Invoice Date:</td>
                            <td class="fw-semibold">@Model.InvoiceDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Due Date:</td>
                            <td class="fw-semibold">@Model.DueDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        @if (Model.SalesOrder != null)
                        {
                            <tr>
                                <td class="text-muted">Sales Order Ref:</td>
                                <td class="fw-semibold">@Model.SalesOrder.SoNumber</td>
                            </tr>
                        }
                        <tr>
                            <td class="text-muted">Reverse Charge:</td>
                            <td>No</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.EInvoiceSupplyType))
                        {
                            <tr>
                                <td class="text-muted">Supply Type:</td>
                                <td class="fw-semibold">@Model.EInvoiceSupplyType</td>
                            </tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.EwayBillNumber))
                        {
                            <tr>
                                <td class="text-muted fw-bold">E-Way Bill No:</td>
                                <td class="fw-bold font-monospace text-dark">@Model.EwayBillNumber</td>
                            </tr>
                            @if (Model.EwayBillDate.HasValue)
                            {
                                <tr>
                                    <td class="text-muted">E-Way Bill Date:</td>
                                    <td>@Model.EwayBillDate.Value.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.VehicleNumber))
                        {
                            <tr>
                                <td class="text-muted">Vehicle No:</td>
                                <td class="font-monospace">@Model.VehicleNumber</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            <!-- Tax Invoice Items Table -->
            <table class="tax-table mb-1">
                <thead>
                    <tr>
                        <th style="width: 4%;">#</th>
                        <th style="width: 34%;">Description of Goods</th>
                        <th style="width: 8%;">HSN</th>
                        <th style="width: 6%;">Qty</th>
                        <th style="width: 10%;">Rate (₹)</th>
                        <th style="width: 10%;">Taxable (₹)</th>
                        @if (Model.IsInterState)
                        {
                            <th style="width: 14%;">IGST (@Model.IgstRate%)</th>
                        }
                        else
                        {
                            <th style="width: 8%;">CGST (2.5%)</th>
                            <th style="width: 8%;">SGST (2.5%)</th>
                        }
                        <th style="width: 14%;">Total (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sl = 1; }
                    @foreach (var item in Model.Items)
                    {
                        decimal lineTax = Math.Round(item.TaxableValue * (item.GstRate / 100m), 2);
                        <tr>
                            <td class="text-center">@sl</td>
                            <td>
                                <strong>@item.Description</strong>
                                @if (!string.IsNullOrEmpty(item.Colour) || !string.IsNullOrEmpty(item.Size))
                                {
                                    <span class="text-muted small">(@item.Colour - @item.Size)</span>
                                }
                            </td>
                            <td class="text-center">@item.HsnCode</td>
                            <td class="text-center fw-semibold">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@item.TaxableValue.ToString("N2")</td>
                            @if (Model.IsInterState)
                            {
                                <td class="text-end">@lineTax.ToString("N2")</td>
                            }
                            else
                            {
                                <td class="text-end">@(Math.Round(lineTax / 2m, 2).ToString("N2"))</td>
                                <td class="text-end">@(Math.Round(lineTax / 2m, 2).ToString("N2"))</td>
                            }
                            <td class="text-end fw-bold">@item.TotalAmount.ToString("N2")</td>
                        </tr>
                        sl++;
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Total:</td>
                        <td class="text-center fw-bold">@Model.Items.Sum(i => i.Quantity)</td>
                        <td></td>
                        <td class="text-end fw-bold">₹@Model.TaxableAmount.ToString("N2")</td>
                        @if (Model.IsInterState)
                        {
                            <td class="text-end fw-bold">₹@Model.IgstAmount.ToString("N2")</td>
                        }
                        else
                        {
                            <td class="text-end fw-bold">₹@Model.CgstAmount.ToString("N2")</td>
                            <td class="text-end fw-bold">₹@Model.SgstAmount.ToString("N2")</td>
                        }
                        <td class="text-end fw-bold fs-6">₹@Model.GrandTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <!-- Amount in words -->
            <div class="py-1 px-2 border bg-light mb-1">
                <span class="small text-muted text-uppercase fw-semibold" style="font-size: 7.5pt;">Amount Chargeable (in words):</span>
                <div class="fw-bold" style="font-size: 8.5pt;">@NumberToWords(Model.GrandTotal)</div>
            </div>

            <!-- Tax Summary Box -->
            <div class="row g-0 border mb-1">
                <div class="col-7 p-2 border-end small">
                    <strong class="d-block mb-1 text-uppercase text-muted" style="font-size: 7.5pt;">Bank Details for RTGS / NEFT / IMPS:</strong>
                    <div><strong>Bank:</strong> @Model.BankName</div>
                    <div><strong>Account No:</strong> @Model.BankAccountNumber</div>
                    <div><strong>IFSC Code:</strong> @Model.BankIfsc</div>
                    <div><strong>Branch:</strong> @Model.BankBranch</div>
                </div>
                <div class="col-5 p-2 small">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td class="text-muted py-0">Taxable Value:</td>
                            <td class="text-end fw-semibold py-0">₹@Model.TaxableAmount.ToString("N2")</td>
                        </tr>
                        @if (Model.IsInterState)
                        {
                            <tr>
                                <td class="text-muted py-0">Integrated Tax (IGST):</td>
                                <td class="text-end fw-semibold py-0">₹@Model.IgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td class="text-muted py-0">Central Tax (CGST):</td>
                                <td class="text-end fw-semibold py-0">₹@Model.CgstAmount.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-0">State Tax (SGST):</td>
                                <td class="text-end fw-semibold py-0">₹@Model.SgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        @if (Model.RoundOff != 0)
                        {
                            <tr>
                                <td class="text-muted py-0">Round Off:</td>
                                <td class="text-end py-0">₹@Model.RoundOff.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="border-top">
                            <td class="fw-bold py-1">Invoice Total:</td>
                            <td class="text-end fw-bold py-1 text-dark" style="font-size: 10pt;">₹@Model.GrandTotal.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Footer / Signatures -->
        <div class="invoice-footer border-top pt-2 mt-1">
            <div class="row align-items-end">
                <div class="col-7 small">
                    <strong>Declaration:</strong>
                    <p class="mb-0 text-muted" style="font-size: 7.5pt;">
                        We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.
                    </p>
                    <div class="mt-1 text-muted" style="font-size: 7.5pt;">
                        @Model.TermsAndConditions
                    </div>
                </div>
                <div class="col-5 text-end">
                    <div class="small fw-bold text-uppercase mb-2">For @compName.ToUpper()</div>
                    <div class="border-top d-inline-block pt-1 px-3 text-muted small" style="min-width: 160px;">
                        Authorized Signatory
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
