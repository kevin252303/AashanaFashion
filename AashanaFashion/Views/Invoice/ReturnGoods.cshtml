@model AashanaFashion.Models.SalesReturnCreateViewModel
@{
    ViewData["Title"] = $"Sales Return for Invoice {Model.InvoiceNumber}";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.TaxInvoiceId" class="page-back"><i class="bi bi-arrow-left"></i> Invoice @Model.InvoiceNumber</a>
        <h1 class="page-title">Record goods return</h1>
        <p class="page-sub">Issue a credit note against invoice <span class="font-monospace">@Model.InvoiceNumber</span> · @Model.CustomerName</p>
    </div>
</div>

<form asp-action="ReturnGoods" method="post" id="returnForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TaxInvoiceId" />
    <input type="hidden" asp-for="InvoiceNumber" />
    <input type="hidden" asp-for="InvoiceDate" />
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="CustomerName" />

    <div asp-validation-summary="All" class="af-alert af-alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="data-card">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Items to return</div>
                        <div class="data-card-sub">Enter the quantity coming back for each invoiced line.</div>
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="af-table table-edit" id="returnItemsTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Colour</th>
                                <th>Size</th>
                                <th class="text-end">Invoiced</th>
                                <th class="text-end">Remaining</th>
                                <th class="text-center" style="width: 120px;">Return qty</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-end">Taxable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                var remaining = item.OriginalQuantity - item.AlreadyReturnedQuantity;
                                <tr>
                                    <td>
                                        <input type="hidden" name="Items[@i].TaxInvoiceItemId" value="@item.TaxInvoiceItemId" />
                                        <input type="hidden" name="Items[@i].DesignId" value="@item.DesignId" />
                                        <input type="hidden" name="Items[@i].Description" value="@item.Description" />
                                        <input type="hidden" name="Items[@i].Colour" value="@item.Colour" />
                                        <input type="hidden" name="Items[@i].Size" value="@item.Size" />
                                        <input type="hidden" name="Items[@i].OriginalQuantity" value="@item.OriginalQuantity" />
                                        <input type="hidden" name="Items[@i].AlreadyReturnedQuantity" value="@item.AlreadyReturnedQuantity" />
                                        <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" class="item-unit-price" />
                                        <input type="hidden" name="Items[@i].GstRate" value="@item.GstRate" class="item-gst-rate" />
                                        <span class="cell-title">@item.Description</span>
                                    </td>
                                    <td>@(item.Colour ?? "—")</td>
                                    <td>@(item.Size ?? "—")</td>
                                    <td class="cell-num">@item.OriginalQuantity</td>
                                    <td class="cell-num text-muted">@remaining</td>
                                    <td>
                                        <input type="number" name="Items[@i].ReturnQuantity" value="0" min="0" max="@remaining"
                                               class="af-input af-input-sm text-center return-qty-input" aria-label="Return quantity for @item.Description" @(remaining <= 0 ? "disabled" : "") />
                                    </td>
                                    <td class="cell-num">₹@item.UnitPrice.ToString("N2")</td>
                                    <td class="cell-num text-foreground fw-semibold item-taxable-display">₹0.00</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-side">
                <div class="data-card mb-4">
                    <div class="data-card-header">
                        <div class="data-card-title">Return details</div>
                    </div>
                    <div class="data-card-body">
                        <div class="mb-3">
                            <label asp-for="ReturnDate" class="form-label">Return date <span class="req">*</span></label>
                            <input asp-for="ReturnDate" type="date" class="af-input" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">Reason</label>
                            <select asp-for="Reason" class="af-input af-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.ReturnReason>()"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="af-input" rows="3" placeholder="Condition of returned garments, defect notes…"></textarea>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="RestockInventory" class="form-check-input" type="checkbox" role="switch" id="restockCheck" checked />
                            <label class="form-check-label" for="restockCheck">Restock to ready inventory</label>
                            <div class="form-text">Adds returned quantities back into ready product stock.</div>
                        </div>
                    </div>
                </div>

                <div class="data-card">
                    <div class="data-card-header">
                        <div class="data-card-title">Credit summary</div>
                    </div>
                    <div class="data-card-body">
                        <div class="kv-row"><span class="k">Returned quantity</span><span class="v" id="summaryTotalQty">0 pcs</span></div>
                        <div class="kv-row"><span class="k">Return taxable value</span><span class="v" id="summaryTaxable">₹0.00</span></div>
                        <div class="kv-row"><span class="k">Est. GST reversal</span><span class="v" id="summaryGst">₹0.00</span></div>
                        <div class="bill-total mb-3"><span class="k">Credit amount</span><span class="v text-danger" id="summaryGrandTotal">₹0.00</span></div>

                        <div class="af-alert af-alert-warning">
                            <div class="alert-body">
                                <span class="alert-title">Commission clawback</span>
                                Salesman commission on these items is deducted automatically in the commission ledger and general ledger.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger" id="btnSubmitReturn"><i class="bi bi-arrow-return-left"></i> Confirm return</button>
                            <a asp-action="Details" asp-route-id="@Model.TaxInvoiceId" class="btn btn-secondary">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function recalculateReturnSummary() {
            var totalQty = 0;
            var totalTaxable = 0;
            var totalGst = 0;

            $('#returnItemsTable tbody tr').each(function () {
                var $row = $(this);
                var qty = parseInt($row.find('.return-qty-input').val()) || 0;
                var unitPrice = parseFloat($row.find('.item-unit-price').val()) || 0;
                var gstRate = parseFloat($row.find('.item-gst-rate').val()) || 0;

                var taxable = Math.round(qty * unitPrice * 100) / 100;
                var gst = Math.round(taxable * (gstRate / 100) * 100) / 100;

                $row.find('.item-taxable-display').text('₹' + taxable.toLocaleString('en-IN', { minimumFractionDigits: 2 }));

                totalQty += qty;
                totalTaxable += taxable;
                totalGst += gst;
            });

            var grandTotal = totalTaxable + totalGst;

            $('#summaryTotalQty').text(totalQty + ' pcs');
            $('#summaryTaxable').text('₹' + totalTaxable.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            $('#summaryGst').text('₹' + totalGst.toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            $('#summaryGrandTotal').text('₹' + grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }));

            $('#btnSubmitReturn').prop('disabled', totalQty <= 0);
        }

        $(document).ready(function () {
            $('.return-qty-input').on('input change', recalculateReturnSummary);
            recalculateReturnSummary();
        });
    </script>
}
