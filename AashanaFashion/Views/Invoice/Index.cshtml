@model IEnumerable<AashanaFashion.Models.TaxInvoice>
@{
    ViewData["Title"] = "GST Tax Invoices";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool canCreate = role == "Admin" || role == "SuperAdmin" || role == "Manager";
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.Status != null || !string.IsNullOrEmpty(ViewBag.EInvoiceStatus as string);
}

<div class="page-header">
    <div>
        <h1 class="page-title">GST Tax Invoices</h1>
        <p class="page-sub">Customer billing, GST compliance (CGST / SGST / IGST) and payment receipts.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Accounting" asp-action="Index" class="btn btn-secondary"><i class="bi bi-journal-text"></i> General ledger</a>
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New invoice</a>
        }
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total invoiced</div>
        <div class="metric-value">₹@(((decimal)ViewBag.TotalInvoiced).ToString("N2"))</div>
        <div class="metric-meta">billing to date</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total collected</div>
        <div class="metric-value">₹@(((decimal)ViewBag.TotalCollected).ToString("N2"))</div>
        <div class="metric-meta success">cleared payments</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Receivables pending</div>
        <div class="metric-value">₹@(((decimal)ViewBag.OutstandingReceivables).ToString("N2"))</div>
        <div class="metric-meta warning">pending balance</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Overdue</div>
        <div class="metric-value">@ViewBag.OverdueCount</div>
        <div class="metric-meta danger">past due date</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">e-Invoices</div>
        <div class="metric-value">@ViewBag.EInvoiceGeneratedCount</div>
        <div class="metric-meta">IRN generated</div>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Invoice #, customer, GSTIN, IRN…" value="@ViewBag.Search" />
            </div>
            <select name="status" class="af-input af-select" onchange="this.form.submit()" aria-label="Payment status">
                <option value="">All payment statuses</option>
                @foreach (AashanaFashion.Models.InvoicePaymentStatus s in Enum.GetValues(typeof(AashanaFashion.Models.InvoicePaymentStatus)))
                {
                    <option value="@s" selected="@((AashanaFashion.Models.InvoicePaymentStatus?)ViewBag.Status == s)">@s.Humanize()</option>
                }
            </select>
            <select name="eInvoiceStatus" class="af-input af-select" onchange="this.form.submit()" aria-label="e-Invoice status">
                <option value="">All e-Invoice statuses</option>
                <option value="Generated" selected="@(ViewBag.EInvoiceStatus == "Generated")">IRN active</option>
                <option value="Pending" selected="@(ViewBag.EInvoiceStatus == "Pending")">IRN pending</option>
                <option value="Cancelled" selected="@(ViewBag.EInvoiceStatus == "Cancelled")">IRN cancelled</option>
            </select>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Date</th>
                        <th>Due</th>
                        <th>Customer</th>
                        <th>Supply</th>
                        <th class="text-end">Taxable</th>
                        <th class="text-end">GST</th>
                        <th class="text-end">Grand total</th>
                        <th class="text-end">Balance</th>
                        <th>Payment</th>
                        <th>e-Invoice</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        bool isOverdue = inv.DueDate < DateTime.Today && inv.PaymentStatus != AashanaFashion.Models.InvoicePaymentStatus.Paid;
                        <tr class="@(isOverdue ? "row-danger" : "")">
                            <td>
                                <a asp-action="Details" asp-route-id="@inv.Id" class="cell-title">@inv.InvoiceNumber</a>
                                @if (inv.SalesOrderId.HasValue)
                                {
                                    <span class="cell-sub">SO @inv.SalesOrder?.SoNumber</span>
                                }
                            </td>
                            <td class="text-nowrap tabular">@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-nowrap tabular">
                                <span class="@(isOverdue ? "text-danger fw-semibold" : "")">@inv.DueDate.ToString("dd/MM/yyyy")</span>
                                @if (isOverdue)
                                {
                                    <span class="cell-sub text-danger">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="text-foreground fw-medium">@inv.CustomerName</span>
                                @if (!string.IsNullOrEmpty(inv.CustomerGstin))
                                {
                                    <span class="cell-sub font-monospace">@inv.CustomerGstin</span>
                                }
                            </td>
                            <td><span class="af-badge b-gray">@inv.PlaceOfSupply</span></td>
                            <td class="cell-num">₹@inv.TaxableAmount.ToString("N2")</td>
                            <td class="cell-num">
                                ₹@((inv.CgstAmount + inv.SgstAmount + inv.IgstAmount).ToString("N2"))
                                <span class="cell-sub">@(inv.IsInterState ? "IGST" : "CGST + SGST")</span>
                            </td>
                            <td class="cell-num"><span class="text-foreground fw-semibold">₹@inv.GrandTotal.ToString("N2")</span></td>
                            <td class="cell-num">
                                <span class="@(inv.BalanceDue > 0 ? "text-warning fw-semibold" : "text-muted")">₹@inv.BalanceDue.ToString("N2")</span>
                            </td>
                            <td>
                                @switch (inv.PaymentStatus)
                                {
                                    case AashanaFashion.Models.InvoicePaymentStatus.Paid:
                                        <span class="af-badge b-green">Paid</span>
                                        break;
                                    case AashanaFashion.Models.InvoicePaymentStatus.PartiallyPaid:
                                        <span class="af-badge b-yellow">Partial</span>
                                        break;
                                    case AashanaFashion.Models.InvoicePaymentStatus.Unpaid:
                                        <span class="af-badge b-red">Unpaid</span>
                                        break;
                                    default:
                                        <span class="af-badge b-gray">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (inv.EInvoiceStatus == "Generated")
                                {
                                    <span class="af-badge b-green" title="IRN: @inv.Irn">IRN active</span>
                                    @if (!string.IsNullOrEmpty(inv.EInvoiceAckNo))
                                    {
                                        <span class="cell-sub font-monospace text-2xs">Ack @inv.EInvoiceAckNo</span>
                                    }
                                }
                                else if (inv.EInvoiceStatus == "Cancelled")
                                {
                                    <span class="af-badge b-red" title="Cancelled on @inv.EInvoiceCancelDate?.ToString("dd/MM/yyyy")">Cancelled</span>
                                }
                                else
                                {
                                    <span class="af-badge b-gray">Pending</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@inv.Id" class="row-action" title="View details" aria-label="View"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Print" asp-route-id="@inv.Id" target="_blank" class="row-action" title="Print GST invoice" aria-label="Print"><i class="bi bi-printer"></i></a>
                                    @if (inv.EInvoiceStatus == "Generated")
                                    {
                                        <a asp-action="DownloadEInvoiceJson" asp-route-id="@inv.Id" class="row-action primary" title="Download INV-01 JSON" aria-label="Download e-Invoice JSON"><i class="bi bi-filetype-json"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "invoice" : "invoices")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-receipt")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No tax invoices yet")</div>
            <p>@(filtered ? "No invoices match your filters." : "Create a tax invoice or generate one from a sales order.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">New invoice</a>
            }
        </div>
    }
</div>
