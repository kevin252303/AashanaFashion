@model AashanaFashion.Models.BankPaymentBatch
@{
    ViewData["Title"] = $"Batch #{Model.BatchNumber} - Bank Bulk Payment";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Accounting" asp-action="Index">Accounting</a></li>
                <li class="breadcrumb-item"><a asp-controller="BankPayment" asp-action="Index">Bank bulk payments</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.BatchNumber</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h1 class="page-title mb-0">Batch #@Model.BatchNumber</h1>
            @if (Model.Status == BankPaymentBatchStatus.Processed)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check-circle"></i> Processed
                </span>
            }
            else if (Model.Status == BankPaymentBatchStatus.Exported)
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle">
                    <i class="bi bi-file-earmark-check"></i> Exported
                </span>
            }
            else if (Model.Status == BankPaymentBatchStatus.Cancelled)
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border">@Model.Status</span>
            }
        </div>
        <p class="text-muted text-sm mb-0">Generated on @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") by @(Model.ExportedBy ?? "System")</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to hub
        </a>

        <!-- Download Dropdown for Multiple Bank Formats -->
        <div class="dropdown">
            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-download"></i> Download file
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><h6 class="dropdown-header text-2xs">TARGET BANK FORMATS</h6></li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.HdfcENet ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="HdfcENet">
                        <i class="bi bi-filetype-csv me-1 text-primary"></i> HDFC Bank ENet CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.IciciCib ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="IciciCib">
                        <i class="bi bi-filetype-csv me-1 text-primary"></i> ICICI Bank CIB CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.SbiCmp ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="SbiCmp">
                        <i class="bi bi-filetype-csv me-1 text-primary"></i> SBI CMP / Saral CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.AxisCms ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="AxisCms">
                        <i class="bi bi-filetype-csv me-1 text-primary"></i> Axis Bank CMS CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.KotakCms ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="KotakCms">
                        <i class="bi bi-filetype-csv me-1 text-primary"></i> Kotak Mahindra CMS CSV
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-sm @(Model.BankFormat == BankFormat.StandardNeftRtgs ? "fw-bold" : "")"
                       asp-action="DownloadFile" asp-route-id="@Model.Id" asp-route-format="StandardNeftRtgs">
                        <i class="bi bi-filetype-csv me-1 text-secondary"></i> Universal RBI NEFT/RTGS CSV
                    </a>
                </li>
            </ul>
        </div>

        @if (Model.Status != BankPaymentBatchStatus.Processed && Model.Status != BankPaymentBatchStatus.Cancelled)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#reconcileBatchModal">
                <i class="bi bi-check-circle"></i> Mark as processed / enter UTR
            </button>

            <form asp-action="CancelBatch" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this payment batch?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-sm text-danger" title="Cancel this batch">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </form>
        }
    </div>
</div>

<!-- Batch Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Total batch payout</div>
            <div class="stat-value tabular text-primary">₹@Model.TotalAmount.ToString("N2")</div>
            <div class="text-xs text-muted mt-1">@Model.TotalBeneficiaries beneficiaries included</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Debit bank account</div>
            <div class="stat-value font-monospace fs-5">@Model.DebitAccountNumber</div>
            <div class="text-xs text-muted mt-1">@(Model.DebitBankName ?? "Bank") &bull; IFSC: @Model.DebitIfsc</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Bank format &amp; value date</div>
            <div class="stat-value fs-5">@Model.BankFormat</div>
            <div class="text-xs text-muted mt-1">Processing date: @Model.PaymentDate.ToString("dd/MM/yyyy")</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Bank UTR / Confirmation</div>
            <div class="stat-value font-monospace fs-5">
                @(string.IsNullOrEmpty(Model.BankReferenceUtr) ? "Pending Upload" : Model.BankReferenceUtr)
            </div>
            <div class="text-xs text-muted mt-1">
                @if (Model.ProcessedAt.HasValue)
                {
                    <span>Settled on @Model.ProcessedAt.Value.ToString("dd/MM/yyyy")</span>
                }
                else
                {
                    <span class="text-warning">Awaiting bank authorization</span>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="alert alert-secondary py-2 px-3 text-sm mb-4">
        <strong>Batch memo:</strong> @Model.Notes
    </div>
}

<!-- Beneficiaries Table -->
<div class="table-card">
    <div class="table-toolbar d-flex justify-content-between align-items-center">
        <div class="text-sm fw-semibold">
            <span>Beneficiary payout list (@Model.Items.Count items)</span>
        </div>
        <div class="text-xs text-muted">
            All records formatted per @Model.BankFormat upload specification
        </div>
    </div>
    <div class="table-responsive">
        <table class="af-table table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 40px;">#</th>
                    <th>Beneficiary</th>
                    <th>Type</th>
                    <th>Account No</th>
                    <th>IFSC Code</th>
                    <th class="text-center">Mode</th>
                    <th class="text-end">Amount</th>
                    <th>Source Reference</th>
                    <th>Item Status</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-muted text-xs">@(idx++)</td>
                        <td>
                            <div class="fw-semibold">@item.BeneficiaryName</div>
                            @if (!string.IsNullOrEmpty(item.Narration))
                            {
                                <div class="text-xs text-muted">@item.Narration</div>
                            }
                        </td>
                        <td>
                            @if (item.BeneficiaryType == BeneficiaryType.Vendor)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Supplier</span>
                            }
                            else if (item.BeneficiaryType == BeneficiaryType.Karigar)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">Karigar</span>
                            }
                            else if (item.BeneficiaryType == BeneficiaryType.Employee)
                            {
                                <span class="badge bg-purple-subtle text-purple border">Staff</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">Other</span>
                            }
                        </td>
                        <td>
                            <span class="font-monospace">@item.AccountNumber</span>
                            @if (!string.IsNullOrEmpty(item.BankName))
                            {
                                <div class="text-xs text-muted">
                                    @item.BankName
                                    @if (!string.IsNullOrEmpty(item.BankBranch))
                                    {
                                        <span> &bull; @item.BankBranch</span>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(item.BankBranch))
                            {
                                <div class="text-xs text-muted">@item.BankBranch</div>
                            }
                        </td>
                        <td>
                            <span class="font-monospace">@item.IfscCode</span>
                            @if (!string.IsNullOrEmpty(item.ValidationErrors))
                            {
                                <div class="text-danger text-xs"><i class="bi bi-exclamation-triangle"></i> @item.ValidationErrors</div>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-secondary border font-monospace">@item.TransactionType</span>
                        </td>
                        <td class="text-end tabular fw-semibold">₹@item.Amount.ToString("N2")</td>
                        <td>
                            <span class="mono-id">@item.ReferenceNumber</span>
                            <div class="text-xs text-muted">@item.SourceType</div>
                        </td>
                        <td>
                            @if (item.Status == "Processed")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-check-circle"></i> Paid
                                </span>
                            }
                            else if (item.Status == "Exported")
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">Exported</span>
                            }
                            else if (item.Status == "Cancelled")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@item.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-footer d-flex justify-content-between text-xs text-muted">
        <span>Showing <strong>@Model.Items.Count</strong> beneficiaries</span>
        <span>Total: <strong>₹@Model.TotalAmount.ToString("N2")</strong></span>
    </div>
</div>

<!-- MODAL: Reconcile / Mark Processed -->
<div class="modal fade" id="reconcileBatchModal" tabindex="-1" aria-labelledby="reconcileBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="MarkProcessed" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BatchId" value="@Model.Id" />
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="reconcileBatchModalLabel">Reconcile &amp; mark batch as processed</h5>
                        <div class="text-xs text-muted">Enter the bank UTR or transaction confirmation reference</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="d-flex justify-content-between">
                            <div>
                                <div class="text-xs text-muted">BATCH NUMBER</div>
                                <div class="fw-bold font-monospace">@Model.BatchNumber</div>
                            </div>
                            <div class="text-end">
                                <div class="text-xs text-muted">TOTAL AMOUNT</div>
                                <div class="fw-bold text-primary tabular">₹@Model.TotalAmount.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="BankReferenceUtr" class="form-label text-sm fw-semibold">Bank UTR / Transaction reference <span class="text-danger">*</span></label>
                        <input type="text" name="BankReferenceUtr" id="BankReferenceUtr" class="form-control form-control-sm font-monospace"
                               placeholder="e.g. HDFC202610050012345 or CMS-UTR-998822" required />
                        <div class="text-xs text-muted mt-1">Unique transaction reference number provided by your corporate net banking.</div>
                    </div>

                    <div class="mb-3">
                        <label for="ProcessedDate" class="form-label text-sm fw-semibold">Processed date <span class="text-danger">*</span></label>
                        <input type="date" name="ProcessedDate" id="ProcessedDate" class="form-control form-control-sm"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="Notes" class="form-label text-sm fw-semibold">Reconciliation notes</label>
                        <input type="text" name="Notes" id="Notes" class="form-control form-control-sm" placeholder="e.g. Approved by CFO token" />
                    </div>

                    <div class="alert alert-info py-2 px-3 text-xs mb-0">
                        <i class="bi bi-info-circle me-1"></i> Marking this batch as processed will automatically:
                        <ul class="mb-0 mt-1 ps-3">
                            <li>Create <code>VendorPayment</code> vouchers for all vendor bills.</li>
                            <li>Mark employee <code>SalaryRecord</code>s as Paid.</li>
                            <li>Post general ledger expense transactions in Accounting.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-check-circle"></i> Confirm &amp; reconcile batch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
