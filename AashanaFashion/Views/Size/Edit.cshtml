@model AashanaFashion.Models.Size
@{
    ViewData["Title"] = "Edit Size";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Sizes</a>
        <h1 class="page-title">Edit Size</h1>
        <p class="page-sub">Modify size configurations</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="data-card-header">
                <span class="data-card-title">Size details</span>
            </div>
            <div class="data-card-body">
                <div class="af-form-group">
                    <label asp-for="SizeName" class="af-label">Size Name <span class="req">*</span></label>
                    <input asp-for="SizeName" class="af-input" placeholder="e.g. S, XL, 38, 40" required />
                    <span asp-validation-for="SizeName" class="af-error"></span>
                </div>

                <div class="af-form-group">
                    <label asp-for="DisplayOrder" class="af-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="af-input" placeholder="e.g. 1 for S, 2 for M, 3 for L" />
                    <span class="af-hint">Determines logical sorting in tables and matrices.</span>
                    <span asp-validation-for="DisplayOrder" class="af-error"></span>
                </div>

                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
