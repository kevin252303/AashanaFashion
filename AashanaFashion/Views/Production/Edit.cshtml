@model AashanaFashion.Models.ProductionOrder
@{
    ViewData["Title"] = "Edit Order";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    var designs    = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new List<AashanaFashion.Models.Design>();
    var vendors    = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new List<AashanaFashion.Models.Vendor>();
    var currentDesign  = designs.FirstOrDefault(d => d.Id == Model.DesignId) ?? Model.Design;
    var creationSteps  = currentDesign?.GetCreationSteps() ?? new List<string> { "Cutting", "Dying", "Stitching" };
    var completedSteps = Model.GetCompletedProcessesList();

    // Determine current active step index in configured creation steps
    int currentStepIndex = -1;
    for (int i = 0; i < creationSteps.Count; i++)
    {
        if (!completedSteps.Contains(creationSteps[i]))
        {
            currentStepIndex = i;
            break;
        }
    }

    bool allProcessesDone = (currentStepIndex == -1 && creationSteps.Any()) || Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch || Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
    string currentProcessName = allProcessesDone
        ? (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "Dispatched" : "Ready to Dispatch")
        : (currentStepIndex >= 0 ? creationSteps[currentStepIndex] : "Ready to Dispatch");
    string? nextProcessName = (currentStepIndex >= 0 && currentStepIndex + 1 < creationSteps.Count)
        ? creationSteps[currentStepIndex + 1]
        : (currentStepIndex >= 0 ? "Ready to Dispatch" : null);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Order — @Model.LotNo</h1>
        <p class="page-sub">Design: @Model.Design?.DesignNumber</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.JobSlips != null && Model.JobSlips.Any())
        {
            <a asp-controller="JobSlip" asp-action="PrintAll" asp-route-lotId="@Model.Id" target="_blank" class="btn btn-sm btn-primary">📑 Print All Slips (@Model.JobSlips.Count)</a>
        }
        <a asp-controller="Barcode" asp-action="PrintTags" asp-route-orderId="@Model.Id" target="_blank" class="btn btn-sm btn-outline-dark">🏷️ Barcode Tags</a>
        <a asp-controller="Barcode" asp-action="PrintLotTag" asp-route-orderId="@Model.Id" target="_blank" class="btn btn-sm btn-outline-dark">Lot Tag</a>
        <a asp-controller="QualityControl" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm btn-outline-warning">🔍 Log QC Check</a>
        <a asp-controller="QualityControl" asp-action="Index" asp-route-orderId="@Model.Id" class="btn btn-sm btn-outline-secondary">QC Logs</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><span class="alert-body">@TempData["Success"]</span><button class="alert-close">&times;</button></div>
}
@if (TempData["Error"] != null)
{
    <div class="af-alert af-alert-danger mb-3"><span class="alert-body">@TempData["Error"]</span><button class="alert-close">&times;</button></div>
}

<form asp-action="Edit" method="post" id="orderForm">
@Html.AntiForgeryToken()
<input type="hidden" name="id" value="@Model.Id" />
<input type="hidden" name="CreatedDate" value="@Model.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")" />
<input type="hidden" name="Status" id="orderStatusInput" value="@Model.Status" />
<input type="hidden" name="CurrentProcess" id="currentProcessInput" value="@Model.CurrentProcess" />
<input type="hidden" name="CompletedProcesses" id="completedProcessesInput" value="@Model.CompletedProcesses" />

<!-- Workflow Stage Progression Pipeline Card (matching Product Master) -->
<div class="card p-3 mb-4 border rounded-3 bg-light shadow-sm" id="lotWorkflowCard">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div>
            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <span>🔄</span> Production Stage Progression
            </h6>
            <small class="text-muted">
                Configured processes for Design <strong>@(currentDesign?.DesignNumber ?? Model.Design?.DesignNumber)</strong>. Sequence is strictly enforced order-wise.
            </small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(allProcessesDone ? "bg-success" : "bg-primary") px-3 py-2" id="lotStepCountBadge">
                @(completedSteps.Count) of @(creationSteps.Count) Configured Processes Completed
            </span>
        </div>
    </div>

    <!-- Live Flow Pipeline Flowchart -->
    <div class="p-3 bg-white border rounded-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small fw-bold text-muted text-uppercase" style="letter-spacing:0.5px;">Workflow Stages:</span>
            <small class="text-muted" style="font-size:0.75rem;">
                <span class="badge bg-success me-1">✓ Completed</span>
                <span class="badge bg-primary me-1">⚡ In Progress</span>
                <span class="badge bg-light text-secondary border">🔒 Locked</span>
            </small>
        </div>
        <div id="lotStagesPipeline" class="d-flex flex-wrap align-items-center gap-2 p-3 bg-light rounded border" style="min-height:56px;">
            @for (int i = 0; i < creationSteps.Count; i++)
            {
                var step = creationSteps[i];
                var isCompleted = completedSteps.Contains(step);
                var isCurrent = !isCompleted && i == currentStepIndex && !allProcessesDone;
                var isPending = !isCompleted && !isCurrent;

                <div class="d-flex align-items-center gap-2 stage-node" data-step-index="@i" data-step-name="@step">
                    @if (isCompleted)
                    {
                        <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#10b981; color:#fff; border: 1px solid #059669;">
                            <span class="badge bg-white text-success rounded-circle" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:bold;">✓</span>
                            <span class="fw-semibold">@step</span>
                            <span class="badge bg-white text-success font-monospace" style="font-size:0.65rem;">Done</span>
                        </span>
                        <span class="text-success fw-bold fs-5">➔</span>
                    }
                    else if (isCurrent)
                    {
                        <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#2563eb; color:#fff; border: 2px solid #1d4ed8; box-shadow: 0 0 0 3px rgba(37,99,235,0.25);">
                            <span class="badge bg-white text-primary rounded-circle font-monospace" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:bold;">@(i + 1)</span>
                            <span class="fw-bold">@step</span>
                            <span class="badge bg-warning text-dark fw-bold font-monospace" style="font-size:0.65rem;">In Progress</span>
                        </span>
                        <span class="text-primary fw-bold fs-5">➔</span>
                    }
                    else
                    {
                        <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#f8fafc; color:#94a3b8; border: 1px solid #cbd5e1; opacity:0.85;" title="Must complete previous step '@(i > 0 ? creationSteps[i - 1] : "")' first">
                            <span class="badge bg-light text-secondary rounded-circle border" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.7rem;">🔒</span>
                            <span class="text-secondary">@step</span>
                            <span class="badge bg-light text-muted border font-monospace" style="font-size:0.65rem;">Locked</span>
                        </span>
                        @if (i < creationSteps.Count - 1 || true)
                        {
                            <span class="text-muted fw-bold fs-5" style="opacity:0.35;">➔</span>
                        }
                    }
                </div>
            }

            <!-- Destination Node 1: Ready to Dispatch -->
            @{
                bool isReady = Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch;
                bool isPastReady = Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
            }
            <div class="d-flex align-items-center gap-2 stage-node-destination">
                @if (isReady)
                {
                    <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#059669; color:#fff; border: 2px solid #047857; box-shadow: 0 0 0 3px rgba(5,150,105,0.25);">
                        <span class="badge bg-white text-success rounded-circle" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:bold;">📦</span>
                        <span class="fw-bold">Ready to Dispatch</span>
                        <span class="badge bg-white text-success fw-bold font-monospace" style="font-size:0.65rem;">Active</span>
                    </span>
                    <span class="text-success fw-bold fs-5">➔</span>
                }
                else if (isPastReady)
                {
                    <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#10b981; color:#fff; border: 1px solid #059669;">
                        <span class="badge bg-white text-success rounded-circle" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:bold;">✓</span>
                        <span class="fw-semibold">Ready to Dispatch</span>
                        <span class="badge bg-white text-success font-monospace" style="font-size:0.65rem;">Done</span>
                    </span>
                    <span class="text-success fw-bold fs-5">➔</span>
                }
                else
                {
                    <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#f8fafc; color:#94a3b8; border: 1px solid #cbd5e1; opacity:0.85;" title="Will unlock once all configured processes are completed">
                        <span class="badge bg-light text-secondary rounded-circle border" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.7rem;">🔒</span>
                        <span class="text-secondary">Ready to Dispatch</span>
                        <span class="badge bg-light text-muted border font-monospace" style="font-size:0.65rem;">Locked</span>
                    </span>
                    <span class="text-muted fw-bold fs-5" style="opacity:0.35;">➔</span>
                }
            </div>

            <!-- Destination Node 2: Dispatched -->
            @{
                bool isDispatched = Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
            }
            <div class="d-flex align-items-center gap-2 stage-node-destination">
                @if (isDispatched)
                {
                    <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#334155; color:#fff; border: 1px solid #1e293b;">
                        <span class="badge bg-white text-dark rounded-circle" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:bold;">🚚</span>
                        <span class="fw-bold">Dispatched</span>
                        <span class="badge bg-white text-dark font-monospace" style="font-size:0.65rem;">Completed</span>
                    </span>
                }
                else
                {
                    <span class="badge px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2" style="background:#f8fafc; color:#94a3b8; border: 1px solid #cbd5e1; opacity:0.85;" title="Final status after dispatching">
                        <span class="badge bg-light text-secondary rounded-circle border" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.7rem;">🔒</span>
                        <span class="text-secondary">Dispatched</span>
                        <span class="badge bg-light text-muted border font-monospace" style="font-size:0.65rem;">Pending</span>
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Active Stage Progression Controls & Toolbar -->
    <div class="p-3 bg-white border rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small fw-bold text-muted text-uppercase" style="letter-spacing:0.5px;">Current Active Stage:</span>
            <span class="badge @(Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "bg-secondary" : (Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "bg-success" : "bg-primary")) fs-6 px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2">
                <span>@(allProcessesDone ? (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "🚚 Dispatched" : "📦 Ready to Dispatch") : $"⚡ {currentProcessName}")</span>
            </span>
            @if (!allProcessesDone && !string.IsNullOrEmpty(nextProcessName))
            {
                <span class="text-muted small ms-1">Next in pipeline: <strong>@nextProcessName</strong></span>
            }
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (!allProcessesDone)
            {
                <button type="submit" formaction="@Url.Action("AdvanceStage", "Production", new { id = Model.Id })" class="btn btn-primary btn-sm px-3 py-2 fw-bold shadow-sm d-flex align-items-center gap-2" title="Mark '@currentProcessName' complete and unlock '@nextProcessName'">
                    <span>✓</span> Mark <strong>@currentProcessName</strong> Completed & Advance ➔
                </button>
            }
            else if (Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch)
            {
                <button type="submit" formaction="@Url.Action("AdvanceStage", "Production", new { id = Model.Id })" class="btn btn-dark btn-sm px-3 py-2 fw-bold shadow-sm d-flex align-items-center gap-2" title="Mark this lot as Dispatched">
                    <span>🚚</span> Mark Lot Dispatched ➔
                </button>
            }

            @if (completedSteps.Any() || Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch || Model.Status == AashanaFashion.Models.OrderStatus.Dispatched)
            {
                <button type="submit" formaction="@Url.Action("RevertStage", "Production", new { id = Model.Id })" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" title="Step back to previous stage if needed" onclick="return confirm('Step back to previous stage?');">
                    <span>↩</span> Revert Previous Step
                </button>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="data-card mb-3">
            <div class="data-card-header">
                <div class="data-card-title">Order Details</div>
            </div>
            <div style="padding:1.5rem;">

                    @if (isAdmin)
                    {
                        <div class="af-form-group">
                            <label class="af-label">Design</label>
                            <select name="DesignId" class="af-input af-select" id="designSelect">
                                @Html.Raw(string.Join("", designs.Select(d => 
                                    $"<option value=\"{d.Id}\" data-colours=\"{d.Colours}\" data-sizes=\"{d.Sizes}\" data-steps=\"{d.CreationFlow}\" data-hw-worker=\"{d.HandworkWorkerId}\" data-st-worker=\"{d.StitchingWorkerId}\" data-hw-choli=\"{d.HandworkCholi.ToString().ToLower()}\" data-hw-chaniya=\"{d.HandworkChaniya.ToString().ToLower()}\" data-hw-dupatta=\"{d.HandworkDupatta.ToString().ToLower()}\" {(d.Id == Model.DesignId ? "selected" : "")}>{d.DesignNumber}</option>")))
                            </select>
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Lot No</label>
                            <input type="text" name="LotNo" class="af-input" value="@Model.LotNo" />
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="DesignId" value="@Model.DesignId" />
                        <div class="af-form-group">
                            <label class="af-label">Design</label>
                            <input type="text" class="af-input" value="@Model.Design?.DesignNumber" disabled style="background:#f8fafc;" />
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Lot No</label>
                            <input type="text" class="af-input" value="@Model.LotNo" disabled style="background:#f8fafc;" />
                        </div>
                    }

                    <div class="af-form-group mb-3">
                        <label class="af-label">Active Stage</label>
                        <div class="d-flex align-items-center gap-2 p-2 rounded border bg-light">
                            <span class="badge @(Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "bg-success" : (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "bg-secondary" : "bg-primary")) fs-6 px-3 py-1">
                                @(allProcessesDone ? (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "Dispatched" : "Ready to Dispatch") : currentProcessName)
                            </span>
                            <span class="text-muted small">(@(completedSteps.Count)/@(creationSteps.Count) completed)</span>
                        </div>
                    </div>

                    <!-- Hidden legacy fallback fields -->
                    <input type="hidden" name="StitchingWorkerId" id="fallbackStitchingWorkerId" value="@Model.StitchingWorkerId" />
                    <input type="hidden" name="HandworkWorkerId" id="fallbackHandworkWorkerId" value="@Model.HandworkWorkerId" />
                    <input type="hidden" name="HandworkCholi" id="fallbackHwCholi" value="@(Model.HandworkCholi ? "true" : "false")" />
                    <input type="hidden" name="HandworkChaniya" id="fallbackHwChaniya" value="@(Model.HandworkChaniya ? "true" : "false")" />
                    <input type="hidden" name="HandworkDupatta" id="fallbackHwDupatta" value="@(Model.HandworkDupatta ? "true" : "false")" />

                    <input type="hidden" id="totalQuantity" name="TotalQuantity" value="@Model.TotalQuantity" />

                    <div style="display:flex;gap:.75rem;margin-top:1rem;">
                        <button type="submit" class="btn-af btn-af-primary">Save Changes</button>
                        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
                    </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">Colour & Size Matrix</div>
                <span class="af-badge b-blue" id="totalPieces">Total: @Model.TotalQuantity pcs</span>
            </div>
            <div style="padding:1rem;">
                <div id="matrixContainer">
                    <div class="text-center p-4 text-muted" id="matrixPlaceholder" style="display:none;">
                        Select a design to see colour/size matrix
                    </div>
                    <div id="matrixGrid" style="overflow-x:auto;">
                        <table class="af-table" id="matrixTable" style="min-width:100%;">
                            <thead>
                                <tr id="matrixHeader">
                                    <th style="min-width:100px;">Colour ↓ / Size →</th>
                                </tr>
                            </thead>
                            <tbody id="matrixBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Garment Components & Process Vendor Assignments Matrix -->
<div class="row mt-4">
    <div class="col-12">
        <div class="data-card mb-3" id="componentMatrixCard">
            <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="data-card-title">Garment Components & Process Vendor Planning Matrix</span>
                    <span class="text-muted ms-2" style="font-size:0.8rem;">Every component (e.g. Chaniya, Choli, Dupatta, Belt, Jacket) can be assigned to different vendors for different processes.</span>
                </div>
                <span class="af-badge b-blue" id="lotComponentCountBadge">@Model.GetComponentsList().Count Components</span>
            </div>
            <div style="padding:1.25rem;">
                <!-- Components Bar -->
                <div class="p-3 bg-light border rounded-3 mb-3">
                    <label class="form-label small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing:0.5px;">
                        Components for this Lot (Can have 3 or more parts):
                    </label>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="lotComponentBadgesContainer">
                        <!-- Badges rendered by JS -->
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                        <span class="small text-muted fw-semibold me-1">Quick Add:</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Belt" style="font-size:0.75rem;">+ Belt</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Jacket" style="font-size:0.75rem;">+ Jacket / Shrug</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Inner" style="font-size:0.75rem;">+ Inner / Lining</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Cape" style="font-size:0.75rem;">+ Cape</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Koti" style="font-size:0.75rem;">+ Koti</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Stole" style="font-size:0.75rem;">+ Stole</button>
                        
                        <div class="input-group input-group-sm ms-auto" style="max-width:260px;">
                            <input type="text" id="customLotComponentInput" class="form-control form-control-sm" placeholder="Custom component name..." />
                            <button type="button" class="btn btn-primary btn-sm" id="btnAddCustomLotComponent">+ Add Part</button>
                        </div>
                    </div>
                    <input type="hidden" name="Components" id="lotComponentsHiddenInput" value="@Model.Components" />
                </div>

                <!-- Matrix Table -->
                <div class="table-responsive bg-white border rounded-3">
                    <table class="table table-bordered table-hover align-middle mb-0" id="lotComponentMatrixTable">
                        <thead class="table-light">
                            <tr id="lotMatrixHeaderRow" style="font-size:0.82rem;">
                                <th style="min-width:140px; background:#f1f5f9;">Component Part</th>
                                <th style="width:50px; text-align:center; background:#f1f5f9;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="lotMatrixTableBody">
                            <!-- Dynamic rows injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</form>

<!-- Job Work Slips (Challans) Card for External Processes -->
<div class="card p-3 mt-4 border rounded-3 bg-light shadow-sm" id="jobSlipsCard">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <span>📑</span> Vendor Job Slips (Challans)
            </h5>
            <small class="text-muted">
                Automatically generated for outside vendor processes based on the Component Planning Matrix. In-house processes are handled internally without challans.
            </small>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.JobSlips != null && Model.JobSlips.Any())
            {
                <a asp-controller="JobSlip" asp-action="PrintAll" asp-route-lotId="@Model.Id" target="_blank" class="btn btn-sm btn-primary">
                    🖨️ Print All Slips (@Model.JobSlips.Count)
                </a>
            }
            <form asp-controller="JobSlip" asp-action="Regenerate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Re-sync job slips with the latest component vendor assignments">
                    🔄 Sync / Regenerate Slips
                </button>
            </form>
        </div>
    </div>

    @if (Model.JobSlips != null && Model.JobSlips.Any())
    {
        <div class="table-responsive bg-white border rounded-3">
            <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Slip #</th>
                        <th>Process</th>
                        <th>Vendor (Job Worker)</th>
                        <th>Assigned Component(s)</th>
                        <th class="text-center">Total Pcs</th>
                        <th class="text-end">Rate / Total</th>
                        <th class="text-center">Status</th>
                        <th>Issue Date</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slip in Model.JobSlips.OrderBy(s => s.ProcessName).ThenBy(s => s.Vendor?.VendorName))
                    {
                        var statusBadge = slip.Status switch {
                            "Issued" => "bg-primary text-white",
                            "In Process" => "bg-warning text-dark",
                            "Received" => "bg-success text-white",
                            "Cancelled" => "bg-danger text-white",
                            _ => "bg-secondary text-white"
                        };

                        <tr>
                            <td class="ps-3 fw-bold font-monospace">
                                <a asp-controller="JobSlip" asp-action="Details" asp-route-id="@slip.Id" class="text-decoration-none">
                                    @slip.SlipNumber
                                </a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@slip.ProcessName</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(slip.Vendor?.VendorName ?? $"Vendor #{slip.VendorId}")</div>
                                @if (!string.IsNullOrEmpty(slip.Vendor?.Phone))
                                {
                                    <small class="text-muted">📞 @slip.Vendor.Phone</small>
                                }
                            </td>
                            <td>
                                @foreach (var comp in slip.GetComponentsList())
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border me-1">@comp</span>
                                }
                            </td>
                            <td class="text-center fw-bold">
                                @slip.TotalQuantity <span class="text-muted fw-normal" style="font-size:0.75rem;">pcs</span>
                            </td>
                            <td class="text-end">
                                @if (slip.Rate.HasValue && slip.Rate > 0)
                                {
                                    <span class="font-monospace">₹@slip.Rate.Value.ToString("N2")/pc</span>
                                    @if (slip.TotalAmount.HasValue && slip.TotalAmount > 0)
                                    {
                                        <br /><small class="text-muted fw-bold">₹@slip.TotalAmount.Value.ToString("N2")</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge px-2 py-1">@slip.Status</span>
                            </td>
                            <td style="font-size:0.8rem; color:#64748b;">
                                @slip.IssueDate.ToString("dd-MMM-yyyy")
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="JobSlip" asp-action="Print" asp-route-id="@slip.Id" target="_blank" class="btn btn-outline-primary" title="Print Challan">
                                        🖨️ Print
                                    </a>
                                    <a asp-controller="JobSlip" asp-action="Details" asp-route-id="@slip.Id" class="btn btn-outline-secondary" title="View Details">
                                        👁️ View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-4 bg-white border rounded-3 text-center">
            <div style="font-size: 2rem;" class="mb-2">📑</div>
            <h6 class="fw-bold text-dark">No External Job Slips Generated</h6>
            <p class="text-muted mb-3" style="max-width:550px; margin:0 auto; font-size:0.85rem;">
                Job slips are automatically created when processes are delegated to external vendors in the planning matrix above. In-house processes do not generate external job slips.
            </p>
            <form asp-controller="JobSlip" asp-action="Regenerate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm btn-primary">
                    ⚡ Check & Generate Job Slips Now
                </button>
            </form>
        </div>
    }
</div>


@if (Model.Design?.BomItems?.Any() == true)
{
    var hasShortage = false;
    <div class="data-card mt-4">
        <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="data-card-title">Raw Material Requirements (BOM Consumption)</span>
                <span style="font-size: 0.8rem; color: #64748b; margin-left: 0.5rem;">Calculated for @Model.TotalQuantity pcs based on Design #@Model.Design.DesignNumber recipe</span>
            </div>
            <div>
                @if (Model.IsMaterialIssued)
                {
                    <span class="af-badge" style="background:#dcfce7;color:#16a34a;font-size:0.85rem;padding:0.4rem 0.75rem;">
                        ✔ Materials Issued on @Model.MaterialIssuedDate?.ToString("dd-MMM-yyyy HH:mm")
                    </span>
                }
                else
                {
                    <form asp-action="IssueMaterials" asp-route-id="@Model.Id" method="post" style="display:inline;" onsubmit="return confirm('Issue raw materials from stock for this lot? This will deduct the required quantities from inventory.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-af btn-af-primary btn-af-sm">
                            📦 Issue Materials from Stock
                        </button>
                    </form>
                }
            </div>
        </div>
        <div style="padding: 1rem;">
            <div style="overflow-x:auto;">
                <table class="af-table" style="font-size: 0.85rem;">
                    <thead>
                        <tr>
                            <th>Component</th>
                            <th>Raw Material</th>
                            <th class="text-end">Per Piece</th>
                            <th class="text-end">Wastage %</th>
                            <th class="text-end">Total Required (@Model.TotalQuantity pcs)</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-center">Availability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bom in Model.Design.BomItems)
                        {
                            var totalReq = Model.TotalQuantity * bom.EffectiveQuantity;
                            var currentStock = bom.RawMaterial?.CurrentStock ?? 0;
                            var isShortage = currentStock < totalReq;
                            if (isShortage) hasShortage = true;

                            <tr>
                                <td><span class="af-badge b-gray">@bom.Component</span></td>
                                <td>
                                    <strong>@(bom.RawMaterial?.Name ?? $"Material #{bom.RawMaterialId}")</strong>
                                    @if (!string.IsNullOrEmpty(bom.Remarks))
                                    {
                                        <span style="font-size: 0.75rem; color: #64748b;">(@bom.Remarks)</span>
                                    }
                                </td>
                                <td class="text-end">@bom.QuantityPerPiece.ToString("N2") @bom.RawMaterial?.Unit</td>
                                <td class="text-end">@bom.WastagePercentage.ToString("N1")%</td>
                                <td class="text-end" style="font-weight: 700; color: #0f172a;">@totalReq.ToString("N2") @bom.RawMaterial?.Unit</td>
                                <td class="text-end" style="font-weight: 600; color: @(isShortage ? "#dc2626" : "#16a34a");">
                                    @currentStock.ToString("N2") @bom.RawMaterial?.Unit
                                </td>
                                <td class="text-center">
                                    @if (isShortage)
                                    {
                                        <span class="af-badge" style="background:#fee2e2;color:#dc2626;">
                                            Shortage (-@((totalReq - currentStock).ToString("N2")))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="af-badge" style="background:#dcfce7;color:#16a34a;">
                                            Available
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (hasShortage && !Model.IsMaterialIssued)
            {
                <div class="af-alert af-alert-warning mt-3 mb-0" style="font-size: 0.85rem;">
                    <span class="alert-body">⚠ Some raw materials have insufficient stock for this lot. You can still issue or create a Purchase Order to replenish stock.</span>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="data-card mt-4 p-4 text-center">
        <p style="color: #64748b; margin-bottom: 0.75rem;">No Bill of Materials (BOM) recipe configured for Design <strong>@Model.Design?.DesignNumber</strong>.</p>
        <a asp-controller="Design" asp-action="Bom" asp-route-id="@Model.DesignId" class="btn-af btn-af-ghost btn-af-sm">
            ⚙ Configure BOM Recipe & Costing Sheet →
        </a>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var existingDetails = @Html.Raw(Json.Serialize(Model.Details.Select(d => new { colour = d.Colour, size = d.Size, quantity = d.Quantity })));
        var allVendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AashanaFashion.Models.Vendor>)(ViewBag.Vendors ?? new List<AashanaFashion.Models.Vendor>())).Select(v => new { id = v.Id, name = v.VendorName })));
        var lotComponentsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GetComponentsList()));
        var currentLotProcesses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(creationSteps));
        var existingAssignments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.ComponentAssignments ?? new List<AashanaFashion.Models.ProductionOrderComponentAssignment>()).Select(a => new { componentName = a.ComponentName, processName = a.ProcessName, vendorId = a.VendorId, rate = a.Rate })));
    </script>
    <script src="~/js/production-edit.js"></script>
    <script>
        // LOT COMPONENT & PROCESS VENDOR MATRIX
        var lotMatrixState = {};
        if (existingAssignments && existingAssignments.length > 0) {
            existingAssignments.forEach(function(a) {
                lotMatrixState[a.componentName + '___' + a.processName] = { vendorId: a.vendorId, rate: a.rate };
            });
        } else {
            // Fallback pre-fill from legacy workers if no assignments exist yet
            var legacyHw = '@Model.HandworkWorkerId';
            var legacySt = '@Model.StitchingWorkerId';
            if (legacySt) {
                lotComponentsList.forEach(function(c) {
                    lotMatrixState[c + '___Stitching'] = { vendorId: legacySt, rate: '' };
                });
            }
            if (legacyHw) {
                @if (Model.HandworkCholi) { <text>lotMatrixState['Choli___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
                @if (Model.HandworkChaniya) { <text>lotMatrixState['Chaniya___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
                @if (Model.HandworkDupatta) { <text>lotMatrixState['Dupatta___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
            }
        }

        function renderLotComponentBadges() {
            var html = '';
            lotComponentsList.forEach(function(comp) {
                var icon = '🧵';
                var clow = comp.toLowerCase();
                if (clow.includes('chaniya') || clow.includes('lehenga') || clow.includes('skirt')) icon = '👗';
                else if (clow.includes('choli') || clow.includes('blouse') || clow.includes('top')) icon = '👚';
                else if (clow.includes('dupatta') || clow.includes('chunri') || clow.includes('scarf')) icon = '🧣';
                else if (clow.includes('jacket') || clow.includes('shrug') || clow.includes('koti')) icon = '🧥';
                else if (clow.includes('belt')) icon = '🎗️';
                else if (clow.includes('inner') || clow.includes('lining')) icon = '🩱';
                else if (clow.includes('cape')) icon = '✨';

                html += `
                    <span class="badge bg-white text-dark border shadow-sm p-2 d-inline-flex align-items-center gap-2">
                        <span>${icon}</span>
                        <span class="fw-semibold">${comp}</span>
                        <button type="button" class="btn-close btn-close-sm remove-lot-component-btn" data-name="${comp}" title="Remove component" style="font-size:0.65rem;"></button>
                    </span>
                `;
            });
            $('#lotComponentBadgesContainer').html(html);
            $('#lotComponentsHiddenInput').val(lotComponentsList.join(', '));
            $('#lotComponentCountBadge').text(lotComponentsList.length + (lotComponentsList.length === 1 ? ' Component' : ' Components'));
        }

        function renderLotMatrixTable() {
            var procs = currentLotProcesses || [];
            var thead = '<th style="min-width:140px; background:#f1f5f9;">Component Part</th>';
            procs.forEach(function(p) {
                thead += `<th style="min-width:170px; background:#f1f5f9; text-align:center;">${p}</th>`;
            });
            thead += '<th style="width:50px; text-align:center; background:#f1f5f9;">Action</th>';
            $('#lotMatrixHeaderRow').html(thead);

            var tbody = '';
            var assignmentIdx = 0;

            lotComponentsList.forEach(function(comp) {
                var icon = '🧵';
                var clow = comp.toLowerCase();
                if (clow.includes('chaniya') || clow.includes('lehenga')) icon = '👗';
                else if (clow.includes('choli') || clow.includes('blouse')) icon = '👚';
                else if (clow.includes('dupatta') || clow.includes('chunri')) icon = '🧣';
                else if (clow.includes('jacket') || clow.includes('shrug')) icon = '🧥';
                else if (clow.includes('belt')) icon = '🎗️';
                else if (clow.includes('inner') || clow.includes('lining')) icon = '🩱';

                tbody += `<tr>
                    <td class="fw-bold text-dark" style="white-space:nowrap; vertical-align:middle;">
                        <span class="me-1">${icon}</span> ${comp}
                    </td>`;

                procs.forEach(function(p) {
                    var key = comp + '___' + p;
                    var val = lotMatrixState[key] || { vendorId: '', rate: '' };

                    var options = '<option value="">— In-house / None —</option>';
                    if (typeof allVendors !== 'undefined') {
                        allVendors.forEach(function(v) {
                            var sel = (val.vendorId && String(val.vendorId) === String(v.id)) ? 'selected' : '';
                            options += `<option value="${v.id}" ${sel}>${v.name}</option>`;
                        });
                    }

                    tbody += `
                        <td class="p-2">
                            <select name="ComponentAssignments[${assignmentIdx}].VendorId" class="form-select form-select-sm lot-matrix-vendor-select" data-comp="${comp}" data-proc="${p}">
                                ${options}
                            </select>
                            <div class="input-group input-group-sm mt-1">
                                <span class="input-group-text py-0 px-1 text-muted" style="font-size:0.7rem;">₹</span>
                                <input type="number" step="0.01" min="0" name="ComponentAssignments[${assignmentIdx}].Rate" value="${val.rate || ''}" placeholder="Rate" class="form-control form-control-sm py-0 lot-matrix-rate-input" data-comp="${comp}" data-proc="${p}" style="font-size:0.75rem;" />
                            </div>
                            <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ComponentName" value="${comp}" />
                            <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ProcessName" value="${p}" />
                        </td>
                    `;
                    assignmentIdx++;
                });

                tbody += `
                    <td class="text-center" style="vertical-align:middle;">
                        <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 remove-lot-component-btn" data-name="${comp}" title="Remove ${comp}">
                            🗑️
                        </button>
                    </td>
                </tr>`;
            });

            if (lotComponentsList.length === 0) {
                tbody = `<tr><td colspan="${procs.length + 2}" class="text-center text-muted py-4">No components defined for this lot. Click a quick add button or type a component name above.</td></tr>`;
            }

            $('#lotMatrixTableBody').html(tbody);
            syncLotLegacyWorkerFallbacks();
        }

        function syncLotLegacyWorkerFallbacks() {
            var hwVendor = '';
            var stVendor = '';
            var hasHwCholi = false;
            var hasHwChaniya = false;
            var hasHwDupatta = false;

            Object.keys(lotMatrixState).forEach(function(key) {
                var parts = key.split('___');
                var c = parts[0];
                var p = parts[1];
                var entry = lotMatrixState[key];
                if (entry && entry.vendorId) {
                    if (p.toLowerCase().includes('handwork')) {
                        if (!hwVendor) hwVendor = entry.vendorId;
                        if (c.toLowerCase().includes('choli')) hasHwCholi = true;
                        if (c.toLowerCase().includes('chaniya') || c.toLowerCase().includes('lehenga')) hasHwChaniya = true;
                        if (c.toLowerCase().includes('dupatta')) hasHwDupatta = true;
                    }
                    if (p.toLowerCase().includes('stitching') && !stVendor) {
                        stVendor = entry.vendorId;
                    }
                }
            });

            $('#fallbackHandworkWorkerId').val(hwVendor);
            $('#fallbackStitchingWorkerId').val(stVendor);
            $('#fallbackHwCholi').val(hasHwCholi ? 'true' : 'false');
            $('#fallbackHwChaniya').val(hasHwChaniya ? 'true' : 'false');
            $('#fallbackHwDupatta').val(hasHwDupatta ? 'true' : 'false');
        }

        $(document).on('change', '.lot-matrix-vendor-select', function() {
            var comp = $(this).data('comp');
            var proc = $(this).data('proc');
            var key = comp + '___' + proc;
            if (!lotMatrixState[key]) lotMatrixState[key] = {};
            lotMatrixState[key].vendorId = $(this).val();
            syncLotLegacyWorkerFallbacks();
        });

        $(document).on('input', '.lot-matrix-rate-input', function() {
            var comp = $(this).data('comp');
            var proc = $(this).data('proc');
            var key = comp + '___' + proc;
            if (!lotMatrixState[key]) lotMatrixState[key] = {};
            lotMatrixState[key].rate = $(this).val();
        });

        function addLotComponent(name) {
            name = (name || '').trim();
            if (!name) return;
            if (!lotComponentsList.some(function(c) { return c.toLowerCase() === name.toLowerCase(); })) {
                lotComponentsList.push(name);
                renderLotComponentBadges();
                renderLotMatrixTable();
            }
        }

        function removeLotComponent(name) {
            lotComponentsList = lotComponentsList.filter(function(c) { return c.toLowerCase() !== name.toLowerCase(); });
            Object.keys(lotMatrixState).forEach(function(k) {
                if (k.startsWith(name + '___')) delete lotMatrixState[k];
            });
            renderLotComponentBadges();
            renderLotMatrixTable();
        }

        $(document).on('click', '.quick-add-lot-comp', function() {
            var name = $(this).data('name');
            addLotComponent(name);
        });

        $('#btnAddCustomLotComponent').on('click', function() {
            var name = $('#customLotComponentInput').val();
            if (name) {
                addLotComponent(name);
                $('#customLotComponentInput').val('');
            }
        });

        $('#customLotComponentInput').on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#btnAddCustomLotComponent').click();
            }
        });

        $(document).on('click', '.remove-lot-component-btn', function() {
            var name = $(this).data('name');
            removeLotComponent(name);
        });

        // Initialize on load
        renderLotComponentBadges();
        renderLotMatrixTable();
    </script>
}
