@model AashanaFashion.Models.ProductionOrder
@{
    ViewData["Title"] = "Edit Order";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    var designs    = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new List<AashanaFashion.Models.Design>();
    var vendors    = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new List<AashanaFashion.Models.Vendor>();
    var currentDesign  = designs.FirstOrDefault(d => d.Id == Model.DesignId) ?? Model.Design;
    var creationSteps  = currentDesign?.GetCreationSteps() ?? new List<string> { "Cutting", "Dying", "Stitching" };
    var completedSteps = Model.GetCompletedProcessesList();

    // Determine current active step index in configured creation steps
    int currentStepIndex = -1;
    for (int i = 0; i < creationSteps.Count; i++)
    {
        if (!completedSteps.Contains(creationSteps[i]))
        {
            currentStepIndex = i;
            break;
        }
    }

    bool allProcessesDone = (currentStepIndex == -1 && creationSteps.Any()) || Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch || Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
    string currentProcessName = allProcessesDone
        ? (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "Dispatched" : "Ready to Dispatch")
        : (currentStepIndex >= 0 ? creationSteps[currentStepIndex] : "Ready to Dispatch");
    string? nextProcessName = (currentStepIndex >= 0 && currentStepIndex + 1 < creationSteps.Count)
        ? creationSteps[currentStepIndex + 1]
        : (currentStepIndex >= 0 ? "Ready to Dispatch" : null);
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Production orders</a>
        <h1 class="page-title d-flex align-items-center gap-2 flex-wrap">
            Lot @Model.LotNo
            <span class="af-badge @(Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "b-gray" : (Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "b-green" : "b-blue"))">@currentProcessName</span>
        </h1>
        <p class="page-sub">Design @Model.Design?.DesignNumber · @Model.TotalQuantity pcs</p>
    </div>
    <div class="page-actions">
        <a asp-controller="QualityControl" asp-action="Index" asp-route-orderId="@Model.Id" class="btn btn-secondary">QC logs</a>
        <a asp-controller="QualityControl" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-secondary"><i class="bi bi-clipboard-check"></i> Log QC check</a>
        <div class="dropdown">
            <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-printer"></i> Print</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @if (Model.JobSlips != null && Model.JobSlips.Any())
                {
                    <li><a asp-controller="JobSlip" asp-action="PrintAll" asp-route-lotId="@Model.Id" target="_blank" class="dropdown-item"><i class="bi bi-files"></i> All job slips (@Model.JobSlips.Count)</a></li>
                }
                <li><a asp-controller="Barcode" asp-action="PrintTags" asp-route-orderId="@Model.Id" target="_blank" class="dropdown-item"><i class="bi bi-upc"></i> Barcode tags</a></li>
                <li><a asp-controller="Barcode" asp-action="PrintLotTag" asp-route-orderId="@Model.Id" target="_blank" class="dropdown-item"><i class="bi bi-tag"></i> Lot tag</a></li>
            </ul>
        </div>
    </div>
</div>

<form asp-action="Edit" method="post" id="orderForm">
@Html.AntiForgeryToken()
<input type="hidden" name="id" value="@Model.Id" />
<input type="hidden" name="CreatedDate" value="@Model.CreatedDate.ToString("yyyy-MM-ddTHH:mm:ss")" />
<input type="hidden" name="Status" id="orderStatusInput" value="@Model.Status" />
<input type="hidden" name="CurrentProcess" id="currentProcessInput" value="@Model.CurrentProcess" />
<input type="hidden" name="CompletedProcesses" id="completedProcessesInput" value="@Model.CompletedProcesses" />

<!-- Workflow stage progression -->
<div class="data-card mb-4" id="lotWorkflowCard">
    <div class="data-card-header">
        <div>
            <span class="data-card-title"><i class="bi bi-diagram-3"></i> Production stage progression</span>
            <span class="data-card-sub d-block">Configured processes for design <strong>@(currentDesign?.DesignNumber ?? Model.Design?.DesignNumber)</strong>. The sequence is enforced in order.</span>
        </div>
        <span class="af-badge @(allProcessesDone ? "b-green" : "b-indigo")" id="lotStepCountBadge">
            @(completedSteps.Count) of @(creationSteps.Count) processes completed
        </span>
    </div>
    <div class="data-card-body">
        <div id="lotStagesPipeline" class="flow mb-4">
            @for (int i = 0; i < creationSteps.Count; i++)
            {
                var step = creationSteps[i];
                var isCompleted = completedSteps.Contains(step);
                var isCurrent = !isCompleted && i == currentStepIndex && !allProcessesDone;

                <span class="flow-step stage-node @(isCompleted ? "done" : (isCurrent ? "current" : "locked"))" data-step-index="@i" data-step-name="@step"
                      title="@(isCompleted ? "Completed" : isCurrent ? "In progress" : $"Must complete '{(i > 0 ? creationSteps[i - 1] : "")}' first")">
                    <span class="flow-num">@if (isCompleted) {<i class="bi bi-check"></i>} else {<text>@(i + 1)</text>}</span>
                    @step
                    @if (isCurrent) { <span class="flow-code">In progress</span> }
                </span>
                <i class="bi bi-chevron-right flow-sep"></i>
            }

            @{
                bool isReady = Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch;
                bool isPastReady = Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
                bool isDispatched = Model.Status == AashanaFashion.Models.OrderStatus.Dispatched;
            }
            <span class="flow-step stage-node-destination @(isPastReady ? "done" : (isReady ? "current" : "locked"))" title="@(isReady || isPastReady ? "" : "Unlocks once all configured processes are completed")">
                <span class="flow-num">@if (isPastReady) {<i class="bi bi-check"></i>} else {<i class="bi bi-box-seam"></i>}</span>
                Ready to Dispatch
                @if (isReady) { <span class="flow-code">Active</span> }
            </span>
            <i class="bi bi-chevron-right flow-sep"></i>
            <span class="flow-step stage-node-destination @(isDispatched ? "done" : "locked")" title="Final status after dispatching">
                <span class="flow-num">@if (isDispatched) {<i class="bi bi-check"></i>} else {<i class="bi bi-truck"></i>}</span>
                Dispatched
            </span>
        </div>

        <div class="panel-inset d-flex justify-content-between align-items-center flex-wrap gap-3 mb-0">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="micro-label mb-0">Current stage</span>
                <span class="af-badge @(Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "b-gray" : (Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "b-green" : "b-indigo"))">@currentProcessName</span>
                @if (!allProcessesDone && !string.IsNullOrEmpty(nextProcessName))
                {
                    <span class="text-sm text-muted">Next: <strong class="text-foreground">@nextProcessName</strong></span>
                }
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (completedSteps.Any() || Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch || Model.Status == AashanaFashion.Models.OrderStatus.Dispatched)
                {
                    <button type="submit" formaction="@Url.Action("RevertStage", "Production", new { id = Model.Id })" class="btn btn-sm btn-ghost" title="Step back to previous stage if needed" onclick="return confirm('Step back to previous stage?');">
                        <i class="bi bi-arrow-counterclockwise"></i> Revert previous step
                    </button>
                }
                @if (!allProcessesDone)
                {
                    <button type="submit" formaction="@Url.Action("AdvanceStage", "Production", new { id = Model.Id })" class="btn btn-sm btn-primary" title="Mark '@currentProcessName' complete and unlock '@nextProcessName'">
                        Mark @currentProcessName complete <i class="bi bi-arrow-right"></i>
                    </button>
                }
                else if (Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch)
                {
                    <button type="submit" formaction="@Url.Action("AdvanceStage", "Production", new { id = Model.Id })" class="btn btn-sm btn-primary" title="Mark this lot as Dispatched">
                        <i class="bi bi-truck"></i> Mark lot dispatched
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Order details</span>
            </div>
            <div class="data-card-body">

                    @if (isAdmin)
                    {
                        <div class="af-form-group">
                            <label class="af-label">Design</label>
                            <select name="DesignId" class="af-input af-select" id="designSelect">
                                @Html.Raw(string.Join("", designs.Select(d => 
                                    $"<option value=\"{d.Id}\" data-colours=\"{d.Colours}\" data-sizes=\"{d.Sizes}\" data-steps=\"{d.CreationFlow}\" data-hw-worker=\"{d.HandworkWorkerId}\" data-st-worker=\"{d.StitchingWorkerId}\" data-hw-choli=\"{d.HandworkCholi.ToString().ToLower()}\" data-hw-chaniya=\"{d.HandworkChaniya.ToString().ToLower()}\" data-hw-dupatta=\"{d.HandworkDupatta.ToString().ToLower()}\" {(d.Id == Model.DesignId ? "selected" : "")}>{d.DesignNumber}</option>")))
                            </select>
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Lot No</label>
                            <input type="text" name="LotNo" class="af-input font-monospace" value="@Model.LotNo" />
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="DesignId" value="@Model.DesignId" />
                        <div class="af-form-group">
                            <label class="af-label">Design</label>
                            <input type="text" class="af-input" value="@Model.Design?.DesignNumber" disabled />
                        </div>
                        <div class="af-form-group">
                            <label class="af-label">Lot No</label>
                            <input type="text" class="af-input font-monospace" value="@Model.LotNo" disabled />
                        </div>
                    }

                    <div class="af-form-group mb-0">
                        <label class="af-label">Active stage</label>
                        <div class="d-flex align-items-center gap-2">
                            <span class="af-badge @(Model.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "b-green" : (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "b-gray" : "b-indigo"))">
                                @(allProcessesDone ? (Model.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "Dispatched" : "Ready to Dispatch") : currentProcessName)
                            </span>
                            <span class="text-muted text-xs">(@(completedSteps.Count)/@(creationSteps.Count) completed)</span>
                        </div>
                    </div>

                    <!-- Hidden legacy fallback fields -->
                    <input type="hidden" name="StitchingWorkerId" id="fallbackStitchingWorkerId" value="@Model.StitchingWorkerId" />
                    <input type="hidden" name="HandworkWorkerId" id="fallbackHandworkWorkerId" value="@Model.HandworkWorkerId" />
                    <input type="hidden" name="HandworkCholi" id="fallbackHwCholi" value="@(Model.HandworkCholi ? "true" : "false")" />
                    <input type="hidden" name="HandworkChaniya" id="fallbackHwChaniya" value="@(Model.HandworkChaniya ? "true" : "false")" />
                    <input type="hidden" name="HandworkDupatta" id="fallbackHwDupatta" value="@(Model.HandworkDupatta ? "true" : "false")" />

                    <input type="hidden" id="totalQuantity" name="TotalQuantity" value="@Model.TotalQuantity" />
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Colour &amp; size quantities</span>
                <span class="af-badge b-indigo" id="totalPieces">Total: @Model.TotalQuantity pcs</span>
            </div>
            <div id="matrixContainer">
                <div class="empty-state py-5" id="matrixPlaceholder" style="display:none;">
                    <div class="es-icon"><i class="bi bi-grid-3x3"></i></div>
                    <p>Select a design to see its colour / size matrix.</p>
                </div>
                <div id="matrixGrid" class="table-scroll">
                    <table class="af-table table-edit matrix-table" id="matrixTable" style="min-width:100%;">
                        <thead>
                            <tr id="matrixHeader">
                                <th style="min-width:110px;">Colour \ Size</th>
                            </tr>
                        </thead>
                        <tbody id="matrixBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Garment Components & Process Vendor Assignments Matrix -->
<div class="data-card mt-4" id="componentMatrixCard">
    <div class="data-card-header">
        <div>
            <span class="data-card-title">Garment components &amp; vendor planning</span>
            <span class="data-card-sub d-block">Each component (Chaniya, Choli, Dupatta, Belt, Jacket…) can go to a different vendor for each process.</span>
        </div>
        <span class="af-badge b-indigo" id="lotComponentCountBadge">@Model.GetComponentsList().Count Components</span>
    </div>
    <div class="data-card-body">
        <div class="panel-inset">
            <span class="micro-label">Components for this lot (3 or more parts)</span>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="lotComponentBadgesContainer">
                <!-- Badges rendered by JS -->
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                <span class="text-xs text-muted me-1">Quick add</span>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Belt"><i class="bi bi-plus"></i> Belt</button>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Jacket"><i class="bi bi-plus"></i> Jacket / Shrug</button>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Inner"><i class="bi bi-plus"></i> Inner / Lining</button>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Cape"><i class="bi bi-plus"></i> Cape</button>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Koti"><i class="bi bi-plus"></i> Koti</button>
                <button type="button" class="btn btn-sm btn-secondary quick-add-lot-comp" data-name="Stole"><i class="bi bi-plus"></i> Stole</button>

                <div class="input-group input-group-sm ms-auto" style="max-width:280px;">
                    <input type="text" id="customLotComponentInput" class="form-control form-control-sm" placeholder="Custom component name…" />
                    <button type="button" class="btn btn-secondary btn-sm" id="btnAddCustomLotComponent"><i class="bi bi-plus"></i> Add part</button>
                </div>
            </div>
            <input type="hidden" name="Components" id="lotComponentsHiddenInput" value="@Model.Components" />
        </div>

        <div class="grid-card">
            <table class="af-table table-edit" id="lotComponentMatrixTable">
                <thead>
                    <tr id="lotMatrixHeaderRow">
                        <th style="min-width:140px;">Component</th>
                        <th style="width:50px;"></th>
                    </tr>
                </thead>
                <tbody id="lotMatrixTableBody">
                    <!-- Dynamic rows injected by JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="form-footer">
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</div>
</form>

<!-- Job Work Slips (Challans) for external processes -->
<div class="table-card mt-4" id="jobSlipsCard">
    <div class="data-card-header">
        <div>
            <span class="data-card-title"><i class="bi bi-files"></i> Vendor job slips (challans)</span>
            <span class="data-card-sub d-block">Generated for outside vendor processes from the component planning matrix. In-house processes need no challans.</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.JobSlips != null && Model.JobSlips.Any())
            {
                <a asp-controller="JobSlip" asp-action="PrintAll" asp-route-lotId="@Model.Id" target="_blank" class="btn btn-sm btn-secondary">
                    <i class="bi bi-printer"></i> Print all (@Model.JobSlips.Count)
                </a>
            }
            <form asp-controller="JobSlip" asp-action="Regenerate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-sm btn-secondary" title="Re-sync job slips with the latest component vendor assignments">
                    <i class="bi bi-arrow-repeat"></i> Sync slips
                </button>
            </form>
        </div>
    </div>

    @if (Model.JobSlips != null && Model.JobSlips.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Slip #</th>
                        <th>Process</th>
                        <th>Vendor (Job Worker)</th>
                        <th>Component(s)</th>
                        <th class="text-end">Total Pcs</th>
                        <th class="text-end">Rate / Total</th>
                        <th>Status</th>
                        <th>Issue Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slip in Model.JobSlips.OrderBy(s => s.ProcessName).ThenBy(s => s.Vendor?.VendorName))
                    {
                        var statusBadge = slip.Status switch {
                            "Issued" => "b-blue",
                            "In Process" => "b-yellow",
                            "Received" => "b-green",
                            "Cancelled" => "b-red",
                            _ => "b-gray"
                        };

                        <tr>
                            <td>
                                <a asp-controller="JobSlip" asp-action="Details" asp-route-id="@slip.Id" class="font-monospace fw-medium">@slip.SlipNumber</a>
                            </td>
                            <td><span class="tag">@slip.ProcessName</span></td>
                            <td>
                                <span class="cell-title">@(slip.Vendor?.VendorName ?? $"Vendor #{slip.VendorId}")</span>
                                @if (!string.IsNullOrEmpty(slip.Vendor?.Phone))
                                {
                                    <span class="cell-sub">@slip.Vendor.Phone</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var comp in slip.GetComponentsList())
                                    {
                                        <span class="tag">@comp</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-num"><span class="text-foreground fw-medium">@slip.TotalQuantity</span> <span class="text-xs text-muted">pcs</span></td>
                            <td class="cell-num">
                                @if (slip.Rate.HasValue && slip.Rate > 0)
                                {
                                    <span>₹@slip.Rate.Value.ToString("N2")/pc</span>
                                    @if (slip.TotalAmount.HasValue && slip.TotalAmount > 0)
                                    {
                                        <span class="cell-sub">₹@slip.TotalAmount.Value.ToString("N2")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td><span class="af-badge @statusBadge">@slip.Status</span></td>
                            <td class="text-muted text-nowrap">@slip.IssueDate.ToString("dd-MMM-yyyy")</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-controller="JobSlip" asp-action="Print" asp-route-id="@slip.Id" target="_blank" class="row-action" title="Print challan" aria-label="Print challan"><i class="bi bi-printer"></i></a>
                                    <a asp-controller="JobSlip" asp-action="Details" asp-route-id="@slip.Id" class="row-action primary" title="View details" aria-label="View details"><i class="bi bi-box-arrow-up-right"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-files"></i></div>
            <div class="es-title">No external job slips</div>
            <p>Job slips are created when processes are delegated to external vendors in the planning matrix above.</p>
            <form asp-controller="JobSlip" asp-action="Regenerate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lotId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn btn-secondary">
                    <i class="bi bi-lightning-charge"></i> Check &amp; generate job slips
                </button>
            </form>
        </div>
    }
</div>

@if (Model.Design?.BomItems?.Any() == true)
{
    var hasShortage = false;
    <div class="table-card mt-4">
        <div class="data-card-header">
            <div>
                <span class="data-card-title">Raw material requirements (BOM)</span>
                <span class="data-card-sub d-block">Calculated for @Model.TotalQuantity pcs from design @Model.Design.DesignNumber's recipe</span>
            </div>
            <div>
                @if (Model.IsMaterialIssued)
                {
                    <span class="af-badge b-green"><i class="bi bi-check2"></i> Materials issued on @Model.MaterialIssuedDate?.ToString("dd-MMM-yyyy HH:mm")</span>
                }
                else
                {
                    <form asp-action="IssueMaterials" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Issue raw materials from stock for this lot? This will deduct the required quantities from inventory.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="bi bi-box-seam"></i> Issue materials from stock
                        </button>
                    </form>
                }
            </div>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Component</th>
                        <th>Raw Material</th>
                        <th class="text-end">Per Piece</th>
                        <th class="text-end">Wastage %</th>
                        <th class="text-end">Required (@Model.TotalQuantity pcs)</th>
                        <th class="text-end">Current Stock</th>
                        <th>Availability</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bom in Model.Design.BomItems)
                    {
                        var totalReq = Model.TotalQuantity * bom.EffectiveQuantity;
                        var currentStock = bom.RawMaterial?.CurrentStock ?? 0;
                        var isShortage = currentStock < totalReq;
                        if (isShortage) hasShortage = true;

                        <tr>
                            <td><span class="tag">@bom.Component</span></td>
                            <td>
                                <span class="cell-title">@(bom.RawMaterial?.Name ?? $"Material #{bom.RawMaterialId}")</span>
                                @if (!string.IsNullOrEmpty(bom.Remarks))
                                {
                                    <span class="cell-sub">@bom.Remarks</span>
                                }
                            </td>
                            <td class="cell-num">@bom.QuantityPerPiece.ToString("N2") @bom.RawMaterial?.Unit</td>
                            <td class="cell-num">@bom.WastagePercentage.ToString("N1")%</td>
                            <td class="cell-num text-foreground fw-semibold">@totalReq.ToString("N2") @bom.RawMaterial?.Unit</td>
                            <td class="cell-num fw-medium @(isShortage ? "text-danger" : "text-success")">@currentStock.ToString("N2") @bom.RawMaterial?.Unit</td>
                            <td>
                                @if (isShortage)
                                {
                                    <span class="af-badge b-red">Short by @((totalReq - currentStock).ToString("N2"))</span>
                                }
                                else
                                {
                                    <span class="af-badge b-green">Available</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (hasShortage && !Model.IsMaterialIssued)
        {
            <div class="data-card-footer">
                <div class="af-alert af-alert-warning mb-0">
                    <div class="alert-body">Some raw materials have insufficient stock for this lot. You can still issue them or raise a Purchase Order to replenish stock.</div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="data-card mt-4">
        <div class="empty-state py-5">
            <div class="es-icon"><i class="bi bi-calculator"></i></div>
            <div class="es-title">No BOM recipe</div>
            <p>No bill of materials is configured for design <strong>@Model.Design?.DesignNumber</strong>.</p>
            <a asp-controller="Design" asp-action="Bom" asp-route-id="@Model.DesignId" class="btn btn-secondary"><i class="bi bi-gear"></i> Configure BOM &amp; costing</a>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var existingDetails = @Html.Raw(Json.Serialize(Model.Details.Select(d => new { colour = d.Colour, size = d.Size, quantity = d.Quantity })));
        var allVendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AashanaFashion.Models.Vendor>)(ViewBag.Vendors ?? new List<AashanaFashion.Models.Vendor>())).Select(v => new { id = v.Id, name = v.VendorName })));
        var lotComponentsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GetComponentsList()));
        var currentLotProcesses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(creationSteps));
        var existingAssignments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.ComponentAssignments ?? new List<AashanaFashion.Models.ProductionOrderComponentAssignment>()).Select(a => new { componentName = a.ComponentName, processName = a.ProcessName, vendorId = a.VendorId, rate = a.Rate })));
    </script>
    <script src="~/js/production-edit.js"></script>
    <script>
        // LOT COMPONENT & PROCESS VENDOR MATRIX
        var lotMatrixState = {};
        if (existingAssignments && existingAssignments.length > 0) {
            existingAssignments.forEach(function(a) {
                lotMatrixState[a.componentName + '___' + a.processName] = { vendorId: a.vendorId, rate: a.rate };
            });
        } else {
            // Fallback pre-fill from legacy workers if no assignments exist yet
            var legacyHw = '@Model.HandworkWorkerId';
            var legacySt = '@Model.StitchingWorkerId';
            if (legacySt) {
                lotComponentsList.forEach(function(c) {
                    lotMatrixState[c + '___Stitching'] = { vendorId: legacySt, rate: '' };
                });
            }
            if (legacyHw) {
                @if (Model.HandworkCholi) { <text>lotMatrixState['Choli___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
                @if (Model.HandworkChaniya) { <text>lotMatrixState['Chaniya___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
                @if (Model.HandworkDupatta) { <text>lotMatrixState['Dupatta___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
            }
        }

        function renderLotComponentBadges() {
            var html = '';
            lotComponentsList.forEach(function(comp) {
                html += `
                    <span class="tag">${comp} <button type="button" class="tag-remove remove-lot-component-btn" data-name="${comp}" title="Remove component" aria-label="Remove ${comp}"><i class="bi bi-x"></i></button></span>
                `;
            });
            $('#lotComponentBadgesContainer').html(html);
            $('#lotComponentsHiddenInput').val(lotComponentsList.join(', '));
            $('#lotComponentCountBadge').text(lotComponentsList.length + (lotComponentsList.length === 1 ? ' Component' : ' Components'));
        }

        function renderLotMatrixTable() {
            var procs = currentLotProcesses || [];
            var thead = '<th style="min-width:140px;">Component</th>';
            procs.forEach(function(p) {
                thead += `<th style="min-width:180px;">${p}</th>`;
            });
            thead += '<th style="width:50px;"></th>';
            $('#lotMatrixHeaderRow').html(thead);

            var tbody = '';
            var assignmentIdx = 0;

            lotComponentsList.forEach(function(comp) {
                tbody += `<tr>
                    <td class="cell-title text-nowrap">${comp}</td>`;

                procs.forEach(function(p) {
                    var key = comp + '___' + p;
                    var val = lotMatrixState[key] || { vendorId: '', rate: '' };

                    var options = '<option value="">— In-house / None —</option>';
                    if (typeof allVendors !== 'undefined') {
                        allVendors.forEach(function(v) {
                            var sel = (val.vendorId && String(val.vendorId) === String(v.id)) ? 'selected' : '';
                            options += `<option value="${v.id}" ${sel}>${v.name}</option>`;
                        });
                    }

                    tbody += `
                        <td>
                            <select name="ComponentAssignments[${assignmentIdx}].VendorId" class="form-select form-select-sm lot-matrix-vendor-select" data-comp="${comp}" data-proc="${p}">
                                ${options}
                            </select>
                            <div class="input-group input-group-sm mt-1">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0" name="ComponentAssignments[${assignmentIdx}].Rate" value="${val.rate || ''}" placeholder="Rate" class="form-control form-control-sm lot-matrix-rate-input" data-comp="${comp}" data-proc="${p}" />
                            </div>
                            <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ComponentName" value="${comp}" />
                            <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ProcessName" value="${p}" />
                        </td>
                    `;
                    assignmentIdx++;
                });

                tbody += `
                    <td class="text-center"><button type="button" class="row-action danger remove-lot-component-btn" data-name="${comp}" title="Remove ${comp}" aria-label="Remove ${comp}"><i class="bi bi-trash"></i></button></td>
                </tr>`;
            });

            if (lotComponentsList.length === 0) {
                tbody = `<tr><td colspan="${procs.length + 2}" class="text-center text-muted py-4">No components defined for this lot. Click a quick add button or type a component name above.</td></tr>`;
            }

            $('#lotMatrixTableBody').html(tbody);
            syncLotLegacyWorkerFallbacks();
        }

        function syncLotLegacyWorkerFallbacks() {
            var hwVendor = '';
            var stVendor = '';
            var hasHwCholi = false;
            var hasHwChaniya = false;
            var hasHwDupatta = false;

            Object.keys(lotMatrixState).forEach(function(key) {
                var parts = key.split('___');
                var c = parts[0];
                var p = parts[1];
                var entry = lotMatrixState[key];
                if (entry && entry.vendorId) {
                    if (p.toLowerCase().includes('handwork')) {
                        if (!hwVendor) hwVendor = entry.vendorId;
                        if (c.toLowerCase().includes('choli')) hasHwCholi = true;
                        if (c.toLowerCase().includes('chaniya') || c.toLowerCase().includes('lehenga')) hasHwChaniya = true;
                        if (c.toLowerCase().includes('dupatta')) hasHwDupatta = true;
                    }
                    if (p.toLowerCase().includes('stitching') && !stVendor) {
                        stVendor = entry.vendorId;
                    }
                }
            });

            $('#fallbackHandworkWorkerId').val(hwVendor);
            $('#fallbackStitchingWorkerId').val(stVendor);
            $('#fallbackHwCholi').val(hasHwCholi ? 'true' : 'false');
            $('#fallbackHwChaniya').val(hasHwChaniya ? 'true' : 'false');
            $('#fallbackHwDupatta').val(hasHwDupatta ? 'true' : 'false');
        }

        $(document).on('change', '.lot-matrix-vendor-select', function() {
            var comp = $(this).data('comp');
            var proc = $(this).data('proc');
            var key = comp + '___' + proc;
            if (!lotMatrixState[key]) lotMatrixState[key] = {};
            lotMatrixState[key].vendorId = $(this).val();
            syncLotLegacyWorkerFallbacks();
        });

        $(document).on('input', '.lot-matrix-rate-input', function() {
            var comp = $(this).data('comp');
            var proc = $(this).data('proc');
            var key = comp + '___' + proc;
            if (!lotMatrixState[key]) lotMatrixState[key] = {};
            lotMatrixState[key].rate = $(this).val();
        });

        function addLotComponent(name) {
            name = (name || '').trim();
            if (!name) return;
            if (!lotComponentsList.some(function(c) { return c.toLowerCase() === name.toLowerCase(); })) {
                lotComponentsList.push(name);
                renderLotComponentBadges();
                renderLotMatrixTable();
            }
        }

        function removeLotComponent(name) {
            lotComponentsList = lotComponentsList.filter(function(c) { return c.toLowerCase() !== name.toLowerCase(); });
            Object.keys(lotMatrixState).forEach(function(k) {
                if (k.startsWith(name + '___')) delete lotMatrixState[k];
            });
            renderLotComponentBadges();
            renderLotMatrixTable();
        }

        $(document).on('click', '.quick-add-lot-comp', function() {
            var name = $(this).data('name');
            addLotComponent(name);
        });

        $('#btnAddCustomLotComponent').on('click', function() {
            var name = $('#customLotComponentInput').val();
            if (name) {
                addLotComponent(name);
                $('#customLotComponentInput').val('');
            }
        });

        $('#customLotComponentInput').on('keypress', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                $('#btnAddCustomLotComponent').click();
            }
        });

        $(document).on('click', '.remove-lot-component-btn', function() {
            var name = $(this).data('name');
            removeLotComponent(name);
        });

        // Initialize on load
        renderLotComponentBadges();
        renderLotMatrixTable();
    </script>
}
