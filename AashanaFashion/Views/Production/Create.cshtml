@model AashanaFashion.Models.ProductionOrder
@{
    ViewData["Title"] = "New Production Order";
    var designs = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new List<AashanaFashion.Models.Design>();
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new List<AashanaFashion.Models.Vendor>();
    var designOptions = string.Join("", designs.Select(d => {
        var discJson = System.Text.Json.JsonSerializer.Serialize(
            (d.DiscontinuedVariants ?? new List<AashanaFashion.Models.DesignDiscontinuedVariant>())
            .Select(v => new { colour = v.Colour ?? "", size = v.Size ?? "", reason = v.Reason ?? "" })
        );
        var compJson = System.Text.Json.JsonSerializer.Serialize(d.GetComponentsList());
        var assignJson = System.Text.Json.JsonSerializer.Serialize(
            (d.ComponentAssignments ?? new List<AashanaFashion.Models.DesignComponentAssignment>())
            .Select(a => new { componentName = a.ComponentName, processName = a.ProcessName, vendorId = a.VendorId, rate = a.EstimatedRate })
        );
        return $"<option value=\"{d.Id}\" data-colours=\"{d.Colours}\" data-sizes=\"{d.Sizes}\" data-steps=\"{d.CreationFlow}\" data-hw-worker=\"{d.HandworkWorkerId}\" data-st-worker=\"{d.StitchingWorkerId}\" data-hw-choli=\"{d.HandworkCholi.ToString().ToLower()}\" data-hw-chaniya=\"{d.HandworkChaniya.ToString().ToLower()}\" data-hw-dupatta=\"{d.HandworkDupatta.ToString().ToLower()}\" data-components='{compJson}' data-assignments='{assignJson}' data-discontinued-variants='{discJson}'>{d.DesignNumber}</option>";
    }));
}

<div class="page-header">
    <div>
        <h1 class="page-title">New Production Order</h1>
        <p class="page-sub">Create a new production order</p>
    </div>
    <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back</a>
</div>

<form asp-action="Create" method="post" id="orderForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close">&times;</button>
        </div>
    }

    <div class="row">
        <div class="col-lg-4">
            <div class="data-card mb-3">
                <div class="data-card-header">
                    <div class="data-card-title">Order Details</div>
                </div>
                <div style="padding:1.5rem;">
                    <div class="af-form-group">
                        <label class="af-label">Design *</label>
                        <select asp-for="DesignId" class="af-input af-select" id="designSelect" required>
                            <option value="">— Select Design —</option>
                            @Html.Raw(designOptions)
                        </select>
                        <span asp-validation-for="DesignId" class="af-error"></span>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="LotNo" class="af-label">Lot No *</label>
                        <div style="display:flex;gap:0.5rem;align-items:center;">
                            <input asp-for="LotNo" class="af-input font-monospace fw-bold" id="lotNoInput" placeholder="LOT-202609-0001" required style="letter-spacing:0.5px;flex:1;" />
                            <button type="button" class="btn-af btn-af-ghost btn-af-sm" id="btnRefreshLot" title="Refresh to next auto Lot No" style="white-space:nowrap;padding:0.45rem 0.75rem;">
                                🔄 Auto
                            </button>
                        </div>
                        <span asp-validation-for="LotNo" class="af-error"></span>
                        <small class="text-muted" style="font-size:0.75rem;">Auto-generated format: <code>LOT-YYYYMM-XXXX</code>. You can also edit if needed.</small>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Status" class="af-label">Initial Status</label>
                        <select asp-for="Status" class="af-input af-select"
                                asp-items="Html.GetEnumSelectList<AashanaFashion.Models.OrderStatus>()"></select>
                    </div>

                    <!-- Hidden legacy fallback fields -->
                    <input type="hidden" asp-for="StitchingWorkerId" id="fallbackStitchingWorkerId" />
                    <input type="hidden" asp-for="HandworkWorkerId" id="fallbackHandworkWorkerId" />
                    <input type="hidden" asp-for="HandworkCholi" id="fallbackHwCholi" />
                    <input type="hidden" asp-for="HandworkChaniya" id="fallbackHwChaniya" />
                    <input type="hidden" asp-for="HandworkDupatta" id="fallbackHwDupatta" />

                    <div class="af-form-group" id="verificationSection" style="display:none;">
                        <label class="af-label">Verification Checklist</label>
                        <div style="background:#f8fafc;border-radius:10px;padding:1rem;display:flex;flex-direction:column;gap:.75rem;" id="verificationContainer">
                        </div>
                    </div>

                    <input type="hidden" id="totalQuantity" name="TotalQuantity" value="0" />

                    <div style="display:flex;gap:.75rem;margin-top:1rem;">
                        <button type="submit" class="btn-af btn-af-primary">Create Order</button>
                        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="data-card">
                <div class="data-card-header">
                    <div class="data-card-title">Colour & Size Matrix</div>
                    <span class="af-badge b-blue" id="totalPieces">Total: 0 pcs</span>
                </div>
                <div style="padding:1rem;">
                    <div id="matrixContainer">
                        <div class="text-center p-4 text-muted" id="matrixPlaceholder">
                            Select a design to see colour/size matrix
                        </div>
                        <div id="matrixGrid" style="overflow-x:auto;">
                            <table class="af-table" id="matrixTable" style="min-width:100%;">
                                <thead>
                                    <tr id="matrixHeader">
                                        <th style="min-width:100px;">Colour ↓ / Size →</th>
                                    </tr>
                                </thead>
                                <tbody id="matrixBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Garment Components & Process Vendor Assignments Matrix -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="data-card mb-3" id="componentMatrixCard">
                <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="data-card-title">Garment Components & Process Vendor Planning Matrix</span>
                        <span class="text-muted ms-2" style="font-size:0.8rem;">Every component (e.g. Chaniya, Choli, Dupatta, Belt, Jacket) can be assigned to different vendors for different processes.</span>
                    </div>
                    <span class="af-badge b-blue" id="lotComponentCountBadge">3 Components</span>
                </div>
                <div style="padding:1.25rem;">
                    <!-- Components Bar -->
                    <div class="p-3 bg-light border rounded-3 mb-3">
                        <label class="form-label small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing:0.5px;">
                            Components for this Lot (Can have 3 or more parts):
                        </label>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="lotComponentBadgesContainer">
                            <!-- Badges rendered by JS -->
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                            <span class="small text-muted fw-semibold me-1">Quick Add:</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Belt" style="font-size:0.75rem;">+ Belt</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Jacket" style="font-size:0.75rem;">+ Jacket / Shrug</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Inner" style="font-size:0.75rem;">+ Inner / Lining</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Cape" style="font-size:0.75rem;">+ Cape</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Koti" style="font-size:0.75rem;">+ Koti</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-lot-comp" data-name="Stole" style="font-size:0.75rem;">+ Stole</button>
                            
                            <div class="input-group input-group-sm ms-auto" style="max-width:260px;">
                                <input type="text" id="customLotComponentInput" class="form-control form-control-sm" placeholder="Custom component name..." />
                                <button type="button" class="btn btn-primary btn-sm" id="btnAddCustomLotComponent">+ Add Part</button>
                            </div>
                        </div>
                        <input type="hidden" asp-for="Components" id="lotComponentsHiddenInput" value="Chaniya, Choli, Dupatta" />
                    </div>

                    <!-- Matrix Table -->
                    <div class="table-responsive bg-white border rounded-3">
                        <table class="table table-bordered table-hover align-middle mb-0" id="lotComponentMatrixTable">
                            <thead class="table-light">
                                <tr id="lotMatrixHeaderRow" style="font-size:0.82rem;">
                                    <th style="min-width:140px; background:#f1f5f9;">Component Part</th>
                                    <th style="width:50px; text-align:center; background:#f1f5f9;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="lotMatrixTableBody">
                                <tr><td colspan="2" class="text-center text-muted py-4">Select a design above to load components and process vendor planning matrix.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        var allVendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AashanaFashion.Models.Vendor>)(ViewBag.Vendors ?? new List<AashanaFashion.Models.Vendor>())).Select(v => new { id = v.Id, name = v.VendorName })));
        var allMasterProcesses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AashanaFashion.Models.ProcessMaster>)(ViewBag.Processes ?? new List<AashanaFashion.Models.ProcessMaster>())).Select(p => new { id = p.Id, name = p.ProcessName, order = p.DisplayOrder })));
    </script>
    <script src="~/js/production-create.js"></script>
    <script>
        document.getElementById('btnRefreshLot')?.addEventListener('click', async function() {
            try {
                const res = await fetch('/Production/GetNextLotNumber');
                if (res.ok) {
                    const data = await res.json();
                    if (data.lotNo) {
                        const input = document.getElementById('lotNoInput');
                        input.value = data.lotNo;
                        input.classList.add('border-primary');
                        setTimeout(() => input.classList.remove('border-primary'), 600);
                    }
                }
            } catch (err) {
                console.error('Failed to get next lot number', err);
            }
        });
    </script>
}
