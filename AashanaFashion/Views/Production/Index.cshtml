@model IEnumerable<AashanaFashion.Models.BatchDashboardViewModel>
@{
    ViewData["Title"] = "Production Orders";
    var role        = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin    = role == "Admin" || role == "SuperAdmin";
    bool canCreate  = isAdmin || User.HasClaim("Permission.ProductionOrder.CanCreate", "true");
    bool canEdit    = isAdmin || User.HasClaim("Permission.ProductionOrder.CanEdit",   "true");
    bool canDelete  = isAdmin || User.HasClaim("Permission.ProductionOrder.CanDelete", "true");
    bool filtered   = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.SelectedStatus != null;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Production Orders</h1>
        <p class="page-sub">Plan production lots, assign vendors per component and follow each lot through its creation flow.</p>
    </div>
    @if (canCreate)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Order Lot</a>
        </div>
    }
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total orders</div>
        <div class="metric-value">@ViewBag.Total</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">In progress</div>
        <div class="metric-value">@ViewBag.InProgress</div>
        <div class="metric-meta info">moving through stages</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Ready to dispatch</div>
        <div class="metric-value">@ViewBag.ReadyToDispatch</div>
        <div class="metric-meta success">inwarded to ready stock</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Dispatched</div>
        <div class="metric-value">@ViewBag.Dispatched</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search design number or lot no…" value="@ViewBag.Search" />
            </div>
            <select name="status" class="af-input af-select" onchange="this.form.submit()">
                <option value="">All stages / statuses</option>
                @foreach (var s in Enum.GetValues<AashanaFashion.Models.OrderStatus>())
                {
                    <option value="@s" selected="@(ViewBag.SelectedStatus != null && (AashanaFashion.Models.OrderStatus)ViewBag.SelectedStatus == s ? "selected" : null)">@s.Humanize()</option>
                }
            </select>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-clipboard-data")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No production orders yet")</div>
            <p>@(filtered ? "No orders match your filters." : "Create an order lot to start tracking production.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">New Order Lot</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 56px;">#</th>
                        <th>Design / Lot</th>
                        <th class="text-end">Qty</th>
                        <th>Stage</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool done = item.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch || item.Status == AashanaFashion.Models.OrderStatus.Dispatched;
                        <tr>
                            <td class="text-muted tabular">@item.Id</td>
                            <td>
                                <div class="d-flex align-items-start gap-3">
                                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                                    {
                                        <img src="@item.PhotoPath" alt="@item.DesignNumber" class="thumb" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                    }
                                    <div class="min-w-0">
                                        @if (canEdit)
                                        {
                                            <span class="cell-title ctx-trigger link-trigger"
                                                  data-id="@item.Id"
                                                  data-edit="@Url.Action("Edit", "Production", new { id = item.Id })"
                                                  data-can-delete="@canDelete.ToString().ToLower()">@item.DesignNumber</span>
                                        }
                                        else
                                        {
                                            <span class="cell-title">@item.DesignNumber</span>
                                        }
                                        <span class="mono-id ms-1">@item.LotNo</span>

                                        @if (item.ComponentAssignments != null && item.ComponentAssignments.Any())
                                        {
                                            <div class="mt-1">
                                                @foreach (var procGroup in item.ComponentAssignments.GroupBy(a => a.ProcessName))
                                                {
                                                    var assignmentTexts = procGroup.Select(a => $"{a.ComponentName} → {(a.Vendor != null ? a.Vendor.VendorName : "Vendor #" + a.VendorId)}").ToList();
                                                    <div class="cell-sub text-truncate" style="max-width:320px;" title="@string.Join(", ", assignmentTexts)">
                                                        <span class="text-secondary fw-medium">@procGroup.Key:</span> @string.Join(", ", assignmentTexts)
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(item.StitchingWorkerName))
                                            {
                                                <span class="cell-sub text-nowrap">Stitch: <strong>@item.StitchingWorkerName</strong></span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.HandworkWorkerName))
                                            {
                                                <span class="cell-sub text-nowrap">Hand: <strong>@item.HandworkWorkerName</strong> (@item.HandworkParts)</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="cell-num"><span class="text-foreground">@item.TotalQuantity</span> <span class="text-xs text-muted">pcs</span></td>
                            <td style="min-width: 180px;">
                                <span class="text-foreground fw-medium">@(item.Status == AashanaFashion.Models.OrderStatus.Dispatched ? "Dispatched" : item.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch ? "Ready to Dispatch" : item.CurrentStage)</span>
                                @if (item.CreationSteps.Any())
                                {
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <div class="af-progress flex-grow-1" style="max-width: 120px;">
                                            <div class="af-progress-bar @(done ? "bg-success" : "")" role="progressbar" style="width: @item.ProgressPercentage%;" aria-valuenow="@item.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="text-xs text-muted tabular">@(item.CompletedProcesses.Count)/@(item.CreationSteps.Count)</span>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.Status == AashanaFashion.Models.OrderStatus.Dispatched)
                                { <span class="af-badge b-gray">Dispatched</span> }
                                else if (item.Status == AashanaFashion.Models.OrderStatus.ReadyToDispatch)
                                { <span class="af-badge b-green">Ready</span> }
                                else
                                { <span class="af-badge b-blue">In Progress</span> }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (item.JobSlipCount > 0)
                                    {
                                        <a asp-controller="JobSlip" asp-action="Index" asp-route-lotId="@item.Id" class="btn btn-sm btn-secondary me-1" title="View @item.JobSlipCount job slips for this lot"><i class="bi bi-files"></i> @item.JobSlipCount slips</a>
                                        <a asp-controller="JobSlip" asp-action="PrintAll" asp-route-lotId="@item.Id" target="_blank" class="row-action" title="Print all slips for lot @item.LotNo" aria-label="Print all slips"><i class="bi bi-printer"></i></a>
                                    }
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    }
                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action danger" title="Delete" aria-label="Delete" onclick="return confirm('Delete this order?')"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "order" : "orders")</span>
        </div>
    }
</div>

<!-- Context Menu -->
<ul id="ctxMenu" class="dropdown-menu" style="display:none; position:fixed; z-index:9999;">
    <li>
        <a id="ctxEdit" href="#" class="dropdown-item"><i class="bi bi-pencil"></i> Edit</a>
    </li>
    <li id="ctxDeleteItem">
        <hr class="dropdown-divider">
        <a id="ctxDelete" href="#" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</a>
    </li>
</ul>

<form id="ctxDeleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
<script>
    var menu = document.getElementById('ctxMenu');
    var ctxEdit = document.getElementById('ctxEdit');
    var ctxDeleteItem = document.getElementById('ctxDeleteItem');
    var ctxDeleteForm = document.getElementById('ctxDeleteForm');

    document.querySelectorAll('.ctx-trigger').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.stopPropagation();
            var id        = el.dataset.id;
            var canDel    = el.dataset.canDelete === 'true';

            ctxEdit.href = el.dataset.edit;

            if (canDel) {
                ctxDeleteForm.action = '/Production/Delete/' + id;
                ctxDeleteItem.style.display = 'block';
                document.getElementById('ctxDelete').onclick = function (ev) {
                    ev.preventDefault();
                    if (confirm('Delete this order?')) ctxDeleteForm.submit();
                    hideMenu();
                };
            } else {
                ctxDeleteItem.style.display = 'none';
            }

            menu.style.display = 'block';
            menu.style.left = e.clientX + 'px';
            menu.style.top = e.clientY + 'px';
        });
    });

    document.addEventListener('click', hideMenu);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideMenu(); });

    function hideMenu() { menu.style.display = 'none'; }
</script>
}
