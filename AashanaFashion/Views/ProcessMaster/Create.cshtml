@model AashanaFashion.Models.ProcessMaster
@{
    ViewData["Title"] = "Add New Process";
}

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="page-header">
            <div>
                <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Processes</a>
                <h1 class="page-title">Add New Process</h1>
                <p class="page-sub">Define a new stage in the production workflow and set its sequence order.</p>
            </div>
        </div>

        <form asp-action="Create" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-header">
                <span class="data-card-title">Process details</span>
            </div>
            <div class="data-card-body">
                <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="ProcessName" class="af-label">Process Name <span class="req">*</span></label>
                        <input asp-for="ProcessName" class="af-input" placeholder="e.g. Cutting, Dying, Handwork, Stitching" required />
                        <span asp-validation-for="ProcessName" class="af-error"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ProcessCode" class="af-label">Process Code</label>
                        <input asp-for="ProcessCode" class="af-input text-uppercase font-monospace" placeholder="e.g. CUT, DYE, STITCH" maxlength="30" />
                        <span asp-validation-for="ProcessCode" class="af-error"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="af-label">Sequence Order <span class="req">*</span></label>
                        <input asp-for="DisplayOrder" class="af-input" type="number" min="1" step="1" required />
                        <span class="af-hint">Determines position in the creation flow (1 = first step).</span>
                        <span asp-validation-for="DisplayOrder" class="af-error"></span>
                    </div>

                    <div class="col-md-8">
                        <div class="field-check">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveCheck" />
                                <label class="form-check-label" for="isActiveCheck">Active (available in product creation flow)</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="af-label">Description / Instructions</label>
                        <textarea asp-for="Description" class="af-input" rows="3" placeholder="Brief description of operations carried out during this process…"></textarea>
                        <span asp-validation-for="Description" class="af-error"></span>
                    </div>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Process</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
