@model AashanaFashion.Models.ProcessMaster
@{
    ViewData["Title"] = "Add New Process";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                    <span>➕</span> Add New Process
                </h4>
                <small class="text-muted">Define a new stage in the production workflow and set its sequence order.</small>
            </div>
            <a asp-action="Index" class="btn-af btn-af-ghost">Back to List</a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <div class="af-form-group mb-0">
                                <label asp-for="ProcessName" class="af-label fw-bold">Process Name <span class="text-danger">*</span></label>
                                <input asp-for="ProcessName" class="af-input" placeholder="e.g. Cutting, Dying, Handwork, Stitching" required />
                                <span asp-validation-for="ProcessName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group mb-0">
                                <label asp-for="ProcessCode" class="af-label fw-bold">Process Code</label>
                                <input asp-for="ProcessCode" class="af-input text-uppercase font-monospace" placeholder="e.g. CUT, DYE, STITCH" maxlength="30" />
                                <span asp-validation-for="ProcessCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="af-form-group mb-0">
                                <label asp-for="DisplayOrder" class="af-label fw-bold">Sequence Order <span class="text-danger">*</span></label>
                                <input asp-for="DisplayOrder" class="af-input" type="number" min="1" step="1" required />
                                <small class="text-muted" style="font-size:0.75rem;">Determines position in the Creation Flow pipeline (1 = first step).</small>
                                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-8 d-flex align-items-center pt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveCheck" />
                                <label class="form-check-label fw-bold text-dark" for="isActiveCheck">
                                    Active (Available in Product Creation Flow)
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="af-form-group mb-0">
                                <label asp-for="Description" class="af-label fw-bold">Description / Instructions</label>
                                <textarea asp-for="Description" class="af-input" rows="3" placeholder="Brief description of operations carried out during this process..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
                        <button type="submit" class="btn-af btn-af-primary">Save Process</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
