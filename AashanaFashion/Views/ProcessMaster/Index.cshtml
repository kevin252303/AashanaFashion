@model List<AashanaFashion.Models.ProcessMaster>
@{
    ViewData["Title"] = "Process Master";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdminOrManager = userRole == "Admin" || userRole == "SuperAdmin" || userRole == "Manager" || userRole == "System Admin";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
            <span>🔄</span> Process Master & Workflow Sequence
        </h4>
        <small class="text-muted">Define production process steps and their sequence. Products will inherit this order-wise creation flow.</small>
    </div>
    @if (isAdminOrManager)
    {
        <a asp-action="Create" class="btn-af btn-af-primary">
            <span>➕</span> Add New Process
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 px-3 small mb-3" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-3" style="border-left: 4px solid #3b82f6 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Processes</div>
                    <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalProcesses ?? Model.Count)</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle fs-5">⚙️</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-3" style="border-left: 4px solid #10b981 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Active In Workflow</div>
                    <div class="fs-4 fw-bold text-success">@(ViewBag.ActiveCount ?? Model.Count(m => m.IsActive))</div>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-2 rounded-circle fs-5">✅</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-3" style="border-left: 4px solid #6b7280 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Inactive Processes</div>
                    <div class="fs-4 fw-bold text-secondary">@(ViewBag.InactiveCount ?? Model.Count(m => !m.IsActive))</div>
                </div>
                <div class="bg-secondary bg-opacity-10 text-secondary p-2 rounded-circle fs-5">⏸️</div>
            </div>
        </div>
    </div>
</div>

<!-- Live Workflow Pipeline Preview -->
<div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body p-3">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <span>⚡</span> Current Standard Creation Flow (In Sequence)
            </h6>
            <span class="badge bg-secondary">Auto-sequenced by Order</span>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 p-2 bg-white rounded border">
            @{
                var activeProcesses = Model.Where(p => p.IsActive).OrderBy(p => p.DisplayOrder).ToList();
            }
            @if (activeProcesses.Any())
            {
                for (int i = 0; i < activeProcesses.Count; i++)
                {
                    var proc = activeProcesses[i];
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2">
                            <span class="badge bg-white text-primary rounded-circle" style="width:20px;height:20px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;">@proc.DisplayOrder</span>
                            @proc.ProcessName
                            @if (!string.IsNullOrEmpty(proc.ProcessCode))
                            {
                                <small class="text-white-50">(@proc.ProcessCode)</small>
                            }
                        </span>
                        @if (i < activeProcesses.Count - 1)
                        {
                            <span class="text-muted fw-bold fs-5">➔</span>
                        }
                    </div>
                }
            }
            else
            {
                <span class="text-muted small">No active processes configured yet.</span>
            }
        </div>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0">🔍</span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by process name, code, description..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check form-switch mt-1">
                    <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnlyCheck" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()" />
                    <label class="form-check-label small fw-semibold" for="activeOnlyCheck">Active processes only</label>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button type="submit" class="btn-af btn-af-primary btn-af-sm">Filter</button>
                <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:110px;" class="text-center">Sequence Order</th>
                        <th style="width:100px;" class="text-center">Reorder</th>
                        <th>Process Name</th>
                        <th style="width:130px;">Process Code</th>
                        <th>Description</th>
                        <th style="width:110px;" class="text-center">Status</th>
                        <th style="width:160px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            bool isFirst = (i == 0);
                            bool isLast = (i == Model.Count - 1);

                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-dark bg-opacity-75 fs-6 px-3 py-1 font-monospace">#@item.DisplayOrder</span>
                                </td>
                                <td class="text-center">
                                    @if (isAdminOrManager)
                                    {
                                        <div class="btn-group btn-group-sm" role="group">
                                            <form asp-action="MoveUp" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Move Up in sequence" @(isFirst ? "disabled" : "")>
                                                    ▲
                                                </button>
                                            </form>
                                            <form asp-action="MoveDown" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Move Down in sequence" @(isLast ? "disabled" : "")>
                                                    ▼
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.ProcessName</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProcessCode))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@item.ProcessCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="text-center">
                                    @if (isAdminOrManager)
                                    {
                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent" title="Click to toggle status">
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (isAdminOrManager)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-0 px-2 me-1" title="Edit Process">
                                            ✏️ Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete process \'@item.ProcessName\'?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete Process">
                                                🗑️
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <em>No processes found matching your criteria.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
