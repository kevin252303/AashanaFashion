@model List<AashanaFashion.Models.ProcessMaster>
@{
    ViewData["Title"] = "Process Master";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdminOrManager = userRole == "Admin" || userRole == "SuperAdmin" || userRole == "Manager" || userRole == "System Admin";
    var activeProcesses = Model.Where(p => p.IsActive).OrderBy(p => p.DisplayOrder).ToList();
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ActiveOnly == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Process Master &amp; Workflow Sequence</h1>
        <p class="page-sub">Define production process steps and their sequence. Products inherit this order-wise creation flow.</p>
    </div>
    @if (isAdminOrManager)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Process</a>
        </div>
    }
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total processes</div>
        <div class="metric-value">@(ViewBag.TotalProcesses ?? Model.Count)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Active in workflow</div>
        <div class="metric-value">@(ViewBag.ActiveCount ?? Model.Count(m => m.IsActive))</div>
        <div class="metric-meta success">used for new lots</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Inactive</div>
        <div class="metric-value">@(ViewBag.InactiveCount ?? Model.Count(m => !m.IsActive))</div>
        <div class="metric-meta">skipped in the flow</div>
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-header">
        <span class="data-card-title">Current standard creation flow</span>
        <span class="af-badge b-gray">Auto-sequenced by order</span>
    </div>
    <div class="data-card-body">
        @if (activeProcesses.Any())
        {
            <div class="flow">
                @for (int i = 0; i < activeProcesses.Count; i++)
                {
                    var proc = activeProcesses[i];
                    <span class="flow-step">
                        <span class="flow-num">@proc.DisplayOrder</span>
                        @proc.ProcessName
                        @if (!string.IsNullOrEmpty(proc.ProcessCode))
                        {
                            <span class="flow-code">@proc.ProcessCode</span>
                        }
                    </span>
                    @if (i < activeProcesses.Count - 1)
                    {
                        <i class="bi bi-chevron-right flow-sep"></i>
                    }
                }
            </div>
        }
        else
        {
            <span class="text-muted text-sm">No active processes configured yet.</span>
        }
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" class="af-input" placeholder="Search process name, code, description…" />
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnlyCheck" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="activeOnlyCheck">Active processes only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width:90px;">Sequence</th>
                        @if (isAdminOrManager)
                        {
                            <th style="width:90px;">Reorder</th>
                        }
                        <th>Process</th>
                        <th style="width:130px;">Code</th>
                        <th>Description</th>
                        <th style="width:110px;">Status</th>
                        <th class="text-end" style="width:110px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        bool isFirst = (i == 0);
                        bool isLast = (i == Model.Count - 1);

                        <tr>
                            <td><span class="mono-id">#@item.DisplayOrder</span></td>
                            @if (isAdminOrManager)
                            {
                                <td>
                                    <div class="row-actions">
                                        <form asp-action="MoveUp" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action" title="Move up in sequence" aria-label="Move up" @(isFirst ? "disabled" : "")><i class="bi bi-arrow-up"></i></button>
                                        </form>
                                        <form asp-action="MoveDown" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action" title="Move down in sequence" aria-label="Move down" @(isLast ? "disabled" : "")><i class="bi bi-arrow-down"></i></button>
                                        </form>
                                    </div>
                                </td>
                            }
                            <td><span class="cell-title">@item.ProcessName</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProcessCode))
                                {
                                    <span class="mono-id">@item.ProcessCode</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td>
                                <span class="af-badge @(item.IsActive ? "b-green" : "b-gray")">@(item.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td class="cell-actions">
                                @if (isAdminOrManager)
                                {
                                    <div class="row-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit process" aria-label="Edit process"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action @(item.IsActive ? "warning" : "success")" title="@(item.IsActive ? "Deactivate" : "Activate")" aria-label="@(item.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete process \'@item.ProcessName\'?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action danger" title="Delete process" aria-label="Delete process"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count</strong> @(Model.Count == 1 ? "process" : "processes")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-diagram-3")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No processes yet")</div>
            <p>@(filtered ? "No processes match your criteria." : "Add production steps such as Dying, Handwork and Stitching.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (isAdminOrManager)
            {
                <a asp-action="Create" class="btn btn-secondary">Add New Process</a>
            }
        </div>
    }
</div>
