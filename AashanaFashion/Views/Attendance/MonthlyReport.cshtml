@model IEnumerable<AashanaFashion.Models.Employee>
@{
    ViewData["Title"] = "Monthly Attendance Matrix";
    int curYear = ViewBag.Year;
    int curMonth = ViewBag.Month;
    int daysInMonth = ViewBag.DaysInMonth;
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string currentDept = ViewBag.Department ?? "";
    var records = ViewBag.Records as List<AashanaFashion.Models.AttendanceRecord> ?? new();
    string monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(curMonth);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Monthly Attendance Matrix</h1>
        <p class="page-sub">Day-by-day attendance grid for @monthName @curYear.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-calendar3"></i> Daily register</a>
        <a asp-controller="Salary" asp-action="Index" class="btn btn-secondary"><i class="bi bi-cash-stack"></i> Payroll</a>
        <button type="button" onclick="window.print()" class="btn btn-secondary"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="mrSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="mrSearch" name="search" value="@ViewBag.Search" placeholder="Code, name…" class="af-input" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="mrMonth">Month</label>
                <select id="mrMonth" name="month" class="af-input af-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == curMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="mrYear">Year</label>
                <select id="mrYear" name="year" class="af-input af-select" style="min-width: 100px;">
                    @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == curYear)">@y</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="mrDept">Department</label>
                <select id="mrDept" name="department" class="af-input af-select">
                    <option value="">All departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == currentDept)">@d</option>
                    }
                </select>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="MonthlyReport" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    <div class="data-card-header">
        <div class="legend">
            <span><span class="att-cell p">P</span> Present</span>
            <span><span class="att-cell l">L</span> Late</span>
            <span><span class="att-cell h">H</span> Half day</span>
            <span><span class="att-cell a">A</span> Absent</span>
            <span><span class="att-cell a-implied">A</span> No punch</span>
            <span><span class="att-cell off">–</span> Sunday</span>
        </div>
    </div>

    <div class="table-scroll">
        <table class="af-table att-grid">
            <thead>
                <tr>
                    <th style="min-width: 180px;">Employee</th>
                    <th style="min-width: 90px;">Dept</th>
                    @for (int d = 1; d <= daysInMonth; d++)
                    {
                        var dayDate = new DateTime(curYear, curMonth, d);
                        var isSun = dayDate.DayOfWeek == DayOfWeek.Sunday;
                        <th class="@(isSun ? "is-sunday" : "")" style="min-width: 30px;">
                            <span class="att-day">@d</span>
                            <span class="att-dow">@dayDate.ToString("ddd")[0]</span>
                        </th>
                    }
                    <th style="min-width: 54px;">Days</th>
                    <th style="min-width: 58px;">Hours</th>
                    <th style="min-width: 50px;">OT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    var empRecords = records.Where(r => r.EmployeeId == emp.Id).ToList();
                    decimal presentDays = 0;
                    decimal totalHours = 0;
                    decimal overtimeHours = 0;

                    <tr>
                        <td class="text-truncate" style="max-width: 200px;">
                            <a asp-controller="Employee" asp-action="Edit" asp-route-id="@emp.Id" class="cell-title text-reset">@emp.FullName</a>
                            <span class="cell-sub font-monospace">@emp.EmployeeCode</span>
                        </td>
                        <td class="text-muted text-xs">@emp.Department</td>

                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            var date = new DateTime(curYear, curMonth, d);
                            var isSunday = date.DayOfWeek == DayOfWeek.Sunday;
                            var rec = empRecords.FirstOrDefault(r => r.Date.Day == d);

                            if (rec != null)
                            {
                                totalHours += rec.TotalHours;
                                overtimeHours += rec.OvertimeHours;

                                if (rec.Status == AashanaFashion.Models.AttendanceStatus.Present)
                                {
                                    presentDays += 1;
                                    <td class="@(isSunday ? "is-sunday" : "")"><span class="att-cell p" title="In: @rec.CheckInTime.ToString("hh:mm tt")">P</span></td>
                                }
                                else if (rec.Status == AashanaFashion.Models.AttendanceStatus.Late)
                                {
                                    presentDays += 1;
                                    <td class="@(isSunday ? "is-sunday" : "")"><span class="att-cell l" title="Late: @rec.CheckInTime.ToString("hh:mm tt")">L</span></td>
                                }
                                else if (rec.Status == AashanaFashion.Models.AttendanceStatus.HalfDay)
                                {
                                    presentDays += 0.5m;
                                    <td class="@(isSunday ? "is-sunday" : "")"><span class="att-cell h" title="Half day (@rec.TotalHours hrs)">H</span></td>
                                }
                                else
                                {
                                    <td class="@(isSunday ? "is-sunday" : "")"><span class="att-cell a">A</span></td>
                                }
                            }
                            else if (isSunday)
                            {
                                <td class="is-sunday"><span class="att-cell off">–</span></td>
                            }
                            else if (date <= DateTime.Today)
                            {
                                <td><span class="att-cell a-implied" title="No punch recorded">A</span></td>
                            }
                            else
                            {
                                <td><span class="att-cell off">·</span></td>
                            }
                        }

                        <td class="att-total text-success">@presentDays</td>
                        <td class="att-total">@Math.Round(totalHours, 1)</td>
                        <td class="att-total text-muted">@Math.Round(overtimeHours, 1)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
