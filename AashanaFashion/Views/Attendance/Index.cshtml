@model IEnumerable<AashanaFashion.Models.Employee>
@{
    ViewData["Title"] = "Daily Attendance Register";
    var targetDate = (DateTime)ViewBag.TargetDate;
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string currentDept = ViewBag.Department ?? "";
    var recordDict = ViewBag.RecordDict as Dictionary<int, AashanaFashion.Models.AttendanceRecord> ?? new();

    int totalEmployees = ViewBag.TotalEmployees ?? 0;
    int presentCount = ViewBag.PresentCount ?? 0;
    int halfDayCount = ViewBag.HalfDayCount ?? 0;
    int lateCount = ViewBag.LateCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold">📅 Daily Attendance Register</h2>
        <p class="text-muted mb-0">Floor attendance records, clock in/out timestamps, and working hours.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Kiosk" class="btn btn-primary">
            📷 Open Face Scanner Kiosk
        </a>
        <a asp-action="MonthlyReport" class="btn btn-outline-secondary">
            📊 Monthly Matrix
        </a>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#manualPunchModal">
            ➕ Manual Entry
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show af-alert mb-4" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show af-alert mb-4" role="alert">
        <span>⚠️ @TempData["Error"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}

<!-- Metrics Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3">
            <span class="text-muted small text-uppercase">Total Active</span>
            <h3 class="fw-bold my-1 text-dark">@totalEmployees</h3>
            <small class="text-muted">Staff & Workers</small>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3 border-start border-success border-4">
            <span class="text-muted small text-uppercase">Present</span>
            <h3 class="fw-bold my-1 text-success">@presentCount</h3>
            <small class="text-muted">Full Shift</small>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3 border-start border-info border-4">
            <span class="text-muted small text-uppercase">Late Arrival</span>
            <h3 class="fw-bold my-1 text-info">@lateCount</h3>
            <small class="text-muted">After 9:30 AM</small>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3 border-start border-warning border-4">
            <span class="text-muted small text-uppercase">Half Day</span>
            <h3 class="fw-bold my-1 text-warning">@halfDayCount</h3>
            <small class="text-muted">&lt; 4 Hours</small>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3 border-start border-danger border-4">
            <span class="text-muted small text-uppercase">Absent</span>
            <h3 class="fw-bold my-1 text-danger">@absentCount</h3>
            <small class="text-muted">No Punch Recorded</small>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-3 text-center p-3 bg-light">
            <span class="text-muted small text-uppercase">Attendance %</span>
            <h3 class="fw-bold my-1 text-primary">
                @(totalEmployees > 0 ? Math.Round(((decimal)(presentCount + lateCount) / totalEmployees) * 100, 1) : 0)%
            </h3>
            <small class="text-muted">Turnout Rate</small>
        </div>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="small text-muted fw-semibold">Select Date:</label>
                <input type="date" name="date" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
            </div>
            <div class="col-md-4">
                <label class="small text-muted fw-semibold">Department:</label>
                <select name="department" class="form-select" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == currentDept)">@d</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary w-100">
                    Today
                </a>
                <a asp-action="Index" asp-route-date="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" class="btn btn-outline-secondary w-100">
                    Yesterday
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Register Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
            📋 Attendance for @targetDate.ToString("dddd, dd MMMM yyyy")
        </h5>
        <span class="badge bg-light text-dark border">@Model.Count() Employees</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Employee</th>
                    <th>Code & Dept</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Hours Worked</th>
                    <th>Overtime</th>
                    <th>Status</th>
                    <th>Verification</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            No employees found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        var hasRecord = recordDict.TryGetValue(emp.Id, out var rec);
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    @if (hasRecord && !string.IsNullOrEmpty(rec!.CheckInPhoto))
                                    {
                                        <img src="@rec.CheckInPhoto" class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover;" title="Snapshot at Punch In" />
                                    }
                                    else if (!string.IsNullOrEmpty(emp.FacePhotoPath))
                                    {
                                        <img src="@emp.FacePhotoPath" class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-muted fw-bold" style="width: 38px; height: 38px;">
                                            @(emp.FullName.Length > 0 ? emp.FullName[0].ToString() : "E")
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@emp.FullName</div>
                                        <small class="text-muted">@emp.Designation</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="font-monospace fw-semibold">@emp.EmployeeCode</div>
                                <small class="text-muted">@emp.Department</small>
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    <span class="fw-bold text-success font-monospace">@rec!.CheckInTime.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord && rec!.CheckOutTime.HasValue)
                                {
                                    <span class="fw-bold text-primary font-monospace">@rec.CheckOutTime.Value.ToString("hh:mm tt")</span>
                                }
                                else if (hasRecord)
                                {
                                    <span class="badge bg-warning-subtle text-warning">Working (In)</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord && rec!.TotalHours > 0)
                                {
                                    <span class="fw-bold">@rec.TotalHours hrs</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord && rec!.OvertimeHours > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        +@rec.OvertimeHours hrs OT
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">0 hrs</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    switch (rec!.Status)
                                    {
                                        case AashanaFashion.Models.AttendanceStatus.Present:
                                            <span class="badge bg-success">Present</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.Late:
                                            <span class="badge bg-info text-dark">Late</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.HalfDay:
                                            <span class="badge bg-warning text-dark">Half Day</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.Absent:
                                            <span class="badge bg-danger">Absent</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.OnLeave:
                                            <span class="badge bg-secondary">On Leave</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@rec.Status</span>
                                            break;
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Absent</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    if (rec!.VerificationMethod == AashanaFashion.Models.VerificationMethod.FaceScan)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-inline-flex align-items-center gap-1">
                                            <span>📷</span> Face Scan @(rec.FaceConfidence.HasValue ? $"({Math.Round(rec.FaceConfidence.Value)}%)" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">
                                            ✍️ @rec.VerificationMethod
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <button type="button" class="btn btn-sm btn-outline-secondary btnEditPunch"
                                        data-emp-id="@emp.Id"
                                        data-emp-name="@emp.FullName"
                                        data-in-time="@(hasRecord ? rec!.CheckInTime.ToString("HH:mm") : "09:00")"
                                        data-out-time="@(hasRecord && rec!.CheckOutTime.HasValue ? rec.CheckOutTime.Value.ToString("HH:mm") : "")"
                                        data-status="@(hasRecord ? rec!.Status.ToString() : "Present")"
                                        data-notes="@(hasRecord ? rec!.Notes : "")">
                                    ✏️ Edit
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Manual Entry / Correction Modal -->
<div class="modal fade" id="manualPunchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="ManualPunch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title fw-bold">✍️ Manual Attendance Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                    <select name="EmployeeId" id="modalEmployeeId" class="form-select" required>
                        <option value="">Select Employee...</option>
                        @foreach (var emp in Model)
                        {
                            <option value="@emp.Id">@emp.EmployeeCode — @emp.FullName (@emp.Department)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                    <input type="date" name="Date" id="modalDate" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Check In Time <span class="text-danger">*</span></label>
                        <input type="time" name="CheckInTime" id="modalCheckInTime" value="09:00" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Check Out Time</label>
                        <input type="time" name="CheckOutTime" id="modalCheckOutTime" value="18:00" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Attendance Status</label>
                    <select name="Status" id="modalStatus" class="form-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.AttendanceStatus>()">
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Remarks / Reason</label>
                    <input type="text" name="Notes" id="modalNotes" placeholder="e.g. Approved shift override" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Attendance</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $('.btnEditPunch').on('click', function () {
            const btn = $(this);
            $('#modalEmployeeId').val(btn.data('emp-id'));
            $('#modalCheckInTime').val(btn.data('in-time'));
            $('#modalCheckOutTime').val(btn.data('out-time') || '');
            $('#modalStatus').val(btn.data('status'));
            $('#modalNotes').val(btn.data('notes'));
            $('#manualPunchModal').modal('show');
        });
    </script>
}
