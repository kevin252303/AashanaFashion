@model IEnumerable<AashanaFashion.Models.Employee>
@{
    ViewData["Title"] = "Daily Attendance Register";
    var targetDate = (DateTime)ViewBag.TargetDate;
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    string currentDept = ViewBag.Department ?? "";
    var recordDict = ViewBag.RecordDict as Dictionary<int, AashanaFashion.Models.AttendanceRecord> ?? new();

    int totalEmployees = ViewBag.TotalEmployees ?? 0;
    int presentCount = ViewBag.PresentCount ?? 0;
    int halfDayCount = ViewBag.HalfDayCount ?? 0;
    int lateCount = ViewBag.LateCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Daily Attendance Register</h1>
        <p class="page-sub">Floor attendance records, clock in/out timestamps, and working hours.</p>
    </div>
    <div class="page-actions">
        <a asp-action="MonthlyReport" class="btn btn-secondary"><i class="bi bi-calendar3"></i> Monthly matrix</a>
        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#manualPunchModal"><i class="bi bi-plus-lg"></i> Manual entry</button>
        <a asp-action="Kiosk" class="btn btn-primary"><i class="bi bi-camera"></i> Open face kiosk</a>
    </div>
</div>

<div class="metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
    <div class="metric-card">
        <div class="metric-label">Total active</div>
        <div class="metric-value">@totalEmployees</div>
        <div class="metric-meta">staff &amp; workers</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Present</div>
        <div class="metric-value">@presentCount</div>
        <div class="metric-meta success">full shift</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Late arrival</div>
        <div class="metric-value">@lateCount</div>
        <div class="metric-meta info">after 9:30 AM</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Half day</div>
        <div class="metric-value">@halfDayCount</div>
        <div class="metric-meta warning">&lt; 4 hours</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Absent</div>
        <div class="metric-value">@absentCount</div>
        <div class="metric-meta danger">no punch recorded</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Attendance</div>
        <div class="metric-value">@(totalEmployees > 0 ? Math.Round(((decimal)(presentCount + lateCount) / totalEmployees) * 100, 1) : 0)%</div>
        <div class="metric-meta">turnout rate</div>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="atSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="atSearch" name="search" value="@ViewBag.Search" placeholder="Code, name…" class="af-input" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="atDate">Date</label>
                <input type="date" id="atDate" name="date" value="@targetDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
            <div class="toolbar-field">
                <label for="atDept">Department</label>
                <select id="atDept" name="department" class="af-input af-select">
                    <option value="">All departments</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d" selected="@(d == currentDept)">@d</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="atStatus">Status</label>
                <select id="atStatus" name="status" class="af-input af-select">
                    <option value="">All statuses</option>
                    @foreach (AashanaFashion.Models.AttendanceStatus st in Enum.GetValues(typeof(AashanaFashion.Models.AttendanceStatus)))
                    {
                        <option value="@st" selected="@(ViewBag.Status != null && (AashanaFashion.Models.AttendanceStatus)ViewBag.Status == st)">@st.Humanize()</option>
                    }
                </select>
            </div>
            <div class="segmented" role="group" aria-label="Quick dates">
                <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="segment @(targetDate.Date == DateTime.Today ? "active" : "")">Today</a>
                <a asp-action="Index" asp-route-date="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" class="segment @(targetDate.Date == DateTime.Today.AddDays(-1) ? "active" : "")">Yesterday</a>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" class="btn btn-ghost" title="Reset">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    <div class="data-card-header">
        <span class="data-card-title">Attendance for @targetDate.ToString("dddd, dd MMMM yyyy")</span>
        <span class="count-pill">@Model.Count()</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-people"></i></div>
            <div class="es-title">No employees found</div>
            <p>Try another department or clear the search.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Code &amp; Dept</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th class="text-end">Hours</th>
                        <th>Overtime</th>
                        <th>Status</th>
                        <th>Verification</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        var hasRecord = recordDict.TryGetValue(emp.Id, out var rec);
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (hasRecord && !string.IsNullOrEmpty(rec!.CheckInPhoto))
                                    {
                                        <img src="@rec.CheckInPhoto" class="thumb rounded-circle" style="width:36px;height:36px;" title="Snapshot at punch in" alt="" />
                                    }
                                    else if (!string.IsNullOrEmpty(emp.FacePhotoPath))
                                    {
                                        <img src="@emp.FacePhotoPath" class="thumb rounded-circle" style="width:36px;height:36px;" alt="" />
                                    }
                                    else
                                    {
                                        <span class="u-avatar avatar-lg" style="width:36px;height:36px;">@(emp.FullName.Length > 0 ? emp.FullName[0].ToString() : "E")</span>
                                    }
                                    <div>
                                        <span class="cell-title">@emp.FullName</span>
                                        <span class="cell-sub">@emp.Designation</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="mono-id">@emp.EmployeeCode</span>
                                <span class="cell-sub">@emp.Department</span>
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    <span class="text-foreground fw-medium tabular">@rec!.CheckInTime.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord && rec!.CheckOutTime.HasValue)
                                {
                                    <span class="text-foreground fw-medium tabular">@rec.CheckOutTime.Value.ToString("hh:mm tt")</span>
                                }
                                else if (hasRecord)
                                {
                                    <span class="af-badge b-blue"><span class="status-dot info"></span> Working</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="cell-num">
                                @if (hasRecord && rec!.TotalHours > 0)
                                {
                                    <span class="text-foreground">@rec.TotalHours hrs</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord && rec!.OvertimeHours > 0)
                                {
                                    <span class="af-badge b-green">+@rec.OvertimeHours hrs OT</span>
                                }
                                else
                                {
                                    <span class="text-muted text-xs">0 hrs</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    switch (rec!.Status)
                                    {
                                        case AashanaFashion.Models.AttendanceStatus.Present:
                                            <span class="af-badge b-green">Present</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.Late:
                                            <span class="af-badge b-blue">Late</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.HalfDay:
                                            <span class="af-badge b-yellow">Half day</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.Absent:
                                            <span class="af-badge b-red">Absent</span>
                                            break;
                                        case AashanaFashion.Models.AttendanceStatus.OnLeave:
                                            <span class="af-badge b-gray">On leave</span>
                                            break;
                                        default:
                                            <span class="af-badge b-gray">@rec.Status.Humanize()</span>
                                            break;
                                    }
                                }
                                else
                                {
                                    <span class="af-badge b-red">Absent</span>
                                }
                            </td>
                            <td>
                                @if (hasRecord)
                                {
                                    if (rec!.VerificationMethod == AashanaFashion.Models.VerificationMethod.FaceScan)
                                    {
                                        <span class="af-badge b-indigo"><i class="bi bi-person-bounding-box"></i> Face @(rec.FaceConfidence.HasValue ? $"{Math.Round(rec.FaceConfidence.Value)}%" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="tag">@rec.VerificationMethod.Humanize()</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <button type="button" class="row-action btnEditPunch" title="Edit attendance" aria-label="Edit attendance"
                                        data-emp-id="@emp.Id"
                                        data-emp-name="@emp.FullName"
                                        data-in-time="@(hasRecord ? rec!.CheckInTime.ToString("HH:mm") : "09:00")"
                                        data-out-time="@(hasRecord && rec!.CheckOutTime.HasValue ? rec.CheckOutTime.Value.ToString("HH:mm") : "")"
                                        data-status="@(hasRecord ? rec!.Status.ToString() : "Present")"
                                        data-notes="@(hasRecord ? rec!.Notes : "")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Manual Entry / Correction Modal -->
<div class="modal fade" id="manualPunchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="ManualPunch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Manual Attendance Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Employee <span class="req">*</span></label>
                    <select name="EmployeeId" id="modalEmployeeId" class="form-select" required>
                        <option value="">Select Employee...</option>
                        @foreach (var emp in Model)
                        {
                            <option value="@emp.Id">@emp.EmployeeCode — @emp.FullName (@emp.Department)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Date <span class="req">*</span></label>
                    <input type="date" name="Date" id="modalDate" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Check In Time <span class="req">*</span></label>
                        <input type="time" name="CheckInTime" id="modalCheckInTime" value="09:00" class="form-control" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Check Out Time</label>
                        <input type="time" name="CheckOutTime" id="modalCheckOutTime" value="18:00" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Attendance Status</label>
                    <select name="Status" id="modalStatus" class="form-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.AttendanceStatus>()">
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Remarks / Reason</label>
                    <input type="text" name="Notes" id="modalNotes" placeholder="e.g. Approved shift override" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Attendance</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $('.btnEditPunch').on('click', function () {
            const btn = $(this);
            $('#modalEmployeeId').val(btn.data('emp-id'));
            $('#modalCheckInTime').val(btn.data('in-time'));
            $('#modalCheckOutTime').val(btn.data('out-time') || '');
            $('#modalStatus').val(btn.data('status'));
            $('#modalNotes').val(btn.data('notes'));
            $('#manualPunchModal').modal('show');
        });
    </script>
}
