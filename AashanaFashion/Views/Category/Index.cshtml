@model IEnumerable<AashanaFashion.Models.ProductCategory>
@{
    ViewData["Title"] = "Category Master";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    bool canCreate = isAdmin || User.HasClaim("Permission.DesignMaster.CanCreate", "true");
    bool canEdit   = isAdmin || User.HasClaim("Permission.DesignMaster.CanEdit",   "true");
    bool canDelete = isAdmin || User.HasClaim("Permission.DesignMaster.CanDelete", "true");

    var activeCount = Model.Count(c => c.IsActive);
    var totalProducts = Model.Sum(c => c.Products?.Count ?? 0);
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ActiveOnly == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Category Master</h1>
        <p class="page-sub">Classify garments and products for catalogue navigation, pricing rules, and GST rates</p>
    </div>
    @if (canCreate)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Category</a>
        </div>
    }
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total categories</div>
        <div class="metric-value">@Model.Count()</div>
        <div class="metric-meta success">@activeCount active</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Linked products</div>
        <div class="metric-value">@totalProducts</div>
        <div class="metric-meta">designs across all categories</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Default tax slabs</div>
        <div class="metric-value">5% / 12%</div>
        <div class="metric-meta">GST standards for apparel</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search name, code, HSN…" value="@ViewBag.Search" />
            </div>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" id="activeOnly" value="true" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="activeOnly">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 28%;">Category</th>
                        <th>Code</th>
                        <th>Parent</th>
                        <th>HSN/SAC</th>
                        <th>GST Rate</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var prodCount = item.Products?.Count ?? 0;
                        <tr>
                            <td>
                                <span class="cell-title">@item.CategoryName</span>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="cell-sub text-truncate" style="max-width: 280px;">@item.Description</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CategoryCode))
                                {
                                    <span class="mono-id">@item.CategoryCode</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                @if (item.ParentCategory != null)
                                {
                                    <span class="tag"><i class="bi bi-folder2 text-placeholder"></i> @item.ParentCategory.CategoryName</span>
                                }
                                else
                                {
                                    <span class="text-muted text-xs">Top level</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.DefaultHsnCode))
                                {
                                    <span class="font-monospace text-xs">@item.DefaultHsnCode</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                @if (item.DefaultGstRate.HasValue)
                                {
                                    <span class="tabular">@item.DefaultGstRate.Value.ToString("0.##")%</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Design" asp-action="Index" class="count-pill @(prodCount > 0 ? "text-primary" : "")" title="View products">@prodCount</a>
                            </td>
                            <td>
                                <span class="af-badge @(item.IsActive ? "b-green" : "b-gray")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit category" aria-label="Edit category"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action @(item.IsActive ? "warning" : "success")" title="@(item.IsActive ? "Deactivate" : "Activate")" aria-label="@(item.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action danger" onclick="return confirm('Are you sure you want to delete category \'@item.CategoryName\'?');" title="Delete category" aria-label="Delete category">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "category" : "categories")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-folder2")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No categories yet")</div>
            <p>@(filtered ? "No categories match your search. Try adjusting the filters." : "Create a category to group designs and set default HSN and GST rates.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">New Category</a>
            }
        </div>
    }
</div>
