@model AashanaFashion.Models.ProductCategory
@{
    ViewData["Title"] = "New Category";
    var parents = (List<AashanaFashion.Models.ProductCategory>?)ViewBag.ParentCategories ?? new List<AashanaFashion.Models.ProductCategory>();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Categories</a>
        <h1 class="page-title">New Product Category</h1>
        <p class="page-sub">Define a category for organizing garments and setting tax &amp; pricing defaults</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Create" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-header">
                <span class="data-card-title">Category information</span>
            </div>
            <div class="data-card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="CategoryName" class="af-label">Category Name <span class="req">*</span></label>
                        <input asp-for="CategoryName" class="af-input" placeholder="e.g. Kurtis, Sarees, Lehengas" required />
                        <span asp-validation-for="CategoryName" class="af-error"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoryCode" class="af-label">Short Code</label>
                        <input asp-for="CategoryCode" class="af-input text-uppercase font-monospace" placeholder="e.g. KRT" maxlength="10" />
                        <span asp-validation-for="CategoryCode" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ParentCategoryId" class="af-label">Parent Category</label>
                        <select asp-for="ParentCategoryId" class="af-input af-select">
                            <option value="">None (top-level category)</option>
                            @foreach (var parent in parents)
                            {
                                <option value="@parent.Id">@parent.CategoryName</option>
                            }
                        </select>
                        <span class="af-hint">Use for hierarchical grouping (e.g. Ethnic Wear → Kurtis).</span>
                        <span asp-validation-for="ParentCategoryId" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DefaultHsnCode" class="af-label">Default HSN/SAC Code</label>
                        <input asp-for="DefaultHsnCode" class="af-input font-monospace" placeholder="e.g. 6204, 5208" />
                        <span class="af-hint">Auto-suggested when creating products in this category.</span>
                        <span asp-validation-for="DefaultHsnCode" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DefaultGstRate" class="af-label">Default GST Rate (%)</label>
                        <select asp-for="DefaultGstRate" class="af-input af-select">
                            <option value="5.00">5% (Garments under ₹1,000 / Standard Apparel)</option>
                            <option value="12.00">12% (Garments above ₹1,000 / Luxury Apparel)</option>
                            <option value="18.00">18% (Synthetic / Specialized)</option>
                            <option value="0.00">0% (Nil Rated / Exempt)</option>
                        </select>
                        <span asp-validation-for="DefaultGstRate" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="af-label">Description / Notes</label>
                        <textarea asp-for="Description" class="af-input" rows="3" placeholder="Category notes, style types, or production guidelines…"></textarea>
                        <span asp-validation-for="Description" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" checked />
                            <label class="form-check-label" for="isActiveSwitch">Active category</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Category</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title"><i class="bi bi-lightbulb"></i> How categories are used</span>
            </div>
            <div class="data-card-body">
                <ul class="activity-list">
                    <li class="activity-item">
                        <div class="activity-text"><strong>Product Master</strong> — every design can be assigned a category. Its default HSN and tax rate are auto-suggested.</div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-text"><strong>Pricelist rules</strong> — create pricing rules at category level (e.g. 10% off all <em>Kurtis</em>).</div>
                    </li>
                    <li class="activity-item">
                        <div class="activity-text"><strong>Hierarchy</strong> — subcategories inherit reporting context from their parent while allowing specific product tagging.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
