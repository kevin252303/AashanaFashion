@model AashanaFashion.Models.ProductCategory
@{
    ViewData["Title"] = "Edit Category — " + Model.CategoryName;
    var parents = (List<AashanaFashion.Models.ProductCategory>?)ViewBag.ParentCategories ?? new List<AashanaFashion.Models.ProductCategory>();
    var prodCount = Model.Products?.Count ?? 0;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Categories</a>
        <h1 class="page-title d-flex align-items-center gap-2">
            @Model.CategoryName
            <span class="af-badge @(Model.IsActive ? "b-green" : "b-gray")">@(Model.IsActive ? "Active" : "Inactive")</span>
        </h1>
        <p class="page-sub">Update category details, parent hierarchy, and default tax configuration</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Edit" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            <div class="data-card-header">
                <span class="data-card-title">Category information</span>
            </div>
            <div class="data-card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="CategoryName" class="af-label">Category Name <span class="req">*</span></label>
                        <input asp-for="CategoryName" class="af-input" required />
                        <span asp-validation-for="CategoryName" class="af-error"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CategoryCode" class="af-label">Short Code</label>
                        <input asp-for="CategoryCode" class="af-input text-uppercase font-monospace" maxlength="10" />
                        <span asp-validation-for="CategoryCode" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ParentCategoryId" class="af-label">Parent Category</label>
                        <select asp-for="ParentCategoryId" class="af-input af-select">
                            <option value="">None (top-level category)</option>
                            @foreach (var parent in parents)
                            {
                                <option value="@parent.Id" selected="@(Model.ParentCategoryId == parent.Id)">@parent.CategoryName</option>
                            }
                        </select>
                        <span class="af-hint">Use for hierarchical grouping (e.g. Ethnic Wear → Kurtis).</span>
                        <span asp-validation-for="ParentCategoryId" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DefaultHsnCode" class="af-label">Default HSN/SAC Code</label>
                        <input asp-for="DefaultHsnCode" class="af-input font-monospace" />
                        <span class="af-hint">Auto-suggested when creating products in this category.</span>
                        <span asp-validation-for="DefaultHsnCode" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DefaultGstRate" class="af-label">Default GST Rate (%)</label>
                        <select asp-for="DefaultGstRate" class="af-input af-select">
                            <option value="5.00" selected="@(Model.DefaultGstRate == 5.0m)">5% (Garments under ₹1,000 / Standard Apparel)</option>
                            <option value="12.00" selected="@(Model.DefaultGstRate == 12.0m)">12% (Garments above ₹1,000 / Luxury Apparel)</option>
                            <option value="18.00" selected="@(Model.DefaultGstRate == 18.0m)">18% (Synthetic / Specialized)</option>
                            <option value="0.00" selected="@(Model.DefaultGstRate == 0.0m)">0% (Nil Rated / Exempt)</option>
                        </select>
                        <span asp-validation-for="DefaultGstRate" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="af-label">Description / Notes</label>
                        <textarea asp-for="Description" class="af-input" rows="3"></textarea>
                        <span asp-validation-for="Description" class="af-error"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch" />
                            <label class="form-check-label" for="isActiveSwitch">Active category</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Category</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="data-card mb-4">
            <div class="data-card-header">
                <span class="data-card-title">Linked products <span class="count-pill">@prodCount</span></span>
                @if (prodCount > 0)
                {
                    <a asp-controller="Design" asp-action="Index" class="btn btn-sm btn-ghost">View all <i class="bi bi-arrow-right"></i></a>
                }
            </div>
            @if (prodCount > 0 && Model.Products != null)
            {
                <div style="max-height: 300px; overflow-y: auto;">
                    <table class="af-table">
                        <tbody>
                            @foreach (var prod in Model.Products.Take(10))
                            {
                                <tr>
                                    <td>
                                        <span class="cell-title">@prod.DesignNumber</span>
                                        @if (prod.SalesPrice > 0)
                                        {
                                            <span class="cell-sub">₹@prod.SalesPrice.ToString("N2")</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        <a asp-controller="Design" asp-action="Edit" asp-route-id="@prod.Id" class="row-action" title="Edit product" aria-label="Edit product"><i class="bi bi-pencil"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (prodCount > 10)
                {
                    <div class="data-card-footer">… and @(prodCount - 10) more products</div>
                }
            }
            else
            {
                <div class="empty-state py-4">
                    <div class="es-icon"><i class="bi bi-box-seam"></i></div>
                    <p>No products are linked to this category yet.</p>
                </div>
            }
        </div>

        <div class="af-alert af-alert-info">
            <div class="alert-body">
                <span class="alert-title">Synchronisation</span>
                Renaming this category will update the category name on all <strong>@prodCount</strong> linked design record(s).
            </div>
        </div>
    </div>
</div>
