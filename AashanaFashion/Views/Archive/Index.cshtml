@model List<AashanaFashion.Models.Design>
@{
    ViewData["Title"] = "Archive - Discontinued Items";
    var productStockMap = ViewBag.ProductStockMap as Dictionary<int, int> ?? new();
    var variantItems = ViewBag.VariantItems as List<AashanaFashion.Controllers.ArchiveVariantItemViewModel> ?? new();
    var activeTab = ViewBag.ActiveTab as string ?? "products";
    var currentFilter = ViewBag.Filter as string ?? "";
}

<div class="page-header">
    <div>
        <a asp-controller="Design" asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Active products</a>
        <h1 class="page-title">Archive — Discontinued Catalogue</h1>
        <p class="page-sub">Manage discontinued products &amp; variants, liquidate remaining stock, or restore items</p>
    </div>
    <div class="page-actions">
        <a asp-controller="SalesOrder" asp-action="Create" class="btn btn-primary"><i class="bi bi-bag-plus"></i> Create Sales Order</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Discontinued products</div>
        <div class="metric-value">@ViewBag.TotalProducts</div>
        <div class="metric-meta danger">blocked from new production</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Discontinued variants</div>
        <div class="metric-value">@ViewBag.TotalVariants</div>
        <div class="metric-meta warning">colour / size rules</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Remaining stock (sellable)</div>
        <div class="metric-value">@ViewBag.TotalStock</div>
        <div class="metric-meta success">ready sets, sell until exhausted</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Stock retail value</div>
        <div class="metric-value">₹@(((decimal)ViewBag.TotalStockValue).ToString("N0"))</div>
        <div class="metric-meta">liquidation revenue potential</div>
    </div>
</div>

<ul class="nav nav-tabs" id="archiveTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "products" ? "active" : "")" id="products-tab" data-bs-toggle="tab" data-bs-target="#productsPane" type="button" role="tab">
            Discontinued products <span class="count-pill">@Model.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "variants" ? "active" : "")" id="variants-tab" data-bs-toggle="tab" data-bs-target="#variantsPane" type="button" role="tab">
            Discontinued variants <span class="count-pill">@variantItems.Count</span>
        </button>
    </li>
</ul>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <input type="hidden" name="tab" value="@activeTab" />
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search design number or category…" value="@ViewBag.Search" />
            </div>
            <div class="segmented" role="group" aria-label="Stock filter">
                <a asp-action="Index" asp-route-tab="@activeTab" asp-route-search="@ViewBag.Search" class="segment @(string.IsNullOrEmpty(currentFilter) ? "active" : "")">All items</a>
                <a asp-action="Index" asp-route-tab="@activeTab" asp-route-filter="in_stock" asp-route-search="@ViewBag.Search" class="segment @(currentFilter == "in_stock" ? "active" : "")">With stock</a>
                <a asp-action="Index" asp-route-tab="@activeTab" asp-route-filter="out_of_stock" asp-route-search="@ViewBag.Search" class="segment @(currentFilter == "out_of_stock" ? "active" : "")">Out of stock</a>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" asp-route-tab="@activeTab" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Apply</button>
        </div>
    </form>

    <div class="tab-content" id="archiveTabsContent">

        <!-- TAB 1: WHOLE PRODUCTS -->
        <div class="tab-pane fade @(activeTab == "products" ? "show active" : "")" id="productsPane" role="tabpanel">
            @if (Model.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th style="width: 64px;">Photo</th>
                                <th>Design</th>
                                <th>Category</th>
                                <th class="text-end">Sales Price</th>
                                <th class="text-end">Stock on Hand</th>
                                <th>Stock Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                int stock = productStockMap.GetValueOrDefault(p.Id, 0);
                                var photo = !string.IsNullOrEmpty(p.PhotoPath) ? p.PhotoPath : p.ColourImages?.FirstOrDefault()?.PhotoPath;
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(photo))
                                        {
                                            <img src="@photo" alt="@p.DesignNumber" class="thumb" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                        }
                                        else
                                        {
                                            <div class="thumb d-flex align-items-center justify-content-center text-placeholder"><i class="bi bi-image"></i></div>
                                        }
                                    </td>
                                    <td>
                                        <span class="cell-title">@p.DesignNumber</span>
                                        <span class="cell-sub">Discontinued product</span>
                                    </td>
                                    <td><span class="tag">@(p.ProductCategory?.CategoryName ?? p.Category ?? "Goods")</span></td>
                                    <td class="cell-num">₹@((p.SalesPrice > 0 ? p.SalesPrice : p.Price).ToString("N2"))</td>
                                    <td class="cell-num"><span class="@(stock > 0 ? "text-foreground fw-medium" : "text-muted")">@stock pcs</span></td>
                                    <td>
                                        @if (stock > 0)
                                        {
                                            <span class="af-badge b-green">Available to sell</span>
                                        }
                                        else
                                        {
                                            <span class="af-badge b-gray">Zero stock</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        <div class="row-actions">
                                            @if (stock > 0)
                                            {
                                                <a asp-controller="SalesOrder" asp-action="Create" class="btn btn-sm btn-secondary me-1" title="Sell available stock in a sales order">Sell stock</a>
                                            }
                                            <a asp-controller="Design" asp-action="Edit" asp-route-id="@p.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                            <form asp-action="RestoreProduct" asp-route-id="@p.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="row-action primary" title="Restore to active products" aria-label="Restore" onclick="return confirm('Restore product @p.DesignNumber back to active Product Master?')">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="es-icon"><i class="bi bi-archive"></i></div>
                    <div class="es-title">No discontinued products</div>
                    <p>All products are active.</p>
                </div>
            }
        </div>

        <!-- TAB 2: VARIANT DISCONTINUATIONS -->
        <div class="tab-pane fade @(activeTab == "variants" ? "show active" : "")" id="variantsPane" role="tabpanel">
            @if (variantItems.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th style="width: 64px;">Photo</th>
                                <th>Design</th>
                                <th>Discontinued Variant</th>
                                <th>Reason</th>
                                <th>Date</th>
                                <th class="text-end">Stock on Hand</th>
                                <th>Stock Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in variantItems)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(v.PhotoPath))
                                        {
                                            <img src="@v.PhotoPath" alt="@v.DesignNumber" class="thumb" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                        }
                                        else
                                        {
                                            <div class="thumb d-flex align-items-center justify-content-center text-placeholder"><i class="bi bi-image"></i></div>
                                        }
                                    </td>
                                    <td>
                                        <span class="cell-title">@v.DesignNumber</span>
                                        <span class="cell-sub">@v.CategoryName</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="tag">@(string.IsNullOrEmpty(v.Colour) ? "All colours" : v.Colour)</span>
                                            <span class="text-placeholder">/</span>
                                            <span class="tag">@(string.IsNullOrEmpty(v.Size) ? "All sizes" : v.Size)</span>
                                        </div>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(v.Reason) ? "No reason specified" : v.Reason)</td>
                                    <td class="text-muted text-nowrap">@v.DiscontinuedDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="cell-num"><span class="@(v.QuantityOnHand > 0 ? "text-foreground fw-medium" : "text-muted")">@v.QuantityOnHand pcs</span></td>
                                    <td>
                                        @if (v.QuantityOnHand > 0)
                                        {
                                            <span class="af-badge b-green">Available to sell</span>
                                        }
                                        else
                                        {
                                            <span class="af-badge b-gray">Zero stock</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        <div class="row-actions">
                                            @if (v.QuantityOnHand > 0)
                                            {
                                                <a asp-controller="SalesOrder" asp-action="Create" class="btn btn-sm btn-secondary me-1" title="Sell available stock in a sales order">Sell stock</a>
                                            }
                                            <a asp-controller="Design" asp-action="Edit" asp-route-id="@v.DesignId" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                            <form asp-action="RestoreVariant" asp-route-id="@v.VariantId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="row-action primary" title="Restore variant to active production" aria-label="Restore" onclick="return confirm('Restore this variant back to active production?')">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="es-icon"><i class="bi bi-archive"></i></div>
                    <div class="es-title">No discontinued variants</div>
                    <p>No colour or size variants have been discontinued.</p>
                </div>
            }
        </div>
    </div>
</div>
