@model AashanaFashion.Models.Lead

@{
    ViewData["Title"] = "New Lead";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Leads</a>
        <h1 class="page-title">New lead inquiry</h1>
        <p class="page-sub">Capture customer requirement before generating a quotation or booking a sales order.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-9">
        <form asp-action="Create" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Inquiry details</div>
                    <div class="data-card-sub">Fields marked <span class="req">*</span> are required.</div>
                </div>
            </div>
            <div class="data-card-body">
                <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="LeadNumber" class="form-label">Lead number <span class="req">*</span></label>
                        <input asp-for="LeadNumber" class="af-input font-monospace" readonly />
                        <span asp-validation-for="LeadNumber" class="af-error"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label">Inquiry title <span class="req">*</span></label>
                        <input asp-for="Title" class="af-input" placeholder="e.g. Designer Kurti Order - 500 pcs wholesale" />
                        <span asp-validation-for="Title" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label">Contact person <span class="req">*</span></label>
                        <input asp-for="ContactPerson" class="af-input" placeholder="e.g. Ramesh Patel" />
                        <span asp-validation-for="ContactPerson" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label">Company / Brand name <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="CompanyName" class="af-input" placeholder="e.g. Patel Brothers Retails" />
                        <span asp-validation-for="CompanyName" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone / WhatsApp number</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-whatsapp text-success"></i></span>
                            <input asp-for="Phone" class="af-input" placeholder="e.g. 98250 12345" />
                        </div>
                        <span asp-validation-for="Phone" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email address <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Email" type="email" class="af-input" placeholder="e.g. contact@patelretails.com" />
                        <span asp-validation-for="Email" class="af-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="af-input" placeholder="e.g. Surat" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="af-input" placeholder="e.g. Gujarat" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EstimatedQuantity" class="form-label">Estimated pieces</label>
                        <input asp-for="EstimatedQuantity" type="number" min="0" class="af-input" placeholder="e.g. 500" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EstimatedValue" class="form-label">Estimated value</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="EstimatedValue" type="number" step="0.01" class="af-input" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Source" class="form-label">Lead source</label>
                        <select asp-for="Source" asp-items="ViewBag.Sources" class="af-input af-select">
                            <option value="">Select source</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AssignedToUserId" class="form-label">Assigned salesperson</label>
                        <select asp-for="AssignedToUserId" asp-items="ViewBag.Users" class="af-input af-select">
                            <option value="">Unassigned</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NextFollowUpDate" class="form-label">Next follow-up date</label>
                        <input asp-for="NextFollowUpDate" type="date" class="af-input" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ExpectedCloseDate" class="form-label">Expected close date</label>
                        <input asp-for="ExpectedCloseDate" type="date" class="af-input" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Requirement notes &amp; specifications</label>
                        <textarea asp-for="Notes" rows="3" class="af-input" placeholder="Fabric specifications, target budget, sample requirements…"></textarea>
                    </div>
                </div>

                <div class="form-actions mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save lead</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
