@model AashanaFashion.Models.QcDashboardViewModel
@{
    ViewData["Title"] = "Quality Control Dashboard";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool canCreate = role == "Admin" || role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Quality Control &amp; Rejection Tracking</h1>
        <p class="page-sub">Monitor garment defect rates, stage checkpoints, rework queues, and vendor quality.</p>
    </div>
    <div class="page-actions">
        <a asp-action="ReworkQueue" class="btn btn-secondary">
            <i class="bi bi-arrow-repeat"></i> Rework queue
            @if (Model.ActiveReworkCount > 0)
            {
                <span class="af-badge b-red pill">@Model.ActiveReworkCount</span>
            }
        </a>
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Log QC Inspection</a>
        }
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total inspected</div>
        <div class="metric-value">@Model.TotalUnitsInspected.ToString("N0") <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta">across @Model.TotalInspections inspection logs</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Overall pass rate</div>
        <div class="metric-value">@Model.OverallPassRate%</div>
        <div class="metric-meta @(Model.OverallPassRate >= 95 ? "success" : (Model.OverallPassRate >= 85 ? "warning" : "danger"))">@Model.TotalUnitsPassed.ToString("N0") accepted units</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Units in rework</div>
        <div class="metric-value">@Model.TotalUnitsRework.ToString("N0") <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta warning">@Model.ActiveReworkCount active defects pending</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Scrapped / irrecoverable</div>
        <div class="metric-value">@Model.TotalUnitsScrapped.ToString("N0") <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta danger">damage &amp; write-offs</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">Defect category breakdown</span>
            </div>
            <div class="data-card-body">
                @if (Model.CategoryBreakdowns.Any())
                {
                    <div class="progress-list">
                        @foreach (var item in Model.CategoryBreakdowns)
                        {
                            <div class="progress-row">
                                <span class="pr-label" title="@item.CategoryName">@item.CategoryName</span>
                                <div class="af-progress" role="progressbar" aria-valuenow="@item.Percentage" aria-valuemin="0" aria-valuemax="100" aria-label="@item.CategoryName">
                                    <div class="af-progress-bar bg-danger" style="width: @item.Percentage%;"></div>
                                </div>
                                <span class="pr-value">@item.DefectCount pcs · @item.Percentage%</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <div class="es-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
                        <div class="es-title">No defects logged</div>
                        <p>Perfect quality record so far.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">Vendor quality scorecard</span>
            </div>
            @if (Model.VendorScorecards.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Vendor</th>
                                <th>Process</th>
                                <th class="text-end">Inspected</th>
                                <th class="text-end">Defects</th>
                                <th class="text-end">Defect Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.VendorScorecards)
                            {
                                <tr>
                                    <td class="cell-title">@v.VendorName</td>
                                    <td><span class="tag">@v.ServiceType</span></td>
                                    <td class="cell-num">@v.InspectedPieces</td>
                                    <td class="cell-num text-danger fw-medium">@v.DefectivePieces</td>
                                    <td class="cell-num">
                                        <span class="af-badge @(v.DefectRate > 10 ? "b-red" : (v.DefectRate > 5 ? "b-yellow" : "b-green"))">@v.DefectRate%</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-4">
                    <div class="es-icon"><i class="bi bi-people"></i></div>
                    <p>No vendor inspection data available yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="table-card">
    <form method="get" class="table-toolbar">
        <div class="toolbar-filters">
            <span class="data-card-title me-2">Recent inspections</span>
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="QC, lot, design, vendor…" value="@ViewBag.Search" />
            </div>
            <select name="orderId" class="af-input af-select">
                <option value="">All lots</option>
                @foreach (var o in (List<AashanaFashion.Models.ProductionOrder>)ViewBag.Orders)
                {
                    <option value="@o.Id" selected="@(Model.SelectedOrderId == o.Id)">Lot: @o.LotNo (@(o.Design?.DesignNumber ?? ""))</option>
                }
            </select>
            <select name="stage" class="af-input af-select">
                <option value="">All stages</option>
                @foreach (AashanaFashion.Models.QcStage s in Enum.GetValues(typeof(AashanaFashion.Models.QcStage)))
                {
                    <option value="@s" selected="@(Model.StageFilter == s)">@s.Humanize()</option>
                }
            </select>
            <select name="vendorId" class="af-input af-select">
                <option value="">All vendors</option>
                @foreach (var v in (List<AashanaFashion.Models.Vendor>)ViewBag.Vendors)
                {
                    <option value="@v.Id" selected="@(Model.SelectedVendorId == v.Id)">@v.VendorName</option>
                }
            </select>
            <select name="result" class="af-input af-select">
                <option value="">All results</option>
                @foreach (AashanaFashion.Models.QcResult r in Enum.GetValues(typeof(AashanaFashion.Models.QcResult)))
                {
                    <option value="@r" selected="@(ViewBag.Result != null && (AashanaFashion.Models.QcResult)ViewBag.Result == r)">@r.Humanize()</option>
                }
            </select>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.RecentInspections.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>QC #</th>
                        <th>Date</th>
                        <th>Lot / Design</th>
                        <th>Stage</th>
                        <th>Vendor / Worker</th>
                        <th class="text-end">Inspected</th>
                        <th class="text-end">Passed</th>
                        <th class="text-end">Rework</th>
                        <th class="text-end">Scrap</th>
                        <th>Status</th>
                        <th>Inspector</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentInspections)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@item.Id" class="font-monospace fw-medium">@item.InspectionNumber</a></td>
                            <td class="text-muted text-nowrap">@item.InspectionDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="cell-title">@item.ProductionOrder?.LotNo</span>
                                <span class="cell-sub">@(item.ProductionOrder?.Design?.DesignNumber ?? "—")</span>
                            </td>
                            <td><span class="tag">@item.Stage.Humanize()</span></td>
                            <td>@(item.Vendor?.VendorName ?? "In-House")</td>
                            <td class="cell-num text-foreground fw-medium">@item.TotalInspected</td>
                            <td class="cell-num text-success">@item.TotalPassed</td>
                            <td class="cell-num text-warning">@item.TotalRework</td>
                            <td class="cell-num text-danger">@item.TotalScrap</td>
                            <td>
                                @if (item.OverallResult == AashanaFashion.Models.QcResult.Passed)
                                {
                                    <span class="af-badge b-green">Passed</span>
                                }
                                else if (item.OverallResult == AashanaFashion.Models.QcResult.PassedWithRework)
                                {
                                    <span class="af-badge b-yellow">Rework req.</span>
                                }
                                else
                                {
                                    <span class="af-badge b-red">Failed</span>
                                }
                            </td>
                            <td class="text-muted">@item.InspectorName</td>
                            <td class="cell-actions">
                                <a asp-action="Details" asp-route-id="@item.Id" class="row-action primary" title="View" aria-label="View"><i class="bi bi-box-arrow-up-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.RecentInspections.Count()</strong> inspections</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-clipboard-check"></i></div>
            <div class="es-title">No inspections found</div>
            <p>No inspections match the filter.</p>
            @if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">Log first inspection</a>
            }
        </div>
    }
</div>
