@model AashanaFashion.Models.ReworkQueueViewModel
@{
    ViewData["Title"] = "Rework & Alteration Queue";
    var currentStatus = (AashanaFashion.Models.ReworkStatus?)ViewBag.SelectedStatus;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Quality dashboard</a>
        <h1 class="page-title">Rework &amp; Alteration Queue</h1>
        <p class="page-sub">Track garments currently being altered, repaired, or awaiting re-inspection.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Log QC Inspection</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Pending rework</div>
        <div class="metric-value">@Model.TotalPendingRework</div>
        <div class="metric-meta warning">awaiting assignment / dispatch</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Sent to rework</div>
        <div class="metric-value">@Model.TotalSentToRework</div>
        <div class="metric-meta info">with tailor / vendor</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Rework completed</div>
        <div class="metric-value">@Model.TotalCompletedRework</div>
        <div class="metric-meta success">repaired and re-passed</div>
    </div>
</div>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link @(!currentStatus.HasValue ? "active" : "")" asp-action="ReworkQueue" asp-route-search="@ViewBag.Search">
            Active queue <span class="count-pill">@(Model.TotalPendingRework + Model.TotalSentToRework)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == AashanaFashion.Models.ReworkStatus.PendingRework ? "active" : "")" asp-action="ReworkQueue" asp-route-status="@AashanaFashion.Models.ReworkStatus.PendingRework" asp-route-search="@ViewBag.Search">
            Pending <span class="count-pill">@Model.TotalPendingRework</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == AashanaFashion.Models.ReworkStatus.SentToRework ? "active" : "")" asp-action="ReworkQueue" asp-route-status="@AashanaFashion.Models.ReworkStatus.SentToRework" asp-route-search="@ViewBag.Search">
            With tailor / vendor <span class="count-pill">@Model.TotalSentToRework</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == AashanaFashion.Models.ReworkStatus.ReworkCompleted ? "active" : "")" asp-action="ReworkQueue" asp-route-status="@AashanaFashion.Models.ReworkStatus.ReworkCompleted" asp-route-search="@ViewBag.Search">
            Completed <span class="count-pill">@Model.TotalCompletedRework</span>
        </a>
    </li>
</ul>

<div class="table-card">
    <form method="get" class="table-toolbar">
        @if (currentStatus.HasValue)
        {
            <input type="hidden" name="status" value="@currentStatus.Value" />
        }
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search defect, order, worker…" value="@ViewBag.Search" />
            </div>
        </div>
        <div class="toolbar-actions">
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || currentStatus.HasValue)
            {
                <a asp-action="ReworkQueue" class="btn btn-ghost">Reset</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.DefectItems.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>QC / Date</th>
                        <th>Lot / Design</th>
                        <th>Defect</th>
                        <th>Category</th>
                        <th class="text-end">Qty (pcs)</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th>Resolution Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DefectItems)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@d.QualityInspectionId" class="font-monospace fw-medium">@d.QualityInspection?.InspectionNumber</a>
                                <span class="cell-sub">@d.CreatedDate.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td>
                                <span class="cell-title">@d.QualityInspection?.ProductionOrder?.LotNo</span>
                                <span class="cell-sub">@(d.QualityInspection?.ProductionOrder?.Design?.DesignNumber ?? "—")</span>
                            </td>
                            <td>
                                <span class="cell-title">@d.DefectReason</span>
                                <span class="cell-sub">Severity: @d.Severity.Humanize()</span>
                            </td>
                            <td><span class="tag">@d.DefectCategory.Humanize()</span></td>
                            <td class="cell-num text-foreground fw-medium">@d.Quantity</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.ReworkAssignedTo))
                                {
                                    <span>@d.ReworkAssignedTo</span>
                                }
                                else if (d.QualityInspection?.Vendor != null)
                                {
                                    <span>@d.QualityInspection.Vendor.VendorName</span>
                                }
                                else
                                {
                                    <span class="text-muted">In-House</span>
                                }
                            </td>
                            <td>
                                @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.ReworkCompleted)
                                {
                                    <span class="af-badge b-green">Completed</span>
                                }
                                else if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework)
                                {
                                    <span class="af-badge b-blue">Sent to tailor</span>
                                }
                                else
                                {
                                    <span class="af-badge b-yellow">Pending</span>
                                }
                            </td>
                            <td class="text-muted">@(d.ResolutionNotes ?? "—")</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework)
                                    {
                                        <form asp-action="UpdateReworkStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="defectId" value="@d.Id" />
                                            <input type="hidden" name="status" value="@AashanaFashion.Models.ReworkStatus.SentToRework" />
                                            <input type="hidden" name="resolutionNotes" value="Handed over to tailor for alteration." />
                                            <button type="submit" class="btn btn-sm btn-secondary me-1" title="Dispatch to tailor/vendor"><i class="bi bi-send"></i> Send</button>
                                        </form>
                                    }

                                    @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework || d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework)
                                    {
                                        <form asp-action="UpdateReworkStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="defectId" value="@d.Id" />
                                            <input type="hidden" name="status" value="@AashanaFashion.Models.ReworkStatus.ReworkCompleted" />
                                            <input type="hidden" name="resolutionNotes" value="Repaired, inspected, and passed." />
                                            <button type="submit" class="btn btn-sm btn-secondary me-1" title="Mark alteration complete and passed"><i class="bi bi-check-lg"></i> Pass</button>
                                        </form>

                                        <form asp-action="UpdateReworkStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="defectId" value="@d.Id" />
                                            <input type="hidden" name="status" value="@AashanaFashion.Models.ReworkStatus.Scrapped" />
                                            <input type="hidden" name="resolutionNotes" value="Irrecoverable defect after repair attempt. Written off as scrap." />
                                            <button type="submit" class="row-action danger" title="Cannot be repaired — scrap piece" aria-label="Scrap" onclick="return confirm('Write off this piece as scrap?')"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.DefectItems.Count()</strong> items</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
            <div class="es-title">Rework queue is clear</div>
            <p>All altered items have been processed and passed.</p>
        </div>
    }
</div>
