@model AashanaFashion.Models.QualityInspection
@{
    ViewData["Title"] = $"QC Inspection {Model.InspectionNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">← Back to Quality Dashboard</a>
        <h2 class="fw-bold mt-1 mb-0">
            Inspection @Model.InspectionNumber
            @if (Model.OverallResult == AashanaFashion.Models.QcResult.Passed)
            {
                <span class="badge bg-success fs-6 align-middle ms-2">Passed</span>
            }
            else if (Model.OverallResult == AashanaFashion.Models.QcResult.PassedWithRework)
            {
                <span class="badge bg-warning text-dark fs-6 align-middle ms-2">Passed with Rework</span>
            }
            else
            {
                <span class="badge bg-danger fs-6 align-middle ms-2">Failed / Rejected</span>
            }
        </h2>
        <p class="text-muted mb-0">Inspected on @Model.InspectionDate.ToString("dd MMMM yyyy") by <strong>@Model.InspectorName</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        <a asp-action="Create" class="btn btn-primary">➕ Log Another</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Total Inspected</span>
                <h3 class="fw-bold my-1 text-primary">@Model.TotalInspected <span class="fs-6 text-muted fw-normal">pcs</span></h3>
                <small class="text-muted">100% sample audit</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Passed / Accepted</span>
                <h3 class="fw-bold my-1 text-success">@Model.TotalPassed <span class="fs-6 text-muted fw-normal">pcs</span></h3>
                <small class="text-success fw-semibold">@Model.PassRatePercent% Pass Rate</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Sent to Rework</span>
                <h3 class="fw-bold my-1 text-warning">@Model.TotalRework <span class="fs-6 text-muted fw-normal">pcs</span></h3>
                <small class="text-muted">Alteration queue</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Scrapped / Damage</span>
                <h3 class="fw-bold my-1 text-danger">@Model.TotalScrap <span class="fs-6 text-muted fw-normal">pcs</span></h3>
                <small class="text-muted">Write-off loss</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Inspection Information -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">ℹ️ Inspection Info</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm mb-0">
                    <tr>
                        <td class="text-muted" style="width: 45%;">Production Lot:</td>
                        <td class="fw-bold">
                            <a asp-controller="Production" asp-action="Edit" asp-route-id="@Model.ProductionOrderId" class="text-decoration-none">
                                Lot @Model.ProductionOrder?.LotNo
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Design:</td>
                        <td class="fw-semibold">@(Model.ProductionOrder?.Design?.DesignNumber ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Stage:</td>
                        <td><span class="badge bg-light text-dark border">@Model.Stage</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Component / Piece:</td>
                        <td>
                            @if (Model.ProductionEntity != null)
                            {
                                <span>@Model.ProductionEntity.EntityType #@Model.ProductionEntity.SlNo (@Model.ProductionEntity.Colour)</span>
                            }
                            else
                            {
                                <span class="text-muted">Full Lot</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Vendor / Worker:</td>
                        <td>@(Model.Vendor?.VendorName ?? "In-House Tailoring")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Inspector:</td>
                        <td>@Model.InspectorName</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Date Logged:</td>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </table>

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="mt-3 p-3 bg-light rounded-3">
                        <span class="small fw-semibold text-muted d-block mb-1">Remarks:</span>
                        <p class="mb-0 small">@Model.Remarks</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Defect Breakdown & Rework Actions -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">⚠️ Defect Breakdown & Rework Actions</h5>
                <span class="badge bg-secondary-subtle text-secondary">@Model.Defects.Count defects logged</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Defects.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th>Reason / Description</th>
                                    <th class="text-end">Qty</th>
                                    <th>Severity</th>
                                    <th>Action Taken</th>
                                    <th>Rework Status</th>
                                    <th class="text-center">Resolution</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Defects)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@d.DefectCategory</span></td>
                                        <td>
                                            <div class="fw-semibold">@d.DefectReason</div>
                                            @if (!string.IsNullOrWhiteSpace(d.ResolutionNotes))
                                            {
                                                <small class="text-muted">Notes: @d.ResolutionNotes</small>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">@d.Quantity</td>
                                        <td>
                                            <span class="badge @(d.Severity == AashanaFashion.Models.DefectSeverity.Critical ? "bg-danger" : (d.Severity == AashanaFashion.Models.DefectSeverity.Major ? "bg-warning text-dark" : "bg-info text-dark"))">
                                                @d.Severity
                                            </span>
                                        </td>
                                        <td><small class="fw-semibold">@d.Action</small></td>
                                        <td>
                                            @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.ReworkCompleted)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework || d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework)
                                            {
                                                <span class="badge bg-warning text-dark">@d.ReworkStatus</span>
                                            }
                                            else if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.Scrapped)
                                            {
                                                <span class="badge bg-danger">Scrapped</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">N/A</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework || d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework)
                                            {
                                                <form asp-action="UpdateReworkStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="defectId" value="@d.Id" />
                                                    <input type="hidden" name="status" value="@AashanaFashion.Models.ReworkStatus.ReworkCompleted" />
                                                    <input type="hidden" name="resolutionNotes" value="Altered and re-inspected. Passed." />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Rework Completed">
                                                        ✓ Pass
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <span class="fs-1 d-block mb-2">🎉</span>
                        <p class="mb-0 fw-semibold">No defects found during this inspection!</p>
                        <small class="text-muted">All @Model.TotalPassed pieces passed quality check.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
