@model AashanaFashion.Models.QualityInspection
@{
    ViewData["Title"] = $"QC Inspection {Model.InspectionNumber}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Quality dashboard</a>
        <h1 class="page-title d-flex align-items-center gap-2">
            Inspection @Model.InspectionNumber
            @if (Model.OverallResult == AashanaFashion.Models.QcResult.Passed)
            {
                <span class="af-badge b-green">Passed</span>
            }
            else if (Model.OverallResult == AashanaFashion.Models.QcResult.PassedWithRework)
            {
                <span class="af-badge b-yellow">Passed with rework</span>
            }
            else
            {
                <span class="af-badge b-red">Failed / rejected</span>
            }
        </h1>
        <p class="page-sub">Inspected on @Model.InspectionDate.ToString("dd MMMM yyyy") by <strong class="text-foreground">@Model.InspectorName</strong></p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Log another</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total inspected</div>
        <div class="metric-value">@Model.TotalInspected <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta">100% sample audit</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Passed / accepted</div>
        <div class="metric-value">@Model.TotalPassed <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta success">@Model.PassRatePercent% pass rate</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Sent to rework</div>
        <div class="metric-value">@Model.TotalRework <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta warning">alteration queue</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Scrapped / damage</div>
        <div class="metric-value">@Model.TotalScrap <span class="metric-suffix">pcs</span></div>
        <div class="metric-meta danger">write-off loss</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="data-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">Inspection info</span>
            </div>
            <div class="data-card-body">
                <div class="info-grid" style="grid-template-columns: minmax(0, 1fr);">
                    <div class="info-item">
                        <div class="info-label">Production lot</div>
                        <a asp-controller="Production" asp-action="Edit" asp-route-id="@Model.ProductionOrderId" class="info-value fw-medium">Lot @Model.ProductionOrder?.LotNo</a>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Design</div>
                        <div class="info-value">@(Model.ProductionOrder?.Design?.DesignNumber ?? "—")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Stage</div>
                        <span class="tag">@Model.Stage.Humanize()</span>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Component / piece</div>
                        @if (Model.ProductionEntity != null)
                        {
                            <div class="info-value">@Model.ProductionEntity.EntityType #@Model.ProductionEntity.SlNo (@Model.ProductionEntity.Colour)</div>
                        }
                        else
                        {
                            <div class="info-value muted">Full lot</div>
                        }
                    </div>
                    <div class="info-item">
                        <div class="info-label">Vendor / worker</div>
                        <div class="info-value">@(Model.Vendor?.VendorName ?? "In-House Tailoring")</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Inspector</div>
                        <div class="info-value">@Model.InspectorName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date logged</div>
                        <div class="info-value">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="panel-inset mt-4 mb-0">
                        <div class="micro-label">Remarks</div>
                        <p class="mb-0 text-sm">@Model.Remarks</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="table-card h-100">
            <div class="data-card-header">
                <span class="data-card-title">Defect breakdown &amp; rework actions</span>
                <span class="count-pill">@Model.Defects.Count</span>
            </div>
            @if (Model.Defects.Any())
            {
                <div class="table-scroll">
                    <table class="af-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Reason / Description</th>
                                <th class="text-end">Qty</th>
                                <th>Severity</th>
                                <th>Action Taken</th>
                                <th>Rework Status</th>
                                <th class="text-end">Resolution</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Defects)
                            {
                                <tr>
                                    <td><span class="tag">@d.DefectCategory.Humanize()</span></td>
                                    <td>
                                        <span class="cell-title">@d.DefectReason</span>
                                        @if (!string.IsNullOrWhiteSpace(d.ResolutionNotes))
                                        {
                                            <span class="cell-sub">Notes: @d.ResolutionNotes</span>
                                        }
                                    </td>
                                    <td class="cell-num text-foreground fw-medium">@d.Quantity</td>
                                    <td>
                                        <span class="af-badge priority @(d.Severity == AashanaFashion.Models.DefectSeverity.Critical ? "priority-critical" : (d.Severity == AashanaFashion.Models.DefectSeverity.Major ? "priority-high" : "priority-low"))">@d.Severity.Humanize()</span>
                                    </td>
                                    <td class="text-sm">@d.Action.Humanize()</td>
                                    <td>
                                        @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.ReworkCompleted)
                                        {
                                            <span class="af-badge b-green">Completed</span>
                                        }
                                        else if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework || d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework)
                                        {
                                            <span class="af-badge b-yellow">@d.ReworkStatus.Humanize()</span>
                                        }
                                        else if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.Scrapped)
                                        {
                                            <span class="af-badge b-red">Scrapped</span>
                                        }
                                        else
                                        {
                                            <span class="af-badge b-gray">N/A</span>
                                        }
                                    </td>
                                    <td class="cell-actions">
                                        @if (d.ReworkStatus == AashanaFashion.Models.ReworkStatus.PendingRework || d.ReworkStatus == AashanaFashion.Models.ReworkStatus.SentToRework)
                                        {
                                            <form asp-action="UpdateReworkStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="defectId" value="@d.Id" />
                                                <input type="hidden" name="status" value="@AashanaFashion.Models.ReworkStatus.ReworkCompleted" />
                                                <input type="hidden" name="resolutionNotes" value="Altered and re-inspected. Passed." />
                                                <button type="submit" class="btn btn-sm btn-secondary" title="Mark rework completed">
                                                    <i class="bi bi-check-lg"></i> Pass
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-placeholder">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="es-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
                    <div class="es-title">No defects found</div>
                    <p>All @Model.TotalPassed pieces passed the quality check.</p>
                </div>
            }
        </div>
    </div>
</div>
