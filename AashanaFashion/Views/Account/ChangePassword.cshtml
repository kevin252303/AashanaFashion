@model AashanaFashion.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-6 col-md-8">
        <div class="data-card shadow-sm border-0">
            <div class="data-card-header d-flex justify-content-between align-items-center">
                <span class="data-card-title">🔑 Change Password</span>
                <a asp-controller="Production" asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back to Dashboard</a>
            </div>
            <div class="p-4">
                <p class="text-muted small mb-4">Ensure your account remains secure by choosing a strong password with at least 6 characters.</p>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="af-alert af-alert-danger mb-4">
                            <span class="alert-body">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>⚠️ @err.ErrorMessage</div>
                                }
                            </span>
                        </div>
                    }

                    <div class="af-form-group mb-3">
                        <label asp-for="CurrentPassword" class="af-label">Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="af-input" placeholder="Enter your current password" autofocus />
                        <span asp-validation-for="CurrentPassword" class="af-error"></span>
                    </div>

                    <div class="af-form-group mb-3">
                        <label asp-for="NewPassword" class="af-label">New Password</label>
                        <input asp-for="NewPassword" type="password" class="af-input" placeholder="Enter new password (min. 6 characters)" />
                        <span asp-validation-for="NewPassword" class="af-error"></span>
                    </div>

                    <div class="af-form-group mb-4">
                        <label asp-for="ConfirmPassword" class="af-label">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="af-input" placeholder="Re-type your new password" />
                        <span asp-validation-for="ConfirmPassword" class="af-error"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-controller="Production" asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
                        <button type="submit" class="btn-af btn-af-primary">
                            <span class="ico">💾</span> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
