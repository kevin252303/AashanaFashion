@model AashanaFashion.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-xl-5 col-lg-6 col-md-8">
        <div class="page-header">
            <div>
                <a asp-controller="Production" asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Dashboard</a>
                <h1 class="page-title">Change Password</h1>
                <p class="page-sub">Keep your account secure with a strong password of at least 6 characters.</p>
            </div>
        </div>

        <form asp-action="ChangePassword" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="af-alert af-alert-danger">
                        <div class="alert-body">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <div class="af-form-group">
                    <label asp-for="CurrentPassword" class="af-label">Current password</label>
                    <input asp-for="CurrentPassword" type="password" class="af-input" placeholder="Enter your current password" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="af-error"></span>
                </div>

                <div class="af-form-group">
                    <label asp-for="NewPassword" class="af-label">New password</label>
                    <input asp-for="NewPassword" type="password" class="af-input" placeholder="At least 6 characters" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="af-error"></span>
                </div>

                <div class="af-form-group mb-0">
                    <label asp-for="ConfirmPassword" class="af-label">Confirm new password</label>
                    <input asp-for="ConfirmPassword" type="password" class="af-input" placeholder="Re-type your new password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="af-error"></span>
                </div>
            </div>
            <div class="data-card-footer d-flex justify-content-end gap-2">
                <a asp-controller="Production" asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
