@model AashanaFashion.Models.LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign In";
}

<section class="auth-brand">
    <img src="~/images/aashana_logo.jpg" alt="Aashana — since 2003" class="auth-logo" />

    <div class="auth-pitch">
        <div class="auth-eyebrow">Production System</div>
        <h1 class="auth-headline">Every lot, every stage, in one place.</h1>
        <p class="auth-lede">Manage production orders, track fabric through each process, and keep your team, stock and billing in sync.</p>
        <ul class="auth-features">
            <li><i class="bi bi-diagram-3"></i> Real-time production order tracking</li>
            <li><i class="bi bi-shield-check"></i> Role-based access control</li>
            <li><i class="bi bi-check2-square"></i> Stage-wise verification workflow</li>
            <li><i class="bi bi-people"></i> Team, attendance &amp; payroll</li>
        </ul>
    </div>

    <div class="auth-legal">© @DateTime.Now.Year Aashana Fashion · Production Management System</div>
</section>

<main class="auth-main">
    <div class="auth-card">
        <div class="auth-card-mark brand-mark">AF</div>
        <h2 class="auth-title">Sign in</h2>
        <p class="auth-sub">Welcome back. Enter your details to continue.</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="af-alert af-alert-danger" role="alert">
                    <div class="alert-body">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <div class="auth-field">
                <label asp-for="Username" class="af-label">Username</label>
                <div class="search-field">
                    <i class="bi bi-person"></i>
                    <input asp-for="Username" class="af-input" placeholder="Enter your username" autocomplete="username" autofocus />
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="af-label">Password</label>
                <div class="auth-pw search-field">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="af-input" id="pwInput" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" id="togglePw" class="pw-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe">Keep me signed in</label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
        </form>

        <div class="auth-trial">
            New garment business?
            <a asp-controller="Subscription" asp-action="RegisterTenant" class="fw-semibold">Start 14-day free trial <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="auth-foot">Need access? Ask your administrator to create an account.</div>
    </div>
</main>

@section Scripts {
    <script src="~/js/login.js"></script>
}
