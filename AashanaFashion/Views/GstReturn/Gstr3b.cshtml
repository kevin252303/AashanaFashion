@model AashanaFashion.Models.Gstr3bViewModel
@{
    ViewData["Title"] = $"GSTR-3B — {Model.MonthName} {Model.Year}";
    int selectedYear = ViewBag.SelectedYear;
    int selectedMonth = ViewBag.SelectedMonth;
    decimal itcIgst = Math.Min(Model.OutwardTaxableSupplies.IntegratedTax, Model.NetItcAvailable.IntegratedTax);
    decimal itcCgst = Math.Min(Model.OutwardTaxableSupplies.CentralTax, Model.NetItcAvailable.CentralTax);
    decimal itcSgst = Math.Min(Model.OutwardTaxableSupplies.StateTax, Model.NetItcAvailable.StateTax);
}

<div class="page-header">
    <div>
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="page-back"><i class="bi bi-arrow-left"></i> GST returns</a>
        <h1 class="page-title">GSTR-3B return sheet</h1>
        <p class="page-sub">Tax liability from sales and input tax credit from purchases for @Model.MonthName @Model.Year.</p>
    </div>
    <div class="page-actions d-print-none">
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print / save PDF</button>
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-body">
        <div class="info-grid cols-4">
            <div><div class="info-label">Taxpayer</div><div class="info-value">@Model.Company.CompanyName</div></div>
            <div><div class="info-label">GSTIN</div><div class="info-value font-monospace">@(Model.Company.Gstin ?? "Not set")</div></div>
            <div><div class="info-label">State &amp; code</div><div class="info-value">@Model.Company.State (@Model.Company.StateCode)</div></div>
            <div><div class="info-label">Return period</div><div class="info-value"><span class="af-badge b-indigo">@Model.MonthName @Model.Year</span></div></div>
        </div>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Output tax</div>
        <div class="metric-value">₹@Model.OutwardTaxableSupplies.TotalTax.ToString("N2")</div>
        <div class="metric-meta">table 3.1(a)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Net ITC available</div>
        <div class="metric-value">₹@Model.NetItcAvailable.TotalTax.ToString("N2")</div>
        <div class="metric-meta success">table 4(C)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Tax payable in cash</div>
        <div class="metric-value">₹@Model.TotalCashPayable.ToString("N2")</div>
        <div class="metric-meta @(Model.TotalCashPayable > 0 ? "warning" : "success")">table 6.1</div>
    </div>
</div>

<div class="table-card mb-4">
    <div class="data-card-header">
        <div class="data-card-title">3.1 Outward supplies &amp; inward supplies liable to reverse charge</div>
    </div>
    <div class="table-scroll">
        <table class="af-table fin-table">
            <thead>
                <tr>
                    <th style="width: 40%;">Nature of supplies</th>
                    <th class="text-end">Taxable value</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST / UTGST</th>
                    <th class="text-end">Cess</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-foreground fw-medium">(a) Outward taxable supplies <span class="text-muted fw-normal">(other than zero rated, nil rated and exempted)</span></td>
                    <td class="cell-num text-foreground fw-semibold">@Model.OutwardTaxableSupplies.TotalTaxableValue.ToString("N2")</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.IntegratedTax.ToString("N2")</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.CentralTax.ToString("N2")</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.StateTax.ToString("N2")</td>
                    <td class="cell-num text-muted">0.00</td>
                </tr>
                <tr><td class="text-muted">(b) Outward taxable supplies (zero rated)</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="text-muted">(c) Other outward supplies (nil rated, exempted)</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td></tr>
                <tr><td class="text-muted">(d) Inward supplies (liable to reverse charge)</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="text-muted">(e) Non-GST outward supplies</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td></tr>
            </tbody>
            <tfoot>
                <tr>
                    <td>Total outward tax liability</td>
                    <td class="text-end tabular">₹@Model.OutwardTaxableSupplies.TotalTaxableValue.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.OutwardTaxableSupplies.IntegratedTax.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.OutwardTaxableSupplies.CentralTax.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.OutwardTaxableSupplies.StateTax.ToString("N2")</td>
                    <td class="text-end tabular">₹0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="table-card mb-4">
    <div class="data-card-header">
        <div class="data-card-title">4. Eligible input tax credit</div>
    </div>
    <div class="table-scroll">
        <table class="af-table fin-table">
            <thead>
                <tr>
                    <th style="width: 40%;">Details</th>
                    <th class="text-end">IGST</th>
                    <th class="text-end">CGST</th>
                    <th class="text-end">SGST / UTGST</th>
                    <th class="text-end">Cess</th>
                </tr>
            </thead>
            <tbody>
                <tr class="fs-group"><td colspan="5">(A) ITC available (whether in full or part)</td></tr>
                <tr><td class="fs-indent text-muted">(1) Import of goods</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="fs-indent text-muted">(2) Import of services</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">—</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="fs-indent text-muted">(3) Inward supplies liable to reverse charge</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="fs-indent text-muted">(4) Inward supplies from ISD</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td></tr>
                <tr>
                    <td class="fs-indent text-foreground fw-medium">(5) All other ITC <span class="text-muted fw-normal">(raw materials, fabrics &amp; trims)</span></td>
                    <td class="cell-num text-success fw-semibold">@Model.ItcAllOtherPurchases.IntegratedTax.ToString("N2")</td>
                    <td class="cell-num text-success fw-semibold">@Model.ItcAllOtherPurchases.CentralTax.ToString("N2")</td>
                    <td class="cell-num text-success fw-semibold">@Model.ItcAllOtherPurchases.StateTax.ToString("N2")</td>
                    <td class="cell-num text-muted">0.00</td>
                </tr>
                <tr class="fs-group"><td colspan="5">(B) ITC reversed</td></tr>
                <tr><td class="fs-indent text-muted">(1) As per rules 42 &amp; 43 of CGST Rules</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td></tr>
                <tr><td class="fs-indent text-muted">(2) Others</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td><td class="cell-num text-muted">0.00</td></tr>
            </tbody>
            <tfoot>
                <tr class="fs-result positive">
                    <td>(C) Net ITC available (A) − (B)</td>
                    <td class="text-end tabular">₹@Model.NetItcAvailable.IntegratedTax.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.NetItcAvailable.CentralTax.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.NetItcAvailable.StateTax.ToString("N2")</td>
                    <td class="text-end tabular">₹0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="table-card">
    <div class="data-card-header">
        <div class="data-card-title">6.1 Payment of tax <span class="text-muted fw-normal">· net payable in cash after ITC</span></div>
    </div>
    <div class="table-scroll">
        <table class="af-table fin-table">
            <thead>
                <tr>
                    <th>Tax</th>
                    <th class="text-end">Total payable</th>
                    <th class="text-end">Paid through ITC</th>
                    <th class="text-end">Payable in cash</th>
                    <th class="text-end">Interest</th>
                    <th class="text-end">Late fee</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-foreground fw-medium">Integrated tax (IGST)</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.IntegratedTax.ToString("N2")</td>
                    <td class="cell-num text-success">@itcIgst.ToString("N2")</td>
                    <td class="cell-num text-foreground fw-semibold">@Model.NetPayableIgst.ToString("N2")</td>
                    <td class="cell-num text-muted">0.00</td>
                    <td class="cell-num text-muted">0.00</td>
                </tr>
                <tr>
                    <td class="text-foreground fw-medium">Central tax (CGST)</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.CentralTax.ToString("N2")</td>
                    <td class="cell-num text-success">@itcCgst.ToString("N2")</td>
                    <td class="cell-num text-foreground fw-semibold">@Model.NetPayableCgst.ToString("N2")</td>
                    <td class="cell-num text-muted">0.00</td>
                    <td class="cell-num text-muted">0.00</td>
                </tr>
                <tr>
                    <td class="text-foreground fw-medium">State / UT tax (SGST)</td>
                    <td class="cell-num">@Model.OutwardTaxableSupplies.StateTax.ToString("N2")</td>
                    <td class="cell-num text-success">@itcSgst.ToString("N2")</td>
                    <td class="cell-num text-foreground fw-semibold">@Model.NetPayableSgst.ToString("N2")</td>
                    <td class="cell-num text-muted">0.00</td>
                    <td class="cell-num text-muted">0.00</td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="fs-result @(Model.TotalCashPayable > 0 ? "negative" : "positive")">
                    <td>Total cash liability</td>
                    <td class="text-end tabular">₹@Model.OutwardTaxableSupplies.TotalTax.ToString("N2")</td>
                    <td class="text-end tabular">₹@((itcIgst + itcCgst + itcSgst).ToString("N2"))</td>
                    <td class="text-end tabular">₹@Model.TotalCashPayable.ToString("N2")</td>
                    <td class="text-end tabular">₹0.00</td>
                    <td class="text-end tabular">₹0.00</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
