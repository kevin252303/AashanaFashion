@model AashanaFashion.Models.Gstr1PeriodViewModel
@{
    ViewData["Title"] = "GST Returns & Filing Hub";
    var gstr3b = ViewBag.Gstr3b as AashanaFashion.Models.Gstr3bViewModel;
    int selectedYear = ViewBag.SelectedYear;
    int selectedMonth = ViewBag.SelectedMonth;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">🏛️ GST Returns & Compliance Hub</h1>
        <p class="page-sub mb-0 text-muted">
            Official GSTR-1, GSTR-3B Auto-Tax Computation, and GSTR-2B Input Tax Credit Reconciliation
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Reconciliation" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="btn btn-outline-info">
            🔍 GSTR-2B ITC Matching
        </a>
        <a asp-action="Gstr3b" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="btn btn-outline-primary">
            📋 GSTR-3B Return Sheet
        </a>
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                📊 Export CSV
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="b2b">📁 B2B Invoices CSV</a></li>
                <li><a class="dropdown-item" asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="hsn">🏷️ HSN Summary CSV</a></li>
                <li><a class="dropdown-item" asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="b2cs">🛒 B2C Small Summary CSV</a></li>
            </ul>
        </div>
        <a asp-action="DownloadGstr1Json" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="btn btn-success fw-bold">
            📥 Download GSTR-1 JSON (GST Portal Format)
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Return Period & Company Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-auto d-flex align-items-center gap-2">
                <span class="fw-bold text-secondary">Return Period:</span>
            </div>
            <div class="col-auto">
                <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                        <option value="@m" selected="@(m == selectedMonth)">@mName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                    {
                        <option value="@y" selected="@(y == selectedYear)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-auto ms-auto d-flex align-items-center gap-2 flex-wrap">
                <span class="badge bg-light text-dark border px-2 py-1.5">
                    🏢 Company: <strong>@Model.Company.CompanyName</strong>
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1.5 font-monospace">
                    GSTIN: <strong>@(Model.Company.Gstin ?? "Not Set")</strong>
                </span>
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1.5">
                    State: <strong>@Model.Company.State (@Model.Company.StateCode)</strong>
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1.5 font-monospace">
                    Code: <strong>@Model.ReturnPeriodCode</strong>
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Pre-Filing Audit Alert Box -->
@if (Model.ValidationIssues.Any())
{
    var errors = Model.ValidationIssues.Where(i => i.Severity == AashanaFashion.Models.GstValidationSeverity.Error).ToList();
    var warnings = Model.ValidationIssues.Where(i => i.Severity == AashanaFashion.Models.GstValidationSeverity.Warning).ToList();

    <div class="alert @(errors.Any() ? "alert-warning" : "alert-info") border-0 shadow-sm rounded-3 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="mb-0 fw-bold">
                ⚠️ Pre-Filing Data Audit (@Model.ValidationIssues.Count item(s) need attention)
            </h6>
            <button class="btn btn-sm btn-link text-decoration-none p-0" type="button" data-bs-toggle="collapse" data-bs-target="#auditDetails">
                Toggle Details ▾
            </button>
        </div>
        <p class="small mb-2 text-muted">
            The GST Portal strictly validates GSTIN formats, Place of Supply, and HSN codes during upload. Resolve these items to avoid portal rejection:
        </p>
        <div class="collapse show" id="auditDetails">
            <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white rounded-2 mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Severity</th>
                            <th>Invoice / Doc #</th>
                            <th>Party</th>
                            <th>Issue Detected</th>
                            <th>Recommended Fix</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in Model.ValidationIssues)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(issue.Severity == AashanaFashion.Models.GstValidationSeverity.Error ? "bg-danger" : "bg-warning text-dark")">
                                        @issue.Severity
                                    </span>
                                </td>
                                <td class="fw-bold font-monospace">@issue.DocumentNumber</td>
                                <td>@issue.PartyName</td>
                                <td class="text-danger">@issue.Issue</td>
                                <td class="text-success fw-semibold">@issue.Recommendation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2 py-2">
        <span>✅</span>
        <span class="small fw-semibold">Pre-Filing Data Audit Passed: All active invoices, GSTINs, and tax slabs are validated and compliant with GSTN rules.</span>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">Gross Turnover</span>
                <h4 class="fw-bold my-1 text-dark">₹@Model.TotalTurnover.ToString("N2")</h4>
                <small class="text-muted">@Model.TotalInvoiceCount Total Invoices</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">Taxable Value</span>
                <h4 class="fw-bold my-1 text-primary">₹@Model.TotalTaxableValue.ToString("N2")</h4>
                <small class="text-muted">Net of discounts</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">IGST (Inter-State)</span>
                <h4 class="fw-bold my-1 text-info">₹@Model.TotalIgst.ToString("N2")</h4>
                <small class="text-muted">Outside @Model.Company.State</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">CGST (Central)</span>
                <h4 class="fw-bold my-1 text-success">₹@Model.TotalCgst.ToString("N2")</h4>
                <small class="text-muted">Intra-State</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">SGST (State)</span>
                <h4 class="fw-bold my-1 text-success">₹@Model.TotalSgst.ToString("N2")</h4>
                <small class="text-muted">Intra-State</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-primary-subtle text-primary border-primary">
            <div class="card-body p-3">
                <span class="text-uppercase small fw-bold d-block text-primary">Output Tax Due</span>
                <h4 class="fw-bold my-1 text-primary">₹@Model.TotalTaxLiability.ToString("N2")</h4>
                <small class="text-primary fw-semibold">GSTR-1 Total Liability</small>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-pills mb-3 border-bottom pb-2 gap-2" id="gstTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="b2b-tab" data-bs-toggle="pill" data-bs-target="#b2b" type="button" role="tab">
            🏢 Table 4A/4B: B2B Invoices <span class="badge bg-secondary ms-1">@Model.B2bInvoices.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="b2cs-tab" data-bs-toggle="pill" data-bs-target="#b2cs" type="button" role="tab">
            🛒 Table 7: B2C Small <span class="badge bg-secondary ms-1">@Model.B2csSummaries.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="b2cl-tab" data-bs-toggle="pill" data-bs-target="#b2cl" type="button" role="tab">
            📦 Table 5A: B2C Large <span class="badge bg-secondary ms-1">@Model.B2clInvoices.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="cdnr-tab" data-bs-toggle="pill" data-bs-target="#cdnr" type="button" role="tab">
            ↩️ Table 9B: Credit Notes <span class="badge bg-secondary ms-1">@Model.CreditNotes.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="hsn-tab" data-bs-toggle="pill" data-bs-target="#hsn" type="button" role="tab">
            🏷️ Table 12: HSN Summary <span class="badge bg-secondary ms-1">@Model.HsnSummaries.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="doc-tab" data-bs-toggle="pill" data-bs-target="#doc" type="button" role="tab">
            📑 Table 13: Doc Issued <span class="badge bg-secondary ms-1">@Model.DocumentSummaries.Count</span>
        </button>
    </li>
    <li class="nav-item ms-auto" role="presentation">
        <button class="nav-link fw-semibold text-primary" id="gstr3b-tab" data-bs-toggle="pill" data-bs-target="#gstr3b_preview" type="button" role="tab">
            📊 GSTR-3B Net Liability Preview
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="gstTabsContent">

    <!-- Table 4A/4B: B2B Invoices -->
    <div class="tab-pane fade show active" id="b2b" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Table 4A, 4B, 4C, 6B, 6C — Taxable Outward Supplies to Registered Persons (B2B)</h6>
                <a asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="b2b" class="btn btn-sm btn-outline-secondary">
                    Export B2B CSV
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Recipient GSTIN</th>
                            <th>Customer Name</th>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>POS</th>
                            <th class="text-end">Invoice Val</th>
                            <th class="text-end">Taxable Val</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th>e-Invoice</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.B2bInvoices.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4 text-muted">
                                    No B2B invoices found for @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var inv in Model.B2bInvoices)
                            {
                                <tr>
                                    <td><span class="font-monospace fw-bold text-primary">@inv.CustomerGstin</span></td>
                                    <td class="fw-semibold">@inv.CustomerName</td>
                                    <td>
                                        <a asp-controller="Invoice" asp-action="Details" asp-route-id="@inv.InvoiceId" class="text-decoration-none fw-bold">
                                            @inv.InvoiceNumber
                                        </a>
                                    </td>
                                    <td class="small text-muted">@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td><span class="badge bg-light text-dark border">@inv.PosStateCode</span></td>
                                    <td class="text-end fw-semibold">₹@inv.InvoiceValue.ToString("N2")</td>
                                    <td class="text-end">₹@inv.TaxableValue.ToString("N2")</td>
                                    <td class="text-center"><span class="badge bg-secondary-subtle text-secondary">@inv.GstRate%</span></td>
                                    <td class="text-end">₹@inv.IgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@inv.CgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@inv.SgstAmount.ToString("N2")</td>
                                    <td>
                                        @if (inv.EInvoiceStatus == "Generated")
                                        {
                                            <span class="badge bg-success-subtle text-success">IRN Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">@inv.EInvoiceStatus</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.B2bInvoices.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="5">Total B2B (@Model.B2bInvoices.Count Invoices)</td>
                                <td class="text-end">₹@Model.B2bInvoices.Sum(x => x.InvoiceValue).ToString("N2")</td>
                                <td class="text-end">₹@Model.B2bInvoices.Sum(x => x.TaxableValue).ToString("N2")</td>
                                <td></td>
                                <td class="text-end">₹@Model.B2bInvoices.Sum(x => x.IgstAmount).ToString("N2")</td>
                                <td class="text-end">₹@Model.B2bInvoices.Sum(x => x.CgstAmount).ToString("N2")</td>
                                <td class="text-end">₹@Model.B2bInvoices.Sum(x => x.SgstAmount).ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Table 7: B2C Small -->
    <div class="tab-pane fade" id="b2cs" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Table 7 — Taxable Supplies to Unregistered Persons (B2C Small — Grouped by POS & Rate)</h6>
                <a asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="b2cs" class="btn btn-sm btn-outline-secondary">
                    Export B2CS CSV
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Type</th>
                            <th>Place Of Supply</th>
                            <th>State Name</th>
                            <th class="text-center">Tax Rate</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th class="text-center">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.B2csSummaries.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    No B2C Small transactions found for @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var b in Model.B2csSummaries)
                            {
                                <tr>
                                    <td><span class="badge @(b.SupplyType == "INTRA" ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info")">@b.SupplyType</span></td>
                                    <td class="font-monospace fw-bold">@b.PlaceOfSupply</td>
                                    <td class="fw-semibold">@b.StateName</td>
                                    <td class="text-center"><span class="badge bg-secondary-subtle text-secondary">@b.GstRate%</span></td>
                                    <td class="text-end fw-semibold">₹@b.TaxableValue.ToString("N2")</td>
                                    <td class="text-end">₹@b.IgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@b.CgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@b.SgstAmount.ToString("N2")</td>
                                    <td class="text-center">@b.InvoiceCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Table 5A: B2C Large -->
    <div class="tab-pane fade" id="b2cl" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Table 5A, 5B — Inter-State Supplies to Unregistered Persons &gt; ₹2,50,000 (B2C Large)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer Name</th>
                            <th>POS</th>
                            <th class="text-end">Invoice Value</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">IGST Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.B2clInvoices.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No B2C Large transactions (> ₹2.5L inter-state) in @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var inv in Model.B2clInvoices)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace">@inv.InvoiceNumber</td>
                                    <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                                    <td>@inv.CustomerName</td>
                                    <td>@inv.PosStateCode</td>
                                    <td class="text-end">₹@inv.InvoiceValue.ToString("N2")</td>
                                    <td class="text-end">₹@inv.TaxableValue.ToString("N2")</td>
                                    <td class="text-center">@inv.GstRate%</td>
                                    <td class="text-end fw-semibold text-info">₹@inv.IgstAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Table 9B: Credit Notes -->
    <div class="tab-pane fade" id="cdnr" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Table 9B — Credit / Debit Notes Issued (Registered & Unregistered)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Note #</th>
                            <th>Date</th>
                            <th>Original Invoice #</th>
                            <th>Customer Name</th>
                            <th>GSTIN</th>
                            <th class="text-end">Refund Value</th>
                            <th class="text-end">Taxable</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.CreditNotes.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center py-4 text-muted">
                                    No credit notes or sales returns recorded for @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var n in Model.CreditNotes)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-danger">@n.NoteNumber</td>
                                    <td>@n.NoteDate.ToString("dd-MMM-yyyy")</td>
                                    <td class="font-monospace">@n.OriginalInvoiceNumber</td>
                                    <td>@n.CustomerName</td>
                                    <td><span class="font-monospace">@(string.IsNullOrEmpty(n.CustomerGstin) ? "URP" : n.CustomerGstin)</span></td>
                                    <td class="text-end fw-semibold text-danger">-₹@n.NoteValue.ToString("N2")</td>
                                    <td class="text-end">-₹@n.TaxableValue.ToString("N2")</td>
                                    <td class="text-center">@n.GstRate%</td>
                                    <td class="text-end">₹@n.IgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@n.CgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@n.SgstAmount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@n.Reason</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Table 12: HSN Summary -->
    <div class="tab-pane fade" id="hsn" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Table 12 — HSN Summary of Outward Supplies (Mandatory for Textile & Garments)</h6>
                <a asp-action="DownloadGstr1Csv" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" asp-route-section="hsn" class="btn btn-sm btn-outline-secondary">
                    Export HSN CSV
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>HSN Code</th>
                            <th>Description</th>
                            <th>UQC</th>
                            <th class="text-end">Total Qty</th>
                            <th class="text-end">Total Value</th>
                            <th class="text-end">Taxable Value</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.HsnSummaries.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    No item-wise HSN records found for @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var h in Model.HsnSummaries)
                            {
                                <tr>
                                    <td><span class="font-monospace fw-bold text-dark">@h.HsnCode</span></td>
                                    <td class="small">@h.Description</td>
                                    <td><span class="badge bg-light text-dark border">@h.Uqc</span></td>
                                    <td class="text-end fw-semibold">@h.TotalQuantity.ToString("N0")</td>
                                    <td class="text-end">₹@h.TotalValue.ToString("N2")</td>
                                    <td class="text-end fw-semibold">₹@h.TaxableValue.ToString("N2")</td>
                                    <td class="text-center"><span class="badge bg-secondary-subtle text-secondary">@h.GstRate%</span></td>
                                    <td class="text-end">₹@h.IgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@h.CgstAmount.ToString("N2")</td>
                                    <td class="text-end">₹@h.SgstAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.HsnSummaries.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3">HSN Total</td>
                                <td class="text-end">@Model.HsnSummaries.Sum(x => x.TotalQuantity).ToString("N0")</td>
                                <td class="text-end">₹@Model.HsnSummaries.Sum(x => x.TotalValue).ToString("N2")</td>
                                <td class="text-end">₹@Model.HsnSummaries.Sum(x => x.TaxableValue).ToString("N2")</td>
                                <td></td>
                                <td class="text-end">₹@Model.HsnSummaries.Sum(x => x.IgstAmount).ToString("N2")</td>
                                <td class="text-end">₹@Model.HsnSummaries.Sum(x => x.CgstAmount).ToString("N2")</td>
                                <td class="text-end">₹@Model.HsnSummaries.Sum(x => x.SgstAmount).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Table 13: Documents Issued -->
    <div class="tab-pane fade" id="doc" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Table 13 — Documents Issued During the Tax Period</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th>Nature of Document</th>
                            <th>From Serial No.</th>
                            <th>To Serial No.</th>
                            <th class="text-center">Total Number</th>
                            <th class="text-center text-danger">Cancelled</th>
                            <th class="text-center text-success">Net Issued</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.DocumentSummaries.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No documents generated in @Model.MonthName @Model.Year.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var doc in Model.DocumentSummaries)
                            {
                                <tr>
                                    <td class="fw-semibold">@doc.DocumentType</td>
                                    <td class="font-monospace">@doc.FromSerial</td>
                                    <td class="font-monospace">@doc.ToSerial</td>
                                    <td class="text-center fw-bold">@doc.TotalCount</td>
                                    <td class="text-center fw-bold text-danger">@doc.CancelledCount</td>
                                    <td class="text-center fw-bold text-success">@doc.NetIssuedCount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- GSTR-3B Quick Preview Tab -->
    <div class="tab-pane fade" id="gstr3b_preview" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">GSTR-3B Monthly Tax Computation Summary</h6>
                <a asp-action="Gstr3b" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="btn btn-sm btn-primary">
                    Open Full GSTR-3B Form ↗
                </a>
            </div>
            <div class="card-body">
                @if (gstr3b != null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 bg-light">
                                <span class="small text-muted text-uppercase fw-bold">1. Output Tax Liability (Sales)</span>
                                <h4 class="fw-bold my-1 text-danger">₹@gstr3b.OutwardTaxableSupplies.TotalTax.ToString("N2")</h4>
                                <small class="text-muted">Table 3.1(a) Outward Taxable</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 bg-light">
                                <span class="small text-muted text-uppercase fw-bold">2. Eligible Input Credit (Purchases)</span>
                                <h4 class="fw-bold my-1 text-success">₹@gstr3b.NetItcAvailable.TotalTax.ToString("N2")</h4>
                                <small class="text-muted">Table 4(C) Net ITC Available</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 @(gstr3b.TotalCashPayable > 0 ? "bg-warning-subtle text-dark" : "bg-success-subtle text-success")">
                                <span class="small text-uppercase fw-bold">3. Net Cash Payable</span>
                                <h4 class="fw-bold my-1">₹@gstr3b.TotalCashPayable.ToString("N2")</h4>
                                <small>Tax payable after adjusting ITC credit</small>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mt-3 mb-2">Breakdown by Tax Component:</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Tax Type</th>
                                    <th class="text-end">Output Tax (GSTR-1)</th>
                                    <th class="text-end">Input Tax Credit (Purchases)</th>
                                    <th class="text-end">Net Cash Tax Payable</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-info">IGST (Integrated Tax)</td>
                                    <td class="text-end">₹@gstr3b.OutwardTaxableSupplies.IntegratedTax.ToString("N2")</td>
                                    <td class="text-end text-success">₹@gstr3b.NetItcAvailable.IntegratedTax.ToString("N2")</td>
                                    <td class="text-end fw-bold">₹@gstr3b.NetPayableIgst.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-primary">CGST (Central Tax)</td>
                                    <td class="text-end">₹@gstr3b.OutwardTaxableSupplies.CentralTax.ToString("N2")</td>
                                    <td class="text-end text-success">₹@gstr3b.NetItcAvailable.CentralTax.ToString("N2")</td>
                                    <td class="text-end fw-bold">₹@gstr3b.NetPayableCgst.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-primary">SGST (State Tax)</td>
                                    <td class="text-end">₹@gstr3b.OutwardTaxableSupplies.StateTax.ToString("N2")</td>
                                    <td class="text-end text-success">₹@gstr3b.NetItcAvailable.StateTax.ToString("N2")</td>
                                    <td class="text-end fw-bold">₹@gstr3b.NetPayableSgst.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<!-- How to file instructions accordion -->
<div class="card border-0 shadow-sm rounded-3 mt-4">
    <div class="card-body p-3">
        <h6 class="fw-bold mb-2">💡 Quick Guide: How to File on the GST Portal</h6>
        <div class="row g-2 small text-muted">
            <div class="col-md-4">
                <strong>Step 1: Download GSTR-1 JSON</strong><br />
                Click the green button above to download <code>@($"GSTR1_{Model.Company.Gstin}_{Model.ReturnPeriodCode}.json")</code>.
            </div>
            <div class="col-md-4">
                <strong>Step 2: Upload to GST Portal</strong><br />
                Log in to <a href="https://services.gst.gov.in" target="_blank" class="text-decoration-none">gst.gov.in</a> &rarr; <em>Returns Dashboard</em> &rarr; Select <em>@Model.MonthName @Model.Year</em> &rarr; GSTR-1 &rarr; <em>Prepare Offline</em> &rarr; Click <em>Upload</em>.
            </div>
            <div class="col-md-4">
                <strong>Step 3: Verification & Filing</strong><br />
                All B2B invoices, B2CS summaries, HSN tables, and document series will populate automatically without any manual re-typing. Verify and generate summary to file with EVC / DSC.
            </div>
        </div>
    </div>
</div>
