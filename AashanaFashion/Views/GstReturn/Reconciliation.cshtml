@model AashanaFashion.Models.Gstr2bReconciliationViewModel
@{
    ViewData["Title"] = $"GSTR-2B ITC Matching — {Model.MonthName} {Model.Year}";
    int selectedYear = ViewBag.SelectedYear;
    int selectedMonth = ViewBag.SelectedMonth;
}

<div class="page-header">
    <div>
        <a asp-action="Index" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="page-back"><i class="bi bi-arrow-left"></i> GST returns</a>
        <h1 class="page-title">GSTR-2B ITC matching</h1>
        <p class="page-sub">Reconcile purchase bills against suppliers’ auto-drafted GSTR-2B to protect your input tax credit.</p>
    </div>
</div>

<form method="post" asp-action="ReconcileGstr2b" enctype="multipart/form-data" class="data-card mb-4">
    @Html.AntiForgeryToken()
    <div class="data-card-header">
        <div>
            <div class="data-card-title">Upload GSTR-2B statement</div>
            <div class="data-card-sub">JSON file downloaded from gst.gov.in for the selected period.</div>
        </div>
        @if (Model.HasUploadedFile && !string.IsNullOrEmpty(Model.FileName))
        {
            <span class="text-xs text-muted"><i class="bi bi-file-earmark-check text-success"></i> <span class="font-monospace">@Model.FileName</span> · @Model.MonthName @Model.Year</span>
        }
    </div>
    <div class="data-card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label" for="rcMonth">Tax month</label>
                <select id="rcMonth" name="month" class="af-input af-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == selectedMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="rcYear">Year</label>
                <select id="rcYear" name="year" class="af-input af-select">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                    {
                        <option value="@y" selected="@(y == selectedYear)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" for="rcFile">GSTR-2B JSON <span class="req">*</span></label>
                <input type="file" id="rcFile" name="gstr2bFile" class="af-input" accept=".json" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-arrow-left-right"></i> Run reconciliation</button>
            </div>
        </div>
    </div>
</form>

@if (Model.HasUploadedFile)
{
    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-label">Matched invoices</div>
            <div class="metric-value">@Model.MatchedCount</div>
            <div class="metric-meta success">₹@Model.SafeEligibleItc.ToString("N2") safe ITC to claim</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Missing in GSTR-2B</div>
            <div class="metric-value">@Model.MissingIn2bCount</div>
            <div class="metric-meta warning">₹@Model.AtRiskItc.ToString("N2") ITC at risk</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Missing in ERP</div>
            <div class="metric-value">@Model.MissingInErpCount</div>
            <div class="metric-meta info">supplier filed, bill not entered</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Value mismatch</div>
            <div class="metric-value">@Model.MismatchedCount</div>
            <div class="metric-meta danger">taxable value / tax differs</div>
        </div>
    </div>

    <div class="table-card">
        <div class="data-card-header">
            <div class="data-card-title">Reconciliation sheet</div>
            <span class="text-xs text-muted">@Model.Items.Count items</span>
        </div>
        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="es-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div class="es-title">Nothing to compare</div>
                <p>No records to compare for this tax period.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Supplier GSTIN</th>
                            <th>Supplier</th>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th class="text-end">ERP taxable</th>
                            <th class="text-end">ERP tax</th>
                            <th class="text-end">2B taxable</th>
                            <th class="text-end">2B tax</th>
                            <th class="text-end">Difference</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            bool matched = item.MatchStatus == "Matched";
                            bool missing2b = item.MatchStatus == "Missing in GSTR-2B";
                            bool missingErp = item.MatchStatus == "Missing in ERP";
                            <tr class="@(!matched && !missing2b && !missingErp ? "row-danger" : "")">
                                <td>
                                    @if (matched)
                                    {
                                        <span class="af-badge b-green">Matched</span>
                                    }
                                    else if (missing2b)
                                    {
                                        <span class="af-badge b-yellow">Missing in 2B</span>
                                    }
                                    else if (missingErp)
                                    {
                                        <span class="af-badge b-blue">In 2B only</span>
                                    }
                                    else
                                    {
                                        <span class="af-badge b-red">Mismatch</span>
                                    }
                                </td>
                                <td class="font-monospace text-xs text-foreground">@item.SupplierGstin</td>
                                <td class="text-foreground fw-medium">@item.SupplierName</td>
                                <td><span class="mono-id">@item.InvoiceNumber</span></td>
                                <td class="text-nowrap text-muted tabular">@(item.InvoiceDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="cell-num">₹@item.ErpTaxableValue.ToString("N2")</td>
                                <td class="cell-num text-foreground">₹@item.ErpTaxAmount.ToString("N2")</td>
                                <td class="cell-num">₹@item.Gstr2bTaxableValue.ToString("N2")</td>
                                <td class="cell-num text-foreground">₹@item.Gstr2bTaxAmount.ToString("N2")</td>
                                <td class="cell-num fw-semibold @(item.Difference == 0 ? "text-success" : "text-danger")">₹@item.Difference.ToString("N2")</td>
                                <td class="text-xs">
                                    @if (matched)
                                    {
                                        <span class="text-success">Eligible for GSTR-3B ITC</span>
                                    }
                                    else if (missing2b)
                                    {
                                        <span class="text-danger">Ask supplier to file GSTR-1</span>
                                    }
                                    else if (missingErp)
                                    {
                                        <a asp-controller="Purchase" asp-action="Create" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> Enter bill</a>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Review tax discrepancy</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span>Showing <strong>@Model.Items.Count</strong> items</span>
            </div>
        }
    </div>
}
else
{
    <div class="table-card">
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-cloud-arrow-up"></i></div>
            <div class="es-title">Upload a GSTR-2B statement to start</div>
            <p>You have <strong>@Model.TotalErpBillsCount purchase bills</strong> (₹@Model.TotalErpItc.ToString("N2") input tax credit) recorded for @Model.MonthName @Model.Year.</p>
        </div>
        <div class="data-card-body border-top">
            <span class="micro-label mb-2">Getting the GSTR-2B JSON</span>
            <ol class="step-list">
                <li>Sign in to the <a href="https://services.gst.gov.in" target="_blank" rel="noopener">GST portal</a> after the 14th of the month.</li>
                <li>Open <strong>Returns dashboard</strong> and pick the financial year and period (@Model.MonthName @Model.Year).</li>
                <li>Under <strong>Auto-drafted ITC statement (GSTR-2B)</strong>, click <strong>Download</strong>.</li>
                <li>Choose <strong>Generate JSON file to download</strong>, save it and upload it above.</li>
            </ol>
        </div>
    </div>
}
