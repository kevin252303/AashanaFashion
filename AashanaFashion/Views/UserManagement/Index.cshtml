@model IEnumerable<AashanaFashion.Models.AppUser>
@{
    ViewData["Title"] = "User List";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    bool canCreate = isAdmin || User.HasClaim("Permission.UserManagement.CanCreate", "true");
    bool canEdit   = isAdmin || User.HasClaim("Permission.UserManagement.CanEdit",   "true");
    bool canDelete = isAdmin || User.HasClaim("Permission.UserManagement.CanDelete", "true");
    bool filtered  = !string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.SelectedRole as string) || ViewBag.ActiveOnly == true;
    var roleDict   = ViewBag.UserRoles as Dictionary<string, int> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">User List</h1>
        <p class="page-sub">Manage who can sign in and what role they have</p>
    </div>
    @if (canCreate && ViewBag.IsQuotaFull != true)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add User</a>
        </div>
    }
</div>

@if (ViewBag.AllowedErpSeats != null)
{
    var activeSeats = (int)ViewBag.ActiveErpSeats;
    var allowedSeats = (int)ViewBag.AllowedErpSeats;
    var isFull = (bool)ViewBag.IsQuotaFull;

    <div class="af-alert @(isFull ? "af-alert-warning" : "af-alert-info")">
        <div class="alert-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <span class="alert-title">ERP desk user licence: @activeSeats of @allowedSeats seats active</span>
                @(isFull ? "Quota full — upgrade your subscription to add desk users." : $"{ViewBag.SeatsRemaining} seats remaining.")
            </div>
            <a asp-controller="Subscription" asp-action="Index" class="btn btn-sm btn-secondary"><i class="bi bi-cloud"></i> Subscription &amp; quotas</a>
        </div>
    </div>
}

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total users</div>
        <div class="metric-value">@Model.Count()</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Admins</div>
        <div class="metric-value">@Model.Count(u => u.Role == "Admin")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Managers</div>
        <div class="metric-value">@Model.Count(u => u.Role == "Manager")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Active</div>
        <div class="metric-value">@Model.Count(u => u.IsActive)</div>
        <div class="metric-meta success">can sign in</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search username, name, email, phone…" value="@ViewBag.Search" />
            </div>
            <select name="role" class="af-input af-select" onchange="this.form.submit()">
                <option value="">All roles</option>
                @if (ViewBag.Roles != null)
                {
                    @foreach (var r in (List<string>)ViewBag.Roles)
                    {
                        <option value="@r" selected="@(r == (string)ViewBag.SelectedRole)">@r</option>
                    }
                }
            </select>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnly" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="activeOnly">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 56px;">#</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Contact</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roleId = roleDict.TryGetValue(user.Role, out var rid) ? rid : 0;
                        var rc = user.Role switch { "Admin" => "b-red", "SuperAdmin" => "b-red", "Manager" => "b-yellow", _ => "b-purple" };
                        <tr>
                            <td class="text-muted tabular">@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="av-sm">@string.Concat(user.FullName.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper()</span>
                                    <div class="min-w-0">
                                        <span class="cell-title">@(!string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : user.FullName)</span>
                                        <span class="cell-sub">@user.FirstName @user.MiddleName @user.LastName</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="mono-id">@user.Username</span></td>
                            <td class="text-muted">@(user.Email ?? "—")</td>
                            <td class="text-muted">@(user.ContactNumber ?? "—")</td>
                            <td><span class="af-badge @rc" title="Role #@roleId">@user.Role</span></td>
                            <td>
                                @if (user.IsActive)
                                { <span class="af-badge b-green">Active</span> }
                                else
                                { <span class="af-badge b-gray">Inactive</span> }
                            </td>
                            <td class="cell-actions">
                                @if (canEdit || canDelete)
                                {
                                    <div class="row-actions">
                                        @if (canEdit)
                                        {
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="row-action @(user.IsActive ? "warning" : "success")" title="@(user.IsActive ? "Deactivate" : "Activate")" aria-label="@(user.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (canDelete)
                                        {
                                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Delete @user.Username?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="row-action danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-placeholder">View only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "user" : "users")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-people")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No users yet")</div>
            <p>@(filtered ? "No users match your filters." : "Add users so your team can sign in.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
        </div>
    }
</div>
