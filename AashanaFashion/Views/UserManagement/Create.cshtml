@model AashanaFashion.Models.UserFormViewModel
@{
    ViewData["Title"] = "Add New User";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="page-header">
            <div>
                <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Users</a>
                <h1 class="page-title">Add New User</h1>
                <p class="page-sub">Create a new system user with a role</p>
            </div>
        </div>
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">User details</span>
            </div>
            <div class="data-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="af-alert af-alert-danger mb-3">
                            <div class="alert-body">
                                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                { <div>@e.ErrorMessage</div> }
                            </div>
                            <button class="alert-close">&times;</button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-4 af-form-group">
                            <label asp-for="FirstName" class="af-label">First Name</label>
                            <input asp-for="FirstName" class="af-input" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="af-error"></span>
                        </div>
                        <div class="col-md-4 af-form-group">
                            <label asp-for="MiddleName" class="af-label">Middle Name</label>
                            <input asp-for="MiddleName" class="af-input" placeholder="Middle name (optional)" />
                        </div>
                        <div class="col-md-4 af-form-group">
                            <label asp-for="LastName" class="af-label">Last Name</label>
                            <input asp-for="LastName" class="af-input" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="af-error"></span>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DisplayName" class="af-label">Display Name</label>
                        <input asp-for="DisplayName" class="af-input" placeholder="Display name (optional)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 af-form-group">
                            <label asp-for="Username" class="af-label">Username</label>
                            <input asp-for="Username" class="af-input" placeholder="e.g. ali.hassan" />
                            <span asp-validation-for="Username" class="af-error"></span>
                        </div>
                        <div class="col-md-6 af-form-group">
                            <label asp-for="Email" class="af-label">Email</label>
                            <input asp-for="Email" class="af-input" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="af-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 af-form-group">
                            <label asp-for="ContactNumber" class="af-label">Contact Number</label>
                            <input asp-for="ContactNumber" class="af-input" placeholder="Phone number" />
                        </div>
                        <div class="col-md-6 af-form-group">
                            <label asp-for="Role" class="af-label">Role</label>
                            <select asp-for="Role" class="af-input af-select">
                                <option value="">— Select Role —</option>
                                @foreach (var r in Model.AvailableRoles)
                                {
                                    if (Model.Role == r.RoleName)
                                    {
                                        <option value="@r.RoleName" selected>@r.RoleName @(r.Description != null ? $"— {r.Description}" : "")</option>
                                    }
                                    else
                                    {
                                        <option value="@r.RoleName">@r.RoleName @(r.Description != null ? $"— {r.Description}" : "")</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Role" class="af-error"></span>
                            @if (!Model.AvailableRoles.Any())
                            {
                                <span class="af-hint text-warning">No roles found. <a asp-controller="Role" asp-action="Create">Create a role first</a>.</span>
                            }
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Address" class="af-label">Address</label>
                        <input asp-for="Address" class="af-input" placeholder="Address (optional)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 af-form-group">
                            <label asp-for="Password" class="af-label">Password</label>
                            <div class="input-with-action">
                                <input asp-for="Password" class="af-input" id="pwInput" placeholder="Min 6 characters" />
                                <button type="button" id="togglePw" class="input-action" aria-label="Show password"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="af-error"></span>
                        </div>
                        <div class="col-md-6 af-form-group">
                            <label asp-for="ConfirmPassword" class="af-label">Confirm Password</label>
                            <div class="input-with-action">
                                <input asp-for="ConfirmPassword" class="af-input" id="cpwInput" placeholder="Re-enter password" />
                                <button type="button" id="toggleCpw" class="input-action" aria-label="Show password"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="af-error"></span>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Active account</label>
                        </div>
                    </div>

                    <div class="form-footer">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('togglePw').onclick = function () {
            var i = document.getElementById('pwInput');
            i.type = i.type === 'password' ? 'text' : 'password';
        };
        document.getElementById('toggleCpw').onclick = function () {
            var i = document.getElementById('cpwInput');
            i.type = i.type === 'password' ? 'text' : 'password';
        };
    </script>
}
