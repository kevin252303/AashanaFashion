@model AashanaFashion.Models.UserRole
@{
    ViewData["Title"] = "New Role";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-xl-5">
        <div class="page-header">
            <div>
                <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Roles</a>
                <h1 class="page-title">New Role</h1>
                <p class="page-sub">Name the role now; assign module permissions next.</p>
            </div>
        </div>
        <div class="data-card">
            <div class="data-card-header">
                <span class="data-card-title">Role details</span>
            </div>
            <div class="data-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="af-alert af-alert-danger mb-3">
                            <div class="alert-body">
                                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                { <div>@e.ErrorMessage</div> }
                            </div>
                            <button class="alert-close">&times;</button>
                        </div>
                    }

                    <div class="af-form-group">
                        <label asp-for="RoleName" class="af-label">Role Name</label>
                        <input asp-for="RoleName" class="af-input" placeholder="e.g. Supervisor" />
                        <span asp-validation-for="RoleName" class="af-error"></span>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Description" class="af-label">Description</label>
                        <input asp-for="Description" class="af-input" placeholder="Optional description" />
                    </div>

                    <div class="af-form-group">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>

                    <div class="form-footer">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
