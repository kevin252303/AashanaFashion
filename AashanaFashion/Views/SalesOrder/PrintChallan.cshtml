@model AashanaFashion.Models.DeliveryChallan
@{
    Layout = null;
    var customer = Model.Customer;
    var order = Model.SalesOrder;
    var totalQuantity = Model.TotalQuantity;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Delivery Challan — @Model.ChallanNumber</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: #f1f5f9;
            color: #0f172a;
            padding: 20px;
        }
        .challan-container {
            max-width: 850px;
            margin: 0 auto;
            background: #ffffff;
            padding: 30px;
            border: 1px solid #cbd5e1;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .actions-bar {
            max-width: 850px;
            margin: 0 auto 15px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .btn {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .btn-primary { background: #2563eb; color: #fff; border-color: #1d4ed8; }
        .btn-ghost { background: #fff; color: #475569; border-color: #cbd5e1; }
        
        .header {
            display: flex;
            justify-content: space-between;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .brand-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #0f172a;
        }
        .brand-sub {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }
        .doc-badge {
            text-align: right;
        }
        .doc-title {
            font-size: 18px;
            font-weight: 700;
            color: #2563eb;
            text-transform: uppercase;
        }
        .doc-sub {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .info-card {
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 12px 16px;
        }
        .info-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 8px;
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 4px;
        }
        .info-row {
            display: flex;
            font-size: 13px;
            margin-bottom: 4px;
        }
        .info-label {
            width: 120px;
            color: #64748b;
            font-weight: 600;
        }
        .info-val {
            flex: 1;
            color: #0f172a;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 13px;
        }
        th {
            background: #f8fafc;
            color: #475569;
            text-align: left;
            padding: 8px 10px;
            border-top: 1px solid #cbd5e1;
            border-bottom: 2px solid #cbd5e1;
            font-weight: 700;
        }
        td {
            padding: 8px 10px;
            border-bottom: 1px solid #e2e8f0;
        }
        .text-center { text-align: center; }
        .text-end { text-align: right; }

        .total-row {
            background: #f8fafc;
            font-weight: 700;
            font-size: 14px;
            border-top: 2px solid #0f172a;
            border-bottom: 2px solid #0f172a;
        }

        .signatures {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-top: 50px;
            text-align: center;
        }
        .sig-box {
            border-top: 1px dashed #94a3b8;
            padding-top: 8px;
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
        }

        .footer-note {
            margin-top: 30px;
            padding-top: 12px;
            border-top: 1px solid #e2e8f0;
            font-size: 11px;
            color: #94a3b8;
            text-align: center;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .challan-container {
                border: none;
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            .actions-bar {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="actions-bar">
        <button onclick="window.print()" class="btn btn-primary">🖨 Print Delivery Challan</button>
        <button onclick="window.close()" class="btn btn-ghost">Close</button>
    </div>

    <div class="challan-container">
        <!-- Header -->
        <div class="header">
            <div>
                <div class="brand-title">AASHANA FASHION</div>
                <div class="brand-sub">Apparel Manufacturing & Job-Work Production</div>
            </div>
            <div class="doc-badge">
                <div class="doc-title">Delivery Challan</div>
                <div class="doc-sub">Packing Slip / Dispatch Memo</div>
            </div>
        </div>

        <!-- Meta Grid -->
        <div class="meta-grid">
            <!-- Consignee / Deliver To -->
            <div class="info-card">
                <div class="info-title">Consignee / Deliver To</div>
                <div class="info-row">
                    <span class="info-label">Customer:</span>
                    <span class="info-val"><strong>@customer?.CustomerName</strong></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Contact:</span>
                    <span class="info-val">@(customer?.ContactPerson ?? "—") (@(customer?.Phone ?? "—"))</span>
                </div>
                <div class="info-row">
                    <span class="info-label">GSTIN:</span>
                    <span class="info-val">@(customer?.GstNumber ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Address:</span>
                    <span class="info-val">@(string.IsNullOrEmpty(Model.ShippingAddress) ? customer?.Address : Model.ShippingAddress)</span>
                </div>
            </div>

            <!-- Dispatch & Transport -->
            <div class="info-card">
                <div class="info-title">Dispatch & Transport Details</div>
                <div class="info-row">
                    <span class="info-label">Challan No:</span>
                    <span class="info-val"><strong>@Model.ChallanNumber</strong></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date:</span>
                    <span class="info-val">@Model.ChallanDate.ToString("dd-MMM-yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Order Ref:</span>
                    <span class="info-val">@order?.SoNumber @(!string.IsNullOrEmpty(order?.CustomerPoReference) ? $"(PO: {order.CustomerPoReference})" : "")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Transporter:</span>
                    <span class="info-val">@(Model.TransporterName ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Vehicle No:</span>
                    <span class="info-val">@(Model.VehicleNumber ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">LR / Docket #:</span>
                    <span class="info-val">@(Model.LrNumber ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">E-Way Bill #:</span>
                    <span class="info-val">@(Model.EwayBillNumber ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Total Boxes:</span>
                    <span class="info-val"><strong>@Model.NumberOfBoxes Parcel(s)</strong></span>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <table>
            <thead>
                <tr>
                    <th style="width: 40px;" class="text-center">Sr</th>
                    <th>Product / Design Number</th>
                    <th>Colour</th>
                    <th>Size</th>
                    <th class="text-end" style="width: 100px;">Quantity (Pcs)</th>
                    <th>Package Remarks</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var sr = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">@(sr++)</td>
                            <td><strong>@item.DesignNumber</strong></td>
                            <td>@(string.IsNullOrEmpty(item.Colour) ? "—" : item.Colour)</td>
                            <td>@(string.IsNullOrEmpty(item.Size) ? "—" : item.Size)</td>
                            <td class="text-end" style="font-weight: 700;">@item.QuantityDispatched</td>
                            <td>@(item.Remarks ?? "—")</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="total-row">
                    <td colspan="4" class="text-end">Total Dispatched Quantity:</td>
                    <td class="text-end">@totalQuantity Pcs</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="font-size: 12px; color: #475569; margin-bottom: 20px; background: #f8fafc; padding: 10px; border-radius: 4px; border: 1px solid #e2e8f0;">
                <strong>Dispatch Notes:</strong> @Model.Notes
            </div>
        }

        <!-- Signatures -->
        <div class="signatures">
            <div class="sig-box">Prepared By (@(Model.DispatchedBy ?? "Warehouse"))</div>
            <div class="sig-box">Checked & Verified By</div>
            <div class="sig-box">Receiver's Signature & Stamp</div>
        </div>

        <div class="footer-note">
            This Delivery Challan confirms the dispatch and handover of goods to the transporter/consignee. Subject to local jurisdiction.
        </div>
    </div>

</body>
</html>
