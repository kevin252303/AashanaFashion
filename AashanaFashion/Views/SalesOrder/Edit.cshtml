@model AashanaFashion.Models.SalesOrderViewModel
@{
    ViewData["Title"] = $"Edit Sales Order — {Model.SoNumber}";
    var customers = ViewBag.Customers as List<AashanaFashion.Models.Customer> ?? new();
    var designs = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new();
    var colours = ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new();
    var sizes = ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new();
    var pricelists = ViewBag.Pricelists as List<AashanaFashion.Models.Pricelist> ?? new();
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="page-back"><i class="bi bi-arrow-left"></i> @Model.SoNumber</a>
        <h1 class="page-title">Edit sales order</h1>
        <p class="page-sub">Update items, schedule or pricing for <span class="font-monospace">@Model.SoNumber</span>.</p>
    </div>
</div>

<form asp-action="Edit" method="post" id="soForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SoNumber" />

    <div asp-validation-summary="All" class="af-alert af-alert-danger"></div>

    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Order details</div>
                <div class="data-card-sub">Picking a customer fills address, transporter, terms and pricelist.</div>
            </div>
        </div>
        <div class="data-card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label">SO number</label>
                <input class="af-input font-monospace fw-semibold" value="@Model.SoNumber" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label d-flex justify-content-between align-items-center">
                    <span>Customer <span class="req">*</span></span>
                    <span class="af-badge b-indigo d-none" id="customerPricelistBadge">Pricelist</span>
                </label>
                <select asp-for="CustomerId" class="af-input af-select" id="customerSelect" required>
                    <option value="">Select customer</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CustomerId ? "selected" : null)">
                            @c.CustomerName @(!string.IsNullOrEmpty(c.City) ? $"({c.City})" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="label-row">
                    <label class="form-label" for="soPricelistSelect">Pricelist</label>
                    <span class="d-inline-flex gap-3">
                        <button type="button" class="label-action" data-bs-toggle="modal" data-bs-target="#quickPricelistModal" title="Create a new pricelist"><i class="bi bi-plus-lg"></i> New</button>
                        <button type="button" class="label-action @(!Model.PricelistId.HasValue ? "d-none" : "")" id="btnEditSelectedPricelist" data-bs-toggle="modal" data-bs-target="#editPricelistModal" title="Edit the selected pricelist"><i class="bi bi-pencil"></i> Edit</button>
                    </span>
                </div>
                <select asp-for="PricelistId" class="af-input af-select" id="soPricelistSelect">
                    <option value="">Standard / base price</option>
                    @foreach (var pl in pricelists)
                    {
                        <option value="@pl.Id" selected="@(pl.Id == Model.PricelistId ? "selected" : null)">
                            @pl.Name (@pl.DiscountPolicyDisplay)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select asp-for="Status" class="af-input af-select">
                    @foreach (var s in Enum.GetValues<SalesOrderStatus>())
                    {
                        <option value="@s" selected="@(s == Model.Status ? "selected" : null)">@s.Humanize()</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Customer PO ref</label>
                <input asp-for="CustomerPoReference" class="af-input" placeholder="e.g. PO-8891" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Order date <span class="req">*</span></label>
                <input asp-for="OrderDate" type="date" class="af-input" value="@Model.OrderDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Expected delivery</label>
                <input asp-for="ExpectedDeliveryDate" type="date" class="af-input" value="@(Model.ExpectedDeliveryDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Transporter / courier</label>
                <input asp-for="TransporterName" class="af-input" id="transporterInput" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Delivery address</label>
                <input asp-for="ShippingAddress" class="af-input" id="shippingAddressInput" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Payment terms</label>
                <input asp-for="PaymentTerms" class="af-input" id="paymentTermsInput" />
            </div>
            <div class="col-12">
                <label class="form-label">Notes / instructions</label>
                <input asp-for="Notes" class="af-input" />
            </div>
        </div>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Line items</div>
                <div class="data-card-sub">Design, colour, size and quantity.</div>
            </div>
            <div class="btn-row">
                <button type="button" id="btnReapplyPricelist" class="btn btn-sm btn-secondary" title="Recalculate rates &amp; discounts for all items using the selected pricelist">
                    <i class="bi bi-arrow-repeat"></i> Apply pricelist
                </button>
                <button type="button" id="addRowBtn" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> Add item</button>
            </div>
        </div>
            <div class="table-scroll">
                <table class="af-table table-edit" id="itemsTable" style="min-width: 1000px;">
                    <thead>
                        <tr>
                            <th style="width: 44px;" class="text-center">#</th>
                            <th style="min-width: 200px;">Design <span class="req">*</span></th>
                            <th style="width: 140px;">Colour</th>
                            <th style="width: 110px;">Size</th>
                            <th style="width: 90px;" class="text-end">Qty <span class="req">*</span></th>
                            <th style="width: 120px;" class="text-end">Rate (₹) <span class="req">*</span></th>
                            <th style="width: 90px;" class="text-end">Disc %</th>
                            <th style="width: 90px;" class="text-end">GST %</th>
                            <th style="width: 120px;" class="text-end">Gross (₹)</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @for (int i = 0; i < Model.Details.Count; i++)
                        {
                            var d = Model.Details[i];
                            <tr class="item-row">
                                <td class="text-center sr-no">@(i + 1)</td>
                                <td>
                                    <input type="hidden" name="Details[@i].Id" value="@d.Id" />
                                    <select name="Details[@i].DesignId" class="af-input af-input-sm af-select item-design" required>
                                        <option value="">Select design</option>
                                        @foreach (var des in designs)
                                        {
                                            <option value="@des.Id" data-number="@des.DesignNumber" data-rate="@des.SalesPrice" data-discontinued="@des.Discontinued.ToString().ToLower()" selected="@(des.Id == d.DesignId ? "selected" : null)">
                                                @des.DesignNumber (₹@des.SalesPrice.ToString("N2")) @(des.Discontinued ? "· discontinued" : "")
                                            </option>
                                        }
                                    </select>
                                    <input type="hidden" name="Details[@i].DesignNumber" class="item-design-number" value="@d.DesignNumber" />
                                    <div class="item-discontinued-notice mt-1 text-xs" style="display:none;"></div>
                                </td>
                                <td>
                                    <input type="text" name="Details[@i].Colour" class="af-input af-input-sm item-colour" value="@d.Colour" list="coloursList" />
                                </td>
                                <td>
                                    <input type="text" name="Details[@i].Size" class="af-input af-input-sm item-size" value="@d.Size" list="sizesList" />
                                </td>
                                <td>
                                    <input type="number" min="1" name="Details[@i].Quantity" class="af-input af-input-sm text-end item-qty" value="@d.Quantity" required />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" name="Details[@i].UnitPrice" class="af-input af-input-sm text-end item-rate" value="@d.UnitPrice" required />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="100" name="Details[@i].DiscountPercentage" class="af-input af-input-sm text-end item-disc" value="@d.DiscountPercentage" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="100" name="Details[@i].GstPercentage" class="af-input af-input-sm text-end item-gst" value="@d.GstPercentage" />
                                </td>
                                <td class="cell-num text-foreground fw-semibold item-net">₹@d.NetAmount.ToString("N2")</td>
                                <td class="text-center">
                                    <button type="button" class="row-action danger remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    </div>

    <div class="row g-4 justify-content-end mb-4">
        <div class="col-md-6 col-lg-5">
            <div class="data-card">
                <div class="data-card-header">
                    <div class="data-card-title">Order total &amp; discounts</div>
                </div>
                <div class="data-card-body">
                    <div class="kv-row"><span class="k">Items Subtotal</span><span class="v" id="subtotalDisplay">₹0.00</span></div>

                    <!-- Whole Order Agent Discount Toggle & Configuration -->
                    <div class="panel-inset p-2 my-2 border rounded-2">
                        <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="HasAgentDiscount" id="chkAgentDiscount" />
                            <label class="form-check-label fw-semibold text-sm cursor-pointer" for="chkAgentDiscount">
                                <i class="bi bi-tag text-primary me-1"></i> Agent discount (whole order)
                            </label>
                        </div>

                        <div id="agentDiscountBox" class="mt-2 pt-2 border-top @(Model.HasAgentDiscount ? "" : "d-none")">
                            <div class="row g-2 align-items-center">
                                <div class="col-5">
                                    <label class="text-xs text-muted mb-1 d-block" for="agentDiscountType">Type</label>
                                    <select asp-for="AgentDiscountType" class="af-input af-input-sm af-select" id="agentDiscountType">
                                        <option value="0" selected="@((int)Model.AgentDiscountType == 0 ? "selected" : null)">Percentage (%)</option>
                                        <option value="1" selected="@((int)Model.AgentDiscountType == 1 ? "selected" : null)">Fixed amount (₹)</option>
                                    </select>
                                </div>
                                <div class="col-7">
                                    <label class="text-xs text-muted mb-1 d-block" for="agentDiscountRate">Discount value</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text font-monospace text-xs" id="agentDiscountUnit">@((int)Model.AgentDiscountType == 1 ? "₹" : "%")</span>
                                        <input type="number" step="0.01" min="0" asp-for="AgentDiscountRate" class="af-input af-input-sm text-end font-monospace" id="agentDiscountRate" placeholder="0.00" value="@Model.AgentDiscountRate" />
                                    </div>
                                </div>
                            </div>
                            <div class="text-xs text-muted mt-1 d-flex justify-content-between align-items-center">
                                <span>Deducted from subtotal:</span>
                                <span id="agentDiscountCalcBadge" class="text-danger fw-semibold">-₹@Model.AgentDiscountAmount.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="kv-row text-danger @(Model.HasAgentDiscount ? "" : "d-none")" id="agentDiscountRow">
                        <span class="k text-danger">Agent discount</span>
                        <span class="v text-danger tabular fw-semibold" id="agentDiscountDisplay">-₹@Model.AgentDiscountAmount.ToString("N2")</span>
                    </div>

                    <div class="kv-row @(Model.HasAgentDiscount ? "" : "d-none")" id="netSubtotalRow">
                        <span class="k">Net subtotal</span>
                        <span class="v tabular fw-semibold" id="netSubtotalDisplay">₹0.00</span>
                    </div>

                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="transportCharge">Transport charge (₹)</label>
                        <input type="number" step="0.01" min="0" asp-for="TransportCharge" class="af-input af-input-sm text-end" id="transportCharge" style="width: 120px;" value="@Model.TransportCharge" />
                    </div>
                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="transportGST">Transport GST %</label>
                        <input type="number" step="0.01" min="0" max="100" asp-for="TransportChargeGST" class="af-input af-input-sm text-end" id="transportGST" style="width: 120px;" value="@Model.TransportChargeGST" />
                    </div>
                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="roundOff">Round off (₹)</label>
                        <input type="number" step="0.01" asp-for="RoundOff" class="af-input af-input-sm text-end" id="roundOff" style="width: 120px;" value="@Model.RoundOff" />
                    </div>
                    <div class="bill-total"><span class="k">Grand total</span><span class="v" id="grandTotalDisplay">₹@Model.TotalAmount.ToString("N2")</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Update sales order</button>
    </div>
</form>

<!-- Quick Create Pricelist Modal -->
<div class="modal fade" id="quickPricelistModal" tabindex="-1" aria-labelledby="quickPricelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickPricelistModalLabel">New pricelist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="quickPlAlert" class="af-alert af-alert-danger d-none" role="alert"></div>
                
                <div class="mb-3">
                    <label class="form-label">Pricelist name <span class="req">*</span></label>
                    <input type="text" id="quickPlName" class="af-input" placeholder="e.g. VIP Wholesale (10% Off)" required />
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Discount policy</label>
                        <select id="quickPlPolicy" class="af-input af-select">
                            <option value="0">Discount included in price</option>
                            <option value="1">Show discount % to customer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Discount type</label>
                        <select id="quickPlMethod" class="af-input af-select">
                            <option value="1">Percentage (%)</option>
                            <option value="0">Fixed Price (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6" id="quickPlPctCol">
                        <label class="form-label">Discount %</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.1" min="0" max="100" id="quickPlDiscount" class="af-input text-end" value="10" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="quickPlFixedCol">
                        <label class="form-label">Fixed price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0" id="quickPlFixed" class="af-input text-end" value="0.00" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Min quantity</label>
                        <input type="number" step="1" min="1" id="quickPlMinQty" class="af-input text-center" value="1" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Description / notes</label>
                    <textarea id="quickPlDesc" class="af-input" rows="2" placeholder="Optional notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuickPricelist">Save &amp; Select</button>
            </div>
        </div>
    </div>
</div>

<!-- Quick Edit Pricelist Modal -->
<div class="modal fade" id="editPricelistModal" tabindex="-1" aria-labelledby="editPricelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPricelistModalLabel">Edit pricelist rules</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="editPlAlert" class="af-alert af-alert-danger d-none" role="alert"></div>
                <input type="hidden" id="editPlId" />
                
                <div class="mb-3">
                    <label class="form-label">Pricelist name <span class="req">*</span></label>
                    <input type="text" id="editPlName" class="af-input" required />
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Discount policy</label>
                        <select id="editPlPolicy" class="af-input af-select">
                            <option value="0">Discount included in price</option>
                            <option value="1">Show discount % to customer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Discount type</label>
                        <select id="editPlMethod" class="af-input af-select">
                            <option value="1">Percentage (%)</option>
                            <option value="0">Fixed Price (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6" id="editPlPctCol">
                        <label class="form-label">Discount %</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.1" min="0" max="100" id="editPlDiscount" class="af-input text-end" value="0" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="editPlFixedCol">
                        <label class="form-label">Fixed price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0" id="editPlFixed" class="af-input text-end" value="0.00" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Min quantity</label>
                        <input type="number" step="1" min="1" id="editPlMinQty" class="af-input text-center" value="1" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Description / notes</label>
                    <textarea id="editPlDesc" class="af-input" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdatePricelist">Save &amp; Re-apply</button>
            </div>
        </div>
    </div>
</div>

<datalist id="coloursList">
    @foreach (var c in colours) { <option value="@c.ColourName" /> }
</datalist>
<datalist id="sizesList">
    @foreach (var s in sizes) { <option value="@s.SizeName" /> }
</datalist>

<template id="designOptionsTemplate">
    <option value="">Select design</option>
    @foreach (var d in designs)
    {
        <option value="@d.Id" data-number="@d.DesignNumber" data-rate="@d.SalesPrice" data-discontinued="@d.Discontinued.ToString().ToLower()">
            @d.DesignNumber (₹@d.SalesPrice.ToString("N2")) @(d.Discontinued ? "· discontinued" : "")
        </option>
    }
</template>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const customerSelect = document.getElementById('customerSelect');
    const soPricelistSelect = document.getElementById('soPricelistSelect');
    const btnEditPricelist = document.getElementById('btnEditSelectedPricelist');
    const btnReapplyPricelist = document.getElementById('btnReapplyPricelist');

    const shippingAddress = document.getElementById('shippingAddressInput');
    const transporterInput = document.getElementById('transporterInput');
    const paymentTermsInput = document.getElementById('paymentTermsInput');

    const itemsBody = document.getElementById('itemsBody');
    const addRowBtn = document.getElementById('addRowBtn');

    const subtotalDisplay = document.getElementById('subtotalDisplay');
    const grandTotalDisplay = document.getElementById('grandTotalDisplay');
    const transportChargeInput = document.getElementById('transportCharge');
    const transportGSTInput = document.getElementById('transportGST');
    const roundOffInput = document.getElementById('roundOff');

    const chkAgentDiscount = document.getElementById('chkAgentDiscount');
    const agentDiscountBox = document.getElementById('agentDiscountBox');
    const agentDiscountRow = document.getElementById('agentDiscountRow');
    const netSubtotalRow = document.getElementById('netSubtotalRow');
    const agentDiscountTypeSelect = document.getElementById('agentDiscountType');
    const agentDiscountRateInput = document.getElementById('agentDiscountRate');
    const agentDiscountUnit = document.getElementById('agentDiscountUnit');
    const agentDiscountCalcBadge = document.getElementById('agentDiscountCalcBadge');
    const agentDiscountDisplay = document.getElementById('agentDiscountDisplay');
    const netSubtotalDisplay = document.getElementById('netSubtotalDisplay');

    chkAgentDiscount?.addEventListener('change', function () {
        const checked = this.checked;
        if (agentDiscountBox) agentDiscountBox.classList.toggle('d-none', !checked);
        if (agentDiscountRow) agentDiscountRow.classList.toggle('d-none', !checked);
        if (netSubtotalRow) netSubtotalRow.classList.toggle('d-none', !checked);
        recalc();
    });

    agentDiscountTypeSelect?.addEventListener('change', function () {
        if (agentDiscountUnit) agentDiscountUnit.textContent = this.value === "1" ? "₹" : "%";
        recalc();
    });

    agentDiscountRateInput?.addEventListener('input', recalc);

    const designOptions = document.getElementById('designOptionsTemplate').innerHTML;

    function fmt(n) {
        return '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function getCurrentPricelistId() {
        return soPricelistSelect?.value ? parseInt(soPricelistSelect.value) : null;
    }

    function updateEditButtonVisibility() {
        const plId = getCurrentPricelistId();
        if (btnEditPricelist) {
            btnEditPricelist.classList.toggle('d-none', !plId);
        }
    }

    function applyPricelistToRow(row) {
        const designSelect = row.querySelector('.item-design');
        const designId = designSelect?.value;
        const qty = parseFloat(row.querySelector('.item-qty')?.value) || 1;
        const rateInput = row.querySelector('.item-rate');
        const discInput = row.querySelector('.item-disc');
        const colourInput = row.querySelector('.item-colour');
        const sizeInput = row.querySelector('.item-size');
        const colour = colourInput?.value?.trim() || '';
        const size = sizeInput?.value?.trim() || '';

        if (!designId) return;

        const plId = getCurrentPricelistId();
        const plParam = plId ? `pricelistId=${plId}` : 'pricelistId=';
        fetch(`/Pricelist/CalculatePrice?${plParam}&designId=${designId}&quantity=${qty}&colour=${encodeURIComponent(colour)}&size=${encodeURIComponent(size)}`)
            .then(res => res.json())
            .then(res => {
                if (res) {
                    if (rateInput && res.unitPrice > 0) rateInput.value = res.unitPrice.toFixed(2);
                    if (discInput) discInput.value = (res.discountPercentage || 0).toFixed(2);
                    recalc();
                }
            })
            .catch(console.error);
    }

    function applyPricelistToAllRows() {
        document.querySelectorAll('#itemsBody .item-row').forEach(applyPricelistToRow);
    }

    customerSelect?.addEventListener('change', function () {
        const id = this.value;
        if (!id) {
            if (soPricelistSelect) soPricelistSelect.value = '';
            updateEditButtonVisibility();
            applyPricelistToAllRows();
            return;
        }
        fetch('/SalesOrder/GetCustomerDetails?id=' + id)
            .then(res => res.json())
            .then(data => {
                if (shippingAddress && data.shippingAddress) shippingAddress.value = data.shippingAddress;
                if (transporterInput && data.transporter) transporterInput.value = data.transporter;
                if (paymentTermsInput && data.paymentTerms) paymentTermsInput.value = data.paymentTerms;

                if (soPricelistSelect && data.pricelistId) {
                    soPricelistSelect.value = data.pricelistId;
                }
                updateEditButtonVisibility();
                applyPricelistToAllRows();
            })
            .catch(console.error);
    });

    soPricelistSelect?.addEventListener('change', function () {
        updateEditButtonVisibility();
        applyPricelistToAllRows();
    });

    btnReapplyPricelist?.addEventListener('click', function () {
        applyPricelistToAllRows();
    });

    // Quick Create Modal controls
    document.getElementById('quickPlMethod')?.addEventListener('change', function () {
        const isPct = this.value === '1';
        document.getElementById('quickPlPctCol').classList.toggle('d-none', !isPct);
        document.getElementById('quickPlFixedCol').classList.toggle('d-none', isPct);
    });

    document.getElementById('btnSaveQuickPricelist')?.addEventListener('click', function () {
        const name = document.getElementById('quickPlName').value.trim();
        const alertBox = document.getElementById('quickPlAlert');
        if (!name) {
            alertBox.textContent = 'Please enter a pricelist name.';
            alertBox.classList.remove('d-none');
            return;
        }

        const payload = {
            name: name,
            discountPolicy: parseInt(document.getElementById('quickPlPolicy').value),
            computationMethod: parseInt(document.getElementById('quickPlMethod').value),
            discountPercentage: parseFloat(document.getElementById('quickPlDiscount').value) || 0,
            fixedPrice: parseFloat(document.getElementById('quickPlFixed').value) || 0,
            minQuantity: parseFloat(document.getElementById('quickPlMinQty').value) || 1,
            description: document.getElementById('quickPlDesc').value.trim()
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Pricelist/QuickCreate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, body: data })))
        .then(res => {
            if (!res.body.success) {
                alertBox.textContent = res.body.message || 'Error creating pricelist.';
                alertBox.classList.remove('d-none');
                return;
            }

            // Add to select and select it
            const opt = new Option(`${res.body.name} (${res.body.policy})`, res.body.id, true, true);
            soPricelistSelect.add(opt);
            soPricelistSelect.value = res.body.id;
            updateEditButtonVisibility();

            // Close modal
            const modalEl = document.getElementById('quickPricelistModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            alertBox.classList.add('d-none');
            document.getElementById('quickPlName').value = '';
            document.getElementById('quickPlDesc').value = '';

            applyPricelistToAllRows();
        })
        .catch(err => {
            alertBox.textContent = 'Server error creating pricelist.';
            alertBox.classList.remove('d-none');
            console.error(err);
        });
    });

    // Quick Edit Modal controls
    document.getElementById('editPlMethod')?.addEventListener('change', function () {
        const isPct = this.value === '1';
        document.getElementById('editPlPctCol').classList.toggle('d-none', !isPct);
        document.getElementById('editPlFixedCol').classList.toggle('d-none', isPct);
    });

    btnEditPricelist?.addEventListener('click', function () {
        const plId = getCurrentPricelistId();
        if (!plId) return;

        const alertBox = document.getElementById('editPlAlert');
        alertBox.classList.add('d-none');

        fetch('/Pricelist/GetQuickDetails?id=' + plId)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('editPlId').value = data.id;
                    document.getElementById('editPlName').value = data.name;
                    document.getElementById('editPlPolicy').value = data.discountPolicy;
                    document.getElementById('editPlMethod').value = data.computationMethod;
                    document.getElementById('editPlDiscount').value = data.discountPercentage || 0;
                    document.getElementById('editPlFixed').value = (data.fixedPrice || 0).toFixed(2);
                    document.getElementById('editPlMinQty').value = data.minQuantity || 1;
                    document.getElementById('editPlDesc').value = data.description || '';

                    const isPct = data.computationMethod === 1;
                    document.getElementById('editPlPctCol').classList.toggle('d-none', !isPct);
                    document.getElementById('editPlFixedCol').classList.toggle('d-none', isPct);
                }
            })
            .catch(console.error);
    });

    document.getElementById('btnUpdatePricelist')?.addEventListener('click', function () {
        const id = parseInt(document.getElementById('editPlId').value);
        const name = document.getElementById('editPlName').value.trim();
        const alertBox = document.getElementById('editPlAlert');

        if (!name) {
            alertBox.textContent = 'Please enter a pricelist name.';
            alertBox.classList.remove('d-none');
            return;
        }

        const payload = {
            id: id,
            name: name,
            discountPolicy: parseInt(document.getElementById('editPlPolicy').value),
            computationMethod: parseInt(document.getElementById('editPlMethod').value),
            discountPercentage: parseFloat(document.getElementById('editPlDiscount').value) || 0,
            fixedPrice: parseFloat(document.getElementById('editPlFixed').value) || 0,
            minQuantity: parseFloat(document.getElementById('editPlMinQty').value) || 1,
            description: document.getElementById('editPlDesc').value.trim()
        };

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Pricelist/QuickUpdate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json().then(data => ({ status: res.status, body: data })))
        .then(res => {
            if (!res.body.success) {
                alertBox.textContent = res.body.message || 'Error updating pricelist.';
                alertBox.classList.remove('d-none');
                return;
            }

            // Update text in select
            const opt = soPricelistSelect.querySelector(`option[value="${id}"]`);
            if (opt) {
                opt.textContent = `${res.body.name} (${res.body.policy})`;
            }

            // Close modal
            const modalEl = document.getElementById('editPricelistModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            applyPricelistToAllRows();
        })
        .catch(err => {
            alertBox.textContent = 'Server error updating pricelist.';
            alertBox.classList.remove('d-none');
            console.error(err);
        });
    });

    function reindex() {
        const rows = itemsBody.querySelectorAll('.item-row');
        rows.forEach((row, idx) => {
            row.querySelectorAll('select, input').forEach(el => {
                const name = el.getAttribute('name');
                if (name) el.setAttribute('name', name.replace(/\[\d+\]/, '[' + idx + ']'));
            });
            const sr = row.querySelector('.sr-no');
            if (sr) sr.textContent = idx + 1;
            const removeBtn = row.querySelector('.remove-row');
            if (removeBtn) removeBtn.style.display = rows.length > 1 ? '' : 'none';
        });
    }

    function recalc() {
        let subtotal = 0;
        itemsBody.querySelectorAll('.item-row').forEach(row => {
            const qty = parseFloat(row.querySelector('.item-qty')?.value) || 0;
            const rate = parseFloat(row.querySelector('.item-rate')?.value) || 0;
            const disc = parseFloat(row.querySelector('.item-disc')?.value) || 0;
            const gst = parseFloat(row.querySelector('.item-gst')?.value) || 0;

            const total = qty * rate;
            const discAmt = total * disc / 100;
            const gstAmt = (total - discAmt) * gst / 100;
            const net = total - discAmt + gstAmt;

            const netEl = row.querySelector('.item-net');
            if (netEl) netEl.textContent = fmt(net);

            subtotal += net;
        });

        // Whole Order Agent Discount calculation & deduction
        const hasAgentDisc = chkAgentDiscount?.checked || false;
        const discType = agentDiscountTypeSelect?.value || "0";
        const discRate = parseFloat(agentDiscountRateInput?.value) || 0;

        let agentDiscAmt = 0;
        if (hasAgentDisc && discRate > 0) {
            if (discType === "0") {
                agentDiscAmt = subtotal * (discRate / 100);
            } else {
                agentDiscAmt = Math.min(subtotal, discRate);
            }
        }

        const netSubtotal = Math.max(0, subtotal - agentDiscAmt);

        if (agentDiscountCalcBadge) agentDiscountCalcBadge.textContent = '-' + fmt(agentDiscAmt);
        if (agentDiscountDisplay) agentDiscountDisplay.textContent = '-' + fmt(agentDiscAmt);
        if (netSubtotalDisplay) netSubtotalDisplay.textContent = fmt(netSubtotal);

        const tc = parseFloat(transportChargeInput?.value) || 0;
        const tg = parseFloat(transportGSTInput?.value) || 0;
        const effTransport = tc + (tc * tg / 100);
        const ro = parseFloat(roundOffInput?.value) || 0;
        const grandTotal = netSubtotal + effTransport + ro;

        if (subtotalDisplay) subtotalDisplay.textContent = fmt(subtotal);
        if (grandTotalDisplay) grandTotalDisplay.textContent = fmt(grandTotal);
    }

    function checkDiscontinuedStatus(row) {
        const designSelect = row.querySelector('.item-design');
        const designId = designSelect?.value;
        const colour = row.querySelector('.item-colour')?.value?.trim() || '';
        const size = row.querySelector('.item-size')?.value?.trim() || '';
        const noticeEl = row.querySelector('.item-discontinued-notice');
        const qtyInput = row.querySelector('.item-qty');

        if (!designId) {
            if (noticeEl) { noticeEl.style.display = 'none'; noticeEl.innerHTML = ''; }
            return;
        }

        fetch(`/SalesOrder/CheckItemStockAndDiscontinued?designId=${designId}&colour=${encodeURIComponent(colour)}&size=${encodeURIComponent(size)}`)
            .then(res => res.json())
            .then(data => {
                if (!noticeEl) return;
                if (data.isDiscontinued) {
                    noticeEl.style.display = 'block';
                    if (!data.canSell) {
                        noticeEl.innerHTML = '<span class="text-danger fw-semibold"><i class="bi bi-slash-circle"></i> Discontinued with zero stock — cannot order.</span>';
                        if (qtyInput) {
                            qtyInput.classList.add('border-danger');
                            qtyInput.title = 'Item is discontinued and out of stock';
                        }
                    } else {
                        noticeEl.innerHTML = `<span class="af-badge b-yellow">Discontinued · ${data.stockOnHand} pcs in stock</span>`;
                        if (qtyInput) {
                            qtyInput.classList.remove('border-danger');
                            qtyInput.max = data.stockOnHand;
                            qtyInput.title = `Maximum sellable stock: ${data.stockOnHand} pcs`;
                        }
                    }
                } else {
                    noticeEl.style.display = 'none';
                    noticeEl.innerHTML = '';
                    if (qtyInput) {
                        qtyInput.classList.remove('border-danger');
                        qtyInput.removeAttribute('max');
                        qtyInput.title = '';
                    }
                }
            })
            .catch(console.error);
    }

    function bindRow(row) {
        const designSelect = row.querySelector('.item-design');
        const designNumInput = row.querySelector('.item-design-number');
        const rateInput = row.querySelector('.item-rate');

        designSelect?.addEventListener('change', function () {
            const opt = this.selectedOptions[0];
            if (opt && opt.value) {
                if (designNumInput) designNumInput.value = opt.getAttribute('data-number') || '';
                const rate = parseFloat(opt.getAttribute('data-rate')) || 0;
                if (rateInput && (!rateInput.value || parseFloat(rateInput.value) === 0)) {
                    rateInput.value = rate.toFixed(2);
                }
                applyPricelistToRow(row);
                checkDiscontinuedStatus(row);
            } else if (designNumInput) {
                designNumInput.value = '';
                checkDiscontinuedStatus(row);
            }
            recalc();
        });

        row.querySelector('.item-qty')?.addEventListener('input', function () {
            applyPricelistToRow(row);
            recalc();
        });
        row.querySelector('.item-colour')?.addEventListener('change', function () {
            applyPricelistToRow(row);
            checkDiscontinuedStatus(row);
        });
        row.querySelector('.item-size')?.addEventListener('change', function () {
            applyPricelistToRow(row);
            checkDiscontinuedStatus(row);
        });
        row.querySelector('.item-rate')?.addEventListener('input', recalc);
        row.querySelector('.item-disc')?.addEventListener('input', recalc);
        row.querySelector('.item-gst')?.addEventListener('input', recalc);

        row.querySelector('.remove-row')?.addEventListener('click', function () {
            row.remove();
            reindex();
            recalc();
        });

        checkDiscontinuedStatus(row);
    }

    addRowBtn?.addEventListener('click', function () {
        const idx = itemsBody.querySelectorAll('.item-row').length;
        const tr = document.createElement('tr');
        tr.className = 'item-row';
        tr.innerHTML = `
            <td class="text-center sr-no">${idx + 1}</td>
            <td>
                <select name="Details[${idx}].DesignId" class="af-input af-input-sm af-select item-design" required>
                    ${designOptions}
                </select>
                <input type="hidden" name="Details[${idx}].DesignNumber" class="item-design-number" />
                <div class="item-discontinued-notice mt-1 text-xs" style="display:none;"></div>
            </td>
            <td><input type="text" name="Details[${idx}].Colour" class="af-input af-input-sm item-colour" placeholder="Colour" list="coloursList" /></td>
            <td><input type="text" name="Details[${idx}].Size" class="af-input af-input-sm item-size" placeholder="Size" list="sizesList" /></td>
            <td><input type="number" min="1" name="Details[${idx}].Quantity" class="af-input af-input-sm text-end item-qty" value="1" required /></td>
            <td><input type="number" step="0.01" min="0" name="Details[${idx}].UnitPrice" class="af-input af-input-sm text-end item-rate" value="0.00" required /></td>
            <td><input type="number" step="0.01" min="0" max="100" name="Details[${idx}].DiscountPercentage" class="af-input af-input-sm text-end item-disc" value="0" /></td>
            <td><input type="number" step="0.01" min="0" max="100" name="Details[${idx}].GstPercentage" class="af-input af-input-sm text-end item-gst" value="12" /></td>
            <td class="cell-num text-foreground fw-semibold item-net">₹0.00</td>
            <td class="text-center"><button type="button" class="row-action danger remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button></td>
        `;
        itemsBody.appendChild(tr);
        bindRow(tr);
        reindex();
    });

    itemsBody.querySelectorAll('.item-row').forEach(bindRow);
    transportChargeInput?.addEventListener('input', recalc);
    transportGSTInput?.addEventListener('input', recalc);
    roundOffInput?.addEventListener('input', recalc);

    updateEditButtonVisibility();
    recalc();
});
</script>
