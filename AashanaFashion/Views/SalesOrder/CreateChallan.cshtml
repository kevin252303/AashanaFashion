@model AashanaFashion.Models.CreateChallanViewModel
@{
    ViewData["Title"] = $"Generate Delivery Challan — {Model.SoNumber}";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.SalesOrderId" class="page-back"><i class="bi bi-arrow-left"></i> @Model.SoNumber</a>
        <h1 class="page-title">New delivery challan</h1>
        <p class="page-sub">Dispatch against sales order <span class="font-monospace">@Model.SoNumber</span> · @Model.CustomerName</p>
    </div>
</div>

<form asp-action="CreateChallan" method="post" id="challanForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SalesOrderId" />
    <input type="hidden" asp-for="SoNumber" />
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="CustomerName" />

    <div asp-validation-summary="All" class="af-alert af-alert-danger"></div>

    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Logistics &amp; transport</div>
                <div class="data-card-sub">Printed on the challan and e-way bill.</div>
            </div>
        </div>
        <div class="data-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="ChallanNumber" class="form-label">Challan number</label>
                    <input asp-for="ChallanNumber" class="af-input font-monospace fw-semibold" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="ChallanDate" class="form-label">Challan date <span class="req">*</span></label>
                    <input asp-for="ChallanDate" type="datetime-local" class="af-input" value="@Model.ChallanDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div class="col-md-3">
                    <label asp-for="TransporterName" class="form-label">Transporter / courier <span class="req">*</span></label>
                    <input asp-for="TransporterName" class="af-input" placeholder="e.g. VRL Logistics, Blue Dart" required />
                </div>
                <div class="col-md-3">
                    <label asp-for="VehicleNumber" class="form-label">Vehicle number</label>
                    <input asp-for="VehicleNumber" class="af-input text-uppercase font-monospace" placeholder="e.g. GJ-05-AB-1234" />
                </div>
                <div class="col-md-3">
                    <label asp-for="LrNumber" class="form-label">LR / docket / tracking</label>
                    <input asp-for="LrNumber" class="af-input font-monospace" placeholder="Lorry receipt number" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EwayBillNumber" class="form-label">E-way bill number</label>
                    <input asp-for="EwayBillNumber" class="af-input font-monospace" placeholder="12-digit EWB" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NumberOfBoxes" class="form-label">Parcels / boxes <span class="req">*</span></label>
                    <input asp-for="NumberOfBoxes" type="number" min="1" class="af-input" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="consigneeView">Consignee</label>
                    <input id="consigneeView" class="af-input" value="@Model.CustomerName" readonly />
                </div>
                <div class="col-md-8">
                    <label asp-for="ShippingAddress" class="form-label">Delivery address <span class="req">*</span></label>
                    <input asp-for="ShippingAddress" class="af-input" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Notes" class="form-label">Dispatch remarks</label>
                    <input asp-for="Notes" class="af-input" placeholder="e.g. Fragile, handle with care" />
                </div>
            </div>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Items to dispatch</div>
                <div class="data-card-sub">Lower a quantity for a partial shipment.</div>
            </div>
            <span class="af-badge b-purple" id="totalDispatchBadge">0 pcs</span>
        </div>
        <div class="table-scroll">
            <table class="af-table table-edit">
                <thead>
                    <tr>
                        <th>Design</th>
                        <th>Colour</th>
                        <th>Size</th>
                        <th class="text-end">Ordered</th>
                        <th class="text-end">Dispatched</th>
                        <th class="text-end">Pending</th>
                        <th style="width: 130px;" class="text-end">Dispatch now <span class="req">*</span></th>
                        <th style="min-width: 160px;">Package remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        <tr>
                            <td>
                                <span class="cell-title">@item.DesignNumber</span>
                                <input type="hidden" name="Items[@i].SalesOrderDetailId" value="@item.SalesOrderDetailId" />
                                <input type="hidden" name="Items[@i].DesignNumber" value="@item.DesignNumber" />
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.Colour) ? "—" : item.Colour)
                                <input type="hidden" name="Items[@i].Colour" value="@item.Colour" />
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.Size) ? "—" : item.Size)
                                <input type="hidden" name="Items[@i].Size" value="@item.Size" />
                            </td>
                            <td class="cell-num text-muted">
                                @item.OrderedQuantity
                                <input type="hidden" name="Items[@i].OrderedQuantity" value="@item.OrderedQuantity" />
                            </td>
                            <td class="cell-num text-muted">
                                @item.PreviouslyDispatched
                                <input type="hidden" name="Items[@i].PreviouslyDispatched" value="@item.PreviouslyDispatched" />
                            </td>
                            <td class="cell-num text-danger fw-semibold">
                                @item.PendingQuantity
                                <input type="hidden" name="Items[@i].PendingQuantity" value="@item.PendingQuantity" />
                            </td>
                            <td>
                                <input type="number" min="0" max="@item.PendingQuantity" name="Items[@i].DispatchQuantity" class="af-input af-input-sm text-end fw-semibold dispatch-qty" value="@item.DispatchQuantity" aria-label="Dispatch quantity for @item.DesignNumber" required />
                            </td>
                            <td>
                                <input type="text" name="Items[@i].Remarks" class="af-input af-input-sm" placeholder="Box # or note" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-truck"></i> Generate challan</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var qtyInputs = document.querySelectorAll('.dispatch-qty');
            var badge = document.getElementById('totalDispatchBadge');
            function updateTotal() {
                var total = 0;
                qtyInputs.forEach(function (input) { total += parseInt(input.value) || 0; });
                badge.textContent = total + ' pcs to dispatch';
            }
            qtyInputs.forEach(function (input) { input.addEventListener('input', updateTotal); });
            updateTotal();
        })();
    </script>
}
