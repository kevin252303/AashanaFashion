@model List<AashanaFashion.Models.SalesOrder>
@{
    ViewData["Title"] = "Sales Orders";
    var totalOrders = Model.Count;
    var dispatchedCount = Model.Count(o => o.Status == SalesOrderStatus.Dispatched);
    var partialCount = Model.Count(o => o.Status == SalesOrderStatus.PartiallyDispatched);
    var pendingCount = Model.Count(o => o.Status == SalesOrderStatus.Confirmed || o.Status == SalesOrderStatus.InProduction || o.Status == SalesOrderStatus.Draft);
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.SelectedStatus != null;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sales Orders</h1>
        <p class="page-sub">Customer orders, dispatch tracking and delivery challans.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New sales order</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total orders</div>
        <div class="metric-value">@totalOrders</div>
        <div class="metric-meta">all customer bookings</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Pending / in production</div>
        <div class="metric-value">@pendingCount</div>
        <div class="metric-meta warning">awaiting dispatch</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Partially dispatched</div>
        <div class="metric-value">@partialCount</div>
        <div class="metric-meta info">split shipment in progress</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Fully dispatched</div>
        <div class="metric-value">@dispatchedCount</div>
        <div class="metric-meta success">100% fulfilled</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="SO #, customer or PO ref…" value="@ViewBag.Search" />
            </div>
            <select name="status" class="af-input af-select" onchange="this.form.submit()" aria-label="Status">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<SalesOrderStatus>())
                {
                    <option value="@s" selected="@(ViewBag.SelectedStatus != null && (SalesOrderStatus)ViewBag.SelectedStatus == s ? "selected" : null)">@s.Humanize()</option>
                }
            </select>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-bag")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No sales orders yet")</div>
            <p>@(filtered ? "No orders match your filters." : "Create a sales order to start tracking customer bookings.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-secondary">New sales order</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Order date</th>
                        <th>Expected delivery</th>
                        <th>Dispatched</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var totalPieces = o.Details.Sum(d => d.Quantity);
                        var dispatchedPieces = o.Details.Sum(d => d.DispatchedQuantity);
                        var pct = totalPieces > 0 ? (int)Math.Round(dispatchedPieces * 100.0 / totalPieces) : 0;
                        var isFullyDispatched = o.Status == SalesOrderStatus.Dispatched;

                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@o.Id" class="cell-title">@o.SoNumber</a>
                                @if (!string.IsNullOrEmpty(o.CustomerPoReference))
                                {
                                    <span class="cell-sub">Ref @o.CustomerPoReference</span>
                                }
                            </td>
                            <td>
                                <span class="text-foreground fw-medium">@(o.Customer?.CustomerName ?? "—")</span>
                                @if (!string.IsNullOrEmpty(o.Customer?.City))
                                {
                                    <span class="cell-sub">@o.Customer.City</span>
                                }
                            </td>
                            <td class="text-nowrap text-muted tabular">@o.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap text-muted tabular">@(o.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td style="min-width: 150px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="af-progress flex-grow-1" style="max-width: 90px;">
                                        <div class="af-progress-bar @(isFullyDispatched ? "bg-success" : "")" role="progressbar" style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-xs text-muted tabular">@dispatchedPieces / @totalPieces</span>
                                </div>
                                @if (o.Challans.Any())
                                {
                                    <span class="cell-sub">@o.Challans.Count @(o.Challans.Count == 1 ? "challan" : "challans")</span>
                                }
                            <td class="cell-num text-foreground fw-semibold">
                                <div>₹@o.TotalAmount.ToString("N2")</div>
                                @if (o.HasAgentDiscount && o.AgentDiscountAmount > 0)
                                {
                                    <div class="text-xs text-danger" title="Agent discount deducted from subtotal">
                                        <i class="bi bi-tag-fill"></i> -₹@o.AgentDiscountAmount.ToString("N0")
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="af-badge @(o.Status switch {
                                    SalesOrderStatus.Confirmed => "b-blue",
                                    SalesOrderStatus.InProduction => "b-yellow",
                                    SalesOrderStatus.PartiallyDispatched => "b-purple",
                                    SalesOrderStatus.Dispatched => "b-green",
                                    _ => "b-gray"
                                })">@o.Status.Humanize()</span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (!isFullyDispatched)
                                    {
                                        <a asp-action="CreateChallan" asp-route-id="@o.Id" class="btn btn-sm btn-secondary me-1" title="Generate delivery challan"><i class="bi bi-truck"></i> Dispatch</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@o.Id" class="row-action" title="View details" aria-label="View"><i class="bi bi-eye"></i></a>
                                    @if (!isFullyDispatched)
                                    {
                                        <a asp-action="Edit" asp-route-id="@o.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count</strong> @(Model.Count == 1 ? "order" : "orders")</span>
        </div>
    }
</div>
