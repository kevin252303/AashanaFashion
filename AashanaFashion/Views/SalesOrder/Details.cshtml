@model AashanaFashion.Models.SalesOrder
@inject AashanaFashion.Services.ICommunicationService CommunicationService
@{
    ViewData["Title"] = $"Sales Order — {Model.SoNumber}";
    var totalOrdered = Model.Details.Sum(d => d.Quantity);
    var totalDispatched = Model.Details.Sum(d => d.DispatchedQuantity);
    var totalPending = Math.Max(0, totalOrdered - totalDispatched);
    var fulfillmentPercent = totalOrdered > 0 ? (int)Math.Round((double)totalDispatched / totalOrdered * 100) : 0;
    var canDispatch = totalPending > 0 && Model.Status != SalesOrderStatus.Cancelled;
    var statusBadge = Model.Status switch
    {
        SalesOrderStatus.Confirmed => "b-blue",
        SalesOrderStatus.InProduction => "b-yellow",
        SalesOrderStatus.PartiallyDispatched => "b-purple",
        SalesOrderStatus.Dispatched => "b-green",
        _ => "b-gray"
    };
    var chatterVm = await CommunicationService.GetChatterViewModelAsync("SalesOrder", Model.Id);
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Sales orders</a>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">@Model.SoNumber</h1>
            <span class="af-badge @statusBadge">@Model.Status.Humanize()</span>
        </div>
        <p class="page-sub">@(Model.Customer?.CustomerName ?? "—") · Ordered @Model.OrderDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-actions">
        <div class="btn-group">
            <a asp-controller="WhatsApp" asp-action="SalesOrder" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary">
                <i class="bi bi-whatsapp text-success"></i> WhatsApp
            </a>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalWa_chatter_SalesOrder_@Model.Id" title="Edit message before sending">
                <i class="bi bi-sliders"></i>
            </button>
        </div>
        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#modalEmail_chatter_SalesOrder_@Model.Id">
            <i class="bi bi-envelope text-primary"></i> Email order
        </button>
        @if (canDispatch)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-controller="Invoice" asp-action="Create" asp-route-salesOrderId="@Model.Id" class="btn btn-secondary"><i class="bi bi-receipt"></i> Tax invoice</a>
            <a asp-action="CreateChallan" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-truck"></i> Delivery challan</a>
        }
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-body">
        <div class="progress-row">
            <span class="pr-label fw-medium text-foreground">Dispatch fulfilment</span>
            <div class="af-progress">
                <div class="af-progress-bar @(fulfillmentPercent == 100 ? "bg-success" : "")" role="progressbar" style="width: @fulfillmentPercent%;" aria-valuenow="@fulfillmentPercent" aria-valuemin="0" aria-valuemax="100" aria-label="Dispatch fulfilment"></div>
            </div>
            <span class="pr-value">@totalDispatched of @totalOrdered pcs · @fulfillmentPercent%</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="data-card h-100">
            <div class="data-card-header">
                <div class="data-card-title">Customer &amp; consignee</div>
            </div>
            <div class="data-card-body">
                <div class="info-grid">
                    <div>
                        <div class="info-label">Customer</div>
                        <div class="info-value">@Model.Customer?.CustomerName</div>
                    </div>
                    <div>
                        <div class="info-label">Contact person</div>
                        <div class="info-value">@(Model.Customer?.ContactPerson ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Phone</div>
                        <div class="info-value">@(Model.Customer?.Phone ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">GSTIN</div>
                        <div class="info-value font-monospace">@(Model.Customer?.GstNumber ?? "—")</div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="info-label">Shipping address</div>
                        <div class="info-value">@(string.IsNullOrEmpty(Model.ShippingAddress) ? Model.Customer?.Address ?? "—" : Model.ShippingAddress)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="data-card h-100">
            <div class="data-card-header">
                <div class="data-card-title">Order &amp; logistics</div>
            </div>
            <div class="data-card-body">
                <div class="info-grid">
                    <div>
                        <div class="info-label">Customer PO ref</div>
                        <div class="info-value">@(Model.CustomerPoReference ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Expected delivery</div>
                        <div class="info-value">@(Model.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Transporter</div>
                        <div class="info-value">@(Model.TransporterName ?? "—")</div>
                    </div>
                    <div>
                        <div class="info-label">Payment terms</div>
                        <div class="info-value">@(Model.PaymentTerms ?? "—")</div>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <div class="info-label">Pricelist</div>
                        <div class="info-value">
                            @if (Model.Pricelist != null)
                            {
                                <span class="af-badge b-indigo">@Model.Pricelist.Name · @Model.Pricelist.DiscountPolicyDisplay</span>
                            }
                            else
                            {
                                <span class="text-muted">Standard / base pricing</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div style="grid-column: 1 / -1;">
                            <div class="info-label">Notes</div>
                            <div class="info-value text-muted">@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-card mb-4">
    <div class="data-card-header">
        <div class="data-card-title">Order items</div>
        <span class="text-xs text-muted">@Model.Details.Count @(Model.Details.Count == 1 ? "line" : "lines")</span>
    </div>
    <div class="table-scroll">
        <table class="af-table">
            <thead>
                <tr>
                    <th style="width: 48px;">#</th>
                    <th>Design</th>
                    <th>Colour</th>
                    <th>Size</th>
                    <th class="text-end">Ordered</th>
                    <th class="text-end">Dispatched</th>
                    <th class="text-end">Pending</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Disc</th>
                    <th class="text-end">GST</th>
                    <th class="text-end">Net amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Details.OrderBy(x => x.SrNo))
                {
                    <tr>
                        <td class="text-muted tabular">@d.SrNo</td>
                        <td>
                            <span class="cell-title">@d.DesignNumber</span>
                            @if (d.DesignId.HasValue)
                            {
                                <a asp-controller="Design" asp-action="Bom" asp-route-id="@d.DesignId.Value" class="af-badge b-blue ms-1">BOM</a>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(d.Colour) ? "—" : d.Colour)</td>
                        <td>@(string.IsNullOrEmpty(d.Size) ? "—" : d.Size)</td>
                        <td class="cell-num text-foreground">@d.Quantity</td>
                        <td class="cell-num text-success">@d.DispatchedQuantity</td>
                        <td class="cell-num @(d.PendingQuantity > 0 ? "text-danger fw-semibold" : "text-muted")">@d.PendingQuantity</td>
                        <td class="cell-num">₹@d.UnitPrice.ToString("N2")</td>
                        <td class="cell-num">@d.DiscountPercentage.ToString("N0")%</td>
                        <td class="cell-num">@d.GstPercentage.ToString("N0")%</td>
                        <td class="cell-num text-foreground fw-semibold">₹@d.NetAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Total</td>
                    <td class="text-end tabular">@totalOrdered</td>
                    <td class="text-end tabular text-success">@totalDispatched</td>
                    <td class="text-end tabular @(totalPending > 0 ? "text-danger" : "text-success")">@totalPending</td>
                    <td colspan="3"></td>
                    <td class="text-end tabular">₹@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="table-card">
    <div class="data-card-header">
        <div>
            <div class="data-card-title">Delivery challans</div>
            <div class="data-card-sub">@Model.Challans.Count @(Model.Challans.Count == 1 ? "shipment" : "shipments") generated</div>
        </div>
        @if (canDispatch)
        {
            <a asp-action="CreateChallan" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> New challan</a>
        }
    </div>

    @if (!Model.Challans.Any())
    {
        <div class="empty-state py-4">
            <div class="es-icon"><i class="bi bi-truck"></i></div>
            <div class="es-title">No challans yet</div>
            <p>Delivery challans generated for this order will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Challan</th>
                        <th>Dispatch date</th>
                        <th>Transporter</th>
                        <th>Vehicle</th>
                        <th>LR / tracking</th>
                        <th class="text-end">Boxes</th>
                        <th class="text-end">Pcs</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ch in Model.Challans.OrderByDescending(c => c.ChallanDate))
                    {
                        <tr>
                            <td><span class="mono-id">@ch.ChallanNumber</span></td>
                            <td class="text-nowrap text-muted tabular">@ch.ChallanDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@(ch.TransporterName ?? "—")</td>
                            <td class="font-monospace text-xs">@(ch.VehicleNumber ?? "—")</td>
                            <td class="font-monospace text-xs">@(ch.LrNumber ?? "—")</td>
                            <td class="cell-num">@ch.NumberOfBoxes</td>
                            <td class="cell-num text-success fw-semibold">@ch.TotalQuantity</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-controller="WhatsApp" asp-action="DispatchChallan" asp-route-id="@ch.Id" target="_blank" class="row-action" title="Send WhatsApp dispatch advice to buyer" aria-label="Send WhatsApp"><i class="bi bi-whatsapp text-success"></i></a>
                                    <a asp-controller="Invoice" asp-action="Create" asp-route-salesOrderId="@Model.Id" asp-route-deliveryChallanId="@ch.Id" class="row-action" title="Generate invoice from this delivery challan" aria-label="Generate invoice"><i class="bi bi-receipt"></i></a>
                                    <a asp-action="PrintChallan" asp-route-id="@ch.Id" target="_blank" class="row-action" title="Print challan" aria-label="Print challan"><i class="bi bi-printer"></i></a>
                                    <a asp-action="PrintChallanEwayBill" asp-route-id="@ch.Id" target="_blank" class="row-action" title="Print e-way bill" aria-label="Print e-way bill"><i class="bi bi-file-earmark-text"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_DocumentChatter" model="chatterVm" />

