@model AashanaFashion.Models.SalesOrderViewModel
@{
    ViewData["Title"] = "New Sales Order";
    var customers = ViewBag.Customers as List<AashanaFashion.Models.Customer> ?? new();
    var designs = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new();
    var colours = ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new();
    var sizes = ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new();
    var pricelists = ViewBag.Pricelists as List<AashanaFashion.Models.Pricelist> ?? new();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Sales orders</a>
        <h1 class="page-title">New sales order</h1>
        <p class="page-sub">Book a customer order and schedule production.</p>
    </div>
</div>

<form asp-action="Create" method="post" id="soForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="af-alert af-alert-danger"></div>

    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Order details</div>
                <div class="data-card-sub">Picking a customer fills address, transporter, terms and pricelist.</div>
            </div>
        </div>
        <div class="data-card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <label class="form-label">SO number <span class="req">*</span></label>
                <input asp-for="SoNumber" class="af-input font-monospace fw-semibold" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label d-flex justify-content-between align-items-center">
                    <span>Customer <span class="req">*</span></span>
                    <span class="af-badge b-indigo d-none" id="customerPricelistBadge">Pricelist</span>
                </label>
                <select asp-for="CustomerId" class="af-input af-select" id="customerSelect" required>
                    <option value="">Select customer</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CustomerId ? "selected" : null)">
                            @c.CustomerName @(!string.IsNullOrEmpty(c.City) ? $"({c.City})" : "")
                        </option>
                    }
                </select>
                <div id="soCustCreditBox" class="mt-1 d-none">
                    <span id="soCustCreditBadge" class="af-badge b-green" style="font-size: 0.72rem; padding: 2px 6px;"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="label-row">
                    <label class="form-label" for="soPricelistSelect">Pricelist</label>
                    <span class="d-inline-flex gap-3">
                        <button type="button" class="label-action" data-bs-toggle="modal" data-bs-target="#quickPricelistModal" title="Create a new pricelist"><i class="bi bi-plus-lg"></i> New</button>
                        <button type="button" class="label-action d-none" id="btnEditSelectedPricelist" data-bs-toggle="modal" data-bs-target="#editPricelistModal" title="Edit the selected pricelist"><i class="bi bi-pencil"></i> Edit</button>
                    </span>
                </div>
                <select asp-for="PricelistId" class="af-input af-select" id="soPricelistSelect">
                    <option value="">Standard / base price</option>
                    @foreach (var pl in pricelists)
                    {
                        <option value="@pl.Id" selected="@(pl.Id == Model.PricelistId ? "selected" : null)">
                            @pl.Name (@pl.DiscountPolicyDisplay)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Customer PO / order ref</label>
                <input asp-for="CustomerPoReference" class="af-input" placeholder="e.g. PO-8891" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Order date <span class="req">*</span></label>
                <input asp-for="OrderDate" type="date" class="af-input" value="@Model.OrderDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Expected delivery</label>
                <input asp-for="ExpectedDeliveryDate" type="date" class="af-input" value="@(Model.ExpectedDeliveryDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Transporter / courier</label>
                <input asp-for="TransporterName" class="af-input" id="transporterInput" placeholder="Transport service" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Payment terms</label>
                <input asp-for="PaymentTerms" class="af-input" id="paymentTermsInput" placeholder="e.g. Net 30, Advance" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Delivery address</label>
                <input asp-for="ShippingAddress" class="af-input" id="shippingAddressInput" placeholder="Consignee delivery address" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Notes / instructions</label>
                <input asp-for="Notes" class="af-input" placeholder="Packaging or delivery instructions" />
            </div>
        </div>
        </div>
    </div>

    <!-- Live Credit Limit Warning Banner -->
    <div id="soCreditLimitAlert" class="af-alert af-alert-warning mb-4 d-none">
        <div class="alert-body">
            <span class="alert-title"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Customer Credit Limit Warning</span>
            <div id="soCreditLimitAlertMsg" class="text-sm mt-1"></div>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Line items</div>
                <div class="data-card-sub">Design, colour, size and quantity.</div>
            </div>
            <div class="btn-row">
                <button type="button" id="btnReapplyPricelist" class="btn btn-sm btn-secondary" title="Recalculate rates &amp; discounts for all items using the selected pricelist">
                    <i class="bi bi-arrow-repeat"></i> Apply pricelist
                </button>
                <button type="button" id="addRowBtn" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> Add item</button>
            </div>
        </div>

        <!-- High-Speed Barcode & SKU Scanner Bar -->
        <div class="p-3 border-bottom bg-light-subtle d-flex align-items-center gap-3 flex-wrap">
            <div class="input-group" style="max-width: 480px;">
                <span class="input-group-text bg-white border-end-0 text-primary">
                    <i class="bi bi-upc-scan fs-5"></i>
                </span>
                <input type="text" id="soBarcodeInput" class="form-control border-start-0 font-monospace text-sm" placeholder="Scan barcode, SKU, piece tag, or enter design & press Enter..." autocomplete="off" />
                <button type="button" id="btnScanBarcode" class="btn btn-primary">
                    <i class="bi bi-arrow-return-left"></i> Add
                </button>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button type="button" id="btnOpenCamScan" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#cameraScanModal" title="Use laptop / phone camera scanner">
                    <i class="bi bi-camera"></i> Camera scan
                </button>
                <div class="form-check form-switch mb-0" title="Keeps cursor focused in barcode box for hands-free scanner guns">
                    <input class="form-check-input" type="checkbox" id="chkAutoKeepFocus" checked>
                    <label class="form-check-label text-xs fw-medium" for="chkAutoKeepFocus">Hands-free scan</label>
                </div>
                <div class="form-check form-switch mb-0" title="Play sound on barcode scan">
                    <input class="form-check-input" type="checkbox" id="chkScanAudio" checked>
                    <label class="form-check-label text-xs fw-medium" for="chkScanAudio"><i class="bi bi-volume-up"></i> Sound</label>
                </div>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span id="scanStatusBadge" class="text-xs fw-medium text-muted">
                    <i class="bi bi-broadcast text-success me-1"></i> Scanner ready (scan any tag or enter design)
                </span>
            </div>
        </div>

        <div class="table-scroll">
                <table class="af-table table-edit" id="itemsTable" style="min-width: 1000px;">
                    <thead>
                        <tr>
                            <th style="width: 44px;" class="text-center">#</th>
                            <th style="min-width: 200px;">Design <span class="req">*</span></th>
                            <th style="width: 140px;">Colour</th>
                            <th style="width: 110px;">Size</th>
                            <th style="width: 90px;" class="text-end">Qty <span class="req">*</span></th>
                            <th style="width: 120px;" class="text-end">Rate (₹) <span class="req">*</span></th>
                            <th style="width: 90px;" class="text-end">Disc %</th>
                            <th style="width: 90px;" class="text-end">GST %</th>
                            <th style="width: 120px;" class="text-end">Gross (₹)</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr class="item-row">
                            <td class="text-center sr-no">1</td>
                            <td>
                                <select name="Details[0].DesignId" class="af-input af-input-sm af-select item-design" required>
                                    <option value="">Select design</option>
                                    @foreach (var d in designs)
                                    {
                                        <option value="@d.Id" data-number="@d.DesignNumber" data-rate="@d.SalesPrice" data-colours="@d.Colours" data-sizes="@d.Sizes" data-discontinued="@d.Discontinued.ToString().ToLower()">
                                            @d.DesignNumber (₹@d.SalesPrice.ToString("N2")) @(d.Discontinued ? "· discontinued" : "")
                                        </option>
                                    }
                                </select>
                                <input type="hidden" name="Details[0].DesignNumber" class="item-design-number" />
                                <div class="item-discontinued-notice mt-1 text-xs" style="display:none;"></div>
                            </td>
                            <td>
                                <input type="text" name="Details[0].Colour" class="af-input af-input-sm item-colour" placeholder="Colour" list="coloursList" />
                            </td>
                            <td>
                                <input type="text" name="Details[0].Size" class="af-input af-input-sm item-size" placeholder="Size" list="sizesList" />
                            </td>
                            <td>
                                <input type="number" min="1" name="Details[0].Quantity" class="af-input af-input-sm text-end item-qty" value="1" required />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" name="Details[0].UnitPrice" class="af-input af-input-sm text-end item-rate" value="0.00" required />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" max="100" name="Details[0].DiscountPercentage" class="af-input af-input-sm text-end item-disc" value="0" />
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" max="100" name="Details[0].GstPercentage" class="af-input af-input-sm text-end item-gst" value="12" />
                            </td>
                            <td class="cell-num text-foreground fw-semibold item-net">₹0.00</td>
                            <td class="text-center">
                                <button type="button" class="row-action danger remove-row" title="Remove" aria-label="Remove" style="display:none;"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
    </div>

    <div class="row g-4 justify-content-end mb-4">
        <div class="col-md-6 col-lg-5">
            <div class="data-card">
                <div class="data-card-header">
                    <div class="data-card-title">Order total &amp; discounts</div>
                </div>
                <div class="data-card-body">
                    <div class="kv-row"><span class="k">Items Subtotal</span><span class="v" id="subtotalDisplay">₹0.00</span></div>

                    <!-- Whole Order Agent Discount Toggle & Configuration -->
                    <div class="panel-inset p-2 my-2 border rounded-2">
                        <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="HasAgentDiscount" id="chkAgentDiscount" />
                            <label class="form-check-label fw-semibold text-sm cursor-pointer" for="chkAgentDiscount">
                                <i class="bi bi-tag text-primary me-1"></i> Agent discount (whole order)
                            </label>
                        </div>

                        <div id="agentDiscountBox" class="mt-2 pt-2 border-top @(Model.HasAgentDiscount ? "" : "d-none")">
                            <div class="row g-2 align-items-center">
                                <div class="col-5">
                                    <label class="text-xs text-muted mb-1 d-block" for="agentDiscountType">Type</label>
                                    <select asp-for="AgentDiscountType" class="af-input af-input-sm af-select" id="agentDiscountType">
                                        <option value="0">Percentage (%)</option>
                                        <option value="1">Fixed amount (₹)</option>
                                    </select>
                                </div>
                                <div class="col-7">
                                    <label class="text-xs text-muted mb-1 d-block" for="agentDiscountRate">Discount value</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text font-monospace text-xs" id="agentDiscountUnit">%</span>
                                        <input type="number" step="0.01" min="0" asp-for="AgentDiscountRate" class="af-input af-input-sm text-end font-monospace" id="agentDiscountRate" placeholder="0.00" value="@Model.AgentDiscountRate" />
                                    </div>
                                </div>
                            </div>
                            <div class="text-xs text-muted mt-1 d-flex justify-content-between align-items-center">
                                <span>Deducted from subtotal:</span>
                                <span id="agentDiscountCalcBadge" class="text-danger fw-semibold">-₹0.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="kv-row text-danger @(Model.HasAgentDiscount ? "" : "d-none")" id="agentDiscountRow">
                        <span class="k text-danger">Agent discount</span>
                        <span class="v text-danger tabular fw-semibold" id="agentDiscountDisplay">-₹0.00</span>
                    </div>

                    <div class="kv-row @(Model.HasAgentDiscount ? "" : "d-none")" id="netSubtotalRow">
                        <span class="k">Net subtotal</span>
                        <span class="v tabular fw-semibold" id="netSubtotalDisplay">₹0.00</span>
                    </div>

                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="transportCharge">Transport charge (₹)</label>
                        <input type="number" step="0.01" min="0" asp-for="TransportCharge" class="af-input af-input-sm text-end" id="transportCharge" style="width: 120px;" value="0" />
                    </div>
                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="transportGST">Transport GST %</label>
                        <input type="number" step="0.01" min="0" max="100" asp-for="TransportChargeGST" class="af-input af-input-sm text-end" id="transportGST" style="width: 120px;" value="18" />
                    </div>
                    <div class="kv-row align-items-center">
                        <label class="k mb-0" for="roundOff">Round off (₹)</label>
                        <input type="number" step="0.01" asp-for="RoundOff" class="af-input af-input-sm text-end" id="roundOff" style="width: 120px;" value="0" />
                    </div>
                    <div class="bill-total"><span class="k">Grand total</span><span class="v" id="grandTotalDisplay">₹0.00</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save &amp; confirm order</button>
    </div>
</form>

<!-- Quick Create Pricelist Modal -->
<div class="modal fade" id="quickPricelistModal" tabindex="-1" aria-labelledby="quickPricelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickPricelistModalLabel">New pricelist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="quickPlAlert" class="af-alert af-alert-danger d-none" role="alert"></div>
                
                <div class="mb-3">
                    <label class="form-label">Pricelist name <span class="req">*</span></label>
                    <input type="text" id="quickPlName" class="af-input" placeholder="e.g. VIP Wholesale (10% Off)" required />
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Discount policy</label>
                        <select id="quickPlPolicy" class="af-input af-select">
                            <option value="0">Discount included in price</option>
                            <option value="1">Show discount % to customer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Discount type</label>
                        <select id="quickPlMethod" class="af-input af-select">
                            <option value="1">Percentage (%)</option>
                            <option value="0">Fixed Price (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6" id="quickPlPctCol">
                        <label class="form-label">Discount %</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.1" min="0" max="100" id="quickPlDiscount" class="af-input text-end" value="10" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="quickPlFixedCol">
                        <label class="form-label">Fixed price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0" id="quickPlFixed" class="af-input text-end" value="0.00" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Min quantity</label>
                        <input type="number" step="1" min="1" id="quickPlMinQty" class="af-input text-center" value="1" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Description / notes</label>
                    <textarea id="quickPlDesc" class="af-input" rows="2" placeholder="Optional notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuickPricelist">Save &amp; Select</button>
            </div>
        </div>
    </div>
</div>

<!-- Quick Edit Pricelist Modal -->
<div class="modal fade" id="editPricelistModal" tabindex="-1" aria-labelledby="editPricelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPricelistModalLabel">Edit pricelist rules</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="editPlAlert" class="af-alert af-alert-danger d-none" role="alert"></div>
                <input type="hidden" id="editPlId" />
                
                <div class="mb-3">
                    <label class="form-label">Pricelist name <span class="req">*</span></label>
                    <input type="text" id="editPlName" class="af-input" required />
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Discount policy</label>
                        <select id="editPlPolicy" class="af-input af-select">
                            <option value="0">Discount included in price</option>
                            <option value="1">Show discount % to customer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Discount type</label>
                        <select id="editPlMethod" class="af-input af-select">
                            <option value="1">Percentage (%)</option>
                            <option value="0">Fixed Price (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6" id="editPlPctCol">
                        <label class="form-label">Discount %</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.1" min="0" max="100" id="editPlDiscount" class="af-input text-end" value="0" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="editPlFixedCol">
                        <label class="form-label">Fixed price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0" id="editPlFixed" class="af-input text-end" value="0.00" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Min quantity</label>
                        <input type="number" step="1" min="1" id="editPlMinQty" class="af-input text-center" value="1" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label">Description / notes</label>
                    <textarea id="editPlDesc" class="af-input" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnUpdatePricelist">Save &amp; Re-apply</button>
            </div>
        </div>
    </div>
</div>

<!-- Camera Barcode Scan Modal -->
<div class="modal fade" id="cameraScanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-camera text-primary"></i> Scan Barcode with Camera
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3">
                <div class="position-relative d-inline-block rounded overflow-hidden border bg-black w-100" style="min-height: 250px; max-height: 340px;">
                    <video id="cameraVideo" playsinline style="width: 100%; height: 280px; object-fit: cover;"></video>
                    <div id="cameraReticle" class="position-absolute top-50 start-50 translate-middle border border-2 border-danger rounded" style="width: 75%; height: 50%; pointer-events: none; box-shadow: 0 0 0 9999px rgba(0,0,0,0.4);">
                        <div class="position-absolute top-50 start-0 w-100 border-top border-danger" style="opacity: 0.7;"></div>
                    </div>
                </div>
                <div id="cameraStatusText" class="mt-2 text-xs text-muted">Point camera at barcode or QR code on garment tag</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Datalists for Colours and Sizes -->
<datalist id="coloursList">
    @foreach (var c in colours) { <option value="@c.ColourName" /> }
</datalist>
<datalist id="sizesList">
    @foreach (var s in sizes) { <option value="@s.SizeName" /> }
</datalist>

<template id="designOptionsTemplate">
    <option value="">Select design</option>
    @foreach (var d in designs)
    {
        <option value="@d.Id" data-number="@d.DesignNumber" data-rate="@d.SalesPrice" data-colours="@d.Colours" data-sizes="@d.Sizes" data-discontinued="@d.Discontinued.ToString().ToLower()">
            @d.DesignNumber (₹@d.SalesPrice.ToString("N2")) @(d.Discontinued ? "· discontinued" : "")
        </option>
    }
</template>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const customerSelect = document.getElementById('customerSelect');
    const soPricelistSelect = document.getElementById('soPricelistSelect');
    const btnEditPricelist = document.getElementById('btnEditSelectedPricelist');
    const btnReapplyPricelist = document.getElementById('btnReapplyPricelist');

    const shippingAddress = document.getElementById('shippingAddressInput');
    const transporterInput = document.getElementById('transporterInput');
    const paymentTermsInput = document.getElementById('paymentTermsInput');

    const itemsBody = document.getElementById('itemsBody');
    const addRowBtn = document.getElementById('addRowBtn');

    const subtotalDisplay = document.getElementById('subtotalDisplay');
