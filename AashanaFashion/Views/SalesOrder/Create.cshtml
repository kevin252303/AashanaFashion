    // ——— Audio Synthesizer for Barcode Gun Feedback ———
    let audioCtx = null;
    function playScanBeep(success) {
        if (!document.getElementById('chkScanAudio')?.checked) return;
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (success) {
                // High dual chime
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime); // A5
                osc.frequency.setValueAtTime(1320, audioCtx.currentTime + 0.06); // E6
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.14);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.15);
            } else {
                // Low buzz
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, audioCtx.currentTime); // A3
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.28);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            }
        } catch (e) {
            console.warn('Audio not available', e);
        }
    }

    // ——— Barcode Scanner Logic (USB Gun / Keyboard / Code Lookup) ———
    const soBarcodeInput = document.getElementById('soBarcodeInput');
    const btnScanBarcode = document.getElementById('btnScanBarcode');
    const scanStatusBadge = document.getElementById('scanStatusBadge');
    const chkAutoKeepFocus = document.getElementById('chkAutoKeepFocus');

    async function performBarcodeScan(rawCode) {
        const code = (rawCode || soBarcodeInput?.value || '').trim();
        if (!code) {
            soBarcodeInput?.focus();
            return;
        }

        if (scanStatusBadge) {
            scanStatusBadge.innerHTML = `<span class="spinner-border spinner-border-sm text-primary me-1"></span> Looking up <strong>${code}</strong>...`;
        }

        const customerId = customerSelect?.value ? parseInt(customerSelect.value) : null;
        const pricelistId = getCurrentPricelistId();

        try {
            const resp = await fetch('/SalesOrder/ScanBarcode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code, customerId: customerId, pricelistId: pricelistId, quantity: 1 })
            });

            const data = await resp.json();

            if (data && data.success) {
                playScanBeep(true);
                applyScannedItemToTable(data);
                if (scanStatusBadge) {
                    scanStatusBadge.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> ${data.message}</span>`;
                }
            } else {
                playScanBeep(false);
                if (scanStatusBadge) {
                    scanStatusBadge.innerHTML = `<span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i> ${data?.message || 'Barcode not found'}</span>`;
                }
            }
        } catch (err) {
            playScanBeep(false);
            if (scanStatusBadge) {
                scanStatusBadge.innerHTML = `<span class="text-danger fw-semibold"><i class="bi bi-x-circle-fill me-1"></i> Scan request failed</span>`;
            }
            console.error('Scan error:', err);
        } finally {
            if (soBarcodeInput) {
                soBarcodeInput.value = '';
                if (chkAutoKeepFocus?.checked) {
                    soBarcodeInput.focus();
                }
            }
        }
    }

    function applyScannedItemToTable(data) {
        const rows = Array.from(itemsBody.querySelectorAll('.item-row'));

        // Check if an existing row matches designId, colour, and size
        let existingRow = rows.find(r => {
            const dVal = r.querySelector('.item-design')?.value;
            const cVal = (r.querySelector('.item-colour')?.value || '').trim().toLowerCase();
            const sVal = (r.querySelector('.item-size')?.value || '').trim().toLowerCase();

            return parseInt(dVal) === data.designId &&
                   cVal === (data.colour || '').trim().toLowerCase() &&
                   sVal === (data.size || '').trim().toLowerCase();
        });

        if (existingRow) {
            // INCREMENT QUANTITY!
            const qtyInput = existingRow.querySelector('.item-qty');
            const currentQty = parseFloat(qtyInput?.value) || 0;
            const newQty = currentQty + 1;
            if (qtyInput) qtyInput.value = newQty;

            // Flash highlight
            existingRow.classList.add('table-success');
            setTimeout(() => existingRow.classList.remove('table-success'), 1200);

            applyPricelistToRow(existingRow);
            recalc();
            return;
        }

        // Check if the first row is completely unused/blank
        let targetRow = null;
        if (rows.length === 1 && !rows[0].querySelector('.item-design')?.value) {
            targetRow = rows[0];
        } else {
            // Click Add Row to append a clean row
            addRowBtn?.click();
            const updatedRows = itemsBody.querySelectorAll('.item-row');
            targetRow = updatedRows[updatedRows.length - 1];
        }

        if (!targetRow) return;

        const designSelect = targetRow.querySelector('.item-design');
        const designNumInput = targetRow.querySelector('.item-design-number');
        const colourInput = targetRow.querySelector('.item-colour');
        const sizeInput = targetRow.querySelector('.item-size');
        const qtyInput = targetRow.querySelector('.item-qty');
        const rateInput = targetRow.querySelector('.item-rate');
        const discInput = targetRow.querySelector('.item-disc');
        const gstInput = targetRow.querySelector('.item-gst');

        if (designSelect) {
            designSelect.value = data.designId;
            if (designNumInput) designNumInput.value = data.designNumber;
        }
        if (colourInput) colourInput.value = data.colour || '';
        if (sizeInput) sizeInput.value = data.size || '';
        if (qtyInput) qtyInput.value = 1;
        if (rateInput && data.unitPrice > 0) rateInput.value = data.unitPrice.toFixed(2);
        if (discInput) discInput.value = (data.discountPercentage || 0).toFixed(2);
        if (gstInput) gstInput.value = (data.gstPercentage || 12).toFixed(2);

        targetRow.classList.add('table-success');
        setTimeout(() => targetRow.classList.remove('table-success'), 1200);

        checkDiscontinuedStatus(targetRow);
        recalc();
    }

    soBarcodeInput?.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            performBarcodeScan();
        }
    });

    btnScanBarcode?.addEventListener('click', function() {
        performBarcodeScan();
    });

    if (chkAutoKeepFocus?.checked) {
        soBarcodeInput?.focus();
    }

    // ——— Camera Barcode Scanner via HTML5 BarcodeDetector ———
    let cameraStream = null;
    let cameraActive = false;
    const cameraModal = document.getElementById('cameraScanModal');
    const cameraVideo = document.getElementById('cameraVideo');
    const cameraStatusText = document.getElementById('cameraStatusText');

    cameraModal?.addEventListener('shown.bs.modal', async function () {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            if (cameraStatusText) cameraStatusText.textContent = 'Camera API is not supported in this browser.';
            return;
        }

        try {
            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } }
            });
            if (cameraVideo) {
                cameraVideo.srcObject = cameraStream;
                await cameraVideo.play();
                cameraActive = true;
                startCameraDetection();
            }
        } catch (err) {
            if (cameraStatusText) cameraStatusText.textContent = 'Camera permission denied or camera unavailable.';
            console.error('Camera error', err);
        }
    });

    cameraModal?.addEventListener('hidden.bs.modal', function () {
        cameraActive = false;
        if (cameraStream) {
            cameraStream.getTracks().forEach(t => t.stop());
            cameraStream = null;
        }
        if (chkAutoKeepFocus?.checked) {
            soBarcodeInput?.focus();
        }
    });

    async function startCameraDetection() {
        if (!('BarcodeDetector' in window)) {
            if (cameraStatusText) cameraStatusText.textContent = 'Direct camera barcode detection not supported in this browser; please use USB laser scanner or enter code.';
            return;
        }

        try {
            const barcodeDetector = new window.BarcodeDetector({
                formats: ['code_128', 'qr_code', 'ean_13', 'ean_8', 'code_39', 'upc_a', 'upc_e']
            });

            async function detectFrame() {
                if (!cameraActive || !cameraVideo) return;
                try {
                    const barcodes = await barcodeDetector.detect(cameraVideo);
                    if (barcodes && barcodes.length > 0) {
                        const rawCode = barcodes[0].rawValue;
                        if (rawCode) {
                            cameraActive = false;
                            const modal = bootstrap.Modal.getInstance(cameraModal);
                            if (modal) modal.hide();
                            performBarcodeScan(rawCode);
                            return;
                        }
                    }
                } catch (e) {
                    // Frame detection skip
                }
                if (cameraActive) {
                    requestAnimationFrame(detectFrame);
                }
            }

            detectFrame();
        } catch (err) {
            console.warn('BarcodeDetector error', err);
        }
    }
});
</script>
