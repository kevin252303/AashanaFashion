@model IEnumerable<AashanaFashion.Models.Company>
@inject AashanaFashion.Services.ICompanyContext CompanyContext
@{
    ViewData["Title"] = "Companies";
    var activeCompany = await CompanyContext.GetActiveCompanyAsync();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-buildings-fill text-primary me-2"></i>Company Master</h4>
        <p class="text-muted mb-0 small">Manage multiple companies, GSTINs, bank accounts, prefixes and separate books of accounts.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-1.5 shadow-sm">
            <i class="bi bi-plus-circle"></i> Add New Company
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @foreach (var comp in Model)
    {
        var isCurrent = comp.Id == activeCompany.Id;
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 position-relative @(isCurrent ? "border-primary border-2 shadow" : "")" style="@(isCurrent ? "outline: 2px solid var(--bs-primary); outline-offset: -2px;" : "")">
                <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-start">
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 mb-1 font-monospace">@comp.CompanyCode</span>
                        @if (comp.IsDefault)
                        {
                            <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1 ms-1">
                                <i class="bi bi-star-fill text-warning"></i> Default
                            </span>
                        }
                        @if (isCurrent)
                        {
                            <span class="badge bg-primary text-white px-2 py-1 ms-1">
                                <i class="bi bi-check2-circle"></i> Active Now
                            </span>
                        }
                    </div>
                    @if (comp.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Inactive</span>
                    }
                </div>

                <div class="card-body pt-2 pb-3">
                    <h5 class="card-title fw-bold mb-1 text-truncate" title="@comp.CompanyName">@comp.CompanyName</h5>
                    <div class="text-muted small mb-3">
                        <i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrWhiteSpace(comp.City) ? "India" : $"{comp.City}, {comp.State} - {comp.PinCode}")
                    </div>

                    <div class="p-2.5 rounded bg-light border small mb-3">
                        <div class="row g-1">
                            <div class="col-5 text-muted">GSTIN:</div>
                            <div class="col-7 fw-semibold font-monospace text-truncate">@(string.IsNullOrWhiteSpace(comp.Gstin) ? "—" : comp.Gstin)</div>

                            <div class="col-5 text-muted">PAN:</div>
                            <div class="col-7 font-monospace text-truncate">@(string.IsNullOrWhiteSpace(comp.Pan) ? "—" : comp.Pan)</div>

                            <div class="col-5 text-muted">Bank:</div>
                            <div class="col-7 text-truncate">@(string.IsNullOrWhiteSpace(comp.BankName) ? "—" : comp.BankName)</div>

                            <div class="col-5 text-muted">Inv Prefix:</div>
                            <div class="col-7 font-monospace text-primary fw-semibold">@(string.IsNullOrWhiteSpace(comp.InvoicePrefix) ? "INV-" : comp.InvoicePrefix)</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-2">
                        @if (isCurrent)
                        {
                            <button class="btn btn-sm btn-outline-primary disabled w-100 me-2" disabled>
                                <i class="bi bi-check2"></i> Current Active Company
                            </button>
                        }
                        else
                        {
                            <a asp-action="Switch" asp-route-companyId="@comp.Id" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-primary flex-grow-1 me-2 d-inline-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-arrow-repeat"></i> Switch to This
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border px-2" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@comp.Id">
                                            <i class="bi bi-pencil me-2 text-warning"></i> Edit Details
                                        </a>
                                    </li>
                                    @if (!comp.IsDefault)
                                    {
                                        <li>
                                            <form asp-action="SetDefault" asp-route-id="@comp.Id" method="post" onsubmit="return confirm('Make @comp.CompanyName the default company?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-star me-2 text-warning"></i> Set as Default
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
