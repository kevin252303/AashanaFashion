@model IEnumerable<AashanaFashion.Models.Company>
@inject AashanaFashion.Services.ICompanyContext CompanyContext
@{
    ViewData["Title"] = "Companies";
    var activeCompany = await CompanyContext.GetActiveCompanyAsync();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Company Master</h1>
        <p class="page-sub">Manage multiple companies, GSTINs, bank accounts, prefixes and separate books of accounts.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Company</a>
        </div>
    }
</div>

<div class="row g-3">
    @foreach (var comp in Model)
    {
        var isCurrent = comp.Id == activeCompany.Id;
        <div class="col-md-6 col-xl-4">
            <div class="summary-card company-card flex-column align-items-stretch @(isCurrent ? "is-current" : "")">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="mono-id">@comp.CompanyCode</span>
                    @if (comp.IsDefault)
                    {
                        <span class="af-badge b-yellow"><i class="bi bi-star-fill"></i> Default</span>
                    }
                    @if (isCurrent)
                    {
                        <span class="af-badge b-indigo"><i class="bi bi-check2"></i> Active now</span>
                    }
                    <span class="af-badge ms-auto @(comp.IsActive ? "b-green" : "b-red")">@(comp.IsActive ? "Active" : "Inactive")</span>
                </div>

                <div>
                    <div class="ql-title text-truncate" title="@comp.CompanyName">@comp.CompanyName</div>
                    <div class="ql-desc"><i class="bi bi-geo-alt"></i> @(string.IsNullOrWhiteSpace(comp.City) ? "India" : $"{comp.City}, {comp.State} - {comp.PinCode}")</div>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">GSTIN</div>
                        <div class="info-value font-monospace text-xs text-truncate">@(string.IsNullOrWhiteSpace(comp.Gstin) ? "—" : comp.Gstin)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">PAN</div>
                        <div class="info-value font-monospace text-xs text-truncate">@(string.IsNullOrWhiteSpace(comp.Pan) ? "—" : comp.Pan)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Bank</div>
                        <div class="info-value text-sm text-truncate">@(string.IsNullOrWhiteSpace(comp.BankName) ? "—" : comp.BankName)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Invoice prefix</div>
                        <div class="info-value font-monospace text-xs">@(string.IsNullOrWhiteSpace(comp.InvoicePrefix) ? "INV-" : comp.InvoicePrefix)</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-3 border-top">
                    @if (isCurrent)
                    {
                        <button class="btn btn-sm btn-secondary flex-grow-1" disabled>
                            <i class="bi bi-check2"></i> Current company
                        </button>
                    }
                    else
                    {
                        <a asp-action="Switch" asp-route-companyId="@comp.Id" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-primary flex-grow-1">
                            <i class="bi bi-arrow-repeat"></i> Switch to this
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-secondary btn-icon" data-bs-toggle="dropdown" aria-label="More actions">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@comp.Id">
                                        <i class="bi bi-pencil"></i> Edit details
                                    </a>
                                </li>
                                @if (!comp.IsDefault)
                                {
                                    <li>
                                        <form asp-action="SetDefault" asp-route-id="@comp.Id" method="post" onsubmit="return confirm('Make @comp.CompanyName the default company?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-star"></i> Set as default
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
