@model AashanaFashion.Models.Company
@{
    ViewData["Title"] = "Add New Company";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="page-header">
            <div>
                <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Companies</a>
                <h1 class="page-title">Create New Company</h1>
                <p class="page-sub">Legal identity, address, bank details and document numbering for this company.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-info-circle"></i> Basic Company Information</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="CompanyName" class="form-label">Company Legal Name <span class="req">*</span></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="e.g. Aashana Fashion Pvt Ltd" required />
                            <span asp-validation-for="CompanyName" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CompanyCode" class="form-label">Company Code <span class="req">*</span></label>
                            <input asp-for="CompanyCode" class="form-control text-uppercase" placeholder="e.g. AF-MAIN or AF-SURAT" required />
                            <span asp-validation-for="CompanyCode" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gstin" class="form-label">GSTIN</label>
                            <input asp-for="Gstin" class="form-control text-uppercase font-monospace" placeholder="e.g. 24AABCA1234F1Z9" maxlength="15" />
                            <span asp-validation-for="Gstin" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Pan" class="form-label">PAN Number</label>
                            <input asp-for="Pan" class="form-control text-uppercase font-monospace" placeholder="e.g. AABCA1234F" maxlength="10" />
                            <span asp-validation-for="Pan" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Phone" class="form-label">Contact Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210" />
                            <span asp-validation-for="Phone" class="af-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Contact Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="info@company.com" />
                            <span asp-validation-for="Email" class="af-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AuthorizedSignatory" class="form-label">Authorized Signatory Name</label>
                            <input asp-for="AuthorizedSignatory" class="form-control" placeholder="e.g. Partner / Director" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-geo-alt"></i> Registered Office & Address</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Address1" class="form-label">Address Line 1</label>
                            <input asp-for="Address1" class="form-control" placeholder="Plot / Unit No, Building" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address2" class="form-label">Address Line 2 (Area/Locality)</label>
                            <input asp-for="Address2" class="form-control" placeholder="Road, GIDC or Estate" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" placeholder="Surat" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="State" class="form-label">State</label>
                            <input asp-for="State" class="form-control" placeholder="Gujarat" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="StateCode" class="form-label">State Code</label>
                            <input asp-for="StateCode" class="form-control font-monospace" placeholder="24" maxlength="2" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PinCode" class="form-label">PIN Code</label>
                            <input asp-for="PinCode" class="form-control font-monospace" placeholder="394221" maxlength="6" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-bank"></i> Bank Account Details (Printed on Invoices)</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label">Bank Name</label>
                            <input asp-for="BankName" class="form-control" placeholder="e.g. HDFC Bank" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankAccountNumber" class="form-label">Account Number</label>
                            <input asp-for="BankAccountNumber" class="form-control font-monospace" placeholder="e.g. 50200012345678" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BankIfsc" class="form-label">IFSC Code</label>
                            <input asp-for="BankIfsc" class="form-control text-uppercase font-monospace" placeholder="e.g. HDFC0001234" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BankBranch" class="form-label">Branch Name</label>
                            <input asp-for="BankBranch" class="form-control" placeholder="e.g. Ring Road Branch" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UpiId" class="form-label">UPI ID / VPA</label>
                            <input asp-for="UpiId" class="form-control font-monospace" placeholder="e.g. aashana@hdfcbank" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-hash"></i> Document Sequence Prefixes & Status</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="InvoicePrefix" class="form-label">Tax Invoice Prefix</label>
                            <input asp-for="InvoicePrefix" class="form-control font-monospace text-uppercase" placeholder="e.g. AF/26-27/ or INV-" />
                            <div class="form-text">Prefix used when generating new invoice numbers.</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SalesOrderPrefix" class="form-label">Sales Order Prefix</label>
                            <input asp-for="SalesOrderPrefix" class="form-control font-monospace text-uppercase" placeholder="e.g. SO-2026- or SO/AF/" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PurchaseOrderPrefix" class="form-label">Purchase Order Prefix</label>
                            <input asp-for="PurchaseOrderPrefix" class="form-control font-monospace text-uppercase" placeholder="e.g. PO- or PO/AF/" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked id="isActiveCheck">
                                <label class="form-check-label" for="isActiveCheck">Active Company</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsDefault" class="form-check-input" type="checkbox" id="isDefaultCheck">
                                <label class="form-check-label" for="isDefaultCheck">Set as Default Company</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Company</button>
            </div>
        </form>
    </div>
</div>
