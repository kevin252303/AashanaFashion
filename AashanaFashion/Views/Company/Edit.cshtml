@model AashanaFashion.Models.Company
@{
    ViewData["Title"] = $"Edit Company - {Model.CompanyName}";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="page-header">
            <div>
                <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Companies</a>
                <h1 class="page-title">Edit Company: @Model.CompanyName</h1>
                <p class="page-sub">Legal identity, address, bank details and document numbering for this company.</p>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-info-circle"></i> Basic Company Information</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="CompanyName" class="form-label">Company Legal Name <span class="req">*</span></label>
                            <input asp-for="CompanyName" class="form-control" required />
                            <span asp-validation-for="CompanyName" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CompanyCode" class="form-label">Company Code <span class="req">*</span></label>
                            <input asp-for="CompanyCode" class="form-control text-uppercase" required />
                            <span asp-validation-for="CompanyCode" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gstin" class="form-label">GSTIN</label>
                            <input asp-for="Gstin" class="form-control text-uppercase font-monospace" maxlength="15" />
                            <span asp-validation-for="Gstin" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Pan" class="form-label">PAN Number</label>
                            <input asp-for="Pan" class="form-control text-uppercase font-monospace" maxlength="10" />
                            <span asp-validation-for="Pan" class="af-error"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Phone" class="form-label">Contact Phone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="af-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Contact Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="af-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AuthorizedSignatory" class="form-label">Authorized Signatory Name</label>
                            <input asp-for="AuthorizedSignatory" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-geo-alt"></i> Registered Office & Address</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Address1" class="form-label">Address Line 1</label>
                            <input asp-for="Address1" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address2" class="form-label">Address Line 2 (Area/Locality)</label>
                            <input asp-for="Address2" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="State" class="form-label">State</label>
                            <input asp-for="State" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="StateCode" class="form-label">State Code</label>
                            <input asp-for="StateCode" class="form-control font-monospace" maxlength="2" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PinCode" class="form-label">PIN Code</label>
                            <input asp-for="PinCode" class="form-control font-monospace" maxlength="6" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="data-card mb-4">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-bank"></i> Bank Account Details (Printed on Invoices)</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BankIfsc" class="form-label">IFSC Code</label>
                            <div class="input-group">
                                <input asp-for="BankIfsc" id="companyIfscInput" class="form-control text-uppercase font-monospace" maxlength="11" />
                                <button type="button" class="btn btn-secondary btn-sm" id="btnFetchCompanyIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                    <i class="bi bi-search"></i> Fetch
                                </button>
                            </div>
                            <div id="companyIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BankName" class="form-label">Bank Name</label>
                            <input asp-for="BankName" id="companyBankName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BankBranch" class="form-label">Branch Name</label>
                            <input asp-for="BankBranch" id="companyBankBranch" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankAccountNumber" class="form-label">Account Number</label>
                            <input asp-for="BankAccountNumber" class="form-control font-monospace" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UpiId" class="form-label">UPI ID / VPA</label>
                            <input asp-for="UpiId" class="form-control font-monospace" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Numbering & Document Formats -->
            <div class="data-card mb-4">
                <div class="data-card-header d-flex justify-content-between align-items-center">
                    <span class="data-card-title"><i class="bi bi-hash"></i> Document Numbering &amp; Sequence Formats</span>
                    <button type="button" class="btn btn-ghost btn-sm text-xs" data-bs-toggle="collapse" data-bs-target="#tokenHelperCollapse" aria-expanded="false">
                        <i class="bi bi-info-circle"></i> Available tokens
                    </button>
                </div>
                <div class="data-card-body">
                    <!-- Collapsible Token Helper -->
                    <div class="collapse mb-3" id="tokenHelperCollapse">
                        <div class="p-3 bg-light rounded border text-xs">
                            <div class="fw-semibold mb-2 text-dark">Supported pattern tokens:</div>
                            <div class="row g-2">
                                <div class="col-md-3"><code class="text-primary">{PREFIX}</code> — Prefix set in field below</div>
                                <div class="col-md-3"><code class="text-primary">{FY}</code> — Indian FY short (e.g. <code>26-27</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{FY4}</code> — Full FY (e.g. <code>2026-2027</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{YYYY}</code> — 4-digit Year (e.g. <code>2026</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{YY}</code> — 2-digit Year (e.g. <code>26</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{MM}</code> — 2-digit Month (e.g. <code>10</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{DD}</code> — 2-digit Day (e.g. <code>07</code>)</div>
                                <div class="col-md-3"><code class="text-primary">{COMP}</code> — Company Code (e.g. <code>AF</code>)</div>
                                <div class="col-md-6"><code class="text-primary">{0000}</code> or <code class="text-primary">{SEQ}</code> — Sequential counter padded to 4 digits (auto-resets per FY or Year/Month)</div>
                                <div class="col-md-6"><code class="text-primary">{00000}</code> — 5-digit sequential counter (e.g. <code>00001</code>)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Tax Invoice Numbering -->
                    <div class="border rounded p-3 mb-3 bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <label class="form-label fw-semibold mb-0"><i class="bi bi-receipt me-1"></i>Tax invoice numbering</label>
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-xs text-muted">Preview:</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace text-xs" id="invoicePreview">...</span>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label asp-for="InvoicePrefix" class="form-label text-xs text-muted mb-1">Prefix</label>
                                <input asp-for="InvoicePrefix" id="invoicePrefixInput" class="form-control form-control-sm font-monospace text-uppercase" placeholder="e.g. AF/ or INV-" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="InvoiceNumberFormat" class="form-label text-xs text-muted mb-1">Pattern format</label>
                                <input asp-for="InvoiceNumberFormat" id="invoiceFormatInput" class="form-control form-control-sm font-monospace" placeholder="{PREFIX}/{FY}/{0000}" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1 mt-2 flex-wrap">
                            <span class="text-2xs text-muted me-1">Presets:</span>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#invoiceFormatInput" data-format="{PREFIX}/{FY}/{0000}">GST FY: <code>{PREFIX}/{FY}/{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#invoiceFormatInput" data-format="{PREFIX}{YYYY}{MM}-{0000}">Year-Month: <code>{PREFIX}{YYYY}{MM}-{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#invoiceFormatInput" data-format="{PREFIX}/{YYYY}/{0000}">Calendar Year: <code>{PREFIX}/{YYYY}/{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#invoiceFormatInput" data-format="{PREFIX}{0000}">Sequential: <code>{PREFIX}{0000}</code></button>
                        </div>
                    </div>

                    <!-- Sales Order Numbering -->
                    <div class="border rounded p-3 mb-3 bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <label class="form-label fw-semibold mb-0"><i class="bi bi-cart-check me-1"></i>Sales order numbering</label>
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-xs text-muted">Preview:</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace text-xs" id="salesOrderPreview">...</span>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label asp-for="SalesOrderPrefix" class="form-label text-xs text-muted mb-1">Prefix</label>
                                <input asp-for="SalesOrderPrefix" id="soPrefixInput" class="form-control form-control-sm font-monospace text-uppercase" placeholder="e.g. SO/ or SO-" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="SalesOrderNumberFormat" class="form-label text-xs text-muted mb-1">Pattern format</label>
                                <input asp-for="SalesOrderNumberFormat" id="soFormatInput" class="form-control form-control-sm font-monospace" placeholder="{PREFIX}{YYYY}-{0000}" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1 mt-2 flex-wrap">
                            <span class="text-2xs text-muted me-1">Presets:</span>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#soFormatInput" data-format="{PREFIX}/{FY}/{0000}">GST FY: <code>{PREFIX}/{FY}/{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#soFormatInput" data-format="{PREFIX}{YYYY}-{0000}">Calendar Year: <code>{PREFIX}{YYYY}-{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#soFormatInput" data-format="{PREFIX}{0000}">Sequential: <code>{PREFIX}{0000}</code></button>
                        </div>
                    </div>

                    <!-- Purchase Order Numbering -->
                    <div class="border rounded p-3 mb-3 bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <label class="form-label fw-semibold mb-0"><i class="bi bi-bag-check me-1"></i>Purchase order numbering</label>
                            <div class="d-flex align-items-center gap-1">
                                <span class="text-xs text-muted">Preview:</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace text-xs" id="purchaseOrderPreview">...</span>
                            </div>
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label asp-for="PurchaseOrderPrefix" class="form-label text-xs text-muted mb-1">Prefix</label>
                                <input asp-for="PurchaseOrderPrefix" id="poPrefixInput" class="form-control form-control-sm font-monospace text-uppercase" placeholder="e.g. PO/ or PO-" />
                            </div>
                            <div class="col-md-8">
                                <label asp-for="PurchaseOrderNumberFormat" class="form-label text-xs text-muted mb-1">Pattern format</label>
                                <input asp-for="PurchaseOrderNumberFormat" id="poFormatInput" class="form-control form-control-sm font-monospace" placeholder="{PREFIX}{0000}" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1 mt-2 flex-wrap">
                            <span class="text-2xs text-muted me-1">Presets:</span>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#poFormatInput" data-format="{PREFIX}/{FY}/{0000}">GST FY: <code>{PREFIX}/{FY}/{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#poFormatInput" data-format="{PREFIX}{YYYY}-{0000}">Calendar Year: <code>{PREFIX}{YYYY}-{0000}</code></button>
                            <button type="button" class="btn btn-ghost btn-xs text-xs format-preset-btn" data-target="#poFormatInput" data-format="{PREFIX}{0000}">Sequential: <code>{PREFIX}{0000}</code></button>
                        </div>
                    </div>

                    <!-- Company Status -->
                    <div class="row g-3 pt-2">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck">
                                <label class="form-check-label" for="isActiveCheck">Active Company</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input asp-for="IsDefault" class="form-check-input" type="checkbox" id="isDefaultCheck">
                                <label class="form-check-label" for="isDefaultCheck">Set as Default Company</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Company</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        initIfscLookup({
            ifscInput: '#companyIfscInput',
            bankNameInput: '#companyBankName',
            branchInput: '#companyBankBranch',
            fetchBtn: '#btnFetchCompanyIfsc',
            statusContainer: '#companyIfscStatus'
        });

        function evaluateDocPreview(format, prefix, code) {
            format = (format || '{PREFIX}{0000}').trim();
            prefix = prefix || '';
            code = code || '';
            var d = new Date();
            var month = d.getMonth() + 1;
            var year = d.getFullYear();

            var startYear = month >= 4 ? year : year - 1;
            var endYear = startYear + 1;
            var fy2 = String(startYear % 100).padStart(2, '0') + '-' + String(endYear % 100).padStart(2, '0');
            var fy4 = startYear + '-' + endYear;

            var mm = String(month).padStart(2, '0');
            var dd = String(d.getDate()).padStart(2, '0');
            var yyyy = String(year);
            var yy = String(year % 100).padStart(2, '0');

            var res = format
                .replace(/\{PREFIX\}/gi, prefix)
                .replace(/\{COMPANY\}|\{COMP\}/gi, code)
                .replace(/\{FYFULL\}|\{FY4\}/gi, fy4)
                .replace(/\{FY\}/gi, fy2)
                .replace(/\{YYYY\}/gi, yyyy)
                .replace(/\{YY\}/gi, yy)
                .replace(/\{MM\}/gi, mm)
                .replace(/\{DD\}/gi, dd);

            var seqMatched = false;
            res = res.replace(/\{(0+|SEQ(?::?\d*)?)\}/gi, function (match, p1) {
                seqMatched = true;
                if (p1.startsWith('0')) {
                    return '1'.padStart(p1.length, '0');
                } else {
                    var digits = p1.replace(/\D/g, '');
                    var pad = parseInt(digits, 10) || 4;
                    return '1'.padStart(pad, '0');
                }
            });

            if (!seqMatched) {
                res += '0001';
            }

            return res;
        }

        function updateAllPreviews() {
            var code = document.querySelector('[name="CompanyCode"]')?.value || '';

            var invPrefix = document.getElementById('invoicePrefixInput')?.value || '';
            var invFormat = document.getElementById('invoiceFormatInput')?.value || '';
            var invEl = document.getElementById('invoicePreview');
            if (invEl) invEl.textContent = evaluateDocPreview(invFormat, invPrefix, code);

            var soPrefix = document.getElementById('soPrefixInput')?.value || '';
            var soFormat = document.getElementById('soFormatInput')?.value || '';
            var soEl = document.getElementById('salesOrderPreview');
            if (soEl) soEl.textContent = evaluateDocPreview(soFormat, soPrefix, code);

            var poPrefix = document.getElementById('poPrefixInput')?.value || '';
            var poFormat = document.getElementById('poFormatInput')?.value || '';
            var poEl = document.getElementById('purchaseOrderPreview');
            if (poEl) poEl.textContent = evaluateDocPreview(poFormat, poPrefix, code);
        }

        ['invoicePrefixInput', 'invoiceFormatInput', 'soPrefixInput', 'soFormatInput', 'poPrefixInput', 'poFormatInput'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('input', updateAllPreviews);
        });
        var compCode = document.querySelector('[name="CompanyCode"]');
        if (compCode) compCode.addEventListener('input', updateAllPreviews);

        document.querySelectorAll('.format-preset-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetId = btn.dataset.target;
                var format = btn.dataset.format;
                var input = document.querySelector(targetId);
                if (input) {
                    input.value = format;
                    updateAllPreviews();
                }
            });
        });

        updateAllPreviews();
    </script>
}
