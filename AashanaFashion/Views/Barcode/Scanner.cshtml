@{
    ViewData["Title"] = "Production Floor Barcode Scanner";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Floor Barcode &amp; QR Scanner</h1>
        <p class="page-sub">High-speed piece tracking station for USB laser scanners and camera scanning.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="PMS" asp-action="ProductionEntities" class="btn btn-secondary"><i class="bi bi-123"></i> Tracking entities</a>
        <a asp-controller="QualityControl" asp-action="Index" class="btn btn-secondary"><i class="bi bi-clipboard-check"></i> QC dashboard</a>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Scanner Input & Camera -->
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Scanner Input</h5>
                <span class="af-badge b-green"><span class="status-dot success"></span> Ready</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="barcodeInput">Scan barcode / QR code</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                        <input type="text" id="barcodeInput" class="form-control fw-medium font-monospace" placeholder="Scan or type barcode…" autofocus autocomplete="off" />
                        <button class="btn btn-primary" id="btnLookup" type="button">Lookup</button>
                    </div>
                    <span class="form-text">Handheld USB barcode guns trigger the lookup automatically on scan.</span>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button class="btn btn-secondary" type="button" id="btnToggleCamera">
                        <i class="bi bi-camera"></i> <span id="cameraBtnText">Open Webcam / Mobile Camera Scanner</span>
                    </button>
                </div>

                <!-- Camera Container -->
                <div id="cameraScannerWrapper" class="d-none panel-inset text-center mb-0">
                    <div id="reader" style="width: 100%; max-width: 400px; margin: 0 auto;"></div>
                </div>
            </div>
        </div>

        <!-- Session Scan Statistics -->
        <div class="metric-grid mb-0" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
            <div class="metric-card">
                <div class="metric-label">Total scans</div>
                <div class="metric-value" id="statTotalScans">0</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Successful</div>
                <div class="metric-value text-success" id="statSuccessScans">0</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Errors</div>
                <div class="metric-value text-danger" id="statErrorScans">0</div>
            </div>
        </div>
    </div>

    <!-- Right: Garment Details & 1-Scan Action Center -->
    <div class="col-lg-7">
        <div class="card mb-4" id="detailsCard">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Garment Piece Information</h5>
                <span id="garmentStatusBadge" class="af-badge b-gray">Awaiting scan</span>
            </div>
            <div class="card-body" id="scanEmptyState">
                <div class="empty-state">
                    <div class="es-icon"><i class="bi bi-upc-scan"></i></div>
                    <div class="es-title">Ready for scanning</div>
                    <p>Point your laser gun at a bundle sticker or use your camera.</p>
                </div>
            </div>

            <!-- Scanned Data Display (Initially Hidden) -->
            <div class="card-body d-none" id="scanDataContent">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="panel-inset h-100 mb-0">
                            <div class="info-label">Piece identifier</div>
                            <div class="ql-title font-monospace my-1" id="dispBarcode">—</div>
                            <div class="text-primary fw-medium" id="dispComponent">—</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="panel-inset h-100 mb-0">
                            <div class="info-label">Order &amp; design</div>
                            <div class="ql-title my-1" id="dispLot">—</div>
                            <div class="text-muted" id="dispDesign">—</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-label">Colour</div>
                        <div id="dispColour" class="info-value">—</div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Size</div>
                        <div id="dispSize" class="info-value">—</div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-label">Piece serial #</div>
                        <div id="dispSlNo" class="info-value">—</div>
                    </div>
                </div>

                <!-- Current Process Alert -->
                <div class="af-alert af-alert-warning align-items-center d-none" id="activeProcessBox">
                    <div class="alert-body">
                        <span class="alert-title">In progress</span>
                        <strong id="dispProcessName">Handwork</strong> at <span id="dispVendorName">Vendor ABC</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary flex-shrink-0" id="btnQuickReturn">
                        <i class="bi bi-check-lg"></i> Mark returned
                    </button>
                </div>

                <!-- 1-Scan Floor Action Controls -->
                <div class="panel mb-4">
                    <div class="panel-title mb-3">Floor dispatch / transfer</div>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Next process</label>
                            <select id="actionProcessName" class="form-select">
                                <option value="Dying">Dying</option>
                                <option value="Roll">Roll Press</option>
                                <option value="Handwork">Handwork</option>
                                <option value="Stitching">Stitching</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Assign vendor / worker</label>
                            <select id="actionVendorId" class="form-select">
                                <option value="">-- In-House --</option>
                                @foreach (var v in (List<AashanaFashion.Models.Vendor>)ViewBag.Vendors)
                                {
                                    <option value="@v.Id">@v.VendorName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary w-100" id="btnDispatchAction">
                                <i class="bi bi-upload"></i> Dispatch Piece
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Process History -->
                <div>
                    <div class="micro-label">Stage tracking history</div>
                    <div id="historyTableContainer"></div>
                </div>
            </div>
        </div>

        <!-- Live Scan Session Log Table -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Session Activity Log</h5>
                <button type="button" class="btn btn-sm btn-ghost" id="btnClearLog">Clear log</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Barcode</th>
                                <th>Piece</th>
                                <th>Action Performed</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="sessionLogBody">
                            <tr id="emptyLogPrompt">
                                <td colspan="5" class="text-center py-4 text-muted">No scans in this session yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- html5-qrcode lightweight library for webcam/mobile camera scanning -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        // Web Audio Synthesizer Beeps
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playBeep(success) {
            try {
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (success) {
                    // High cheerful double-beep
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, audioCtx.currentTime); // A5
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.08);

                    setTimeout(() => {
                        const osc2 = audioCtx.createOscillator();
                        const gain2 = audioCtx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(audioCtx.destination);
                        osc2.type = 'sine';
                        osc2.frequency.setValueAtTime(1174.66, audioCtx.currentTime); // D6
                        gain2.gain.setValueAtTime(0.15, audioCtx.currentTime);
                        osc2.start();
                        osc2.stop(audioCtx.currentTime + 0.1);
                    }, 90);
                } else {
                    // Low buzz
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.25);
                }
            } catch (e) {
                console.log('Audio feedback not available', e);
            }
        }

        let totalScans = 0;
        let successScans = 0;
        let errorScans = 0;
        let currentScannedBarcode = null;

        function updateStats(success) {
            totalScans++;
            if (success) successScans++; else errorScans++;
            $('#statTotalScans').text(totalScans);
            $('#statSuccessScans').text(successScans);
            $('#statErrorScans').text(errorScans);
        }

        function addSessionLog(barcode, piece, action, isSuccess) {
            $('#emptyLogPrompt').remove();
            const time = new Date().toLocaleTimeString();
            const badge = isSuccess 
                ? '<span class="af-badge b-green">Success</span>' 
                : '<span class="af-badge b-red">Error</span>';

            const row = `
                <tr>
                    <td class="text-muted">${time}</td>
                    <td class="font-monospace fw-medium">${barcode}</td>
                    <td>${piece}</td>
                    <td>${action}</td>
                    <td>${badge}</td>
                </tr>
            `;
            $('#sessionLogBody').prepend(row);
        }

        // Barcode Lookup
        function doLookup(code) {
            if (!code || code.trim() === '') return;
            code = code.trim();

            $.ajax({
                url: '/Barcode/Lookup',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ code: code }),
                success: function (res) {
                    if (res.success) {
                        playBeep(true);
                        updateStats(true);
                        currentScannedBarcode = res.barcode;

                        $('#scanEmptyState').addClass('d-none');
                        $('#scanDataContent').removeClass('d-none');

                        $('#garmentStatusBadge').text(res.status).removeClass().addClass('af-badge b-indigo');
                        $('#dispBarcode').text(res.barcode);
                        $('#dispComponent').text(res.entityType + ' #' + res.slNo);
                        $('#dispLot').text('Lot ' + res.lotNo);
                        $('#dispDesign').text(res.designNumber);
                        $('#dispColour').text(res.colour);
                        $('#dispSize').text(res.size);
                        $('#dispSlNo').text('#' + res.slNo);

                        if (res.currentProcess) {
                            $('#activeProcessBox').removeClass('d-none');
                            $('#dispProcessName').text(res.currentProcess);
                            $('#dispVendorName').text(res.currentVendor || 'In-House');
                        } else {
                            $('#activeProcessBox').addClass('d-none');
                        }

                        // History
                        let historyHtml = '<div class="grid-card"><table class="af-table table-sm"><thead><tr><th>Process</th><th>Vendor</th><th>Given</th><th>Returned</th></tr></thead><tbody>';
                        if (res.history && res.history.length > 0) {
                            res.history.forEach(h => {
                                historyHtml += `<tr><td>${h.processName}</td><td>${h.vendorName || 'In-House'}</td><td>${h.givenDate || '—'}</td><td>${h.actualReturnDate || 'Ongoing'}</td></tr>`;
                            });
                        } else {
                            historyHtml += '<tr><td colspan="4" class="text-center text-muted">No past tracking records</td></tr>';
                        }
                        historyHtml += '</tbody></table></div>';
                        $('#historyTableContainer').html(historyHtml);

                        addSessionLog(res.barcode, res.entityType + ' #' + res.slNo, 'Looked up garment info', true);
                    } else {
                        playBeep(false);
                        updateStats(false);
                        addSessionLog(code, '—', res.message || 'Not found', false);
                        alert(res.message || 'Barcode not recognized.');
                    }
                },
                error: function () {
                    playBeep(false);
                    updateStats(false);
                    alert('Error connecting to scanner API.');
                },
                complete: function () {
                    $('#barcodeInput').val('').focus();
                }
            });
        }

        // Trigger lookup on Enter key
        $('#barcodeInput').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                doLookup($(this).val());
            }
        });

        $('#btnLookup').on('click', function () {
            doLookup($('#barcodeInput').val());
        });

        // Quick Return Button Action
        $('#btnQuickReturn').on('click', function () {
            if (!currentScannedBarcode) return;

            $.ajax({
                url: '/Barcode/ExecuteScanAction',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    barcode: currentScannedBarcode,
                    actionType: 'Return'
                }),
                success: function (res) {
                    if (res.success) {
                        playBeep(true);
                        alert(res.message);
                        addSessionLog(currentScannedBarcode, $('#dispComponent').text(), 'Marked Returned', true);
                        doLookup(currentScannedBarcode);
                    } else {
                        playBeep(false);
                        alert(res.message);
                    }
                }
            });
        });

        // Dispatch Action
        $('#btnDispatchAction').on('click', function () {
            if (!currentScannedBarcode) return;

            const processName = $('#actionProcessName').val();
            const vendorId = $('#actionVendorId').val() ? parseInt($('#actionVendorId').val()) : null;

            $.ajax({
                url: '/Barcode/ExecuteScanAction',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    barcode: currentScannedBarcode,
                    actionType: 'SendProcess',
                    processName: processName,
                    vendorId: vendorId
                }),
                success: function (res) {
                    if (res.success) {
                        playBeep(true);
                        alert(res.message);
                        addSessionLog(currentScannedBarcode, $('#dispComponent').text(), 'Dispatched to ' + processName, true);
                        doLookup(currentScannedBarcode);
                    } else {
                        playBeep(false);
                        alert(res.message);
                    }
                }
            });
        });

        $('#btnClearLog').on('click', function () {
            $('#sessionLogBody').html('<tr id="emptyLogPrompt"><td colspan="5" class="text-center py-4 text-muted">No scans in this session yet.</td></tr>');
        });

        // Camera Scanner Toggle
        let html5QrcodeScanner = null;
        $('#btnToggleCamera').on('click', function () {
            const wrapper = $('#cameraScannerWrapper');
            if (wrapper.hasClass('d-none')) {
                wrapper.removeClass('d-none');
                $('#cameraBtnText').text('Close Camera Scanner');

                if (!html5QrcodeScanner) {
                    html5QrcodeScanner = new Html5Qrcode("reader");
                }

                html5QrcodeScanner.start(
                    { facingMode: "environment" },
                    { fps: 10, qrbox: { width: 250, height: 250 } },
                    (decodedText) => {
                        doLookup(decodedText);
                    },
                    (errorMessage) => {
                        // ignore frame errors
                    }
                ).catch((err) => {
                    alert('Camera access denied or unavailable: ' + err);
                    wrapper.addClass('d-none');
                    $('#cameraBtnText').text('Open Webcam / Mobile Camera Scanner');
                });
            } else {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.stop().then(() => {
                        wrapper.addClass('d-none');
                        $('#cameraBtnText').text('Open Webcam / Mobile Camera Scanner');
                    });
                } else {
                    wrapper.addClass('d-none');
                    $('#cameraBtnText').text('Open Webcam / Mobile Camera Scanner');
                }
            }
        });
    </script>
}
