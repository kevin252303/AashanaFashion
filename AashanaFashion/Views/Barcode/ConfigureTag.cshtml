@model AashanaFashion.Models.BarcodeTagConfig
@{
    ViewData["Title"] = "Configure Barcode Tag";
    var dynamicFields = Model.GetDynamicCustomFields();
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="page-title mb-1">Configure Barcode Tag</h1>
        <p class="page-sub mb-0">Customize label layout, toggle fields, alter labels, and add new custom details to garment barcode tags.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form asp-action="ResetConfig" method="post" class="d-inline" onsubmit="return confirm('Reset all barcode tag settings to default values?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                🔄 Reset to Defaults
            </button>
        </form>
        <a asp-controller="Production" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            ← Back to Production
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><span class="alert-body">@TempData["Success"]</span><button class="alert-close">&times;</button></div>
}

<form asp-action="ConfigureTag" method="post" id="tagConfigForm">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ConfigName" />
<input type="hidden" asp-for="IsDefault" />
<input type="hidden" name="dynamicFieldsJson" id="dynamicFieldsJsonInput" value="@Model.DynamicCustomFieldsJson" />

<div class="row g-4">
    <!-- Left Column: Controls & Field Settings -->
    <div class="col-lg-7">
        
        <!-- Dimensions & Font Size -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <span>📏</span> Tag Dimensions & Typography
            </h6>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label class="form-label small fw-semibold text-muted">Tag Width (mm)</label>
                    <div class="input-group input-group-sm">
                        <input type="number" asp-for="TagWidthMm" class="form-control live-cfg-input" id="cfgTagWidth" min="30" max="150" />
                        <span class="input-group-text">mm</span>
                    </div>
                    <small class="text-muted" style="font-size:0.7rem;">Thermal default: 50mm</small>
                </div>
                <div class="col-sm-4">
                    <label class="form-label small fw-semibold text-muted">Tag Height (mm)</label>
                    <div class="input-group input-group-sm">
                        <input type="number" asp-for="TagHeightMm" class="form-control live-cfg-input" id="cfgTagHeight" min="20" max="150" />
                        <span class="input-group-text">mm</span>
                    </div>
                    <small class="text-muted" style="font-size:0.7rem;">Thermal default: 30mm</small>
                </div>
                <div class="col-sm-4">
                    <label class="form-label small fw-semibold text-muted">Font Scale</label>
                    <select asp-for="FontSize" class="form-select form-select-sm live-cfg-input" id="cfgFontSize">
                        <option value="small">Small (Compact)</option>
                        <option value="normal">Normal (Standard)</option>
                        <option value="large">Large (High Legibility)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Branding & Header Details -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <span>🏷️</span> Header & Brand Details
            </h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowBrandName" id="cfgShowBrand" />
                        <label class="form-check-label small fw-bold" for="cfgShowBrand">Show Brand Name</label>
                    </div>
                    <input type="text" asp-for="BrandName" class="form-control form-control-sm live-cfg-input" id="cfgBrandName" placeholder="Company / Brand" />
                </div>
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowSubtitle" id="cfgShowSubtitle" />
                        <label class="form-check-label small fw-bold" for="cfgShowSubtitle">Show Subtitle / Tagline</label>
                    </div>
                    <input type="text" asp-for="Subtitle" class="form-control form-control-sm live-cfg-input" id="cfgSubtitle" placeholder="e.g. Designer Ethnic Wear" />
                </div>
            </div>
        </div>

        <!-- Current Default Garment Details (Configurable & Alterable) -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <span>👗</span> Garment Information (Default Details)
                </h6>
                <span class="badge bg-light text-secondary border small">Configurable Labels</span>
            </div>
            <p class="text-muted small mb-3">Default details configured on garment tags. You can enable/disable each field or alter its display label.</p>

            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0" style="font-size:0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 45px;" class="text-center">Show</th>
                            <th>Field Name</th>
                            <th>Display Label / Prefix</th>
                            <th>Sample Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowDesignNumber" class="form-check-input live-cfg-check" id="cfgShowDesign" />
                            </td>
                            <td class="fw-semibold">Design Number</td>
                            <td>
                                <input type="text" asp-for="DesignNumberLabel" class="form-control form-control-sm live-cfg-input" id="cfgDesignLabel" />
                            </td>
                            <td class="text-muted font-monospace">AF-3052</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowLotNo" class="form-check-input live-cfg-check" id="cfgShowLot" />
                            </td>
                            <td class="fw-semibold">Lot Number</td>
                            <td>
                                <input type="text" asp-for="LotNoLabel" class="form-control form-control-sm live-cfg-input" id="cfgLotLabel" />
                            </td>
                            <td class="text-muted font-monospace">LOT-202609-001</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowSerialNumber" class="form-check-input live-cfg-check" id="cfgShowSerial" />
                            </td>
                            <td class="fw-semibold">Serial Number</td>
                            <td>
                                <input type="text" asp-for="SerialNumberLabel" class="form-control form-control-sm live-cfg-input" id="cfgSerialLabel" />
                            </td>
                            <td class="text-muted font-monospace">#14</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowComponent" class="form-check-input live-cfg-check" id="cfgShowComponent" />
                            </td>
                            <td class="fw-semibold">Component / Part</td>
                            <td>
                                <input type="text" asp-for="ComponentLabel" class="form-control form-control-sm live-cfg-input" id="cfgComponentLabel" />
                            </td>
                            <td class="text-muted">Chaniya</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowColour" class="form-check-input live-cfg-check" id="cfgShowColour" />
                            </td>
                            <td class="fw-semibold">Colour</td>
                            <td>
                                <input type="text" asp-for="ColourLabel" class="form-control form-control-sm live-cfg-input" id="cfgColourLabel" />
                            </td>
                            <td class="text-muted">Rani Pink</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" asp-for="ShowSize" class="form-check-input live-cfg-check" id="cfgShowSize" />
                            </td>
                            <td class="fw-semibold">Size</td>
                            <td>
                                <input type="text" asp-for="SizeLabel" class="form-control form-control-sm live-cfg-input" id="cfgSizeLabel" />
                            </td>
                            <td class="text-muted">M (38)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Barcode & QR Code Section -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <span>📱</span> Barcode & QR Code Configuration
            </h6>
            <div class="row g-3 align-items-center">
                <div class="col-sm-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowBarcode" id="cfgShowBarcode" />
                        <label class="form-check-label small fw-bold" for="cfgShowBarcode">Show 1D Barcode</label>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowBarcodeText" id="cfgShowBarcodeText" />
                        <label class="form-check-label small fw-bold" for="cfgShowBarcodeText">Show Barcode Digits</label>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowQrCode" id="cfgShowQr" />
                        <label class="form-check-label small fw-bold" for="cfgShowQr">Show QR Code</label>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Barcode Height (px)</label>
                    <input type="range" class="form-range live-cfg-input" asp-for="BarcodeHeight" min="20" max="60" id="cfgBarcodeHeight" oninput="$('#barcodeHeightVal').text(this.value + 'px')" />
                    <span id="barcodeHeightVal" class="small text-muted font-monospace">@Model.BarcodeHeight px</span>
                </div>
            </div>
        </div>

        <!-- Commercial, Pricing & Product Identifiers -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <span>💰</span> Commercial, Pricing & Product Details
            </h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowPrice" id="cfgShowPrice" />
                        <label class="form-check-label small fw-bold" for="cfgShowPrice">Show M.R.P. / Price</label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Label:</span>
                        <input type="text" asp-for="PriceLabel" class="form-control live-cfg-input" id="cfgPriceLabel" placeholder="M.R.P. ₹" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowMfgDate" id="cfgShowMfgDate" />
                        <label class="form-check-label small fw-bold" for="cfgShowMfgDate">Show Mfg / Pkg Date</label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Label:</span>
                        <input type="text" asp-for="MfgDateLabel" class="form-control live-cfg-input" id="cfgMfgLabel" placeholder="Mfg Date:" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowCategory" id="cfgShowCategory" />
                        <label class="form-check-label small fw-bold" for="cfgShowCategory">Show Product Category</label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Label:</span>
                        <input type="text" asp-for="CategoryLabel" class="form-control live-cfg-input" id="cfgCategoryLabel" placeholder="Category:" />
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowHsnCode" id="cfgShowHsn" />
                        <label class="form-check-label small fw-bold" for="cfgShowHsn">Show HSN / SAC Code</label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Label:</span>
                        <input type="text" asp-for="HsnLabel" class="form-control live-cfg-input" id="cfgHsnLabel" placeholder="HSN:" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Standard Additional Details (Fabric, Care, Origin, Footer) -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-3">
            <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <span>🧵</span> Fabric, Care & Standard Attributes
            </h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowCustomField1" id="cfgShowCust1" />
                        <label class="form-check-label small fw-bold" for="cfgShowCust1">Enable Field 1 (e.g. Fabric)</label>
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text" style="width:70px;">Label:</span>
                        <input type="text" asp-for="CustomField1Label" class="form-control live-cfg-input" id="cfgCust1Label" placeholder="Fabric" />
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="width:70px;">Value:</span>
                        <input type="text" asp-for="CustomField1Value" class="form-control live-cfg-input" id="cfgCust1Val" placeholder="Net / Georgette / Silk" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowCustomField2" id="cfgShowCust2" />
                        <label class="form-check-label small fw-bold" for="cfgShowCust2">Enable Field 2 (e.g. Wash Care)</label>
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text" style="width:70px;">Label:</span>
                        <input type="text" asp-for="CustomField2Label" class="form-control live-cfg-input" id="cfgCust2Label" placeholder="Care" />
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="width:70px;">Value:</span>
                        <input type="text" asp-for="CustomField2Value" class="form-control live-cfg-input" id="cfgCust2Val" placeholder="Dry Clean Only" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowCustomField3" id="cfgShowCust3" />
                        <label class="form-check-label small fw-bold" for="cfgShowCust3">Enable Field 3 (e.g. Country of Origin)</label>
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text" style="width:70px;">Label:</span>
                        <input type="text" asp-for="CustomField3Label" class="form-control live-cfg-input" id="cfgCust3Label" placeholder="Origin" />
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="width:70px;">Value:</span>
                        <input type="text" asp-for="CustomField3Value" class="form-control live-cfg-input" id="cfgCust3Val" placeholder="Made in India" />
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input live-cfg-check" type="checkbox" asp-for="ShowFooterText" id="cfgShowFooter" />
                        <label class="form-check-label small fw-bold" for="cfgShowFooter">Show Footer Note</label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="width:70px;">Text:</span>
                        <input type="text" asp-for="FooterText" class="form-control live-cfg-input" id="cfgFooterText" placeholder="(Inclusive of all taxes)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Dynamic New Details (Add Any Custom Field) -->
        <div class="card p-3 border rounded-3 bg-white shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>➕</span> Add New Custom Details
                    </h6>
                    <small class="text-muted">Define extra custom fields to print on tags (e.g., Net Quantity, Batch, Packer).</small>
                </div>
                <button type="button" class="btn btn-sm btn-primary" id="btnAddNewField">
                    + Add Detail
                </button>
            </div>

            <div id="dynamicFieldsContainer" class="d-flex flex-column gap-2">
                @if (dynamicFields.Any())
                {
                    @foreach (var df in dynamicFields)
                    {
                        <div class="dynamic-field-row d-flex align-items-center gap-2 p-2 bg-light border rounded" data-id="@df.Id">
                            <div class="form-check mb-0">
                                <input type="checkbox" class="form-check-input dyn-field-enable live-cfg-check" @(df.Enabled ? "checked" : "") />
                            </div>
                            <input type="text" class="form-control form-control-sm dyn-field-label live-cfg-input" placeholder="Field Label (e.g. Net Qty)" value="@df.Label" style="max-width:140px;" />
                            <input type="text" class="form-control form-control-sm dyn-field-value live-cfg-input flex-grow-1" placeholder="Field Value (e.g. 1 N)" value="@df.Value" />
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-dyn-field py-1 px-2" title="Remove field">🗑️</button>
                        </div>
                    }
                }
            </div>
            <div id="noDynamicFieldsMsg" class="text-muted small text-center py-2 @(dynamicFields.Any() ? "d-none" : "")">
                No extra custom details added. Click "+ Add Detail" to add more.
            </div>
        </div>

        <!-- Save Button Bar -->
        <div class="p-3 bg-white border rounded-3 shadow-sm d-flex justify-content-between align-items-center mb-5">
            <span class="text-muted small">All changes will apply to future printed tags automatically.</span>
            <button type="submit" class="btn btn-success fw-bold px-4">
                💾 Save Configuration
            </button>
        </div>

    </div>

    <!-- Right Column: Live Interactive Tag Preview -->
    <div class="col-lg-5">
        <div class="sticky-top" style="top: 80px; z-index: 10;">
            <div class="card p-3 border rounded-3 bg-white shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span>👁️</span> Live Tag Preview
                    </h6>
                    <span class="badge bg-primary text-white" id="previewDimsBadge">50mm × 30mm</span>
                </div>
                <p class="text-muted small mb-3">Real-time simulation of the physical printed barcode tag.</p>

                <!-- Tag Simulation Stage -->
                <div class="p-4 bg-light border rounded-3 d-flex justify-content-center align-items-center" style="min-height: 280px; overflow: auto;">
                    
                    <div id="liveTagPreview" class="preview-tag-box" style="
                        width: 50mm;
                        min-height: 30mm;
                        background: #ffffff;
                        border: 1px dashed #000000;
                        padding: 2.5mm 3.5mm;
                        box-sizing: border-box;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
                        color: #0f172a;
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
                    ">
                        <!-- Tag Header (Brand & Subtitle) -->
                        <div id="prevHeaderSection" class="border-bottom pb-1 mb-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div id="prevBrandName" class="fw-bold text-uppercase" style="font-size: 8pt; letter-spacing: 0.5px;">Aashana Fashion</div>
                                    <div id="prevSubtitle" class="text-muted" style="font-size: 6.5pt; display: none;">Designer Ethnic Wear</div>
                                </div>
                                <div class="text-end" id="prevLotSerialBox">
                                    <span id="prevLotNo" class="fw-bold font-monospace" style="font-size: 7pt;">Lot: LOT-202609-001</span>
                                    <div id="prevSerialNo" class="text-muted" style="font-size: 6.5pt;">#14</div>
                                </div>
                            </div>
                        </div>

                        <!-- Garment Primary Details (Design, Component, Colour, Size) -->
                        <div id="prevPrimaryDetails" class="mb-1" style="font-size: 7.5pt; line-height: 1.25;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span id="prevDesignBox" class="fw-bold" style="font-size: 8.5pt;">Design: AF-3052</span>
                                <span id="prevComponentBox" class="fw-bold text-uppercase badge bg-light text-dark border p-1" style="font-size:6.5pt;">Chaniya</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span id="prevColourBox">Colour: <strong>Rani Pink</strong></span>
                                <span id="prevSizeBox">Size: <strong>M (38)</strong></span>
                            </div>
                        </div>

                        <!-- Extra Details (Commercial / Fabric / Custom) -->
                        <div id="prevExtraDetails" class="py-1 border-top border-bottom mb-1" style="font-size: 6.8pt; line-height: 1.2; display: none;">
                            <div id="prevPriceRow" style="display: none;" class="fw-bold text-dark">M.R.P. ₹: <strong>₹ 4,999.00</strong></div>
                            <div id="prevMfgRow" style="display: none;" class="text-muted">Mfg Date: <strong>@DateTime.Now.ToString("MM/yyyy")</strong></div>
                            <div id="prevCategoryRow" style="display: none;" class="text-muted">Category: <strong>Lehenga Choli</strong></div>
                            <div id="prevHsnRow" style="display: none;" class="text-muted">HSN: <strong>6204</strong></div>
                            <div id="prevCust1Row" style="display: none;" class="text-muted">Fabric: <strong>Net / Silk</strong></div>
                            <div id="prevCust2Row" style="display: none;" class="text-muted">Wash Care: <strong>Dry Clean Only</strong></div>
                            <div id="prevCust3Row" style="display: none;" class="text-muted">Origin: <strong>Made in India</strong></div>
                            <div id="prevDynamicRowsContainer"></div>
                        </div>

                        <!-- Barcode & QR Code Row -->
                        <div id="prevCodesRow" class="d-flex align-items-center justify-content-between gap-1 mt-auto pt-1">
                            <div id="prevBarcodeBox" class="flex-grow-1" style="max-width: 32mm;">
                                <div id="prevBarcodeSvgContainer">
                                    @Html.Raw(ViewBag.SampleBarcodeSvg)
                                </div>
                            </div>
                            <div id="prevQrBox" style="width: 12mm; height: 12mm; flex-shrink: 0;">
                                <div id="prevQrSvgContainer">
                                    @Html.Raw(ViewBag.SampleQrCodeSvg)
                                </div>
                            </div>
                        </div>

                        <!-- Footer Note -->
                        <div id="prevFooterRow" class="text-center text-muted border-top pt-1 mt-1" style="font-size: 6pt; display: none;">
                            (Incl. of all taxes)
                        </div>

                    </div>
                </div>

                <div class="mt-3 p-2 bg-light rounded text-center small text-muted">
                    💡 This preview reflects real thermal print paper sizing. You can adjust dimensions to match your thermal printer roll (e.g. 50x28mm, 50x30mm, 60x40mm).
                </div>
            </div>
        </div>
    </div>
</div>
</form>

@section Scripts {
    <script>
        function updateLivePreview() {
            var widthMm = parseInt($('#cfgTagWidth').val()) || 50;
            var heightMm = parseInt($('#cfgTagHeight').val()) || 30;
            var fontScale = $('#cfgFontSize').val();

            $('#previewDimsBadge').text(widthMm + 'mm × ' + heightMm + 'mm');
            $('#liveTagPreview').css({
                'width': widthMm + 'mm',
                'min-height': heightMm + 'mm'
            });

            // Font scale multiplier
            var baseScale = fontScale === 'small' ? 0.85 : (fontScale === 'large' ? 1.15 : 1.0);
            $('#liveTagPreview').css('font-size', (8 * baseScale) + 'pt');

            // Brand & Subtitle
            var showBrand = $('#cfgShowBrand').is(':checked');
            var brandName = $('#cfgBrandName').val() || 'Aashana Fashion';
            var showSubtitle = $('#cfgShowSubtitle').is(':checked');
            var subtitle = $('#cfgSubtitle').val() || '';

            $('#prevBrandName').toggle(showBrand).text(brandName);
            $('#prevSubtitle').toggle(showSubtitle && subtitle.length > 0).text(subtitle);
            $('#prevHeaderSection').toggle(showBrand || showSubtitle);

            // Lot & Serial
            var showLot = $('#cfgShowLot').is(':checked');
            var lotLabel = $('#cfgLotLabel').val() || 'Lot';
            var showSerial = $('#cfgShowSerial').is(':checked');
            var serialLabel = $('#cfgSerialLabel').val() || '#';

            $('#prevLotNo').toggle(showLot).text(lotLabel + ': LOT-202609-001');
            $('#prevSerialNo').toggle(showSerial).text(serialLabel + '14');
            $('#prevLotSerialBox').toggle(showLot || showSerial);

            // Garment Details
            var showDesign = $('#cfgShowDesign').is(':checked');
            var designLabel = $('#cfgDesignLabel').val() || 'Design';
            var showComponent = $('#cfgShowComponent').is(':checked');
            var componentLabel = $('#cfgComponentLabel').val() || 'Part';
            var showColour = $('#cfgShowColour').is(':checked');
            var colourLabel = $('#cfgColourLabel').val() || 'Colour';
            var showSize = $('#cfgShowSize').is(':checked');
            var sizeLabel = $('#cfgSizeLabel').val() || 'Size';

            $('#prevDesignBox').toggle(showDesign).html(designLabel + ': <strong>AF-3052</strong>');
            $('#prevComponentBox').toggle(showComponent).text('Chaniya');
            $('#prevColourBox').toggle(showColour).html(colourLabel + ': <strong>Rani Pink</strong>');
            $('#prevSizeBox').toggle(showSize).html(sizeLabel + ': <strong>M (38)</strong>');

            // Barcode & QR Code
            var showBarcode = $('#cfgShowBarcode').is(':checked');
            var showQr = $('#cfgShowQr').is(':checked');
            $('#prevBarcodeBox').toggle(showBarcode);
            $('#prevQrBox').toggle(showQr);
            $('#prevCodesRow').toggle(showBarcode || showQr);

            // Pricing & Commercial
            var showPrice = $('#cfgShowPrice').is(':checked');
            var priceLabel = $('#cfgPriceLabel').val() || 'M.R.P. ₹';
            $('#prevPriceRow').toggle(showPrice).html(priceLabel + ' <strong>4,999.00</strong>');

            var showMfg = $('#cfgShowMfgDate').is(':checked');
            var mfgLabel = $('#cfgMfgLabel').val() || 'Mfg Date:';
            $('#prevMfgRow').toggle(showMfg).html(mfgLabel + ' <strong>@DateTime.Now.ToString("MM/yyyy")</strong>');

            var showCat = $('#cfgShowCategory').is(':checked');
            var catLabel = $('#cfgCategoryLabel').val() || 'Category:';
            $('#prevCategoryRow').toggle(showCat).html(catLabel + ' <strong>Lehenga Choli</strong>');

            var showHsn = $('#cfgShowHsn').is(':checked');
            var hsnLabel = $('#cfgHsnLabel').val() || 'HSN:';
            $('#prevHsnRow').toggle(showHsn).html(hsnLabel + ' <strong>6204</strong>');

            // Custom Details 1, 2, 3
            var showCust1 = $('#cfgShowCust1').is(':checked');
            var cust1Label = $('#cfgCust1Label').val() || 'Fabric:';
            var cust1Val = $('#cfgCust1Val').val() || 'Net / Silk';
            $('#prevCust1Row').toggle(showCust1).html(cust1Label + ': <strong>' + cust1Val + '</strong>');

            var showCust2 = $('#cfgShowCust2').is(':checked');
            var cust2Label = $('#cfgCust2Label').val() || 'Wash Care:';
            var cust2Val = $('#cfgCust2Val').val() || 'Dry Clean Only';
            $('#prevCust2Row').toggle(showCust2).html(cust2Label + ': <strong>' + cust2Val + '</strong>');

            var showCust3 = $('#cfgShowCust3').is(':checked');
            var cust3Label = $('#cfgCust3Label').val() || 'Origin:';
            var cust3Val = $('#cfgCust3Val').val() || 'Made in India';
            $('#prevCust3Row').toggle(showCust3).html(cust3Label + ': <strong>' + cust3Val + '</strong>');

            // Dynamic Custom Fields
            var dynHtml = '';
            var dynList = [];
            $('.dynamic-field-row').each(function() {
                var enabled = $(this).find('.dyn-field-enable').is(':checked');
                var label = $(this).find('.dyn-field-label').val().trim();
                var val = $(this).find('.dyn-field-value').val().trim();
                var id = $(this).data('id');

                if (label || val) {
                    dynList.push({ id: id, label: label, value: val, enabled: enabled });
                    if (enabled) {
                        dynHtml += '<div class="text-muted">' + label + ': <strong>' + val + '</strong></div>';
                    }
                }
            });

            $('#prevDynamicRowsContainer').html(dynHtml);
            $('#dynamicFieldsJsonInput').val(JSON.stringify(dynList));

            var hasAnyExtra = showPrice || showMfg || showCat || showHsn || showCust1 || showCust2 || showCust3 || (dynHtml.length > 0);
            $('#prevExtraDetails').toggle(hasAnyExtra);

            // Footer note
            var showFooter = $('#cfgShowFooter').is(':checked');
            var footerText = $('#cfgFooterText').val() || '(Incl. of all taxes)';
            $('#prevFooterRow').toggle(showFooter).text(footerText);
        }

        $(document).ready(function() {
            // Live binding
            $(document).on('input change', '.live-cfg-input, .live-cfg-check', function() {
                updateLivePreview();
            });

            // Add dynamic field
            $('#btnAddNewField').on('click', function() {
                var newId = 'df_' + Date.now();
                var row = `
                    <div class="dynamic-field-row d-flex align-items-center gap-2 p-2 bg-light border rounded" data-id="${newId}">
                        <div class="form-check mb-0">
                            <input type="checkbox" class="form-check-input dyn-field-enable live-cfg-check" checked />
                        </div>
                        <input type="text" class="form-control form-control-sm dyn-field-label live-cfg-input" placeholder="Field Label (e.g. Net Qty)" value="" style="max-width:140px;" />
                        <input type="text" class="form-control form-control-sm dyn-field-value live-cfg-input flex-grow-1" placeholder="Field Value (e.g. 1 N)" value="" />
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-dyn-field py-1 px-2" title="Remove field">🗑️</button>
                    </div>
                `;
                $('#dynamicFieldsContainer').append(row);
                $('#noDynamicFieldsMsg').addClass('d-none');
                updateLivePreview();
            });

            // Remove dynamic field
            $(document).on('click', '.btn-remove-dyn-field', function() {
                $(this).closest('.dynamic-field-row').remove();
                if ($('.dynamic-field-row').length === 0) {
                    $('#noDynamicFieldsMsg').removeClass('d-none');
                }
                updateLivePreview();
            });

            // Initial render
            updateLivePreview();
        });
    </script>
}
