@model AashanaFashion.Models.ProductionOrder
@{
    ViewData["Title"] = $"Master Lot Tag — {Model.LotNo}";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .no-print-bar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .tag-container {
            padding: 30px;
            display: flex;
            justify-content: center;
        }

        /* 4x6 inch Master Lot Card */
        .master-card {
            width: 100mm;
            min-height: 148mm;
            background: #ffffff;
            border: 2px solid #000000;
            padding: 6mm;
            box-sizing: border-box;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-header-brand {
            text-align: center;
            border-bottom: 2px solid #000000;
            padding-bottom: 3mm;
            margin-bottom: 4mm;
        }

        @@media print {
            body { background: transparent; }
            .no-print-bar { display: none !important; }
            .tag-container { padding: 0 !important; }
            .master-card {
                box-shadow: none !important;
                border: 2px solid #000000 !important;
                page-break-inside: avoid;
            }
            @@page { margin: 5mm; }
        }
    </style>
</head>
<body>

    <div class="no-print-bar">
        <div class="d-flex align-items-center gap-3">
            <a href="/Production/Edit/@Model.Id" class="btn btn-sm btn-outline-secondary">← Back to Order</a>
            <h5 class="mb-0 fw-bold">Master Lot Tag — @Model.LotNo</h5>
        </div>
        <button type="button" class="btn btn-primary fw-bold px-3" onclick="window.print()">
            🖨️ Print Lot Tag
        </button>
    </div>

    <div class="tag-container">
        <div class="master-card">
            <div>
                <div class="card-header-brand">
                    <h4 class="fw-bold mb-0 text-uppercase tracking-wider">AASHANA FASHION</h4>
                    <span class="small text-muted text-uppercase fw-semibold">Master Production Lot Tag</span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <small class="text-muted d-block">LOT NUMBER</small>
                        <span class="fs-4 fw-bold">@Model.LotNo</span>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted d-block">TOTAL QUANTITY</small>
                        <span class="fs-4 fw-bold text-primary">@Model.TotalQuantity <span class="fs-6 text-muted">pcs</span></span>
                    </div>

                    <div class="col-6 mt-2">
                        <small class="text-muted d-block">DESIGN NUMBER</small>
                        <span class="fs-5 fw-bold">@(Model.Design?.DesignNumber ?? "—")</span>
                    </div>
                    <div class="col-6 mt-2 text-end">
                        <small class="text-muted d-block">DATE CREATED</small>
                        <span class="fw-semibold">@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>

                <!-- Size & Colour Matrix Table -->
                <div class="border rounded mb-3">
                    <table class="table table-bordered table-sm mb-0 text-center" style="font-size: 8.5pt;">
                        <thead class="table-dark">
                            <tr>
                                <th>Colour</th>
                                <th>Size</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Details)
                            {
                                <tr>
                                    <td class="fw-semibold">@d.Colour</td>
                                    <td class="fw-bold">@d.Size</td>
                                    <td class="fw-bold">@d.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Master Barcodes -->
            <div class="border-top pt-3">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div style="flex-grow: 1;">
                        @Html.Raw(ViewBag.BarcodeSvg)
                    </div>
                    <div style="width: 28mm; height: 28mm; flex-shrink: 0;">
                        @Html.Raw(ViewBag.QrCodeSvg)
                    </div>
                </div>
                <div class="text-center mt-2 small text-muted">
                    Scan with handheld gun or camera to track whole lot
                </div>
            </div>
        </div>
    </div>

</body>
</html>
