@model IEnumerable<AashanaFashion.Models.PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders";
    var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin = role == "Admin" || role == "SuperAdmin";
    bool canCreate = isAdmin || User.HasClaim("Permission.Purchase.CanCreate", "true");
    bool canEdit   = isAdmin || User.HasClaim("Permission.Purchase.CanEdit", "true");
    bool canDelete = isAdmin || User.HasClaim("Permission.Purchase.CanDelete", "true");
}

<div class="page-header">
    <div>
        <h1 class="page-title">Purchase Orders</h1>
        <p class="page-sub">Manage all purchase orders</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn-af btn-af-primary">+ New Purchase Order</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><span class="alert-body">@TempData["Success"]</span><button class="alert-close">&times;</button></div>
}

<div class="data-card">
    <table class="af-table">
        <thead>
            <tr>
                <th>PO No</th>
                <th>Vendor</th>
                <th>Agent</th>
                <th>Invoice No</th>
                <th>Order Date</th>
                <th>Expected Receiving</th>
                <th>Items</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var isOverdue = item.ExpectedReceivingDate.HasValue
                    && item.Status != PurchaseOrderStatus.Received
                    && item.Status != PurchaseOrderStatus.Cancelled
                    && (DateTime.Now.Date - item.ExpectedReceivingDate.Value.Date).Days > 0;
                <tr>
                    <td><strong>@item.PoNumber</strong></td>
                    <td>@item.Vendor?.VendorName</td>
                    <td>@item.AgentName</td>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.OrderDate.ToString("dd-MMM-yyyy")</td>
                    <td style="@(isOverdue ? "color:#dc2626;font-weight:700;" : "")">
                        @if (item.ExpectedReceivingDate.HasValue)
                        {
                            @item.ExpectedReceivingDate.Value.ToString("dd-MMM-yyyy")
                            if (isOverdue)
                            {
                                var d = (DateTime.Now.Date - item.ExpectedReceivingDate.Value.Date).Days;
                                <span style="display:block;font-size:.75rem;">@d day@(d > 1 ? "s" : "") overdue</span>
                            }
                        }
                        else
                        {
                            <span style="color:#cbd5e1;">—</span>
                        }
                    </td>
                    <td class="text-center">@item.Details.Count</td>
                    <td>@item.TotalAmount.ToString("N2")</td>
                    <td>
                        <span class="af-badge @(item.Status switch {
                            PurchaseOrderStatus.Pending => "b-warn",
                            PurchaseOrderStatus.Approved => "b-blue",
                            PurchaseOrderStatus.PartiallyReceived => "b-purple",
                            PurchaseOrderStatus.Received => "b-green",
                            PurchaseOrderStatus.Cancelled => "b-gray",
                            _ => "b-gray"
                        })">@item.Status</span>
                    </td>
                    <td>
                        <div style="display:flex;gap:.4rem;flex-wrap:wrap;">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-af btn-af-ghost btn-af-sm">View</a>
                            @if (canEdit)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-af btn-af-ghost btn-af-sm">Edit</a>
                            }
                            @if (canDelete)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-af btn-af-danger btn-af-sm" onclick="return confirm('Delete this purchase order?')">Delete</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="text-center p-4 text-muted">No purchase orders found. <a asp-action="Create">Create the first one</a>.</div>
    }
</div>
