@model AashanaFashion.Models.PurchaseOrder
@{
    ViewData["Title"] = Model.PoNumber;
    var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin = role == "Admin" || role == "SuperAdmin";
    bool canEdit = isAdmin || User.HasClaim("Permission.Purchase.CanEdit", "true");
    var allowedStatuses = new[] { PurchaseOrderStatus.Pending, PurchaseOrderStatus.Approved, PurchaseOrderStatus.PartiallyReceived };
    bool canReceive = canEdit && allowedStatuses.Contains(Model.Status);
    int? delayDays = null;
    if (Model.ExpectedReceivingDate.HasValue && Model.Status != PurchaseOrderStatus.Received && Model.Status != PurchaseOrderStatus.Cancelled)
    {
        delayDays = (DateTime.Now.Date - Model.ExpectedReceivingDate.Value.Date).Days;
        if (delayDays < 0) delayDays = 0;
    }
    bool isPartiallyReceived = Model.Status == PurchaseOrderStatus.PartiallyReceived;
    var statusBadge = Model.Status switch
    {
        PurchaseOrderStatus.Pending => "b-yellow",
        PurchaseOrderStatus.Approved => "b-blue",
        PurchaseOrderStatus.PartiallyReceived => "b-purple",
        PurchaseOrderStatus.Received => "b-green",
        _ => "b-gray"
    };
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Purchase orders</a>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">@Model.PoNumber</h1>
            <span class="af-badge @statusBadge">@Model.Status.Humanize()</span>
        </div>
        <p class="page-sub">@Model.Vendor?.VendorName · Ordered @Model.OrderDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-actions">
        <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-secondary" target="_blank"><i class="bi bi-printer"></i> Print</a>
        @if (canEdit && Model.Status != PurchaseOrderStatus.Received)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
    </div>
</div>

@if (delayDays > 0)
{
    <div class="af-alert af-alert-danger">
        <div class="alert-body"><span class="alert-title">Overdue by @delayDays day@(delayDays > 1 ? "s" : "")</span>Expected on @Model.ExpectedReceivingDate?.ToString("dd MMM yyyy").</div>
    </div>
}
else if (Model.Status == PurchaseOrderStatus.Received)
{
    <div class="af-alert af-alert-success">
        <div class="alert-body">This purchase order has been received and is closed. No further changes can be made.</div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="data-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Order info</div>
            </div>
            <div class="data-card-body">
                <div class="kv-row"><span class="k">Vendor</span><span class="v">@Model.Vendor?.VendorName</span></div>
                <div class="kv-row"><span class="k">GSTIN</span><span class="v font-monospace">@(Model.Vendor?.GstNumber ?? "—")</span></div>
                <div class="kv-row"><span class="k">Agent</span><span class="v">@(string.IsNullOrEmpty(Model.AgentName) ? "—" : Model.AgentName)</span></div>
                <div class="kv-row"><span class="k">Transporter</span><span class="v">@(string.IsNullOrEmpty(Model.CourierServiceName) ? "—" : Model.CourierServiceName)</span></div>
                @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
                {
                    <div class="kv-row"><span class="k">Vendor invoice</span><span class="v font-monospace">@Model.InvoiceNumber</span></div>
                }
                @if (Model.Bills?.Any() == true)
                {
                    <div class="kv-row">
                        <span class="k">Bill no(s).</span>
                        <span class="v d-flex flex-wrap gap-1 justify-content-end">
                            @foreach (var bill in Model.Bills.OrderBy(b => b.CreatedDate))
                            {
                                <span class="af-badge b-purple">@bill.BillNumber</span>
                            }
                        </span>
                    </div>
                }
                <div class="kv-row"><span class="k">Order date</span><span class="v">@Model.OrderDate.ToString("dd MMM yyyy")</span></div>
                <div class="kv-row">
                    <span class="k">Expected receiving</span>
                    <span class="v @(delayDays > 0 ? "text-danger" : "")">
                        @(Model.ExpectedReceivingDate?.ToString("dd MMM yyyy") ?? "—")
                        @if (delayDays > 0)
                        {
                            <span class="d-block text-xs">@delayDays day@(delayDays > 1 ? "s" : "") overdue</span>
                        }
                    </span>
                </div>
                @if (Model.ReceivedOnDate.HasValue)
                {
                    <div class="kv-row"><span class="k">Received on</span><span class="v text-success">@Model.ReceivedOnDate.Value.ToString("dd MMM yyyy")</span></div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="kv-row"><span class="k">Notes</span><span class="v text-end">@Model.Notes</span></div>
                }
            </div>
        </div>

        @if (canReceive)
        {
            <div class="data-card">
                <div class="data-card-header">
                    <div>
                        <div class="data-card-title">Update status</div>
                        <div class="data-card-sub">Record receipts against this order.</div>
                    </div>
                </div>
                <div class="data-card-body">
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <label class="form-label" for="statusSelect">Status</label>
                        <div class="d-flex gap-2 mb-3">
                            <select name="status" class="af-input af-select flex-grow-1" id="statusSelect">
                                @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
                                {
                                    <option value="@s" selected="@(s == Model.Status)">@s.Humanize()</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6" id="dateSection" style="display:none;">
                                <label class="form-label" for="receivedOnDate">Received date</label>
                                <input id="receivedOnDate" name="receivedOnDate" type="date" class="af-input" value="@(Model.ReceivedOnDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-6" id="billSection" style="display:none;">
                                <label class="form-label" for="billNumberInput">Bill no. <span class="req">*</span></label>
                                <input name="billNumber" id="billNumberInput" type="text" class="af-input" placeholder="Bill number" />
                            </div>
                        </div>

                        <div id="receiveSection" style="display:@(isPartiallyReceived ? "block" : "none");">
                            <div class="section-label mb-2">Received quantities</div>
                            <div class="grid-card">
                                <table class="af-table table-edit">
                                    <thead>
                                        <tr>
                                            <th style="width: 36px;">#</th>
                                            <th>Product</th>
                                            <th class="text-end">Ordered</th>
                                            <th style="width: 96px;">Received</th>
                                            <th class="text-end">Pending</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var di = 0;
                                            foreach (var d in Model.Details.OrderBy(x => x.SrNo))
                                            {
                                                var pending = d.Quantity - d.ReceivedQuantity;
                                                <tr>
                                                    <td class="text-muted tabular">@d.SrNo</td>
                                                    <td>@d.ProductName</td>
                                                    <td class="cell-num">@d.Quantity</td>
                                                    <td>
                                                        <input name="details[@di].Id" type="hidden" value="@d.Id" />
                                                        <input name="details[@di].ReceivedQuantity" class="af-input af-input-sm text-end" type="number" min="0" max="@d.Quantity" value="@d.ReceivedQuantity" aria-label="Received quantity for @d.ProductName" />
                                                    </td>
                                                    <td class="cell-num fw-semibold @(pending > 0 ? "text-warning" : "text-success")">@pending</td>
                                                </tr>
                                                di++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text">Set the received quantity for each item, then choose Partially received or Received above.</div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-7">
        <div class="table-card mb-4">
            <div class="data-card-header">
                <div class="data-card-title">Line items</div>
                <span class="text-xs text-muted">@Model.Details.Count @(Model.Details.Count == 1 ? "line" : "lines")</span>
            </div>
            <div class="table-scroll">
                <table class="af-table" style="min-width: 900px;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Design no.</th>
                            <th>HSN</th>
                            <th>Unit</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Received</th>
                            <th class="text-end">Pending</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Disc</th>
                            <th class="text-end">GST</th>
                            <th class="text-end">Gross</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Details.OrderBy(d => d.SrNo))
                        {
                            var pending = d.Quantity - d.ReceivedQuantity;
                            <tr>
                                <td class="text-muted tabular">@d.SrNo</td>
                                <td><span class="cell-title">@d.ProductName</span></td>
                                <td>@(string.IsNullOrEmpty(d.ProductDesignNo) ? "—" : d.ProductDesignNo)</td>
                                <td class="font-monospace text-xs">@(string.IsNullOrEmpty(d.HsnCode) ? "—" : d.HsnCode)</td>
                                <td>@d.Unit</td>
                                <td class="cell-num">@d.Quantity</td>
                                <td class="cell-num text-success">@d.ReceivedQuantity</td>
                                <td class="cell-num fw-semibold @(pending > 0 ? "text-warning" : "text-success")">@pending</td>
                                <td class="cell-num">@d.UnitPrice.ToString("N2")</td>
                                <td class="cell-num">@d.TotalPrice.ToString("N2")</td>
                                <td class="cell-num">@(d.DiscountPercentage > 0 ? d.DiscountPercentage.ToString("N2") + "%" : "—")</td>
                                <td class="cell-num">@(d.GstPercentage > 0 ? d.GstPercentage.ToString("N2") + "%" : "—")</td>
                                <td class="cell-num text-foreground fw-semibold">@d.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">Amount summary</div>
            </div>
            <div class="data-card-body">
                <div class="kv-row"><span class="k">Subtotal (gross of all items)</span><span class="v">₹@Model.Details.Sum(d => d.NetAmount).ToString("N2")</span></div>
                <div class="kv-row"><span class="k">Transport charge</span><span class="v">₹@Model.TransportCharge.ToString("N2")</span></div>
                @if (Model.TransportChargeGST > 0)
                {
                    <div class="kv-row"><span class="k">Transport GST (@Model.TransportChargeGST.ToString("N2")%)</span><span class="v">₹@((Model.TransportCharge * Model.TransportChargeGST / 100m).ToString("N2"))</span></div>
                }
                <div class="kv-row"><span class="k">Round off</span><span class="v">₹@Model.RoundOff.ToString("N2")</span></div>
                <div class="bill-total"><span class="k">Net amount</span><span class="v">₹@Model.TotalAmount.ToString("N2")</span></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var sel = document.getElementById('statusSelect');
            var sec = document.getElementById('receiveSection');
            var dsec = document.getElementById('dateSection');
            var billSec = document.getElementById('billSection');
            var billInput = document.getElementById('billNumberInput');
            if (sel) {
                function toggle() {
                    var showReceive = sel.value === 'PartiallyReceived' || sel.value === 'Received';
                    if (sec) sec.style.display = showReceive ? 'block' : 'none';
                    if (dsec) dsec.style.display = showReceive ? 'block' : 'none';
                    if (billSec) billSec.style.display = showReceive ? 'block' : 'none';
                    if (billInput) {
                        billInput.required = showReceive;
                    }
                }
                sel.addEventListener('change', toggle);
                toggle();
            }
        })();
    </script>
}
