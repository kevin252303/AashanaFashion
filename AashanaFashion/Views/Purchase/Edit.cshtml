@model AashanaFashion.Models.PurchaseOrderViewModel
@{
    ViewData["Title"] = "Edit Purchase Order";
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new();
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="page-back"><i class="bi bi-arrow-left"></i> @Model.PoNumber</a>
        <h1 class="page-title">Edit purchase order</h1>
        <p class="page-sub">Update vendor, items and charges for <span class="font-monospace">@Model.PoNumber</span>.</p>
    </div>
</div>

<form asp-action="Edit" method="post" id="poForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PoNumber" />

    <div asp-validation-summary="All" class="af-alert af-alert-danger"></div>

    <div class="data-card">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Order details</div>
                <div class="data-card-sub">Vendor, dates, line items and charges.</div>
            </div>
            <div class="text-end">
                <span class="micro-label">Net amount</span>
                <span class="fw-semibold text-foreground tabular" id="grandTotal">₹@Model.TotalAmount.ToString("N2")</span>
            </div>
        </div>
        <div class="data-card-body">

            <div class="row">
                <div class="col-md-3">
                    <div class="af-form-group">
                        <label class="form-label">PO number</label>
                        <input class="af-input font-monospace fw-semibold" value="@Model.PoNumber" readonly />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="af-form-group">
                        <label asp-for="OrderDate" class="form-label">Order date</label>
                        <input asp-for="OrderDate" class="af-input" type="date" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="af-form-group">
                        <label asp-for="ExpectedReceivingDate" class="form-label">Expected receiving</label>
                        <input asp-for="ExpectedReceivingDate" class="af-input" type="date" id="expectedReceivingDate" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="af-form-group">
                        <label class="form-label">&nbsp;</label>
                        <div id="delayWarning" class="af-badge b-red" style="display:none;"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="af-form-group">
                        <label asp-for="VendorId" class="form-label">Vendor <span class="req">*</span></label>
                        <select asp-for="VendorId" id="VendorId" class="af-input af-select" required>
                            <option value="">Select vendor</option>
                            @foreach (var v in vendors)
                            {
                                <option value="@v.Id" selected="@(v.Id == Model.VendorId)">@v.VendorName — @v.GstNumber</option>
                            }
                        </select>
                        <span asp-validation-for="VendorId" class="af-error"></span>
                    </div>
                </div>
                <div class="col-md-6" id="vendorDetailsCol" style="display:none;">
                    <div class="af-form-group">
                        <label class="form-label">Vendor details</label>
                        <div class="panel-inset mb-0">
                            <div class="row g-2 text-sm">
                                <div class="col-6"><span class="text-muted">GSTIN</span> <span id="vendorGST" class="font-monospace text-foreground">—</span></div>
                                <div class="col-6"><span class="text-muted">Phone</span> <span id="vendorPhone" class="text-foreground">—</span></div>
                                <div class="col-6"><span class="text-muted">Email</span> <span id="vendorEmail" class="text-foreground">—</span></div>
                                <div class="col-6"><span class="text-muted">Address</span> <span id="vendorAddress" class="text-foreground">—</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="af-form-group">
                        <label asp-for="AgentName" class="form-label">Agent name</label>
                        <input asp-for="AgentName" class="af-input" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="af-form-group">
                        <label asp-for="CourierServiceName" class="form-label">Transporter</label>
                        <input asp-for="CourierServiceName" class="af-input" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="af-form-group">
                        <label asp-for="InvoiceNumber" class="form-label">Vendor invoice no.</label>
                        <input asp-for="InvoiceNumber" class="af-input" placeholder="Invoice number" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="af-form-group">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <input asp-for="Notes" class="af-input" />
                    </div>
                </div>
            </div>

            <div class="section-label mt-2 mb-3">Line items</div>

            <datalist id="rawMaterialsList">
                @if (ViewBag.RawMaterials != null)
                {
                    foreach (var rm in (List<RawMaterial>)ViewBag.RawMaterials)
                    {
                        <option value="@rm.Name" data-id="@rm.Id" data-unit="@rm.Unit" data-rate="@rm.Rate">Stock: @rm.CurrentStock @rm.Unit | Rate: ₹@rm.Rate</option>
                    }
                }
            </datalist>

            <div class="grid-card">
                <table class="af-table table-edit" id="itemsTable" style="min-width:1100px;">
                    <thead>
                        <tr>
                            <th style="width:44px;" class="text-center">#</th>
                            <th style="min-width:180px;">Product <span class="req">*</span></th>
                            <th style="width:110px;">Design no.</th>
                            <th style="width:100px;">HSN</th>
                            <th style="width:100px;">Unit</th>
                            <th style="width:90px;">Qty</th>
                            <th style="width:120px;">Rate</th>
                            <th style="width:100px;">Disc %</th>
                            <th style="width:100px;">GST %</th>
                            <th style="width:110px;" class="text-end">Gross</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @if (Model.Details.Any())
                        {
                            var i = 0;
                            foreach (var d in Model.Details)
                            {
                                <tr class="item-row">
                                    <td class="text-center sr-no">@d.SrNo</td>
                                    <td>
                                        <input name="Details[@i].ProductName" class="af-input af-input-sm item-product" list="rawMaterialsList" value="@d.ProductName" required autocomplete="off" />
                                        <input type="hidden" name="Details[@i].RawMaterialId" class="item-rawmaterial-id" value="@d.RawMaterialId" />
                                        <input type="hidden" name="Details[@i].Id" value="@d.Id" />
                                        <input type="hidden" name="Details[@i].SrNo" value="@d.SrNo" />
                                    </td>
                                    <td><input name="Details[@i].ProductDesignNo" class="af-input af-input-sm" value="@d.ProductDesignNo" /></td>
                                    <td><input name="Details[@i].HsnCode" class="af-input af-input-sm" value="@d.HsnCode" /></td>
                                    <td>
                                        <select name="Details[@i].Unit" class="af-input af-input-sm af-select unit-select">
                                            <option value="Piece" selected="@(d.Unit == "Piece" ? "selected" : null)">Piece</option>
                                            <option value="Meter" selected="@(d.Unit == "Meter" ? "selected" : null)">Meter</option>
                                        </select>
                                    </td>
                                    <td><input name="Details[@i].Quantity" class="af-input af-input-sm item-qty" type="number" min="1" value="@d.Quantity" required /></td>
                                    <td><input name="Details[@i].UnitPrice" class="af-input af-input-sm item-rate" type="number" step="0.01" min="0" value="@d.UnitPrice" required /></td>
                                    <td><input name="Details[@i].DiscountPercentage" class="af-input af-input-sm item-disc" type="number" step="0.01" min="0" max="100" value="@d.DiscountPercentage" /></td>
                                    <td><input name="Details[@i].GstPercentage" class="af-input af-input-sm item-gst" type="number" step="0.01" min="0" max="100" value="@d.GstPercentage" /></td>
                                    <td class="cell-num text-foreground fw-semibold"><span class="item-net">₹@d.NetAmount.ToString("N2")</span></td>
                                    <td><button type="button" class="row-action danger remove-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button></td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr class="item-row">
                                <td class="text-center sr-no">1</td>
                                <td><input name="Details[0].ProductName" class="af-input af-input-sm" placeholder="Product" required /></td>
                                <td><input name="Details[0].ProductDesignNo" class="af-input af-input-sm" placeholder="Design #" /></td>
                                <td><input name="Details[0].HsnCode" class="af-input af-input-sm" placeholder="HSN" /></td>
                                <td>
                                    <select name="Details[0].Unit" class="af-input af-input-sm af-select unit-select">
                                        <option value="Piece">Piece</option>
                                        <option value="Meter">Meter</option>
                                    </select>
                                </td>
                                <td><input name="Details[0].Quantity" class="af-input af-input-sm item-qty" type="number" min="1" value="1" required /></td>
                                <td><input name="Details[0].UnitPrice" class="af-input af-input-sm item-rate" type="number" step="0.01" min="0" value="0" required /></td>
                                <td><input name="Details[0].DiscountPercentage" class="af-input af-input-sm item-disc" type="number" step="0.01" min="0" max="100" value="0" /></td>
                                <td><input name="Details[0].GstPercentage" class="af-input af-input-sm item-gst" type="number" step="0.01" min="0" max="100" value="0" /></td>
                                <td class="cell-num text-foreground fw-semibold"><span class="item-net">₹0.00</span></td>
                                <td><button type="button" class="row-action danger remove-row" title="Remove" aria-label="Remove" style="display:none;"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="button" id="addRow" class="btn btn-sm btn-secondary mt-3"><i class="bi bi-plus-lg"></i> Add item</button>
            <input type="hidden" id="detailCount" name="DetailCount" value="@(Model.Details.Count > 0 ? Model.Details.Count : 1)" />

            <div class="section-label mt-4 mb-3">Charges</div>

            <div class="row">
                <div class="col-md-2">
                    <div class="af-form-group">
                        <label asp-for="TransportCharge" class="form-label">Transport charge (₹)</label>
                        <input asp-for="TransportCharge" class="af-input" type="number" step="0.01" min="0" id="transportCharge" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="af-form-group">
                        <label asp-for="TransportChargeGST" class="form-label">Transport GST %</label>
                        <input asp-for="TransportChargeGST" class="af-input" type="number" step="0.01" min="0" id="transportChargeGST" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="af-form-group">
                        <label asp-for="RoundOff" class="form-label">Round off (₹)</label>
                        <input asp-for="RoundOff" class="af-input" type="number" step="0.01" id="roundOff" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="af-form-group">
                        <label class="form-label">Effective transport</label>
                        <div id="effectiveTransportDisplay" class="af-input bg-raised fw-semibold tabular d-flex align-items-center" aria-live="polite">₹0.00</div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Update purchase order</button>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/purchase.js"></script>
}
