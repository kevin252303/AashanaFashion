@{
    ViewData["Title"] = "Import Device Logs";
    bool isSuccess = ViewBag.Success == true;
    int imported = ViewBag.ImportedCount ?? 0;
    int skipped = ViewBag.SkippedCount ?? 0;
    var errors = ViewBag.Errors as List<string> ?? new List<string>();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Biometric terminals</a>
        <h1 class="page-title">Import device logs</h1>
        <p class="page-sub">Upload punch log files (.csv, .dat, .txt) downloaded from face terminals via USB or web GUI.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="ImportLogs" method="post" enctype="multipart/form-data" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Upload attendance log</div>
                    <div class="data-card-sub">Standard CSV exports or raw eSSL / ZKTeco USB DAT files.</div>
                </div>
            </div>
            <div class="data-card-body">
                <div class="mb-4">
                    <label class="form-label" for="logFile">Log file <span class="req">*</span></label>
                    <input type="file" id="logFile" name="logFile" class="af-input" accept=".csv,.txt,.dat" required />
                </div>

                <div class="panel-inset">
                    <span class="micro-label mb-2">Supported formats</span>
                    <div class="text-sm fw-medium text-foreground">Standard CSV</div>
                    <pre class="code-sample mb-3">EmployeeCode,PunchTime
EMP-001,2026-09-23 09:14:20
EMP-002,2026-09-23 09:35:10</pre>
                    <div class="text-sm fw-medium text-foreground">eSSL / ZKTeco tab-separated DAT / TXT</div>
                    <pre class="code-sample">1	2026-09-23 09:14:20	1	15
2	2026-09-23 09:35:10	1	15</pre>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Parse &amp; import punches</button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        @if (isSuccess)
        {
            <div class="data-card mb-4">
                <div class="data-card-header">
                    <div class="data-card-title"><i class="bi bi-check-circle-fill text-success me-1"></i> Import summary</div>
                </div>
                <div class="data-card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="metric-card mb-0">
                                <div class="metric-label">Punches imported</div>
                                <div class="metric-value text-success">@imported</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="metric-card mb-0">
                                <div class="metric-label">Duplicates / skipped</div>
                                <div class="metric-value">@skipped</div>
                            </div>
                        </div>
                    </div>

                    @if (errors.Any())
                    {
                        <div class="af-alert af-alert-warning">
                            <div class="alert-body">
                                <span class="alert-title">@errors.Count @(errors.Count == 1 ? "line needs" : "lines need") attention</span>
                                <ul class="mb-0 ps-3">
                                    @foreach (var err in errors)
                                    {
                                        <li>@err</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-secondary w-100">Open daily register <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        }

        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">Downloading logs from the terminal</div>
            </div>
            <div class="data-card-body">
                <ol class="step-list">
                    <li>Insert a formatted USB drive into the face scanner’s USB port.</li>
                    <li>Open the admin menu → <strong>USB Manager</strong> or <strong>Data Management</strong>.</li>
                    <li>Choose <strong>Download Attendance Data (Att-Log)</strong>.</li>
                    <li>The device saves an <code>attlog.dat</code> or <code>*.txt</code> / <code>*.csv</code> file to the drive.</li>
                    <li>Plug the drive into your computer and upload the file here.</li>
                </ol>
            </div>
        </div>
    </div>
</div>
