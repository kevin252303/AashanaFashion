@{
    ViewData["Title"] = "Import Biometric Device Logs";
    bool isSuccess = ViewBag.Success == true;
    int imported = ViewBag.ImportedCount ?? 0;
    int skipped = ViewBag.SkippedCount ?? 0;
    var errors = ViewBag.Errors as List<string> ?? new List<string>();
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-action="Index">Biometric Devices</a></li>
            <li class="breadcrumb-item active">Import Device Logs</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0 fw-bold">📁 Import Device Attendance Logs</h2>
            <p class="text-muted mb-0">Upload punch log files (.csv, .dat, .txt) downloaded from face terminals via USB or Web GUI.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Devices
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show af-alert mb-4" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show af-alert mb-4" role="alert">
        <span>⚠️ @TempData["Error"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}

<div class="row g-4">
    <!-- Upload Form -->
    <div class="col-lg-6">
        <form asp-action="ImportLogs" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm rounded-3 h-100">
            @Html.AntiForgeryToken()
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">Upload Attendance Log File</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    <label class="form-label fw-semibold">Select Log File (.csv, .dat, .txt)</label>
                    <input type="file" name="logFile" class="form-control form-control-lg" accept=".csv,.txt,.dat" required />
                    <small class="text-muted mt-1 d-block">Supports standard CSV exports or raw eSSL / ZKTeco USB DAT files.</small>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4">
                    <h6 class="fw-bold small text-muted text-uppercase mb-2">Supported File Formats</h6>
                    <div class="small mb-2">
                        <strong>Standard CSV:</strong>
                        <div class="font-monospace bg-white p-2 border rounded mt-1">
                            EmployeeCode,PunchTime<br />
                            EMP-001,2026-09-23 09:14:20<br />
                            EMP-002,2026-09-23 09:35:10
                        </div>
                    </div>
                    <div class="small">
                        <strong>eSSL / ZKTeco Tab-Separated USB DAT / TXT:</strong>
                        <div class="font-monospace bg-white p-2 border rounded mt-1">
                            1&emsp;2026-09-23 09:14:20&emsp;1&emsp;15<br />
                            2&emsp;2026-09-23 09:35:10&emsp;1&emsp;15
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    🚀 Parse & Import Punches
                </button>
            </div>
        </form>
    </div>

    <!-- Results & Instructions -->
    <div class="col-lg-6">
        @if (isSuccess)
        {
            <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-success border-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-success">🎉 Import Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center g-3 mb-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small">Punches Imported</span>
                                <h3 class="fw-bold my-1 text-success">@imported</h3>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small">Duplicates / Skipped</span>
                                <h3 class="fw-bold my-1 text-secondary">@skipped</h3>
                            </div>
                        </div>
                    </div>

                    @if (errors.Any())
                    {
                        <div class="alert alert-warning small mb-0">
                            <strong>Notice:</strong>
                            <ul class="mb-0 ps-3">
                                @foreach (var err in errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mt-3 text-center">
                        <a asp-controller="Attendance" asp-action="Index" class="btn btn-success">
                            View in Daily Attendance Register &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">💡 How to Download Logs from Hardware</h5>
            </div>
            <div class="card-body">
                <ol class="text-muted small ps-3 mb-0" style="line-height: 1.8;">
                    <li>Insert any formatted USB pendrive into the USB port of your face scanner device.</li>
                    <li>Enter the administrator menu &rarr; Navigate to <strong>USB Manager</strong> or <strong>Data Management</strong>.</li>
                    <li>Select <strong>Download Attendance Data (Att-Log)</strong>.</li>
                    <li>The device will save an <code>attlog.dat</code> or <code>*.txt</code> / <code>*.csv</code> file on the USB stick.</li>
                    <li>Plug the USB drive into your computer and select the file above to sync all shift attendance instantly!</li>
                </ol>
            </div>
        </div>
    </div>
</div>
