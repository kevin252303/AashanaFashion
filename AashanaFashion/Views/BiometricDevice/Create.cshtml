@model AashanaFashion.Models.BiometricDevice
@{
    ViewData["Title"] = "Register Terminal";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Biometric terminals</a>
        <h1 class="page-title">Register terminal</h1>
        <p class="page-sub">Add a face-recognition scanner or fingerprint punch machine.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Create" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Device identification</div>
                    <div class="data-card-sub">Name, serial and network setup.</div>
                </div>
            </div>
            <div class="data-card-body">
                <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DeviceName" class="form-label">Terminal name <span class="req">*</span></label>
                        <input asp-for="DeviceName" class="af-input" placeholder="e.g. Main Gate Face Scanner" required />
                        <span asp-validation-for="DeviceName" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeviceIdentifier" class="form-label">Serial number / machine ID <span class="req">*</span></label>
                        <input asp-for="DeviceIdentifier" class="af-input font-monospace" placeholder="e.g. SN12345678 or DEV-01" required />
                        <div class="form-text">On the device sticker or under menu → Sys Info.</div>
                        <span asp-validation-for="DeviceIdentifier" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeviceModel" class="form-label">Brand / model</label>
                        <input asp-for="DeviceModel" class="af-input" placeholder="e.g. eSSL SilkBio-101 / Hikvision MinMoe" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Installation location</label>
                        <input asp-for="Location" class="af-input" placeholder="e.g. Factory main entrance" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IpAddress" class="form-label">LAN IP address <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="IpAddress" class="af-input font-monospace" placeholder="e.g. 192.168.1.201" />
                    </div>
                        <div class="col-md-6">
                            <label asp-for="ApiKey" class="form-label">API secret token</label>
                            <input asp-for="ApiKey" class="af-input font-monospace" readonly />
                            <div class="form-text">Auto-generated authentication token for webhooks.</div>
                        </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                            <label class="form-check-label" for="isActiveSwitch">Accept punches from this terminal</label>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Register terminal</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
