@model IEnumerable<AashanaFashion.Models.BiometricDevice>
@{
    ViewData["Title"] = "Biometric Terminals";
    string baseUrl = ViewBag.BaseUrl ?? "";
    bool activeOnly = ViewBag.ActiveOnly == true;
    bool filtered = !string.IsNullOrEmpty(ViewBag.Search as string) || activeOnly;
    int onlineCount = Model.Count(d => d.LastHeartbeat.HasValue && (DateTime.Now - d.LastHeartbeat.Value).TotalMinutes < 15);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Biometric Terminals</h1>
        <p class="page-sub">Connect face-recognition hardware via Cloud Push API, local LAN or USB log import.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#testPunchModal">
            <i class="bi bi-lightning-charge"></i> Test punch
        </button>
        <a asp-action="ImportLogs" class="btn btn-secondary"><i class="bi bi-upload"></i> Import logs</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Register terminal</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Registered terminals</div>
        <div class="metric-value">@Model.Count()</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Online now</div>
        <div class="metric-value">@onlineCount</div>
        <div class="metric-meta success">heartbeat in last 15 min</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Active</div>
        <div class="metric-value">@Model.Count(d => d.IsActive)</div>
        <div class="metric-meta">accepting punches</div>
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-header">
        <div>
            <div class="data-card-title">Cloud webhook push endpoint</div>
            <div class="data-card-sub">Point your terminal’s “Cloud Server” or “Webhook HTTP Push” setting at this URL.</div>
        </div>
        <a href="#setupInstructions" class="btn btn-sm btn-ghost">Setup guide <i class="bi bi-arrow-down"></i></a>
    </div>
    <div class="data-card-body">
        <div class="input-group">
            <span class="input-group-text font-monospace fw-semibold text-primary">POST</span>
            <input type="text" id="universalPushUrl" class="af-input font-monospace" readonly value="@baseUrl/api/biometric/push" aria-label="Push URL" />
            <button class="btn btn-secondary" type="button" id="btnCopyPushUrl"><i class="bi bi-clipboard"></i> Copy</button>
        </div>
        <div class="form-text">Compatible with eSSL / ZKTeco ADMS, Hikvision MinMoe, Realtime, Biomax and any HTTP-enabled device.</div>
    </div>
</div>

<div class="table-card mb-4">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search name, serial, IP, location…" value="@ViewBag.Search" />
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" name="activeOnly" value="true" id="activeOnly" @(activeOnly ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="activeOnly">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-fingerprint")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No terminals registered")</div>
            <p>@(filtered ? "No terminals match your filters." : "Register a biometric terminal to start receiving punches.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-secondary">Register terminal</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Terminal</th>
                        <th>Identifier / serial</th>
                        <th>Model</th>
                        <th>Location</th>
                        <th>Last heartbeat</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dev in Model)
                    {
                        var isOnline = dev.LastHeartbeat.HasValue && (DateTime.Now - dev.LastHeartbeat.Value).TotalMinutes < 15;
                        <tr>
                            <td>
                                <span class="cell-title">@dev.DeviceName</span>
                                <span class="cell-sub font-monospace">Key @(dev.ApiKey.Length > 8 ? dev.ApiKey.Substring(0, 8) + "…" : dev.ApiKey)</span>
                            </td>
                            <td>
                                <span class="mono-id">@dev.DeviceIdentifier</span>
                                @if (!string.IsNullOrEmpty(dev.IpAddress))
                                {
                                    <span class="cell-sub font-monospace">IP @dev.IpAddress</span>
                                }
                            </td>
                            <td>@(dev.DeviceModel ?? "Universal")</td>
                            <td class="text-muted">@(dev.Location ?? "Factory floor")</td>
                            <td class="text-nowrap">
                                @if (dev.LastHeartbeat.HasValue)
                                {
                                    <span class="text-foreground">@dev.LastHeartbeat.Value.ToString("dd MMM, hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Never connected</span>
                                }
                            </td>
                            <td>
                                @if (isOnline)
                                {
                                    <span class="af-badge b-green">Online</span>
                                }
                                else if (dev.IsActive)
                                {
                                    <span class="af-badge b-yellow">Standby</span>
                                }
                                else
                                {
                                    <span class="af-badge b-gray">Disabled</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Edit" asp-route-id="@dev.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@dev.Id" method="post" onsubmit="return confirm('Delete this device registration?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="row-action danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "terminal" : "terminals")</span>
        </div>
    }
</div>

<div class="data-card" id="setupInstructions">
    <div class="data-card-header">
        <div>
            <div class="data-card-title">Configure your face-scan machine</div>
            <div class="data-card-sub">Pick the option your hardware supports.</div>
        </div>
    </div>
    <div class="data-card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="panel h-100 mb-0">
                    <div class="panel-head">
                        <div>
                            <span class="af-badge b-indigo mb-2">Option A</span>
                            <h3 class="panel-title">eSSL / ZKTeco ADMS cloud</h3>
                        </div>
                    </div>
                    <ol class="step-list">
                        <li>Open device menu: <strong>Comm. → Cloud Server / ADMS</strong>.</li>
                        <li>Enable <strong>Cloud Server Setting</strong>.</li>
                        <li>Server address: <code>@(baseUrl.Replace("http://", "").Replace("https://", ""))</code></li>
                        <li>Server port: <code>@(Context.Request.Host.Port ?? (Context.Request.IsHttps ? 443 : 80))</code></li>
                        <li>Enable <strong>Push attendance logs</strong>.</li>
                    </ol>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel h-100 mb-0">
                    <div class="panel-head">
                        <div>
                            <span class="af-badge b-cyan mb-2">Option B</span>
                            <h3 class="panel-title">Universal webhook push</h3>
                        </div>
                    </div>
                    <ol class="step-list">
                        <li>Open the device web GUI or admin software.</li>
                        <li>Go to <strong>HTTP Push / Webhook</strong> settings.</li>
                        <li>Push URL: <code>@baseUrl/api/biometric/push</code></li>
                        <li>Device sends: <code>{ "employeeCode": "EMP-001", "punchTime": "2026-09-23 09:30:00" }</code></li>
                    </ol>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel h-100 mb-0">
                    <div class="panel-head">
                        <div>
                            <span class="af-badge b-gray mb-2">Option C</span>
                            <h3 class="panel-title">USB drive / file import</h3>
                        </div>
                    </div>
                    <ol class="step-list">
                        <li>Insert a USB drive into the face-scan device.</li>
                        <li>Menu → <strong>Download Att-Log</strong> (.csv / .dat / .txt).</li>
                        <li>Open <a asp-action="ImportLogs">Import device logs</a> and upload the file.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="testPunchModal" tabindex="-1" aria-labelledby="testPunchTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="testPunchTitle">Simulate a device punch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted text-sm">Check that attendance, hours and overtime calculate correctly when a punch arrives from a terminal.</p>
                <div class="mb-3">
                    <label class="form-label" for="simEmpCode">Employee code <span class="req">*</span></label>
                    <input type="text" id="simEmpCode" class="af-input font-monospace" placeholder="e.g. EMP-001 or 1" value="EMP-001" required />
                </div>
                <div>
                    <label class="form-label" for="simPunchType">Punch mode</label>
                    <select id="simPunchType" class="af-input af-select">
                        <option value="Auto">Auto (IN if first, OUT if second)</option>
                        <option value="CheckIn">Force punch IN</option>
                        <option value="CheckOut">Force punch OUT</option>
                    </select>
                </div>
                <div id="simResult" class="af-alert d-none mt-3 mb-0"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnSendSimPunch" class="btn btn-primary"><i class="bi bi-send"></i> Send punch</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#btnCopyPushUrl').on('click', function () {
            navigator.clipboard.writeText($('#universalPushUrl').val())
                .then(function () { window.afToast && afToast('Push URL copied to clipboard.', 'success'); });
        });

        $('#btnSendSimPunch').on('click', async function () {
            const empCode = $('#simEmpCode').val().trim();
            const punchType = $('#simPunchType').val();

            if (!empCode) {
                alert('Please enter an employee code.');
                return;
            }

            const btn = $(this);
            btn.prop('disabled', true).addClass('is-loading');

            try {
                const res = await $.post('@Url.Action("TestPunch", "BiometricDevice")', {
                    employeeCode: empCode,
                    punchType: punchType
                });

                $('#simResult')
                    .removeClass('d-none af-alert-danger')
                    .addClass('af-alert-success')
                    .html('<div class="alert-body"><span class="alert-title">Punch logged</span></div>')
                    .find('.alert-body').append(document.createTextNode(res.message || 'The punch was recorded.'));
            } catch (err) {
                const errMsg = err.responseJSON ? err.responseJSON.message : err.statusText;
                $('#simResult')
                    .removeClass('d-none af-alert-success')
                    .addClass('af-alert-danger')
                    .html('<div class="alert-body"><span class="alert-title">Punch failed</span></div>')
                    .find('.alert-body').append(document.createTextNode(errMsg || 'Request failed.'));
            } finally {
                btn.prop('disabled', false).removeClass('is-loading');
            }
        });
    </script>
}
