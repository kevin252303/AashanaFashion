@model AashanaFashion.Models.BiometricDevice
@{
    ViewData["Title"] = $"Edit Terminal — {Model.DeviceName}";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Biometric terminals</a>
        <h1 class="page-title">Edit terminal — @Model.DeviceName</h1>
        <p class="page-sub">Serial <span class="font-monospace">@Model.DeviceIdentifier</span></p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="data-card mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ApiKey" />
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Device details</div>
                    <div class="data-card-sub">Identification and network setup.</div>
                </div>
            </div>
            <div class="data-card-body">
                <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DeviceName" class="form-label">Terminal name <span class="req">*</span></label>
                        <input asp-for="DeviceName" class="af-input" required />
                        <span asp-validation-for="DeviceName" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeviceIdentifier" class="form-label">Serial number / machine ID <span class="req">*</span></label>
                        <input asp-for="DeviceIdentifier" class="af-input font-monospace" required />
                        <div class="form-text">On the device sticker or under menu → Sys Info.</div>
                        <span asp-validation-for="DeviceIdentifier" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DeviceModel" class="form-label">Brand / model</label>
                        <input asp-for="DeviceModel" class="af-input" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Installation location</label>
                        <input asp-for="Location" class="af-input" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IpAddress" class="form-label">LAN IP address <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="IpAddress" class="af-input font-monospace" />
                    </div>
                        <div class="col-md-6">
                            <label class="form-label" for="apiKeyView">API key</label>
                            <div class="input-with-action">
                                <input type="text" id="apiKeyView" value="@Model.ApiKey" class="af-input font-monospace" readonly />
                                <button type="button" class="input-action" title="Copy" aria-label="Copy API key" onclick="navigator.clipboard.writeText(document.getElementById('apiKeyView').value).then(function(){ window.afToast && afToast('API key copied.', 'success'); })"><i class="bi bi-clipboard"></i></button>
                            </div>
                        </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" />
                            <label class="form-check-label" for="isActiveSwitch">Accept punches from this terminal</label>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
                </div>
            </div>
        </form>

        <div class="data-card">
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Regenerate API key</div>
                    <div class="data-card-sub">If the token was compromised, issue a new one. You will need to update the device settings.</div>
                </div>
                <form asp-action="RegenerateApiKey" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Regenerate API key for this terminal?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-repeat"></i> Regenerate key</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
