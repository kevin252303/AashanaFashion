@model AashanaFashion.Models.DyingEntry
@{
    ViewData["Title"] = "Add Dying Entry";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Entries</a>
        <h1 class="page-title">Add Dying Entry</h1>
        <p class="page-sub">Record cloth sent for dying</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5 col-xl-4">
        <div class="data-card">
            <div class="data-card-header">
                <div class="data-card-title">Dying Entry</div>
            </div>
            <div class="data-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="af-alert af-alert-danger mb-3">
                            <div class="alert-body">
                                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                { <div>@e.ErrorMessage</div> }
                            </div>
                            <button class="alert-close">&times;</button>
                        </div>
                    }

                    <div class="af-form-group">
                        <label asp-for="LotNo" class="af-label">Lot No <span class="req">*</span></label>
                        <input asp-for="LotNo" class="af-input" placeholder="e.g. LOT-001" required />
                        <span asp-validation-for="LotNo" class="af-error"></span>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="EntryDate" class="af-label">Date <span class="req">*</span></label>
                        <input asp-for="EntryDate" class="af-input" type="date" required />
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Meters" class="af-label">Meters <span class="req">*</span></label>
                        <input asp-for="Meters" class="af-input" type="number" step="0.01" min="0.01" placeholder="0.00" required />
                        <span asp-validation-for="Meters" class="af-error"></span>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Remarks" class="af-label">Remarks</label>
                        <input asp-for="Remarks" class="af-input" placeholder="Optional notes" />
                    </div>

                    <div class="form-footer">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Entry</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
