@model AashanaFashion.Controllers.DyingIndexViewModel
@{
    ViewData["Title"] = "Dying Entry";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var month = ViewBag.Month;
    var year = ViewBag.Year;
    var prevMonth = month == 1 ? 12 : month - 1;
    var prevYear = month == 1 ? year - 1 : year;
    var nextMonth = month == 12 ? 1 : month + 1;
    var nextYear = month == 12 ? year + 1 : year;
    bool canManage = role == "Admin" || role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dying Entry</h1>
        <p class="page-sub">Track cloth sent for dying</p>
    </div>
    @if (canManage)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Entry</a>
        </div>
    }
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total meters</div>
        <div class="metric-value">@ViewBag.TotalMeters <span class="metric-suffix">m</span></div>
        <div class="metric-meta">@ViewBag.MonthName</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total entries</div>
        <div class="metric-value">@Model.Entries.Count</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Lots</div>
        <div class="metric-value">@Model.Summary.Count</div>
    </div>
</div>

<div class="table-card mb-4">
    <form method="get" asp-action="Index" class="table-toolbar">
        <input type="hidden" name="month" value="@ViewBag.Month" />
        <input type="hidden" name="year" value="@ViewBag.Year" />
        <div class="toolbar-filters">
            <div class="period-nav">
                <a asp-action="Index" asp-route-month="@prevMonth" asp-route-year="@prevYear" class="btn btn-ghost btn-icon btn-sm" title="Previous month" aria-label="Previous month"><i class="bi bi-chevron-left"></i></a>
                <span class="period-label">@ViewBag.MonthName</span>
                <a asp-action="Index" asp-route-month="@nextMonth" asp-route-year="@nextYear" class="btn btn-ghost btn-icon btn-sm" title="Next month" aria-label="Next month"><i class="bi bi-chevron-right"></i></a>
            </div>
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search lot number or remarks…" value="@ViewBag.Search" />
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" asp-route-month="@ViewBag.Month" asp-route-year="@ViewBag.Year" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>

    @if (!Model.Entries.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-droplet"></i></div>
            <div class="es-title">No dying entries this month</div>
            <p>Entries for cloth sent to dying appear here.</p>
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-secondary">Add Entry</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Lot No</th>
                        <th class="text-end">Meters</th>
                        <th>Remarks</th>
                        @if (canManage)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td class="text-nowrap">@entry.EntryDate.ToString("dd MMM yyyy")</td>
                            <td><span class="mono-id">@entry.LotNo</span></td>
                            <td class="cell-num text-foreground fw-medium">@entry.Meters <span class="text-xs text-muted">m</span></td>
                            <td class="text-muted">@entry.Remarks</td>
                            @if (canManage)
                            {
                                <td class="cell-actions">
                                    <form asp-action="Delete" asp-route-id="@entry.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="row-action danger" title="Delete" aria-label="Delete" onclick="return confirm('Delete this entry?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Entries.Count</strong> entries</span>
        </div>
    }
</div>

@if (Model.Summary.Any())
{
    <div class="table-card">
        <div class="data-card-header">
            <span class="data-card-title">Summary by lot (for payment)</span>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Lot No</th>
                        <th class="text-end">Total Meters</th>
                        <th class="text-end">Entries</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Summary)
                    {
                        <tr>
                            <td><span class="mono-id">@item.LotNo</span></td>
                            <td class="cell-num text-foreground fw-medium">@item.TotalMeters <span class="text-xs text-muted">m</span></td>
                            <td class="cell-num">@item.EntryCount</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Grand total</td>
                        <td class="cell-num">@ViewBag.TotalMeters m</td>
                        <td class="cell-num">@Model.Entries.Count</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
