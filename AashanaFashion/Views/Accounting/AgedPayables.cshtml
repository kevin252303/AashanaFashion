@model AashanaFashion.Models.AgedPayablesViewModel
@{
    ViewData["Title"] = $"Aged Payables — As of {Model.AsOfDate:dd MMM yyyy}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Aged Payables</h1>
        <p class="page-sub">Vendor bill liabilities scheduled by due age. As of @Model.AsOfDate.ToString("dd MMM yyyy") · @Model.Company.CompanyName</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-action="ThreeWayMatching" class="btn btn-secondary"><i class="bi bi-check2-all"></i> 3-way matching</a>
        <a asp-action="AgedReceivables" class="btn btn-secondary"><i class="bi bi-people"></i> Aged receivables</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<div class="metric-grid cols-6">
    <div class="metric-card">
        <div class="metric-label">Total payables</div>
        <div class="metric-value">₹@Model.TotalOutstanding.ToString("N2")</div>
        <div class="metric-meta">across @Model.Vendors.Count @(Model.Vendors.Count == 1 ? "vendor" : "vendors")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Current (not due)</div>
        <div class="metric-value">₹@Model.TotalCurrent.ToString("N2")</div>
        <div class="metric-meta @(Model.TotalCurrent > 0 ? "age-current" : "")">within payment terms</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">1–30 days</div>
        <div class="metric-value">₹@Model.Total1To30.ToString("N2")</div>
        <div class="metric-meta @(Model.Total1To30 > 0 ? "age-30" : "")">due this month</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">31–60 days</div>
        <div class="metric-value">₹@Model.Total31To60.ToString("N2")</div>
        <div class="metric-meta @(Model.Total31To60 > 0 ? "age-60" : "")">supplier follow-up</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">61–90 days</div>
        <div class="metric-value">₹@Model.Total61To90.ToString("N2")</div>
        <div class="metric-meta @(Model.Total61To90 > 0 ? "age-90" : "")">urgent payout</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">90+ days</div>
        <div class="metric-value">₹@Model.Total90Plus.ToString("N2")</div>
        <div class="metric-meta @(Model.Total90Plus > 0 ? "age-90p" : "")">critical vendor credit</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="AgedPayables" class="table-toolbar align-end d-print-none">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="agAsOf">Aging cut-off date</label>
                <input type="date" id="agAsOf" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Recalculate</button>
        </div>
    </form>

    @if (!Model.Vendors.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="es-title">No outstanding payables</div>
            <p>No vendor liability is pending as of @Model.AsOfDate.ToString("dd MMM yyyy").</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Vendor</th>
                        <th>City</th>
                        <th class="text-end">Bills</th>
                        <th class="text-end">Total due</th>
                        <th class="text-end">Current</th>
                        <th class="text-end">1–30 days</th>
                        <th class="text-end">31–60 days</th>
                        <th class="text-end">61–90 days</th>
                        <th class="text-end">90+ days</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Vendors)
                    {
                        <tr class="@(v.Days90Plus > 0 ? "row-danger" : "")">
                            <td>
                                <a asp-action="VendorStatement" asp-route-vendorId="@v.VendorId" class="cell-title">@v.VendorName</a>
                                @if (!string.IsNullOrEmpty(v.Gstin))
                                {
                                    <span class="cell-sub font-monospace">@v.Gstin</span>
                                }
                            </td>
                            <td class="text-muted">@(v.City ?? "—")</td>
                            <td class="cell-num">@v.BillCount</td>
                            <td class="cell-num text-foreground fw-semibold">₹@v.TotalOutstanding.ToString("N2")</td>
                            <td class="cell-num @(v.CurrentNotDue > 0 ? "age-current" : "text-muted")">@(v.CurrentNotDue > 0 ? $"₹{v.CurrentNotDue:N2}" : "—")</td>
                            <td class="cell-num @(v.Days1To30 > 0 ? "age-30" : "text-muted")">@(v.Days1To30 > 0 ? $"₹{v.Days1To30:N2}" : "—")</td>
                            <td class="cell-num @(v.Days31To60 > 0 ? "age-60" : "text-muted")">@(v.Days31To60 > 0 ? $"₹{v.Days31To60:N2}" : "—")</td>
                            <td class="cell-num @(v.Days61To90 > 0 ? "age-90" : "text-muted")">@(v.Days61To90 > 0 ? $"₹{v.Days61To90:N2}" : "—")</td>
                            <td class="cell-num @(v.Days90Plus > 0 ? "age-90p" : "text-muted")">@(v.Days90Plus > 0 ? $"₹{v.Days90Plus:N2}" : "—")</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="VendorStatement" asp-route-vendorId="@v.VendorId" class="row-action" title="View statement" aria-label="View statement for @v.VendorName"><i class="bi bi-file-text"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end">Grand total</td>
                        <td class="text-end tabular">₹@Model.TotalOutstanding.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.TotalCurrent.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total1To30.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total31To60.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total61To90.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total90Plus.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
