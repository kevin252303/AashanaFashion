@model AashanaFashion.Models.JournalEntry
@{
    ViewData["Title"] = $"Journal Entry — {Model.EntryNumber}";
    decimal totalDebit = Model.Lines.Sum(l => l.Debit);
    decimal totalCredit = Model.Lines.Sum(l => l.Credit);
    bool isBalanced = Math.Abs(totalDebit - totalCredit) < 0.01m;
}

<div class="page-header">
    <div>
        <a asp-action="JournalEntries" class="page-back"><i class="bi bi-arrow-left"></i> Journal entries</a>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title font-monospace">@Model.EntryNumber</h1>
            <span class="af-badge @(Model.Status == AashanaFashion.Models.JournalEntryStatus.Posted ? "b-green" : Model.Status == AashanaFashion.Models.JournalEntryStatus.Draft ? "b-yellow" : "b-gray")">@Model.Status.Humanize()</span>
        </div>
        <p class="page-sub">@(Model.Journal?.Name ?? "Journal") · @Model.Date.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-actions d-print-none">
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print voucher</button>
        <a asp-action="CreateJournalEntry" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New entry</a>
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-body">
        <div class="info-grid cols-4">
            <div>
                <div class="info-label">Journal</div>
                <div class="info-value">@(Model.Journal?.Name ?? "General") <span class="text-muted font-monospace text-xs">@Model.Journal?.Code</span></div>
            </div>
            <div>
                <div class="info-label">Accounting date</div>
                <div class="info-value">@Model.Date.ToString("dd MMM yyyy")</div>
            </div>
            <div>
                <div class="info-label">Reference</div>
                <div class="info-value font-monospace">@(string.IsNullOrEmpty(Model.Reference) ? "—" : Model.Reference)</div>
            </div>
            <div>
                <div class="info-label">Total</div>
                <div class="info-value tabular">₹@totalDebit.ToString("N2")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Narration))
            {
                <div style="grid-column: 1 / -1;">
                    <div class="info-label">Narration</div>
                    <div class="info-value">@Model.Narration</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="table-card">
    <div class="data-card-header">
        <div class="data-card-title">Debit &amp; credit lines</div>
        @if (isBalanced)
        {
            <span class="af-badge b-green"><i class="bi bi-check2"></i> Balanced</span>
        }
        else
        {
            <span class="af-badge b-red"><i class="bi bi-exclamation-triangle"></i> Out of balance</span>
        }
    </div>
    <div class="table-scroll">
        <table class="af-table">
            <thead>
                <tr>
                    <th style="width: 110px;">Code</th>
                    <th>Account</th>
                    <th>Partner</th>
                    <th>Description</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td><a asp-action="GeneralLedger" asp-route-accountId="@l.AccountId" class="mono-id">@(l.Account?.Code ?? "—")</a></td>
                        <td>
                            <span class="cell-title">@(l.Account?.Name ?? "Account")</span>
                            @if (l.Account != null)
                            {
                                <span class="cell-sub">@l.Account.Classification.Humanize()</span>
                            }
                        </td>
                        <td>
                            @if (l.Customer != null)
                            {
                                <span class="text-foreground">@l.Customer.CustomerName</span>
                                <span class="cell-sub">Customer</span>
                            }
                            else if (l.Vendor != null)
                            {
                                <span class="text-foreground">@l.Vendor.VendorName</span>
                                <span class="cell-sub">Vendor</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted">@(string.IsNullOrEmpty(l.Description) ? "—" : l.Description)</td>
                        <td class="cell-num @(l.Debit > 0 ? "text-foreground fw-semibold" : "text-muted")">@(l.Debit > 0 ? $"₹{l.Debit:N2}" : "—")</td>
                        <td class="cell-num @(l.Credit > 0 ? "text-foreground fw-semibold" : "text-muted")">@(l.Credit > 0 ? $"₹{l.Credit:N2}" : "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Total</td>
                    <td class="text-end tabular">₹@totalDebit.ToString("N2")</td>
                    <td class="text-end tabular">₹@totalCredit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
