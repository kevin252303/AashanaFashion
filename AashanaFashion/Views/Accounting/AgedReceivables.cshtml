@model AashanaFashion.Models.AgedReceivablesViewModel
@{
    ViewData["Title"] = $"Aged Receivables — As of {Model.AsOfDate:dd MMM yyyy}";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">👥 Accounts Receivable (AR) Aging Analysis</h1>
        <p class="page-sub mb-0 text-muted">Tracking pending customer invoice collections across aging overdue periods (30 / 60 / 90+ days)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AgedPayables" class="btn btn-outline-danger">
            🏢 Vendor Aged Payables
        </a>
        <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-primary">
            🧾 All Invoices
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            🖨️ Print Report
        </button>
    </div>
</div>

<!-- Date Filter -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AgedReceivables" class="row g-2 align-items-center">
            <div class="col-md-auto">
                <span class="small fw-bold text-secondary">Aging Cut-Off Date:</span>
            </div>
            <div class="col-md-3">
                <input type="date" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-sm btn-dark">Recalculate Aging</button>
            </div>
            <div class="col-md-auto ms-auto">
                <span class="text-muted small">Company: <strong>@Model.Company.CompanyName</strong></span>
            </div>
        </form>
    </div>
</div>

<!-- Summary KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-primary-subtle text-primary border-primary">
            <div class="card-body p-3">
                <span class="small text-uppercase fw-bold d-block text-primary">Total Receivables</span>
                <h4 class="fw-bold my-1 text-primary">₹@Model.TotalOutstanding.ToString("N2")</h4>
                <small class="text-primary fw-semibold">Across @Model.Customers.Count customer(s)</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">Current (Not Due)</span>
                <h4 class="fw-bold my-1 text-success">₹@Model.TotalCurrent.ToString("N2")</h4>
                <small class="text-muted">Within credit terms</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">1 – 30 Days Overdue</span>
                <h4 class="fw-bold my-1 text-warning">₹@Model.Total1To30.ToString("N2")</h4>
                <small class="text-muted">First reminder stage</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">31 – 60 Days Overdue</span>
                <h4 class="fw-bold my-1 text-orange" style="color: #fd7e14;">₹@Model.Total31To60.ToString("N2")</h4>
                <small class="text-muted">Follow-up required</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">61 – 90 Days Overdue</span>
                <h4 class="fw-bold my-1 text-danger">₹@Model.Total61To90.ToString("N2")</h4>
                <small class="text-muted">Urgent recovery</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-danger-subtle border-danger">
            <div class="card-body p-3">
                <span class="text-danger small text-uppercase fw-bold d-block">90+ Days Critical</span>
                <h4 class="fw-bold my-1 text-danger">₹@Model.Total90Plus.ToString("N2")</h4>
                <small class="text-danger fw-semibold">High default risk</small>
            </div>
        </div>
    </div>
</div>

<!-- Aged Receivables Grid -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">Customer Outstanding Breakdown</h6>
        <span class="text-muted small">@Model.Customers.Count customer(s) with pending balance</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Customer Name</th>
                    <th>City / State</th>
                    <th class="text-center">Bills</th>
                    <th class="text-end">Total Due (₹)</th>
                    <th class="text-end text-success">Current (₹)</th>
                    <th class="text-end text-warning">1-30 Days</th>
                    <th class="text-end" style="color: #fd7e14;">31-60 Days</th>
                    <th class="text-end text-danger">61-90 Days</th>
                    <th class="text-end text-danger">90+ Days</th>
                    <th class="text-center" style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Customers.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            🎉 No outstanding customer balances found as of @Model.AsOfDate.ToString("dd-MMM-yyyy")!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Customers)
                    {
                        string waMessage = Uri.EscapeDataString($"Dear {c.CustomerName},\nThis is a gentle reminder from {Model.Company.CompanyName}. Your outstanding balance as of {Model.AsOfDate:dd-MMM-yyyy} is ₹{c.TotalOutstanding:N2}.\nPlease arrange for clearance at your earliest convenience.\nThank you!");
                        string cleanPhone = (c.Phone ?? "").Replace(" ", "").Replace("+", "").Replace("-", "");
                        if (!cleanPhone.StartsWith("91") && cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;

                        <tr>
                            <td>
                                <a asp-action="CustomerStatement" asp-route-customerId="@c.CustomerId" class="fw-bold text-decoration-none">
                                    @c.CustomerName
                                </a>
                                @if (!string.IsNullOrEmpty(c.Gstin))
                                {
                                    <small class="d-block font-monospace text-muted" style="font-size: 0.72rem;">@c.Gstin</small>
                                }
                            </td>
                            <td class="small text-muted">@(c.City ?? "—")</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@c.InvoiceCount</span></td>
                            <td class="text-end fw-bold font-monospace text-primary">₹@c.TotalOutstanding.ToString("N2")</td>
                            <td class="text-end font-monospace @(c.CurrentNotDue > 0 ? "text-success fw-semibold" : "text-muted")">
                                @(c.CurrentNotDue > 0 ? $"₹{c.CurrentNotDue:N2}" : "—")
                            </td>
                            <td class="text-end font-monospace @(c.Days1To30 > 0 ? "text-warning fw-semibold" : "text-muted")">
                                @(c.Days1To30 > 0 ? $"₹{c.Days1To30:N2}" : "—")
                            </td>
                            <td class="text-end font-monospace @(c.Days31To60 > 0 ? "fw-semibold" : "text-muted")" style="@(c.Days31To60 > 0 ? "color: #fd7e14;" : "")">
                                @(c.Days31To60 > 0 ? $"₹{c.Days31To60:N2}" : "—")
                            </td>
                            <td class="text-end font-monospace @(c.Days61To90 > 0 ? "text-danger fw-semibold" : "text-muted")">
                                @(c.Days61To90 > 0 ? $"₹{c.Days61To90:N2}" : "—")
                            </td>
                            <td class="text-end font-monospace @(c.Days90Plus > 0 ? "text-danger fw-bold" : "text-muted")">
                                @if (c.Days90Plus > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger">₹@c.Days90Plus.ToString("N2")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="CustomerStatement" asp-route-customerId="@c.CustomerId" class="btn btn-outline-secondary" title="View Statement">
                                        📜 Statement
                                    </a>
                                    @if (!string.IsNullOrEmpty(c.Phone))
                                    {
                                        <a href="https://wa.me/@cleanPhone?text=@waMessage" target="_blank" class="btn btn-outline-success" title="Send WhatsApp Reminder">
                                            💬 WA
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light fw-bold fs-6">
                <tr>
                    <td colspan="3">Grand Total Receivables:</td>
                    <td class="text-end font-monospace text-primary">₹@Model.TotalOutstanding.ToString("N2")</td>
                    <td class="text-end font-monospace text-success">₹@Model.TotalCurrent.ToString("N2")</td>
                    <td class="text-end font-monospace text-warning">₹@Model.Total1To30.ToString("N2")</td>
                    <td class="text-end font-monospace" style="color: #fd7e14;">₹@Model.Total31To60.ToString("N2")</td>
                    <td class="text-end font-monospace text-danger">₹@Model.Total61To90.ToString("N2")</td>
                    <td class="text-end font-monospace text-danger">₹@Model.Total90Plus.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
