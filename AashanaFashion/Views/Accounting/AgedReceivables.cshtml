@model AashanaFashion.Models.AgedReceivablesViewModel
@{
    ViewData["Title"] = $"Aged Receivables — As of {Model.AsOfDate:dd MMM yyyy}";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Aged Receivables</h1>
        <p class="page-sub">Pending customer collections by how long they are overdue. As of @Model.AsOfDate.ToString("dd MMM yyyy") · @Model.Company.CompanyName</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-controller="Invoice" asp-action="Index" class="btn btn-secondary"><i class="bi bi-receipt"></i> Invoices</a>
        <a asp-action="AgedPayables" class="btn btn-secondary"><i class="bi bi-building"></i> Aged payables</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<div class="metric-grid cols-6">
    <div class="metric-card">
        <div class="metric-label">Total receivables</div>
        <div class="metric-value">₹@Model.TotalOutstanding.ToString("N2")</div>
        <div class="metric-meta">across @Model.Customers.Count @(Model.Customers.Count == 1 ? "customer" : "customers")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Current (not due)</div>
        <div class="metric-value">₹@Model.TotalCurrent.ToString("N2")</div>
        <div class="metric-meta @(Model.TotalCurrent > 0 ? "age-current" : "")">within credit terms</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">1–30 days</div>
        <div class="metric-value">₹@Model.Total1To30.ToString("N2")</div>
        <div class="metric-meta @(Model.Total1To30 > 0 ? "age-30" : "")">first reminder stage</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">31–60 days</div>
        <div class="metric-value">₹@Model.Total31To60.ToString("N2")</div>
        <div class="metric-meta @(Model.Total31To60 > 0 ? "age-60" : "")">follow-up required</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">61–90 days</div>
        <div class="metric-value">₹@Model.Total61To90.ToString("N2")</div>
        <div class="metric-meta @(Model.Total61To90 > 0 ? "age-90" : "")">urgent recovery</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">90+ days</div>
        <div class="metric-value">₹@Model.Total90Plus.ToString("N2")</div>
        <div class="metric-meta @(Model.Total90Plus > 0 ? "age-90p" : "")">high default risk</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="AgedReceivables" class="table-toolbar align-end d-print-none">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="agAsOf">Aging cut-off date</label>
                <input type="date" id="agAsOf" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Recalculate</button>
        </div>
    </form>

    @if (!Model.Customers.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="es-title">No outstanding receivables</div>
            <p>No customer has a pending balance as of @Model.AsOfDate.ToString("dd MMM yyyy").</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>City</th>
                        <th class="text-end">Invoices</th>
                        <th class="text-end">Total due</th>
                        <th class="text-end">Current</th>
                        <th class="text-end">1–30 days</th>
                        <th class="text-end">31–60 days</th>
                        <th class="text-end">61–90 days</th>
                        <th class="text-end">90+ days</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        string waMessage = Uri.EscapeDataString($"Dear {c.CustomerName},\nThis is a gentle reminder from {Model.Company.CompanyName}. Your outstanding balance as of {Model.AsOfDate:dd-MMM-yyyy} is ₹{c.TotalOutstanding:N2}.\nPlease arrange for clearance at your earliest convenience.\nThank you!");
                        string cleanPhone = (c.Phone ?? "").Replace(" ", "").Replace("+", "").Replace("-", "");
                        if (!cleanPhone.StartsWith("91") && cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;
                        <tr class="@(c.Days90Plus > 0 ? "row-danger" : "")">
                            <td>
                                <a asp-action="CustomerStatement" asp-route-customerId="@c.CustomerId" class="cell-title">@c.CustomerName</a>
                                @if (!string.IsNullOrEmpty(c.Gstin))
                                {
                                    <span class="cell-sub font-monospace">@c.Gstin</span>
                                }
                            </td>
                            <td class="text-muted">@(c.City ?? "—")</td>
                            <td class="cell-num">@c.InvoiceCount</td>
                            <td class="cell-num text-foreground fw-semibold">₹@c.TotalOutstanding.ToString("N2")</td>
                            <td class="cell-num @(c.CurrentNotDue > 0 ? "age-current" : "text-muted")">@(c.CurrentNotDue > 0 ? $"₹{c.CurrentNotDue:N2}" : "—")</td>
                            <td class="cell-num @(c.Days1To30 > 0 ? "age-30" : "text-muted")">@(c.Days1To30 > 0 ? $"₹{c.Days1To30:N2}" : "—")</td>
                            <td class="cell-num @(c.Days31To60 > 0 ? "age-60" : "text-muted")">@(c.Days31To60 > 0 ? $"₹{c.Days31To60:N2}" : "—")</td>
                            <td class="cell-num @(c.Days61To90 > 0 ? "age-90" : "text-muted")">@(c.Days61To90 > 0 ? $"₹{c.Days61To90:N2}" : "—")</td>
                            <td class="cell-num @(c.Days90Plus > 0 ? "age-90p" : "text-muted")">@(c.Days90Plus > 0 ? $"₹{c.Days90Plus:N2}" : "—")</td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="CustomerStatement" asp-route-customerId="@c.CustomerId" class="row-action" title="View statement" aria-label="View statement for @c.CustomerName"><i class="bi bi-file-text"></i></a>
                                    @if (!string.IsNullOrEmpty(c.Phone))
                                    {
                                        <a href="https://wa.me/@cleanPhone?text=@waMessage" target="_blank" rel="noopener" class="row-action success" title="Send WhatsApp reminder" aria-label="Send WhatsApp reminder to @c.CustomerName"><i class="bi bi-whatsapp"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end">Grand total</td>
                        <td class="text-end tabular">₹@Model.TotalOutstanding.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.TotalCurrent.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total1To30.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total31To60.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total61To90.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Total90Plus.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
