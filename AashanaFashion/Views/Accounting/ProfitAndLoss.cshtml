@model AashanaFashion.Models.ProfitAndLossViewModel
@{
    ViewData["Title"] = $"Profit & Loss ({Model.FromDate:dd MMM yyyy} to {Model.ToDate:dd MMM yyyy})";
    bool profit = Model.NetProfit >= 0;

    void Lines(AashanaFashion.Models.FinancialReportSection sec)
    {
        if (!sec.Lines.Any())
        {
            <tr><td colspan="3" class="fs-indent text-muted">No postings in this period</td></tr>
        }
        foreach (var line in sec.Lines)
        {
            <tr>
                <td class="fs-indent">@line.Name</td>
                <td class="font-monospace text-xs text-muted">@line.Code</td>
                <td class="cell-num">@line.Amount.ToString("N2")</td>
            </tr>
        }
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Profit &amp; Loss</h1>
        <p class="page-sub">Revenue, manufacturing costs, overheads and net profit for @Model.FromDate.ToString("dd MMM yyyy") – @Model.ToDate.ToString("dd MMM yyyy").</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-action="BalanceSheet" class="btn btn-secondary"><i class="bi bi-bank"></i> Balance sheet</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total revenue</div>
        <div class="metric-value">₹@Model.TotalIncome.ToString("N2")</div>
        <div class="metric-meta">net sales &amp; job work</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Cost of goods sold</div>
        <div class="metric-value">₹@Model.CostOfGoodsSold.TotalAmount.ToString("N2")</div>
        <div class="metric-meta">direct fabric &amp; job charges</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Gross profit</div>
        <div class="metric-value">₹@Model.GrossProfit.ToString("N2")</div>
        <div class="metric-meta info">@Model.GrossMarginPercentage.ToString("F1")% gross margin</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Net @(profit ? "profit" : "loss")</div>
        <div class="metric-value @(profit ? "" : "text-danger")">₹@Model.NetProfit.ToString("N2")</div>
        <div class="metric-meta @(profit ? "success" : "danger")">@Model.NetMarginPercentage.ToString("F1")% net margin</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="ProfitAndLoss" class="table-toolbar align-end d-print-none">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="plFrom">From</label>
                <input type="date" id="plFrom" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
            <div class="toolbar-field">
                <label for="plTo">To</label>
                <input type="date" id="plTo" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Update report</button>
        </div>
    </form>

    <div class="table-scroll">
        <table class="af-table fin-table">
            <thead>
                <tr>
                    <th>Particulars</th>
                    <th style="width: 140px;">Account</th>
                    <th class="text-end" style="width: 200px;">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                <tr class="fs-group"><td colspan="3">I. Revenue from operations</td></tr>
                @{ Lines(Model.OperatingRevenue); }
                @if (Model.OtherIncome.Lines.Any())
                {
                    <tr class="fs-group"><td colspan="3">II. Other income</td></tr>
                    Lines(Model.OtherIncome);
                }
                <tr class="fs-subtotal">
                    <td colspan="2">Total revenue</td>
                    <td class="cell-num">₹@Model.TotalIncome.ToString("N2")</td>
                </tr>

                <tr class="fs-group"><td colspan="3">III. Cost of goods sold</td></tr>
                @{ Lines(Model.CostOfGoodsSold); }
                <tr class="fs-highlight">
                    <td colspan="2">Gross profit <span class="fw-normal">(revenue − cost of sales)</span></td>
                    <td class="cell-num">₹@Model.GrossProfit.ToString("N2")</td>
                </tr>

                <tr class="fs-group"><td colspan="3">IV. Operating &amp; administrative expenses</td></tr>
                @{ Lines(Model.OperatingExpenses); }
                @if (Model.FinancialExpenses.Lines.Any())
                {
                    <tr class="fs-group"><td colspan="3">V. Financial expenses</td></tr>
                    Lines(Model.FinancialExpenses);
                }
            </tbody>
            <tfoot>
                <tr class="fs-result @(profit ? "positive" : "negative")">
                    <td colspan="2">Net @(profit ? "profit" : "loss") for the period</td>
                    <td class="text-end tabular">₹@Model.NetProfit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
