@model AashanaFashion.Models.GeneralLedgerAccountViewModel
@{
    ViewData["Title"] = Model != null ? $"General Ledger — {Model.Account.Code} {Model.Account.Name}" : "General Ledger";
    var accounts = ViewBag.Accounts as List<AashanaFashion.Models.Account> ?? new();
    int? selectedAccountId = ViewBag.SelectedAccountId;
}

<div class="page-header">
    <div>
        <a asp-action="ChartOfAccounts" class="page-back"><i class="bi bi-arrow-left"></i> Chart of accounts</a>
        <h1 class="page-title">General ledger</h1>
        <p class="page-sub">Debits, credits and running balance for a single ledger account.</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-action="JournalEntries" class="btn btn-secondary"><i class="bi bi-journal-text"></i> Journal entries</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print ledger</button>
    </div>
</div>

<div class="table-card mb-4 d-print-none">
    <form method="get" asp-action="GeneralLedger" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="glAccount">Account</label>
                <select id="glAccount" name="accountId" class="af-input af-select" onchange="this.form.submit()" style="min-width: 280px;">
                    @foreach (var a in accounts)
                    {
                        <option value="@a.Id" selected="@(a.Id == selectedAccountId)">@a.Code — @a.Name (@a.Type)</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="glFrom">From</label>
                <input type="date" id="glFrom" name="fromDate" value="@ViewBag.FromDate" class="af-input" />
            </div>
            <div class="toolbar-field">
                <label for="glTo">To</label>
                <input type="date" id="glTo" name="toDate" value="@ViewBag.ToDate" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Load ledger</button>
        </div>
    </form>
</div>

@if (Model == null)
{
    <div class="table-card">
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-journal-text"></i></div>
            <div class="es-title">Select an account</div>
            <p>Pick a ledger account above to see its transactions.</p>
        </div>
    </div>
}
else
{
    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-label">Opening balance</div>
            <div class="metric-value">₹@Math.Abs(Model.OpeningBalance).ToString("N2")</div>
            <div class="metric-meta">@(Model.OpeningBalance >= 0 ? "debit" : "credit") at start of period</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Period debits</div>
            <div class="metric-value">₹@Model.TotalDebit.ToString("N2")</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Period credits</div>
            <div class="metric-value">₹@Model.TotalCredit.ToString("N2")</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Closing balance</div>
            <div class="metric-value">₹@Math.Abs(Model.ClosingBalance).ToString("N2")</div>
            <div class="metric-meta info">@(Model.ClosingBalance >= 0 ? "debit balance" : "credit balance")</div>
        </div>
    </div>

    <div class="table-card">
        <div class="data-card-header">
            <div class="data-card-title d-flex align-items-center gap-2 flex-wrap">
                <span class="mono-id">@Model.Account.Code</span> @Model.Account.Name
                <span class="af-badge b-gray">@Model.Account.Type</span>
            </div>
            <span class="text-xs text-muted">@Model.Rows.Count @(Model.Rows.Count == 1 ? "transaction" : "transactions")</span>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Voucher</th>
                        <th>Journal</th>
                        <th>Reference</th>
                        <th>Partner</th>
                        <th>Narration</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="row-muted">
                        <td colspan="6" class="text-muted fw-medium">Opening balance</td>
                        <td class="cell-num text-muted">—</td>
                        <td class="cell-num text-muted">—</td>
                        <td class="cell-num text-foreground fw-semibold">₹@Math.Abs(Model.OpeningBalance).ToString("N2")<span class="dr-cr">@(Model.OpeningBalance >= 0 ? "Dr" : "Cr")</span></td>
                    </tr>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No transactions for this account in the selected range.</td>
                        </tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-nowrap text-muted tabular">@r.Date.ToString("dd MMM yyyy")</td>
                            <td><a asp-action="JournalEntryDetails" asp-route-id="@r.EntryId" class="cell-title font-monospace">@r.EntryNumber</a></td>
                            <td><span class="mono-id">@r.JournalCode</span></td>
                            <td class="font-monospace text-xs">@(r.Reference ?? "—")</td>
                            <td>@(r.PartnerName ?? "—")</td>
                            <td class="text-muted">@r.Narration</td>
                            <td class="cell-num @(r.Debit > 0 ? "text-foreground" : "text-muted")">@(r.Debit > 0 ? r.Debit.ToString("N2") : "—")</td>
                            <td class="cell-num @(r.Credit > 0 ? "text-foreground" : "text-muted")">@(r.Credit > 0 ? r.Credit.ToString("N2") : "—")</td>
                            <td class="cell-num fw-semibold @(r.RunningBalance >= 0 ? "text-foreground" : "text-danger")">₹@Math.Abs(r.RunningBalance).ToString("N2")<span class="dr-cr">@(r.RunningBalance >= 0 ? "Dr" : "Cr")</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6" class="text-end">Period totals</td>
                        <td class="text-end tabular">₹@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.TotalCredit.ToString("N2")</td>
                        <td class="text-end tabular">₹@Math.Abs(Model.ClosingBalance).ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
