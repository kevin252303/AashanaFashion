@model IEnumerable<AashanaFashion.Models.AccountingTransaction>
@{
    ViewData["Title"] = "Financial Accounting & General Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">💰 Financial Accounting & General Ledger</h1>
        <p class="page-sub mb-0 text-muted">Comprehensive double-entry cash flow, GST summary, AR/AP, and expense ledger</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-primary">
            🧾 Tax Invoices & Receivables
        </a>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#vendorPayoutModal">
            📤 Record Vendor Payout
        </button>
        <a asp-action="Create" class="btn btn-primary">+ Record Entry</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Total Revenue / Inflow</span>
                <h3 class="fw-bold my-1 text-success">₹@(((decimal)ViewBag.TotalIncome).ToString("N2"))</h3>
                <small class="text-muted">Cleared sales and income receipts</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Total Operating Expenses</span>
                <h3 class="fw-bold my-1 text-danger">₹@(((decimal)ViewBag.TotalExpense).ToString("N2"))</h3>
                <small class="text-muted">Purchases, labor, and job-work payouts</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Net Operating Balance</span>
                @{
                    var balance = (decimal)ViewBag.NetBalance;
                }
                <h3 class="fw-bold my-1 @(balance >= 0 ? "text-primary" : "text-danger")">
                    ₹@balance.ToString("N2")
                </h3>
                <small class="text-muted">Net financial position</small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Customer Receivables (AR)</span>
                <h4 class="fw-bold my-1 text-warning">₹@(((decimal)ViewBag.TotalReceivables).ToString("N2"))</h4>
                <small class="text-muted"><a asp-controller="Invoice" asp-action="Index" class="text-decoration-none">View Unpaid Invoices →</a></small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Output GST Collected</span>
                <h4 class="fw-bold my-1 text-dark">₹@(((decimal)ViewBag.TotalOutputGst).ToString("N2"))</h4>
                <small class="text-muted">Tax liability collected from sales</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Vendor Disbursements</span>
                <h4 class="fw-bold my-1 text-secondary">₹@(((decimal)ViewBag.TotalVendorPaid).ToString("N2"))</h4>
                <small class="text-muted">Direct vendor & job-worker settlements</small>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="startDate">Start Date</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold" for="endDate">End Date</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="type">Type</label>
                <select id="type" name="type" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    <option value="Income" selected="@(ViewBag.Type == AashanaFashion.Models.TransactionType.Income)">Income</option>
                    <option value="Expense" selected="@(ViewBag.Type == AashanaFashion.Models.TransactionType.Expense)">Expense</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold" for="category">Category</label>
                <select id="category" name="category" class="form-select form-select-sm">
                    <option value="">— All —</option>
                    @foreach (var cat in (List<string>)ViewBag.Categories)
                    {
                        <option value="@cat" selected="@(ViewBag.Category == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Ledger Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title mb-0 fw-bold">📜 General Ledger Journal</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th>Party / Entity</th>
                        <th>Reference</th>
                        <th>Description</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model)
                    {
                        <tr>
                            <td>@tx.Date.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (tx.Type == AashanaFashion.Models.TransactionType.Income)
                                {
                                    <span class="badge bg-success">Income</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expense</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@tx.Category</span></td>
                            <td class="text-end fw-bold @(tx.Type == AashanaFashion.Models.TransactionType.Income ? "text-success" : "text-danger")">
                                @(tx.Type == AashanaFashion.Models.TransactionType.Income ? "+" : "-")₹@tx.Amount.ToString("N2")
                            </td>
                            <td>
                                @if (tx.VendorId.HasValue)
                                {
                                    <small><span class="text-muted">Vendor:</span> <strong>@tx.Vendor?.VendorName</strong></small>
                                }
                                else if (tx.CustomerId.HasValue)
                                {
                                    <small><span class="text-muted">Customer:</span> <strong>@tx.Customer?.CustomerName</strong></small>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><code>@(tx.Reference ?? "—")</code></td>
                            <td class="small" style="max-width: 250px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="@tx.Description">
                                @tx.Description
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@tx.Id" class="btn btn-outline-secondary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@tx.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this ledger transaction?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger">✕</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No transactions found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Record Vendor Payout Modal -->
<div class="modal fade" id="vendorPayoutModal" tabindex="-1" aria-labelledby="vendorPayoutModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RecordVendorPayment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="vendorPayoutModalLabel">📤 Record Vendor Payout Voucher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vendor / Job Worker</label>
                        <select name="VendorId" class="form-select" required>
                            <option value="">-- Select Vendor --</option>
                            @foreach (var v in (List<AashanaFashion.Models.Vendor>)ViewBag.Vendors)
                            {
                                <option value="@v.Id">@v.VendorName (@(v.Industry ?? "Vendor"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link Purchase Order (Optional)</label>
                        <select name="PurchaseOrderId" class="form-select">
                            <option value="">-- None / General Job Work --</option>
                            @foreach (var po in (List<AashanaFashion.Models.PurchaseOrder>)ViewBag.PurchaseOrders)
                            {
                                <option value="@po.Id">PO #@po.Id — @(po.Vendor?.VendorName ?? "") (₹@po.TotalAmount.ToString("N0"))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Disbursement Amount (₹)</label>
                        <input type="number" step="0.01" name="Amount" class="form-control form-control-lg fw-bold text-danger" placeholder="0.00" min="0.01" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Date</label>
                        <input type="date" name="PaymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Mode</label>
                        <select name="PaymentMode" class="form-select" asp-items="Html.GetEnumSelectList<AashanaFashion.Models.PaymentMode>()"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reference / UTR / Cheque #</label>
                        <input type="text" name="ReferenceNumber" class="form-control" placeholder="Transaction Reference" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="Job-work lot reference or bill settlement note..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold">Disburse Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>
