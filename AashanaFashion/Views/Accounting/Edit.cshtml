@model AashanaFashion.Models.AccountingTransaction
@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> General ledger</a>
        <h1 class="page-title">Edit transaction</h1>
        <p class="page-sub">Update an existing ledger entry.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Edit" method="post" class="data-card">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="data-card-header">
                <div>
                    <div class="data-card-title">Transaction details</div>
                    <div class="data-card-sub">Fields marked <span class="req">*</span> are required.</div>
                </div>
            </div>
            <div class="data-card-body">
                <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label">Date <span class="req">*</span></label>
                        <input asp-for="Date" type="date" class="af-input" value="@Model.Date.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Type" class="form-label">Type <span class="req">*</span></label>
                        <select asp-for="Type" class="af-input af-select">
                            <option value="Income">Income (+)</option>
                            <option value="Expense">Expense (−)</option>
                        </select>
                        <span asp-validation-for="Type" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">Amount <span class="req">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Amount" type="number" step="0.01" class="af-input" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">Category <span class="req">*</span></label>
                        <select asp-for="Category" class="af-input af-select" id="categorySelect">
                            <option value="Sales">Sales</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Raw Material">Raw Material</option>
                            <option value="Dying Work">Dying Work</option>
                            <option value="Roll Press Work">Roll Press Work</option>
                            <option value="Salary / Wages">Salary / Wages</option>
                            <option value="Rent">Rent</option>
                            <option value="Utilities">Utilities (Electricity, Water, etc.)</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Category" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VendorId" class="form-label">Vendor <span class="text-muted fw-normal">(optional)</span></label>
                        <select asp-for="VendorId" class="af-input af-select" asp-items="ViewBag.Vendors">
                            <option value="">None</option>
                        </select>
                        <span asp-validation-for="VendorId" class="af-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer <span class="text-muted fw-normal">(optional)</span></label>
                        <select asp-for="CustomerId" class="af-input af-select" asp-items="ViewBag.Customers">
                            <option value="">None</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="af-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Reference" class="form-label">Reference number <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Reference" class="af-input font-monospace" placeholder="e.g. invoice no., PO number, lot ID" />
                        <span asp-validation-for="Reference" class="af-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="af-input" rows="3" placeholder="Describe the transaction…"></textarea>
                        <span asp-validation-for="Description" class="af-error"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
