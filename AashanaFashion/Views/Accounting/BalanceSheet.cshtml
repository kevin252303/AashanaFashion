@model AashanaFashion.Models.BalanceSheetViewModel
@{
    ViewData["Title"] = $"Balance Sheet — As of {Model.AsOfDate:dd MMM yyyy}";

    void Section(string title, AashanaFashion.Models.FinancialReportSection sec, bool skipIfEmpty = false)
    {
        if (skipIfEmpty && !sec.Lines.Any()) return;
        <tr class="fs-group">
            <td colspan="2">@title</td>
            <td class="cell-num">₹@sec.TotalAmount.ToString("N2")</td>
        </tr>
        foreach (var l in sec.Lines)
        {
            <tr>
                <td class="fs-indent">@l.Name</td>
                <td class="font-monospace text-xs text-muted">@l.Code</td>
                <td class="cell-num">@l.Amount.ToString("N2")</td>
            </tr>
        }
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Balance Sheet</h1>
        <p class="page-sub">Assets, liabilities and equity as of @Model.AsOfDate.ToString("dd MMM yyyy") (assets = liabilities + equity).</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-action="ProfitAndLoss" class="btn btn-secondary"><i class="bi bi-graph-up-arrow"></i> Profit &amp; loss</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

@if (Model.IsBalanced)
{
    <div class="af-alert af-alert-success">
        <div class="alert-body"><span class="alert-title">Balance sheet is balanced</span>Assets and liabilities + equity both total ₹@Model.TotalAssets.ToString("N2").</div>
    </div>
}
else
{
    <div class="af-alert af-alert-warning">
        <div class="alert-body"><span class="alert-title">Difference of ₹@Math.Abs(Model.TotalAssets - Model.TotalLiabilitiesAndEquity).ToString("N2")</span>Assets don’t equal liabilities + equity. Check unposted or one-sided entries.</div>
    </div>
}

<div class="table-card mb-4 d-print-none">
    <form method="get" asp-action="BalanceSheet" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="bsAsOf">As of date</label>
                <input type="date" id="bsAsOf" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Update</button>
        </div>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="data-card-header">
                <div class="data-card-title">Assets</div>
                <span class="fw-semibold text-foreground tabular">₹@Model.TotalAssets.ToString("N2")</span>
            </div>
            <div class="table-scroll">
                <table class="af-table fin-table">
                    <tbody>
                        @{
                            Section("Cash & bank", Model.BankAndCash);
                            Section("Trade debtors (accounts receivable)", Model.AccountsReceivable);
                            Section("Inventories", Model.Inventory);
                            Section("Input GST & current assets", Model.CurrentAssets, true);
                            Section("Property, plant & equipment", Model.FixedAssets, true);
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2">Total assets</td>
                            <td class="text-end tabular">₹@Model.TotalAssets.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="table-card h-100">
            <div class="data-card-header">
                <div class="data-card-title">Liabilities &amp; equity</div>
                <span class="fw-semibold text-foreground tabular">₹@Model.TotalLiabilitiesAndEquity.ToString("N2")</span>
            </div>
            <div class="table-scroll">
                <table class="af-table fin-table">
                    <tbody>
                        @{
                            Section("Trade creditors (accounts payable)", Model.AccountsPayable);
                            Section("Output GST & tax liabilities", Model.DutiesAndTaxes);
                            Section("Other current liabilities", Model.CurrentLiabilities, true);
                        }
                        <tr class="fs-group">
                            <td colspan="2">Equity &amp; reserves</td>
                            <td class="cell-num">₹@Model.TotalEquity.ToString("N2")</td>
                        </tr>
                        @foreach (var l in Model.CapitalAndReserves.Lines)
                        {
                            <tr>
                                <td class="fs-indent">@l.Name</td>
                                <td class="font-monospace text-xs text-muted">@l.Code</td>
                                <td class="cell-num">@l.Amount.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td class="fs-indent">Current period profit / (loss)</td>
                            <td class="font-monospace text-xs text-muted">P&amp;L</td>
                            <td class="cell-num fw-semibold @(Model.CurrentPeriodProfitOrLoss >= 0 ? "text-success" : "text-danger")">@Model.CurrentPeriodProfitOrLoss.ToString("N2")</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2">Total liabilities &amp; equity</td>
                            <td class="text-end tabular">₹@Model.TotalLiabilitiesAndEquity.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
