@model AashanaFashion.Models.CustomerStatementViewModel
@{
    ViewData["Title"] = $"Statement of Account — {Model.Customer.CustomerName}";
}

<div class="page-header d-print-none">
    <div>
        <a asp-action="AgedReceivables" class="page-back"><i class="bi bi-arrow-left"></i> Aged receivables</a>
        <h1 class="page-title">Statement of account</h1>
        <p class="page-sub">Transactions and running balance for @Model.Customer.CustomerName.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print / save PDF</button>
    </div>
</div>

<div class="data-card doc-sheet">
    <div class="doc-head">
        <div>
            <div class="doc-company">@Model.Company.CompanyName</div>
            <div class="text-sm text-muted">@Model.Company.Address1 @Model.Company.Address2</div>
            <div class="text-sm text-muted">@Model.Company.City, @Model.Company.State – @Model.Company.PinCode</div>
            <div class="text-xs text-muted mt-1">GSTIN <span class="font-monospace text-foreground">@(Model.Company.Gstin ?? "Not set")</span></div>
                    <span class="text-xs text-muted">Phone @Model.Company.Phone</span>
        </div>
        <div class="doc-kind">
            <span class="micro-label">Statement of account</span>
            <strong>@Model.FromDate.ToString("dd MMM yyyy") – @Model.ToDate.ToString("dd MMM yyyy")</strong>
        </div>
    </div>

    <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="panel-inset h-100 mb-0">
                    <span class="micro-label mb-1">Bill to</span>
                    <div class="text-foreground fw-semibold">@Model.Customer.CustomerName</div>
                    <div class="text-sm text-muted">@(Model.Customer.Address ?? "Address on file")</div>
                    <div class="text-sm text-muted">@(Model.Customer.City ?? "")@(string.IsNullOrEmpty(Model.Customer.State) ? "" : ", " + Model.Customer.State)</div>
                    <div class="kv-row mt-2"><span class="k">GSTIN</span><span class="v font-monospace">@(Model.Customer.GstNumber ?? "URP (unregistered)")</span></div>
                    <div class="kv-row"><span class="k">Phone</span><span class="v">@(Model.Customer.Phone ?? "—")</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel-inset h-100 mb-0">
                    <span class="micro-label mb-1">Remit payment to</span>
                    <div class="kv-row"><span class="k">Bank</span><span class="v">@(Model.Company.BankName ?? "Not set")</span></div>
                    <div class="kv-row"><span class="k">Account name</span><span class="v">@Model.Company.CompanyName</span></div>
                    <div class="kv-row"><span class="k">A/c number</span><span class="v font-monospace">@(Model.Company.BankAccountNumber ?? "Not set")</span></div>
                    <div class="kv-row"><span class="k">IFSC</span><span class="v font-monospace">@(Model.Company.BankIfsc ?? "Not set")</span></div>
                    <div class="kv-row"><span class="k">Branch</span><span class="v">@(Model.Company.BankBranch ?? "Not set")</span></div>
                </div>
            </div>
    </div>

    <div class="stat-strip mb-4">
        <div><div class="info-label">Opening balance</div><div class="info-value">₹@Model.OpeningBalance.ToString("N2")</div></div>
        <div><div class="info-label">Invoiced (+)</div><div class="info-value">₹@Model.TotalInvoiced.ToString("N2")</div></div>
        <div><div class="info-label">Payments / returns (−)</div><div class="info-value @(Model.TotalPaid + Model.TotalReturns > 0 ? "text-success" : "")">₹@((Model.TotalPaid + Model.TotalReturns).ToString("N2"))</div></div>
        <div class="is-total"><div class="info-label">Balance due</div><div class="info-value">₹@Model.ClosingBalance.ToString("N2")</div></div>
    </div>

    <div class="grid-card">
        <table class="af-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Document</th>
                    <th>Description</th>
                    <th class="text-end">Invoiced</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody>
                <tr class="row-muted">
                    <td colspan="4" class="text-muted fw-medium">Opening balance as on @Model.FromDate.ToString("dd MMM yyyy")</td>
                    <td class="cell-num text-muted">—</td>
                    <td class="cell-num text-muted">—</td>
                    <td class="cell-num text-foreground fw-semibold">₹@Model.OpeningBalance.ToString("N2")</td>
                </tr>
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No transactions recorded in this period.</td></tr>
                }
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td class="text-nowrap text-muted tabular">@t.Date.ToString("dd MMM yyyy")</td>
                        <td><span class="af-badge @(t.Type == "Invoice" ? "b-blue" : t.Type == "Payment" ? "b-green" : "b-yellow")">@t.Type</span></td>
                        <td><span class="mono-id">@t.ReferenceNumber</span></td>
                        <td class="text-muted">@t.Description</td>
                        <td class="cell-num @(t.Debit > 0 ? "text-foreground" : "text-muted")">@(t.Debit > 0 ? $"₹{t.Debit:N2}" : "—")</td>
                        <td class="cell-num @(t.Credit > 0 ? "text-success" : "text-muted")">@(t.Credit > 0 ? $"₹{t.Credit:N2}" : "—")</td>
                        <td class="cell-num text-foreground fw-semibold">₹@t.RunningBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Period activity &amp; closing balance</td>
                    <td class="text-end tabular">₹@Model.TotalInvoiced.ToString("N2")</td>
                    <td class="text-end tabular">₹@((Model.TotalPaid + Model.TotalReturns).ToString("N2"))</td>
                    <td class="text-end tabular">₹@Model.ClosingBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="section-label mt-4 mb-3">Aging of outstanding balance</div>
    <div class="stat-strip">
        <div><div class="info-label">Current</div><div class="info-value @(Model.CurrentNotDue > 0 ? "age-current" : "")">₹@Model.CurrentNotDue.ToString("N2")</div></div>
        <div><div class="info-label">1–30 days</div><div class="info-value @(Model.Days1To30 > 0 ? "age-30" : "")">₹@Model.Days1To30.ToString("N2")</div></div>
        <div><div class="info-label">31–60 days</div><div class="info-value @(Model.Days31To60 > 0 ? "age-60" : "")">₹@Model.Days31To60.ToString("N2")</div></div>
        <div><div class="info-label">61–90 days</div><div class="info-value @(Model.Days61To90 > 0 ? "age-90" : "")">₹@Model.Days61To90.ToString("N2")</div></div>
        <div><div class="info-label">90+ days</div><div class="info-value @(Model.Days90Plus > 0 ? "age-90p" : "")">₹@Model.Days90Plus.ToString("N2")</div></div>
        <div class="is-total"><div class="info-label">Total due</div><div class="info-value">₹@Model.ClosingBalance.ToString("N2")</div></div>
    </div>
</div>
