@model AashanaFashion.Models.TrialBalanceViewModel
@{
    ViewData["Title"] = $"Trial Balance — As of {Model.AsOfDate:dd MMM yyyy}";
    var diff = Math.Abs(Model.TotalDebit - Model.TotalCredit);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Trial Balance</h1>
        <p class="page-sub">Debit and credit balances of every ledger account as of @Model.AsOfDate.ToString("dd MMM yyyy") · @Model.Company.CompanyName</p>
    </div>
    <div class="page-actions d-print-none">
        <a asp-action="ProfitAndLoss" class="btn btn-secondary"><i class="bi bi-graph-up-arrow"></i> Profit &amp; loss</a>
        <a asp-action="BalanceSheet" class="btn btn-secondary"><i class="bi bi-bank"></i> Balance sheet</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

@if (Model.IsBalanced)
{
    <div class="af-alert af-alert-success">
        <div class="alert-body"><span class="alert-title">Books are in balance</span>Total debits and credits both equal ₹@Model.TotalDebit.ToString("N2").</div>
    </div>
}
else
{
    <div class="af-alert af-alert-danger">
        <div class="alert-body"><span class="alert-title">Imbalance detected</span>Debits and credits differ by ₹@diff.ToString("N2"). Review recent journal entries.</div>
    </div>
}

<div class="table-card">
    <form method="get" asp-action="TrialBalance" class="table-toolbar align-end d-print-none">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="tbAsOf">As of date</label>
                <input type="date" id="tbAsOf" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Update</button>
        </div>
    </form>

    @if (!Model.Rows.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-diagram-3"></i></div>
            <div class="es-title">No accounts found</div>
            <p>Set up the chart of accounts to see a trial balance.</p>
            <a asp-action="ChartOfAccounts" class="btn btn-secondary">Chart of accounts</a>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 110px;">Code</th>
                        <th>Account</th>
                        <th>Type</th>
                        <th class="text-end">Period debit</th>
                        <th class="text-end">Period credit</th>
                        <th class="text-end">Closing debit</th>
                        <th class="text-end">Closing credit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a asp-action="GeneralLedger" asp-route-accountId="@r.AccountId" class="mono-id">@r.Code</a></td>
                            <td><a asp-action="GeneralLedger" asp-route-accountId="@r.AccountId" class="cell-title text-reset">@r.Name</a></td>
                            <td><span class="af-badge b-gray">@r.Type</span></td>
                            <td class="cell-num text-muted">@(r.PeriodDebit > 0 ? r.PeriodDebit.ToString("N2") : "—")</td>
                            <td class="cell-num text-muted">@(r.PeriodCredit > 0 ? r.PeriodCredit.ToString("N2") : "—")</td>
                            <td class="cell-num @(r.ClosingDebit > 0 ? "text-foreground fw-semibold" : "text-muted")">@(r.ClosingDebit > 0 ? $"₹{r.ClosingDebit:N2}" : "—")</td>
                            <td class="cell-num @(r.ClosingCredit > 0 ? "text-foreground fw-semibold" : "text-muted")">@(r.ClosingCredit > 0 ? $"₹{r.ClosingCredit:N2}" : "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end">Grand totals</td>
                        <td class="text-end tabular">₹@Model.Rows.Sum(r => r.PeriodDebit).ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.Rows.Sum(r => r.PeriodCredit).ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end tabular">₹@Model.TotalCredit.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Rows.Count</strong> accounts</span>
        </div>
    }
</div>
