@model AashanaFashion.Models.VendorStatementViewModel
@{
    ViewData["Title"] = $"Vendor Statement — {Model.Vendor.VendorName}";
}

<div class="page-header d-print-none">
    <div>
        <a asp-action="AgedPayables" class="page-back"><i class="bi bi-arrow-left"></i> Aged payables</a>
        <h1 class="page-title">Vendor statement</h1>
        <p class="page-sub">Purchase bills, payments and running liability for @Model.Vendor.VendorName.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print / save PDF</button>
    </div>
</div>

<div class="data-card doc-sheet">
    <div class="doc-head">
        <div>
            <div class="doc-company">@Model.Company.CompanyName</div>
            <div class="text-sm text-muted">@Model.Company.Address1 @Model.Company.Address2</div>
            <div class="text-sm text-muted">@Model.Company.City, @Model.Company.State – @Model.Company.PinCode</div>
            <div class="text-xs text-muted mt-1">GSTIN <span class="font-monospace text-foreground">@(Model.Company.Gstin ?? "Not set")</span></div>
        </div>
        <div class="doc-kind">
            <span class="micro-label">Vendor statement</span>
            <strong>@Model.FromDate.ToString("dd MMM yyyy") – @Model.ToDate.ToString("dd MMM yyyy")</strong>
        </div>
    </div>

    <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="panel-inset h-100 mb-0">
                    <span class="micro-label mb-1">Vendor / supplier</span>
                    <div class="text-foreground fw-semibold">@Model.Vendor.VendorName</div>
                    <div class="text-sm text-muted">@(Model.Vendor.Address ?? "Address on file")</div>
                    <div class="text-sm text-muted">@(Model.Vendor.City ?? "")@(string.IsNullOrEmpty(Model.Vendor.State) ? "" : ", " + Model.Vendor.State)</div>
                    <div class="kv-row mt-2"><span class="k">GSTIN</span><span class="v font-monospace">@(Model.Vendor.GstNumber ?? "URP")</span></div>
                    <div class="kv-row"><span class="k">Contact</span><span class="v">@(Model.Vendor.ContactPerson ?? "—") · @(Model.Vendor.Phone ?? "—")</span></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel-inset h-100 mb-0">
                    <span class="micro-label mb-1">Vendor bank account (for payout)</span>
                    <div class="kv-row"><span class="k">Bank</span><span class="v">@(Model.Vendor.BankName ?? "Not provided")</span></div>
                    <div class="kv-row"><span class="k">A/c number</span><span class="v font-monospace">@(Model.Vendor.AccountNumber ?? "Not provided")</span></div>
                    <div class="kv-row"><span class="k">IFSC</span><span class="v font-monospace">@(Model.Vendor.IfscCode ?? "Not provided")</span></div>
                </div>
            </div>
    </div>

    <div class="stat-strip mb-4">
        <div><div class="info-label">Opening payable</div><div class="info-value">₹@Model.OpeningBalance.ToString("N2")</div></div>
        <div><div class="info-label">Billed (+)</div><div class="info-value">₹@Model.TotalBilled.ToString("N2")</div></div>
        <div class="is-total"><div class="info-label">Net payable due</div><div class="info-value">₹@Model.ClosingBalance.ToString("N2")</div></div>
    </div>

    <div class="grid-card">
        <table class="af-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Document / PO</th>
                    <th>Description</th>
                    <th class="text-end">Billed</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance due</th>
                </tr>
            </thead>
            <tbody>
                <tr class="row-muted">
                    <td colspan="4" class="text-muted fw-medium">Opening balance as on @Model.FromDate.ToString("dd MMM yyyy")</td>
                    <td class="cell-num text-muted">—</td>
                    <td class="cell-num text-muted">—</td>
                    <td class="cell-num text-foreground fw-semibold">₹@Model.OpeningBalance.ToString("N2")</td>
                </tr>
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No bills or payments recorded in this period.</td></tr>
                }
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td class="text-nowrap text-muted tabular">@t.Date.ToString("dd MMM yyyy")</td>
                        <td><span class="af-badge @(t.Type == "Bill" ? "b-red" : "b-green")">@t.Type</span></td>
                        <td><span class="mono-id">@t.ReferenceNumber</span></td>
                        <td class="text-muted">@t.Description</td>
                        <td class="cell-num @(t.Debit > 0 ? "text-foreground" : "text-muted")">@(t.Debit > 0 ? $"₹{t.Debit:N2}" : "—")</td>
                        <td class="cell-num @(t.Credit > 0 ? "text-success" : "text-muted")">@(t.Credit > 0 ? $"₹{t.Credit:N2}" : "—")</td>
                        <td class="cell-num text-foreground fw-semibold">₹@t.RunningBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end">Period activity &amp; closing balance</td>
                    <td class="text-end tabular">₹@Model.TotalBilled.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.TotalPaid.ToString("N2")</td>
                    <td class="text-end tabular">₹@Model.ClosingBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

</div>
