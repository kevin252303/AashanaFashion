@model AashanaFashion.Models.SalesCommissionDashboardViewModel
@{
    ViewData["Title"] = "Salesman Commission Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">← Back to General Ledger</a>
        <h1 class="page-title mb-1">🤝 Salesman Commission Ledger</h1>
        <p class="page-sub mb-0 text-muted">Category-wise &amp; flexible commission tracking, accounting expense posting, and settlement payouts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Invoice" asp-action="Index" class="btn btn-outline-primary">
            🧾 Tax Invoices
        </a>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary">
            👥 Customer Master
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Statistics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Total Commission Incurred</span>
                <h3 class="fw-bold my-1 text-primary">₹@Model.TotalCommissionIncurred.ToString("N2")</h3>
                <small class="text-muted">Recorded as operating expense</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Paid Commissions</span>
                <h3 class="fw-bold my-1 text-success">₹@Model.TotalCommissionPaid.ToString("N2")</h3>
                <small class="text-muted">Settled to salesmen</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Pending / Payable</span>
                <h3 class="fw-bold my-1 text-danger">₹@Model.TotalCommissionPending.ToString("N2")</h3>
                <small class="text-muted">Outstanding commission liabilities</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <span class="text-muted small text-uppercase fw-semibold">Invoices with Commission</span>
                <h3 class="fw-bold my-1 text-dark">@Model.TotalInvoicesWithCommission</h3>
                <small class="text-muted">Total billing transactions</small>
            </div>
        </div>
    </div>
</div>

<!-- Salesman Summary Ranking -->
@if (Model.SalesmanSummaries.Any())
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title mb-0 fw-bold">📊 Salesman Summary Performance</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Salesman Name</th>
                            <th class="text-center">Invoices</th>
                            <th class="text-end">Attributed Sales (₹)</th>
                            <th class="text-end">Total Commission (₹)</th>
                            <th class="text-end">Paid (₹)</th>
                            <th class="text-end">Pending Due (₹)</th>
                            <th class="text-center">Settlement Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sm in Model.SalesmanSummaries)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <span class="badge bg-primary-subtle text-primary border me-1">👤</span>
                                    @sm.SalesmanName
                                </td>
                                <td class="text-center">@sm.InvoiceCount</td>
                                <td class="text-end">₹@sm.TotalSales.ToString("N2")</td>
                                <td class="text-end fw-semibold text-primary">₹@sm.TotalCommission.ToString("N2")</td>
                                <td class="text-end text-success">₹@sm.PaidCommission.ToString("N2")</td>
                                <td class="text-end fw-bold @(sm.PendingCommission > 0 ? "text-danger" : "text-muted")">
                                    ₹@sm.PendingCommission.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (sm.PendingCommission <= 0)
                                    {
                                        <span class="badge bg-success">Fully Cleared</span>
                                    }
                                    else if (sm.PaidCommission > 0)
                                    {
                                        <span class="badge bg-warning text-dark">Partially Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Commissions" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="salesman" class="form-control form-control-sm" placeholder="Search Salesman..." value="@ViewBag.Salesman" list="salesmenFilterList" />
                <datalist id="salesmenFilterList">
                    @if (ViewBag.SalesmenList != null)
                    {
                        foreach (var s in (List<string>)ViewBag.SalesmenList)
                        {
                            <option value="@s"></option>
                        }
                    }
                </datalist>
            </div>
            <div class="col-md-2">
                <input type="text" name="category" class="form-control form-control-sm" placeholder="Category / Target..." value="@ViewBag.Category" />
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate" placeholder="Start Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewBag.EndDate" placeholder="End Date" />
            </div>
            <div class="col-md-3 d-flex gap-2 align-items-center">
                <div class="form-check mb-0" style="white-space: nowrap;">
                    <input class="form-check-input" type="checkbox" name="pendingOnly" value="true" id="pendingOnlyCheck" @(ViewBag.PendingOnly == true ? "checked" : "") />
                    <label class="form-check-label small text-muted" for="pendingOnlyCheck">Pending Only</label>
                </div>
                <button type="submit" class="btn btn-sm btn-primary flex-fill">Filter</button>
                <a asp-action="Commissions" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Detailed Commission Entries Ledger -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">📑 Detailed Commission Entries</h5>
        <span class="badge bg-secondary-subtle text-secondary">@Model.RecentEntries.Count entries</span>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentEntries.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Invoice #</th>
                            <th>Customer</th>
                            <th>Salesman</th>
                            <th>Basis &amp; Target</th>
                            <th class="text-end">Sales Amount (₹)</th>
                            <th class="text-center">Rate</th>
                            <th class="text-end">Commission (₹)</th>
                            <th class="text-center">Status</th>
                            <th>Payment Info</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.RecentEntries)
                        {
                            bool isDeduction = entry.CommissionAmount < 0;
                            <tr class="@(isDeduction ? "table-warning bg-opacity-25" : "")">
                                <td>@entry.EntryDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (entry.TaxInvoice != null)
                                    {
                                        <a asp-controller="Invoice" asp-action="Details" asp-route-id="@entry.TaxInvoiceId" class="fw-bold text-decoration-none">
                                            @entry.TaxInvoice.InvoiceNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(entry.Customer?.CustomerName ?? "—")</td>
                                <td class="fw-bold">
                                    @entry.SalesmanName
                                    @if (isDeduction)
                                    {
                                        <span class="badge bg-danger ms-1" style="font-size:0.68rem;">↩️ Return</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @entry.Basis: @(entry.CategoryOrTarget ?? "All")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @(isDeduction ? $"-₹{Math.Abs(entry.SalesAmount):N2}" : $"₹{entry.SalesAmount:N2}")
                                </td>
                                <td class="text-center">
                                    @entry.CommissionRate@(entry.CalcType == AashanaFashion.Models.CommissionCalcType.FixedAmount ? " ₹/pc" : "%")
                                </td>
                                <td class="text-end fw-bold @(isDeduction ? "text-danger" : "text-primary")">
                                    @(isDeduction ? $"-₹{Math.Abs(entry.CommissionAmount):N2}" : $"₹{entry.CommissionAmount:N2}")
                                </td>
                                <td class="text-center">
                                    @if (entry.IsPaid)
                                    {
                                        <span class="badge bg-success">Settled</span>
                                    }
                                    else if (isDeduction)
                                    {
                                        <span class="badge bg-danger">Pending Clawback</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (entry.IsPaid)
                                    {
                                        <div class="small">
                                            <span class="text-muted">Ref:</span> <strong>@entry.PaymentReference</strong>
                                            @if (entry.PaidDate.HasValue)
                                            {
                                                <div class="text-muted" style="font-size:0.75rem;">@entry.PaidDate.Value.ToString("dd MMM yyyy")</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@(isDeduction ? "Offsets next payout" : "Unpaid")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!entry.IsPaid && !isDeduction)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 fw-semibold"
                                                onclick="openSettleModal(@entry.Id, '@entry.SalesmanName', @entry.CommissionAmount, '@(entry.TaxInvoice?.InvoiceNumber)')"
                                                title="Mark commission as settled / paid">
                                            💵 Settle
                                        </button>
                                    }
                                    else if (isDeduction)
                                    {
                                        <span class="text-danger small fw-semibold">Auto-offset</span>
                                    }
                                    else
                                    {
                                        <span class="text-success small fw-semibold">✓ Settled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <span class="fs-1 d-block mb-2">🤝</span>
                <h5>No commission entries found</h5>
                <p class="small mb-0">Commissions configured on customers are automatically calculated and recorded when tax invoices are generated.</p>
            </div>
        }
    </div>
</div>

<!-- Settle Commission Modal -->
<div class="modal fade" id="settleModal" tabindex="-1" aria-labelledby="settleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SettleCommission" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="settleEntryId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="settleModalLabel">💵 Settle Salesman Commission</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Salesman:</span>
                            <strong id="settleSalesmanName"></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Invoice Number:</span>
                            <strong id="settleInvoiceNumber"></strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Commission Due:</span>
                            <strong class="text-success fs-5" id="settleCommissionAmount"></strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment / Settlement Reference</label>
                        <input type="text" name="paymentReference" class="form-control" placeholder="e.g. UTR12345678, Cash Voucher #102, or GPay" required />
                        <small class="text-muted">A matching expense transaction will be logged in the General Ledger under 'Salesman Commission Paid'.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success fw-bold px-3">Confirm Payment &amp; Post to Ledger</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openSettleModal(id, salesman, amount, invoice) {
            document.getElementById('settleEntryId').value = id;
            document.getElementById('settleSalesmanName').textContent = salesman;
            document.getElementById('settleInvoiceNumber').textContent = invoice || '—';
            document.getElementById('settleCommissionAmount').textContent = '₹' + parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
            new bootstrap.Modal(document.getElementById('settleModal')).show();
        }
    </script>
}
