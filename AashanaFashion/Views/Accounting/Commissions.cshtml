@model AashanaFashion.Models.SalesCommissionDashboardViewModel
@{
    ViewData["Title"] = "Salesman Commission";
    var salesmen = ViewBag.SalesmenList as List<string> ?? new List<string>();
    bool pendingOnly = ViewBag.PendingOnly == true;
    bool filtered = !string.IsNullOrEmpty(ViewBag.Salesman as string) || !string.IsNullOrEmpty(ViewBag.Category as string)
                    || !string.IsNullOrEmpty(ViewBag.StartDate as string) || !string.IsNullOrEmpty(ViewBag.EndDate as string) || pendingOnly;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> General ledger</a>
        <h1 class="page-title">Salesman Commission</h1>
        <p class="page-sub">Category-wise commission tracking, expense posting and settlement payouts.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary"><i class="bi bi-people"></i> Customers</a>
        <a asp-controller="Invoice" asp-action="Index" class="btn btn-secondary"><i class="bi bi-receipt"></i> Tax invoices</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Commission incurred</div>
        <div class="metric-value">₹@Model.TotalCommissionIncurred.ToString("N2")</div>
        <div class="metric-meta">recorded as operating expense</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Paid</div>
        <div class="metric-value">₹@Model.TotalCommissionPaid.ToString("N2")</div>
        <div class="metric-meta success">settled to salesmen</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Pending / payable</div>
        <div class="metric-value">₹@Model.TotalCommissionPending.ToString("N2")</div>
        <div class="metric-meta danger">outstanding liabilities</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Invoices with commission</div>
        <div class="metric-value">@Model.TotalInvoicesWithCommission</div>
    </div>
</div>

@if (Model.SalesmanSummaries.Any())
{
    <div class="table-card mb-4">
        <div class="data-card-header">
            <div class="data-card-title">Salesman performance</div>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Salesman</th>
                        <th class="text-end">Invoices</th>
                        <th class="text-end">Attributed sales</th>
                        <th class="text-end">Commission</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Pending</th>
                        <th>Settlement</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sm in Model.SalesmanSummaries)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="av-sm">@(string.IsNullOrEmpty(sm.SalesmanName) ? "?" : sm.SalesmanName.Substring(0, 1).ToUpper())</span>
                                    <span class="cell-title">@sm.SalesmanName</span>
                                </div>
                            </td>
                            <td class="cell-num">@sm.InvoiceCount</td>
                            <td class="cell-num">₹@sm.TotalSales.ToString("N2")</td>
                            <td class="cell-num text-foreground fw-semibold">₹@sm.TotalCommission.ToString("N2")</td>
                            <td class="cell-num text-success">₹@sm.PaidCommission.ToString("N2")</td>
                            <td class="cell-num @(sm.PendingCommission > 0 ? "text-danger fw-semibold" : "text-muted")">₹@sm.PendingCommission.ToString("N2")</td>
                            <td>
                                @if (sm.PendingCommission <= 0)
                                {
                                    <span class="af-badge b-green">Cleared</span>
                                }
                                else if (sm.PaidCommission > 0)
                                {
                                    <span class="af-badge b-yellow">Partially paid</span>
                                }
                                else
                                {
                                    <span class="af-badge b-red">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="table-card">
    <form method="get" asp-action="Commissions" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="cmSalesman">Salesman</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="cmSalesman" name="salesman" class="af-input" placeholder="Search salesman…" value="@ViewBag.Salesman" list="salesmenFilterList" />
                </div>
                <datalist id="salesmenFilterList">
                    @foreach (var s in salesmen)
                    {
                        <option value="@s"></option>
                    }
                </datalist>
            </div>
            <div class="toolbar-field">
                <label for="cmCategory">Category / target</label>
                <input type="text" id="cmCategory" name="category" class="af-input" placeholder="Any" value="@ViewBag.Category" />
            </div>
            <div class="toolbar-field">
                <label for="cmFrom">From</label>
                <input type="date" id="cmFrom" name="startDate" class="af-input" value="@ViewBag.StartDate" />
            </div>
            <div class="toolbar-field">
                <label for="cmTo">To</label>
                <input type="date" id="cmTo" name="endDate" class="af-input" value="@ViewBag.EndDate" />
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" name="pendingOnly" value="true" id="pendingOnlyCheck" @(pendingOnly ? "checked" : "") />
                <label class="form-check-label" for="pendingOnlyCheck">Pending only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Commissions" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.RecentEntries.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Salesman</th>
                        <th>Basis / target</th>
                        <th class="text-end">Sales</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Commission</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentEntries)
                    {
                        bool isDeduction = entry.CommissionAmount < 0;
                        <tr class="@(isDeduction ? "row-warning" : "")">
                            <td class="text-nowrap tabular">@entry.EntryDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (entry.TaxInvoice != null)
                                {
                                    <a asp-controller="Invoice" asp-action="Details" asp-route-id="@entry.TaxInvoiceId" class="fw-medium">@entry.TaxInvoice.InvoiceNumber</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@(entry.Customer?.CustomerName ?? "—")</td>
                            <td>
                                <span class="cell-title">@entry.SalesmanName</span>
                                @if (isDeduction)
                                {
                                    <span class="cell-sub text-danger">Return deduction</span>
                                }
                            </td>
                            <td><span class="af-badge b-gray">@entry.Basis.Humanize(): @(entry.CategoryOrTarget ?? "All")</span></td>
                            <td class="cell-num">@(isDeduction ? $"−₹{Math.Abs(entry.SalesAmount):N2}" : $"₹{entry.SalesAmount:N2}")</td>
                            <td class="cell-num">@entry.CommissionRate@(entry.CalcType == AashanaFashion.Models.CommissionCalcType.FixedAmount ? " ₹/pc" : "%")</td>
                            <td class="cell-num fw-semibold @(isDeduction ? "text-danger" : "text-foreground")">@(isDeduction ? $"−₹{Math.Abs(entry.CommissionAmount):N2}" : $"₹{entry.CommissionAmount:N2}")</td>
                            <td>
                                @if (entry.IsPaid)
                                {
                                    <span class="af-badge b-green">Settled</span>
                                }
                                else if (isDeduction)
                                {
                                    <span class="af-badge b-red">Pending clawback</span>
                                }
                                else
                                {
                                    <span class="af-badge b-yellow">Pending</span>
                                }
                            </td>
                            <td>
                                @if (entry.IsPaid)
                                {
                                    <span class="font-monospace text-xs text-foreground">@entry.PaymentReference</span>
                                    @if (entry.PaidDate.HasValue)
                                    {
                                        <span class="cell-sub">@entry.PaidDate.Value.ToString("dd MMM yyyy")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted text-xs">@(isDeduction ? "Offsets next payout" : "Unpaid")</span>
                                }
                            </td>
                            <td class="cell-actions">
                                @if (!entry.IsPaid && !isDeduction)
                                {
                                    <button type="button" class="btn btn-sm btn-secondary btn-settle"
                                            data-id="@entry.Id"
                                            data-salesman="@entry.SalesmanName"
                                            data-amount="@entry.CommissionAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-invoice="@(entry.TaxInvoice?.InvoiceNumber)"
                                            title="Mark commission as settled">
                                        <i class="bi bi-cash"></i> Settle
                                    </button>
                                }
                                else if (isDeduction)
                                {
                                    <span class="text-xs text-muted">Auto-offset</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle text-success" title="Settled" aria-label="Settled"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.RecentEntries.Count</strong> @(Model.RecentEntries.Count == 1 ? "entry" : "entries")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-percent")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No commission entries yet")</div>
            <p>@(filtered ? "No entries match your filters." : "Commissions configured on customers are recorded automatically when tax invoices are generated.")</p>
            @if (filtered)
            {
                <a asp-action="Commissions" class="btn btn-secondary">Clear filters</a>
            }
        </div>
    }
</div>

<div class="modal fade" id="settleModal" tabindex="-1" aria-labelledby="settleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SettleCommission" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="settleEntryId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="settleModalLabel">Settle commission</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="panel-inset">
                        <div class="kv-row"><span class="k">Salesman</span><span class="v" id="settleSalesmanName"></span></div>
                        <div class="kv-row"><span class="k">Invoice</span><span class="v font-monospace" id="settleInvoiceNumber"></span></div>
                        <div class="kv-row"><span class="k">Commission due</span><span class="v text-success" id="settleCommissionAmount"></span></div>
                    </div>
                    <label class="form-label" for="settleRef">Payment reference <span class="req">*</span></label>
                    <input type="text" id="settleRef" name="paymentReference" class="af-input" placeholder="e.g. UTR12345678, Cash Voucher #102, GPay" required />
                    <div class="form-text">A matching expense is logged in the general ledger under “Salesman Commission Paid”.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Confirm &amp; post to ledger</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.btn-settle').on('click', function () {
            var b = $(this);
            $('#settleEntryId').val(b.data('id'));
            $('#settleSalesmanName').text(b.data('salesman'));
            $('#settleInvoiceNumber').text(b.data('invoice') || '—');
            $('#settleCommissionAmount').text('₹' + parseFloat(b.data('amount')).toLocaleString('en-IN', { minimumFractionDigits: 2 }));
            bootstrap.Modal.getOrCreateInstance(document.getElementById('settleModal')).show();
        });
    </script>
}
