@model AashanaFashion.Models.ThreeWayMatchingViewModel
@{
    ViewData["Title"] = "3-Way Matching for Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">🔍 3-Way Purchase Matching &amp; Verification</h1>
        <p class="page-sub mb-0 text-muted">
            Automated internal control cross-verifying <strong>1. Purchase Order</strong> &rarr; <strong>2. Factory Goods Receipt (GRN)</strong> &rarr; <strong>3. Vendor Bill</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AgedPayables" class="btn btn-outline-danger">
            🏢 Vendor Payables
        </a>
        <a asp-controller="Purchase" asp-action="Create" class="btn btn-primary">
            + New Purchase Order
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-3">
                <span class="text-muted small text-uppercase fw-semibold d-block">Total Purchase Orders</span>
                <h3 class="fw-bold my-1 text-dark">@Model.TotalOrders</h3>
                <small class="text-muted">Active purchase commitments</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-success-subtle border-success">
            <div class="card-body p-3">
                <span class="text-success small text-uppercase fw-bold d-block">Ready for Payment</span>
                <h3 class="fw-bold my-1 text-success">@Model.PerfectMatchCount</h3>
                <small class="text-success">Goods received &amp; verified</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-warning-subtle border-warning">
            <div class="card-body p-3">
                <span class="text-warning small text-uppercase fw-bold d-block">Discrepancies Detected</span>
                <h3 class="fw-bold my-1 text-warning">@Model.DiscrepancyCount</h3>
                <small class="text-dark">Short delivery or price variance</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-info-subtle border-info">
            <div class="card-body p-3">
                <span class="text-info small text-uppercase fw-bold d-block">Pending Delivery</span>
                <h3 class="fw-bold my-1 text-info">@Model.AwaitingDeliveryCount</h3>
                <small class="text-dark">Fabric in transit</small>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-2 d-flex gap-2 flex-wrap align-items-center">
        <span class="small fw-bold text-secondary ps-2">Filter by Status:</span>
        <a asp-action="ThreeWayMatching" class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedStatus) || Model.SelectedStatus == "All" ? "btn-dark" : "btn-light border")">All Orders</a>
        <a asp-action="ThreeWayMatching" asp-route-status="Ready for Payment" class="btn btn-sm @(Model.SelectedStatus == "Ready for Payment" ? "btn-success" : "btn-light border")">✅ Ready for Payment</a>
        <a asp-action="ThreeWayMatching" asp-route-status="Quantity Discrepancy" class="btn btn-sm @(Model.SelectedStatus == "Quantity Discrepancy" ? "btn-warning" : "btn-light border")">⚠️ Quantity Discrepancy</a>
        <a asp-action="ThreeWayMatching" asp-route-status="Pending Delivery" class="btn btn-sm @(Model.SelectedStatus == "Pending Delivery" ? "btn-info" : "btn-light border")">⏳ Pending Delivery</a>
        <a asp-action="ThreeWayMatching" asp-route-status="Awaiting Vendor Bill" class="btn btn-sm @(Model.SelectedStatus == "Awaiting Vendor Bill" ? "btn-secondary" : "btn-light border")">📄 Awaiting Bill</a>
    </div>
</div>

<!-- 3-Way Matching Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">3-Way Verification Matrix (@Model.Items.Count orders)</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>PO # &amp; Date</th>
                    <th>Vendor / Supplier</th>
                    <th class="text-center" style="width: 140px;">1. Ordered Qty</th>
                    <th class="text-center" style="width: 140px;">2. Received Qty</th>
                    <th class="text-end" style="width: 130px;">PO Amount</th>
                    <th class="text-end" style="width: 130px;">3. Bill Amount</th>
                    <th class="text-center" style="width: 180px;">3-Way Match Status</th>
                    <th class="text-center" style="width: 130px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            No purchase orders found matching the selected filter.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Purchase" asp-action="Details" asp-route-id="@item.PurchaseOrderId" class="font-monospace fw-bold text-decoration-none">
                                    @item.PoNumber
                                </a>
                                <small class="d-block text-muted">@item.OrderDate.ToString("dd-MMM-yyyy")</small>
                            </td>
                            <td>
                                <strong class="text-dark">@item.VendorName</strong>
                                @if (!string.IsNullOrEmpty(item.VendorGstin))
                                {
                                    <small class="d-block font-monospace text-muted" style="font-size: 0.72rem;">@item.VendorGstin</small>
                                }
                            </td>
                            <td class="text-center font-monospace fw-semibold">
                                @item.OrderedQuantity.ToString("N0")
                            </td>
                            <td class="text-center font-monospace">
                                @if (item.ReceivedQuantity >= item.OrderedQuantity && item.OrderedQuantity > 0)
                                {
                                    <span class="badge bg-success-subtle text-success">@item.ReceivedQuantity.ToString("N0") (100%)</span>
                                }
                                else if (item.ReceivedQuantity > 0)
                                {
                                    <span class="badge bg-warning-subtle text-dark">@item.ReceivedQuantity.ToString("N0") (Short)</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">0 (Pending)</span>
                                }
                            </td>
                            <td class="text-end font-monospace text-muted">
                                ₹@item.PoAmount.ToString("N2")
                            </td>
                            <td class="text-end font-monospace fw-bold">
                                @if (item.HasBill)
                                {
                                    <span>₹@item.BilledAmount.ToString("N2")</span>
                                    <small class="d-block text-muted font-monospace" style="font-size: 0.7rem;">Bill: @item.BillNumber</small>
                                }
                                else
                                {
                                    <span class="text-muted">Not Entered</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.OverallMatchStatus == "Ready for Payment")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        ✅ Ready for Payment
                                    </span>
                                }
                                else if (item.OverallMatchStatus == "Quantity Discrepancy")
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">
                                        ⚠️ Short Delivery
                                    </span>
                                }
                                else if (item.OverallMatchStatus == "Pending Delivery")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                        ⏳ Pending Delivery
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        📄 Awaiting Bill
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Purchase" asp-action="Details" asp-route-id="@item.PurchaseOrderId" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;">
                                    Inspect PO 🔍
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Educational / Process Guide -->
<div class="card border-0 shadow-sm rounded-3 mt-4">
    <div class="card-body p-3">
        <h6 class="fw-bold mb-2 small text-uppercase text-secondary">💡 How 3-Way Matching Protects Manufacturing Profitability:</h6>
        <div class="row g-3 small text-muted">
            <div class="col-md-4">
                <strong>1. Purchase Order (PO)</strong><br />
                Locks in agreed unit prices and ordered quantities of fabrics, laces, dyes, and trims with the vendor.
            </div>
            <div class="col-md-4">
                <strong>2. Goods Receipt &amp; QC</strong><br />
                Records the actual meters / pieces that arrived at the factory and passed quality inspection before being stored in inventory.
            </div>
            <div class="col-md-4">
                <strong>3. Vendor Bill Verification</strong><br />
                Ensures finance only approves vendor payments when the invoice quantities match what was physically received and verified.
            </div>
        </div>
    </div>
</div>
