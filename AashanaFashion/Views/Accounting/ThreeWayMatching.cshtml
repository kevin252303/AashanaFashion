@model AashanaFashion.Models.ThreeWayMatchingViewModel
@{
    ViewData["Title"] = "3-Way Matching";
    string sel = string.IsNullOrEmpty(Model.SelectedStatus) ? "All" : Model.SelectedStatus;
    var filters = new[] { ("All", "All orders"), ("Ready for Payment", "Ready for payment"), ("Quantity Discrepancy", "Quantity discrepancy"), ("Pending Delivery", "Pending delivery"), ("Awaiting Vendor Bill", "Awaiting bill") };
}

<div class="page-header">
    <div>
        <h1 class="page-title">3-Way Matching</h1>
        <p class="page-sub">Cross-checks each purchase order against the goods received (GRN) and the vendor bill before payment.</p>
    </div>
    <div class="page-actions">
        <a asp-action="AgedPayables" class="btn btn-secondary"><i class="bi bi-building"></i> Aged payables</a>
        <a asp-controller="Purchase" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New purchase order</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Purchase orders</div>
        <div class="metric-value">@Model.TotalOrders</div>
        <div class="metric-meta">active purchase commitments</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Ready for payment</div>
        <div class="metric-value">@Model.PerfectMatchCount</div>
        <div class="metric-meta success">received &amp; verified</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Discrepancies</div>
        <div class="metric-value">@Model.DiscrepancyCount</div>
        <div class="metric-meta warning">short delivery or price variance</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Pending delivery</div>
        <div class="metric-value">@Model.AwaitingDeliveryCount</div>
        <div class="metric-meta info">fabric in transit</div>
    </div>
</div>

<div class="table-card mb-4">
    <div class="filter-bar">
        <div class="segmented" aria-label="Filter by match status">
            @foreach (var (value, label) in filters)
            {
                if (value == "All")
                {
                    <a asp-action="ThreeWayMatching" class="segment @(sel == "All" ? "active" : "")">@label</a>
                }
                else
                {
                    <a asp-action="ThreeWayMatching" asp-route-status="@value" class="segment @(sel == value ? "active" : "")">@label</a>
                }
            }
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-check2-all"></i></div>
            <div class="es-title">No purchase orders</div>
            <p>No purchase orders match the selected filter.</p>
            @if (sel != "All")
            {
                <a asp-action="ThreeWayMatching" class="btn btn-secondary">Show all orders</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Purchase order</th>
                        <th>Vendor</th>
                        <th class="text-end">1. Ordered</th>
                        <th>2. Received</th>
                        <th class="text-end">PO amount</th>
                        <th class="text-end">3. Bill amount</th>
                        <th>Match status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.OverallMatchStatus == "Quantity Discrepancy" ? "row-warning" : "")">
                            <td>
                                <a asp-controller="Purchase" asp-action="Details" asp-route-id="@item.PurchaseOrderId" class="cell-title">@item.PoNumber</a>
                                <span class="cell-sub">@item.OrderDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <span class="text-foreground fw-medium">@item.VendorName</span>
                                @if (!string.IsNullOrEmpty(item.VendorGstin))
                                {
                                    <span class="cell-sub font-monospace">@item.VendorGstin</span>
                                }
                            </td>
                            <td class="cell-num">@item.OrderedQuantity.ToString("N0")</td>
                            <td>
                                @if (item.ReceivedQuantity >= item.OrderedQuantity && item.OrderedQuantity > 0)
                                {
                                    <span class="af-badge b-green">@item.ReceivedQuantity.ToString("N0") · 100%</span>
                                }
                                else if (item.ReceivedQuantity > 0)
                                {
                                    <span class="af-badge b-yellow">@item.ReceivedQuantity.ToString("N0") · short</span>
                                }
                                else
                                {
                                    <span class="af-badge b-gray">0 · pending</span>
                                }
                            </td>
                            <td class="cell-num text-muted">₹@item.PoAmount.ToString("N2")</td>
                            <td class="cell-num">
                                @if (item.HasBill)
                                {
                                    <span class="text-foreground fw-semibold">₹@item.BilledAmount.ToString("N2")</span>
                                    <span class="cell-sub font-monospace">Bill @item.BillNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not entered</span>
                                }
                            </td>
                            <td>
                                @switch (item.OverallMatchStatus)
                                {
                                    case "Ready for Payment":
                                        <span class="af-badge b-green">Ready for payment</span>
                                        break;
                                    case "Quantity Discrepancy":
                                        <span class="af-badge b-yellow">Short delivery</span>
                                        break;
                                    case "Pending Delivery":
                                        <span class="af-badge b-blue">Pending delivery</span>
                                        break;
                                    default:
                                        <span class="af-badge b-gray">Awaiting bill</span>
                                        break;
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-controller="Purchase" asp-action="Details" asp-route-id="@item.PurchaseOrderId" class="row-action" title="Inspect purchase order" aria-label="Inspect @item.PoNumber"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Items.Count</strong> @(Model.Items.Count == 1 ? "order" : "orders")</span>
        </div>
    }
</div>

<div class="data-card">
    <div class="data-card-header">
        <div class="data-card-title">How 3-way matching protects margins</div>
    </div>
    <div class="data-card-body">
        <div class="flow mb-4">
            <span class="flow-step done"><span class="flow-num">1</span> Purchase order</span>
            <i class="bi bi-chevron-right flow-sep"></i>
            <span class="flow-step done"><span class="flow-num">2</span> Goods receipt &amp; QC</span>
            <i class="bi bi-chevron-right flow-sep"></i>
            <span class="flow-step done"><span class="flow-num">3</span> Vendor bill</span>
            <i class="bi bi-chevron-right flow-sep"></i>
            <span class="flow-step current"><span class="flow-num"><i class="bi bi-cash"></i></span> Payment</span>
        </div>
        <div class="row g-3 text-sm">
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1">1. Purchase order</div>
                <div class="text-muted">Locks in agreed unit prices and quantities of fabrics, laces, dyes and trims.</div>
            </div>
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1">2. Goods receipt &amp; QC</div>
                <div class="text-muted">Records the metres or pieces that actually arrived and passed inspection.</div>
            </div>
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1">3. Vendor bill verification</div>
                <div class="text-muted">Finance approves payment only when billed quantities match what was received.</div>
            </div>
        </div>
    </div>
</div>
