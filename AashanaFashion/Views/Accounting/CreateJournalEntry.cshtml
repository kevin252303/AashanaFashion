@model AashanaFashion.Models.CreateJournalEntryViewModel
@{
    ViewData["Title"] = "New Journal Entry";
    var journals = ViewBag.Journals as List<AashanaFashion.Models.Journal> ?? new();
    var accounts = ViewBag.Accounts as List<AashanaFashion.Models.Account> ?? new();
    var customers = ViewBag.Customers as List<AashanaFashion.Models.Customer> ?? new();
}

<div class="page-header">
    <div>
        <a asp-action="JournalEntries" class="page-back"><i class="bi bi-arrow-left"></i> Journal entries</a>
        <h1 class="page-title">New journal entry</h1>
        <p class="page-sub">Post a balanced double-entry voucher with custom debit and credit lines.</p>
    </div>
</div>

<form method="post" asp-action="CreateJournalEntry" id="jeForm">
    @Html.AntiForgeryToken()

    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Voucher details</div>
                <div class="data-card-sub">Fields marked <span class="req">*</span> are required.</div>
            </div>
        </div>
        <div class="data-card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" for="jeJournal">Journal <span class="req">*</span></label>
                    <select id="jeJournal" name="JournalId" class="af-input af-select" required>
                        @foreach (var j in journals)
                        {
                            <option value="@j.Id">@j.Name (@j.Code)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="jeDate">Accounting date <span class="req">*</span></label>
                    <input type="date" id="jeDate" name="Date" class="af-input" value="@Model.Date.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="jeRef">Reference / document no.</label>
                    <input type="text" id="jeRef" name="Reference" class="af-input font-monospace" placeholder="e.g. bank ref, cheque no., tax voucher" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="jeNarr">Narration <span class="req">*</span></label>
                    <input type="text" id="jeNarr" name="Narration" class="af-input" placeholder="Explain the transaction…" required />
                </div>
            </div>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="data-card-header">
            <div>
                <div class="data-card-title">Journal lines</div>
                <div class="data-card-sub">Total debits must equal total credits. At least two lines.</div>
            </div>
            <button type="button" class="btn btn-sm btn-secondary" id="addRowBtn"><i class="bi bi-plus-lg"></i> Add line</button>
        </div>
        <div class="table-scroll">
            <table class="af-table table-edit" id="linesTable" style="min-width: 900px;">
                <thead>
                    <tr>
                        <th style="width: 32%;">Account <span class="req">*</span></th>
                        <th style="width: 20%;">Partner</th>
                        <th style="width: 20%;">Description</th>
                        <th style="width: 13%;" class="text-end">Debit (₹)</th>
                        <th style="width: 13%;" class="text-end">Credit (₹)</th>
                        <th style="width: 44px;"></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                    <tr class="line-row">
                        <td>
                            <select name="Lines[0].AccountId" class="af-input af-input-sm af-select account-select" required aria-label="Account">
                                <option value="">Select account…</option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Id">@a.Code — @a.Name (@a.Type)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Lines[0].CustomerId" class="af-input af-input-sm af-select" aria-label="Partner">
                                <option value="">None</option>
                                <optgroup label="Customers">
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.CustomerName</option>
                                    }
                                </optgroup>
                            </select>
                        </td>
                        <td><input type="text" name="Lines[0].Description" class="af-input af-input-sm" placeholder="Line note…" aria-label="Description" /></td>
                        <td><input type="number" step="0.01" min="0" name="Lines[0].Debit" class="af-input af-input-sm text-end debit-input" value="0.00" aria-label="Debit" /></td>
                        <td><input type="number" step="0.01" min="0" name="Lines[0].Credit" class="af-input af-input-sm text-end credit-input" value="0.00" aria-label="Credit" /></td>
                        <td class="text-center"><button type="button" class="row-action danger remove-row" title="Remove line" aria-label="Remove line"><i class="bi bi-trash"></i></button></td>
                    </tr>
                    <tr class="line-row">
                        <td>
                            <select name="Lines[1].AccountId" class="af-input af-input-sm af-select account-select" required aria-label="Account">
                                <option value="">Select account…</option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Id">@a.Code — @a.Name (@a.Type)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Lines[1].CustomerId" class="af-input af-input-sm af-select" aria-label="Partner">
                                <option value="">None</option>
                                <optgroup label="Customers">
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.CustomerName</option>
                                    }
                                </optgroup>
                            </select>
                        </td>
                        <td><input type="text" name="Lines[1].Description" class="af-input af-input-sm" placeholder="Line note…" aria-label="Description" /></td>
                        <td><input type="number" step="0.01" min="0" name="Lines[1].Debit" class="af-input af-input-sm text-end debit-input" value="0.00" aria-label="Debit" /></td>
                        <td><input type="number" step="0.01" min="0" name="Lines[1].Credit" class="af-input af-input-sm text-end credit-input" value="0.00" aria-label="Credit" /></td>
                        <td class="text-center"><button type="button" class="row-action danger remove-row" title="Remove line" aria-label="Remove line"><i class="bi bi-trash"></i></button></td>
                    </tr>
                </tbody>
                <tfoot class="totals-foot">
                    <tr>
                        <td colspan="3" class="text-end">Total</td>
                        <td class="v" id="totalDebitCell">₹0.00</td>
                        <td class="v" id="totalCreditCell">₹0.00</td>
                        <td></td>
                    </tr>
                    <tr class="grand">
                        <td colspan="3" class="text-end">Difference</td>
                        <td colspan="2" class="text-end" id="diffCell"><span class="af-badge b-gray">₹0.00</span></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="JournalEntries" class="btn btn-secondary">Cancel</a>
        <button type="submit" id="submitBtn" class="btn btn-primary" disabled><i class="bi bi-check2"></i> Post journal entry</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var rowIndex = 2;
            var tbody = document.getElementById('linesBody');
            var submitBtn = document.getElementById('submitBtn');
            var diffCell = document.getElementById('diffCell');

            function fmt(n) { return '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

            function badge(cls, text) {
                var span = document.createElement('span');
                span.className = 'af-badge ' + cls;
                span.textContent = text;
                diffCell.replaceChildren(span);
            }

            function calcTotals() {
                var totalDr = 0, totalCr = 0;
                document.querySelectorAll('.debit-input').forEach(function (i) { totalDr += parseFloat(i.value) || 0; });
                document.querySelectorAll('.credit-input').forEach(function (i) { totalCr += parseFloat(i.value) || 0; });
                document.getElementById('totalDebitCell').textContent = fmt(totalDr);
                document.getElementById('totalCreditCell').textContent = fmt(totalCr);

                var diff = Math.abs(totalDr - totalCr);
                if (diff < 0.01 && totalDr > 0) {
                    badge('b-green', 'Balanced');
                    submitBtn.disabled = false;
                } else {
                    badge('b-red', 'Out of balance · ' + fmt(diff));
                    submitBtn.disabled = true;
                }
            }

            tbody.addEventListener('input', function (e) {
                if (e.target.classList.contains('debit-input') || e.target.classList.contains('credit-input')) calcTotals();
            });

            tbody.addEventListener('click', function (e) {
                var btn = e.target.closest('.remove-row');
                if (!btn) return;
                if (tbody.querySelectorAll('.line-row').length <= 2) {
                    window.afToast && afToast('A double-entry voucher needs at least two lines.', 'warning');
                    return;
                }
                btn.closest('tr').remove();
                calcTotals();
            });

            document.getElementById('addRowBtn').addEventListener('click', function () {
                var newRow = tbody.querySelector('.line-row').cloneNode(true);
                newRow.querySelectorAll('input, select').forEach(function (el) {
                    var name = el.getAttribute('name');
                    if (name) el.setAttribute('name', name.replace(/\[\d+\]/, '[' + rowIndex + ']'));
                    if (el.classList.contains('debit-input') || el.classList.contains('credit-input')) el.value = '0.00';
                    else if (el.tagName === 'INPUT') el.value = '';
                    else if (el.tagName === 'SELECT') el.selectedIndex = 0;
                });
                tbody.appendChild(newRow);
                rowIndex++;
                calcTotals();
            });

            calcTotals();
        })();
    </script>
}
