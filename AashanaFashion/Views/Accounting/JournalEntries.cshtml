@model IEnumerable<AashanaFashion.Models.JournalEntry>
@{
    ViewData["Title"] = "Journal Entries";
    var journals = ViewBag.Journals as List<AashanaFashion.Models.Journal> ?? new();
    int? selectedJournalId = ViewBag.SelectedJournalId;
    bool filtered = selectedJournalId.HasValue || !string.IsNullOrEmpty(ViewBag.StartDate as string) || !string.IsNullOrEmpty(ViewBag.EndDate as string);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Journal Entries</h1>
        <p class="page-sub">Balanced debit and credit vouchers across all journals.</p>
    </div>
    <div class="page-actions">
        <a asp-action="ChartOfAccounts" class="btn btn-secondary"><i class="bi bi-diagram-3"></i> Chart of accounts</a>
        <form method="post" asp-action="SyncHistoricalEntries" onsubmit="return confirm('Create double-entry journal entries for existing sales invoices, receipts and purchase bills?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary"><i class="bi bi-arrow-repeat"></i> Sync invoices &amp; bills</button>
        </form>
        <a asp-action="CreateJournalEntry" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New journal entry</a>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Vouchers</div>
        <div class="metric-value">@Model.Count()</div>
        <div class="metric-meta">in the selected range</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total volume</div>
        <div class="metric-value">₹@Model.Sum(e => e.TotalAmount).ToString("N2")</div>
        <div class="metric-meta">sum of voucher amounts</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="JournalEntries" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="jeJournal">Journal</label>
                <select id="jeJournal" name="journalId" class="af-input af-select" onchange="this.form.submit()">
                    <option value="">All journals</option>
                    @foreach (var j in journals)
                    {
                        <option value="@j.Id" selected="@(j.Id == selectedJournalId)">@j.Name (@j.Code)</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="jeFrom">From</label>
                <input type="date" id="jeFrom" name="startDate" value="@ViewBag.StartDate" class="af-input" />
            </div>
            <div class="toolbar-field">
                <label for="jeTo">To</label>
                <input type="date" id="jeTo" name="endDate" value="@ViewBag.EndDate" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="JournalEntries" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-journal-text")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No journal entries yet")</div>
            <p>@(filtered ? "No vouchers match your filters." : "Use “Sync invoices & bills” to create entries for past sales and purchases, or post one manually.")</p>
            @if (filtered)
            {
                <a asp-action="JournalEntries" class="btn btn-secondary">Clear filters</a>
            }
            else
            {
                <a asp-action="CreateJournalEntry" class="btn btn-secondary">New journal entry</a>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Entry</th>
                        <th>Date</th>
                        <th>Journal</th>
                        <th>Reference</th>
                        <th>Narration</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td><a asp-action="JournalEntryDetails" asp-route-id="@entry.Id" class="cell-title font-monospace">@entry.EntryNumber</a></td>
                            <td class="text-nowrap text-muted tabular">@entry.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="af-badge @JournalBadge(entry.Journal?.Type)">@(entry.Journal?.Name ?? "Journal")</span></td>
                            <td>
                                @if (string.IsNullOrEmpty(entry.Reference))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="mono-id">@entry.Reference</span>
                                }
                            </td>
                            <td class="text-muted text-truncate" style="max-width: 320px;" title="@entry.Narration">@entry.Narration</td>
                            <td class="cell-num text-foreground fw-semibold">₹@entry.TotalAmount.ToString("N2")</td>
                            <td><span class="af-badge @StatusBadge(entry.Status)">@entry.Status.Humanize()</span></td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="JournalEntryDetails" asp-route-id="@entry.Id" class="row-action" title="View debit / credit lines" aria-label="View @entry.EntryNumber"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "entry" : "entries")</span>
        </div>
    }
</div>

@functions {
    string JournalBadge(AashanaFashion.Models.JournalType? t) => t switch
    {
        AashanaFashion.Models.JournalType.Sales => "b-blue",
        AashanaFashion.Models.JournalType.Purchase => "b-yellow",
        AashanaFashion.Models.JournalType.Bank => "b-cyan",
        AashanaFashion.Models.JournalType.Cash => "b-green",
        _ => "b-gray"
    };
    string StatusBadge(AashanaFashion.Models.JournalEntryStatus s) => s switch
    {
        AashanaFashion.Models.JournalEntryStatus.Posted => "b-green",
        AashanaFashion.Models.JournalEntryStatus.Draft => "b-yellow",
        _ => "b-gray"
    };
}
