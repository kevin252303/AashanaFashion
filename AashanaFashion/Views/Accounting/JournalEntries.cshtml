@model IEnumerable<AashanaFashion.Models.JournalEntry>
@{
    ViewData["Title"] = "Journal Entries (Double-Entry Ledger)";
    var journals = ViewBag.Journals as List<AashanaFashion.Models.Journal> ?? new();
    int? selectedJournalId = ViewBag.SelectedJournalId;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="page-title mb-1">📖 Double-Entry Journal Entries</h1>
        <p class="page-sub mb-0 text-muted">Complete financial transaction book with balanced debits and credits across all journals</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ChartOfAccounts" class="btn btn-outline-secondary">🏛️ Chart of Accounts</a>
        <a asp-action="TrialBalance" class="btn btn-outline-primary">⚖️ Trial Balance</a>
        <form method="post" asp-action="SyncHistoricalEntries" class="d-inline" onsubmit="return confirm('Synchronize existing sales invoices, receipts, and purchase bills into double-entry journal entries?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning text-dark fw-semibold">
                🔄 Sync Invoices &amp; Bills
            </button>
        </form>
        <a asp-action="CreateJournalEntry" class="btn btn-primary fw-bold">
            + New Journal Entry
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="JournalEntries" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="journalId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Journals</option>
                    @foreach (var j in journals)
                    {
                        <option value="@j.Id" selected="@(j.Id == selectedJournalId)">@j.Name (@j.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" placeholder="Start Date" />
            </div>
            <div class="col-md-3">
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" placeholder="End Date" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dark w-50">Filter</button>
                <a asp-action="JournalEntries" class="btn btn-sm btn-outline-secondary w-50">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Journal Entries List -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold">Journal Vouchers (@Model.Count() entries)</h6>
        <span class="text-muted small">Total Volume: ₹@Model.Sum(e => e.TotalAmount).ToString("N2")</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th style="width: 140px;">Entry #</th>
                    <th style="width: 120px;">Date</th>
                    <th>Journal</th>
                    <th>Reference</th>
                    <th>Narration</th>
                    <th class="text-end" style="width: 140px;">Amount (₹)</th>
                    <th class="text-center" style="width: 100px;">Status</th>
                    <th class="text-center" style="width: 100px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <p class="mb-2">No journal entries found matching filters.</p>
                            <small>Click <strong>"Sync Invoices &amp; Bills"</strong> above to auto-create journal entries for your past sales &amp; purchase bills.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Model)
                    {
                        string badgeClass = entry.Journal?.Type switch
                        {
                            AashanaFashion.Models.JournalType.Sales => "bg-primary-subtle text-primary border-primary",
                            AashanaFashion.Models.JournalType.Purchase => "bg-warning-subtle text-dark border-warning",
                            AashanaFashion.Models.JournalType.Bank => "bg-info-subtle text-info border-info",
                            AashanaFashion.Models.JournalType.Cash => "bg-success-subtle text-success border-success",
                            _ => "bg-secondary-subtle text-secondary"
                        };

                        <tr>
                            <td>
                                <a asp-action="JournalEntryDetails" asp-route-id="@entry.Id" class="font-monospace fw-bold text-decoration-none">
                                    @entry.EntryNumber
                                </a>
                            </td>
                            <td class="small text-muted">@entry.Date.ToString("dd-MMM-yyyy")</td>
                            <td>
                                <span class="badge @badgeClass px-2 py-1">
                                    @(entry.Journal?.Name ?? "Journal")
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(entry.Reference))
                                {
                                    <span class="font-monospace fw-semibold small">@entry.Reference</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 320px;" title="@entry.Narration">
                                    @entry.Narration
                                </div>
                            </td>
                            <td class="text-end fw-bold font-monospace">
                                ₹@entry.TotalAmount.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success">
                                    @entry.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="JournalEntryDetails" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;">
                                    View Dr/Cr 👁️
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
