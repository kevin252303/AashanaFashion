@model IEnumerable<AashanaFashion.Models.Account>
@{
    ViewData["Title"] = "Chart of Accounts";
    var balances = ViewBag.Balances as Dictionary<int, (decimal TotalDebit, decimal TotalCredit)> ?? new();
    var selectedType = ViewBag.SelectedType as AashanaFashion.Models.AccountType?;
    var groups = Model.GroupBy(a => a.Type).OrderBy(g => g.Key).ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chart of Accounts</h1>
        <p class="page-sub">Double-entry ledger accounts for manufacturing, inventory, taxes and financial statements.</p>
    </div>
    <div class="page-actions">
        <a asp-action="JournalEntries" class="btn btn-secondary"><i class="bi bi-journal-text"></i> Journal entries</a>
        <a asp-action="TrialBalance" class="btn btn-secondary"><i class="bi bi-calculator"></i> Trial balance</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newAccountModal"><i class="bi bi-plus-lg"></i> New account</button>
    </div>
</div>

<div class="segmented mb-4" role="tablist" aria-label="Filter by account class">
    <a asp-action="ChartOfAccounts" class="segment @(!selectedType.HasValue ? "active" : "")">All accounts</a>
    @foreach (var (t, label) in new[] { (AashanaFashion.Models.AccountType.Asset, "Assets"), (AashanaFashion.Models.AccountType.Liability, "Liabilities"), (AashanaFashion.Models.AccountType.Equity, "Equity"), (AashanaFashion.Models.AccountType.Income, "Income"), (AashanaFashion.Models.AccountType.Expense, "Expenses") })
    {
        <a asp-action="ChartOfAccounts" asp-route-type="@t" class="segment @(selectedType == t ? "active" : "")">@label</a>
    }
</div>

@if (!groups.Any())
{
    <div class="table-card">
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-diagram-3"></i></div>
            <div class="es-title">No accounts found</div>
            <p>Create a ledger account to start posting journal entries.</p>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#newAccountModal">New account</button>
        </div>
    </div>
}

@foreach (var grp in groups)
{
    <div class="table-card mb-4">
        <div class="data-card-header">
            <div class="data-card-title d-flex align-items-center gap-2">
                <span class="af-badge @TypeBadge(grp.Key)">@grp.Key</span> Accounts
            </div>
            <span class="text-xs text-muted">@grp.Count() @(grp.Count() == 1 ? "account" : "accounts")</span>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 110px;">Code</th>
                        <th>Account</th>
                        <th>Classification</th>
                        <th class="text-end">Total debit</th>
                        <th class="text-end">Total credit</th>
                        <th class="text-end">Net balance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in grp.OrderBy(a => a.Code))
                    {
                        var hasBal = balances.TryGetValue(acc.Id, out var bal);
                        decimal dr = hasBal ? bal.TotalDebit : 0m;
                        decimal cr = hasBal ? bal.TotalCredit : 0m;
                        decimal net;
                        string balLabel;
                        if (acc.Type == AashanaFashion.Models.AccountType.Asset || acc.Type == AashanaFashion.Models.AccountType.Expense)
                        {
                            net = dr - cr;
                            balLabel = net >= 0 ? "Dr" : "Cr";
                        }
                        else
                        {
                            net = cr - dr;
                            balLabel = net >= 0 ? "Cr" : "Dr";
                        }

                        <tr>
                            <td><a asp-action="GeneralLedger" asp-route-accountId="@acc.Id" class="mono-id">@acc.Code</a></td>
                            <td>
                                <a asp-action="GeneralLedger" asp-route-accountId="@acc.Id" class="cell-title text-reset">@acc.Name</a>
                                @if (acc.IsSystemAccount || acc.IsReconcilable)
                                {
                                    <span class="cell-sub">@(acc.IsSystemAccount ? "System" : "")@(acc.IsSystemAccount && acc.IsReconcilable ? " · " : "")@(acc.IsReconcilable ? "Reconcilable" : "")</span>
                                }
                            </td>
                            <td><span class="af-badge b-gray">@acc.Classification.Humanize()</span></td>
                            <td class="cell-num text-muted">@(dr > 0 ? dr.ToString("N2") : "—")</td>
                            <td class="cell-num text-muted">@(cr > 0 ? cr.ToString("N2") : "—")</td>
                            <td class="cell-num">
                                <span class="@(net != 0 ? "text-foreground fw-semibold" : "text-muted")">₹@Math.Abs(net).ToString("N2")</span><span class="dr-cr">@balLabel</span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="GeneralLedger" asp-route-accountId="@acc.Id" class="row-action" title="View ledger" aria-label="View ledger for @acc.Name"><i class="bi bi-journal-text"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="newAccountModal" tabindex="-1" aria-labelledby="newAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-action="CreateAccount" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="newAccountModalLabel">New ledger account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-5">
                        <label class="form-label" for="accCode">Code <span class="req">*</span></label>
                        <input type="text" id="accCode" name="Code" class="af-input font-monospace" placeholder="e.g. 102100" required />
                    </div>
                    <div class="col-7">
                        <label class="form-label" for="accName">Name <span class="req">*</span></label>
                        <input type="text" id="accName" name="Name" class="af-input" placeholder="e.g. HDFC Current Account" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="accType">Type</label>
                        <select id="accType" name="Type" class="af-input af-select">
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="accClass">Classification</label>
                        <select id="accClass" name="Classification" class="af-input af-select">
                            <option value="BankAndCash">Bank &amp; cash</option>
                            <option value="AccountsReceivable">Accounts receivable</option>
                            <option value="Inventory">Inventory</option>
                            <option value="FixedAsset">Fixed asset</option>
                            <option value="CurrentAsset">Current asset</option>
                            <option value="AccountsPayable">Accounts payable</option>
                            <option value="DutiesAndTaxes">Duties &amp; taxes</option>
                            <option value="CurrentLiability">Current liability</option>
                            <option value="Equity">Equity</option>
                            <option value="OperatingRevenue">Operating revenue</option>
                            <option value="CostOfGoodsSold">Cost of goods sold</option>
                            <option value="DirectManufacturingExpense">Direct manufacturing</option>
                            <option value="OperatingExpense">Operating expense</option>
                            <option value="FinancialExpense">Financial expense</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="accDesc">Description</label>
                        <textarea id="accDesc" name="Description" class="af-input" rows="2" placeholder="Optional notes…"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsReconcilable" value="true" id="isReconcilableCheck" />
                            <label class="form-check-label" for="isReconcilableCheck">Allow statement / invoice reconciliation</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save account</button>
            </div>
        </form>
    </div>
</div>

@functions {
    string TypeBadge(AashanaFashion.Models.AccountType t) => t switch
    {
        AashanaFashion.Models.AccountType.Asset => "b-blue",
        AashanaFashion.Models.AccountType.Liability => "b-orange",
        AashanaFashion.Models.AccountType.Equity => "b-purple",
        AashanaFashion.Models.AccountType.Income => "b-green",
        _ => "b-yellow"
    };
}
