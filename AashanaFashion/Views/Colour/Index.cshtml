@model IEnumerable<AashanaFashion.Models.Colour>
@{
    ViewData["Title"] = "Colour Master";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    bool canCreate = isAdmin || User.HasClaim("Permission.VendorMaster.CanCreate", "true");
    bool canEdit   = isAdmin || User.HasClaim("Permission.VendorMaster.CanEdit",   "true");
    bool canDelete = isAdmin || User.HasClaim("Permission.VendorMaster.CanDelete", "true");
    bool filtered  = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.ActiveOnly == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Colour Master</h1>
        <p class="page-sub">Manage product colour choices</p>
    </div>
    @if (canCreate)
    {
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Colour</a>
        </div>
    }
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search colour name, hex code…" value="@ViewBag.Search" />
            </div>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnly" @(ViewBag.ActiveOnly == true ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label" for="activeOnly">Active only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Colour</th>
                        <th>Hex Code</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="swatch swatch-lg" style="background-color:@(string.IsNullOrEmpty(item.ColourCode) ? "transparent" : item.ColourCode);"></span>
                                    <span class="cell-title">@item.ColourName</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ColourCode))
                                {
                                    <span class="font-monospace text-xs">@item.ColourCode.ToUpperInvariant()</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                <span class="af-badge @(item.IsActive ? "b-green" : "b-gray")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="cell-actions">
                                @if (canEdit || canDelete)
                                {
                                    <div class="row-actions">
                                        @if (canEdit)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                        }
                                        @if (canDelete)
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="row-action danger" onclick="return confirm('Delete this colour?')" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-placeholder">View only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "colour" : "colours")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-palette")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No colours yet")</div>
            <p>@(filtered ? "No colours match your search. Try adjusting the filters." : "Add the colours your designs are produced in.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">New Colour</a>
            }
        </div>
    }
</div>
