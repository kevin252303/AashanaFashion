@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="data-card" style="max-width: 560px; width: 100%;">
        <div class="empty-state">
            <div class="es-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-circle"></i></div>
            <div class="es-title">Something went wrong</div>
            <p>An error occurred while processing your request. Please try again.</p>

            @if (Model.ShowRequestId)
            {
                <p class="mt-2">Request ID <span class="mono-id">@Model.RequestId</span></p>
            }

            <a href="javascript:history.back()" class="btn btn-secondary">Go back</a>
        </div>
        <div class="data-card-footer text-xs">
            <strong class="text-foreground">Development mode.</strong>
            Setting <span class="mono-id">ASPNETCORE_ENVIRONMENT</span> to <span class="mono-id">Development</span> shows detailed error information.
            The Development environment shouldn't be enabled for deployed applications — it can expose sensitive information from exceptions to end users.
        </div>
    </div>
</div>
