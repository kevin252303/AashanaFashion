<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Aashana Fashion</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; display: flex; background: var(--background); }

        .auth-brand {
            flex: 1 1 50%;
            display: flex; flex-direction: column; justify-content: space-between;
            padding: var(--space-10) var(--space-12);
            background: var(--surface);
            border-right: 1px solid var(--border);
        }
        .auth-logo { width: 168px; height: auto; display: block; }
        .auth-pitch { max-width: 420px; }
        .auth-eyebrow { font-size: var(--text-2xs); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--indigo-600); margin-bottom: var(--space-3); }
        .auth-headline { font-size: var(--text-display); font-weight: 700; line-height: 1.2; letter-spacing: -.02em; color: var(--foreground); margin: 0 0 var(--space-3); }
        .auth-lede { font-size: var(--text-body); color: var(--muted); margin: 0 0 var(--space-8); }
        .auth-features { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
        .auth-features li { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); color: var(--secondary); }
        .auth-features .bi {
            width: 28px; height: 28px; flex-shrink: 0;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: var(--radius-md);
            background: var(--indigo-50); color: var(--indigo-600);
            font-size: 14px;
        }
        .auth-legal { font-size: var(--text-xs); color: var(--placeholder); }

        .auth-main {
            flex: 1 1 50%;
            display: flex; align-items: center; justify-content: center;
            padding: var(--space-8) var(--space-4);
        }
        .auth-card {
            width: 100%; max-width: 400px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-raised);
            padding: var(--space-8);
        }
        .auth-card-mark { margin-bottom: var(--space-6); }
        .auth-card.auth-card-wide { max-width: 680px; }
        .auth-main.auth-solo { flex-basis: 100%; }
        .auth-badge { display: inline-flex; align-items: center; gap: 6px; margin-bottom: var(--space-4); }
        .auth-title { font-size: var(--text-title); font-weight: 600; color: var(--foreground); margin: 0 0 var(--space-1); }
        .auth-sub { font-size: var(--text-sm); color: var(--muted); margin: 0 0 var(--space-6); }
        .auth-field { margin-bottom: var(--space-4); }
        .auth-field .af-input { min-height: var(--control-h-lg); padding-top: 7px; padding-bottom: 7px; }
        .auth-field .search-field > .af-input { padding-left: 34px; }
        .auth-pw { position: relative; }
        .auth-pw .af-input { padding-right: 40px; }
        .auth-pw .pw-toggle {
            position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
            width: 30px; height: 28px;
            display: inline-flex; align-items: center; justify-content: center;
            border: 0; background: none; border-radius: var(--radius-sm);
            color: var(--placeholder); cursor: pointer;
        }
        .auth-pw .pw-toggle:hover { color: var(--secondary); background: var(--gray-100); }
        .auth-trial { margin-top: var(--space-5); text-align: center; font-size: var(--text-sm); color: var(--muted); }
        .auth-trial a { display: inline-flex; align-items: center; gap: 4px; }
        .auth-foot { margin-top: var(--space-6); text-align: center; font-size: var(--text-xs); color: var(--placeholder); }

        @@media (max-width: 991.98px) {
            .auth-brand { display: none; }
        }
    </style>
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap-5.3.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
