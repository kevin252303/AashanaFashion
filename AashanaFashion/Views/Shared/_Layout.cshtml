<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Kriyex</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/inter/inter.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@inject AashanaFashion.Services.ICompanyContext CompanyContext

@if (User.Identity?.IsAuthenticated == true)
{
    var activeCompany = await CompanyContext.GetActiveCompanyAsync();
    var userCompanies = await CompanyContext.GetAllowedCompaniesAsync();
    var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "";
    var initials = string.Concat(fullName.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
    var ctrl     = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action   = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isSuperAdmin = role == "SuperAdmin";
    bool isAdmin      = role == "Admin" || isSuperAdmin;

    // Permission helpers — check claims for custom roles
    bool canViewDesign      = isAdmin || User.HasClaim("Permission.DesignMaster.CanView",    "true");
    bool canViewVendor      = isAdmin || User.HasClaim("Permission.VendorMaster.CanView",    "true");
    bool canViewCustomer    = isAdmin || User.HasClaim("Permission.CustomerMaster.CanView",  "true");
    bool canViewUserMgmt    = isAdmin || User.HasClaim("Permission.UserManagement.CanView",  "true");
    bool canViewPurchase    = isAdmin || User.HasClaim("Permission.Purchase.CanView",      "true");
    bool canViewFinance     = isAdmin || role == "Manager" || role == "System Admin" || User.HasClaim("Permission.Accounting.CanView", "true");

    // Active-state helpers for collapsible groups
    bool inMasters    = ctrl is "Design" or "Archive" or "Vendor" or "Customer" or "RawMaterial" or "Colour" or "Size" or "ProcessMaster" or "Pricelist" or "Category" or "Company"
                        || (ctrl == "ReadyProduct" && action != "Assemble");
    bool inJobWork    = ctrl is "Dying" or "RollPress";
    bool inProduction = ctrl is "Production" or "PMS" or "QualityControl" or "JobSlip" or "Barcode" || (ctrl == "ReadyProduct" && action == "Assemble");
    bool inUsers      = ctrl is "UserManagement" or "Role";
    bool inHr         = ctrl is "Employee" or "Attendance" or "Salary" or "BiometricDevice";
    bool inAccounts   = ctrl == "Accounting" && action != "Commissions";

    string crumbGroup = ctrl switch
    {
        "Lead" => "CRM",
        "CustomerPortal" => "Buyer Portal",
        "SalesOrder" => "Sales",
        "Purchase" => "Purchase",
        "Dying" or "RollPress" => "Job Work",
        "UserManagement" or "Role" => "Users",
        "Employee" or "Attendance" or "Salary" or "BiometricDevice" => "HR & Payroll",
        "Invoice" or "Accounting" or "GstReturn" => "Finance",
        "PlatformAdmin" or "Subscription" => "SaaS",
        "Account" => "Account",
        _ when inProduction => "Production",
        _ when inMasters => "Admin Master",
        _ => "Home"
    };

    string Active(bool on) => on ? "active" : "";
    string Group(bool on) => on ? "sb-group open has-active" : "sb-group";

    @if (role == "Developer")
    {
        <aside class="sidebar" id="sidebar" style="background: #0f172a;">
            <div class="sidebar-brand" style="background: #020617; border-bottom: 1px solid #1e293b;">
                <div class="brand-mark" style="background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%); color:white;">⚡</div>
                <div>
                    <div class="brand-name" style="color: #f8fafc;">Kriyex Console</div>
                    <div class="brand-sub" style="color: #818cf8;">kriyex.com Platform</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="sb-section" style="color: #64748b;">SaaS Operations</div>

                <a class="sb-link @Active(ctrl == "PlatformAdmin")"
                   asp-controller="PlatformAdmin" asp-action="Index">
                    <i class="bi bi-shield-check"></i><span>SaaS Client Operations</span>
                </a>

                <a class="sb-link @Active(ctrl == "Subscription")"
                   asp-controller="Subscription" asp-action="Index">
                    <i class="bi bi-cloud"></i><span>Subscription Quotas</span>
                </a>

                <div class="sb-section" style="color: #64748b;">Tenant Management</div>

                <a class="sb-link" href="@Url.Action("Index", "PlatformAdmin")#onboardSection">
                    <i class="bi bi-rocket-takeoff"></i><span>Onboard New Client</span>
                </a>

                <a class="sb-link" href="@Url.Action("Index", "PlatformAdmin")#tenantsTable">
                    <i class="bi bi-building"></i><span>Client Directory</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span>Signed in as</span>
                <span class="af-badge b-indigo">DEVELOPER</span>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn btn-ghost btn-icon topbar-toggle" data-sidebar-toggle aria-label="Open navigation" aria-controls="sidebar">
                    <i class="bi bi-list" style="font-size:18px;"></i>
                </button>
                <nav class="topbar-crumbs" aria-label="Breadcrumb">
                    <span class="crumb-group">SaaS</span>
                    <i class="bi bi-chevron-right crumb-sep"></i>
                    <span class="current">@(ViewData["Title"] ?? "Kriyex SaaS Control Center")</span>
                </nav>
                <span class="af-badge b-indigo ms-2">⚡ KRIYEX PLATFORM</span>
            </div>
            <div class="topbar-right">
                <a asp-controller="PlatformAdmin" asp-action="SwitchToDefault" class="btn btn-secondary btn-sm" title="Reset Tenant Context">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset Context</span>
                </a>

                <div class="dropdown">
                    <button type="button" class="user-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="u-avatar" style="background:#4f46e5;color:white;">DEV</span>
                        <span class="u-meta">
                            <span class="u-name d-block">@fullName</span>
                            <span class="u-role d-block">Developer</span>
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end mt-1" style="min-width:220px;">
                        <li class="px-2 py-2 d-flex align-items-center gap-2">
                            <span class="u-avatar avatar-lg" style="background:#4f46e5;color:white;">DEV</span>
                            <div class="min-w-0">
                                <div class="u-name text-truncate">@fullName</div>
                                <div class="u-role">Developer</div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i> Change password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
    }
    else if (role == "Customer")
    {
        <aside class="sidebar" id="sidebar" aria-label="Buyer navigation">
            <a class="sidebar-brand" asp-controller="CustomerPortal" asp-action="Index">
                <div class="brand-mark" style="background: var(--indigo-600); color: white;">KP</div>
                <div class="min-w-0">
                    <div class="brand-name">Kriyex Portal</div>
                    <div class="brand-sub">B2B Buyer Hub</div>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="sb-section">Overview</div>
                <a class="sb-link @Active(ctrl == "CustomerPortal" && action == "Index")" asp-controller="CustomerPortal" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>

                <div class="sb-section">Orders &amp; Shipments</div>
                <a class="sb-link @Active(ctrl == "CustomerPortal" && (action == "Orders" || action == "OrderDetails"))" asp-controller="CustomerPortal" asp-action="Orders">
                    <i class="bi bi-bag"></i><span>My Orders</span>
                </a>
                <a class="sb-link @Active(ctrl == "CustomerPortal" && action == "Challans")" asp-controller="CustomerPortal" asp-action="Challans">
                    <i class="bi bi-truck"></i><span>Delivery Challans</span>
                </a>

                <div class="sb-section">Billing &amp; Tax</div>
                <a class="sb-link @Active(ctrl == "CustomerPortal" && action == "Invoices")" asp-controller="CustomerPortal" asp-action="Invoices">
                    <i class="bi bi-receipt"></i><span>Tax Invoices</span>
                </a>

                <div class="sb-section">Account</div>
                <a class="sb-link @Active(ctrl == "CustomerPortal" && action == "Profile")" asp-controller="CustomerPortal" asp-action="Profile">
                    <i class="bi bi-person"></i><span>Company Profile</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span>Signed in as</span>
                <span class="af-badge b-blue">BUYER PORTAL</span>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn btn-ghost btn-icon topbar-toggle" data-sidebar-toggle aria-label="Open navigation" aria-controls="sidebar">
                    <i class="bi bi-list" style="font-size:18px;"></i>
                </button>
                <nav class="topbar-crumbs" aria-label="Breadcrumb">
                    <span class="crumb-group">Buyer Portal</span>
                    <i class="bi bi-chevron-right crumb-sep"></i>
                    <span class="current">@(ViewData["Title"] ?? "Dashboard")</span>
                </nav>
            </div>
            <div class="topbar-right">
                <div class="dropdown">
                    <button type="button" class="user-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="u-avatar" style="background:var(--indigo-600);color:white;">BP</span>
                        <span class="u-meta">
                            <span class="u-name d-block">@fullName</span>
                            <span class="u-role d-block">Buyer</span>
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end mt-1" style="min-width:220px;">
                        <li class="px-2 py-2 d-flex align-items-center gap-2">
                            <span class="u-avatar avatar-lg" style="background:var(--indigo-600);color:white;">BP</span>
                            <div class="min-w-0">
                                <div class="u-name text-truncate">@fullName</div>
                                <div class="u-role">Buyer Account</div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i> Change password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
    }
    else
    {
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">
            <a class="sidebar-brand" asp-controller="Production" asp-action="Index">
                <div class="brand-mark">KX</div>
                <div class="min-w-0">
                    <div class="brand-name">Kriyex</div>
                    <div class="brand-sub">Production System</div>
                </div>
            </a>

            <nav class="sidebar-nav">
                <div class="sb-section">Sales &amp; CRM</div>

                <a class="sb-link @Active(ctrl == "Lead")" asp-controller="Lead" asp-action="Index">
                    <i class="bi bi-funnel"></i><span>Leads &amp; CRM</span>
                </a>

                <a class="sb-link @Active(ctrl == "SalesOrder")" asp-controller="SalesOrder" asp-action="Index">
                    <i class="bi bi-bag"></i><span>Sales Orders</span>
                </a>

                @if (canViewPurchase)
                {
                    <a class="sb-link @Active(ctrl == "Purchase")" asp-controller="Purchase" asp-action="Index">
                        <i class="bi bi-cart3"></i><span>Purchase Orders</span>
                    </a>
                }

                @if (canViewDesign || canViewVendor || canViewCustomer || isAdmin)
                {
                    <div class="@Group(inMasters)">
                        <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inMasters ? "true" : "false")">
                            <i class="bi bi-database"></i><span>Admin Master</span><i class="bi bi-chevron-down sb-chevron"></i>
                        </button>
                        <div class="sb-sub">
                            @if (canViewDesign)
                            {
                                <a class="sb-sublink @Active(ctrl == "Design")" asp-controller="Design" asp-action="Index">Product Master</a>
                                <a class="sb-sublink @Active(ctrl == "Archive")" asp-controller="Archive" asp-action="Index">Archive (Discontinued)</a>
                                <a class="sb-sublink @Active(ctrl == "Category")" asp-controller="Category" asp-action="Index">Category Master</a>
                            }
                            @if (canViewCustomer)
                            {
                                <a class="sb-sublink @Active(ctrl == "Customer")" asp-controller="Customer" asp-action="Index">Customer Master</a>
                            }
                            @if (isAdmin || canViewCustomer || canViewDesign)
                            {
                                <a class="sb-sublink @Active(ctrl == "Pricelist")" asp-controller="Pricelist" asp-action="Index">Pricelist Master</a>
                            }
                            @if (canViewVendor)
                            {
                                <a class="sb-sublink @Active(ctrl == "Vendor")" asp-controller="Vendor" asp-action="Index">Vendor Master</a>
                            }
                            <a class="sb-sublink @Active(ctrl == "ReadyProduct" && action == "Index")" asp-controller="ReadyProduct" asp-action="Index">Ready Product Stock</a>
                            <a class="sb-sublink @Active(ctrl == "ReadyProduct" && action == "Outward")" asp-controller="ReadyProduct" asp-action="Outward">Outward Dispatch</a>
                            <a class="sb-sublink @Active(ctrl == "ReadyProduct" && action == "Ledger")" asp-controller="ReadyProduct" asp-action="Ledger">Ready Stock Ledger</a>
                            <a class="sb-sublink @Active(ctrl == "RawMaterial" && (action == "Index" || action == "InOut" || action == "AdjustStock"))" asp-controller="RawMaterial" asp-action="Index">Inventory &amp; Stock</a>
                            <a class="sb-sublink @Active(ctrl == "RawMaterial" && action == "Ledger")" asp-controller="RawMaterial" asp-action="Ledger">Stock Ledger</a>
                            <a class="sb-sublink @Active(ctrl == "Colour")" asp-controller="Colour" asp-action="Index">Colour Master</a>
                            <a class="sb-sublink @Active(ctrl == "Size")" asp-controller="Size" asp-action="Index">Size Master</a>
                            <a class="sb-sublink @Active(ctrl == "ProcessMaster")" asp-controller="ProcessMaster" asp-action="Index">Process Master</a>
                            @if (isAdmin)
                            {
                                <a class="sb-sublink @Active(ctrl == "Company")" asp-controller="Company" asp-action="Index">Company Master</a>
                            }
                        </div>
                    </div>
                }

                @if (role == "Admin" || role == "Manager")
                {
                    <div class="@Group(inJobWork)">
                        <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inJobWork ? "true" : "false")">
                            <i class="bi bi-tools"></i><span>Job Work Entry</span><i class="bi bi-chevron-down sb-chevron"></i>
                        </button>
                        <div class="sb-sub">
                            <a class="sb-sublink @Active(ctrl == "Dying")" asp-controller="Dying" asp-action="Index">Dying Entry</a>
                            <a class="sb-sublink @Active(ctrl == "RollPress")" asp-controller="RollPress" asp-action="Index">Roll Press Entry</a>
                        </div>
                    </div>
                }

                <div class="sb-section">Production</div>
                <div class="@Group(inProduction)">
                    <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inProduction ? "true" : "false")">
                        <i class="bi bi-boxes"></i><span>Production Work</span><i class="bi bi-chevron-down sb-chevron"></i>
                    </button>
                    <div class="sb-sub">
                        <a class="sb-sublink @Active(ctrl == "PMS" && action == "Index")" asp-controller="PMS" asp-action="Index">Dashboard (WIP)</a>
                        <a class="sb-sublink @Active(ctrl == "Production")" asp-controller="Production" asp-action="Index">Order Lots (Plans)</a>
                        <a class="sb-sublink @Active(ctrl == "JobSlip")" asp-controller="JobSlip" asp-action="Index">Job Slips (Challans)</a>
                        <a class="sb-sublink @Active(ctrl == "PMS" && (action == "ProcessTracking" || action == "ProductionEntities"))" asp-controller="PMS" asp-action="ProcessTracking">Process &amp; Piece Tracking</a>
                        <a class="sb-sublink @Active(ctrl == "QualityControl")" asp-controller="QualityControl" asp-action="Index">Quality Control (QC)</a>
                        <a class="sb-sublink @Active(ctrl == "Barcode" && action == "Scanner")" asp-controller="Barcode" asp-action="Scanner">Barcode Scanner</a>
                        <a class="sb-sublink @Active(ctrl == "Barcode" && action == "ConfigureTag")" asp-controller="Barcode" asp-action="ConfigureTag">Configure Barcode Tag</a>
                    </div>
                </div>

                @if (canViewUserMgmt)
                {
                    <div class="sb-section">Users</div>
                    <div class="@Group(inUsers)">
                        <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inUsers ? "true" : "false")">
                            <i class="bi bi-people"></i><span>User Management</span><i class="bi bi-chevron-down sb-chevron"></i>
                        </button>
                        <div class="sb-sub">
                            <a class="sb-sublink @Active(ctrl == "UserManagement" && action == "Index")" asp-controller="UserManagement" asp-action="Index">User List</a>
                            @if (isAdmin)
                            {
                                <a class="sb-sublink @Active(ctrl == "Role")" asp-controller="Role" asp-action="Index">Role List</a>
                            }
                        </div>
                    </div>
                }

                <div class="sb-section">HR &amp; Payroll</div>
                <div class="@Group(inHr)">
                    <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inHr ? "true" : "false")">
                        <i class="bi bi-person-badge"></i><span>Attendance &amp; HR</span><i class="bi bi-chevron-down sb-chevron"></i>
                    </button>
                    <div class="sb-sub">
                        <a class="sb-sublink @Active(ctrl == "Attendance" && action == "Kiosk")" asp-controller="Attendance" asp-action="Kiosk">Face Scanner Kiosk</a>
                        <a class="sb-sublink @Active(ctrl == "Attendance" && action == "Index")" asp-controller="Attendance" asp-action="Index">Daily Register</a>
                        <a class="sb-sublink @Active(ctrl == "Attendance" && action == "MonthlyReport")" asp-controller="Attendance" asp-action="MonthlyReport">Attendance Grid</a>
                        <a class="sb-sublink @Active(ctrl == "Employee")" asp-controller="Employee" asp-action="Index">Employees</a>
                        <a class="sb-sublink @Active(ctrl == "Salary")" asp-controller="Salary" asp-action="Index">Salary &amp; Payroll</a>
                        <a class="sb-sublink @Active(ctrl == "BiometricDevice")" asp-controller="BiometricDevice" asp-action="Index">Biometric Terminals</a>
                    </div>
                </div>

                @if (canViewFinance)
                {
                    <div class="sb-section">Finance &amp; Accounts</div>
                    <a class="sb-link @Active(ctrl == "Invoice")" asp-controller="Invoice" asp-action="Index">
                        <i class="bi bi-receipt"></i><span>Tax Invoices</span>
                    </a>
                    <div class="@Group(inAccounts)">
                        <button type="button" class="sb-link" data-sb-toggle aria-expanded="@(inAccounts ? "true" : "false")">
                            <i class="bi bi-journal-text"></i><span>Accounting</span><i class="bi bi-chevron-down sb-chevron"></i>
                        </button>
                        <div class="sb-sub">
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action is "ChartOfAccounts" or "GeneralLedger")" asp-controller="Accounting" asp-action="ChartOfAccounts">Chart of Accounts</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action is "JournalEntries" or "CreateJournalEntry" or "JournalEntryDetails")" asp-controller="Accounting" asp-action="JournalEntries">Journal Entries</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action == "TrialBalance")" asp-controller="Accounting" asp-action="TrialBalance">Trial Balance</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action == "ProfitAndLoss")" asp-controller="Accounting" asp-action="ProfitAndLoss">Profit &amp; Loss</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action == "BalanceSheet")" asp-controller="Accounting" asp-action="BalanceSheet">Balance Sheet</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action is "Index" or "Create" or "Edit")" asp-controller="Accounting" asp-action="Index">Cash &amp; Bank Ledger</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action is "AgedReceivables" or "CustomerStatement")" asp-controller="Accounting" asp-action="AgedReceivables">Aged Receivables (AR)</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action is "AgedPayables" or "VendorStatement")" asp-controller="Accounting" asp-action="AgedPayables">Aged Payables (AP)</a>
                            <a class="sb-sublink @Active(ctrl == "Accounting" && action == "ThreeWayMatching")" asp-controller="Accounting" asp-action="ThreeWayMatching">3-Way Matching</a>
                        </div>
                    </div>
                    <a class="sb-link @Active(ctrl == "GstReturn")" asp-controller="GstReturn" asp-action="Index">
                        <i class="bi bi-bank"></i><span>GST Returns &amp; Filing</span>
                    </a>
                    <a class="sb-link @Active(ctrl == "Accounting" && action == "Commissions")" asp-controller="Accounting" asp-action="Commissions">
                        <i class="bi bi-percent"></i><span>Salesman Commission</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <div class="sb-section">Organization</div>
                    <a class="sb-link @Active(ctrl == "Subscription")" asp-controller="Subscription" asp-action="Index">
                        <i class="bi bi-cloud"></i><span>Subscription &amp; Quotas</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <span>Signed in as</span>
                <span class="af-badge b-indigo">@role</span>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn btn-ghost btn-icon topbar-toggle" data-sidebar-toggle aria-label="Open navigation" aria-controls="sidebar">
                    <i class="bi bi-list" style="font-size:18px;"></i>
                </button>
                <nav class="topbar-crumbs" aria-label="Breadcrumb">
                    <span class="crumb-group">@crumbGroup</span>
                    <i class="bi bi-chevron-right crumb-sep"></i>
                    <span class="current">@(ViewData["Title"] ?? "Dashboard")</span>
                </nav>
            </div>

            <div class="topbar-right">
                <div class="dropdown company-switch">
                    <button class="btn btn-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Switch company">
                        <i class="bi bi-buildings text-placeholder"></i>
                        <span class="company-name">@activeCompany.CompanyName</span>
                        <i class="bi bi-chevron-down text-placeholder" style="font-size:11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end company-menu mt-1">
                        <li>
                            <div class="dropdown-header d-flex align-items-center justify-content-between">
                                <span>Active company</span>
                                <span class="mono-id">@activeCompany.CompanyCode</span>
                            </div>
                        </li>
                        @foreach (var c in userCompanies)
                        {
                            var isCurrent = c.Id == activeCompany.Id;
                            <li>
                                <a class="dropdown-item @(isCurrent ? "current" : "")"
                                   asp-controller="Company" asp-action="Switch" asp-route-companyId="@c.Id" asp-route-returnUrl="@Context.Request.Path">
                                    <i class="bi @(isCurrent ? "bi-check2 text-primary" : "bi-building")"></i>
                                    <span class="text-truncate">@c.CompanyName</span>
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Company" asp-action="Index">
                                    <i class="bi bi-gear"></i> Manage companies
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="dropdown">
                    <button type="button" class="user-menu-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="u-avatar">@initials</span>
                        <span class="u-meta">
                            <span class="u-name d-block">@fullName</span>
                            <span class="u-role d-block">@role</span>
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end mt-1" style="min-width:230px;">
                        <li class="px-2 py-2 d-flex align-items-center gap-2">
                            <span class="u-avatar avatar-lg">@initials</span>
                            <div class="min-w-0">
                                <div class="u-name text-truncate">@fullName</div>
                                <div class="u-role">@role</div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i> Change password
                            </a>
                        </li>
                        @if (canViewUserMgmt)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">
                                    <i class="bi bi-people"></i> User management
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Subscription" asp-action="Index">
                                    <i class="bi bi-cloud"></i> Subscription &amp; quotas
                                </a>
                            </li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
    }

    var flashSuccess = TempData["Success"]?.ToString();
    var flashInfo    = TempData["Info"]?.ToString();
    var flashWarning = TempData["Warning"]?.ToString();
    var flashError   = TempData["Error"]?.ToString();

    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(flashSuccess))
        {
            <div class="af-toast success" role="status" data-autohide>
                <i class="bi bi-check-circle-fill"></i>
                <div class="toast-body">@flashSuccess</div>
                <button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
            </div>
        }
        @if (!string.IsNullOrEmpty(flashInfo))
        {
            <div class="af-toast info" role="status" data-autohide>
                <i class="bi bi-info-circle-fill"></i>
                <div class="toast-body">@flashInfo</div>
                <button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
            </div>
        }
    </div>

    <main class="main-wrap">
        <div class="page-body">
            @if (!string.IsNullOrEmpty(flashError))
            {
                <div class="af-alert af-alert-danger" role="alert">
                    <div class="alert-body">@flashError</div>
                    <button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
                </div>
            }
            @if (!string.IsNullOrEmpty(flashWarning))
            {
                <div class="af-alert af-alert-warning" role="alert">
                    <div class="alert-body">@flashWarning</div>
                    <button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
                </div>
            }
            @RenderBody()
        </div>
    </main>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap-5.3.3/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Global Print Watermark -->
<div class="print-watermark-container" aria-hidden="true">
    <img src="~/images/aashana_watermark.png" alt="Aashana Fashion Watermark" class="print-watermark-img" />
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
