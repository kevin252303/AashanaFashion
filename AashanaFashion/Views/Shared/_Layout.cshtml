<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Kriyex</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@inject AashanaFashion.Services.ICompanyContext CompanyContext

@if (User.Identity?.IsAuthenticated == true)
{
    var activeCompany = await CompanyContext.GetActiveCompanyAsync();
    var userCompanies = await CompanyContext.GetAllowedCompaniesAsync();
    var role     = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "";
    var initials = string.Concat(fullName.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
    var ctrl     = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action   = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isSuperAdmin = role == "SuperAdmin";
    bool isAdmin      = role == "Admin" || isSuperAdmin;

    // Permission helpers — check claims for custom roles
    bool canViewDesign      = isAdmin || User.HasClaim("Permission.DesignMaster.CanView",    "true");
    bool canViewVendor      = isAdmin || User.HasClaim("Permission.VendorMaster.CanView",    "true");
    bool canViewCustomer    = isAdmin || User.HasClaim("Permission.CustomerMaster.CanView",  "true");
    bool canCreateOrder     = isAdmin || User.HasClaim("Permission.ProductionOrder.CanCreate", "true");
    bool canViewUserMgmt    = isAdmin || User.HasClaim("Permission.UserManagement.CanView",  "true");
    bool canViewPurchase    = isAdmin || User.HasClaim("Permission.Purchase.CanView",      "true");

    @if (role == "Developer")
    {
        <aside class="sidebar" id="sidebar" style="background: #0f172a;">
            <div class="sidebar-brand" style="background: #020617; border-bottom: 1px solid #1e293b;">
                <div class="brand-icon" style="background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%); color:white;">⚡</div>
                <div>
                    <div class="brand-name" style="color: #f8fafc;">Kriyex Console</div>
                    <div class="brand-sub" style="color: #818cf8;">kriyex.com Platform</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-label" style="color: #64748b;">SaaS Operations</div>

                <a class="s-link @(ctrl == "PlatformAdmin" ? "active" : "")"
                   asp-controller="PlatformAdmin" asp-action="Index">
                    <span class="ico">👑</span> SaaS Client Operations
                </a>

                <a class="s-link @(ctrl == "Subscription" ? "active" : "")"
                   asp-controller="Subscription" asp-action="Index">
                    <span class="ico">☁️</span> Subscription Quotas
                </a>

                <div class="nav-label" style="color: #64748b;">Tenant Management</div>

                <a class="s-link" href="@Url.Action("Index", "PlatformAdmin")#onboardSection">
                    <span class="ico">🚀</span> Onboard New Client
                </a>

                <a class="s-link" href="@Url.Action("Index", "PlatformAdmin")#tenantsTable">
                    <span class="ico">🏢</span> Client Directory
                </a>
            </nav>

            <div class="role-pill" style="background: #4f46e5; color: white; font-weight: 700; letter-spacing: 0.5px;">DEVELOPER</div>
        </aside>

        <div class="topbar">
            <div class="topbar-left">
                <span class="page-title">@(ViewData["Title"] ?? "Kriyex SaaS Control Center")</span>
                <span class="badge ms-2" style="background: #e0e7ff; color: #4338ca; font-weight: 600; font-size: 0.75rem; border: 1px solid #c7d2fe;">
                    ⚡ KRIYEX PLATFORM
                </span>
            </div>
            <div class="d-flex align-items-center gap-2.5">
                <a asp-controller="PlatformAdmin" asp-action="SwitchToDefault" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 px-3 py-1 shadow-sm" style="border-radius: 20px; font-size: 0.78rem;" title="Reset Tenant Context">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset Context</span>
                </a>

                <div class="user-chip dropdown">
                    <div class="d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                        <div class="u-avatar" style="background: #4f46e5; color: white;">DEV</div>
                        <div>
                            <div class="u-name">@fullName</div>
                            <div class="u-role text-primary fw-bold">Developer</div>
                        </div>
                        <span class="ms-1" style="font-size:0.75rem; color:#94a3b8;">▾</span>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" style="min-width: 220px; border-radius: 8px; border: 1px solid #e2e8f0; padding: 0.5rem;">
                        <li class="px-3 py-2 border-bottom mb-1">
                            <div class="fw-bold text-dark" style="font-size:0.9rem;">@fullName</div>
                            <div class="small text-muted">Role: <span class="badge" style="background: #4f46e5; color:white; font-size:0.72rem;">Developer</span></div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChangePassword">
                                <span>🔑</span> Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger w-100 border-0 bg-transparent text-start">
                                    <span>🚪</span> Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
    else
    {
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">KX</div>
                <div>
                    <div class="brand-name">Kriyex</div>
                    <div class="brand-sub">Production System</div>
                </div>
            </div>

        <nav class="sidebar-nav">
            <div class="nav-label">Main</div>

            <a class="s-link @(ctrl == "SalesOrder" ? "active" : "")"
               asp-controller="SalesOrder" asp-action="Index">
                <span class="ico">🛍️</span> Sales Orders
            </a>

            @if (canViewPurchase)
            {
                <a class="s-link @(ctrl == "Purchase" ? "active" : "")"
                   asp-controller="Purchase" asp-action="Index">
                    <span class="ico">🛒</span> Purchase Orders
                </a>
            }

            @if (canViewDesign || canViewVendor || canViewCustomer || isAdmin)
            {
                <a class="s-link s-link-toggle @(ctrl == "Design" || ctrl == "Archive" || ctrl == "Vendor" || ctrl == "Customer" || ctrl == "RawMaterial" || ctrl == "ReadyProduct" || ctrl == "Colour" || ctrl == "Size" || ctrl == "ProcessMaster" || ctrl == "Pricelist" || ctrl == "Category" || ctrl == "Company" ? "open" : "")" onclick="toggleNav(this)">
                    <span class="ico">⚙️</span> Admin Master
                    <span class="nav-arrow">▾</span>
                </a>
                <div class="s-submenu @(ctrl == "Design" || ctrl == "Archive" || ctrl == "Vendor" || ctrl == "Customer" || ctrl == "RawMaterial" || ctrl == "ReadyProduct" || ctrl == "Colour" || ctrl == "Size" || ctrl == "ProcessMaster" || ctrl == "Pricelist" || ctrl == "Category" || ctrl == "Company" ? "" : "d-none")">
                    @if (canViewDesign)
                    {
                        <a class="s-link s-sublink @(ctrl == "Design" ? "active" : "")"
                           asp-controller="Design" asp-action="Index">
                            <span class="ico">🎨</span> Product Master
                        </a>
                        <a class="s-link s-sublink @(ctrl == "Archive" ? "active" : "")"
                           asp-controller="Archive" asp-action="Index">
                            <span class="ico">📦</span> Archive (Discontinued)
                        </a>
                        <a class="s-link s-sublink @(ctrl == "Category" ? "active" : "")"
                           asp-controller="Category" asp-action="Index">
                            <span class="ico">🗂️</span> Category Master
                        </a>
                    }
                    @if (canViewCustomer)
                    {
                        <a class="s-link s-sublink @(ctrl == "Customer" ? "active" : "")"
                           asp-controller="Customer" asp-action="Index">
                            <span class="ico">👥</span> Customer Master
                        </a>
                    }
                    @if (isAdmin || canViewCustomer || canViewDesign)
                    {
                        <a class="s-link s-sublink @(ctrl == "Pricelist" ? "active" : "")"
                           asp-controller="Pricelist" asp-action="Index">
                            <span class="ico">🏷️</span> Pricelist Master
                        </a>
                    }
                    @if (canViewVendor)
                    {
                        <a class="s-link s-sublink @(ctrl == "Vendor" ? "active" : "")"
                           asp-controller="Vendor" asp-action="Index">
                            <span class="ico">🏢</span> Vendor Master
                        </a>
                    }
                    <a class="s-link s-sublink @(ctrl == "ReadyProduct" && action == "Index" ? "active" : "")"
                       asp-controller="ReadyProduct" asp-action="Index">
                        <span class="ico">👗</span> Ready Product Stock
                    </a>
                    <a class="s-link s-sublink @(ctrl == "ReadyProduct" && action == "Outward" ? "active" : "")"
                       asp-controller="ReadyProduct" asp-action="Outward">
                        <span class="ico">📤</span> Outward Dispatch
                    </a>
                    <a class="s-link s-sublink @(ctrl == "ReadyProduct" && action == "Ledger" ? "active" : "")"
                       asp-controller="ReadyProduct" asp-action="Ledger">
                        <span class="ico">📋</span> Ready Stock Ledger
                    </a>
                    <a class="s-link s-sublink @(ctrl == "RawMaterial" && (action == "Index" || action == "InOut" || action == "AdjustStock") ? "active" : "")"
                       asp-controller="RawMaterial" asp-action="Index">
                        <span class="ico">🧵</span> Inventory & Stock
                    </a>
                    <a class="s-link s-sublink @(ctrl == "RawMaterial" && action == "Ledger" ? "active" : "")"
                       asp-controller="RawMaterial" asp-action="Ledger">
                        <span class="ico">📜</span> Stock Ledger
                    </a>
                    <a class="s-link s-sublink @(ctrl == "Colour" ? "active" : "")"
                       asp-controller="Colour" asp-action="Index">
                        <span class="ico">🎨</span> Colour Master
                    </a>
                    <a class="s-link s-sublink @(ctrl == "Size" ? "active" : "")"
                       asp-controller="Size" asp-action="Index">
                        <span class="ico">📏</span> Size Master
                    </a>
                    <a class="s-link s-sublink @(ctrl == "ProcessMaster" ? "active" : "")"
                       asp-controller="ProcessMaster" asp-action="Index">
                        <span class="ico">🔄</span> Process Master
                    </a>
                    @if (isAdmin)
                    {
                        <a class="s-link s-sublink @(ctrl == "Company" ? "active" : "")"
                           asp-controller="Company" asp-action="Index">
                            <span class="ico">🏢</span> Company Master
                        </a>
                    }
                </div>
            }

            @if (role == "Admin" || role == "Manager")
            {
                <a class="s-link s-link-toggle @(ctrl == "Dying" || ctrl == "RollPress" ? "open" : "")" onclick="toggleNav(this)">
                    <span class="ico">🏭</span> Job Work Entry
                    <span class="nav-arrow">▾</span>
                </a>
                <div class="s-submenu @(ctrl == "Dying" || ctrl == "RollPress" ? "" : "d-none")">
                    <a class="s-link s-sublink @(ctrl == "Dying" ? "active" : "")"
                       asp-controller="Dying" asp-action="Index">
                        <span class="ico">🎨</span> Dying Entry
                    </a>
                    <a class="s-link s-sublink @(ctrl == "RollPress" ? "active" : "")"
                       asp-controller="RollPress" asp-action="Index">
                        <span class="ico">🧵</span> Roll Press Entry
                    </a>
                </div>
            }

            <div class="nav-label">Production</div>
            <a class="s-link s-link-toggle @(ctrl == "Production" || ctrl == "PMS" || ctrl == "QualityControl" || ctrl == "JobSlip" || (ctrl == "ReadyProduct" && action == "Assemble") ? "open" : "")" onclick="toggleNav(this)">
                <span class="ico">📦</span> Production Work
                <span class="nav-arrow">▾</span>
            </a>
            <div class="s-submenu @(ctrl == "Production" || ctrl == "PMS" || ctrl == "QualityControl" || ctrl == "JobSlip" || (ctrl == "ReadyProduct" && action == "Assemble") ? "" : "d-none")">
                <a class="s-link s-sublink @(ctrl == "PMS" && action == "Index" ? "active" : "")"
                   asp-controller="PMS" asp-action="Index">
                    <span class="ico">📊</span> Dashboard (WIP)
                </a>
                <a class="s-link s-sublink @(ctrl == "Production" ? "active" : "")"
                   asp-controller="Production" asp-action="Index">
                    <span class="ico">📋</span> Order Lots (Plans)
                </a>
                <a class="s-link s-sublink @(ctrl == "JobSlip" ? "active" : "")"
                   asp-controller="JobSlip" asp-action="Index">
                    <span class="ico">📑</span> Job Slips (Challans)
                </a>
                <a class="s-link s-sublink @(ctrl == "PMS" && (action == "ProcessTracking" || action == "ProductionEntities") ? "active" : "")"
                   asp-controller="PMS" asp-action="ProcessTracking">
                    <span class="ico">🔄</span> Process & Piece Tracking
                </a>
                <a class="s-link s-sublink @(ctrl == "QualityControl" ? "active" : "")"
                   asp-controller="QualityControl" asp-action="Index">
                    <span class="ico">🔍</span> Quality Control (QC)
                </a>
                <a class="s-link s-sublink @(ctrl == "Barcode" && action == "Scanner" ? "active" : "")"
                   asp-controller="Barcode" asp-action="Scanner">
                    <span class="ico">📱</span> Barcode Scanner
                </a>
                <a class="s-link s-sublink @(ctrl == "Barcode" && action == "ConfigureTag" ? "active" : "")"
                   asp-controller="Barcode" asp-action="ConfigureTag">
                    <span class="ico">🏷️</span> Configure Barcode Tag
                </a>
            </div>

            @if (canViewUserMgmt)
            {
                <div class="nav-label">Users</div>
                <a class="s-link s-link-toggle @(ctrl == "UserManagement" || ctrl == "Role" ? "open" : "")" onclick="toggleNav(this)">
                    <span class="ico">👥</span> User Management
                    <span class="nav-arrow">▾</span>
                </a>
                <div class="s-submenu @(ctrl == "UserManagement" || ctrl == "Role" ? "" : "d-none")">
                    <a class="s-link s-sublink @(ctrl == "UserManagement" && action == "Index" ? "active" : "")"
                       asp-controller="UserManagement" asp-action="Index">
                        <span class="ico">📋</span> User List
                    </a>
                    @if (isAdmin)
                    {
                        <a class="s-link s-sublink @(ctrl == "Role" ? "active" : "")"
                           asp-controller="Role" asp-action="Index">
                            <span class="ico">🔐</span> Role List
                        </a>
                    }
                </div>
            }

            <div class="nav-label">HR & Payroll</div>
            <a class="s-link s-link-toggle @(ctrl == "Employee" || ctrl == "Attendance" || ctrl == "Salary" ? "open" : "")" onclick="toggleNav(this)">
                <span class="ico">👥</span> Attendance & HR
                <span class="nav-arrow">▾</span>
            </a>
            <div class="s-submenu @(ctrl == "Employee" || ctrl == "Attendance" || ctrl == "Salary" ? "" : "d-none")">
                <a class="s-link s-sublink @(ctrl == "Attendance" && action == "Kiosk" ? "active" : "")"
                   asp-controller="Attendance" asp-action="Kiosk">
                    <span class="ico">📷</span> Face Scanner Kiosk
                </a>
                <a class="s-link s-sublink @(ctrl == "Attendance" && action == "Index" ? "active" : "")"
                   asp-controller="Attendance" asp-action="Index">
                    <span class="ico">📅</span> Daily Register
                </a>
                <a class="s-link s-sublink @(ctrl == "Attendance" && action == "MonthlyReport" ? "active" : "")"
                   asp-controller="Attendance" asp-action="MonthlyReport">
                    <span class="ico">📊</span> Attendance Grid
                </a>
                <a class="s-link s-sublink @(ctrl == "Employee" ? "active" : "")"
                   asp-controller="Employee" asp-action="Index">
                    <span class="ico">👤</span> Employees
                </a>
                <a class="s-link s-sublink @(ctrl == "Salary" ? "active" : "")"
                   asp-controller="Salary" asp-action="Index">
                    <span class="ico">💵</span> Salary & Payroll
                </a>
                <a class="s-link s-sublink @(ctrl == "BiometricDevice" ? "active" : "")"
                   asp-controller="BiometricDevice" asp-action="Index">
                    <span class="ico">📟</span> Biometric Terminals
                </a>
            </div>

            @if (isAdmin || role == "Manager" || role == "System Admin" || User.HasClaim("Permission.Accounting.CanView", "true"))
            {
                <div class="nav-label">Finance & Accounts</div>
                <a class="s-link @(ctrl == "Invoice" ? "active" : "")"
                   asp-controller="Invoice" asp-action="Index">
                    <span class="ico">🧾</span> Tax Invoices
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "ChartOfAccounts" ? "active" : "")"
                   asp-controller="Accounting" asp-action="ChartOfAccounts">
                    <span class="ico">🏛️</span> Chart of Accounts
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "JournalEntries" ? "active" : "")"
                   asp-controller="Accounting" asp-action="JournalEntries">
                    <span class="ico">📖</span> Journal Entries
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "TrialBalance" ? "active" : "")"
                   asp-controller="Accounting" asp-action="TrialBalance">
                    <span class="ico">⚖️</span> Trial Balance
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "ProfitAndLoss" ? "active" : "")"
                   asp-controller="Accounting" asp-action="ProfitAndLoss">
                    <span class="ico">📈</span> Profit &amp; Loss
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "BalanceSheet" ? "active" : "")"
                   asp-controller="Accounting" asp-action="BalanceSheet">
                    <span class="ico">📊</span> Balance Sheet
                </a>
                <a class="s-link @(ctrl == "GstReturn" ? "active" : "")"
                   asp-controller="GstReturn" asp-action="Index">
                    <span class="ico">🇮🇳</span> GST Returns &amp; Filing
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "Index" ? "active" : "")"
                   asp-controller="Accounting" asp-action="Index">
                    <span class="ico">💰</span> Cash &amp; Bank Ledger
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "AgedReceivables" ? "active" : "")"
                   asp-controller="Accounting" asp-action="AgedReceivables">
                    <span class="ico">👥</span> Aged Receivables (AR)
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "AgedPayables" ? "active" : "")"
                   asp-controller="Accounting" asp-action="AgedPayables">
                    <span class="ico">🏢</span> Aged Payables (AP)
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "ThreeWayMatching" ? "active" : "")"
                   asp-controller="Accounting" asp-action="ThreeWayMatching">
                    <span class="ico">🔍</span> 3-Way Matching
                </a>
                <a class="s-link @(ctrl == "Accounting" && action == "Commissions" ? "active" : "")"
                   asp-controller="Accounting" asp-action="Commissions">
                    <span class="ico">🤝</span> Salesman Commission
                </a>
            }

            @if (isAdmin)
            {
                <div class="nav-label">Organization</div>
                <a class="s-link @(ctrl == "Subscription" ? "active" : "")"
                   asp-controller="Subscription" asp-action="Index">
                    <span class="ico">☁️</span> Subscription &amp; Quotas
                </a>
            }
        </nav>

        <div class="role-pill rp-@role">@role</div>
    </aside>

    <div class="topbar">
        <div class="topbar-left">
            <span class="page-title">@(ViewData["Title"] ?? "Dashboard")</span>
        </div>
        <div class="d-flex align-items-center gap-2.5">
            <!-- Odoo-Style Company Switcher -->
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 bg-white px-3 py-1.5 shadow-sm border" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px; font-weight: 500; font-size: 0.82rem;">
                    <i class="bi bi-buildings-fill text-primary"></i>
                    <span class="text-truncate" style="max-width: 170px;">@activeCompany.CompanyName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2 border-0" style="min-width: 260px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;">
                    <li class="px-3 py-2 border-bottom bg-light rounded-top">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">Active Company</span>
                            <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.65rem;">@activeCompany.CompanyCode</span>
                        </div>
                    </li>
                    @foreach (var c in userCompanies)
                    {
                        var isCurrent = c.Id == activeCompany.Id;
                        <li>
                            <a class="dropdown-item py-2 px-3 d-flex align-items-center justify-content-between @(isCurrent ? "bg-primary-subtle text-primary fw-bold" : "")"
                               asp-controller="Company" asp-action="Switch" asp-route-companyId="@c.Id" asp-route-returnUrl="@Context.Request.Path">
                                <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                    <i class="bi bi-circle-fill @(isCurrent ? "text-primary" : "text-secondary")" style="font-size: 0.45rem;"></i>
                                    <span class="text-truncate">@c.CompanyName</span>
                                </div>
                                @if (isCurrent)
                                {
                                    <i class="bi bi-check-circle-fill text-primary" style="font-size: 0.95rem;"></i>
                                }
                            </a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item py-2 px-3 text-primary small d-flex align-items-center gap-2" asp-controller="Company" asp-action="Index">
                                <i class="bi bi-gear-fill"></i> Manage Companies
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- User Chip -->
            <div class="user-chip dropdown">
                <div class="d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                    <div class="u-avatar">@initials</div>
                    <div>
                        <div class="u-name">@fullName</div>
                        <div class="u-role">@role</div>
                    </div>
                    <span class="ms-1" style="font-size:0.75rem; color:#94a3b8;">▾</span>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" style="min-width: 220px; border-radius: 8px; border: 1px solid #e2e8f0; padding: 0.5rem;">
                    <li class="px-3 py-2 border-bottom mb-1">
                        <div class="fw-bold text-dark" style="font-size:0.9rem;">@fullName</div>
                        <div class="small text-muted">Role: <span class="badge bg-primary" style="font-size:0.72rem;">@role</span></div>
                    </li>
                    <li>
                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="ChangePassword">
                            <span>🔑</span> Change Password
                        </a>
                    </li>
                    @if (canViewUserMgmt)
                    {
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="UserManagement" asp-action="Index">
                                <span>👥</span> User Management
                            </a>
                        </li>
                    }
                    @if (isAdmin)
                    {
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-primary fw-semibold" asp-controller="Subscription" asp-action="Index">
                                <span>☁️</span> SaaS Subscription & Quotas
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger w-100 border-0 bg-transparent text-start">
                                <span>🚪</span> Sign Out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    }

    <div class="main-wrap">
        <div class="page-body">
            @RenderBody()
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleNav(el) {
        el.classList.toggle('open');
        var sub = el.nextElementSibling;
        sub.classList.toggle('d-none');
    }
    document.addEventListener('click', function(e) {
        if (e.target.closest('.alert-close')) {
            e.target.closest('.af-alert').remove();
        }
    });
</script>
<!-- Global Print Watermark -->
<div class="print-watermark-container" aria-hidden="true">
    <img src="~/images/aashana_watermark.png" alt="Aashana Fashion Watermark" class="print-watermark-img" />
</div>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
