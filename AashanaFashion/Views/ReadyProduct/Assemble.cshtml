@model AashanaFashion.Models.ReadyProductAssemblyViewModel
@{
    ViewData["Title"] = "3-Piece Set Assembly";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Ready inventory</a>
        <h1 class="page-title">3-Piece Set Assembly from Production</h1>
        <p class="page-sub">Assemble production pieces (Chaniya, Choli, Duppata) of identical design, colour and size into complete ready products.</p>
    </div>
</div>

<div class="data-card mb-4">
    <div class="data-card-body d-flex flex-wrap align-items-center justify-content-between gap-4">
        <div style="max-width: 640px;">
            <div class="panel-title mb-1"><i class="bi bi-info-circle"></i> How set assembly works</div>
            <p class="text-sm text-muted mb-0">
                One ready set requires exactly <strong>1 Chaniya</strong> + <strong>1 Choli</strong> + <strong>1 Duppata</strong> of matching design, colour and size.
                The table below scans completed production pieces and computes the maximum complete sets that can be assembled.
            </p>
        </div>
        <div class="flow">
            <span class="flow-step"><span class="flow-num">1</span>Chaniya</span>
            <i class="bi bi-plus flow-sep"></i>
            <span class="flow-step"><span class="flow-num">1</span>Choli</span>
            <i class="bi bi-plus flow-sep"></i>
            <span class="flow-step"><span class="flow-num">1</span>Duppata</span>
            <i class="bi bi-arrow-right flow-sep"></i>
            <span class="flow-step done"><span class="flow-num"><i class="bi bi-check"></i></span>1 ready set</span>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="data-card-header">
        <span class="data-card-title"><i class="bi bi-list-check"></i> Production matching candidates</span>
        <span class="af-badge b-green">@Model.Candidates.Count(c => c.AssembledSetsAvailable > 0) combinations ready</span>
    </div>
    @if (Model.Candidates.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Design</th>
                        <th>Colour</th>
                        <th>Size</th>
                        <th class="text-end">Chaniya</th>
                        <th class="text-end">Choli</th>
                        <th class="text-end">Duppata</th>
                        <th class="text-center">Max Ready Sets</th>
                        <th class="text-end">Existing Ready Stock</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Candidates)
                    {
                        var hasAvailable = item.AssembledSetsAvailable > 0;
                        var photoSrc = !string.IsNullOrEmpty(item.DesignPhotoPath) ? item.DesignPhotoPath : "/images/placeholder-product.svg";

                        <tr class="@(!hasAvailable ? "opacity-75" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@photoSrc" alt="@item.DesignNumber" class="thumb" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                    <div>
                                        <span class="cell-title">@item.DesignNumber</span>
                                        <span class="cell-sub">Design ID @item.DesignId</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="tag">@item.Colour</span></td>
                            <td><span class="tag">@item.Size</span></td>
                            <td class="cell-num"><span class="@(item.ChaniyaCount > 0 ? "text-foreground fw-medium" : "text-placeholder")">@item.ChaniyaCount</span></td>
                            <td class="cell-num"><span class="@(item.CholiCount > 0 ? "text-foreground fw-medium" : "text-placeholder")">@item.CholiCount</span></td>
                            <td class="cell-num"><span class="@(item.DuppataCount > 0 ? "text-foreground fw-medium" : "text-placeholder")">@item.DuppataCount</span></td>
                            <td class="text-center">
                                @if (hasAvailable)
                                {
                                    <span class="af-badge b-green">@item.AssembledSetsAvailable sets</span>
                                }
                                else
                                {
                                    <span class="af-badge b-gray">Incomplete</span>
                                }
                            </td>
                            <td class="cell-num">
                                @if (item.ExistingReadyProductId.HasValue)
                                {
                                    <a asp-action="Details" asp-route-id="@item.ExistingReadyProductId.Value">@item.ExistingReadyStock sets <i class="bi bi-box-arrow-up-right"></i></a>
                                }
                                else
                                {
                                    <span class="text-muted">None (new)</span>
                                }
                            </td>
                            <td class="cell-actions">
                                @if (hasAvailable)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-sm assemble-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#assembleModal"
                                            data-designid="@item.DesignId"
                                            data-designnumber="@item.DesignNumber"
                                            data-colour="@item.Colour"
                                            data-size="@item.Size"
                                            data-maxsets="@item.AssembledSetsAvailable">
                                        <i class="bi bi-puzzle"></i> Assemble
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary" disabled title="Requires at least 1 Chaniya, 1 Choli, and 1 Duppata">Missing parts</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-puzzle"></i></div>
            <div class="es-title">No complete sets yet</div>
            <p>No production pieces match complete sets yet. You can also add ready products manually.</p>
            <a asp-action="Create" class="btn btn-secondary">Add Ready Product</a>
        </div>
    }
</div>

<!-- Assemble Confirmation Modal -->
<div class="modal fade" id="assembleModal" tabindex="-1" aria-labelledby="assembleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AssembleSets" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="designId" id="modalDesignId" />
                <input type="hidden" name="colour" id="modalColour" />
                <input type="hidden" name="size" id="modalSize" />

                <div class="modal-header">
                    <h5 class="modal-title" id="assembleModalLabel"><i class="bi bi-puzzle"></i> Assemble ready product sets</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="panel-inset mb-3">
                        <div class="kv-row"><span class="k">Design</span><span class="v" id="modalDesignNumber">—</span></div>
                        <div class="kv-row"><span class="k">Colour</span><span class="tag" id="modalColourBadge">—</span></div>
                        <div class="kv-row"><span class="k">Size</span><span class="tag" id="modalSizeBadge">—</span></div>
                        <div class="kv-row"><span class="k">Max sets available</span><span class="v text-success" id="modalMaxSetsText">—</span></div>
                    </div>

                    <div class="mb-3">
                        <label for="modalSetsToAssemble" class="form-label">Number of sets to assemble <span class="req">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                            <input type="number" name="setsToAssemble" id="modalSetsToAssemble" class="form-control" min="1" required />
                        </div>
                        <div class="form-text">Each set requires 1 Chaniya + 1 Choli + 1 Duppata.</div>
                    </div>

                    <div class="mb-0">
                        <label for="modalNotes" class="form-label">Notes / assembly batch reference</label>
                        <input type="text" name="notes" id="modalNotes" class="form-control" placeholder="e.g. Assembled for Diwali dispatch" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assemble &amp; inward stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.assemble-btn').on('click', function () {
                var designId = $(this).data('designid');
                var designNumber = $(this).data('designnumber');
                var colour = $(this).data('colour');
                var size = $(this).data('size');
                var maxSets = $(this).data('maxsets');

                $('#modalDesignId').val(designId);
                $('#modalColour').val(colour);
                $('#modalSize').val(size);

                $('#modalDesignNumber').text(designNumber);
                $('#modalColourBadge').text(colour);
                $('#modalSizeBadge').text(size);
                $('#modalMaxSetsText').text(maxSets + ' sets');

                $('#modalSetsToAssemble').attr('max', maxSets).val(maxSets);
            });
        });
    </script>
}
