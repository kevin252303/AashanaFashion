@model AashanaFashion.Models.ReadyProductStockAdjustViewModel
@{
    ViewData["Title"] = $"Adjust Stock - {Model.DesignNumber}";
    var photoSrc = !string.IsNullOrEmpty(Model.PhotoPath) ? Model.PhotoPath : "/images/placeholder-product.svg";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Breadcrumb -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Ready Products</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ReadyProductId" class="text-decoration-none text-muted">@Model.DesignNumber (@Model.Colour, @Model.Size)</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Adjust Stock</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-arrow-left-right text-warning me-2"></i>Stock Adjustment
            </h3>
            <p class="text-muted small mb-0">Record manual stock inward, audit corrections, or damaged/scrapped piece write-offs.</p>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.ReadyProductId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Product
            </a>
        </div>
    </div>

    <form asp-action="AdjustStock" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReadyProductId" />
        <input type="hidden" asp-for="DesignNumber" />
        <input type="hidden" asp-for="Colour" />
        <input type="hidden" asp-for="Size" />
        <input type="hidden" asp-for="CurrentStock" id="currentStockHidden" />
        <input type="hidden" asp-for="PhotoPath" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

        <div class="row g-4">
            <!-- Product Summary Card -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
                    <div class="bg-light p-3 text-center border-bottom">
                        <img src="@photoSrc" 
                             alt="@Model.DesignNumber" 
                             class="img-fluid rounded-3" 
                             style="max-height: 240px; object-fit: contain;" 
                             onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                    </div>
                    <div class="card-body p-4">
                        <h4 class="fw-bold text-dark mb-1">@Model.DesignNumber</h4>
                        <div class="mb-3">
                            <span class="badge bg-secondary me-1">@Model.Colour</span>
                            <span class="badge bg-dark">Size: @Model.Size</span>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted small">Current Stock on Hand:</span>
                                <span class="fs-4 fw-bold text-dark">@Model.CurrentStock <span class="fs-6 fw-normal text-muted">sets</span></span>
                            </div>
                            <small class="text-muted d-block">Each set = 1 Chaniya + 1 Choli + 1 Duppata</small>
                        </div>

                        <!-- Live Projection Card -->
                        <div class="p-3 rounded-3 border border-primary border-opacity-25 bg-primary bg-opacity-10 text-center">
                            <span class="text-muted small d-block">Projected New Stock Balance:</span>
                            <span id="projectedBalance" class="fs-2 fw-bold text-primary">@Model.CurrentStock</span>
                            <span class="text-muted small d-block">sets after adjustment</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Adjustment Form Inputs -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">
                            <i class="bi bi-sliders text-primary me-2"></i>Adjustment Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <!-- Type of adjustment -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">Adjustment Action <span class="text-danger">*</span></label>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <div class="form-check p-3 border rounded-3 bg-light d-flex align-items-center">
                                            <input class="form-check-input me-2" type="radio" asp-for="AdjustmentType" value="Add" id="typeAdd" checked />
                                            <label class="form-check-label fw-semibold text-success" for="typeAdd">
                                                <i class="bi bi-plus-circle me-1"></i> Add (+) Inward
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check p-3 border rounded-3 bg-light d-flex align-items-center">
                                            <input class="form-check-input me-2" type="radio" asp-for="AdjustmentType" value="Deduct" id="typeDeduct" />
                                            <label class="form-check-label fw-semibold text-danger" for="typeDeduct">
                                                <i class="bi bi-dash-circle me-1"></i> Deduct (-) Outward
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check p-3 border rounded-3 bg-light d-flex align-items-center">
                                            <input class="form-check-input me-2" type="radio" asp-for="AdjustmentType" value="SetExact" id="typeSetExact" />
                                            <label class="form-check-label fw-semibold text-primary" for="typeSetExact">
                                                <i class="bi bi-check2-all me-1"></i> Set Exact Count
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="AdjustmentType" class="text-danger small"></span>
                            </div>

                            <!-- Quantity -->
                            <div class="col-md-6">
                                <label asp-for="Quantity" id="qtyLabel" class="form-label fw-semibold">Quantity to Add (Sets) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-boxes"></i></span>
                                    <input asp-for="Quantity" id="qtyInput" type="number" min="1" class="form-control form-control-lg" required />
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>

                            <!-- Reference / Challan Number -->
                            <div class="col-md-6">
                                <label asp-for="ReferenceNumber" class="form-label fw-semibold">Reference / Doc No.</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-hash"></i></span>
                                    <input asp-for="ReferenceNumber" class="form-control form-control-lg" placeholder="e.g. ADJ-001, CH-892" />
                                </div>
                                <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                            </div>

                            <!-- Reason / Notes -->
                            <div class="col-12">
                                <label asp-for="Reason" class="form-label fw-semibold">Reason for Adjustment <span class="text-danger">*</span></label>
                                <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Provide audit reason (e.g. Physical inventory count verified, Customer returned garment, Found defective during packing, etc.)" required></textarea>
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-warning btn-lg text-dark fw-semibold px-4 shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Confirm Stock Adjustment
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.ReadyProductId" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var currentStock = parseInt($('#currentStockHidden').val()) || 0;

            function recalculateProjection() {
                var type = $('input[name="AdjustmentType"]:checked').val();
                var qty = parseInt($('#qtyInput').val()) || 0;
                var projected = currentStock;

                if (type === 'Add') {
                    $('#qtyLabel').text('Quantity to Add (Sets)');
                    projected = currentStock + qty;
                } else if (type === 'Deduct') {
                    $('#qtyLabel').text('Quantity to Deduct (Sets)');
                    projected = currentStock - qty;
                } else if (type === 'SetExact') {
                    $('#qtyLabel').text('Exact New Stock Count (Sets)');
                    projected = qty;
                }

                $('#projectedBalance').text(projected);

                if (projected < 0) {
                    $('#projectedBalance').removeClass('text-primary text-success').addClass('text-danger');
                } else {
                    $('#projectedBalance').removeClass('text-danger').addClass('text-primary');
                }
            }

            $('input[name="AdjustmentType"]').on('change', recalculateProjection);
            $('#qtyInput').on('input change', recalculateProjection);

            recalculateProjection();
        });
    </script>
}
