@model AashanaFashion.Models.ReadyProductStockAdjustViewModel
@{
    ViewData["Title"] = $"Adjust Stock - {Model.DesignNumber}";
    var photoSrc = !string.IsNullOrEmpty(Model.PhotoPath) ? Model.PhotoPath : "/images/placeholder-product.svg";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Ready Products</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ReadyProductId">@Model.DesignNumber (@Model.Colour, @Model.Size)</a></li>
                <li class="breadcrumb-item active" aria-current="page">Adjust Stock</li>
            </ol>
        </nav>
        <h1 class="page-title">Stock Adjustment</h1>
        <p class="page-sub">Record manual stock inward, audit corrections, or damaged/scrapped piece write-offs.</p>
    </div>
</div>

<form asp-action="AdjustStock" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReadyProductId" />
    <input type="hidden" asp-for="DesignNumber" />
    <input type="hidden" asp-for="Colour" />
    <input type="hidden" asp-for="Size" />
    <input type="hidden" asp-for="CurrentStock" id="currentStockHidden" />
    <input type="hidden" asp-for="PhotoPath" />

    <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="data-card">
                <div class="bg-raised p-3 text-center border-bottom">
                    <img src="@photoSrc"
                         alt="@Model.DesignNumber"
                         class="img-fluid rounded"
                         style="max-height: 240px; object-fit: contain;"
                         onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                </div>
                <div class="data-card-body">
                    <div class="ql-title mb-2">@Model.DesignNumber</div>
                    <div class="d-flex gap-1 mb-3">
                        <span class="tag">@Model.Colour</span>
                        <span class="tag">Size @Model.Size</span>
                    </div>

                    <div class="panel-inset">
                        <div class="kv-row"><span class="k">Current stock on hand</span><span class="v">@Model.CurrentStock sets</span></div>
                        <div class="text-xs text-muted">Each set = 1 Chaniya + 1 Choli + 1 Duppata</div>
                    </div>

                    <div class="metric-card text-center">
                        <div class="metric-label">Projected new balance</div>
                        <div class="metric-value"><span id="projectedBalance" class="text-primary">@Model.CurrentStock</span></div>
                        <div class="metric-meta">sets after adjustment</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="data-card">
                <div class="data-card-header">
                    <span class="data-card-title"><i class="bi bi-sliders"></i> Adjustment details</span>
                </div>
                <div class="data-card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Adjustment action <span class="req">*</span></label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="option-card" for="typeAdd">
                                        <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="Add" id="typeAdd" checked />
                                        <i class="bi bi-plus-circle"></i> Add (+) inward
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="option-card" for="typeDeduct">
                                        <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="Deduct" id="typeDeduct" />
                                        <i class="bi bi-dash-circle"></i> Deduct (−) outward
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="option-card" for="typeSetExact">
                                        <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="SetExact" id="typeSetExact" />
                                        <i class="bi bi-check2-all"></i> Set exact count
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="AdjustmentType" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Quantity" id="qtyLabel" class="form-label">Quantity to Add (Sets) <span class="req">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                                <input asp-for="Quantity" id="qtyInput" type="number" min="1" class="form-control" required />
                            </div>
                            <span asp-validation-for="Quantity" class="af-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReferenceNumber" class="form-label">Reference / Doc No.</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g. ADJ-001, CH-892" />
                            </div>
                            <span asp-validation-for="ReferenceNumber" class="af-error"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Reason" class="form-label">Reason for adjustment <span class="req">*</span></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Provide audit reason (e.g. physical inventory count verified, customer returned garment, found defective during packing)" required></textarea>
                            <span asp-validation-for="Reason" class="af-error"></span>
                        </div>
                    </div>
                </div>
                <div class="data-card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.ReadyProductId" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Confirm stock adjustment</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var currentStock = parseInt($('#currentStockHidden').val()) || 0;

            function recalculateProjection() {
                var type = $('input[name="AdjustmentType"]:checked').val();
                var qty = parseInt($('#qtyInput').val()) || 0;
                var projected = currentStock;

                if (type === 'Add') {
                    $('#qtyLabel').text('Quantity to Add (Sets)');
                    projected = currentStock + qty;
                } else if (type === 'Deduct') {
                    $('#qtyLabel').text('Quantity to Deduct (Sets)');
                    projected = currentStock - qty;
                } else if (type === 'SetExact') {
                    $('#qtyLabel').text('Exact New Stock Count (Sets)');
                    projected = qty;
                }

                $('#projectedBalance').text(projected);

                if (projected < 0) {
                    $('#projectedBalance').removeClass('text-primary text-success').addClass('text-danger');
                } else {
                    $('#projectedBalance').removeClass('text-danger').addClass('text-primary');
                }
            }

            $('input[name="AdjustmentType"]').on('change', recalculateProjection);
            $('#qtyInput').on('input change', recalculateProjection);

            recalculateProjection();
        });
    </script>
}
