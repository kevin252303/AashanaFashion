@model AashanaFashion.Models.ReadyProductIndexViewModel
@{
    ViewData["Title"] = "Ready Product Inventory";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool canManage = role == "Admin" || role == "SuperAdmin" || role == "System Admin" || role == "Manager";

    string StatusBadge(AashanaFashion.Models.ReadyProductStatus s) => s switch
    {
        AashanaFashion.Models.ReadyProductStatus.InStock => "b-green",
        AashanaFashion.Models.ReadyProductStatus.LowStock => "b-yellow",
        AashanaFashion.Models.ReadyProductStatus.Discontinued => "b-gray",
        _ => "b-red"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Ready Product Inventory</h1>
        <p class="page-sub">Finished 3-piece sets (1 Chaniya + 1 Choli + 1 Duppata) are inwarded automatically when production lots reach <strong>Ready to Dispatch</strong>.</p>
    </div>
    <div class="page-actions">
        @if (canManage)
        {
            <form asp-action="SyncCompletedLots" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary" title="Inward stock for any completed lots that have not been inwarded yet">
                    <i class="bi bi-arrow-repeat"></i> Sync completed lots
                </button>
            </form>
        }
        <a asp-action="Ledger" class="btn btn-secondary"><i class="bi bi-journal-text"></i> Stock Ledger</a>
        @if (canManage)
        {
            <a asp-action="Outward" class="btn btn-secondary"><i class="bi bi-box-arrow-up"></i> Outward Dispatch</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Ready Stock</a>
        }
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Ready sets in stock</div>
        <div class="metric-value">@Model.TotalReadySets.ToString("N0") <span class="metric-suffix">sets</span></div>
        <div class="metric-meta">across @Model.TotalDesignsCount distinct designs</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total retail value</div>
        <div class="metric-value">₹@Model.TotalInventoryValue.ToString("N2")</div>
        <div class="metric-meta">production cost ₹@Model.TotalCostValue.ToString("N2")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Stock health</div>
        <div class="d-flex gap-2 align-items-center my-1">
            <span class="af-badge b-green">@Model.InStockCount healthy</span>
            <span class="af-badge b-yellow">@Model.LowStockCount low</span>
        </div>
        <div class="metric-meta @(Model.OutOfStockCount > 0 ? "danger" : "")">@(Model.OutOfStockCount) variant(s) out of stock</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Outfit set rule</div>
        <div class="text-sm text-foreground fw-medium my-1">1 Set = 1 Chaniya + 1 Choli + 1 Duppata</div>
        <div class="metric-meta">pieces match in design, colour &amp; size</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar align-end">
        <input type="hidden" name="viewMode" value="@Model.ViewMode" />
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="rpSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="rpSearch" name="search" value="@Model.Search" placeholder="Design, SKU, barcode, rack…" class="af-input" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="rpDesign">Design</label>
                <select id="rpDesign" name="designId" class="af-input af-select">
                    <option value="">All designs</option>
                    @if (ViewBag.Designs != null)
                    {
                        @foreach (var d in (List<AashanaFashion.Models.Design>)ViewBag.Designs)
                        {
                            <option value="@d.Id" selected="@(Model.DesignId == d.Id)">@d.DesignNumber</option>
                        }
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="rpColour">Colour</label>
                <select id="rpColour" name="colour" class="af-input af-select">
                    <option value="">All colours</option>
                    @if (ViewBag.Colours != null)
                    {
                        @foreach (var c in (List<string>)ViewBag.Colours)
                        {
                            <option value="@c" selected="@(Model.Colour == c)">@c</option>
                        }
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="rpSize">Size</label>
                <select id="rpSize" name="size" class="af-input af-select" style="min-width: 100px;">
                    <option value="">All</option>
                    @if (ViewBag.Sizes != null)
                    {
                        @foreach (var s in (List<string>)ViewBag.Sizes)
                        {
                            <option value="@s" selected="@(Model.Size == s)">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="rpStatus">Stock status</label>
                <select id="rpStatus" name="status" class="af-input af-select">
                    <option value="">All statuses</option>
                    @foreach (AashanaFashion.Models.ReadyProductStatus st in Enum.GetValues(typeof(AashanaFashion.Models.ReadyProductStatus)))
                    {
                        <option value="@st" selected="@(Model.Status == st)">@st.Humanize()</option>
                    }
                </select>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Index" class="btn btn-ghost" title="Reset">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
            <div class="segmented" role="group" aria-label="View mode">
                <a asp-action="Index" asp-route-viewMode="grid" asp-route-search="@Model.Search" asp-route-designId="@Model.DesignId" asp-route-colour="@Model.Colour" asp-route-size="@Model.Size" asp-route-status="@Model.Status"
                   class="segment @(Model.ViewMode == "grid" ? "active" : "")" title="Picture cards" aria-label="Picture cards"><i class="bi bi-grid-3x2-gap"></i></a>
                <a asp-action="Index" asp-route-viewMode="table" asp-route-search="@Model.Search" asp-route-designId="@Model.DesignId" asp-route-colour="@Model.Colour" asp-route-size="@Model.Size" asp-route-status="@Model.Status"
                   class="segment @(Model.ViewMode == "table" ? "active" : "")" title="Table" aria-label="Table"><i class="bi bi-list-ul"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.ReadyProducts.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-box-seam"></i></div>
            <div class="es-title">No ready products found</div>
            <p>No finished garment sets match your filters or have been added yet.</p>
            @if (canManage)
            {
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Create" class="btn btn-secondary"><i class="bi bi-plus-lg"></i> Add ready stock</a>
                    <a asp-action="Assemble" class="btn btn-secondary"><i class="bi bi-stars"></i> Assemble sets from production</a>
                </div>
            }
        </div>
    }
    else if (Model.ViewMode == "grid")
    {
        <div class="data-card-body bg-raised">
            <div class="row g-3">
                @foreach (var item in Model.ReadyProducts)
                {
                    var photo = !string.IsNullOrEmpty(item.PhotoPath) ? item.PhotoPath : (item.Design?.PhotoPath ?? "");
                    <div class="col-sm-6 col-md-4 col-xl-3">
                        <div class="product-card">
                            <div class="product-card-media">
                                @if (!string.IsNullOrEmpty(photo))
                                {
                                    <img src="@photo" alt="@item.DesignNumber - @item.Colour" class="cursor-pointer"
                                         onclick="previewImage('@photo', '@item.DesignNumber — @item.Colour (@item.Size)')" />
                                }
                                else
                                {
                                    <div class="product-card-placeholder"><i class="bi bi-image"></i><span>No picture uploaded</span></div>
                                }
                                <span class="af-badge @StatusBadge(item.CurrentStatus) product-card-status">@item.CurrentStatus.Humanize()</span>
                            </div>

                            <div class="product-card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <div class="ql-title text-truncate">@item.DesignNumber</div>
                                        <div class="text-xs text-muted text-truncate font-monospace">@item.Sku</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-foreground fw-semibold tabular">₹@item.UnitPrice.ToString("N0")</div>
                                        @if (item.CostPrice > 0)
                                        {
                                            <div class="text-xs text-muted tabular">Cost ₹@item.CostPrice.ToString("N0")</div>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-1">
                                    <span class="tag">@item.Colour</span>
                                    <span class="tag">Size @item.Size</span>
                                    @if (!string.IsNullOrEmpty(item.WarehouseLocation))
                                    {
                                        <span class="tag"><i class="bi bi-geo-alt text-placeholder"></i> @item.WarehouseLocation</span>
                                    }
                                </div>

                                <div class="text-xs text-muted">3-piece set · 1 Chaniya · 1 Choli · 1 Duppata</div>

                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                    <div>
                                        <div class="text-xs text-muted">On hand</div>
                                        <div class="fw-semibold tabular @(item.QuantityOnHand > 0 ? "text-foreground" : "text-danger")">@item.QuantityOnHand <span class="text-xs text-muted fw-normal">sets</span></div>
                                    </div>
                                    <div class="row-actions">
                                        @if (canManage)
                                        {
                                            <a asp-action="Outward" asp-route-id="@item.Id" class="row-action" title="Outward / dispatch" aria-label="Outward"><i class="bi bi-box-arrow-up"></i></a>
                                            <a asp-action="AdjustStock" asp-route-id="@item.Id" class="row-action" title="Adjust stock" aria-label="Adjust stock"><i class="bi bi-sliders"></i></a>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary ms-1">Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.ReadyProducts.Count</strong> outfits</span>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">Picture</th>
                        <th>SKU / Barcode</th>
                        <th>Design</th>
                        <th>Colour</th>
                        <th>Size</th>
                        <th>Set Composition</th>
                        <th>Location</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Stock</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReadyProducts)
                    {
                        var photo = !string.IsNullOrEmpty(item.PhotoPath) ? item.PhotoPath : (item.Design?.PhotoPath ?? "");
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(photo))
                                {
                                    <img src="@photo" alt="@item.DesignNumber" class="thumb cursor-pointer"
                                         onclick="previewImage('@photo', '@item.DesignNumber — @item.Colour (@item.Size)')" />
                                }
                                else
                                {
                                    <div class="thumb d-flex align-items-center justify-content-center text-placeholder"><i class="bi bi-image"></i></div>
                                }
                            </td>
                            <td><a asp-action="Details" asp-route-id="@item.Id" class="font-monospace text-xs fw-medium">@item.Sku</a></td>
                            <td>
                                <span class="cell-title">@item.DesignNumber</span>
                                @if (!string.IsNullOrEmpty(item.Design?.CommonDNo))
                                {
                                    <span class="cell-sub">@item.Design.CommonDNo</span>
                                }
                            </td>
                            <td><span class="tag">@item.Colour</span></td>
                            <td><span class="tag">@item.Size</span></td>
                            <td class="text-muted text-xs" title="1 Chaniya + 1 Choli + 1 Duppata">Chaniya + Choli + Duppata</td>
                            <td class="text-muted">@(item.WarehouseLocation ?? "—")</td>
                            <td class="cell-num text-foreground">₹@item.UnitPrice.ToString("N0")</td>
                            <td class="cell-num"><span class="fw-semibold @(item.QuantityOnHand > 0 ? "text-foreground" : "text-danger")">@item.QuantityOnHand</span></td>
                            <td><span class="af-badge @StatusBadge(item.CurrentStatus)">@item.CurrentStatus.Humanize()</span></td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (canManage)
                                    {
                                        <a asp-action="Outward" asp-route-id="@item.Id" class="row-action" title="Outward / dispatch" aria-label="Outward"><i class="bi bi-box-arrow-up"></i></a>
                                        <a asp-action="AdjustStock" asp-route-id="@item.Id" class="row-action" title="Adjust stock" aria-label="Adjust stock"><i class="bi bi-sliders"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="row-action primary" title="Details" aria-label="Details"><i class="bi bi-box-arrow-up-right"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.ReadyProducts.Count</strong> outfits</span>
        </div>
    }
</div>

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalImageTitle">Ready Product Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0 bg-raised">
                <img id="modalPreviewImg" src="" alt="Preview" class="img-fluid" style="max-height: 80vh;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(url, title) {
            document.getElementById('modalPreviewImg').src = url;
            document.getElementById('modalImageTitle').innerText = title;
            new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
        }
    </script>
}
