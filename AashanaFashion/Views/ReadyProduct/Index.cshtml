@model AashanaFashion.Models.ReadyProductIndexViewModel
@{
    ViewData["Title"] = "Ready Product Inventory";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool canManage = role == "Admin" || role == "SuperAdmin" || role == "System Admin" || role == "Manager";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold">👗 Ready Product Inventory (Finished Goods)</h2>
        <p class="text-muted mb-0">
            Finished 3-piece sets (<strong>1 Chaniya + 1 Choli + 1 Duppata</strong>) automatically inwarded into inventory when production lots reach <strong>Ready to Dispatch</strong>.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (canManage)
        {
            <form asp-action="SyncCompletedLots" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success" title="Inward stock for any completed lots that have not been inwarded yet">
                    🔄 Sync Completed Lots
                </button>
            </form>
        }
        <a asp-action="Ledger" class="btn btn-outline-secondary">
            📜 Stock Ledger
        </a>
        @if (canManage)
        {
            <a asp-action="Outward" class="btn btn-outline-danger">
                📤 Outward Dispatch
            </a>
            <a asp-action="Create" class="btn btn-primary">
                ➕ Add Ready Stock
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show af-alert mb-4" role="alert">
        <span>✅ @TempData["Success"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show af-alert mb-4" role="alert">
        <span>ℹ️ @TempData["Info"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show af-alert mb-4" role="alert">
        <span>⚠️ @TempData["Error"]</span>
        <button type="button" class="btn-close alert-close"></button>
    </div>
}

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 border-start border-primary border-4">
            <span class="text-muted small text-uppercase fw-semibold">Ready Sets in Stock</span>
            <h3 class="fw-bold my-1 text-primary">@Model.TotalReadySets.ToString("N0") <span class="fs-6 fw-normal text-muted">sets</span></h3>
            <small class="text-muted">Across @Model.TotalDesignsCount distinct designs</small>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 border-start border-success border-4">
            <span class="text-muted small text-uppercase fw-semibold">Total Retail Value</span>
            <h3 class="fw-bold my-1 text-success">₹@Model.TotalInventoryValue.ToString("N2")</h3>
            <small class="text-muted">Production Cost: ₹@Model.TotalCostValue.ToString("N2")</small>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 border-start border-warning border-4">
            <span class="text-muted small text-uppercase fw-semibold">Stock Health</span>
            <div class="d-flex gap-2 align-items-center my-1">
                <span class="badge bg-success">@Model.InStockCount Healthy</span>
                <span class="badge bg-warning text-dark">@Model.LowStockCount Low</span>
            </div>
            <small class="text-muted">@(Model.OutOfStockCount) variant(s) out of stock</small>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-light">
            <span class="text-muted small text-uppercase fw-semibold">Outfit Set Rule</span>
            <div class="small fw-semibold text-dark mt-1">
                1 Set = 1 Chaniya + 1 Choli + 1 Duppata
            </div>
            <small class="text-muted">All pieces match in Design, Colour & Size</small>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="viewMode" value="@Model.ViewMode" />
            <div class="col-md-3">
                <label class="small text-muted fw-semibold">Search:</label>
                <input type="text" name="search" value="@Model.Search" placeholder="Search Design, SKU, Barcode, Rack..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="small text-muted fw-semibold">Design:</label>
                <select name="designId" class="form-select form-select-sm">
                    <option value="">All Designs</option>
                    @if (ViewBag.Designs != null)
                    {
                        @foreach (var d in (List<AashanaFashion.Models.Design>)ViewBag.Designs)
                        {
                            <option value="@d.Id" selected="@(Model.DesignId == d.Id)">@d.DesignNumber</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="small text-muted fw-semibold">Colour:</label>
                <select name="colour" class="form-select form-select-sm">
                    <option value="">All Colours</option>
                    @if (ViewBag.Colours != null)
                    {
                        @foreach (var c in (List<string>)ViewBag.Colours)
                        {
                            <option value="@c" selected="@(Model.Colour == c)">@c</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="small text-muted fw-semibold">Size:</label>
                <select name="size" class="form-select form-select-sm">
                    <option value="">All</option>
                    @if (ViewBag.Sizes != null)
                    {
                        @foreach (var s in (List<string>)ViewBag.Sizes)
                        {
                            <option value="@s" selected="@(Model.Size == s)">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="small text-muted fw-semibold">Stock Status:</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (AashanaFashion.Models.ReadyProductStatus st in Enum.GetValues(typeof(AashanaFashion.Models.ReadyProductStatus)))
                    {
                        <option value="@st" selected="@(Model.Status == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset">Reset</a>
                <!-- View Mode Toggle -->
                <div class="btn-group btn-group-sm" role="group">
                    <a asp-action="Index" asp-route-viewMode="grid" asp-route-search="@Model.Search" asp-route-designId="@Model.DesignId" asp-route-colour="@Model.Colour" asp-route-size="@Model.Size" asp-route-status="@Model.Status"
                       class="btn @(Model.ViewMode == "grid" ? "btn-dark" : "btn-outline-dark")" title="Grid / Picture Cards View">🖼️</a>
                    <a asp-action="Index" asp-route-viewMode="table" asp-route-search="@Model.Search" asp-route-designId="@Model.DesignId" asp-route-colour="@Model.Colour" asp-route-size="@Model.Size" asp-route-status="@Model.Status"
                       class="btn @(Model.ViewMode == "table" ? "btn-dark" : "btn-outline-dark")" title="Table View">📋</a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.ReadyProducts.Any())
{
    <div class="card border-0 shadow-sm rounded-3 text-center py-5">
        <div class="card-body">
            <div class="display-1 text-muted opacity-50 mb-3">👗</div>
            <h4 class="fw-bold">No Ready Products Found</h4>
            <p class="text-muted">No finished garment sets match your filter criteria or have been added yet.</p>
            @if (canManage)
            {
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a asp-action="Create" class="btn btn-primary">➕ Add Ready Product Stock</a>
                    <a asp-action="Assemble" class="btn btn-outline-success">✨ Assemble Sets from Production</a>
                </div>
            }
        </div>
    </div>
}
else if (Model.ViewMode == "grid")
{
    <!-- Card / Picture Grid View -->
    <div class="row g-3">
        @foreach (var item in Model.ReadyProducts)
        {
            var photo = !string.IsNullOrEmpty(item.PhotoPath) ? item.PhotoPath : (item.Design?.PhotoPath ?? "");
            <div class="col-sm-6 col-md-4 col-xl-3">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden position-relative product-card">
                    <!-- Image Area with Zoom click -->
                    <div class="position-relative bg-light text-center" style="height: 220px; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(photo))
                        {
                            <img src="@photo" alt="@item.DesignNumber - @item.Colour" class="w-100 h-100 object-fit-cover"
                                 onclick="previewImage('@photo', '@item.DesignNumber — @item.Colour (@item.Size)')" style="cursor: pointer;" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                                <span class="display-4">👗</span>
                                <small class="mt-1">No Pic Uploaded</small>
                            </div>
                        }

                        <!-- Stock Status Badge -->
                        <span class="position-absolute top-0 start-0 m-2 badge @(item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.InStock ? "bg-success" : (item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.LowStock ? "bg-warning text-dark" : "bg-danger"))">
                            @(item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.InStock ? "In Stock" : (item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.LowStock ? "Low Stock" : "Out of Stock"))
                        </span>

                        <!-- 3-Piece Set Tag -->
                        <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-75">
                            3-Piece Set
                        </span>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">@item.DesignNumber</h5>
                                <div class="text-muted small">@item.Sku</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-primary fs-5">₹@item.UnitPrice.ToString("N0")</div>
                                @if (item.CostPrice > 0)
                                {
                                    <div class="text-muted small" style="font-size: 0.75rem;">Cost: ₹@item.CostPrice.ToString("N0")</div>
                                }
                            </div>
                        </div>

                        <!-- Variant Attributes: Colour & Size -->
                        <div class="d-flex flex-wrap gap-1 my-2">
                            <span class="badge bg-secondary-subtle text-secondary border">🎨 @item.Colour</span>
                            <span class="badge bg-secondary-subtle text-secondary border">📏 Size: @item.Size</span>
                            @if (!string.IsNullOrEmpty(item.WarehouseLocation))
                            {
                                <span class="badge bg-light text-dark border">📍 @item.WarehouseLocation</span>
                            }
                        </div>

                        <!-- Set Breakdown Indicators -->
                        <div class="p-2 rounded-2 bg-light small mb-3 border">
                            <div class="text-muted fw-semibold mb-1" style="font-size: 0.75rem;">COMPONENTS IN 1 SET:</div>
                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                                <span>👗 Chaniya: <strong>1</strong></span>
                                <span>👚 Choli: <strong>1</strong></span>
                                <span>🧣 Duppata: <strong>1</strong></span>
                            </div>
                        </div>

                        <!-- Stock Level -->
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                            <div>
                                <span class="small text-muted d-block" style="font-size: 0.75rem;">Stock on Hand</span>
                                <span class="fw-bold fs-5 @(item.QuantityOnHand > 0 ? "text-dark" : "text-danger")">
                                    @item.QuantityOnHand <span class="fs-6 fw-normal text-muted">sets</span>
                                </span>
                            </div>
                            <div class="d-flex gap-1">
                                @if (canManage)
                                {
                                    <a asp-action="Outward" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Outward / Dispatch">
                                        📤 Outward
                                    </a>
                                    <a asp-action="AdjustStock" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Adjust Stock">
                                        ⚡ Stock
                                    </a>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="View Details & Ledger">
                                    Details →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Table View -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">📦 Ready Stock Inventory Register</h5>
            <span class="badge bg-light text-dark border">@Model.ReadyProducts.Count Outfits</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Picture</th>
                        <th>SKU / Barcode</th>
                        <th>Design Number</th>
                        <th>Colour</th>
                        <th>Size</th>
                        <th>Set Composition</th>
                        <th>Location</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Stock</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ReadyProducts)
                    {
                        var photo = !string.IsNullOrEmpty(item.PhotoPath) ? item.PhotoPath : (item.Design?.PhotoPath ?? "");
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(photo))
                                {
                                    <img src="@photo" alt="@item.DesignNumber" class="rounded shadow-sm object-fit-cover" style="width: 50px; height: 50px; cursor: pointer;"
                                         onclick="previewImage('@photo', '@item.DesignNumber — @item.Colour (@item.Size)')" />
                                }
                                else
                                {
                                    <div class="bg-light rounded text-center d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                        👗
                                    </div>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none">
                                    @item.Sku
                                </a>
                            </td>
                            <td>
                                <strong>@item.DesignNumber</strong>
                                @if (!string.IsNullOrEmpty(item.Design?.CommonDNo))
                                {
                                    <div class="small text-muted">@item.Design.CommonDNo</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">@item.Colour</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border">@item.Size</span>
                            </td>
                            <td class="small">
                                <span title="1 Chaniya + 1 Choli + 1 Duppata" class="badge bg-info-subtle text-info-emphasis border">
                                    1 Chaniya + 1 Choli + 1 Duppata
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(item.WarehouseLocation ?? "—")
                            </td>
                            <td class="text-end fw-bold text-primary">
                                ₹@item.UnitPrice.ToString("N0")
                            </td>
                            <td class="text-center">
                                <span class="fw-bold fs-6 @(item.QuantityOnHand > 0 ? "text-dark" : "text-danger")">
                                    @item.QuantityOnHand
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.InStock ? "bg-success" : (item.CurrentStatus == AashanaFashion.Models.ReadyProductStatus.LowStock ? "bg-warning text-dark" : "bg-danger"))">
                                    @item.CurrentStatus
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-1">
                                    @if (canManage)
                                    {
                                        <a asp-action="Outward" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Outward / Dispatch">
                                            📤
                                        </a>
                                        <a asp-action="AdjustStock" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Adjust Stock">
                                            ⚡
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Edit">
                                            ✏️
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Details">
                                        View →
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalImageTitle">Ready Product Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-2 bg-dark">
                <img id="modalPreviewImg" src="" alt="Preview" class="img-fluid rounded" style="max-height: 80vh;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(url, title) {
            document.getElementById('modalPreviewImg').src = url;
            document.getElementById('modalImageTitle').innerText = title;
            new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
        }
    </script>
}
