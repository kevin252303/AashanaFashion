@model List<AashanaFashion.Models.ReadyProductTransaction>
@{
    ViewData["Title"] = "Ready Product Stock Ledger";
    var readyProducts = ViewBag.ReadyProducts as List<AashanaFashion.Models.ReadyProduct> ?? new();
    int? selectedProductId = ViewBag.SelectedProductId as int?;
    string? search = ViewBag.Search as string;
    AashanaFashion.Models.ReadyProductTransactionType? selectedType = ViewBag.Type as AashanaFashion.Models.ReadyProductTransactionType?;
    string? startDate = ViewBag.StartDate as string;
    string? endDate = ViewBag.EndDate as string;

    var totalInward = Model.Where(m => m.Quantity > 0).Sum(m => m.Quantity);
    var totalOutward = Math.Abs(Model.Where(m => m.Quantity < 0).Sum(m => m.Quantity));
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Ready Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Stock Movement Ledger</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>Ready Product Stock Ledger
            </h3>
            <p class="text-muted small mb-0">Complete audit log of all inward, 3-piece assembly, adjustments, and outward stock movements.</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-printer me-1"></i> Print / Export
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Ready Inventory
            </a>
        </div>
    </div>

    <!-- Summary KPI Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Transactions Logged</span>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.Count</div>
                    </div>
                    <div class="p-3 rounded-2 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Total Inward Sets (+)</span>
                        <div class="fs-3 fw-bold text-success mt-1">+@totalInward <span class="fs-6 fw-normal text-muted">sets</span></div>
                    </div>
                    <div class="p-3 rounded-2 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-box-arrow-in-down fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold">Total Outward Sets (-)</span>
                        <div class="fs-3 fw-bold text-danger mt-1">-@totalOutward <span class="fs-6 fw-normal text-muted">sets</span></div>
                    </div>
                    <div class="p-3 rounded-2 bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-box-arrow-up fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Ledger" class="row g-2 align-items-end">
                <!-- Search -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Search</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Ref no, notes, SKU..." />
                    </div>
                </div>

                <!-- Product -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Filter by Product</label>
                    <select name="id" class="form-select form-select-sm">
                        <option value="">-- All Ready Products --</option>
                        @foreach (var p in readyProducts)
                        {
                            <option value="@p.Id" selected="@(selectedProductId == p.Id)">
                                @p.DesignNumber (@p.Colour, @p.Size)
                            </option>
                        }
                    </select>
                </div>

                <!-- Transaction Type -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Transaction Type</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="">-- All Types --</option>
                        @foreach (var t in Enum.GetValues<AashanaFashion.Models.ReadyProductTransactionType>())
                        {
                            <option value="@t" selected="@(selectedType == t)">@t</option>
                        }
                    </select>
                </div>

                <!-- Start Date -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                    <input type="date" name="startDate" value="@startDate" class="form-control form-control-sm" />
                </div>

                <!-- End Date -->
                <div class="col-lg-2 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                    <input type="date" name="endDate" value="@endDate" class="form-control form-control-sm" />
                </div>

                <!-- Submit / Reset -->
                <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                    <a asp-action="Ledger" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </a>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Ledger Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date / Time</th>
                        <th>Product (3-Piece Set)</th>
                        <th>Transaction Type</th>
                        <th class="text-center">Change (Sets)</th>
                        <th class="text-center">Balance</th>
                        <th>Reference</th>
                        <th>Notes / Reason</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var tx in Model)
                        {
                            var photoSrc = tx.ReadyProduct != null ? tx.ReadyProduct.EffectivePhotoPath : "/images/placeholder-product.svg";

                            <tr>
                                <td class="ps-4 text-nowrap">
                                    <div class="fw-semibold text-dark">@tx.CreatedDate.ToString("dd-MMM-yyyy")</div>
                                    <div class="small text-muted">@tx.CreatedDate.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    @if (tx.ReadyProduct != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@photoSrc" 
                                                 alt="@tx.ReadyProduct.DesignNumber" 
                                                 class="rounded-2 border object-fit-cover" 
                                                 style="width: 36px; height: 36px;" 
                                                 onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                            <div>
                                                <a asp-action="Details" asp-route-id="@tx.ReadyProductId" class="fw-bold text-dark text-decoration-none">
                                                    @tx.ReadyProduct.DesignNumber
                                                </a>
                                                <div class="small text-muted">
                                                    <span class="badge bg-secondary me-1">@tx.ReadyProduct.Colour</span>
                                                    <span class="badge bg-dark">@tx.ReadyProduct.Size</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Item #@tx.ReadyProductId</span>
                                    }
                                </td>
                                <td>
                                    @switch (tx.TransactionType)
                                    {
                                        case AashanaFashion.Models.ReadyProductTransactionType.ManualInward:
                                            <span class="badge bg-primary">Manual Inward</span>
                                            break;
                                        case AashanaFashion.Models.ReadyProductTransactionType.AssemblyFromProduction:
                                            <span class="badge bg-success">3-Piece Assembly</span>
                                            break;
                                        case AashanaFashion.Models.ReadyProductTransactionType.StockAdjustment:
                                            <span class="badge bg-warning text-dark">Stock Adjustment</span>
                                            break;
                                        case AashanaFashion.Models.ReadyProductTransactionType.OutwardSales:
                                            <span class="badge bg-info text-dark">Dispatched / Sold</span>
                                            break;
                                        case AashanaFashion.Models.ReadyProductTransactionType.DamagedScrapped:
                                            <span class="badge bg-danger">Damaged / Scrap</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@tx.TransactionType</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (tx.Quantity > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 fw-bold px-2 py-1">
                                            +@tx.Quantity
                                        </span>
                                    }
                                    else if (tx.Quantity < 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger fs-6 fw-bold px-2 py-1">
                                            @tx.Quantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted fs-6 fw-bold px-2 py-1">0</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark fs-6">
                                    @tx.BalanceAfter
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(tx.ReferenceType ?? "—")</div>
                                    <div class="small text-muted font-monospace">@(tx.ReferenceNumber ?? "")</div>
                                </td>
                                <td class="small text-muted" style="max-width: 250px;">
                                    @(string.IsNullOrEmpty(tx.Notes) ? "—" : tx.Notes)
                                </td>
                                <td class="small text-dark text-nowrap">
                                    <i class="bi bi-person-circle text-secondary me-1"></i>@(tx.CreatedBy ?? "System")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No stock transactions found matching the filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
