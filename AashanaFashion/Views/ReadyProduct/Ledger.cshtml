@model List<AashanaFashion.Models.ReadyProductTransaction>
@{
    ViewData["Title"] = "Ready Product Stock Ledger";
    var readyProducts = ViewBag.ReadyProducts as List<AashanaFashion.Models.ReadyProduct> ?? new();
    int? selectedProductId = ViewBag.SelectedProductId as int?;
    string? search = ViewBag.Search as string;
    AashanaFashion.Models.ReadyProductTransactionType? selectedType = ViewBag.Type as AashanaFashion.Models.ReadyProductTransactionType?;
    string? startDate = ViewBag.StartDate as string;
    string? endDate = ViewBag.EndDate as string;

    var totalInward = Model.Where(m => m.Quantity > 0).Sum(m => m.Quantity);
    var totalOutward = Math.Abs(Model.Where(m => m.Quantity < 0).Sum(m => m.Quantity));
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Ready inventory</a>
        <h1 class="page-title">Ready Product Stock Ledger</h1>
        <p class="page-sub">Audit log of all inward, 3-piece assembly, adjustments, and outward stock movements.</p>
    </div>
    <div class="page-actions">
        <button type="button" onclick="window.print()" class="btn btn-secondary"><i class="bi bi-printer"></i> Print / Export</button>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Transactions logged</div>
        <div class="metric-value">@Model.Count</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total inward</div>
        <div class="metric-value">+@totalInward <span class="metric-suffix">sets</span></div>
        <div class="metric-meta success">manual, assembly &amp; returns</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total outward</div>
        <div class="metric-value">−@totalOutward <span class="metric-suffix">sets</span></div>
        <div class="metric-meta danger">dispatch, scrap &amp; deductions</div>
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Ledger" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="rlSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="rlSearch" name="search" value="@search" class="af-input" placeholder="Ref no, notes, SKU…" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="rlProduct">Product</label>
                <select id="rlProduct" name="id" class="af-input af-select">
                    <option value="">All ready products</option>
                    @foreach (var p in readyProducts)
                    {
                        <option value="@p.Id" selected="@(selectedProductId == p.Id)">
                            @p.DesignNumber (@p.Colour, @p.Size)
                        </option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="rlType">Transaction</label>
                <select id="rlType" name="type" class="af-input af-select">
                    <option value="">All types</option>
                    @foreach (var t in Enum.GetValues<AashanaFashion.Models.ReadyProductTransactionType>())
                    {
                        <option value="@t" selected="@(selectedType == t)">@t.Humanize()</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="rlFrom">From</label>
                <input type="date" id="rlFrom" name="startDate" value="@startDate" class="af-input" />
            </div>
            <div class="toolbar-field">
                <label for="rlTo">To</label>
                <input type="date" id="rlTo" name="endDate" value="@endDate" class="af-input" />
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="Ledger" class="btn btn-ghost">Reset</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Apply</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date / Time</th>
                        <th>Product (3-Piece Set)</th>
                        <th>Transaction</th>
                        <th class="text-end">Change (Sets)</th>
                        <th class="text-end">Balance</th>
                        <th>Reference</th>
                        <th>Notes / Reason</th>
                        <th>User</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model)
                    {
                        var photoSrc = tx.ReadyProduct != null ? tx.ReadyProduct.EffectivePhotoPath : "/images/placeholder-product.svg";

                        <tr>
                            <td class="text-nowrap">
                                <span class="text-foreground">@tx.CreatedDate.ToString("dd-MMM-yyyy")</span>
                                <span class="cell-sub">@tx.CreatedDate.ToString("hh:mm tt")</span>
                            </td>
                            <td>
                                @if (tx.ReadyProduct != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@photoSrc" alt="@tx.ReadyProduct.DesignNumber" class="thumb" style="width:36px;height:36px;" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                        <div>
                                            <a asp-action="Details" asp-route-id="@tx.ReadyProductId" class="cell-title text-reset">@tx.ReadyProduct.DesignNumber</a>
                                            <span class="cell-sub">@tx.ReadyProduct.Colour · @tx.ReadyProduct.Size</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Item #@tx.ReadyProductId</span>
                                }
                            </td>
                            <td>
                                @switch (tx.TransactionType)
                                {
                                    case AashanaFashion.Models.ReadyProductTransactionType.ManualInward:
                                        <span class="af-badge b-indigo">Manual inward</span>
                                        break;
                                    case AashanaFashion.Models.ReadyProductTransactionType.AssemblyFromProduction:
                                        <span class="af-badge b-green">3-piece assembly</span>
                                        break;
                                    case AashanaFashion.Models.ReadyProductTransactionType.StockAdjustment:
                                        <span class="af-badge b-yellow">Stock adjustment</span>
                                        break;
                                    case AashanaFashion.Models.ReadyProductTransactionType.OutwardSales:
                                        <span class="af-badge b-blue">Dispatched / sold</span>
                                        break;
                                    case AashanaFashion.Models.ReadyProductTransactionType.DamagedScrapped:
                                        <span class="af-badge b-red">Damaged / scrap</span>
                                        break;
                                    default:
                                        <span class="af-badge b-gray">@tx.TransactionType.Humanize()</span>
                                        break;
                                }
                            </td>
                            <td class="cell-num fw-semibold">
                                @if (tx.Quantity > 0)
                                {
                                    <span class="text-success">+@tx.Quantity</span>
                                }
                                else if (tx.Quantity < 0)
                                {
                                    <span class="text-danger">@tx.Quantity</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="cell-num text-foreground fw-semibold">@tx.BalanceAfter</td>
                            <td>
                                <span class="text-foreground">@(tx.ReferenceType ?? "—")</span>
                                <span class="cell-sub font-monospace">@(tx.ReferenceNumber ?? "")</span>
                            </td>
                            <td class="text-muted" style="max-width: 250px;">@(string.IsNullOrEmpty(tx.Notes) ? "—" : tx.Notes)</td>
                            <td class="text-nowrap"><i class="bi bi-person-circle text-placeholder"></i> @(tx.CreatedBy ?? "System")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count</strong> @(Model.Count == 1 ? "transaction" : "transactions")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-journal-x"></i></div>
            <div class="es-title">No transactions found</div>
            <p>No stock transactions match the filter criteria.</p>
            <a asp-action="Ledger" class="btn btn-secondary">Clear filters</a>
        </div>
    }
</div>
