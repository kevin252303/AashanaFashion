@model AashanaFashion.Models.ReadyProductFormViewModel
@{
    ViewData["Title"] = "Add Ready Product";
    var designs = ViewBag.Designs as List<AashanaFashion.Models.Design> ?? new();
    var colours = ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new();
    var sizes = ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new();
}

<div>
    <div class="page-header">
        <div>
            <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Ready products</a>
            <h1 class="page-title">New Ready Product (3-Piece Set)</h1>
            <p class="page-sub">1 Ready Product = 1 Chaniya + 1 Choli + 1 Duppata of identical design, colour, and size.</p>
        </div>
    </div>

    <div class="af-alert af-alert-info">
        <div class="alert-body">
            <span class="alert-title">Ready product specification rule</span>
            Every unit in ready goods inventory represents <strong>1 complete matching set</strong> (1 Chaniya + 1 Choli + 1 Duppata).
            Inventory is tracked uniquely by <strong>design number, colour and size</strong> with custom or auto-inherited photos.
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="readyProductForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

        <div class="row g-4">
            <!-- Left Form Column -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-card-checklist"></i> 1. Product Specification
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Design Selector -->
                            <div class="col-md-12">
                                <label asp-for="DesignId" class="form-label">Select Design <span class="req">*</span></label>
                                <select asp-for="DesignId" id="designSelect" class="form-select" required>
                                    <option value="">-- Choose Design --</option>
                                    @foreach (var d in designs)
                                    {
                                        <option value="@d.Id" selected="@(Model.DesignId == d.Id)">
                                            @d.DesignNumber @(!string.IsNullOrEmpty(d.CommonDNo) ? $"({d.CommonDNo})" : "") - @d.Category
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DesignId" class="af-error"></span>
                                <input type="hidden" asp-for="DesignNumber" id="designNumberHidden" />
                            </div>

                            <!-- Colour -->
                            <div class="col-md-6">
                                <label asp-for="Colour" class="form-label">Colour <span class="req">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Colour" id="colourInput" class="form-control" list="colourList" placeholder="e.g. Navy Blue, Maroon" required />
                                    <datalist id="colourList">
                                        @foreach (var c in colours)
                                        {
                                            <option value="@c.ColourName"></option>
                                        }
                                    </datalist>
                                </div>
                                <span asp-validation-for="Colour" class="af-error"></span>
                                <div class="form-text">Matching colour across Chaniya, Choli, and Duppata.</div>
                            </div>

                            <!-- Size -->
                            <div class="col-md-6">
                                <label asp-for="Size" class="form-label">Size <span class="req">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Size" id="sizeInput" class="form-control" list="sizeList" placeholder="e.g. M, L, XL, Free Size" required />
                                    <datalist id="sizeList">
                                        @foreach (var s in sizes)
                                        {
                                            <option value="@s.SizeName"></option>
                                        }
                                    </datalist>
                                </div>
                                <span asp-validation-for="Size" class="af-error"></span>
                                <div class="form-text">Matching size for the 3-piece set.</div>
                            </div>

                            <!-- Auto-generated SKU -->
                            <div class="col-md-12">
                                <label asp-for="Sku" class="form-label">SKU / Item Code</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                    <input asp-for="Sku" id="skuInput" class="form-control font-monospace" placeholder="Auto-generated if left blank" />
                                </div>
                                <span asp-validation-for="Sku" class="af-error"></span>
                                <div class="form-text">Format: RP-DESIGN-COLOUR-SIZE (also used for product barcode).</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stock & Pricing -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-boxes"></i> 2. Stock & Pricing
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Initial Stock -->
                            <div class="col-md-4">
                                <label asp-for="InitialQuantity" class="form-label">Initial Ready Sets (Stock)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-stack"></i></span>
                                    <input asp-for="InitialQuantity" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="InitialQuantity" class="af-error"></span>
                                <div class="form-text">Opening complete 3-pc sets.</div>
                            </div>

                            <!-- Minimum Stock Alert -->
                            <div class="col-md-4">
                                <label asp-for="MinimumStockAlert" class="form-label">Low Stock Threshold</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-exclamation-triangle"></i></span>
                                    <input asp-for="MinimumStockAlert" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="MinimumStockAlert" class="af-error"></span>
                                <div class="form-text">Alerts when stock falls below this.</div>
                            </div>

                            <!-- Warehouse Location -->
                            <div class="col-md-4">
                                <label asp-for="WarehouseLocation" class="form-label">Rack / Location</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="WarehouseLocation" class="form-control" placeholder="e.g. Rack A-04, Bin 12" />
                                </div>
                                <span asp-validation-for="WarehouseLocation" class="af-error"></span>
                                <div class="form-text">Physical storage spot.</div>
                            </div>

                            <!-- Selling Price -->
                            <div class="col-md-6">
                                <label asp-for="UnitPrice" class="form-label">Sales Price (MRP / Set)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="UnitPrice" id="unitPriceInput" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="UnitPrice" class="af-error"></span>
                                <div class="form-text">Selling price for 1 full ready set.</div>
                            </div>

                            <!-- Cost Price -->
                            <div class="col-md-6">
                                <label asp-for="CostPrice" class="form-label">Cost Price (Estimated / Set)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="CostPrice" id="costPriceInput" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="CostPrice" class="af-error"></span>
                                <div class="form-text">Total production cost of the 3 pieces.</div>
                            </div>

                            <!-- Remarks -->
                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label">Notes / Remarks</label>
                                <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional notes about fabric, embellishments, packing, etc."></textarea>
                                <span asp-validation-for="Remarks" class="af-error"></span>
                            </div>

                            <!-- Active Status -->
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" checked id="isActiveSwitch">
                                    <label class="form-check-label" for="isActiveSwitch">Active Ready Product (Available for dispatch & billing)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Column: Photo & 3-Piece Breakdown -->
            <div class="col-lg-4">
                <!-- Photo Upload & Preview Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-camera"></i> Product Photo
                        </h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3 position-relative d-inline-block w-100">
                            <div class="photo-frame w-100" style="height: 260px;">
                                <img id="photoPreview" 
                                     src="@(string.IsNullOrEmpty(Model.ExistingPhotoPath) ? "/images/placeholder-product.svg" : Model.ExistingPhotoPath)" 
                                     alt="Product Preview" 
                                     class="img-fluid h-100 w-100 object-fit-contain" 
                                     onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                            </div>
                        </div>

                        <input type="hidden" asp-for="ExistingPhotoPath" id="existingPhotoPath" />

                        <div class="mb-3 text-start">
                            <label asp-for="PhotoFile" class="form-label">Upload ready product photo</label>
                            <input asp-for="PhotoFile" id="photoFileInput" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="af-error"></span>
                            <div class="form-text">Upload actual finished photo or inherit design picture automatically.</div>
                        </div>
                    </div>
                </div>

                <!-- 3-Piece Set Manifest Card -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0"><i class="bi bi-puzzle"></i> 3-piece set composition</h5>
                    </div>
                    <div class="card-body">
                        <div class="kv-row"><span class="k"><strong class="text-foreground">Chaniya</strong> (Lehenga)</span><span class="tag">1 piece</span></div>
                        <div class="kv-row"><span class="k"><strong class="text-foreground">Choli</strong> (Blouse)</span><span class="tag">1 piece</span></div>
                        <div class="kv-row"><span class="k"><strong class="text-foreground">Duppata</strong> (Scarf)</span><span class="tag">1 piece</span></div>
                        <p class="text-xs text-muted mt-3 mb-0">All 3 components must match the selected design, colour, and size.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save to Ready Inventory</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Auto-fetch design details when design dropdown changes
            $('#designSelect').on('change', function () {
                var designId = $(this).val();
                if (!designId) return;

                $.getJSON('/ReadyProduct/GetDesignDetails', { designId: designId }, function (data) {
                    if (data) {
                        $('#designNumberHidden').val(data.designNumber);
                        
                        if (data.salesPrice > 0) {
                            $('#unitPriceInput').val(data.salesPrice);
                        }
                        if (data.costPrice > 0) {
                            $('#costPriceInput').val(data.costPrice);
                        }
                        if (data.photoPath && !$('#photoFileInput').val()) {
                            $('#existingPhotoPath').val(data.photoPath);
                            $('#photoPreview').attr('src', data.photoPath);
                        }

                        // Update datalists if colours/sizes available
                        if (data.colours && data.colours.length > 0) {
                            var clHtml = '';
                            $.each(data.colours, function (i, c) {
                                clHtml += '<option value="' + c + '"></option>';
                            });
                            $('#colourList').html(clHtml);
                            if (!$('#colourInput').val()) {
                                $('#colourInput').val(data.colours[0]);
                            }
                        }

                        if (data.sizes && data.sizes.length > 0) {
                            var slHtml = '';
                            $.each(data.sizes, function (i, s) {
                                slHtml += '<option value="' + s + '"></option>';
                            });
                            $('#sizeList').html(slHtml);
                            if (!$('#sizeInput').val()) {
                                $('#sizeInput').val(data.sizes[0]);
                            }
                        }

                        updateSku();
                    }
                });
            });

            // Auto-generate SKU on colour or size change
            $('#colourInput, #sizeInput').on('input change', function () {
                updateSku();
            });

            function updateSku() {
                var dNo = $('#designSelect option:selected').text().split('-')[0].trim();
                var col = $('#colourInput').val().trim();
                var sz = $('#sizeInput').val().trim();

                if (dNo && col && sz) {
                    var sku = 'RP-' + dNo + '-' + col + '-' + sz;
                    sku = sku.replace(/\s+/g, '').toUpperCase();
                    $('#skuInput').val(sku);
                }
            }

            // Image Preview on File Input Change
            $('#photoFileInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (evt) {
                        $('#photoPreview').attr('src', evt.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
