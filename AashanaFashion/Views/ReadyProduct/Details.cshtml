@model AashanaFashion.Models.ReadyProduct
@{
    ViewData["Title"] = $"{Model.DesignNumber} ({Model.Colour}, {Model.Size}) - Details";
    var photoSrc = !string.IsNullOrEmpty(Model.PhotoPath) ? Model.PhotoPath : (!string.IsNullOrEmpty(Model.Design?.PhotoPath) ? Model.Design.PhotoPath : "/images/placeholder-product.svg");
    var margin = Model.UnitPrice > 0 && Model.CostPrice > 0 ? ((Model.UnitPrice - Model.CostPrice) / Model.UnitPrice) * 100 : 0;
    var statusBadge = Model.CurrentStatus switch
    {
        ReadyProductStatus.InStock => "b-green",
        ReadyProductStatus.LowStock => "b-yellow",
        ReadyProductStatus.Discontinued => "b-gray",
        _ => "b-red"
    };
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Ready Products</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.DesignNumber (@Model.Colour, @Model.Size)</li>
            </ol>
        </nav>
        <h1 class="page-title d-flex align-items-center gap-2 flex-wrap">
            @Model.DesignNumber
            <span class="tag">@Model.Colour</span>
            <span class="tag">Size @Model.Size</span>
            <span class="af-badge @statusBadge">@Model.CurrentStatus.Humanize()</span>
        </h1>
    </div>
    <div class="page-actions">
        <a asp-action="PrintTag" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary"><i class="bi bi-printer"></i> Print tag</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-sliders"></i> Adjust stock</a>
        <a asp-action="Outward" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-box-arrow-up"></i> Outward dispatch</a>
    </div>
</div>

@if (Model.CurrentStatus == ReadyProductStatus.OutOfStock)
{
    <div class="af-alert af-alert-danger">
        <div class="alert-body"><span class="alert-title">Out of stock</span>There are 0 finished ready sets in stock for this specification.</div>
    </div>
}
else if (Model.CurrentStatus == ReadyProductStatus.LowStock)
{
    <div class="af-alert af-alert-warning">
        <div class="alert-body"><span class="alert-title">Low stock</span>Current inventory (@Model.QuantityOnHand sets) is at or below the minimum alert threshold (@Model.MinimumStockAlert sets).</div>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="data-card h-100">
            <div class="position-relative bg-raised p-3 text-center border-bottom">
                <img src="@photoSrc"
                     alt="@Model.DesignNumber"
                     class="img-fluid rounded cursor-pointer"
                     style="max-height: 320px; width: 100%; object-fit: contain;"
                     data-bs-toggle="modal"
                     data-bs-target="#imageModal"
                     onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                <button type="button" class="btn btn-sm btn-secondary btn-icon position-absolute top-0 end-0 m-3" data-bs-toggle="modal" data-bs-target="#imageModal" aria-label="Zoom image">
                    <i class="bi bi-zoom-in"></i>
                </button>
            </div>
            <div class="data-card-body">
                <div class="micro-label">3-piece set specification</div>
                <div class="panel-inset">
                    <div class="kv-row"><span class="k">Chaniya (skirt)</span><span class="tag">1 pc</span></div>
                    <div class="kv-row"><span class="k">Choli (blouse)</span><span class="tag">1 pc</span></div>
                    <div class="kv-row"><span class="k">Duppata (scarf)</span><span class="tag">1 pc</span></div>
                </div>

                <div class="info-grid" style="grid-template-columns: minmax(0, 1fr);">
                    <div class="info-item">
                        <div class="info-label">SKU</div>
                        <div class="info-value font-monospace text-sm">@Model.Sku</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Barcode</div>
                        <div class="info-value font-monospace text-sm">@(Model.Barcode ?? Model.Sku)</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Storage rack</div>
                        <div class="info-value @(string.IsNullOrEmpty(Model.WarehouseLocation) ? "muted" : "")">@(string.IsNullOrEmpty(Model.WarehouseLocation) ? "Not specified" : Model.WarehouseLocation)</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <div class="info-item">
                            <div class="info-label">Remarks</div>
                            <div class="info-value">@Model.Remarks</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="metric-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
            <div class="metric-card">
                <div class="metric-label">Quantity on hand</div>
                <div class="metric-value">@Model.QuantityOnHand <span class="metric-suffix">sets</span></div>
                <div class="metric-meta">@(Model.QuantityOnHand * 3) individual garments</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Available for sale</div>
                <div class="metric-value">@Model.AvailableQuantity <span class="metric-suffix">sets</span></div>
                <div class="metric-meta">allocated @Model.AllocatedQuantity sets</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Min stock alert</div>
                <div class="metric-value">@Model.MinimumStockAlert <span class="metric-suffix">sets</span></div>
                <div class="metric-meta">threshold limit</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Unit sales price (MRP)</div>
                <div class="metric-value">₹@Model.UnitPrice.ToString("N2")</div>
                <div class="metric-meta">per complete 3-piece set</div>
            </div>
            <div class="metric-card">
                <div class="metric-label">Unit cost price</div>
                <div class="metric-value">₹@Model.CostPrice.ToString("N2")</div>
                @if (margin > 0)
                {
                    <div class="metric-meta success"><i class="bi bi-arrow-up-right"></i> @margin.ToString("N1")% margin</div>
                }
            </div>
            <div class="metric-card">
                <div class="metric-label">Stock valuation</div>
                <div class="metric-value">₹@((Model.QuantityOnHand * Model.UnitPrice).ToString("N2"))</div>
                <div class="metric-meta">cost ₹@((Model.QuantityOnHand * Model.CostPrice).ToString("N2"))</div>
            </div>
        </div>

        @if (Model.Design != null)
        {
            <div class="data-card">
                <div class="data-card-header">
                    <span class="data-card-title">Design overview · @Model.Design.DesignNumber</span>
                    <a asp-controller="Design" asp-action="Details" asp-route-id="@Model.Design.Id" class="btn btn-sm btn-ghost">View design <i class="bi bi-box-arrow-up-right"></i></a>
                </div>
                <div class="data-card-body">
                    <div class="info-grid cols-3">
                        <div class="info-item">
                            <div class="info-label">Common design no</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Design.CommonDNo) ? "None" : Model.Design.CommonDNo)</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Category</div>
                            <div class="info-value">@Model.Design.Category</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Product type</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Design.ProductType) ? "Goods" : Model.Design.ProductType)</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Available colours</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Design.Colours) ? "N/A" : Model.Design.Colours)</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Available sizes</div>
                            <div class="info-value">@(string.IsNullOrEmpty(Model.Design.Sizes) ? "N/A" : Model.Design.Sizes)</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Created on</div>
                            <div class="info-value">@Model.CreatedDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="table-card">
    <div class="data-card-header">
        <span class="data-card-title">Stock movement ledger</span>
        <a asp-action="Ledger" asp-route-id="@Model.Id" class="btn btn-sm btn-ghost">Full ledger <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (Model.Transactions != null && Model.Transactions.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Transaction</th>
                        <th class="text-end">Change (Sets)</th>
                        <th class="text-end">Balance After</th>
                        <th>Reference</th>
                        <th>Notes / Reason</th>
                        <th>Handled By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <span class="text-foreground">@tx.CreatedDate.ToString("dd-MMM-yyyy")</span>
                                <span class="cell-sub">@tx.CreatedDate.ToString("hh:mm tt")</span>
                            </td>
                            <td>
                                @switch (tx.TransactionType)
                                {
                                    case ReadyProductTransactionType.ManualInward:
                                        <span class="af-badge b-indigo">Manual inward</span>
                                        break;
                                    case ReadyProductTransactionType.AssemblyFromProduction:
                                        <span class="af-badge b-green">3-piece assembly</span>
                                        break;
                                    case ReadyProductTransactionType.StockAdjustment:
                                        <span class="af-badge b-yellow">Adjustment</span>
                                        break;
                                    case ReadyProductTransactionType.OutwardSales:
                                        <span class="af-badge b-blue">Dispatched / sold</span>
                                        break;
                                    case ReadyProductTransactionType.DamagedScrapped:
                                        <span class="af-badge b-red">Damaged / scrap</span>
                                        break;
                                    default:
                                        <span class="af-badge b-gray">@tx.TransactionType.Humanize()</span>
                                        break;
                                }
                            </td>
                            <td class="cell-num fw-semibold">
                                @if (tx.Quantity > 0)
                                {
                                    <span class="text-success">+@tx.Quantity</span>
                                }
                                else if (tx.Quantity < 0)
                                {
                                    <span class="text-danger">@tx.Quantity</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="cell-num text-foreground fw-semibold">@tx.BalanceAfter</td>
                            <td>
                                <span class="text-foreground">@(tx.ReferenceType ?? "N/A")</span>
                                <span class="cell-sub font-monospace">@(tx.ReferenceNumber ?? "")</span>
                            </td>
                            <td class="text-muted" style="max-width: 250px;">@(string.IsNullOrEmpty(tx.Notes) ? "—" : tx.Notes)</td>
                            <td class="text-nowrap"><i class="bi bi-person-circle text-placeholder"></i> @(tx.CreatedBy ?? "System")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-journal-x"></i></div>
            <div class="es-title">No stock movements yet</div>
            <p>Inward, assembly, adjustment and dispatch entries will appear here.</p>
        </div>
    }
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">@Model.DesignNumber - @Model.Colour (Size @Model.Size)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center bg-raised">
                <img src="@photoSrc" class="img-fluid" style="max-height: 80vh;" alt="@Model.DesignNumber" />
            </div>
            <div class="modal-footer justify-content-between">
                <span class="text-muted text-sm">1 Ready Product = 1 Chaniya + 1 Choli + 1 Duppata</span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
