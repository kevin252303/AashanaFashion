@model AashanaFashion.Models.ReadyProductFormViewModel
@{
    ViewData["Title"] = $"Edit Ready Product - {Model.DesignNumber}";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Breadcrumb -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Ready Products</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-muted">@Model.DesignNumber (@Model.Colour, @Model.Size)</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i>Edit Ready Product
            </h3>
            <p class="text-muted small mb-0">Update pricing, thresholds, storage location, or product photo.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-eye me-1"></i> View Details
            </a>
            <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-warning text-dark">
                <i class="bi bi-arrow-left-right me-1"></i> Adjust Stock
            </a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DesignId" />
        <input type="hidden" asp-for="DesignNumber" />
        <input type="hidden" asp-for="Colour" />
        <input type="hidden" asp-for="Size" />
        <input type="hidden" asp-for="ExistingPhotoPath" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

        <div class="row g-4">
            <!-- Left Column: Product Properties -->
            <div class="col-lg-8">
                <!-- Immutable Specification Card -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Design Number:</span>
                                <strong class="fs-5 text-dark">@Model.DesignNumber</strong>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Colour:</span>
                                <span class="badge bg-secondary fs-6">@Model.Colour</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted small d-block">Size:</span>
                                <span class="badge bg-dark fs-6">@Model.Size</span>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            <i class="bi bi-lock-fill me-1"></i> Specification (Design, Colour, Size) defines the 3-piece set identity and cannot be altered directly.
                        </div>
                    </div>
                </div>

                <!-- Pricing & Inventory Settings -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">
                            <i class="bi bi-currency-rupee text-success me-2"></i>Pricing & Stock Alerts
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UnitPrice" class="form-label fw-semibold">Sales Price (MRP / Set) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" required />
                                </div>
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                                <div class="form-text">Selling price for 1 complete 3-piece set.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CostPrice" class="form-label fw-semibold">Cost Price (Estimated / Set)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="CostPrice" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="CostPrice" class="text-danger small"></span>
                                <div class="form-text">Production / landed cost per set.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MinimumStockAlert" class="form-label fw-semibold">Low Stock Threshold</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-bell"></i></span>
                                    <input asp-for="MinimumStockAlert" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="MinimumStockAlert" class="text-danger small"></span>
                                <div class="form-text">Triggers low stock badge when stock &le; this number.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="WarehouseLocation" class="form-label fw-semibold">Rack / Location</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="WarehouseLocation" class="form-control" placeholder="e.g. Rack B-02" />
                                </div>
                                <span asp-validation-for="WarehouseLocation" class="text-danger small"></span>
                                <div class="form-text">Warehouse storage shelf or bin.</div>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Sku" class="form-label fw-semibold">SKU / Barcode Text</label>
                                <input asp-for="Sku" class="form-control font-monospace" />
                                <span asp-validation-for="Sku" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label fw-semibold">Remarks / Storage Notes</label>
                                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Remarks" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                                    <label class="form-check-label fw-semibold" for="isActiveSwitch">Product Set is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Photo Update -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">
                            <i class="bi bi-image text-primary me-2"></i>Product Photo
                        </h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-3 position-relative d-inline-block w-100">
                            <div class="rounded-3 border overflow-hidden bg-light d-flex align-items-center justify-content-center" style="height: 260px;">
                                <img id="photoPreview" 
                                     src="@(string.IsNullOrEmpty(Model.ExistingPhotoPath) ? "/images/placeholder-product.svg" : Model.ExistingPhotoPath)" 
                                     alt="@Model.DesignNumber" 
                                     class="img-fluid h-100 w-100 object-fit-contain" 
                                     onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                            </div>
                        </div>

                        <div class="text-start">
                            <label asp-for="PhotoFile" class="form-label fw-semibold small text-muted">Change / Upload New Photo</label>
                            <input asp-for="PhotoFile" id="photoFileInput" type="file" class="form-control form-control-sm" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                            <div class="form-text small">Leave blank to retain current photo.</div>
                        </div>
                    </div>
                </div>

                <!-- Submit & Cancel -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#photoFileInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (evt) {
                        $('#photoPreview').attr('src', evt.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
