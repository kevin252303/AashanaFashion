@model AashanaFashion.Models.ReadyProductFormViewModel
@{
    ViewData["Title"] = $"Edit Ready Product - {Model.DesignNumber}";
}

<div>
    <div class="page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Ready Products</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.DesignNumber (@Model.Colour, @Model.Size)</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h1 class="page-title">Edit Ready Product</h1>
            <p class="page-sub">Update pricing, thresholds, storage location, or product photo.</p>
        </div>
        <div class="page-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-eye"></i> View details</a>
            <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-sliders"></i> Adjust stock</a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DesignId" />
        <input type="hidden" asp-for="DesignNumber" />
        <input type="hidden" asp-for="Colour" />
        <input type="hidden" asp-for="Size" />
        <input type="hidden" asp-for="ExistingPhotoPath" />

        <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

        <div class="row g-4">
            <!-- Left Column: Product Properties -->
            <div class="col-lg-8">
                <!-- Immutable Specification Card -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Specification</h5>
                        <span class="text-xs text-muted"><i class="bi bi-lock"></i> Locked</span>
                    </div>
                    <div class="card-body">
                        <div class="info-grid cols-3">
                            <div class="info-item">
                                <div class="info-label">Design number</div>
                                <div class="info-value fw-semibold">@Model.DesignNumber</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Colour</div>
                                <span class="tag">@Model.Colour</span>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Size</div>
                                <span class="tag">@Model.Size</span>
                            </div>
                        </div>
                        <div class="af-hint mt-3">Design, colour and size define the 3-piece set identity and cannot be altered directly.</div>
                    </div>
                </div>

                <!-- Pricing & Inventory Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-currency-rupee"></i> Pricing & Stock Alerts
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UnitPrice" class="form-label">Sales Price (MRP / Set) <span class="req">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" required />
                                </div>
                                <span asp-validation-for="UnitPrice" class="af-error"></span>
                                <div class="form-text">Selling price for 1 complete 3-piece set.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CostPrice" class="form-label">Cost Price (Estimated / Set)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="CostPrice" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="CostPrice" class="af-error"></span>
                                <div class="form-text">Production / landed cost per set.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MinimumStockAlert" class="form-label">Low Stock Threshold</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-bell"></i></span>
                                    <input asp-for="MinimumStockAlert" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="MinimumStockAlert" class="af-error"></span>
                                <div class="form-text">Triggers low stock badge when stock &le; this number.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="WarehouseLocation" class="form-label">Rack / Location</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="WarehouseLocation" class="form-control" placeholder="e.g. Rack B-02" />
                                </div>
                                <span asp-validation-for="WarehouseLocation" class="af-error"></span>
                                <div class="form-text">Warehouse storage shelf or bin.</div>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Sku" class="form-label">SKU / Barcode Text</label>
                                <input asp-for="Sku" class="form-control font-monospace" />
                                <span asp-validation-for="Sku" class="af-error"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Remarks" class="form-label">Remarks / Storage Notes</label>
                                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Remarks" class="af-error"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                                    <label class="form-check-label" for="isActiveSwitch">Product Set is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Photo Update -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-image"></i> Product Photo
                        </h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3 position-relative d-inline-block w-100">
                            <div class="photo-frame w-100" style="height: 260px;">
                                <img id="photoPreview" 
                                     src="@(string.IsNullOrEmpty(Model.ExistingPhotoPath) ? "/images/placeholder-product.svg" : Model.ExistingPhotoPath)" 
                                     alt="@Model.DesignNumber" 
                                     class="img-fluid h-100 w-100 object-fit-contain" 
                                     onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                            </div>
                        </div>

                        <div class="text-start">
                            <label asp-for="PhotoFile" class="form-label">Change / upload new photo</label>
                            <input asp-for="PhotoFile" id="photoFileInput" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="PhotoFile" class="af-error"></span>
                            <div class="form-text">Leave blank to retain current photo.</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#photoFileInput').on('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (evt) {
                        $('#photoPreview').attr('src', evt.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
