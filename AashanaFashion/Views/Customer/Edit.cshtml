@model AashanaFashion.Models.CustomerViewModel
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Customers</a>
        <h1 class="page-title">Edit customer</h1>
        <p class="page-sub">Update customer details, commercial terms, and credit exposure rules</p>
    </div>
</div>

<form asp-action="Edit" method="post" id="customerForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close" type="button">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Customer Details</div>
        </div>
        <div>
            <!-- Single Unified Tab -->
            <ul class="nav nav-tabs card-tabs" id="customerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="customer-info-tab" data-bs-toggle="tab" data-bs-target="#customerInfo" type="button" role="tab">
                        <i class="bi bi-person-lines-fill me-1"></i> Customer Information
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="customerInfo" role="tabpanel">

                    <!-- SECTION 1: PRIMARY & CONTACT DETAILS -->
                    <div class="form-section-title">Primary &amp; Contact Details</div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="CustomerName" class="af-label">Customer Name <span class="req">*</span></label>
                                <input asp-for="CustomerName" class="af-input" placeholder="e.g. Shree Krishna Textiles" required />
                                <span asp-validation-for="CustomerName" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IsActive" class="af-label">Status</label>
                                <select asp-for="IsActive" class="af-input af-select">
                                    <option value="true" selected="@(Model.IsActive ? "selected" : null)">Active</option>
                                    <option value="false" selected="@(!Model.IsActive ? "selected" : null)">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label" for="gstInput">Auto-fill from GSTIN</label>
                                <div class="input-group">
                                    <input type="text" id="gstInput" class="af-input text-uppercase" placeholder="Enter 15-character GSTIN" maxlength="15" value="@Model.GstNumber" />
                                    <button type="button" id="fetchGstBtn" class="btn btn-secondary">Fetch</button>
                                </div>
                                <span id="gstError" class="af-error" style="display:none;"></span>
                                <span id="gstSuccess" class="form-text text-success" style="display:none;"></span>
                                <span class="af-hint">Looks up the GST registry and automatically fills legal name, address, and PAN.</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="GstNumber" class="af-label">GST Number</label>
                                <input asp-for="GstNumber" class="af-input text-uppercase font-monospace" id="GstNumber" placeholder="e.g. 24AAAAA0000A1Z5" maxlength="15" />
                                <span asp-validation-for="GstNumber" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PanNumber" class="af-label">PAN Number</label>
                                <input asp-for="PanNumber" class="af-input text-uppercase font-monospace" placeholder="e.g. ABCDE1234F" maxlength="10" />
                                <span asp-validation-for="PanNumber" class="af-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="ContactPerson" class="af-label">Contact Person</label>
                                <input asp-for="ContactPerson" class="af-input" placeholder="e.g. Rajesh Shah" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Phone" class="af-label">Phone Number</label>
                                <input asp-for="Phone" class="af-input" placeholder="e.g. 98250 12345" />
                                <span asp-validation-for="Phone" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Email" class="af-label">Email Address</label>
                                <input asp-for="Email" class="af-input" type="email" placeholder="e.g. billing@customer.com" />
                                <span asp-validation-for="Email" class="af-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Address" class="af-label">Billing &amp; Delivery Address</label>
                        <input asp-for="Address" class="af-input" placeholder="Street address, shop / unit number, landmark" />
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="City" class="af-label">City</label>
                                <input asp-for="City" class="af-input" placeholder="e.g. Surat" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="State" class="af-label">State</label>
                                <input asp-for="State" class="af-input" placeholder="e.g. Gujarat" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PinCode" class="af-label">Pin Code</label>
                                <input asp-for="PinCode" class="af-input font-monospace" placeholder="e.g. 395002" maxlength="10" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: CREDIT LIMITS & EXPOSURE -->
                    <div class="form-section-title">Credit Limits &amp; Exposure</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnerLimit" class="af-label">Credit Limit (₹)</label>
                                <input asp-for="PartnerLimit" class="af-input" type="number" step="0.01" min="0" placeholder="e.g. 500000" id="custPartnerLimit" />
                                <span class="af-hint">Max credit allowed across unpaid invoices &amp; pending orders.</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="TotalReceivable" class="af-label">Opening / Total Receivable (₹)</label>
                                <input asp-for="TotalReceivable" class="af-input" type="number" step="0.01" min="0" placeholder="0.00" />
                                <span class="af-hint">Opening balance or base receivable amount.</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="DaysSalesOutstanding" class="af-label">Credit Period (Days)</label>
                                <input asp-for="DaysSalesOutstanding" class="af-input" type="number" step="1" min="0" placeholder="e.g. 30" />
                                <span class="af-hint">Standard credit days allowed for this buyer.</span>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: SALES & COMMERCIAL TERMS -->
                    <div class="form-section-title">Sales &amp; Commercial Terms</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Salesperson" class="af-label">Salesperson</label>
                                <select asp-for="Salesperson" class="af-input af-select">
                                    <option value="">— Select Salesperson —</option>
                                    @if (ViewBag.Users != null)
                                    {
                                        foreach (var u in (List<AashanaFashion.Models.AppUser>)ViewBag.Users)
                                        {
                                            <option value="@u.FullName" selected="@(Model.Salesperson == u.FullName ? "selected" : null)">@u.FullName (@u.Role)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <div class="label-row">
                                    <label asp-for="PricelistId" class="af-label">Pricelist</label>
                                    <button type="button" class="label-action" data-bs-toggle="modal" data-bs-target="#quickPricelistModal" title="Create a new Pricelist inline">
                                        <i class="bi bi-plus-lg"></i> New
                                    </button>
                                </div>
                                <select asp-for="PricelistId" class="af-input af-select" id="customerPricelistSelect">
                                    <option value="">-- Standard / No Pricelist --</option>
                                    @if (ViewBag.Pricelists != null)
                                    {
                                        foreach (var pl in (List<AashanaFashion.Models.Pricelist>)ViewBag.Pricelists)
                                        {
                                            <option value="@pl.Id" selected="@(Model.PricelistId == pl.Id)">
                                                @pl.Name (@pl.DiscountPolicyDisplay)
                                            </option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="Pricelist" id="customerPricelistNameHidden" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SalesPaymentTerms" class="af-label">Payment Terms</label>
                                <input asp-for="SalesPaymentTerms" class="af-input" placeholder="e.g. Net 30, Immediate, Advance 50%" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SalesPaymentMethod" class="af-label">Payment Method</label>
                                <input asp-for="SalesPaymentMethod" class="af-input" placeholder="e.g. Bank Transfer / RTGS, Cheque" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="DeliveryMethod" class="af-label">Delivery Method</label>
                                <input asp-for="DeliveryMethod" class="af-input" placeholder="e.g. Road, Courier, Hand Delivery" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Transporter" class="af-label">Transporter</label>
                                <input asp-for="Transporter" class="af-input" placeholder="e.g. SafeXpress, V-Trans" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Distance" class="af-label">Distance (km)</label>
                                <input asp-for="Distance" class="af-input" type="number" step="0.1" min="0" placeholder="e.g. 250" />
                                <span class="af-hint">Used for E-Way Bill transportation calculation.</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="field-check mt-md-4">
                                <div class="form-check">
                                    <input asp-for="AddDesignOnScan" class="form-check-input" />
                                    <label asp-for="AddDesignOnScan" class="form-check-label">Add Design on Barcode Scan</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3B: BANK ACCOUNTS -->
                    <div class="form-section-title">Bank Accounts</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IfscCode" class="af-label">IFSC Code</label>
                                <div class="input-group">
                                    <input asp-for="IfscCode" id="customerIfscInput" class="af-input text-uppercase font-monospace" placeholder="e.g. HDFC0001234" maxlength="11" />
                                    <button type="button" class="btn btn-secondary btn-sm" id="btnFetchCustomerIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                        <i class="bi bi-search"></i> Fetch
                                    </button>
                                </div>
                                <div id="customerIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="BankName" class="af-label">Bank Name</label>
                                <input asp-for="BankName" id="customerBankName" class="af-input" placeholder="Bank name" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="BankBranch" class="af-label">Branch Name</label>
                                <input asp-for="BankBranch" id="customerBankBranch" class="af-input" placeholder="Branch name" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="AccountNumber" class="af-label">Account Number</label>
                                <input asp-for="AccountNumber" class="af-input font-monospace" placeholder="A/C number" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: SALESMAN COMMISSION RULES -->
                    <div class="form-section-title">Salesman Commission Rules</div>
                    <div class="grid-actions">
                        <span class="form-text m-0">
                            Configure commission per Category, All Products, Specific Design, or Fixed Amount per piece.
                        </span>
                        <button type="button" id="btnAddCommissionRow" class="btn btn-sm btn-secondary">
                            <i class="bi bi-plus-lg"></i> Add commission rule
                        </button>
                    </div>

                    <div class="grid-card">
                        <table class="af-table table-edit" id="commissionTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:180px;">Salesman Name</th>
                                    <th style="min-width:170px;">Commission Basis</th>
                                    <th style="min-width:200px;">Target (Category / Design)</th>
                                    <th style="min-width:140px;">Calc Type</th>
                                    <th style="min-width:120px;">Rate</th>
                                    <th style="min-width:130px;">Start Date</th>
                                    <th style="min-width:130px;">End Date</th>
                                    <th class="text-center" style="width:65px;">Active</th>
                                    <th style="width:48px;"></th>
                                </tr>
                            </thead>
                            <tbody id="commissionBody">
                                @if (Model.Commissions != null && Model.Commissions.Any())
                                {
                                    for (int i = 0; i < Model.Commissions.Count; i++)
                                    {
                                        var comm = Model.Commissions[i];
                                        <tr class="commission-row">
                                            <td>
                                                <input list="salesmenDatalist" name="Commissions[@i].SalesmanName" value="@comm.SalesmanName" class="af-input comm-salesman" placeholder="Salesman name" />
                                            </td>
                                            <td>
                                                <select name="Commissions[@i].Basis" class="af-input af-select comm-basis-select">
                                                    <option value="0" selected="@(comm.Basis == CommissionBasis.Category)">Category-wise (Default)</option>
                                                    <option value="1" selected="@(comm.Basis == CommissionBasis.AllProducts)">All Products / Order Total</option>
                                                    <option value="2" selected="@(comm.Basis == CommissionBasis.Design)">Specific Design / Product</option>
                                                    <option value="3" selected="@(comm.Basis == CommissionBasis.FixedPerPiece)">Fixed Amount per Piece</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select class="af-input af-select comm-category-select @(comm.Basis == CommissionBasis.Category || comm.Basis == CommissionBasis.FixedPerPiece ? "" : "d-none")">
                                                    <option value="">-- All Categories --</option>
                                                    @if (ViewBag.Categories != null)
                                                    {
                                                        foreach (var cat in (List<AashanaFashion.Models.ProductCategory>)ViewBag.Categories)
                                                        {
                                                            <option value="@cat.CategoryName" selected="@(comm.TargetValue == cat.CategoryName)">@cat.CategoryName</option>
                                                        }
                                                    }
                                                </select>
                                                <select class="af-input af-select comm-design-select @(comm.Basis == CommissionBasis.Design ? "" : "d-none")">
                                                    <option value="">-- Select Design --</option>
                                                    @if (ViewBag.Designs != null)
                                                    {
                                                        foreach (var des in (IEnumerable<dynamic>)ViewBag.Designs)
                                                        {
                                                            <option value="@des.DesignNumber" data-id="@des.Id" selected="@(comm.TargetValue == des.DesignNumber || comm.DesignId == des.Id)">@des.DesignNumber</option>
                                                        }
                                                    }
                                                </select>
                                                <input type="text" class="af-input comm-text-target @(comm.Basis == CommissionBasis.AllProducts ? "" : "d-none")"
                                                       placeholder="All Products" value="@(comm.Basis == CommissionBasis.AllProducts ? "All Products" : comm.TargetValue)" />

                                                <input type="hidden" name="Commissions[@i].TargetValue" value="@comm.TargetValue" class="comm-target-val" />
                                                <input type="hidden" name="Commissions[@i].DesignId" value="@comm.DesignId" class="comm-design-id" />
                                            </td>
                                            <td>
                                                <select name="Commissions[@i].CalcType" class="af-input af-select comm-calctype-select">
                                                    <option value="0" selected="@(comm.CalcType == CommissionCalcType.Percentage)">Percentage (%)</option>
                                                    <option value="1" selected="@(comm.CalcType == CommissionCalcType.FixedAmount)">Fixed Amount (₹)</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input name="Commissions[@i].CommissionRate" value="@comm.CommissionRate" type="number" step="0.01" min="0" class="form-control form-control-sm comm-rate-input" placeholder="0.00" />
                                                    <span class="input-group-text comm-rate-unit">@(comm.CalcType == CommissionCalcType.FixedAmount ? "₹" : "%")</span>
                                                </div>
                                            </td>
                                            <td>
                                                <input name="Commissions[@i].StartDate" value="@(comm.StartDate?.ToString("yyyy-MM-dd"))" type="date" class="af-input form-control-sm" />
                                            </td>
                                            <td>
                                                <input name="Commissions[@i].EndDate" value="@(comm.EndDate?.ToString("yyyy-MM-dd"))" type="date" class="af-input form-control-sm" />
                                            </td>
                                            <td class="text-center align-middle">
                                                <input type="hidden" name="Commissions[@i].IsActive" value="false" />
                                                <input type="checkbox" name="Commissions[@i].IsActive" value="true" class="form-check-input" @(comm.IsActive ? "checked" : "") />
                                            </td>
                                            <td class="text-center align-middle">
                                                <button type="button" class="row-action danger remove-commission-row" title="Remove rule" aria-label="Remove rule"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="commission-row">
                                        <td>
                                            <input list="salesmenDatalist" name="Commissions[0].SalesmanName" class="af-input comm-salesman" placeholder="Salesman name" />
                                        </td>
                                        <td>
                                            <select name="Commissions[0].Basis" class="af-input af-select comm-basis-select">
                                                <option value="0" selected>Category-wise (Default)</option>
                                                <option value="1">All Products / Order Total</option>
                                                <option value="2">Specific Design / Product</option>
                                                <option value="3">Fixed Amount per Piece</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="af-input af-select comm-category-select">
                                                <option value="">-- All Categories --</option>
                                                @if (ViewBag.Categories != null)
                                                {
                                                    foreach (var cat in (List<AashanaFashion.Models.ProductCategory>)ViewBag.Categories)
                                                    {
                                                        <option value="@cat.CategoryName">@cat.CategoryName</option>
                                                    }
                                                }
                                            </select>
                                            <select class="af-input af-select comm-design-select d-none">
                                                <option value="">-- Select Design --</option>
                                                @if (ViewBag.Designs != null)
                                                {
                                                    foreach (var des in (IEnumerable<dynamic>)ViewBag.Designs)
                                                    {
                                                        <option value="@des.DesignNumber" data-id="@des.Id">@des.DesignNumber</option>
                                                    }
                                                }
                                            </select>
                                            <input type="text" class="af-input comm-text-target d-none" placeholder="All Products" />

                                            <input type="hidden" name="Commissions[0].TargetValue" class="comm-target-val" />
                                            <input type="hidden" name="Commissions[0].DesignId" class="comm-design-id" />
                                        </td>
                                        <td>
                                            <select name="Commissions[0].CalcType" class="af-input af-select comm-calctype-select">
                                                <option value="0" selected>Percentage (%)</option>
                                                <option value="1">Fixed Amount (₹)</option>
                                            </select>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input name="Commissions[0].CommissionRate" value="0.00" type="number" step="0.01" min="0" class="form-control form-control-sm comm-rate-input" placeholder="0.00" />
                                                <span class="input-group-text comm-rate-unit">%</span>
                                            </div>
                                        </td>
                                        <td>
                                            <input name="Commissions[0].StartDate" type="date" class="af-input form-control-sm" />
                                        </td>
                                        <td>
                                            <input name="Commissions[0].EndDate" type="date" class="af-input form-control-sm" />
                                        </td>
                                        <td class="text-center align-middle">
                                            <input type="hidden" name="Commissions[0].IsActive" value="false" />
                                            <input type="checkbox" name="Commissions[0].IsActive" value="true" class="form-check-input" checked />
                                        </td>
                                        <td class="text-center align-middle">
                                            <button type="button" class="row-action danger remove-commission-row" title="Remove rule" aria-label="Remove rule"><i class="bi bi-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <datalist id="salesmenDatalist">
                        @if (ViewBag.Users != null)
                        {
                            foreach (var u in (List<AashanaFashion.Models.AppUser>)ViewBag.Users)
                            {
                                <option value="@u.FullName">@u.FullName (@u.Role)</option>
                            }
                        }
                    </datalist>

                    <!-- SECTION 5: ADDITIONAL CONTACTS -->
                    <div class="form-section-title">Additional Contacts</div>
                    <div class="grid-card">
                        <table class="af-table table-edit" id="contactTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th style="width:48px;"></th>
                                </tr>
                            </thead>
                            <tbody id="contactBody">
                                @if (Model.Contacts != null && Model.Contacts.Any())
                                {
                                    for (int i = 0; i < Model.Contacts.Count; i++)
                                    {
                                        <tr class="contact-row">
                                            <td><input name="Contacts[@i].ContactName" value="@Model.Contacts[i].ContactName" class="af-input" placeholder="Contact name" /></td>
                                            <td><input name="Contacts[@i].ContactPhone" value="@Model.Contacts[i].ContactPhone" class="af-input" placeholder="Phone" /></td>
                                            <td><input name="Contacts[@i].ContactEmail" value="@Model.Contacts[i].ContactEmail" class="af-input" placeholder="Email" /></td>
                                            <td><input name="Contacts[@i].ContactRole" value="@Model.Contacts[i].ContactRole" class="af-input" placeholder="Role" /></td>
                                            <td>
                                                <button type="button" class="row-action danger remove-contact-row" title="Remove" aria-label="Remove" style="@(i == 0 && Model.Contacts.Count == 1 ? "display:none;" : "")">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="contact-row">
                                        <td><input name="Contacts[0].ContactName" class="af-input" placeholder="Contact name" /></td>
                                        <td><input name="Contacts[0].ContactPhone" class="af-input" placeholder="Phone" /></td>
                                        <td><input name="Contacts[0].ContactEmail" class="af-input" placeholder="Email" /></td>
                                        <td><input name="Contacts[0].ContactRole" class="af-input" placeholder="Role" /></td>
                                        <td><button type="button" class="row-action danger remove-contact-row" title="Remove" aria-label="Remove" style="display:none;"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addContactRow" class="btn btn-sm btn-secondary mt-3">
                        <i class="bi bi-plus-lg"></i> Add contact
                    </button>

                </div>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
    </div>
</form>

<!-- Quick Create Pricelist Modal -->
<div class="modal fade" id="quickPricelistModal" tabindex="-1" aria-labelledby="quickPricelistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickPricelistModalLabel">Add New Pricelist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="quickPlAlert" class="alert alert-danger d-none" role="alert"></div>
                
                <div class="mb-3">
                    <label class="form-label" for="quickPlName">Pricelist Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickPlName" class="form-control" placeholder="e.g. VIP Wholesale (12% Off)" required />
                </div>
                
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label" for="quickPlPolicy">Discount Policy</label>
                        <select id="quickPlPolicy" class="form-select form-select-sm">
                            <option value="0">Discount included in price</option>
                            <option value="1">Show discount % to customer</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="quickPlMethod">Discount Type</label>
                        <select id="quickPlMethod" class="form-select form-select-sm">
                            <option value="1">Percentage (%)</option>
                            <option value="0">Fixed Price (₹)</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6" id="quickPlPctCol">
                        <label class="form-label" for="quickPlDiscount">Discount %</label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.1" min="0" max="100" id="quickPlDiscount" class="form-control text-end" value="10" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-6 d-none" id="quickPlFixedCol">
                        <label class="form-label" for="quickPlFixed">Fixed Price</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0" id="quickPlFixed" class="form-control text-end" value="0.00" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="quickPlMinQty">Min Quantity</label>
                        <input type="number" step="1" min="1" id="quickPlMinQty" class="form-control form-control-sm text-center" value="1" />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label" for="quickPlDesc">Description / Notes</label>
                    <textarea id="quickPlDesc" class="form-control form-control-sm" rows="2" placeholder="Optional notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuickPricelist">Save &amp; select</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/customer.js"></script>
    <script>
        document.getElementById('quickPlMethod')?.addEventListener('change', function () {
            const isPct = this.value === '1';
            document.getElementById('quickPlPctCol').classList.toggle('d-none', !isPct);
            document.getElementById('quickPlFixedCol').classList.toggle('d-none', isPct);
        });

        document.getElementById('customerPricelistSelect')?.addEventListener('change', function () {
            const text = this.options[this.selectedIndex]?.text || '';
            const hiddenName = document.getElementById('customerPricelistNameHidden');
            if (hiddenName) hiddenName.value = this.value ? text.split(' (')[0].trim() : '';
        });

        document.getElementById('btnSaveQuickPricelist')?.addEventListener('click', function () {
            const name = document.getElementById('quickPlName').value.trim();
            const alertBox = document.getElementById('quickPlAlert');
            if (!name) {
                alertBox.textContent = 'Please enter a pricelist name.';
                alertBox.classList.remove('d-none');
                return;
            }

            const payload = {
                name: name,
                discountPolicy: parseInt(document.getElementById('quickPlPolicy').value),
                computationMethod: parseInt(document.getElementById('quickPlMethod').value),
                discountPercentage: parseFloat(document.getElementById('quickPlDiscount').value) || 0,
                fixedPrice: parseFloat(document.getElementById('quickPlFixed').value) || 0,
                minQuantity: parseFloat(document.getElementById('quickPlMinQty').value) || 1,
                description: document.getElementById('quickPlDesc').value.trim()
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/Pricelist/QuickCreate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json().then(data => ({ status: res.status, body: data })))
            .then(res => {
                if (!res.body.success) {
                    alertBox.textContent = res.body.message || 'Error creating pricelist.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                const sel = document.getElementById('customerPricelistSelect');
                const opt = new Option(`${res.body.name} (${res.body.policy})`, res.body.id, true, true);
                sel.add(opt);
                sel.value = res.body.id;

                const hiddenName = document.getElementById('customerPricelistNameHidden');
                if (hiddenName) hiddenName.value = res.body.name;

                const modalEl = document.getElementById('quickPricelistModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();

                alertBox.classList.add('d-none');
                document.getElementById('quickPlName').value = '';
                document.getElementById('quickPlDesc').value = '';
            })
            .catch(err => {
                alertBox.textContent = 'Server error creating pricelist.';
                alertBox.classList.remove('d-none');
                console.error(err);
            });
        });
    </script>
}
