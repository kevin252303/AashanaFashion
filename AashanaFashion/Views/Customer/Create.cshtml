@model AashanaFashion.Models.CustomerViewModel
@{
    ViewData["Title"] = "New Customer";
}

<div class="page-header">
    <div>
        <h1 class="page-title">New Customer</h1>
        <p class="page-sub">Add a new customer with all details</p>
    </div>
    <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back</a>
</div>

<form asp-action="Create" method="post" id="customerForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Customer Details</div>
        </div>
        <div style="padding:0;">

            <!-- Tabs -->
            <ul class="nav nav-tabs" id="customerTabs" role="tablist" style="padding:0 1.5rem;border-bottom:2px solid #e2e8f0;">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts" type="button" role="tab">Contacts</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab">Sales</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="accounting-tab" data-bs-toggle="tab" data-bs-target="#accounting" type="button" role="tab">Accounting</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="partner-tab" data-bs-toggle="tab" data-bs-target="#partner" type="button" role="tab">Partner Assignment</button>
                </li>
            </ul>

            <div class="tab-content" style="padding:1.5rem;">

                <!-- ===== TAB 1: CONTACTS ===== -->
                <div class="tab-pane fade show active" id="contacts" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="CustomerName" class="af-label">Customer Name *</label>
                                <input asp-for="CustomerName" class="af-input" required />
                                <span asp-validation-for="CustomerName" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="GstNumber" class="af-label">GST Number</label>
                                <input asp-for="GstNumber" class="af-input" id="GstNumber" style="text-transform:uppercase;" />
                            </div>
                            <div style="display:flex;gap:.5rem;align-items:center;margin-top:.25rem;">
                                <input type="text" id="gstInput" class="af-input" style="width:220px;text-transform:uppercase;" placeholder="Enter GST to fetch" maxlength="15" />
                                <button type="button" id="fetchGstBtn" class="btn-af btn-af-primary btn-af-sm">Fetch</button>
                                <span id="gstError" class="af-error" style="display:none;"></span>
                                <span id="gstSuccess" style="display:none;color:#16a34a;font-size:.85rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="ContactPerson" class="af-label">Contact Person</label>
                                <input asp-for="ContactPerson" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Phone" class="af-label">Phone</label>
                                <input asp-for="Phone" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Email" class="af-label">Email</label>
                                <input asp-for="Email" class="af-input" type="email" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PanNumber" class="af-label">PAN Number</label>
                                <input asp-for="PanNumber" class="af-input" style="text-transform:uppercase;" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="CustomerCompany" class="af-label">Company</label>
                                <input asp-for="CustomerCompany" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Website" class="af-label">Website</label>
                                <input asp-for="Website" class="af-input" placeholder="https://" />
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Address" class="af-label">Address</label>
                        <input asp-for="Address" class="af-input" />
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="City" class="af-label">City</label>
                                <input asp-for="City" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="State" class="af-label">State</label>
                                <input asp-for="State" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PinCode" class="af-label">Pin Code</label>
                                <input asp-for="PinCode" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="Industry" class="af-label">Industry</label>
                                <input asp-for="Industry" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Reference" class="af-label">Reference</label>
                                <input asp-for="Reference" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PartnerId" class="af-label">Partner ID</label>
                                <input asp-for="PartnerId" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;">Additional Contacts</label>
                    <div style="overflow-x:auto;margin-top:.5rem;">
                        <table class="af-table" id="contactTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="contactBody">
                                <tr class="contact-row">
                                    <td><input name="Contacts[0].ContactName" class="af-input" placeholder="Contact name" /></td>
                                    <td><input name="Contacts[0].ContactPhone" class="af-input" placeholder="Phone" /></td>
                                    <td><input name="Contacts[0].ContactEmail" class="af-input" placeholder="Email" /></td>
                                    <td><input name="Contacts[0].ContactRole" class="af-input" placeholder="Role" /></td>
                                    <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-contact-row" style="display:none;">×</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addContactRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Contact</button>
                </div>

                <!-- ===== TAB 2: SALES ===== -->
                <div class="tab-pane fade" id="sales" role="tabpanel">
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Sales</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Salesperson" class="af-label">Salesperson</label>
                                <input asp-for="Salesperson" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SalesPaymentTerms" class="af-label">Payment Terms</label>
                                <input asp-for="SalesPaymentTerms" class="af-input" placeholder="e.g. Net 30" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SalesPaymentMethod" class="af-label">Payment Method</label>
                                <input asp-for="SalesPaymentMethod" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Pricelist" class="af-label">Pricelist</label>
                                <input asp-for="Pricelist" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="DeliveryMethod" class="af-label">Delivery Method</label>
                                <input asp-for="DeliveryMethod" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Transporter" class="af-label">Transporter</label>
                                <input asp-for="Transporter" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Distance" class="af-label">Distance (km)</label>
                                <input asp-for="Distance" class="af-input" type="number" step="0.1" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="padding-top:1.8rem;">
                            <label><input asp-for="AddDesignOnScan" /> Add Design on Scan?</label>
                        </div>
                    </div>
                </div>

                <!-- ===== TAB 3: ACCOUNTING ===== -->
                <div class="tab-pane fade" id="accounting" role="tabpanel">
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Accounting Information</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountReceivable" class="af-label">Account Receivable</label>
                                <input asp-for="AccountReceivable" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="CustomerInvoices" class="af-label">Customer Invoices</label>
                                <input asp-for="CustomerInvoices" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PeppolId" class="af-label">Peppol ID</label>
                                <input asp-for="PeppolId" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="InvoiceReport" class="af-label">Invoice Report</label>
                                <input asp-for="InvoiceReport" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="JournalItems" class="af-label">Journal Items</label>
                                <input asp-for="JournalItems" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Send" class="af-label">Send</label>
                                <input asp-for="Send" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AnalyticDistribution" class="af-label">Analytic Distribution</label>
                                <input asp-for="AnalyticDistribution" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="padding-top:1.8rem;">
                            <label><input asp-for="AutoPostBills" /> Auto-post Bills</label>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Bank Accounts</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="BankName" class="af-label">Bank Name</label>
                                <input asp-for="BankName" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountNumber" class="af-label">Account Number</label>
                                <input asp-for="AccountNumber" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="IfscCode" class="af-label">IFSC Code</label>
                                <input asp-for="IfscCode" class="af-input" style="text-transform:uppercase;" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Follow-up</label>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="FollowUpLevel" class="af-label">Follow-up Level</label>
                                <select asp-for="FollowUpLevel" class="af-input af-select">
                                    <option value="">— Select —</option>
                                    <option value="45 Days">45 Days</option>
                                    <option value="30 Days">30 Days</option>
                                    <option value="15 Days">15 Days</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="FollowUpStatus" class="af-label">Follow-up Status</label>
                                <input asp-for="FollowUpStatus" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Reminders" class="af-label">Reminders</label>
                                <select asp-for="Reminders" class="af-input af-select">
                                    <option value="">— Select —</option>
                                    <option value="Automatic">Automatic</option>
                                    <option value="Manual">Manual</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="NextReminder" class="af-label">Next Reminder</label>
                                <input asp-for="NextReminder" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountingResponsible" class="af-label">Responsible</label>
                                <input asp-for="AccountingResponsible" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Credit Limits</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="TotalReceivable" class="af-label">Total Receivable (₹)</label>
                                <input asp-for="TotalReceivable" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="DaysSalesOutstanding" class="af-label">Days Sales Outstanding (DSO)</label>
                                <input asp-for="DaysSalesOutstanding" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnerLimit" class="af-label">Partner Limit (₹)</label>
                                <input asp-for="PartnerLimit" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Commission</label>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM1Name" class="af-label">SM 1 Name</label>
                                <input asp-for="SM1Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM1CommissionPct" class="af-label">SM 1 Commission %</label>
                                <input asp-for="SM1CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM2Name" class="af-label">SM 2 Name</label>
                                <input asp-for="SM2Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM2CommissionPct" class="af-label">SM 2 Commission %</label>
                                <input asp-for="SM2CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM3Name" class="af-label">SM 3 Name</label>
                                <input asp-for="SM3Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM3CommissionPct" class="af-label">SM 3 Commission %</label>
                                <input asp-for="SM3CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommissionStartDate" class="af-label">Start Date</label>
                                <input asp-for="CommissionStartDate" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommissionEndDate" class="af-label">End Date</label>
                                <input asp-for="CommissionEndDate" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== TAB 4: PARTNER ASSIGNMENT ===== -->
                <div class="tab-pane fade" id="partner" role="tabpanel">
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Partner Activation</label>
                    <div class="row">
                        <div class="col-md-3 d-flex align-items-center" style="padding-top:1.8rem;">
                            <label><input asp-for="Activation" /> Activation</label>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="LevelWeight" class="af-label">Level Weight</label>
                                <input asp-for="LevelWeight" class="af-input" type="number" min="0" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Partner Review</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="LatestReview" class="af-label">Latest Review</label>
                                <input asp-for="LatestReview" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="NextReview" class="af-label">Next Review</label>
                                <input asp-for="NextReview" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnershipDate" class="af-label">Partnership Date</label>
                                <input asp-for="PartnershipDate" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;color:#6366f1;">Geolocation</label>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="GeoLatitude" class="af-label">Geo Location (Latitude)</label>
                                <input asp-for="GeoLatitude" class="af-input" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="GeoLongitude" class="af-label">Geo Location (Longitude)</label>
                                <input asp-for="GeoLongitude" class="af-input" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="padding-top:1.8rem;">
                            <label><input asp-for="ComputeBasedOnAddress" /> Compute Based on Address</label>
                        </div>
                    </div>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IsActive" class="af-label">Status</label>
                                <select asp-for="IsActive" class="af-input af-select">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="display:flex;gap:.75rem;margin-top:1rem;">
        <button type="submit" class="btn-af btn-af-primary">Save Customer</button>
        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/customer.js"></script>
}
