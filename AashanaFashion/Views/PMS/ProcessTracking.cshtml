@model AashanaFashion.Controllers.ProcessTrackingViewModel
@{
    ViewData["Title"] = "Process Tracking";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var entities = ViewBag.Entities as List<AashanaFashion.Models.ProductionEntity> ?? new();
    var processNames = ViewBag.ProcessNames as string[] ?? Array.Empty<string>();
    bool canManage = role == "Admin" || role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Process Tracking</h1>
        <p class="page-sub">Monitor pieces at each process and catch delays early</p>
    </div>
    @if (Model.Trackings.Any())
    {
        <div class="page-actions">
            <a asp-action="ExportProcessTracking"
               asp-route-orderId="@ViewBag.SelectedOrderId"
               asp-route-processName="@ViewBag.SelectedProcessName"
               asp-route-search="@ViewBag.Search"
               asp-route-delayedOnly="@ViewBag.DelayedOnly"
               class="btn btn-secondary"><i class="bi bi-download"></i> Export CSV</a>
        </div>
    }
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total trackings</div>
        <div class="metric-value">@Model.Trackings.Count</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Completed</div>
        <div class="metric-value">@Model.Trackings.Count(t => t.IsComplete)</div>
        <div class="metric-meta success">returned from process</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Delayed</div>
        <div class="metric-value">@Model.Trackings.Count(t => !t.IsComplete && t.DaysLate > 0)</div>
        <div class="metric-meta danger">past expected return</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Total days late</div>
        <div class="metric-value">@(Model.Trackings.Where(t => t.DaysLate > 0).Sum(t => t.DaysLate) ?? 0)</div>
        <div class="metric-meta">across all delayed pieces</div>
    </div>
</div>

@if (Model.DelayedTrackings.Any())
{
    <div class="table-card mb-4">
        <div class="data-card-header">
            <span class="data-card-title"><i class="bi bi-exclamation-triangle text-danger"></i> Delayed items</span>
            <span class="af-badge b-red">@Model.DelayedTrackings.Count delayed</span>
        </div>
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Entity</th>
                        <th>Process</th>
                        <th>Subcontractor</th>
                        <th>Given</th>
                        <th>Expected Return</th>
                        <th>Days Late</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tracking in Model.DelayedTrackings)
                    {
                        <tr>
                            <td>
                                <span class="cell-title">@tracking.ProductionEntity?.ProductionOrder?.LotNo</span>
                                <span class="cell-sub">Piece #@tracking.ProductionEntity?.SlNo · @tracking.ProductionEntity?.Colour / @tracking.ProductionEntity?.Size</span>
                            </td>
                            <td><span class="tag">@tracking.ProcessName</span></td>
                            <td>@(tracking.Vendor?.VendorName ?? "—")</td>
                            <td class="text-muted">@tracking.GivenDate?.ToString("dd MMM")</td>
                            <td class="text-muted">@tracking.ExpectedReturnDate?.ToString("dd MMM")</td>
                            <td><span class="af-badge b-red">@tracking.DaysLate days</span></td>
                            <td class="cell-actions">
                                @if (canManage)
                                {
                                    <form asp-action="MarkReturned" asp-route-trackingId="@tracking.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-check-lg"></i> Mark returned</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="table-card">
    <form asp-action="ProcessTracking" method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="ptSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="ptSearch" name="search" class="af-input" placeholder="Code, barcode, vendor, challan…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="ptOrder">Order</label>
                <select id="ptOrder" name="orderId" class="af-input af-select">
                    <option value="">All orders</option>
                    @foreach (var entity in entities.DistinctBy(e => e.ProductionOrderId))
                    {
                        <option value="@entity.ProductionOrderId" selected="@(ViewBag.SelectedOrderId == entity.ProductionOrderId)">
                            @entity.ProductionOrder?.LotNo
                        </option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="ptProcess">Process</label>
                <select id="ptProcess" name="processName" class="af-input af-select">
                    <option value="All">All</option>
                    @foreach (var p in processNames)
                    {
                        <option value="@p" selected="@(ViewBag.SelectedProcessName == p)">@p</option>
                    }
                </select>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="delayedOnly" value="true" id="delayedOnly" @(ViewBag.DelayedOnly == true ? "checked" : "") />
                <label class="form-check-label" for="delayedOnly">Delayed only</label>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="ProcessTracking" class="btn btn-ghost">Clear</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Trackings.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-diagram-3"></i></div>
            <div class="es-title">No process trackings</div>
            <p>Pieces sent to a process will be tracked here.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Entity</th>
                        <th>Process</th>
                        <th>Subcontractor</th>
                        <th>Given</th>
                        <th>Expected Return</th>
                        <th>Actual Return</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tracking in Model.Trackings)
                    {
                        <tr>
                            <td>
                                <span class="cell-title">@tracking.ProductionEntity?.ProductionOrder?.LotNo</span>
                                <span class="cell-sub">Piece #@tracking.ProductionEntity?.SlNo · @tracking.ProductionEntity?.Colour / @tracking.ProductionEntity?.Size</span>
                            </td>
                            <td><span class="af-badge @GetProcessBadge(tracking.ProcessName)">@tracking.ProcessName</span></td>
                            <td>@(tracking.Vendor?.VendorName ?? "—")</td>
                            <td class="text-muted text-nowrap">@tracking.GivenDate?.ToString("dd MMM yyyy")</td>
                            <td class="text-muted text-nowrap">@tracking.ExpectedReturnDate?.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap">
                                @if (tracking.ActualReturnDate.HasValue)
                                {
                                    @tracking.ActualReturnDate?.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                @if (tracking.IsComplete)
                                {
                                    <span class="af-badge b-green">Complete</span>
                                }
                                else if (tracking.DaysLate > 0)
                                {
                                    <span class="af-badge b-red">@tracking.DaysLate days late</span>
                                }
                                else
                                {
                                    <span class="af-badge b-yellow">Pending</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    @if (!tracking.IsComplete && canManage)
                                    {
                                        <form asp-action="MarkReturned" asp-route-trackingId="@tracking.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-secondary"><i class="bi bi-check-lg"></i> Return</button>
                                        </form>
                                    }
                                    @if (tracking.IsComplete && canManage)
                                    {
                                        <a asp-controller="QualityControl" asp-action="Create"
                                           asp-route-orderId="@tracking.ProductionEntity?.ProductionOrderId"
                                           asp-route-entityId="@tracking.ProductionEntityId"
                                           asp-route-vendorId="@tracking.VendorId"
                                           class="btn btn-sm btn-secondary" title="Log quality check">
                                            <i class="bi bi-clipboard-check"></i> QC
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Trackings.Count</strong> trackings</span>
        </div>
    }
</div>

@functions {
    string GetProcessBadge(string process) => process switch
    {
        "Dying" => "b-purple",
        "Roll" => "b-cyan",
        "Handwork" => "b-yellow",
        "Stitching" => "b-blue",
        _ => "b-gray"
    };
}
