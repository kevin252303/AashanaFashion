@model AashanaFashion.Controllers.ProcessTrackingViewModel
@{
    ViewData["Title"] = "Process & Piece Tracking";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var orders = ViewBag.Orders as List<AashanaFashion.Models.ProductionOrder> ?? new();
    var processNames = ViewBag.ProcessNames as string[] ?? Array.Empty<string>();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    var colours = ViewBag.Colours as List<string> ?? new();
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new();
    var activeTab = Model.ActiveTab ?? "dispatches";
    bool canManage = role == "Admin" || role == "Manager";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Process & Piece Tracking</h1>
        <p class="page-sub">Monitor physical garment pieces, subcontractor dispatches, timelines, and delays in one unified view.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (ViewBag.SelectedOrderId != null && (int)ViewBag.SelectedOrderId > 0)
        {
            <a asp-controller="Barcode" asp-action="PrintTags" asp-route-orderId="@ViewBag.SelectedOrderId" target="_blank" class="btn btn-sm btn-outline-dark">
                🏷️ Print Barcode Tags
            </a>
            <a asp-controller="Barcode" asp-action="PrintLotTag" asp-route-orderId="@ViewBag.SelectedOrderId" target="_blank" class="btn btn-sm btn-outline-dark">
                Master Lot Tag
            </a>
        }
        @if (activeTab == "dispatches" && Model.Trackings.Any())
        {
            <a asp-action="ExportProcessTracking" 
               asp-route-orderId="@ViewBag.SelectedOrderId"
               asp-route-processName="@ViewBag.SelectedProcessName"
               asp-route-search="@ViewBag.Search"
               asp-route-delayedOnly="@ViewBag.DelayedOnly"
               class="btn-af btn-af-primary">📥 Download CSV</a>
        }
        else if (activeTab == "pieces" && Model.Entities.Any())
        {
            <a asp-action="ExportEntities" 
               asp-route-orderId="@ViewBag.SelectedOrderId"
               asp-route-status="@ViewBag.SelectedStatus"
               asp-route-colour="@ViewBag.SelectedColour"
               asp-route-search="@ViewBag.Search"
               class="btn-af btn-af-primary">📥 Download CSV</a>
        }
    </div>
</div>

<!-- Unified Navigation Tabs -->
<ul class="nav nav-tabs mb-4" id="trackingTabs" role="tablist" style="border-bottom: 2px solid #e2e8f0;">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(activeTab == "dispatches" ? "active" : "") fw-bold py-2 px-3" 
           href="@Url.Action("ProcessTracking", new { tab = "dispatches", orderId = ViewBag.SelectedOrderId, search = ViewBag.Search })"
           style="border-radius: 8px 8px 0 0;">
            🚚 Subcontractor Movements & Delays
            <span class="badge @(Model.DelayedTrackings.Any() ? "bg-danger" : "bg-primary") ms-1">@Model.Trackings.Count</span>
            @if (Model.DelayedTrackings.Any())
            {
                <span class="badge bg-danger ms-1">@Model.DelayedTrackings.Count Late</span>
            }
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(activeTab == "pieces" ? "active" : "") fw-bold py-2 px-3" 
           href="@Url.Action("ProcessTracking", new { tab = "pieces", orderId = ViewBag.SelectedOrderId, search = ViewBag.Search })"
           style="border-radius: 8px 8px 0 0;">
            🏷️ Garment Pieces & Barcode Labels
            <span class="badge bg-secondary ms-1">@Model.Entities.Count</span>
        </a>
    </li>
</ul>

@if (activeTab == "dispatches")
{
    <!-- TAB 1: SUBCONTRACTOR MOVEMENTS & DELAYS -->
    <!-- Filters for Dispatches -->
    <div class="data-card mb-4">
        <div style="padding:1rem;">
            <form asp-action="ProcessTracking" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="tab" value="dispatches" />
                <div class="col-md-3">
                    <label class="af-label">Search</label>
                    <input type="text" name="search" class="af-input" placeholder="Search piece, barcode, vendor..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <label class="af-label">Order Lot</label>
                    <select name="orderId" class="af-input af-select">
                        <option value="">All Orders</option>
                        @foreach (var o in orders)
                        {
                            <option value="@o.Id" selected="@(ViewBag.SelectedOrderId == o.Id)">@o.LotNo - @o.Design?.DesignNumber</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="af-label">Process</label>
                    <select name="processName" class="af-input af-select">
                        <option value="All">All Processes</option>
                        @foreach (var p in processNames)
                        {
                            <option value="@p" selected="@(ViewBag.SelectedProcessName == p)">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check ms-1 mb-2">
                        <input class="form-check-input" type="checkbox" name="delayedOnly" value="true" id="delayedOnly" @(ViewBag.DelayedOnly == true ? "checked" : "") />
                        <label class="form-check-label small" for="delayedOnly">Delayed Only</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn-af btn-af-primary flex-fill">Filter</button>
                    <a asp-action="ProcessTracking" asp-route-tab="dispatches" class="btn-af btn-af-ghost">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon si-blue">📋</div>
                <div><div class="stat-val">@Model.Trackings.Count</div><div class="stat-lbl">Total Movements</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon si-green">✅</div>
                <div><div class="stat-val">@Model.Trackings.Count(t => t.IsComplete)</div><div class="stat-lbl">Completed Returns</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon si-yellow">⏳</div>
                <div><div class="stat-val">@Model.Trackings.Count(t => !t.IsComplete && t.DaysLate == null)</div><div class="stat-lbl">In Process (On Time)</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card" style="border-left:4px solid #ef4444;">
                <div class="stat-icon si-red">⚠️</div>
                <div>
                    <div class="stat-val text-danger">@Model.Trackings.Count(t => !t.IsComplete && t.DaysLate > 0)</div>
                    <div class="stat-lbl">Overdue / Delayed (@(Model.Trackings.Where(t => t.DaysLate > 0).Sum(t => t.DaysLate) ?? 0) days total)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delayed Items Alert Card -->
    @if (Model.DelayedTrackings.Any())
    {
        <div class="data-card mb-4" style="border-left:4px solid #ef4444;">
            <div class="data-card-header" style="background: #fef2f2;">
                <span class="data-card-title text-danger">⚠️ Delayed Subcontractor Items (@Model.DelayedTrackings.Count)</span>
            </div>
            <div class="table-responsive">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th style="width:45px;">Sr.</th>
                            <th>Piece & Lot</th>
                            <th>Process</th>
                            <th>Subcontractor</th>
                            <th>Given Date</th>
                            <th>Expected Return</th>
                            <th>Days Late</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int delaySr = 1; }
                        @foreach (var tracking in Model.DelayedTrackings)
                        {
                            <tr class="delayed-row">
                                <td class="text-muted small">@(delaySr++)</td>
                                <td>
                                    <strong>@tracking.ProductionEntity?.ProductionOrder?.LotNo</strong>
                                    <span class="text-muted small">Piece #@tracking.ProductionEntity?.SlNo (@tracking.ProductionEntity?.Colour / @tracking.ProductionEntity?.Size)</span>
                                </td>
                                <td><span class="af-badge @GetProcessBadge(tracking.ProcessName)">@tracking.ProcessName</span></td>
                                <td><strong class="text-danger">@(tracking.Vendor?.VendorName ?? "—")</strong></td>
                                <td>@tracking.GivenDate?.ToString("dd MMM yyyy")</td>
                                <td><span class="text-danger fw-bold">@tracking.ExpectedReturnDate?.ToString("dd MMM yyyy")</span></td>
                                <td><span class="af-badge b-red">@tracking.DaysLate days late</span></td>
                                <td>
                                    @if (role == "Admin" || role == "Manager")
                                    {
                                        <form asp-action="MarkReturned" asp-route-trackingId="@tracking.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-af btn-af-success btn-af-sm">✓ Return</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- All Subcontractor Movements Table -->
    <div class="data-card">
        <div class="data-card-header">
            <span class="data-card-title">All Subcontractor Movements & Logs</span>
        </div>
        
        @if (!Model.Trackings.Any())
        {
            <div class="empty-state">
                <div class="es-icon">📋</div>
                <p>No process tracking movements found for the selected filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th style="width:45px;">Sr.</th>
                            <th>Piece / Lot</th>
                            <th>Process</th>
                            <th>Subcontractor</th>
                            <th>Given Date</th>
                            <th>Expected Return</th>
                            <th>Actual Return</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int dispSr = 1; }
                        @foreach (var tracking in Model.Trackings)
                        {
                            <tr class="@(tracking.DaysLate > 0 ? "delayed-row" : "")">
                                <td class="text-muted small">@(dispSr++)</td>
                                <td>
                                    <strong>@tracking.ProductionEntity?.ProductionOrder?.LotNo</strong>
                                    <br><span style="font-size:.75rem;color:#64748b;">Piece #@tracking.ProductionEntity?.SlNo (@tracking.ProductionEntity?.Colour / @tracking.ProductionEntity?.Size)</span>
                                </td>
                                <td><span class="af-badge @GetProcessBadge(tracking.ProcessName)">@tracking.ProcessName</span></td>
                                <td><strong>@(tracking.Vendor?.VendorName ?? "—")</strong></td>
                                <td>@tracking.GivenDate?.ToString("dd MMM yyyy")</td>
                                <td>@tracking.ExpectedReturnDate?.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (tracking.ActualReturnDate.HasValue)
                                    {
                                        @tracking.ActualReturnDate?.ToString("dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">-</span>
                                    }
                                </td>
                                <td>
                                    @if (tracking.IsComplete)
                                    {
                                        <span class="af-badge b-green">✓ Complete</span>
                                    }
                                    else if (tracking.DaysLate > 0)
                                    {
                                        <span class="af-badge b-red">@tracking.DaysLate days late</span>
                                    }
                                    else
                                    {
                                        <span class="af-badge b-yellow">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (!tracking.IsComplete && (role == "Admin" || role == "Manager"))
                                    {
                                        <form asp-action="MarkReturned" asp-route-trackingId="@tracking.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-af btn-af-success btn-af-sm">✓ Return</button>
                                        </form>
                                    }
                                    @if (tracking.IsComplete && (role == "Admin" || role == "Manager"))
                                    {
                                        <a asp-controller="QualityControl" asp-action="Create" 
                                           asp-route-orderId="@tracking.ProductionEntity?.ProductionOrderId"
                                           asp-route-entityId="@tracking.ProductionEntityId"
                                           asp-route-vendorId="@tracking.VendorId"
                                           class="btn-af btn-af-secondary btn-af-sm" title="Log Quality Check">
                                            🔍 QC
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <!-- TAB 2: GARMENT PIECES & BARCODE LABELS -->
    <!-- Filters for Pieces -->
    <div class="data-card mb-4">
        <div style="padding:1rem;">
            <form asp-action="ProcessTracking" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="tab" value="pieces" />
                <div class="col-md-3">
                    <label class="af-label">Search</label>
                    <input type="text" name="search" class="af-input" placeholder="Barcode, Lot, Colour, Size..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <label class="af-label">Order Lot</label>
                    <select name="orderId" class="af-input af-select">
                        <option value="">All Orders</option>
                        @foreach (var o in orders)
                        {
                            <option value="@o.Id" selected="@(ViewBag.SelectedOrderId == o.Id)">@o.LotNo - @o.Design?.DesignNumber</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="af-label">Stage Status</label>
                    <select name="status" class="af-input af-select">
                        <option value="All">All Statuses</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s" selected="@(ViewBag.SelectedStatus == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="af-label">Colour</label>
                    <select name="colour" class="af-input af-select">
                        <option value="All">All Colours</option>
                        @foreach (var c in colours)
                        {
                            <option value="@c" selected="@(ViewBag.SelectedColour == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn-af btn-af-primary flex-fill">Filter</button>
                    <a asp-action="ProcessTracking" asp-route-tab="pieces" class="btn-af btn-af-ghost">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-2">
            <div class="stat-card">
                <div class="stat-icon si-blue">🔢</div>
                <div><div class="stat-val">@Model.Entities.Count</div><div class="stat-lbl">Total Pieces</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="stat-card">
                <div class="stat-icon si-purple">🎨</div>
                <div><div class="stat-val">@Model.Entities.Count(e => e.Status == "AtDying")</div><div class="stat-lbl">At Dying</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon si-yellow">✨</div>
                <div><div class="stat-val">@Model.Entities.Count(e => e.Status == "AtHandwork")</div><div class="stat-lbl">At Handwork</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="stat-card">
                <div class="stat-icon si-cyan">🪡</div>
                <div><div class="stat-val">@Model.Entities.Count(e => e.Status == "AtStitching")</div><div class="stat-lbl">At Stitching</div></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon si-green">✅</div>
                <div><div class="stat-val">@Model.Entities.Count(e => e.Status == "Completed" || e.Status == "ReadyToDispatch" || e.Status == "Dispatched")</div><div class="stat-lbl">Finished Pieces</div></div>
            </div>
        </div>
    </div>

    <!-- Garment Pieces Catalog Table -->
    <div class="data-card">
        <div class="data-card-header">
            <span class="data-card-title">Garment Pieces & Barcode Labels</span>
        </div>
        
        @if (!Model.Entities.Any())
        {
            <div class="empty-state">
                <div class="es-icon">🔢</div>
                <p>No garment tracking entities found for the selected filters.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th style="width:45px;">Sr.</th>
                            <th>Barcode Tag</th>
                            <th style="width:75px;">Piece #</th>
                            <th>Lot No</th>
                            <th>Design</th>
                            <th>Colour</th>
                            <th>Size</th>
                            <th>Current Status</th>
                            <th>Lifecycle Progress</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int pieceSr = 1; }
                        @foreach (var entity in Model.Entities)
                        {
                            <tr>
                                <td class="text-muted small">@(pieceSr++)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(entity.Barcode))
                                    {
                                        <code class="small text-dark fw-bold px-2 py-1" style="background:#f1f5f9; border-radius:4px;">@entity.Barcode</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td><strong class="text-primary">#@entity.SlNo</strong></td>
                                <td>
                                    <strong>@entity.ProductionOrder?.LotNo</strong>
                                    @if (entity.ProductionOrder?.HandworkWorker != null)
                                    {
                                        <div style="font-size:0.72rem; color:#475569; white-space:nowrap;">✨ @entity.ProductionOrder.HandworkWorker.VendorName</div>
                                    }
                                    @if (entity.ProductionOrder?.StitchingWorker != null)
                                    {
                                        <div style="font-size:0.72rem; color:#475569; white-space:nowrap;">🪡 @entity.ProductionOrder.StitchingWorker.VendorName</div>
                                    }
                                </td>
                                <td>@entity.ProductionOrder?.Design?.DesignNumber</td>
                                <td>@entity.Colour</td>
                                <td>@entity.Size</td>
                                <td><span class="af-badge @GetStatusBadge(entity.Status)">@entity.Status</span></td>
                                <td>
                                    @{
                                        var designSteps = entity.ProductionOrder?.Design?.GetCreationSteps() ?? new List<string> { "Dying", "Handwork", "Stitching" };
                                        var total = designSteps.Count > 0 ? designSteps.Count : 3;
                                        
                                        var effStage = entity.Status;
                                        int completedFromStage = 0;
                                        if (effStage == "Completed" || effStage == "Dispatched" || effStage == "ReadyToDispatch")
                                        {
                                            completedFromStage = total;
                                        }
                                        else if (effStage == "AtStitching")
                                        {
                                            int idx = designSteps.FindIndex(s => s.Contains("Stitch", StringComparison.OrdinalIgnoreCase));
                                            completedFromStage = idx >= 0 ? idx : (total > 1 ? total - 1 : 1);
                                        }
                                        else if (effStage == "AtHandwork")
                                        {
                                            int idx = designSteps.FindIndex(s => s.Contains("Hand", StringComparison.OrdinalIgnoreCase) || s.Contains("Emb", StringComparison.OrdinalIgnoreCase));
                                            completedFromStage = idx >= 0 ? idx : 1;
                                        }
                                        else if (effStage == "AtRoll")
                                        {
                                            int idx = designSteps.FindIndex(s => s.Contains("Roll", StringComparison.OrdinalIgnoreCase));
                                            completedFromStage = idx >= 0 ? idx : 1;
                                        }
                                        else if (effStage == "AtDying")
                                        {
                                            completedFromStage = 0;
                                        }

                                        int completedFromTrackings = entity.ProcessTrackings.Count(t => t.IsComplete);
                                        int completed = Math.Max(completedFromStage, completedFromTrackings);
                                        if (completed > total) completed = total;
                                        var pct = total > 0 ? (int)Math.Round((double)completed / total * 100) : 0;
                                        var stepsTooltip = string.Join(" → ", designSteps);
                                    }
                                    <div class="d-flex align-items-center gap-2" title="Stages: @stepsTooltip">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 50px; background-color: #e2e8f0; border-radius: 4px;">
                                            <div class="progress-bar @(completed == total ? "bg-success" : (completed > 0 ? "bg-primary" : "bg-secondary"))" 
                                                 role="progressbar" 
                                                 style="width: @pct%;"></div>
                                        </div>
                                        <span class="fw-bold @(completed == total ? "text-success" : (completed > 0 ? "text-primary" : "text-muted"))" style="font-size: 0.85rem;">
                                            @completed/@total
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (entity.Status != "Completed" && entity.Status != "Dispatched" && entity.Status != "ReadyToDispatch" && (role == "Admin" || role == "Manager"))
                                    {
                                        <button type="button" class="btn-af btn-af-primary btn-af-sm send-process-btn" 
                                                data-id="@entity.Id" 
                                                data-name="Piece #@entity.SlNo — @(entity.ProductionOrder?.Design?.DesignNumber ?? "Garment") (@entity.Colour / @entity.Size)"
                                                data-hw-vendor="@(entity.ProductionOrder?.HandworkWorkerId ?? entity.ProductionOrder?.Design?.HandworkWorkerId ?? 0)"
                                                data-st-vendor="@(entity.ProductionOrder?.StitchingWorkerId ?? entity.ProductionOrder?.Design?.StitchingWorkerId ?? 0)"
                                                data-hw-parts="@(entity.ProductionOrder?.HandworkComponentsSummary ?? entity.ProductionOrder?.Design?.HandworkComponentsSummary ?? "")">
                                            Send to Process
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="color:#cbd5e1;">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<!-- Send for Process Modal -->
<div class="modal fade" id="sendProcessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
            <div class="modal-header" style="background:#f8fafc; border-bottom:1px solid #e2e8f0; border-top-left-radius:12px; border-top-right-radius:12px;">
                <h5 class="modal-title" style="font-weight:700; color:#0f172a;">Send Garment Piece to Process</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="background:none; border:none; font-size:1.5rem; line-height:1; color:#94a3b8; cursor:pointer;">&times;</button>
            </div>
            <form asp-action="SendForProcess" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:1.5rem;">
                    <input type="hidden" id="modalEntityId" name="entityId" />
                    
                    <div class="mb-3">
                        <label class="af-label" style="font-weight:600; margin-bottom:.4rem; display:block;">Garment Piece</label>
                        <input type="text" id="modalEntityName" class="af-input" readonly style="background:#f1f5f9; cursor:not-allowed;" />
                    </div>

                    <div id="modalHwNotice" class="alert alert-warning py-1 px-3 small mb-3" style="display:none; font-size:0.82rem;">
                        ✨ <strong>Handwork Parts for this lot:</strong> <span id="modalHwPartsText"></span>
                    </div>

                    <div class="mb-3">
                        <label class="af-label" style="font-weight:600; margin-bottom:.4rem; display:block;">Process Type *</label>
                        <select name="processName" class="af-input af-select" id="modalProcessSelect" required>
                            <option value="">— Select Process —</option>
                            <option value="Dying">Dying</option>
                            <option value="Roll">Roll Press</option>
                            <option value="Handwork">Handwork (Embroidery)</option>
                            <option value="Stitching">Stitching (Tailoring)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="af-label" style="font-weight:600; margin-bottom:.4rem; display:block;">Subcontractor / Karigar *</label>
                        <select name="vendorId" class="af-input af-select" id="modalVendorSelect" required>
                            <option value="">— Select Karigar —</option>
                            @foreach (var v in vendors)
                            {
                                <option value="@v.Id">@v.VendorName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="af-label" style="font-weight:600; margin-bottom:.4rem; display:block;">Expected Return Date *</label>
                        <input name="expectedReturn" type="date" class="af-input" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer" style="background:#f8fafc; border-top:1px solid #e2e8f0; border-bottom-left-radius:12px; border-bottom-right-radius:12px; display:flex; justify-content:flex-end; gap:.5rem;">
                    <button type="button" class="btn-af btn-af-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-af btn-af-primary">Send to Process</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .delayed-row { background: #fef2f2 !important; }
    .nav-tabs .nav-link {
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-bottom: none;
        margin-right: 4px;
        transition: all 0.2s ease;
    }
    .nav-tabs .nav-link.active {
        color: #1e293b;
        background: #ffffff;
        border-color: #cbd5e1 #cbd5e1 #ffffff #cbd5e1;
        box-shadow: 0 -2px 5px rgba(0,0,0,0.02);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            var currentHwVendor = 0;
            var currentStVendor = 0;
            var currentHwParts = '';

            $('.send-process-btn').click(function() {
                var entityId = $(this).data('id');
                var entityName = $(this).data('name');
                currentHwVendor = $(this).data('hw-vendor') || 0;
                currentStVendor = $(this).data('st-vendor') || 0;
                currentHwParts = $(this).data('hw-parts') || '';
                
                $('#modalEntityId').val(entityId);
                $('#modalEntityName').val(entityName);
                $('#modalProcessSelect').val('');
                $('#modalVendorSelect').val('');
                $('#modalHwNotice').hide();
                
                var modal = new bootstrap.Modal(document.getElementById('sendProcessModal'));
                modal.show();
            });

            $('#modalProcessSelect').change(function() {
                var proc = $(this).val();
                if (proc === 'Handwork') {
                    if (currentHwVendor > 0) {
                        $('#modalVendorSelect').val(currentHwVendor);
                    }
                    if (currentHwParts && currentHwParts !== 'None') {
                        $('#modalHwPartsText').text(currentHwParts);
                        $('#modalHwNotice').show();
                    } else {
                        $('#modalHwNotice').hide();
                    }
                } else if (proc === 'Stitching') {
                    if (currentStVendor > 0) {
                        $('#modalVendorSelect').val(currentStVendor);
                    }
                    $('#modalHwNotice').hide();
                } else {
                    $('#modalHwNotice').hide();
                }
            });
        });
    </script>
}

@functions {
    string GetProcessBadge(string process) => process switch
    {
        "Dying" => "b-purple",
        "Roll" => "b-cyan",
        "Handwork" => "b-yellow",
        "Stitching" => "b-blue",
        _ => "b-gray"
    };

    string GetStatusBadge(string status) => status switch
    {
        "Created" => "b-gray",
        "AtDying" => "b-purple",
        "AtRoll" => "b-cyan",
        "AtHandwork" => "b-yellow",
        "AtStitching" => "b-blue",
        "ReadyToDispatch" => "b-green",
        "Completed" => "b-green",
        "Dispatched" => "b-gray",
        _ => "b-gray"
    };
}
