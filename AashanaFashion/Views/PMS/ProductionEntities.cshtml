@model IEnumerable<AashanaFashion.Models.ProductionEntity>
@{
    ViewData["Title"] = "Production Entities";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var orders = ViewBag.Orders as List<AashanaFashion.Models.ProductionOrder> ?? new();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    var colours = ViewBag.Colours as List<string> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Production Entities</h1>
        <p class="page-sub">Track individual garment pieces through production</p>
    </div>
    <div class="page-actions">
        @if (ViewBag.SelectedOrderId != null && (int)ViewBag.SelectedOrderId > 0)
        {
            <a asp-controller="Barcode" asp-action="PrintTags" asp-route-orderId="@ViewBag.SelectedOrderId" target="_blank" class="btn btn-secondary"><i class="bi bi-upc"></i> Print barcode tags</a>
            <a asp-controller="Barcode" asp-action="PrintLotTag" asp-route-orderId="@ViewBag.SelectedOrderId" target="_blank" class="btn btn-secondary"><i class="bi bi-tag"></i> Master lot tag</a>
        }
        @if (Model.Any())
        {
            <a asp-action="ExportEntities"
               asp-route-orderId="@ViewBag.SelectedOrderId"
               asp-route-status="@ViewBag.SelectedStatus"
               asp-route-colour="@ViewBag.SelectedColour"
               asp-route-search="@ViewBag.Search"
               class="btn btn-secondary"><i class="bi bi-download"></i> Export CSV</a>
        }
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Total entities</div>
        <div class="metric-value">@Model.Count()</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">At dying</div>
        <div class="metric-value">@Model.Count(e => e.Status == "AtDying")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">At roll</div>
        <div class="metric-value">@Model.Count(e => e.Status == "AtRoll")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Completed</div>
        <div class="metric-value">@Model.Count(e => e.Status == "Completed")</div>
        <div class="metric-meta success">all processes done</div>
    </div>
</div>

<div class="table-card">
    <form asp-action="ProductionEntities" method="get" class="table-toolbar align-end">
        <div class="toolbar-filters align-items-end">
            <div class="toolbar-field">
                <label for="peSearch">Search</label>
                <div class="search-field">
                    <i class="bi bi-search"></i>
                    <input type="text" id="peSearch" name="search" class="af-input" placeholder="Code, barcode, lot, size…" value="@ViewBag.Search" />
                </div>
            </div>
            <div class="toolbar-field">
                <label for="peOrder">Order</label>
                <select id="peOrder" name="orderId" class="af-input af-select">
                    <option value="">All orders</option>
                    @foreach (var order in orders)
                    {
                        <option value="@order.Id" selected="@(ViewBag.SelectedOrderId == order.Id)">@order.LotNo - @order.Design?.DesignNumber</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="peStatus">Status</label>
                <select id="peStatus" name="status" class="af-input af-select">
                    <option value="All">All</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(ViewBag.SelectedStatus == s)">@s.Humanize()</option>
                    }
                </select>
            </div>
            <div class="toolbar-field">
                <label for="peColour">Colour</label>
                <select id="peColour" name="colour" class="af-input af-select">
                    <option value="All">All</option>
                    @foreach (var c in colours)
                    {
                        <option value="@c" selected="@(ViewBag.SelectedColour == c)">@c</option>
                    }
                </select>
            </div>
        </div>
        <div class="toolbar-actions">
            <a asp-action="ProductionEntities" class="btn btn-ghost">Clear</a>
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi bi-123"></i></div>
            <div class="es-title">No entities found</div>
            <p>Generate entities from production orders to track individual pieces.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Sl No</th>
                        <th>Barcode</th>
                        <th>Lot</th>
                        <th>Design</th>
                        <th>Colour</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Processes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entity in Model)
                    {
                        <tr>
                            <td class="cell-title tabular">@entity.SlNo</td>
                            <td>
                                @if (!string.IsNullOrEmpty(entity.Barcode))
                                {
                                    <span class="mono-id">@entity.Barcode</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>
                                <span class="cell-title">@entity.ProductionOrder?.LotNo</span>
                                @if (entity.ProductionOrder?.StitchingWorker != null)
                                {
                                    <span class="cell-sub text-nowrap">@entity.ProductionOrder.StitchingWorker.VendorName</span>
                                }
                                @if (entity.ProductionOrder?.HandworkWorker != null)
                                {
                                    <span class="cell-sub text-nowrap">@entity.ProductionOrder.HandworkWorker.VendorName (@entity.ProductionOrder.HandworkComponentsSummary)</span>
                                }
                            </td>
                            <td>@entity.ProductionOrder?.Design?.DesignNumber</td>
                            <td>@entity.Colour</td>
                            <td>@entity.Size</td>
                            @{
                                var displayStatus = entity.Status;
                                if (displayStatus == "Created" && entity.ProductionOrder != null && entity.ProductionOrder.Status != AashanaFashion.Models.OrderStatus.RawMaterialArrived)
                                {
                                    displayStatus = entity.ProductionOrder.Status switch
                                    {
                                        AashanaFashion.Models.OrderStatus.AtDying => "AtDying",
                                        AashanaFashion.Models.OrderStatus.AtHandwork => "AtHandwork",
                                        AashanaFashion.Models.OrderStatus.AtStitching => "AtStitching",
                                        AashanaFashion.Models.OrderStatus.ReadyToDispatch => "ReadyToDispatch",
                                        AashanaFashion.Models.OrderStatus.Dispatched => "Dispatched",
                                        _ => "Created"
                                    };
                                }
                            }
                            <td><span class="af-badge @GetStatusBadge(displayStatus)">@displayStatus.Humanize()</span></td>
                            <td>
                            @{
                                var designSteps = entity.ProductionOrder?.Design?.GetCreationSteps() ?? new List<string> { "Dying", "Handwork", "Stitching" };
                                var total = designSteps.Count > 0 ? designSteps.Count : 3;
                                
                                var effStage = (entity.Status != "Created") 
                                    ? entity.Status 
                                    : (entity.ProductionOrder?.Status.ToString() ?? "Created");

                                int completedFromStage = 0;
                                if (effStage == "Completed" || effStage == "Dispatched" || effStage == "ReadyToDispatch")
                                {
                                    completedFromStage = total;
                                }
                                else if (effStage == "AtStitching")
                                {
                                    int idx = designSteps.FindIndex(s => s.Contains("Stitch", StringComparison.OrdinalIgnoreCase));
                                    completedFromStage = idx >= 0 ? idx : (total > 1 ? total - 1 : 1);
                                }
                                else if (effStage == "AtHandwork")
                                {
                                    int idx = designSteps.FindIndex(s => s.Contains("Hand", StringComparison.OrdinalIgnoreCase) || s.Contains("Emb", StringComparison.OrdinalIgnoreCase));
                                    completedFromStage = idx >= 0 ? idx : 1;
                                }
                                else if (effStage == "AtRoll")
                                {
                                    int idx = designSteps.FindIndex(s => s.Contains("Roll", StringComparison.OrdinalIgnoreCase));
                                    completedFromStage = idx >= 0 ? idx : 1;
                                }
                                else if (effStage == "AtDying")
                                {
                                    completedFromStage = 0;
                                }

                                int completedFromTrackings = entity.ProcessTrackings.Count(t => t.IsComplete);
                                int completed = Math.Max(completedFromStage, completedFromTrackings);
                                if (completed > total) completed = total;
                                var pct = total > 0 ? (int)Math.Round((double)completed / total * 100) : 0;
                                var stepsTooltip = string.Join(" → ", designSteps);
                            }
                                <div class="d-flex align-items-center gap-2" title="Stages: @stepsTooltip">
                                    <div class="af-progress flex-grow-1" style="width: 60px;">
                                        <div class="af-progress-bar @(completed == total ? "bg-success" : "")" role="progressbar" style="width: @pct%;"></div>
                                    </div>
                                    <span class="text-xs tabular fw-medium @(completed == total ? "text-success" : (completed > 0 ? "text-primary" : "text-muted"))">@completed/@total</span>
                                </div>
                            </td>
                            <td class="cell-actions">
                                @if (displayStatus != "Completed" && displayStatus != "Dispatched" && displayStatus != "ReadyToDispatch" && (role == "Admin" || role == "Manager"))
                                {
                                    <button type="button" class="btn btn-sm btn-secondary send-process-btn"
                                            data-id="@entity.Id"
                                            data-name="Piece #@entity.SlNo — @(entity.ProductionOrder?.Design?.DesignNumber ?? "Garment") (@entity.Colour / @entity.Size)"
                                            data-hw-vendor="@(entity.ProductionOrder?.HandworkWorkerId ?? entity.ProductionOrder?.Design?.HandworkWorkerId ?? 0)"
                                            data-st-vendor="@(entity.ProductionOrder?.StitchingWorkerId ?? entity.ProductionOrder?.Design?.StitchingWorkerId ?? 0)"
                                            data-hw-parts="@(entity.ProductionOrder?.HandworkComponentsSummary ?? entity.ProductionOrder?.Design?.HandworkComponentsSummary ?? "")">
                                        <i class="bi bi-send"></i> Send to process
                                    </button>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> entities</span>
        </div>
    }
</div>

<!-- Send for Process Modal -->
<div class="modal fade" id="sendProcessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Send garment piece to process</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SendForProcess" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="modalEntityId" name="entityId" />

                    <div class="af-form-group">
                        <label class="af-label" for="modalEntityName">Garment piece</label>
                        <input type="text" id="modalEntityName" class="af-input" readonly />
                    </div>

                    <div id="modalHwNotice" class="af-alert af-alert-warning" style="display:none;">
                        <div class="alert-body"><span class="alert-title">Handwork parts for this lot</span><span id="modalHwPartsText"></span></div>
                    </div>

                    <div class="af-form-group">
                        <label class="af-label" for="modalProcessSelect">Process type <span class="req">*</span></label>
                        <select name="processName" class="af-input af-select" id="modalProcessSelect" required>
                            <option value="">— Select Process —</option>
                            <option value="Dying">Dying</option>
                            <option value="Roll">Roll Press</option>
                            <option value="Handwork">Handwork (Embroidery)</option>
                            <option value="Stitching">Stitching (Tailoring)</option>
                        </select>
                    </div>

                    <div class="af-form-group">
                        <label class="af-label" for="modalVendorSelect">Subcontractor / karigar <span class="req">*</span></label>
                        <select name="vendorId" class="af-input af-select" id="modalVendorSelect" required>
                            <option value="">— Select Karigar —</option>
                            @foreach (var v in ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new())
                            {
                                <option value="@v.Id">@v.VendorName</option>
                            }
                        </select>
                    </div>

                    <div class="af-form-group mb-0">
                        <label class="af-label">Expected return date <span class="req">*</span></label>
                        <input name="expectedReturn" type="date" class="af-input" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Send to process</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var currentHwVendor = 0;
            var currentStVendor = 0;
            var currentHwParts = '';

            $('.send-process-btn').click(function() {
                var entityId = $(this).data('id');
                var entityName = $(this).data('name');
                currentHwVendor = $(this).data('hw-vendor') || 0;
                currentStVendor = $(this).data('st-vendor') || 0;
                currentHwParts = $(this).data('hw-parts') || '';
                
                $('#modalEntityId').val(entityId);
                $('#modalEntityName').val(entityName);
                $('#modalProcessSelect').val('');
                $('#modalVendorSelect').val('');
                $('#modalHwNotice').hide();
                
                var modal = new bootstrap.Modal(document.getElementById('sendProcessModal'));
                modal.show();
            });

            $('#modalProcessSelect').change(function() {
                var proc = $(this).val();
                if (proc === 'Handwork') {
                    if (currentHwVendor > 0) {
                        $('#modalVendorSelect').val(currentHwVendor);
                    }
                    if (currentHwParts && currentHwParts !== 'None') {
                        $('#modalHwPartsText').text(currentHwParts);
                        $('#modalHwNotice').show();
                    } else {
                        $('#modalHwNotice').hide();
                    }
                } else if (proc === 'Stitching') {
                    if (currentStVendor > 0) {
                        $('#modalVendorSelect').val(currentStVendor);
                    }
                    $('#modalHwNotice').hide();
                } else {
                    $('#modalHwNotice').hide();
                }
            });
        });
    </script>
}

@functions {
    string GetStatusBadge(string status) => status switch
    {
        "Created" => "b-gray",
        "AtDying" => "b-purple",
        "AtRoll" => "b-cyan",
        "AtHandwork" => "b-yellow",
        "AtStitching" => "b-blue",
        "ReadyToDispatch" => "b-green",
        "Completed" => "b-green",
        "Dispatched" => "b-gray",
        _ => "b-gray"
    };
}
