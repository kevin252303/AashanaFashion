@model AashanaFashion.Controllers.PMSDashboardViewModel
@{
    ViewData["Title"] = "Production Management";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Production Management System</h1>
        <p class="page-sub">Monitor and track production lifecycle</p>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <a asp-action="Index" style="text-decoration:none;color:inherit;">
            <div class="stat-card">
                <div class="stat-icon si-blue">📦</div>
                <div><div class="stat-val">@Model.TotalOrders</div><div class="stat-lbl">Total Orders</div></div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon si-yellow">⚙️</div>
            <div><div class="stat-val">@Model.InProgress</div><div class="stat-lbl">In Progress</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon si-green">✅</div>
            <div><div class="stat-val">@Model.ReadyToDispatch</div><div class="stat-lbl">Ready to Dispatch</div></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon si-gray">🚚</div>
            <div><div class="stat-val">@Model.Dispatched</div><div class="stat-lbl">Dispatched</div></div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-action="ProductionEntities" class="quick-link-card">
            <div class="ql-icon">🔢</div>
            <div class="ql-content">
                <div class="ql-title">Production Entities</div>
                <div class="ql-desc">Track individual items</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="ProcessTracking" class="quick-link-card">
            <div class="ql-icon">📋</div>
            <div class="ql-content">
                <div class="ql-title">Process Tracking</div>
                <div class="ql-desc">Monitor process status</div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="RawMaterial" asp-action="Index" class="quick-link-card">
            <div class="ql-icon">🧵</div>
            <div class="ql-content">
                <div class="ql-title">Raw Material</div>
                <div class="ql-desc">Inventory & requirements</div>
            </div>
        </a>
    </div>
</div>

<!-- Recent Orders -->
<div class="data-card">
    <div class="data-card-header">
        <span class="data-card-title">Production Orders</span>
        <a asp-controller="Production" asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">View All</a>
    </div>
    <table class="af-table">
        <thead>
            <tr>
                <th>Lot No</th>
                <th>Design</th>
                <th>Qty</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders.Take(10))
            {
                <tr>
                    <td><strong>@order.LotNo</strong></td>
                    <td>@order.Design?.DesignNumber</td>
                    <td>@order.TotalQuantity pcs</td>
                    <td><span class="af-badge @GetStatusBadge(order.Status)">@order.Status</span></td>
                    <td>
                        <a asp-action="ProductionEntities" asp-route-orderId="@order.Id" class="btn-af btn-af-ghost btn-af-sm">Entities</a>
                        @if (role == "Admin")
                        {
                            <a asp-action="GenerateEntities" asp-route-orderId="@order.Id" class="btn-af btn-af-primary btn-af-sm">Generate</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string GetStatusBadge(AashanaFashion.Models.OrderStatus status) => status switch
    {
        AashanaFashion.Models.OrderStatus.RawMaterialArrived => "b-gray",
        AashanaFashion.Models.OrderStatus.AtDying => "b-purple",
        AashanaFashion.Models.OrderStatus.AtHandwork => "b-yellow",
        AashanaFashion.Models.OrderStatus.AtStitching => "b-blue",
        AashanaFashion.Models.OrderStatus.ReadyToDispatch => "b-green",
        AashanaFashion.Models.OrderStatus.Dispatched => "b-gray",
        _ => "b-gray"
    };
}
