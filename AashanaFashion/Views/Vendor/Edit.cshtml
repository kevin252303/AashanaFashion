@model AashanaFashion.Models.VendorViewModel
@{
    ViewData["Title"] = "Edit Vendor";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Vendors</a>
        <h1 class="page-title">Edit vendor</h1>
        <p class="page-sub">Update vendor details, commercial terms, and bank accounts</p>
    </div>
</div>

<form asp-action="Edit" method="post" id="vendorForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close" type="button">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Vendor Details</div>
        </div>
        <div>
            <!-- Single Unified Tab -->
            <ul class="nav nav-tabs card-tabs" id="vendorTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="vendor-info-tab" data-bs-toggle="tab" data-bs-target="#vendorInfo" type="button" role="tab">
                        <i class="bi bi-building me-1"></i> Vendor Information
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="vendorInfo" role="tabpanel">

                    <!-- SECTION 1: PRIMARY & CONTACT DETAILS -->
                    <div class="form-section-title">Primary &amp; Contact Details</div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="VendorName" class="af-label">Vendor Name <span class="req">*</span></label>
                                <input asp-for="VendorName" class="af-input" placeholder="e.g. Radhe Krishna Yarns" required />
                                <span asp-validation-for="VendorName" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IsActive" class="af-label">Status</label>
                                <select asp-for="IsActive" class="af-input af-select">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label" for="gstInput">Auto-fill from GSTIN</label>
                                <div class="input-group">
                                    <input type="text" id="gstInput" class="af-input text-uppercase font-monospace" placeholder="Enter 15-character GSTIN" maxlength="15" />
                                    <button type="button" id="fetchGstBtn" class="btn btn-secondary">Fetch</button>
                                </div>
                                <span id="gstError" class="af-error" style="display:none;"></span>
                                <span id="gstSuccess" class="form-text text-success" style="display:none;"></span>
                                <span class="af-hint">Looks up the GST registry and automatically fills legal name, address, and PAN.</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="GstNumber" class="af-label">GST Number</label>
                                <input asp-for="GstNumber" class="af-input text-uppercase font-monospace" id="GstNumber" placeholder="e.g. 24AAAAA0000A1Z5" maxlength="15" />
                                <span asp-validation-for="GstNumber" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PanNumber" class="af-label">PAN Number</label>
                                <input asp-for="PanNumber" class="af-input text-uppercase font-monospace" placeholder="e.g. ABCDE1234F" maxlength="10" />
                                <span asp-validation-for="PanNumber" class="af-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="ContactPerson" class="af-label">Contact Person</label>
                                <input asp-for="ContactPerson" class="af-input" placeholder="e.g. Mukesh Patel" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Phone" class="af-label">Phone Number</label>
                                <input asp-for="Phone" class="af-input" placeholder="e.g. 98250 12345" />
                                <span asp-validation-for="Phone" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Email" class="af-label">Email Address</label>
                                <input asp-for="Email" class="af-input" type="email" placeholder="e.g. sales@radhekrishna.com" />
                                <span asp-validation-for="Email" class="af-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Address" class="af-label">Address</label>
                        <input asp-for="Address" class="af-input" placeholder="Plot / unit number, industrial estate, road, landmark" />
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="City" class="af-label">City</label>
                                <input asp-for="City" class="af-input" placeholder="e.g. Surat" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="State" class="af-label">State</label>
                                <input asp-for="State" class="af-input" placeholder="e.g. Gujarat" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PinCode" class="af-label">Pin Code</label>
                                <input asp-for="PinCode" class="af-input font-monospace" placeholder="e.g. 395002" maxlength="10" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: COMMERCIAL & PAYMENT TERMS -->
                    <div class="form-section-title">Commercial &amp; Payment Terms</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnerLimit" class="af-label">Credit / Outstanding Limit (₹)</label>
                                <input asp-for="PartnerLimit" class="af-input" type="number" step="0.01" min="0" placeholder="e.g. 500000" />
                                <span class="af-hint">Maximum unpaid bill balance allowed with this supplier.</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PurchasePaymentTerms" class="af-label">Payment Terms</label>
                                <input asp-for="PurchasePaymentTerms" class="af-input" placeholder="e.g. Net 30, Immediate, Advance 50%" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PurchasePaymentMethod" class="af-label">Payment Method</label>
                                <input asp-for="PurchasePaymentMethod" class="af-input" placeholder="e.g. Bank Transfer / RTGS, Cheque" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: BANK ACCOUNTS -->
                    <div class="form-section-title">Bank Accounts</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IfscCode" class="af-label">IFSC Code</label>
                                <div class="input-group">
                                    <input asp-for="IfscCode" id="vendorIfscInput" class="af-input text-uppercase font-monospace" placeholder="e.g. SBIN0001234" maxlength="11" />
                                    <button type="button" class="btn btn-secondary btn-sm" id="btnFetchVendorIfsc" title="Fetch bank and branch from IFSC" aria-label="Fetch bank and branch">
                                        <i class="bi bi-search"></i> Fetch
                                    </button>
                                </div>
                                <div id="vendorIfscStatus" class="text-xs mt-1" style="display:none;"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="BankName" class="af-label">Bank Name</label>
                                <input asp-for="BankName" id="vendorBankName" class="af-input" placeholder="Bank name" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="BankBranch" class="af-label">Branch Name</label>
                                <input asp-for="BankBranch" id="vendorBankBranch" class="af-input" placeholder="Branch name" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="AccountNumber" class="af-label">Account Number</label>
                                <input asp-for="AccountNumber" class="af-input font-monospace" placeholder="A/C number" />
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: ADDITIONAL CONTACTS -->
                    <div class="form-section-title">Additional Contacts</div>
                    <div class="grid-card">
                        <table class="af-table table-edit" id="contactTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th style="width:48px;"></th>
                                </tr>
                            </thead>
                            <tbody id="contactBody">
                                @if (Model.Contacts != null && Model.Contacts.Any())
                                {
                                    var idx = 0;
                                    foreach (var c in Model.Contacts)
                                    {
                                        <tr class="contact-row">
                                            <td><input name="Contacts[@idx].ContactName" class="af-input" value="@c.ContactName" placeholder="Contact name" /></td>
                                            <td><input name="Contacts[@idx].ContactPhone" class="af-input" value="@c.ContactPhone" placeholder="Phone" /></td>
                                            <td><input name="Contacts[@idx].ContactEmail" class="af-input" value="@c.ContactEmail" placeholder="Email" /></td>
                                            <td><input name="Contacts[@idx].ContactRole" class="af-input" value="@c.ContactRole" placeholder="Role (e.g. Accounts, Dispatch)" /></td>
                                            <td><button type="button" class="row-action danger remove-contact-row" title="Remove" aria-label="Remove" style="@(idx == 0 && Model.Contacts.Count == 1 ? "display:none;" : "")"><i class="bi bi-trash"></i></button></td>
                                        </tr>
                                        idx++;
                                    }
                                }
                                else
                                {
                                    <tr class="contact-row">
                                        <td><input name="Contacts[0].ContactName" class="af-input" placeholder="Contact name" /></td>
                                        <td><input name="Contacts[0].ContactPhone" class="af-input" placeholder="Phone" /></td>
                                        <td><input name="Contacts[0].ContactEmail" class="af-input" placeholder="Email" /></td>
                                        <td><input name="Contacts[0].ContactRole" class="af-input" placeholder="Role (e.g. Accounts, Dispatch)" /></td>
                                        <td><button type="button" class="row-action danger remove-contact-row" title="Remove" aria-label="Remove" style="display:none;"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addContactRow" class="btn btn-sm btn-secondary mt-3"><i class="bi bi-plus-lg"></i> Add contact</button>

                </div>
            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/vendor.js" asp-append-version="true"></script>
}
