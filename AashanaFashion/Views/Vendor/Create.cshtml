@model AashanaFashion.Models.VendorViewModel
@{
    ViewData["Title"] = "New Vendor";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Back</a>
        <h1 class="page-title">New Vendor</h1>
        <p class="page-sub">Add a new vendor with all details</p>
    </div>
</div>

<form asp-action="Create" method="post" id="vendorForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Vendor Details</div>
        </div>
        <div>

            <!-- Tabs -->
            <ul class="nav nav-tabs card-tabs" id="vendorTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts" type="button" role="tab">Contacts</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="salespurchase-tab" data-bs-toggle="tab" data-bs-target="#salespurchase" type="button" role="tab">Purchase</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="accounting-tab" data-bs-toggle="tab" data-bs-target="#accounting" type="button" role="tab">Accounting</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="partner-tab" data-bs-toggle="tab" data-bs-target="#partner" type="button" role="tab">Partner Assignment</button>
                </li>
            </ul>

            <div class="tab-content">

                <!-- ===== TAB 1: CONTACTS ===== -->
                <div class="tab-pane fade show active" id="contacts" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="VendorName" class="af-label">Vendor Name <span class="req">*</span></label>
                                <input asp-for="VendorName" class="af-input" required />
                                <span asp-validation-for="VendorName" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="GstNumber" class="af-label">GST Number</label>
                                <input asp-for="GstNumber" class="af-input text-uppercase" id="GstNumber" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label" for="gstInput">Auto-fill from GSTIN</label>
                                <div class="input-group">
                                    <input type="text" id="gstInput" class="af-input text-uppercase" placeholder="Enter 15-character GSTIN" maxlength="15" />
                                    <button type="button" id="fetchGstBtn" class="btn btn-secondary">Fetch</button>
                                </div>
                                <span id="gstError" class="af-error" style="display:none;"></span>
                                <span id="gstSuccess" class="form-text text-success" style="display:none;"></span>
                                <span class="af-hint">Looks up the GST registry and fills name, address and PAN.</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="ContactPerson" class="af-label">Contact Person</label>
                                <input asp-for="ContactPerson" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Phone" class="af-label">Phone</label>
                                <input asp-for="Phone" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Email" class="af-label">Email</label>
                                <input asp-for="Email" class="af-input" type="email" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PanNumber" class="af-label">PAN Number</label>
                                <input asp-for="PanNumber" class="af-input text-uppercase" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="VendorCompany" class="af-label">Company</label>
                                <input asp-for="VendorCompany" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Website" class="af-label">Website</label>
                                <input asp-for="Website" class="af-input" placeholder="https://" />
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="Address" class="af-label">Address</label>
                        <input asp-for="Address" class="af-input" />
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="City" class="af-label">City</label>
                                <input asp-for="City" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="State" class="af-label">State</label>
                                <input asp-for="State" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PinCode" class="af-label">Pin Code</label>
                                <input asp-for="PinCode" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label asp-for="Industry" class="af-label">Industry</label>
                                <input asp-for="Industry" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Reference" class="af-label">Reference</label>
                                <input asp-for="Reference" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PartnerId" class="af-label">Partner ID</label>
                                <input asp-for="PartnerId" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Additional Contacts</div>
                    <div class="grid-card">
                        <table class="af-table table-edit" id="contactTable">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th style="width:48px;"></th>
                                </tr>
                            </thead>
                            <tbody id="contactBody">
                                <tr class="contact-row">
                                    <td><input name="Contacts[0].ContactName" class="af-input" placeholder="Contact name" /></td>
                                    <td><input name="Contacts[0].ContactPhone" class="af-input" placeholder="Phone" /></td>
                                    <td><input name="Contacts[0].ContactEmail" class="af-input" placeholder="Email" /></td>
                                    <td><input name="Contacts[0].ContactRole" class="af-input" placeholder="Role" /></td>
                                    <td><button type="button" class="row-action danger remove-contact-row" title="Remove" aria-label="Remove" style="display:none;"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addContactRow" class="btn btn-sm btn-secondary mt-3"><i class="bi bi-plus-lg"></i> Add contact</button>
                </div>

                <!-- ===== TAB 2: PURCHASE ===== -->
                <div class="tab-pane fade" id="salespurchase" role="tabpanel">
                    <div class="form-section-title">Purchase</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Buyer" class="af-label">Buyer</label>
                                <input asp-for="Buyer" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PurchasePaymentTerms" class="af-label">Payment Terms</label>
                                <input asp-for="PurchasePaymentTerms" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PurchasePaymentMethod" class="af-label">Payment Method</label>
                                <input asp-for="PurchasePaymentMethod" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Box1099" class="af-label">1099 Box</label>
                                <input asp-for="Box1099" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="ReceiptReminder" class="af-label">Receipt Reminder</label>
                                <input asp-for="ReceiptReminder" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="FiscalPosition" class="af-label">Fiscal Position</label>
                                <input asp-for="FiscalPosition" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CompanyId" class="af-label">Company ID</label>
                                <input asp-for="CompanyId" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="field-check">
                                <div class="form-check">
                                    <input asp-for="GroupRFQ" class="form-check-input" />
                                    <label asp-for="GroupRFQ" class="form-check-label">Group RFQ</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== TAB 3: ACCOUNTING ===== -->
                <div class="tab-pane fade" id="accounting" role="tabpanel">
                    <div class="form-section-title">Accounting Information</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountPayable" class="af-label">Account Payable</label>
                                <input asp-for="AccountPayable" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PeppolId" class="af-label">Peppol ID</label>
                                <input asp-for="PeppolId" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="InvoiceReport" class="af-label">Invoice Report</label>
                                <input asp-for="InvoiceReport" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="JournalItems" class="af-label">Journal Items</label>
                                <input asp-for="JournalItems" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Send" class="af-label">Send</label>
                                <input asp-for="Send" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AnalyticDistribution" class="af-label">Analytic Distribution</label>
                                <input asp-for="AnalyticDistribution" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="field-check">
                                <div class="form-check">
                                    <input asp-for="AutoPostBills" class="form-check-input" />
                                    <label asp-for="AutoPostBills" class="form-check-label">Auto-post Bills</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Bank Accounts</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="BankName" class="af-label">Bank Name</label>
                                <input asp-for="BankName" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountNumber" class="af-label">Account Number</label>
                                <input asp-for="AccountNumber" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="IfscCode" class="af-label">IFSC Code</label>
                                <input asp-for="IfscCode" class="af-input text-uppercase" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Follow-up</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="FollowUpLevel" class="af-label">Follow-up Level</label>
                                <select asp-for="FollowUpLevel" class="af-input af-select">
                                    <option value="">— Select —</option>
                                    <option value="45 Days">45 Days</option>
                                    <option value="30 Days">30 Days</option>
                                    <option value="15 Days">15 Days</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="FollowUpStatus" class="af-label">Follow-up Status</label>
                                <input asp-for="FollowUpStatus" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Reminders" class="af-label">Reminders</label>
                                <select asp-for="Reminders" class="af-input af-select">
                                    <option value="">— Select —</option>
                                    <option value="Automatic">Automatic</option>
                                    <option value="Manual">Manual</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="NextReminder" class="af-label">Next Reminder</label>
                                <input asp-for="NextReminder" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="AccountingResponsible" class="af-label">Responsible</label>
                                <input asp-for="AccountingResponsible" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Credit Limits</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnerLimit" class="af-label">Partner Limit (₹)</label>
                                <input asp-for="PartnerLimit" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Commission</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM1Name" class="af-label">SM 1 Name</label>
                                <input asp-for="SM1Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM1CommissionPct" class="af-label">SM 1 Commission %</label>
                                <input asp-for="SM1CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM2Name" class="af-label">SM 2 Name</label>
                                <input asp-for="SM2Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM2CommissionPct" class="af-label">SM 2 Commission %</label>
                                <input asp-for="SM2CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM3Name" class="af-label">SM 3 Name</label>
                                <input asp-for="SM3Name" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SM3CommissionPct" class="af-label">SM 3 Commission %</label>
                                <input asp-for="SM3CommissionPct" class="af-input" type="number" step="0.01" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommissionStartDate" class="af-label">Start Date</label>
                                <input asp-for="CommissionStartDate" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommissionEndDate" class="af-label">End Date</label>
                                <input asp-for="CommissionEndDate" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== TAB 4: PARTNER ASSIGNMENT ===== -->
                <div class="tab-pane fade" id="partner" role="tabpanel">
                    <div class="form-section-title">Partner Activation</div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="field-check">
                                <div class="form-check">
                                    <input asp-for="Activation" class="form-check-input" />
                                    <label asp-for="Activation" class="form-check-label">Activation</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="LevelWeight" class="af-label">Level Weight</label>
                                <input asp-for="LevelWeight" class="af-input" type="number" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Partner Review</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="LatestReview" class="af-label">Latest Review</label>
                                <input asp-for="LatestReview" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="NextReview" class="af-label">Next Review</label>
                                <input asp-for="NextReview" class="af-input" type="date" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="PartnershipDate" class="af-label">Partnership Date</label>
                                <input asp-for="PartnershipDate" class="af-input" type="date" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-title">Geolocation</div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="GeoLatitude" class="af-label">Geo Location (Latitude)</label>
                                <input asp-for="GeoLatitude" class="af-input" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="GeoLongitude" class="af-label">Geo Location (Longitude)</label>
                                <input asp-for="GeoLongitude" class="af-input" type="number" step="0.000001" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="field-check">
                                <div class="form-check">
                                    <input asp-for="ComputeBasedOnAddress" class="form-check-input" />
                                    <label asp-for="ComputeBasedOnAddress" class="form-check-label">Compute Based on Address</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="IsActive" class="af-label">Status</label>
                                <select asp-for="IsActive" class="af-input af-select">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Vendor</button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/vendor.js"></script>
}
