@model AashanaFashion.Models.PlatformDashboardViewModel
@{
    ViewData["Title"] = "SaaS Client Operations";
    var search = ViewBag.Search as string;
    var planFilter = ViewBag.PlanFilter as SubscriptionTier?;
    var statusFilter = ViewBag.StatusFilter as TenantStatus?;
    var expiringOnly = (bool)(ViewBag.ExpiringSoonOnly ?? false);
    bool filtered = !string.IsNullOrWhiteSpace(search) || planFilter.HasValue || statusFilter.HasValue || expiringOnly;
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">SaaS Client Operations</h1>
            <span class="af-badge b-orange"><i class="bi bi-shield-shaded"></i> Platform owner</span>
        </div>
        <p class="page-sub">Client companies, recurring revenue (MRR / ARR), licence seats and renewals on Kriyex.</p>
    </div>
    <div class="page-actions">
        <a asp-action="SwitchToDefault" class="btn btn-secondary"><i class="bi bi-house"></i> Reset context</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTenantModal"><i class="bi bi-plus-lg"></i> Onboard client</button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="af-alert af-alert-success mb-3"><div class="alert-body">@TempData["Success"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div class="af-alert af-alert-danger mb-3"><div class="alert-body">@TempData["Error"]</div></div>
}

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Monthly recurring revenue</div>
        <div class="metric-value">₹@Model.TotalMrr.ToString("N0")</div>
        <div class="metric-meta">ARR run rate ₹@Model.TotalArr.ToString("N0")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Active clients</div>
        <div class="metric-value">@Model.ActiveTenants</div>
        <div class="metric-meta">@Model.TotalTenants total · @Model.TrialTenants trial · @Model.SuspendedTenants suspended</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Expiring in 7 days</div>
        <div class="metric-value">@Model.ExpiringSoonCount</div>
        <div class="metric-meta @(Model.ExpiringSoonCount > 0 ? "danger" : "")">needs renewal follow-up</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Desk seats used</div>
        <div class="metric-value">@Model.TotalErpSeatsUsed <span class="metric-suffix">/ @Model.TotalErpSeatsAllocated</span></div>
        <div class="metric-meta">workers @Model.TotalWorkerRecordsUsed / @Model.TotalWorkerRecordsAllocated slots</div>
    </div>
</div>

@if (Model.ExpiringSoonCount > 0)
{
    <div class="af-alert af-alert-danger">
        <div class="alert-body d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <span class="alert-title">Action required</span>
                @Model.ExpiringSoonCount client @(Model.ExpiringSoonCount == 1 ? "tenant has a subscription or trial" : "tenants have subscriptions or trials") expiring within 7 days.
            </div>
            <a asp-action="Index" asp-route-expiringSoonOnly="true" class="btn btn-sm btn-secondary"><i class="bi bi-funnel"></i> Show expiring clients</a>
        </div>
    </div>
}

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Business, subdomain, email, phone…" value="@search" />
            </div>
            <select name="planFilter" class="af-input af-select" aria-label="Plan">
                <option value="">All plans</option>
                <option value="@SubscriptionTier.Starter" selected="@(planFilter == SubscriptionTier.Starter)">Starter</option>
                <option value="@SubscriptionTier.Growth" selected="@(planFilter == SubscriptionTier.Growth)">Growth</option>
                <option value="@SubscriptionTier.Enterprise" selected="@(planFilter == SubscriptionTier.Enterprise)">Enterprise</option>
                <option value="@SubscriptionTier.FreeTrial" selected="@(planFilter == SubscriptionTier.FreeTrial)">Free trial</option>
            </select>
            <select name="statusFilter" class="af-input af-select" aria-label="Status">
                <option value="">All statuses</option>
                <option value="@TenantStatus.Active" selected="@(statusFilter == TenantStatus.Active)">Active</option>
                <option value="@TenantStatus.Suspended" selected="@(statusFilter == TenantStatus.Suspended)">Suspended</option>
                <option value="@TenantStatus.PastDue" selected="@(statusFilter == TenantStatus.PastDue)">Past due</option>
                <option value="@TenantStatus.Cancelled" selected="@(statusFilter == TenantStatus.Cancelled)">Cancelled</option>
            </select>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" name="expiringSoonOnly" value="true" id="expiringCheck" @(expiringOnly ? "checked" : "") />
                <label class="form-check-label" for="expiringCheck">Expiring ≤ 7 days</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (!Model.Tenants.Any())
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-buildings")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No client tenants yet")</div>
            <p>@(filtered ? "No client tenants match your filters." : "Onboard a client organisation to get started.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear filters</a>
            }
            else
            {
                <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#newTenantModal">Onboard client</button>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Subdomain</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Desk seats</th>
                        <th>Floor workers</th>
                        <th>Activity</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Tenants)
                    {
                        var t = item.Tenant;
                        var seatPct = t.AllowedErpSeats > 0 ? (item.ActiveErpUsers * 100 / t.AllowedErpSeats) : 0;
                        var empPct = t.AllowedEmployeeRecords > 0 ? (item.ActiveEmployees * 100 / t.AllowedEmployeeRecords) : 0;
                        bool active = t.Status == TenantStatus.Active;

                        <tr class="@(item.IsExpiringSoon ? "row-warning" : (t.Status == TenantStatus.Suspended ? "row-muted" : ""))">
                            <td>
                                <span class="cell-title">@t.BusinessName</span>
                                <span class="cell-sub">@(t.AdminEmail ?? "—")@(string.IsNullOrEmpty(t.Phone) ? "" : " · " + t.Phone)</span>
                            </td>
                            <td class="text-nowrap">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="mono-id">@t.Subdomain</span>
                                    <a href="https://@(t.Subdomain).kriyex.com" target="_blank" rel="noopener" class="row-action d-inline-flex" title="Open https://@(t.Subdomain).kriyex.com" aria-label="Open @t.BusinessName workspace"><i class="bi bi-box-arrow-up-right"></i></a>
                                </div>
                                <span class="cell-sub font-monospace" style="font-size:0.72rem;">@(t.Subdomain).kriyex.com</span>
                            </td>
                            <td>
                                <span class="af-badge @PlanBadge(t.PlanType)">@t.PlanType.Humanize()</span>
                                <span class="cell-sub tabular">₹@item.MonthlyRevenue.ToString("N0")/mo</span>
                            </td>
                            <td><span class="af-badge @StatusBadge(t.Status)">@t.Status.Humanize()</span></td>
                            <td style="min-width: 110px;">
                                <span class="text-xs text-foreground tabular">@item.ActiveErpUsers / @t.AllowedErpSeats</span>
                                <div class="af-progress mt-1" style="max-width: 90px;"><div class="af-progress-bar @(seatPct >= 90 ? "bg-danger" : "")" style="width: @seatPct%;"></div></div>
                            </td>
                            <td style="min-width: 110px;">
                                <span class="text-xs text-foreground tabular">@item.ActiveEmployees / @t.AllowedEmployeeRecords</span>
                                <div class="af-progress mt-1" style="max-width: 90px;"><div class="af-progress-bar @(empPct >= 90 ? "bg-danger" : "bg-success")" style="width: @empPct%;"></div></div>
                            </td>
                            <td class="text-xs text-muted text-nowrap">@item.TotalOrdersCount lots<br />@item.TotalInvoicesCount invoices</td>
                            <td class="text-nowrap">
                                <span class="@(item.IsExpiringSoon ? "text-danger fw-semibold" : item.IsExpired ? "text-muted" : "text-foreground")">@(item.DaysLeft > 0 ? $"{item.DaysLeft} days left" : "Expired")</span>
                                <span class="cell-sub">@((t.SubscriptionEndsAt ?? t.TrialEndsAt).ToString("dd MMM yyyy"))</span>
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <form asp-action="QuickExtend" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenantId" value="@t.Id" />
                                        <input type="hidden" name="days" value="30" />
                                        <button type="submit" class="btn btn-sm btn-secondary me-1" title="Extend by 30 days">+30 d</button>
                                    </form>
                                    <a asp-action="SwitchToTenant" asp-route-tenantId="@t.Id" class="row-action" title="View client workspace" aria-label="View @t.BusinessName workspace"><i class="bi bi-eye"></i></a>
                                    <button type="button" class="row-action" data-bs-toggle="modal" data-bs-target="#editTenantModal_@t.Id" title="Edit plan &amp; quotas" aria-label="Edit plan and quotas for @t.BusinessName"><i class="bi bi-sliders"></i></button>
                                    <form asp-action="ToggleSuspend" method="post" onsubmit="return confirm('@(active ? "Suspend" : "Reactivate") this client?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenantId" value="@t.Id" />
                                        <button type="submit" class="row-action @(active ? "danger" : "success")" title="@(active ? "Suspend access" : "Reactivate access")" aria-label="@(active ? "Suspend" : "Reactivate") @t.BusinessName"><i class="bi @(active ? "bi-slash-circle" : "bi-check-circle")"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Tenants.Count</strong> @(Model.Tenants.Count == 1 ? "client" : "clients") · total MRR ₹@Model.TotalMrr.ToString("N0")</span>
        </div>
    }
</div>

@foreach (var item in Model.Tenants)
{
    var t = item.Tenant;
    <div class="modal fade" id="editTenantModal_@t.Id" tabindex="-1" aria-labelledby="editTenantTitle_@t.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="UpdateTenant" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tenantId" value="@t.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editTenantTitle_@t.Id">Manage @t.BusinessName</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="plan_@t.Id">Plan</label>
                            <select id="plan_@t.Id" name="plan" class="af-input af-select">
                                <option value="@SubscriptionTier.Starter" selected="@(t.PlanType == SubscriptionTier.Starter)">Starter (₹2,499/mo)</option>
                                <option value="@SubscriptionTier.Growth" selected="@(t.PlanType == SubscriptionTier.Growth)">Growth (₹6,999/mo)</option>
                                <option value="@SubscriptionTier.Enterprise" selected="@(t.PlanType == SubscriptionTier.Enterprise)">Enterprise (₹18,999/mo)</option>
                                <option value="@SubscriptionTier.FreeTrial" selected="@(t.PlanType == SubscriptionTier.FreeTrial)">Free trial</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="status_@t.Id">Account status</label>
                            <select id="status_@t.Id" name="status" class="af-input af-select">
                                <option value="@TenantStatus.Active" selected="@(t.Status == TenantStatus.Active)">Active</option>
                                <option value="@TenantStatus.Suspended" selected="@(t.Status == TenantStatus.Suspended)">Suspended</option>
                                <option value="@TenantStatus.PastDue" selected="@(t.Status == TenantStatus.PastDue)">Past due</option>
                                <option value="@TenantStatus.Cancelled" selected="@(t.Status == TenantStatus.Cancelled)">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="seats_@t.Id">Desk seats <span class="req">*</span></label>
                            <input type="number" id="seats_@t.Id" name="allowedErpSeats" class="af-input" value="@t.AllowedErpSeats" min="1" max="1000" required />
                            <div class="form-text">Web portal logins.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="workers_@t.Id">Floor workers <span class="req">*</span></label>
                            <input type="number" id="workers_@t.Id" name="allowedEmployeeRecords" class="af-input" value="@t.AllowedEmployeeRecords" min="0" max="10000" step="10" required />
                            <div class="form-text">Face / biometric staff.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ends_@t.Id">Subscription expiry</label>
                            <input type="date" id="ends_@t.Id" name="subscriptionEndsAt" class="af-input" value="@((t.SubscriptionEndsAt ?? t.TrialEndsAt).ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="modal fade" id="newTenantModal" tabindex="-1" aria-labelledby="newTenantTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-action="CreateTenant" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="newTenantTitle">Onboard client organisation on Kriyex</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="ntName">Company / brand name <span class="req">*</span></label>
                        <input type="text" id="ntName" name="businessName" class="af-input" placeholder="e.g. Surat Tex Fab" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ntSub">Subdomain <span class="req">*</span></label>
                        <div class="input-group">
                            <input type="text" id="ntSub" name="subdomain" class="af-input font-monospace" placeholder="surattex" required />
                            <span class="input-group-text">.kriyex.com</span>
                        </div>
                        <div class="form-text" id="ntPreview">Workspace URL: https://[subdomain].kriyex.com</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntPlan">Plan</label>
                        <select id="ntPlan" name="planType" class="af-input af-select">
                            <option value="@SubscriptionTier.Growth" selected>Growth (₹6,999/mo)</option>
                            <option value="@SubscriptionTier.Starter">Starter (₹2,499/mo)</option>
                            <option value="@SubscriptionTier.Enterprise">Enterprise (₹18,999/mo)</option>
                            <option value="@SubscriptionTier.FreeTrial">14-day free trial</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntSeats">Desk seats <span class="req">*</span></label>
                        <input type="number" id="ntSeats" name="allowedErpSeats" class="af-input" value="15" min="1" max="500" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntWorkers">Floor workers <span class="req">*</span></label>
                        <input type="number" id="ntWorkers" name="allowedEmployeeRecords" class="af-input" value="100" min="0" max="5000" step="25" required />
                    </div>
                </div>

                <div class="section-label mt-4 mb-3">Primary admin account</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="ntAdminName">Full name <span class="req">*</span></label>
                        <input type="text" id="ntAdminName" name="adminFullName" class="af-input" placeholder="e.g. Deepak Patel" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="ntAdminEmail">Email <span class="req">*</span></label>
                        <input type="email" id="ntAdminEmail" name="adminEmail" class="af-input" placeholder="deepak@texfab.com" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntPhone">Phone</label>
                        <input type="text" id="ntPhone" name="phone" class="af-input" placeholder="+91 98765 00000" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntUser">Username <span class="req">*</span></label>
                        <input type="text" id="ntUser" name="adminUsername" class="af-input" placeholder="admin" autocomplete="off" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="ntPass">Initial password <span class="req">*</span></label>
                        <input type="password" id="ntPass" name="adminPassword" class="af-input" autocomplete="new-password" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-rocket-takeoff"></i> Provision tenant</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const biz = document.getElementById('ntName');
            const sub = document.getElementById('ntSub');
            const preview = document.getElementById('ntPreview');

            if (biz && sub && preview) {
                biz.addEventListener('input', function () {
                    if (!sub.dataset.manual) {
                        const slug = biz.value.toLowerCase()
                            .replace(/[^a-z0-9]/g, '-')
                            .replace(/-+/g, '-')
                            .replace(/^-|-$/g, '');
                        sub.value = slug;
                        preview.textContent = 'Workspace URL: https://' + (slug || '[subdomain]') + '.kriyex.com';
                    }
                });

                sub.addEventListener('input', function () {
                    sub.dataset.manual = 'true';
                    let val = sub.value.trim().toLowerCase()
                        .replace('https://', '')
                        .replace('http://', '')
                        .replace('.kriyex.com', '')
                        .replace('.aashanafashion.com', '');
                    preview.textContent = 'Workspace URL: https://' + (val || '[subdomain]') + '.kriyex.com';
                });
            }
        });
    </script>
}

@functions {
    string PlanBadge(SubscriptionTier p) => p switch
    {
        SubscriptionTier.Enterprise => "b-purple",
        SubscriptionTier.Growth => "b-indigo",
        SubscriptionTier.Starter => "b-blue",
        _ => "b-gray"
    };
    string StatusBadge(TenantStatus s) => s switch
    {
        TenantStatus.Active => "b-green",
        TenantStatus.Suspended => "b-red",
        TenantStatus.PastDue => "b-yellow",
        _ => "b-gray"
    };
}
