@{
    ViewData["Title"] = "Module not enabled";
    var moduleName = ViewBag.ModuleName as string ?? "Requested module";
    var moduleDesc = ViewBag.ModuleDescription as string ?? "";
    var moduleIcon = ViewBag.ModuleIcon as string ?? "bi-lock";
    var tenantName = ViewBag.TenantName as string ?? "Your organization";
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">Module not enabled</h1>
            <span class="af-badge b-orange"><i class="bi bi-shield-lock"></i> Access restricted</span>
        </div>
        <p class="page-sub">The feature you are trying to access is not included in the active subscription for @tenantName.</p>
    </div>
</div>

<div class="data-card max-w-xl mx-auto my-4">
    <div class="data-card-body p-4 text-center">
        <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle bg-light border p-3" style="width: 64px; height: 64px;">
            <i class="bi @moduleIcon text-primary" style="font-size: 28px;"></i>
        </div>

        <h3 class="h5 fw-semibold text-foreground mb-2">@moduleName</h3>
        <p class="text-muted text-sm mb-4">@moduleDesc</p>

        <div class="af-alert af-alert-info text-start mb-4">
            <div class="alert-body">
                <span class="alert-title">Need access to this module?</span>
                <p class="mb-0 text-xs">
                    Module-wise access is managed centrally by your platform developer or account administrator. Please contact your account representative to enable @moduleName for @tenantName.
                </p>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Production" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house"></i> Go to workspace dashboard
            </a>
            <a href="mailto:support@kriyex.com?subject=Enable%20Module%20Request%20-%20@Uri.EscapeDataString(tenantName)&body=Hello%20Team%2C%0A%0AWe%20would%20like%20to%20activate%20the%20@Uri.EscapeDataString(moduleName)%20module%20for%20our%20account%20(@Uri.EscapeDataString(tenantName))." class="btn btn-secondary">
                <i class="bi bi-envelope"></i> Request activation
            </a>
        </div>
    </div>
</div>
