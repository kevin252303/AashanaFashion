@model AashanaFashion.Models.RegisterTenantViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Start Free Trial — Kriyex Cloud ERP";
}

<section class="auth-brand">
    <div class="d-flex align-items-center gap-2">
        <div class="brand-mark">KX</div>
        <span class="fw-bold fs-4 text-dark">Kriyex</span>
    </div>

    <div class="auth-pitch">
        <div class="auth-eyebrow">14-day free trial · no credit card</div>
        <h1 class="auth-headline">Put your garment business on Kriyex Cloud.</h1>
        <p class="auth-lede">Production, payroll and GST accounting for textile brands, garment factories and job workers.</p>
        <ul class="auth-features">
            <li><i class="bi bi-diagram-3"></i> Production lots, job slips &amp; QC</li>
            <li><i class="bi bi-receipt"></i> GST invoicing, e-invoice &amp; returns</li>
            <li><i class="bi bi-journal-text"></i> Double-entry ledger &amp; statements</li>
            <li><i class="bi bi-person-badge"></i> Face kiosk attendance &amp; payroll</li>
        </ul>
    </div>

    <div class="auth-legal">© @DateTime.Now.Year Kriyex · Production Management System</div>
</section>

<main class="auth-main">
    <div class="auth-card auth-card-wide">
        <div class="auth-card-mark brand-mark">KX</div>
        <h2 class="auth-title">Start your free trial</h2>
        <p class="auth-sub">Full access for 14 days on .kriyex.com. Pick a plan now — you won’t be charged during the trial.</p>

        <form asp-controller="Subscription" asp-action="RegisterTenant" method="post" id="registerForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="af-alert af-alert-danger"></div>

            <div class="section-label mb-3">Business</div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="BusinessName" class="form-label"></label>
                    <input asp-for="BusinessName" class="af-input" id="bizNameInput" placeholder="e.g. Surat Textile Mills" required />
                    <span asp-validation-for="BusinessName" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Subdomain" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Subdomain" class="af-input font-monospace" placeholder="surattextile" required id="subdomainInput" />
                        <span class="input-group-text">.kriyex.com</span>
                    </div>
                    <span asp-validation-for="Subdomain" class="af-error"></span>
                    <div class="form-text" id="subdomainPreview">Your workspace URL: https://[subdomain].kriyex.com</div>
                </div>
            </div>

            <div class="section-label mb-3">Administrator account</div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="AdminFullName" class="form-label"></label>
                    <input asp-for="AdminFullName" class="af-input" placeholder="e.g. Rajesh Shah" required />
                    <span asp-validation-for="AdminFullName" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AdminEmail" class="form-label"></label>
                    <input asp-for="AdminEmail" type="email" class="af-input" placeholder="rajesh@surattextile.com" required />
                    <span asp-validation-for="AdminEmail" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="af-input" placeholder="+91 98765 43210" />
                    <span asp-validation-for="Phone" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="af-input" placeholder="admin" required />
                    <span asp-validation-for="Username" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="af-input" placeholder="At least 6 characters" required />
                    <span asp-validation-for="Password" class="af-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="af-input" placeholder="Repeat your password" required />
                    <span asp-validation-for="ConfirmPassword" class="af-error"></span>
                </div>
            </div>

            <div class="section-label mb-3">Plan</div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="plan-card compact" for="planOptStarter">
                        <div class="plan-head"><span class="plan-name">Starter</span></div>
                        <div class="plan-price">₹2,499<small>/mo</small></div>
                        <p class="plan-desc">5 desk seats · 25 workers</p>
                        <span class="plan-select"><input type="radio" class="form-check-input" id="planOptStarter" name="PlanType" value="@SubscriptionTier.Starter" /> Select</span>
                    </label>
                </div>
                <div class="col-md-4">
                    <label class="plan-card compact" for="planOptGrowth">
                        <div class="plan-head"><span class="plan-name">Growth</span><span class="af-badge b-indigo">Recommended</span></div>
                        <div class="plan-price">₹6,999<small>/mo</small></div>
                        <p class="plan-desc">15 desk seats · 100 workers</p>
                        <span class="plan-select"><input type="radio" class="form-check-input" id="planOptGrowth" name="PlanType" value="@SubscriptionTier.Growth" checked /> Select</span>
                    </label>
                </div>
                <div class="col-md-4">
                    <label class="plan-card compact" for="planOptEnterprise">
                        <div class="plan-head"><span class="plan-name">Enterprise</span></div>
                        <div class="plan-price">₹18,999<small>/mo</small></div>
                        <p class="plan-desc">50 desk seats · 500 workers</p>
                        <span class="plan-select"><input type="radio" class="form-check-input" id="planOptEnterprise" name="PlanType" value="@SubscriptionTier.Enterprise" /> Select</span>
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-rocket-takeoff"></i> Start 14-day free trial</button>
        </form>

        <div class="auth-trial">Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-semibold">Sign in</a></div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const bizInput = document.getElementById('bizNameInput');
            const subInput = document.getElementById('subdomainInput');
            const preview = document.getElementById('subdomainPreview');

            bizInput.addEventListener('input', function () {
                if (!subInput.dataset.manual) {
                    const slug = bizInput.value.toLowerCase()
                        .replace(/[^a-z0-9]/g, '-')
                        .replace(/-+/g, '-')
                        .replace(/^-|-$/g, '');
                    subInput.value = slug;
                    updatePreview();
                }
            });

            subInput.addEventListener('input', function () {
                subInput.dataset.manual = 'true';
                updatePreview();
            });

            function updatePreview() {
                let val = (subInput.value || '[subdomain]').trim().toLowerCase()
                    .replace('https://', '')
                    .replace('http://', '')
                    .replace('.kriyex.com', '');
                preview.textContent = 'Your workspace URL: https://' + val + '.kriyex.com';
            }
        });
    </script>
}
