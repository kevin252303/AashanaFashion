@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Subscription Suspended";
}

<main class="auth-main auth-solo">
    <div class="auth-card">
        <div class="empty-state p-0 mb-4">
            <div class="es-icon"><i class="bi bi-pause-circle"></i></div>
            <div class="es-title">Subscription suspended</div>
            <p>Your organisation’s subscription has expired or is suspended, so desk access is temporarily restricted.</p>
        </div>

        <div class="af-alert af-alert-info">
            <div class="alert-body">
                <span class="alert-title">What happens next</span>
                <ul class="mb-0 ps-3">
                    <li>Production data, ledgers and attendance records stay secure.</li>
                    <li>Floor workers can keep using the face attendance kiosks.</li>
                    <li>Renew or reactivate your subscription to restore desk access.</li>
                </ul>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a href="mailto:billing@aashanafashion.com?subject=Reactivate%20Subscription" class="btn btn-primary btn-lg"><i class="bi bi-envelope"></i> Contact billing &amp; support</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary"><i class="bi bi-box-arrow-right"></i> Sign out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-secondary"><i class="bi bi-box-arrow-in-right"></i> Back to sign in</a>
            }
        </div>
    </div>
</main>
