@model AashanaFashion.Models.SubscriptionDashboardViewModel

@{
    ViewData["Title"] = "SaaS Subscription & License Portal";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1">
                <i class="bi bi-cloud-check text-primary me-2"></i>SaaS Subscription & Quota Manager
            </h2>
            <p class="text-muted mb-0">
                Organization: <strong class="text-dark">@Model.Tenant.BusinessName</strong> 
                &bull; Subdomain: <span class="badge bg-light text-primary border">@Model.Tenant.Subdomain</span>
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span class="badge @(Model.Tenant.Status == TenantStatus.Active ? "bg-success" : "bg-danger") px-3 py-2 fs-6">
                <i class="bi bi-check-circle-fill me-1"></i> @Model.Tenant.Status
            </span>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#changePlanModal">
                <i class="bi bi-arrow-up-circle me-1"></i> Change Plan
            </button>
            <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#addSeatsModal">
                <i class="bi bi-person-plus-fill me-1"></i> Add Seats / Workers
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Overview Banner -->
    <div class="card shadow-sm border-0 mb-4 bg-gradient bg-light">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-3 border-end">
                    <span class="text-muted small text-uppercase fw-semibold">Current Plan Tier</span>
                    <h3 class="fw-bold text-primary mt-1 mb-0">@Model.Tenant.PlanType</h3>
                    <small class="text-muted">Multi-Tenant Cloud Edition</small>
                </div>
                <div class="col-md-3 border-end">
                    <span class="text-muted small text-uppercase fw-semibold">Status / Renewal</span>
                    <h4 class="fw-bold mt-1 mb-0 @(Model.DaysRemaining <= 5 ? "text-danger" : "text-dark")">
                        @Model.DaysRemaining Days Remaining
                    </h4>
                    <small class="text-muted">
                        @(Model.IsTrial ? "14-Day Free Trial" : "Active Subscription")
                    </small>
                </div>
                <div class="col-md-3 border-end">
                    <span class="text-muted small text-uppercase fw-semibold">Estimated Monthly Fee</span>
                    <h4 class="fw-bold text-success mt-1 mb-0">₹@Model.MonthlyBillingEstimate.ToString("N0")</h4>
                    <small class="text-muted">Base Plan + Add-on Quotas</small>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase fw-semibold">Tenant Identification</span>
                    <p class="mb-0 fw-semibold text-dark mt-1">
                        <i class="bi bi-globe me-1"></i> @(Model.Tenant.Subdomain).kriyex.com
                    </p>
                    <small class="text-muted">Tenant ID #@Model.Tenant.Id</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Dual Quota Visualizer Cards -->
    <div class="row g-4 mb-4">
        <!-- Quota 1: ERP Desk User Seats -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-laptop me-2"></i>ERP Desk User Seats
                        </h5>
                        <span class="badge @(Model.ErpSeatPercentage >= 90 ? "bg-danger" : (Model.ErpSeatPercentage >= 75 ? "bg-warning text-dark" : "bg-primary")) fs-6 px-3">
                            @Model.UsedErpSeats / @Model.TotalErpSeats Seats
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Desk users with dedicated web logins who manage Production Orders, Invoicing, Billing, Designs, Inventory, and General Ledger Accounting.
                    </p>

                    <!-- Progress Bar -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Seat Consumption</span>
                            <span>@Model.ErpSeatPercentage% Used</span>
                        </div>
                        <div class="progress" style="height: 14px;">
                            <div class="progress-bar @(Model.ErpSeatPercentage >= 90 ? "bg-danger" : (Model.ErpSeatPercentage >= 75 ? "bg-warning" : "bg-primary"))"
                                 role="progressbar" style="width: @Model.ErpSeatPercentage%;" 
                                 aria-valuenow="@Model.UsedErpSeats" aria-valuemin="0" aria-valuemax="@Model.TotalErpSeats">
                            </div>
                        </div>
                    </div>

                    <div class="row text-center g-2 pt-2 border-top">
                        <div class="col-4 border-end">
                            <span class="text-muted small">Licensed Seats</span>
                            <h4 class="fw-bold mb-0">@Model.TotalErpSeats</h4>
                        </div>
                        <div class="col-4 border-end">
                            <span class="text-muted small">Active Users</span>
                            <h4 class="fw-bold mb-0 text-primary">@Model.UsedErpSeats</h4>
                        </div>
                        <div class="col-4">
                            <span class="text-muted small">Seats Available</span>
                            <h4 class="fw-bold mb-0 text-success">@(Model.TotalErpSeats - Model.UsedErpSeats)</h4>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Additional seat: ₹399/seat/mo</span>
                    <a asp-controller="UserManagement" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-people me-1"></i> Manage ERP Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Quota 2: Floor Worker Records (HRMS / Payroll Only) -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0 border-top border-success border-4">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-success">
                            <i class="bi bi-person-badge me-2"></i>Floor Worker Records (HRMS)
                        </h5>
                        <span class="badge @(Model.EmployeePercentage >= 90 ? "bg-danger" : (Model.EmployeePercentage >= 75 ? "bg-warning text-dark" : "bg-success")) fs-6 px-3">
                            @Model.UsedEmployeeRecords / @Model.TotalEmployeeRecords Workers
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Factory tailors, cutters, and operators. <strong>No ERP portal access.</strong> Restricted to Face Scan Kiosk and Biometric punch in/out. Attendance & payroll maintained in HRMS.
                    </p>

                    <!-- Progress Bar -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Worker Capacity Consumption</span>
                            <span>@Model.EmployeePercentage% Used</span>
                        </div>
                        <div class="progress" style="height: 14px;">
                            <div class="progress-bar @(Model.EmployeePercentage >= 90 ? "bg-danger" : (Model.EmployeePercentage >= 75 ? "bg-warning" : "bg-success"))"
                                 role="progressbar" style="width: @Model.EmployeePercentage%;" 
                                 aria-valuenow="@Model.UsedEmployeeRecords" aria-valuemin="0" aria-valuemax="@Model.TotalEmployeeRecords">
                            </div>
                        </div>
                    </div>

                    <div class="row text-center g-2 pt-2 border-top">
                        <div class="col-4 border-end">
                            <span class="text-muted small">Max Worker Limit</span>
                            <h4 class="fw-bold mb-0">@Model.TotalEmployeeRecords</h4>
                        </div>
                        <div class="col-4 border-end">
                            <span class="text-muted small">Registered Staff</span>
                            <h4 class="fw-bold mb-0 text-success">@Model.UsedEmployeeRecords</h4>
                        </div>
                        <div class="col-4">
                            <span class="text-muted small">Capacity Left</span>
                            <h4 class="fw-bold mb-0 text-info">@(Model.TotalEmployeeRecords - Model.UsedEmployeeRecords)</h4>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                    <span class="small text-muted">Worker add-on pack: ₹499/25 workers/mo</span>
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-person-lines-fill me-1"></i> Manage Workers
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Multi-Tenant Architecture & Isolation Guarantee -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-shield-lock-fill text-warning me-2"></i>Multi-Tenant Data Isolation & Security Details
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="bg-primary-subtle text-primary p-2 rounded me-3">
                            <i class="bi bi-database-fill-lock fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">EF Core Global Query Filters</h6>
                            <p class="text-muted small mb-0">
                                Every SQL query automatically injects <code>WHERE TenantId = @Model.Tenant.Id</code>. No data leakage is possible across tenants.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="bg-success-subtle text-success p-2 rounded me-3">
                            <i class="bi bi-cpu-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Floor Worker Isolation</h6>
                            <p class="text-muted small mb-0">
                                Factory floor workers have no login credentials. They authenticate exclusively via AI Face Recognition or Biometric API at physical tablets.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start">
                        <div class="bg-info-subtle text-info p-2 rounded me-3">
                            <i class="bi bi-hdd-network-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Hybrid Dedicated DB Path</h6>
                            <p class="text-muted small mb-0">
                                Enterprise customers can optionally specify a dedicated SQL database connection string while retaining shared app services.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Add Seats / Workers -->
<div class="modal fade" id="addSeatsModal" tabindex="-1" aria-labelledby="addSeatsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Subscription" asp-action="AddSeats" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addSeatsModalLabel">
                        <i class="bi bi-person-plus-fill text-success me-2"></i>Add License Capacity
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Add ERP Desk User Seats</label>
                        <div class="input-group">
                            <input type="number" name="additionalErpSeats" class="form-control" value="5" min="0" max="500" required />
                            <span class="input-group-text">seats (₹399/seat/mo)</span>
                        </div>
                        <small class="text-muted">Desk users who can login to ERP web portal.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Add Floor Worker Payroll Records</label>
                        <div class="input-group">
                            <input type="number" name="additionalWorkers" class="form-control" value="25" min="0" max="2000" step="25" required />
                            <span class="input-group-text">workers (₹499/25 pack)</span>
                        </div>
                        <small class="text-muted">Tailors/cutters for Face Kiosk and HRMS payroll records.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg me-1"></i> Confirm & Update Quota
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Change Plan Tier -->
<div class="modal fade" id="changePlanModal" tabindex="-1" aria-labelledby="changePlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Subscription" asp-action="ChangePlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="changePlanModalLabel">
                        <i class="bi bi-arrow-up-circle text-primary me-2"></i>Select Subscription Plan
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Starter -->
                        <div class="col-md-4">
                            <div class="card h-100 border @(Model.Tenant.PlanType == SubscriptionTier.Starter ? "border-primary bg-primary-subtle" : "")">
                                <div class="card-body">
                                    <h5 class="fw-bold">Starter</h5>
                                    <h4 class="text-primary fw-bold">₹2,499<small class="fs-6 text-muted">/mo</small></h4>
                                    <p class="small text-muted">Small garment shop or job worker unit.</p>
                                    <ul class="list-unstyled small mb-3">
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 5 ERP Desk Users</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 25 Floor Workers</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Production & Job Slips</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Face Scan Kiosk</li>
                                    </ul>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="newPlan" id="planStarter" value="@SubscriptionTier.Starter" @(Model.Tenant.PlanType == SubscriptionTier.Starter ? "checked" : "")>
                                        <label class="form-check-label fw-bold" for="planStarter">Select Starter</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Growth -->
                        <div class="col-md-4">
                            <div class="card h-100 border @(Model.Tenant.PlanType == SubscriptionTier.Growth ? "border-primary bg-primary-subtle" : "")">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="fw-bold">Growth</h5>
                                        <span class="badge bg-warning text-dark">Popular</span>
                                    </div>
                                    <h4 class="text-primary fw-bold">₹6,999<small class="fs-6 text-muted">/mo</small></h4>
                                    <p class="small text-muted">Garment brand & manufacturing factory.</p>
                                    <ul class="list-unstyled small mb-3">
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 15 ERP Desk Users</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 100 Floor Workers</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> GST Filing Hub & Invoicing</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Double-Entry General Ledger</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 3-Way Match & Aging</li>
                                    </ul>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="newPlan" id="planGrowth" value="@SubscriptionTier.Growth" @(Model.Tenant.PlanType == SubscriptionTier.Growth ? "checked" : "")>
                                        <label class="form-check-label fw-bold" for="planGrowth">Select Growth</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Enterprise -->
                        <div class="col-md-4">
                            <div class="card h-100 border @(Model.Tenant.PlanType == SubscriptionTier.Enterprise ? "border-primary bg-primary-subtle" : "")">
                                <div class="card-body">
                                    <h5 class="fw-bold">Enterprise</h5>
                                    <h4 class="text-primary fw-bold">₹18,999<small class="fs-6 text-muted">/mo</small></h4>
                                    <p class="small text-muted">Textile mill & multi-factory conglomerate.</p>
                                    <ul class="list-unstyled small mb-3">
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 50 ERP Desk Users</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> 500 Floor Workers</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Dedicated DB Support</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Biometric Machine Terminal API</li>
                                        <li><i class="bi bi-check-lg text-success me-1"></i> Priority 24x7 SLA Support</li>
                                    </ul>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="newPlan" id="planEnterprise" value="@SubscriptionTier.Enterprise" @(Model.Tenant.PlanType == SubscriptionTier.Enterprise ? "checked" : "")>
                                        <label class="form-check-label fw-bold" for="planEnterprise">Select Enterprise</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Upgrade / Switch Plan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
