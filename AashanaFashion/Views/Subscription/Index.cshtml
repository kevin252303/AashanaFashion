@model AashanaFashion.Models.SubscriptionDashboardViewModel
@{
    ViewData["Title"] = "Subscription & Quotas";
    bool active = Model.Tenant.Status == TenantStatus.Active;
}

<div class="page-header">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="page-title">Subscription &amp; Quotas</h1>
            <span class="af-badge @(active ? "b-green" : "b-red")">@Model.Tenant.Status.Humanize()</span>
        </div>
        <p class="page-sub">@Model.Tenant.BusinessName · <span class="font-monospace">@(Model.Tenant.Subdomain).aashanafashion.com</span></p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#addSeatsModal"><i class="bi bi-person-plus"></i> Add seats / workers</button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#changePlanModal"><i class="bi bi-arrow-up-circle"></i> Change plan</button>
    </div>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-label">Current plan</div>
        <div class="metric-value">@Model.Tenant.PlanType.Humanize()</div>
        <div class="metric-meta">multi-tenant cloud edition</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Days remaining</div>
        <div class="metric-value @(Model.DaysRemaining <= 5 ? "text-danger" : "")">@Model.DaysRemaining</div>
        <div class="metric-meta @(Model.DaysRemaining <= 5 ? "danger" : "")">@(Model.IsTrial ? "14-day free trial" : "active subscription")</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Estimated monthly fee</div>
        <div class="metric-value">₹@Model.MonthlyBillingEstimate.ToString("N0")</div>
        <div class="metric-meta">base plan + add-on quotas</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Tenant ID</div>
        <div class="metric-value">#@Model.Tenant.Id</div>
        <div class="metric-meta font-monospace">@Model.Tenant.Subdomain</div>
    </div>
</div>

<div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="data-card h-100">
                <div class="data-card-header">
                    <div class="data-card-title d-flex align-items-center gap-2"><i class="bi bi-laptop text-muted"></i> ERP desk user seats</div>
                    <span class="af-badge @(Model.ErpSeatPercentage >= 90 ? "b-red" : Model.ErpSeatPercentage >= 75 ? "b-yellow" : "b-gray")">@Model.UsedErpSeats / @Model.TotalErpSeats</span>
                </div>
                <div class="data-card-body">
                    <p class="text-sm text-muted">Desk users with web logins who manage production, invoicing, designs, inventory and accounting.</p>
                    <div class="progress-row">
                        <span class="pr-label">Consumption</span>
                        <div class="af-progress"><div class="af-progress-bar @(Model.ErpSeatPercentage >= 90 ? "bg-danger" : Model.ErpSeatPercentage >= 75 ? "bg-warning" : "")" role="progressbar" style="width: @Model.ErpSeatPercentage%;" aria-valuenow="@Model.UsedErpSeats" aria-valuemin="0" aria-valuemax="@Model.TotalErpSeats" aria-label="ERP desk user seats used"></div></div>
                        <span class="pr-value">@Model.ErpSeatPercentage% used</span>
                    </div>
                    <div class="usage-figures">
                        <div><div class="info-label">Licensed seats</div><div class="info-value">@Model.TotalErpSeats</div></div>
                        <div><div class="info-label">Active users</div><div class="info-value">@Model.UsedErpSeats</div></div>
                        <div><div class="info-label">Available</div><div class="info-value text-success">@(Model.TotalErpSeats - Model.UsedErpSeats)</div></div>
                    </div>
                    <div class="form-actions justify-content-between">
                        <span class="text-xs text-muted">Additional seat ₹399/seat/mo</span>
                        <a asp-controller="UserManagement" asp-action="Index" class="btn btn-sm btn-secondary"><i class="bi bi-people"></i> Manage users</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="data-card h-100">
                <div class="data-card-header">
                    <div class="data-card-title d-flex align-items-center gap-2"><i class="bi bi-person-badge text-muted"></i> Floor worker records (HRMS)</div>
                    <span class="af-badge @(Model.EmployeePercentage >= 90 ? "b-red" : Model.EmployeePercentage >= 75 ? "b-yellow" : "b-gray")">@Model.UsedEmployeeRecords / @Model.TotalEmployeeRecords</span>
                </div>
                <div class="data-card-body">
                    <p class="text-sm text-muted">Tailors, cutters and operators. No ERP access — face kiosk and biometric punch only; attendance and payroll stay in HRMS.</p>
                    <div class="progress-row">
                        <span class="pr-label">Consumption</span>
                        <div class="af-progress"><div class="af-progress-bar @(Model.EmployeePercentage >= 90 ? "bg-danger" : Model.EmployeePercentage >= 75 ? "bg-warning" : "bg-success")" role="progressbar" style="width: @Model.EmployeePercentage%;" aria-valuenow="@Model.UsedEmployeeRecords" aria-valuemin="0" aria-valuemax="@Model.TotalEmployeeRecords" aria-label="Floor worker records (HRMS) used"></div></div>
                        <span class="pr-value">@Model.EmployeePercentage% used</span>
                    </div>
                    <div class="usage-figures">
                        <div><div class="info-label">Worker limit</div><div class="info-value">@Model.TotalEmployeeRecords</div></div>
                        <div><div class="info-label">Registered</div><div class="info-value">@Model.UsedEmployeeRecords</div></div>
                        <div><div class="info-label">Capacity left</div><div class="info-value text-success">@(Model.TotalEmployeeRecords - Model.UsedEmployeeRecords)</div></div>
                    </div>
                    <div class="form-actions justify-content-between">
                        <span class="text-xs text-muted">Worker add-on ₹499 per 25 workers/mo</span>
                        <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-secondary"><i class="bi bi-person-lines-fill"></i> Manage workers</a>
                    </div>
                </div>
            </div>
        </div>
</div>

<div class="data-card">
    <div class="data-card-header">
        <div class="data-card-title">Data isolation &amp; security</div>
    </div>
    <div class="data-card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1"><i class="bi bi-database-lock text-muted me-1"></i> Global query filters</div>
                <p class="text-sm text-muted mb-0">Every query is scoped with <code>WHERE TenantId = @Model.Tenant.Id</code>, so data can’t leak across tenants.</p>
            </div>
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1"><i class="bi bi-cpu text-muted me-1"></i> Floor worker isolation</div>
                <p class="text-sm text-muted mb-0">Factory workers have no login credentials. They authenticate only by face recognition or biometric API at kiosks.</p>
            </div>
            <div class="col-md-4">
                <div class="text-foreground fw-semibold mb-1"><i class="bi bi-hdd-network text-muted me-1"></i> Dedicated database option</div>
                <p class="text-sm text-muted mb-0">Enterprise customers can use a dedicated SQL database while keeping shared app services.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSeatsModal" tabindex="-1" aria-labelledby="addSeatsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Subscription" asp-action="AddSeats" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="addSeatsModalLabel">Add licence capacity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="addSeats">ERP desk seats <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="number" id="addSeats" name="additionalErpSeats" class="af-input" value="5" min="0" max="500" required />
                        <span class="input-group-text">seats · ₹399/seat/mo</span>
                    </div>
                    <div class="form-text">Desk users who can sign in to the ERP portal.</div>
                </div>
                <div>
                    <label class="form-label" for="addWorkers">Floor worker records <span class="req">*</span></label>
                    <div class="input-group">
                        <input type="number" id="addWorkers" name="additionalWorkers" class="af-input" value="25" min="0" max="2000" step="25" required />
                        <span class="input-group-text">workers · ₹499 per 25</span>
                    </div>
                    <div class="form-text">Tailors and cutters for the face kiosk and HRMS payroll.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Update quota</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="changePlanModal" tabindex="-1" aria-labelledby="changePlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form asp-controller="Subscription" asp-action="ChangePlan" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="changePlanModalLabel">Choose a plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="plan-card" for="planStarter">
                            <div class="plan-head"><span class="plan-name">Starter</span></div>
                            <div class="plan-price">₹2,499<small>/mo</small></div>
                            <p class="plan-desc">Small garment shop or job-work unit.</p>
                            <ul class="plan-features"><li><i class="bi bi-check-lg"></i> 5 ERP desk users</li><li><i class="bi bi-check-lg"></i> 25 floor workers</li><li><i class="bi bi-check-lg"></i> Production &amp; job slips</li><li><i class="bi bi-check-lg"></i> Face scan kiosk</li></ul>
                            <span class="plan-select"><input class="form-check-input" type="radio" name="newPlan" id="planStarter" value="@SubscriptionTier.Starter" @(Model.Tenant.PlanType == SubscriptionTier.Starter ? "checked" : "")> Select starter</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="plan-card" for="planGrowth">
                            <div class="plan-head"><span class="plan-name">Growth</span><span class="af-badge b-indigo">Popular</span></div>
                            <div class="plan-price">₹6,999<small>/mo</small></div>
                            <p class="plan-desc">Garment brand &amp; manufacturing factory.</p>
                            <ul class="plan-features"><li><i class="bi bi-check-lg"></i> 15 ERP desk users</li><li><i class="bi bi-check-lg"></i> 100 floor workers</li><li><i class="bi bi-check-lg"></i> GST filing &amp; invoicing</li><li><i class="bi bi-check-lg"></i> Double-entry ledger</li><li><i class="bi bi-check-lg"></i> 3-way match &amp; aging</li></ul>
                            <span class="plan-select"><input class="form-check-input" type="radio" name="newPlan" id="planGrowth" value="@SubscriptionTier.Growth" @(Model.Tenant.PlanType == SubscriptionTier.Growth ? "checked" : "")> Select growth</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="plan-card" for="planEnterprise">
                            <div class="plan-head"><span class="plan-name">Enterprise</span></div>
                            <div class="plan-price">₹18,999<small>/mo</small></div>
                            <p class="plan-desc">Textile mill &amp; multi-factory group.</p>
                            <ul class="plan-features"><li><i class="bi bi-check-lg"></i> 50 ERP desk users</li><li><i class="bi bi-check-lg"></i> 500 floor workers</li><li><i class="bi bi-check-lg"></i> Dedicated database</li><li><i class="bi bi-check-lg"></i> Biometric terminal API</li><li><i class="bi bi-check-lg"></i> Priority 24×7 support</li></ul>
                            <span class="plan-select"><input class="form-check-input" type="radio" name="newPlan" id="planEnterprise" value="@SubscriptionTier.Enterprise" @(Model.Tenant.PlanType == SubscriptionTier.Enterprise ? "checked" : "")> Select enterprise</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Switch plan</button>
            </div>
        </form>
    </div>
</div>
