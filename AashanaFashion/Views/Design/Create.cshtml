@model AashanaFashion.Models.Design
@{
    ViewData["Title"] = "New Product";
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">New Product</h1>
        <p class="page-sub">Add a new product with all details</p>
    </div>
    <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back</a>
</div>

<form asp-action="Create" method="post" id="productForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Product Details</div>
        </div>
        <div style="padding:0;">

            <!-- Tabs -->
            <ul class="nav nav-tabs" id="productTabs" role="tablist" style="padding:0 1.5rem;border-bottom:2px solid #e2e8f0;">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">General Information</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="attributes-tab" data-bs-toggle="tab" data-bs-target="#attributes" type="button" role="tab">Attributes & Variants</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab">Sales</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="prices-tab" data-bs-toggle="tab" data-bs-target="#prices" type="button" role="tab">Prices</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="purchase-tab" data-bs-toggle="tab" data-bs-target="#purchase" type="button" role="tab">Purchase</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory" type="button" role="tab">Inventory</button>
                </li>
            </ul>

            <div class="tab-content" style="padding:1.5rem;">

                <!-- ===== TAB 1: GENERAL INFORMATION ===== -->
                <div class="tab-pane fade show active" id="general" role="tabpanel">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label class="af-label">Product Type</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ProductType" value="Goods" checked="@(Model.ProductType == "Goods")" /> Goods</label>
                                    <label><input type="radio" name="ProductType" value="Service" checked="@(Model.ProductType == "Service")" /> Service</label>
                                    <label><input type="radio" name="ProductType" value="Combo" checked="@(Model.ProductType == "Combo")" /> Combo</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="InvoicingPolicy" class="af-label">Invoicing Policy</label>
                                <input asp-for="InvoicingPolicy" class="af-input" placeholder="Invoicing policy" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="gap:1.5rem;padding-top:1.8rem;">
                            <label><input asp-for="TrackInventory" /> Track Inventory</label>
                            <label><input asp-for="Discontinued" /> Discontinued</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="DesignNumber" class="af-label">Design Number *</label>
                                <input asp-for="DesignNumber" class="af-input" placeholder="e.g. AF-001" required />
                                <span asp-validation-for="DesignNumber" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommonDNo" class="af-label">Common D No</label>
                                <input asp-for="CommonDNo" class="af-input" placeholder="Common design number" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SalesPrice" class="af-label">Sales Price (₹)</label>
                                <input asp-for="SalesPrice" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="QuantityOnHand" class="af-label">Quantity On Hand</label>
                                <input asp-for="QuantityOnHand" class="af-input" type="number" step="1" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="CategoryId" class="af-label mb-0">Category</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#quickCategoryModal" title="Create a new Category inline">
                                        ➕ New
                                    </button>
                                </div>
                                <select asp-for="CategoryId" class="af-input af-select" id="productCategorySelect">
                                    <option value="">-- Select Category --</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var cat in (List<AashanaFashion.Models.ProductCategory>)ViewBag.Categories)
                                        {
                                            <option value="@cat.Id" data-hsn="@cat.DefaultHsnCode" data-gst="@cat.DefaultGstRate" selected="@(Model.CategoryId == cat.Id)">
                                                @cat.CategoryName @(!string.IsNullOrEmpty(cat.CategoryCode) ? $"({cat.CategoryCode})" : "")
                                            </option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="Category" id="categoryNameHidden" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="HsnSacCode" class="af-label">HSN/SAC Code</label>
                                <input asp-for="HsnSacCode" class="af-input" placeholder="HSN/SAC" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SalesTaxes" class="af-label">Sales Taxes</label>
                                <input asp-for="SalesTaxes" class="af-input" placeholder="Sales taxes" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PurchaseTaxes" class="af-label">Purchase Taxes</label>
                                <input asp-for="PurchaseTaxes" class="af-input" placeholder="Purchase taxes" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Company" class="af-label">Company</label>
                                <input asp-for="Company" class="af-input" placeholder="Company" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Property1" class="af-label">Property 1</label>
                                <input asp-for="Property1" class="af-input" placeholder="Property" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label class="af-label">Colours *</label>
                                <div style="max-height: 120px; overflow-y: auto; border: 1px solid #cbd5e1; border-radius: 8px; padding: .5rem; background: #fff;">
                                    @foreach (var c in ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new())
                                    {
                                        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.25rem; font-size:.875rem;">
                                            <input type="checkbox" name="selectedColours" value="@c.Id" id="colour_@c.Id" data-name="@c.ColourName" data-code="@c.ColourCode" class="colour-checkbox" />
                                            @if (!string.IsNullOrEmpty(c.ColourCode))
                                            {
                                                <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:@c.ColourCode; border:1px solid #cbd5e1;"></span>
                                            }
                                            <label for="colour_@c.Id" style="cursor:pointer; margin-bottom:0;">@c.ColourName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="af-label mb-0">Sizes *</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#extraChargesModal" title="Configure extra charges according to Colour or Size">
                                        ⚙️ Configure Charges
                                    </button>
                                </div>
                                <div style="max-height: 120px; overflow-y: auto; border: 1px solid #cbd5e1; border-radius: 8px; padding: .5rem; background: #fff;">
                                    @foreach (var s in ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new())
                                    {
                                        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.25rem; font-size:.875rem;">
                                            <input type="checkbox" name="selectedSizes" value="@s.Id" id="size_@s.Id" data-name="@s.SizeName" class="size-checkbox" />
                                            <label for="size_@s.Id" style="cursor:pointer; margin-bottom:0;">@s.SizeName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="extraChargesSummaryRow" class="row mb-2" style="display:none;">
                        <div class="col-md-12">
                            <div class="alert alert-light border py-1 px-3 d-flex justify-content-between align-items-center small mb-0">
                                <div>
                                    <strong class="text-primary">🏷️ Variant Extra Charges:</strong>
                                    <span id="extraChargesSummaryText" class="text-dark ms-1"></span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#extraChargesModal">Edit Charges</button>
                            </div>
                        </div>
                    </div>
                    <div id="extraChargesHiddenInputs"></div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="af-form-group">
                                <label asp-for="CreationFlow" class="af-label">Creation Flow</label>
                                <input asp-for="CreationFlow" class="af-input" placeholder="e.g. Dying,Handwork,Stitching" />
                                <span style="font-size:.75rem;color:#94a3b8;">Comma-separated list of production steps</span>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="InternalNotes" class="af-label">Internal Notes</label>
                        <textarea asp-for="InternalNotes" class="af-input" rows="3" placeholder="Internal notes"></textarea>
                    </div>
                </div>

                <!-- ===== TAB 2: ATTRIBUTES & VARIANTS ===== -->
                <div class="tab-pane fade" id="attributes" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="attrTable">
                            <thead>
                                <tr>
                                    <th style="width:200px;">Attribute</th>
                                    <th style="width:300px;">Values</th>
                                    <th style="width:120px;">Colour Check</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="attrBody">
                                <tr class="attr-row">
                                    <td><input name="AttributeLines[0].Attribute" class="af-input" placeholder="e.g. Size, Color" /></td>
                                    <td><input name="AttributeLines[0].Values" class="af-input" placeholder="e.g. S,M,L / Red,Blue" /></td>
                                    <td class="text-center"><input name="AttributeLines[0].ColourCheck" type="checkbox" value="true" /><input type="hidden" name="AttributeLines[0].ColourCheck" value="false" /></td>
                                    <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-attr-row" style="display:none;">×</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addAttrRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Attribute</button>
                </div>

                <!-- ===== TAB 3: SALES ===== -->
                <div class="tab-pane fade" id="sales" role="tabpanel">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="VisibilityOfProducts" class="af-label">Visibility Of Products</label>
                                <input asp-for="VisibilityOfProducts" class="af-input" placeholder="Visibility" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Website" class="af-label">Website</label>
                                <input asp-for="Website" class="af-input" placeholder="Website URL" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Tags" class="af-label">Tags</label>
                                <input asp-for="Tags" class="af-input" placeholder="Tags" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Ribbon" class="af-label">Ribbon</label>
                                <input asp-for="Ribbon" class="af-input" placeholder="Ribbon text" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="OutOfStockMessage" class="af-label">Out-of-Stock Message</label>
                                <input asp-for="OutOfStockMessage" class="af-input" placeholder="Message" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="gap:1.5rem;padding-top:1.8rem;">
                            <label><input asp-for="IsPublished" /> Is Published</label>
                            <label><input asp-for="SellWhenOutOfStock" /> Sell when Out-of-Stock</label>
                            <label><input asp-for="ShowAvailableQty" /> Show Available Qty</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label">Re-Invoice Costs</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ReInvoiceCosts" value="" checked="@(string.IsNullOrEmpty(Model.ReInvoiceCosts))" /> No</label>
                                    <label><input type="radio" name="ReInvoiceCosts" value="At cost" checked="@(Model.ReInvoiceCosts == "At cost")" /> At cost</label>
                                    <label><input type="radio" name="ReInvoiceCosts" value="Sales price" checked="@(Model.ReInvoiceCosts == "Sales price")" /> Sales price</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label class="af-label">Ecommerce Description</label>
                        <textarea asp-for="EcommerceDescription" class="af-input" rows="3" placeholder="Ecommerce description"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label class="af-label">Quotation Description</label>
                        <textarea asp-for="QuotationDescription" class="af-input" rows="2" placeholder="Quotation description"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label class="af-label">Warning On Sales Orders</label>
                        <textarea asp-for="WarningOnSalesOrders" class="af-input" rows="2" placeholder="Warning message"></textarea>
                    </div>

                    <!-- Packaging (child table on Sales tab) -->
                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;">Packagings</label>
                    <div style="overflow-x:auto;margin-top:.5rem;">
                        <table class="af-table" id="pkgTable">
                            <thead>
                                <tr>
                                    <th style="width:200px;">Packaging Name</th>
                                    <th style="width:150px;">Quantity</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="pkgBody">
                                <tr class="pkg-row">
                                    <td><input name="Packagings[0].PackagingName" class="af-input" placeholder="Packaging" /></td>
                                    <td><input name="Packagings[0].Quantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                    <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-pkg-row" style="display:none;">×</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addPkgRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Packaging</button>
                </div>

                <!-- ===== TAB 4: PRICES ===== -->
                <div class="tab-pane fade" id="prices" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="priceTable">
                            <thead>
                                <tr>
                                    <th style="width:180px;">Pricelist</th>
                                    <th style="width:180px;">Applied On</th>
                                    <th style="width:150px;">Price (₹)</th>
                                    <th style="width:150px;">Min. Quantity</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="priceBody">
                                <tr class="price-row">
                                    <td><input name="Pricelists[0].Pricelist" class="af-input" placeholder="Pricelist name" /></td>
                                    <td><input name="Pricelists[0].AppliedOn" class="af-input" placeholder="e.g. Product, Category" /></td>
                                    <td><input name="Pricelists[0].Price" class="af-input" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input name="Pricelists[0].MinQuantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                    <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-price-row" style="display:none;">×</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addPriceRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Pricelist</button>
                </div>

                <!-- ===== TAB 5: PURCHASE ===== -->
                <div class="tab-pane fade" id="purchase" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="vendorTable">
                            <thead>
                                <tr>
                                    <th style="width:180px;">Vendor</th>
                                    <th style="width:100px;">Quantity</th>
                                    <th style="width:100px;">Unit</th>
                                    <th style="width:120px;">Unit Price (₹)</th>
                                    <th style="width:100px;">Lead Time (Days)</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="vendorBody">
                                <tr class="vendor-row">
                                    <td>
                                        <select name="ProductVendors[0].VendorId" class="af-input af-select">
                                            <option value="">— Select —</option>
                                            @foreach (var v in vendors)
                                            {
                                                <option value="@v.Id">@v.VendorName</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input name="ProductVendors[0].Quantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                    <td>
                                        <select name="ProductVendors[0].Unit" class="af-input af-select">
                                            <option value="Piece">Piece</option>
                                            <option value="Meter">Meter</option>
                                        </select>
                                    </td>
                                    <td><input name="ProductVendors[0].UnitPrice" class="af-input" type="number" step="0.01" min="0" value="0" /></td>
                                    <td><input name="ProductVendors[0].LeadTime" class="af-input" type="number" min="0" value="0" /></td>
                                    <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-vendor-row" style="display:none;">×</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addVendorRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Vendor</button>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label">Control Policy</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ControlPolicy" value="On ordered quantities" checked="@(Model.ControlPolicy == "On ordered quantities")" /> On ordered quantities</label>
                                    <label><input type="radio" name="ControlPolicy" value="On received quantities" checked="@(Model.ControlPolicy == "On received quantities")" /> On received quantities</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="PurchaseDescription" class="af-label">Purchase Description</label>
                        <textarea asp-for="PurchaseDescription" class="af-input" rows="2" placeholder="Purchase description"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="WarningOnPurchaseOrders" class="af-label">Warning On Purchase Orders</label>
                        <textarea asp-for="WarningOnPurchaseOrders" class="af-input" rows="2" placeholder="Warning message"></textarea>
                    </div>
                </div>

                <!-- ===== TAB 6: INVENTORY ===== -->
                <div class="tab-pane fade" id="inventory" role="tabpanel">
                    <div class="af-form-group">
                        <label class="af-label">Routes</label>
                        <div style="display:flex;flex-wrap:wrap;gap:1rem;padding:.5rem 0;">
                            <label><input asp-for="RouteBuy" /> Buy</label>
                            <label><input asp-for="RouteManufacture" /> Manufacture</label>
                            <label><input asp-for="RouteResupplySubcontractor" /> Aashana: Resupply Subcontractor</label>
                            <label><input asp-for="RouteResupplySubcontractorOnOrder" /> Resupply Subcontractor on Order</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Responsible" class="af-label">Responsible</label>
                                <select asp-for="Responsible" class="af-input af-select">
                                    <option value="">— Select Responsible User —</option>
                                    @if (ViewBag.Users != null)
                                    {
                                        foreach (var u in (List<AashanaFashion.Models.AppUser>)ViewBag.Users)
                                        {
                                            <option value="@u.FullName">@u.FullName (@u.Role)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="CustomerLeadTime" class="af-label">Customer Lead Time (Days)</label>
                                <input asp-for="CustomerLeadTime" class="af-input" type="number" min="0" placeholder="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SafetyFactor" class="af-label">Safety Factor</label>
                                <input asp-for="SafetyFactor" class="af-input" type="number" step="0.01" min="0" placeholder="0.00" />
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForReceipts" class="af-label">Description For Receipts</label>
                        <textarea asp-for="DescriptionForReceipts" class="af-input" rows="2" placeholder="Description for receipts"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForInternalTransfers" class="af-label">Description For Internal Transfers</label>
                        <textarea asp-for="DescriptionForInternalTransfers" class="af-input" rows="2" placeholder="Description for internal transfers"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForDeliveryOrders" class="af-label">Description For Delivery Orders</label>
                        <textarea asp-for="DescriptionForDeliveryOrders" class="af-input" rows="2" placeholder="Description for delivery orders"></textarea>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="display:flex;gap:.75rem;margin-top:1rem;">
        <button type="submit" class="btn-af btn-af-primary">Create Product</button>
        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
    </div>
</form>

<!-- Quick Create Category Modal -->
<div class="modal fade" id="quickCategoryModal" tabindex="-1" aria-labelledby="quickCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2">
                <h6 class="modal-title fw-bold" id="quickCategoryModalLabel">🗂️ Quick Create Category</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="quickCatError" class="alert alert-danger py-1 px-2 small d-none"></div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Category Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickCategoryName" class="form-control form-control-sm" placeholder="e.g. Kurtis, Sarees" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">Short Code</label>
                        <input type="text" id="quickCategoryCode" class="form-control form-control-sm text-uppercase" placeholder="e.g. KRT" maxlength="10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">Default HSN/SAC</label>
                        <input type="text" id="quickDefaultHsn" class="form-control form-control-sm font-monospace" placeholder="e.g. 6204" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Default GST Rate</label>
                    <select id="quickDefaultGst" class="form-select form-select-sm">
                        <option value="5.00">5% (Standard Apparel)</option>
                        <option value="12.00">12% (Luxury Apparel)</option>
                        <option value="18.00">18% (Specialized / Synthetics)</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Description (Optional)</label>
                    <textarea id="quickCategoryDesc" class="form-control form-control-sm" rows="2" placeholder="Notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveQuickCategoryBtn" class="btn btn-sm btn-primary px-3">Create Category</button>
            </div>
        </div>
    </div>
</div>

<!-- Configure Extra Charges (Colour & Size) Modal -->
<div class="modal fade" id="extraChargesModal" tabindex="-1" aria-labelledby="extraChargesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⚙️</span>
                    <h6 class="modal-title fw-bold" id="extraChargesModalLabel">Configure Variant Extra Charges (Colour & Size)</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="alert alert-info py-2 px-3 small mb-3">
                    💡 Specify extra charges (surcharges in ₹) for specific colours or sizes (e.g. plus sizes or intricate dye colours). These surcharges will automatically reflect when creating Sales Orders, calculating pricelists, and generating invoices.
                </div>

                <ul class="nav nav-pills mb-3" id="extraChargesTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-1 px-3 small fw-semibold" id="colour-charges-tab" data-bs-toggle="pill" data-bs-target="#colour-charges-pane" type="button" role="tab">🎨 Colour Extra Charges</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-1 px-3 small fw-semibold" id="size-charges-tab" data-bs-toggle="pill" data-bs-target="#size-charges-pane" type="button" role="tab">📏 Size Extra Charges</button>
                    </li>
                </ul>

                <div class="tab-content" id="extraChargesTabContent">
                    <!-- Colour Tab -->
                    <div class="tab-pane fade show active" id="colour-charges-pane" role="tabpanel">
                        <div id="noColoursWarning" class="text-muted small py-2 d-none">No colours are selected yet. Please check colours in the product form first.</div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle mb-0" id="colourChargesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Colour Name</th>
                                        <th style="width: 30%;">Extra Charge (₹)</th>
                                        <th style="width: 35%;">Remarks (Optional)</th>
                                    </tr>
                                </thead>
                                <tbody id="colourChargesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Size Tab -->
                    <div class="tab-pane fade" id="size-charges-pane" role="tabpanel">
                        <div id="noSizesWarning" class="text-muted small py-2 d-none">No sizes are selected yet. Please check sizes in the product form first.</div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle mb-0" id="sizeChargesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Size</th>
                                        <th style="width: 30%;">Extra Charge (₹)</th>
                                        <th style="width: 35%;">Remarks (Optional)</th>
                                    </tr>
                                </thead>
                                <tbody id="sizeChargesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Live Preview Matrix -->
                <div class="card border-0 bg-light p-2 mt-3 rounded-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-dark">Price Calculation Preview:</span>
                        <span id="previewCalculationText" class="small text-primary fw-bold">Base Price: ₹0.00</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="applyExtraChargesBtn" class="btn btn-sm btn-primary px-3">Apply Extra Charges</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/product.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const catSelect = document.getElementById('productCategorySelect');
        const catHidden = document.getElementById('categoryNameHidden');
        const hsnInput = document.getElementById('HsnSacCode');

        catSelect?.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (opt && opt.value) {
                if (catHidden) catHidden.value = opt.text.trim();
                const hsn = opt.getAttribute('data-hsn');
                if (hsn && hsnInput) {
                    hsnInput.value = hsn;
                }
            } else {
                if (catHidden) catHidden.value = '';
            }
        });

        document.getElementById('saveQuickCategoryBtn')?.addEventListener('click', function () {
            const nameInput = document.getElementById('quickCategoryName');
            const codeInput = document.getElementById('quickCategoryCode');
            const hsnInputEl = document.getElementById('quickDefaultHsn');
            const gstInput = document.getElementById('quickDefaultGst');
            const descInput = document.getElementById('quickCategoryDesc');
            const errDiv = document.getElementById('quickCatError');

            const name = nameInput?.value?.trim();
            if (!name) {
                if (errDiv) {
                    errDiv.textContent = 'Category Name is required.';
                    errDiv.classList.remove('d-none');
                }
                return;
            }

            const payload = {
                categoryName: name,
                categoryCode: codeInput?.value?.trim() || null,
                defaultHsnCode: hsnInputEl?.value?.trim() || null,
                defaultGstRate: parseFloat(gstInput?.value) || 5.0,
                description: descInput?.value?.trim() || null
            };

            this.disabled = true;
            this.textContent = 'Saving...';

            fetch('/Category/QuickCreate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    let option = catSelect.querySelector(`option[value="${data.id}"]`);
                    if (!option) {
                        option = document.createElement('option');
                        option.value = data.id;
                        option.textContent = data.code ? `${data.name} (${data.code})` : data.name;
                        option.setAttribute('data-hsn', data.hsn || '');
                        option.setAttribute('data-gst', data.gst || '');
                        catSelect.appendChild(option);
                    }
                    catSelect.value = data.id;
                    catSelect.dispatchEvent(new Event('change'));

                    const modalEl = document.getElementById('quickCategoryModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modalInstance.hide();

                    nameInput.value = '';
                    if (codeInput) codeInput.value = '';
                    if (hsnInputEl) hsnInputEl.value = '';
                    if (descInput) descInput.value = '';
                    if (errDiv) errDiv.classList.add('d-none');
                } else {
                    if (errDiv) {
                        errDiv.textContent = data.message || 'Error creating category.';
                        errDiv.classList.remove('d-none');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (errDiv) {
                    errDiv.textContent = 'Server error occurred.';
                    errDiv.classList.remove('d-none');
                }
            })
            .finally(() => {
                this.disabled = false;
                this.textContent = 'Create Category';
            });
        });

        // Extra charges handling
        const extraChargesStore = {
            'Colour': {},
            'Size': {}
        };

        const extraChargesModalEl = document.getElementById('extraChargesModal');
        const colourChargesBody = document.getElementById('colourChargesBody');
        const sizeChargesBody = document.getElementById('sizeChargesBody');
        const noColoursWarning = document.getElementById('noColoursWarning');
        const noSizesWarning = document.getElementById('noSizesWarning');
        const previewCalculationText = document.getElementById('previewCalculationText');
        const extraChargesHiddenInputs = document.getElementById('extraChargesHiddenInputs');
        const extraChargesSummaryRow = document.getElementById('extraChargesSummaryRow');
        const extraChargesSummaryText = document.getElementById('extraChargesSummaryText');

        function updatePreviewText() {
            const baseRate = parseFloat(document.getElementById('SalesPrice')?.value) || parseFloat(document.getElementById('Price')?.value) || 0;
            let maxColourExtra = 0;
            let maxColourName = '';
            for (const c in extraChargesStore['Colour']) {
                if (extraChargesStore['Colour'][c].charge > maxColourExtra) {
                    maxColourExtra = extraChargesStore['Colour'][c].charge;
                    maxColourName = c;
                }
            }
            let maxSizeExtra = 0;
            let maxSizeName = '';
            for (const s in extraChargesStore['Size']) {
                if (extraChargesStore['Size'][s].charge > maxSizeExtra) {
                    maxSizeExtra = extraChargesStore['Size'][s].charge;
                    maxSizeName = s;
                }
            }
            if (maxColourExtra > 0 || maxSizeExtra > 0) {
                let formula = `Base: ₹${baseRate.toFixed(2)}`;
                if (maxColourExtra > 0) formula += ` + Colour (${maxColourName}): ₹${maxColourExtra.toFixed(2)}`;
                if (maxSizeExtra > 0) formula += ` + Size (${maxSizeName}): ₹${maxSizeExtra.toFixed(2)}`;
                formula += ` = Total: ₹${(baseRate + maxColourExtra + maxSizeExtra).toFixed(2)}`;
                previewCalculationText.textContent = formula;
            } else {
                previewCalculationText.textContent = `Base Price: ₹${baseRate.toFixed(2)} (No active surcharges)`;
            }
        }

        extraChargesModalEl?.addEventListener('show.bs.modal', function () {
            const checkedColours = Array.from(document.querySelectorAll('.colour-checkbox:checked'));
            colourChargesBody.innerHTML = '';
            if (checkedColours.length === 0) {
                noColoursWarning.classList.remove('d-none');
            } else {
                noColoursWarning.classList.add('d-none');
                checkedColours.forEach(cb => {
                    const name = cb.getAttribute('data-name');
                    const code = cb.getAttribute('data-code');
                    const existing = extraChargesStore['Colour'][name] || { charge: 0, remarks: '' };
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                ${code ? `<span style="display:inline-block;width:14px;height:14px;border-radius:50%;background-color:${code};border:1px solid #ccc;"></span>` : ''}
                                <span class="fw-semibold text-dark">${name}</span>
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end ec-colour-charge" data-name="${name}" value="${existing.charge > 0 ? existing.charge.toFixed(2) : '0.00'}" />
                            </div>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm ec-colour-remarks" data-name="${name}" placeholder="e.g. Special dye" value="${existing.remarks || ''}" />
                        </td>
                    `;
                    colourChargesBody.appendChild(tr);
                });
            }

            const checkedSizes = Array.from(document.querySelectorAll('.size-checkbox:checked'));
            sizeChargesBody.innerHTML = '';
            if (checkedSizes.length === 0) {
                noSizesWarning.classList.remove('d-none');
            } else {
                noSizesWarning.classList.add('d-none');
                checkedSizes.forEach(cb => {
                    const name = cb.getAttribute('data-name');
                    const existing = extraChargesStore['Size'][name] || { charge: 0, remarks: '' };
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">${name}</span>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end ec-size-charge" data-name="${name}" value="${existing.charge > 0 ? existing.charge.toFixed(2) : '0.00'}" />
                            </div>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm ec-size-remarks" data-name="${name}" placeholder="e.g. Plus size fabric" value="${existing.remarks || ''}" />
                        </td>
                    `;
                    sizeChargesBody.appendChild(tr);
                });
            }

            updatePreviewText();
        });

        extraChargesModalEl?.addEventListener('input', function (e) {
            if (e.target.classList.contains('ec-colour-charge')) {
                const name = e.target.getAttribute('data-name');
                if (!extraChargesStore['Colour'][name]) extraChargesStore['Colour'][name] = {};
                extraChargesStore['Colour'][name].charge = parseFloat(e.target.value) || 0;
                updatePreviewText();
            }
            if (e.target.classList.contains('ec-size-charge')) {
                const name = e.target.getAttribute('data-name');
                if (!extraChargesStore['Size'][name]) extraChargesStore['Size'][name] = {};
                extraChargesStore['Size'][name].charge = parseFloat(e.target.value) || 0;
                updatePreviewText();
            }
        });

        function syncHiddenInputsAndBadge() {
            extraChargesHiddenInputs.innerHTML = '';
            let count = 0;
            const summaryParts = [];
            let idx = 0;

            for (const type of ['Colour', 'Size']) {
                for (const val in extraChargesStore[type]) {
                    const item = extraChargesStore[type][val];
                    if (item.charge > 0) {
                        count++;
                        summaryParts.push(`${val} (+₹${item.charge.toFixed(2)})`);

                        extraChargesHiddenInputs.innerHTML += `
                            <input type="hidden" name="ExtraCharges[${idx}].AttributeType" value="${type}" />
                            <input type="hidden" name="ExtraCharges[${idx}].AttributeValue" value="${val}" />
                            <input type="hidden" name="ExtraCharges[${idx}].ExtraCharge" value="${item.charge}" />
                            <input type="hidden" name="ExtraCharges[${idx}].Remarks" value="${item.remarks || ''}" />
                        `;
                        idx++;
                    }
                }
            }

            if (count > 0) {
                extraChargesSummaryText.textContent = `${count} surcharge(s) active: ${summaryParts.join(', ')}`;
                extraChargesSummaryRow.style.display = '';
            } else {
                extraChargesSummaryRow.style.display = 'none';
            }
        }

        document.getElementById('applyExtraChargesBtn')?.addEventListener('click', function () {
            document.querySelectorAll('.ec-colour-charge').forEach(input => {
                const name = input.getAttribute('data-name');
                const charge = parseFloat(input.value) || 0;
                const remarks = document.querySelector(`.ec-colour-remarks[data-name="${name}"]`)?.value || '';
                extraChargesStore['Colour'][name] = { charge, remarks };
            });

            document.querySelectorAll('.ec-size-charge').forEach(input => {
                const name = input.getAttribute('data-name');
                const charge = parseFloat(input.value) || 0;
                const remarks = document.querySelector(`.ec-size-remarks[data-name="${name}"]`)?.value || '';
                extraChargesStore['Size'][name] = { charge, remarks };
            });

            syncHiddenInputsAndBadge();

            const modalInstance = bootstrap.Modal.getInstance(extraChargesModalEl) || new bootstrap.Modal(extraChargesModalEl);
            modalInstance.hide();
        });
    });
    </script>
}
