@model AashanaFashion.Models.Design
@{
    ViewData["Title"] = "Edit Product";
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Product — @Model.DesignNumber</h1>
        <p class="page-sub">ID #@Model.Id</p>
    </div>
    <a asp-action="Index" class="btn-af btn-af-ghost btn-af-sm">← Back</a>
</div>

<form asp-action="Edit" method="post" id="productForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedDate" />
    <input type="hidden" asp-for="PhotoPath" id="existingPhotoPath" />
    <input type="hidden" name="removePhoto" id="removePhotoInput" value="false" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="af-alert af-alert-danger mb-3">
            <div class="alert-body">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
            <button class="alert-close">&times;</button>
        </div>
    }

    <div class="data-card">
        <div class="data-card-header">
            <div class="data-card-title">Product Details</div>
        </div>
        <div style="padding:0;">

            <!-- Tabs -->
            <ul class="nav nav-tabs" id="productTabs" role="tablist" style="padding:0 1.5rem;border-bottom:2px solid #e2e8f0;">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">General Information</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="attributes-tab" data-bs-toggle="tab" data-bs-target="#attributes" type="button" role="tab">Attributes & Variants</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab">Sales</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="prices-tab" data-bs-toggle="tab" data-bs-target="#prices" type="button" role="tab">Prices</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="purchase-tab" data-bs-toggle="tab" data-bs-target="#purchase" type="button" role="tab">Purchase</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventory" type="button" role="tab">Inventory</button>
                </li>
            </ul>

            <div class="tab-content" style="padding:1.5rem;">

                <!-- ===== TAB 1: GENERAL INFORMATION ===== -->
                <div class="tab-pane fade show active" id="general" role="tabpanel">

                    <!-- Product / Design Photo Upload Banner -->
                    <div class="row align-items-center mb-4 p-3 bg-light rounded-3 border">
                        <div class="col-auto">
                            <div class="rounded-3 border overflow-hidden bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                                <img id="designPhotoPreview" 
                                     src="@(string.IsNullOrEmpty(Model.PhotoPath) ? "/images/placeholder-product.svg" : Model.PhotoPath)" 
                                     alt="Design Photo Preview" 
                                     class="img-fluid h-100 w-100 object-fit-contain" 
                                     onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                            </div>
                        </div>
                        <div class="col">
                            <label class="af-label fw-bold mb-1"><i class="bi bi-camera me-1 text-primary"></i> Product / Design Photo</label>
                            <p class="text-muted small mb-2">Upload or change reference photo for this design. Leave blank to keep current photo.</p>
                            <div class="d-flex align-items-center gap-2" style="max-width: 480px;">
                                <input type="file" name="photoFile" id="designPhotoInput" class="form-control form-control-sm" accept="image/*" />
                                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                                {
                                    <button type="button" id="removePhotoBtn" class="btn btn-outline-danger btn-sm text-nowrap" onclick="removeDesignPhoto()">
                                        🗑️ Remove
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label class="af-label">Product Type</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ProductType" value="Goods" checked="@(Model.ProductType == "Goods")" /> Goods</label>
                                    <label><input type="radio" name="ProductType" value="Service" checked="@(Model.ProductType == "Service")" /> Service</label>
                                    <label><input type="radio" name="ProductType" value="Combo" checked="@(Model.ProductType == "Combo")" /> Combo</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="InvoicingPolicy" class="af-label">Invoicing Policy</label>
                                <input asp-for="InvoicingPolicy" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-5 pt-3">
                            <div class="d-flex align-items-center gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="TrackInventory" id="trackInvCheck" />
                                    <label class="form-check-label fw-semibold" for="trackInvCheck">Track Inventory</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="Discontinued" id="discontinuedCheck" />
                                    <label class="form-check-label fw-bold text-danger" for="discontinuedCheck">
                                        🚫 Discontinue Whole Product
                                    </label>
                                </div>
                            </div>
                            <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                If discontinued, product is moved to <strong>Archive</strong> and cannot be selected for new production orders. Stock on hand remains sellable.
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="DesignNumber" class="af-label">Design Number *</label>
                                <input asp-for="DesignNumber" class="af-input" required />
                                <span asp-validation-for="DesignNumber" class="af-error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CommonDNo" class="af-label">Common D No</label>
                                <input asp-for="CommonDNo" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SalesPrice" class="af-label">Sales Price (₹)</label>
                                <input asp-for="SalesPrice" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="QuantityOnHand" class="af-label">Quantity On Hand</label>
                                <input asp-for="QuantityOnHand" class="af-input" type="number" step="1" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label asp-for="CategoryId" class="af-label mb-0">Category</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#quickCategoryModal" title="Create a new Category inline">
                                        ➕ New
                                    </button>
                                </div>
                                <select asp-for="CategoryId" class="af-input af-select" id="productCategorySelect">
                                    <option value="">-- Select Category --</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var cat in (List<AashanaFashion.Models.ProductCategory>)ViewBag.Categories)
                                        {
                                            <option value="@cat.Id" data-hsn="@cat.DefaultHsnCode" data-gst="@cat.DefaultGstRate" selected="@(Model.CategoryId == cat.Id || (!Model.CategoryId.HasValue && string.Equals(Model.Category, cat.CategoryName, StringComparison.OrdinalIgnoreCase)))">
                                                @cat.CategoryName @(!string.IsNullOrEmpty(cat.CategoryCode) ? $"({cat.CategoryCode})" : "")
                                            </option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="Category" id="categoryNameHidden" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="HsnSacCode" class="af-label">HSN/SAC Code</label>
                                <input asp-for="HsnSacCode" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="SalesTaxes" class="af-label">Sales Taxes</label>
                                <input asp-for="SalesTaxes" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="PurchaseTaxes" class="af-label">Purchase Taxes</label>
                                <input asp-for="PurchaseTaxes" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="CompanyId" class="af-label">Company</label>
                                <select asp-for="CompanyId" class="af-input af-select">
                                    <option value="">— All Companies (Shared) —</option>
                                    @if (ViewBag.Companies != null)
                                    {
                                        foreach (var comp in (List<AashanaFashion.Models.Company>)ViewBag.Companies)
                                        {
                                            <option value="@comp.Id">🏢 @comp.CompanyName (@comp.CompanyCode)</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label asp-for="Property1" class="af-label">Property 1</label>
                                <input asp-for="Property1" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <label class="af-label">Colours *</label>
                                <div style="max-height: 120px; overflow-y: auto; border: 1px solid #cbd5e1; border-radius: 8px; padding: .5rem; background: #fff;">
                                    @foreach (var c in ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new())
                                    {
                                        var isChecked = (ViewBag.SelectedColours as List<string>)?.Contains(c.ColourName) == true;
                                        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.25rem; font-size:.875rem;">
                                            <input type="checkbox" name="selectedColours" value="@c.Id" id="colour_@c.Id" data-name="@c.ColourName" data-code="@c.ColourCode" class="colour-checkbox" checked="@isChecked" />
                                            @if (!string.IsNullOrEmpty(c.ColourCode))
                                            {
                                                <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:@c.ColourCode; border:1px solid #cbd5e1;"></span>
                                            }
                                            <label for="colour_@c.Id" style="cursor:pointer; margin-bottom:0;">@c.ColourName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="af-form-group">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="af-label mb-0">Sizes *</label>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#extraChargesModal" title="Configure extra charges according to Colour or Size">
                                        ⚙️ Configure Charges
                                    </button>
                                </div>
                                <div style="max-height: 120px; overflow-y: auto; border: 1px solid #cbd5e1; border-radius: 8px; padding: .5rem; background: #fff;">
                                    @foreach (var s in ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new())
                                    {
                                        var isChecked = (ViewBag.SelectedSizes as List<string>)?.Contains(s.SizeName) == true;
                                        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.25rem; font-size:.875rem;">
                                            <input type="checkbox" name="selectedSizes" value="@s.Id" id="size_@s.Id" data-name="@s.SizeName" class="size-checkbox" checked="@isChecked" />
                                            <label for="size_@s.Id" style="cursor:pointer; margin-bottom:0;">@s.SizeName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="extraChargesSummaryRow" class="row mb-2" style="display:none;">
                        <div class="col-md-12">
                            <div class="alert alert-light border py-1 px-3 d-flex justify-content-between align-items-center small mb-0">
                                <div>
                                    <strong class="text-primary">🏷️ Variant Extra Charges:</strong>
                                    <span id="extraChargesSummaryText" class="text-dark ms-1"></span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#extraChargesModal">Edit Charges</button>
                            </div>
                        </div>
                    </div>
                    <div id="extraChargesHiddenInputs"></div>

                    <!-- Colour-wise Image Upload Section -->
                    <div class="card p-3 mb-4 border rounded-3 bg-light shadow-sm" id="colourPhotosSection">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                <span>🎨</span> Colour-wise Product Photos
                            </h6>
                            <span class="badge bg-primary text-white" id="selectedColourCountBadge">@((Model.ColourImages?.Count ?? 0)) Photos</span>
                        </div>
                        <p class="text-muted small mb-3">Upload multiple photos for each selected colour (e.g. front view, back view, embroidery detail). You can select multiple images at once, add additional photos, or remove individual photos.</p>
                        
                        <div id="noColoursSelectedMsg" class="text-muted small py-4 text-center border rounded bg-white" style="@(Model.ColourImages?.Any() == true ? "display:none;" : "")">
                            <span class="fs-4 d-block mb-1">🎨</span>
                            <em>Please select one or more colours in the list above to upload photos for each colourway.</em>
                        </div>
                        
                        <div id="colourPhotosGrid" class="row g-3"></div>
                        <div id="deletedPhotosContainer"></div>
                    </div>

                    <!-- Variant-wise Discontinuation Section -->
                    <div class="card p-3 mb-4 border rounded-3 bg-light shadow-sm" id="discontinuedVariantsSection">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-danger mb-0 d-flex align-items-center gap-2">
                                <span>🚫</span> Variant-wise Discontinuation
                            </h6>
                            <span class="badge bg-danger text-white" id="discontinuedVariantCountBadge">@(Model.DiscontinuedVariants?.Count ?? 0) Discontinued</span>
                        </div>
                        <p class="text-muted small mb-3">
                            Discontinue specific colours, sizes, or specific colour-size combinations. 
                            <strong>No new production orders</strong> can be scheduled for discontinued variants. 
                            However, any <strong>existing stock on hand</strong> can still be sold via Sales Orders.
                        </p>

                        <!-- Form to add discontinued variant -->
                        <div class="p-3 bg-white border rounded-3 mb-3">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Colour</label>
                                    <select id="discColourSelect" class="form-select form-select-sm">
                                        <option value="">— All Colours —</option>
                                        @foreach (var c in ViewBag.Colours as List<AashanaFashion.Models.Colour> ?? new())
                                        {
                                            <option value="@c.ColourName">@c.ColourName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold mb-1">Size</label>
                                    <select id="discSizeSelect" class="form-select form-select-sm">
                                        <option value="">— All Sizes —</option>
                                        @foreach (var s in ViewBag.Sizes as List<AashanaFashion.Models.Size> ?? new())
                                        {
                                            <option value="@s.SizeName">@s.SizeName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold mb-1">Reason for Discontinuation</label>
                                    <input type="text" id="discReasonInput" class="form-control form-control-sm" placeholder="e.g. Fabric unavailable, dying discontinued" />
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-bold" id="btnAddDiscVariant">
                                        ➕ Discontinue
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Table of discontinued variants -->
                        <div class="table-responsive bg-white border rounded-3">
                            <table class="table table-sm table-hover align-middle mb-0" id="discVariantsTable">
                                <thead class="table-light">
                                    <tr style="font-size: 0.8rem;">
                                        <th>Colour</th>
                                        <th>Size</th>
                                        <th>Reason</th>
                                        <th>Date</th>
                                        <th style="width: 60px;" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="discVariantsBody">
                                    @if (Model.DiscontinuedVariants?.Any() == true)
                                    {
                                        int vIdx = 0;
                                        foreach (var v in Model.DiscontinuedVariants)
                                        {
                                            <tr class="disc-variant-row" data-index="@vIdx">
                                                <td>
                                                    <strong>@(string.IsNullOrEmpty(v.Colour) ? "All Colours" : v.Colour)</strong>
                                                    <input type="hidden" name="DiscontinuedVariants[@vIdx].Colour" value="@v.Colour" />
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary">@(string.IsNullOrEmpty(v.Size) ? "All Sizes" : v.Size)</span>
                                                    <input type="hidden" name="DiscontinuedVariants[@vIdx].Size" value="@v.Size" />
                                                </td>
                                                <td class="text-muted small">
                                                    @(string.IsNullOrEmpty(v.Reason) ? "No reason specified" : v.Reason)
                                                    <input type="hidden" name="DiscontinuedVariants[@vIdx].Reason" value="@v.Reason" />
                                                </td>
                                                <td class="text-muted small">
                                                    @v.DiscontinuedDate.ToString("dd-MMM-yyyy")
                                                    <input type="hidden" name="DiscontinuedVariants[@vIdx].DiscontinuedDate" value="@v.DiscontinuedDate.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 remove-disc-variant" title="Restore this variant">
                                                        🗑️
                                                    </button>
                                                </td>
                                            </tr>
                                            vIdx++;
                                        }
                                    }
                                </tbody>
                            </table>
                            <div id="noDiscVariantsMsg" class="p-3 text-center text-muted small" style="@(Model.DiscontinuedVariants?.Any() == true ? "display:none;" : "")">
                                No variants currently discontinued for this design.
                            </div>
                        </div>
                    </div>

                    <!-- Process Master Creation Flow Section -->
                    <div class="card p-3 mb-3 border rounded-3 bg-light shadow-sm" id="creationFlowSection">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span>🔄</span> Creation Flow & Workflow Stages
                                </h6>
                                <small class="text-muted">Select production processes from Process Master. Pipeline sequence is strictly maintained order-wise.</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" id="btnSelectAllProcesses" style="font-size:0.75rem;">
                                    ✓ Select All
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btnClearProcesses" style="font-size:0.75rem;">
                                    ✕ Clear
                                </button>
                                <a asp-controller="ProcessMaster" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2 text-decoration-none" style="font-size:0.75rem;" title="Manage process definitions and sequence order">
                                    ⚙️ Manage Master
                                </a>
                            </div>
                        </div>

                        <!-- Checkbox pills sorted by ProcessMaster DisplayOrder -->
                        <div class="p-3 bg-white border rounded-3 mb-3">
                            <label class="form-label small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing:0.5px;">
                                Available Master Processes (In Sequence):
                            </label>
                            <div class="d-flex flex-wrap gap-2" id="processCheckboxesContainer">
                                @{
                                    var availableProcesses = ViewBag.Processes as List<AashanaFashion.Models.ProcessMaster> ?? new();
                                    var existingSteps = Model.GetCreationSteps();
                                }
                                @if (availableProcesses.Any())
                                {
                                    @foreach (var proc in availableProcesses)
                                    {
                                        bool isProcChecked = existingSteps.Any(s => string.Equals(s, proc.ProcessName, StringComparison.OrdinalIgnoreCase));
                                        <div class="form-check form-check-inline process-pill-check p-0 m-0">
                                            <input class="btn-check process-step-checkbox" type="checkbox" 
                                                   id="proc_@proc.Id" 
                                                   data-id="@proc.Id" 
                                                   data-name="@proc.ProcessName" 
                                                   data-code="@proc.ProcessCode" 
                                                   data-order="@proc.DisplayOrder" 
                                                   @(isProcChecked ? "checked" : "") />
                                            <label class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 px-3 py-1 rounded-pill" for="proc_@proc.Id">
                                                <span class="badge bg-white text-primary rounded-circle border font-monospace" style="font-size:0.7rem;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;">@proc.DisplayOrder</span>
                                                <span class="fw-semibold">@proc.ProcessName</span>
                                                @if (!string.IsNullOrEmpty(proc.ProcessCode))
                                                {
                                                    <span class="badge bg-light text-dark font-monospace" style="font-size:0.65rem;">@proc.ProcessCode</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small fst-italic py-1">
                                        No active processes found in Process Master. Configure processes in <a asp-controller="ProcessMaster" asp-action="Index" target="_blank">Process Master</a>.
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Live Pipeline Flow Preview -->
                        <div class="p-3 bg-white border rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-muted text-uppercase" style="letter-spacing:0.5px;">Live Workflow Flowchart:</span>
                                <span class="badge bg-success" id="processStepCountBadge">0 Steps</span>
                            </div>
                            <div id="creationFlowPipeline" class="d-flex flex-wrap align-items-center gap-2 p-2 bg-light rounded border" style="min-height:48px;">
                                <!-- Dynamically populated by JS -->
                            </div>
                        </div>

                        <!-- Bound hidden input for CreationFlow -->
                        <input type="hidden" asp-for="CreationFlow" id="creationFlowInput" />
                    </div>

                    <!-- Component & Process Vendor Assignment Matrix -->
                    <div class="card p-3 mb-3 border rounded-3 bg-light shadow-sm" id="componentMatrixCard">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                                    <span>🧩</span> Garment Components & Vendor Process Planning Matrix
                                </h6>
                                <small class="text-muted">Define all parts/components of this product and assign specific vendors/karigars for each creation process.</small>
                            </div>
                            <span class="badge bg-primary px-2 py-1" id="componentCountBadge">@Model.GetComponentsList().Count Components</span>
                        </div>

                        <!-- Components management bar -->
                        <div class="p-3 bg-white border rounded-3 mb-3">
                            <label class="form-label small fw-bold text-muted mb-2 text-uppercase" style="letter-spacing:0.5px;">
                                Product Components (Can have 3 or more parts):
                            </label>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2" id="componentBadgesContainer">
                                <!-- Badges dynamically rendered -->
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                                <span class="small text-muted fw-semibold me-1">Quick Add:</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Belt" style="font-size:0.75rem;">+ Belt</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Jacket" style="font-size:0.75rem;">+ Jacket / Shrug</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Inner" style="font-size:0.75rem;">+ Inner / Lining</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Cape" style="font-size:0.75rem;">+ Cape</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Koti" style="font-size:0.75rem;">+ Koti</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 quick-add-comp-btn" data-name="Stole" style="font-size:0.75rem;">+ Stole</button>
                                
                                <div class="input-group input-group-sm ms-auto" style="max-width:260px;">
                                    <input type="text" id="customComponentInput" class="form-control form-control-sm" placeholder="Custom component name..." />
                                    <button type="button" class="btn btn-primary btn-sm" id="btnAddCustomComponent">+ Add Part</button>
                                </div>
                            </div>
                            <input type="hidden" asp-for="Components" id="componentsHiddenInput" />
                        </div>

                        <!-- Matrix Table -->
                        <div class="table-responsive bg-white border rounded-3">
                            <table class="table table-bordered table-hover align-middle mb-0" id="componentMatrixTable">
                                <thead class="table-light">
                                    <tr id="matrixHeaderRow" style="font-size:0.82rem;">
                                        <th style="min-width:140px; background:#f1f5f9;">Component Part</th>
                                        <!-- Dynamic Process Columns injected here -->
                                        <th style="width:50px; text-align:center; background:#f1f5f9;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="matrixTableBody">
                                    <!-- Dynamic rows per component injected here -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Hidden fallback inputs for legacy compatibility -->
                        <input type="hidden" asp-for="StitchingWorkerId" id="fallbackStitchingWorkerId" />
                        <input type="hidden" asp-for="HandworkWorkerId" id="fallbackHandworkWorkerId" />
                        <input type="hidden" asp-for="HandworkCholi" id="fallbackHwCholi" />
                        <input type="hidden" asp-for="HandworkChaniya" id="fallbackHwChaniya" />
                        <input type="hidden" asp-for="HandworkDupatta" id="fallbackHwDupatta" />
                    </div>

                    <div class="af-form-group">
                        <label asp-for="InternalNotes" class="af-label">Internal Notes</label>
                        <textarea asp-for="InternalNotes" class="af-input" rows="3"></textarea>
                    </div>
                </div>

                <!-- ===== TAB 2: ATTRIBUTES & VARIANTS ===== -->
                <div class="tab-pane fade" id="attributes" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="attrTable">
                            <thead>
                                <tr>
                                    <th style="width:200px;">Attribute</th>
                                    <th style="width:300px;">Values</th>
                                    <th style="width:120px;">Colour Check</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="attrBody">
                                @{
                                    var ai = 0;
                                    foreach (var attr in Model.AttributeLines)
                                    {
                                        <tr class="attr-row">
                                            <td><input name="AttributeLines[@ai].Attribute" class="af-input" value="@attr.Attribute" /></td>
                                            <td><input name="AttributeLines[@ai].Values" class="af-input" value="@attr.Values" /></td>
                                            <td class="text-center"><input name="AttributeLines[@ai].ColourCheck" type="checkbox" value="true" checked="@(attr.ColourCheck ? "checked" : null)" /><input type="hidden" name="AttributeLines[@ai].ColourCheck" value="false" /></td>
                                            <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-attr-row">×</button></td>
                                        </tr>
                                        ai++;
                                    }
                                }
                                @if (!Model.AttributeLines.Any())
                                {
                                    <tr class="attr-row">
                                        <td><input name="AttributeLines[0].Attribute" class="af-input" placeholder="e.g. Size, Color" /></td>
                                        <td><input name="AttributeLines[0].Values" class="af-input" placeholder="e.g. S,M,L / Red,Blue" /></td>
                                        <td class="text-center"><input name="AttributeLines[0].ColourCheck" type="checkbox" value="true" /><input type="hidden" name="AttributeLines[0].ColourCheck" value="false" /></td>
                                        <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-attr-row" style="display:none;">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addAttrRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Attribute</button>
                </div>

                <!-- ===== TAB 3: SALES ===== -->
                <div class="tab-pane fade" id="sales" role="tabpanel">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="VisibilityOfProducts" class="af-label">Visibility Of Products</label>
                                <input asp-for="VisibilityOfProducts" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Website" class="af-label">Website</label>
                                <input asp-for="Website" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Tags" class="af-label">Tags</label>
                                <input asp-for="Tags" class="af-input" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Ribbon" class="af-label">Ribbon</label>
                                <input asp-for="Ribbon" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="OutOfStockMessage" class="af-label">Out-of-Stock Message</label>
                                <input asp-for="OutOfStockMessage" class="af-input" />
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-center" style="gap:1.5rem;padding-top:1.8rem;">
                            <label><input asp-for="IsPublished" /> Is Published</label>
                            <label><input asp-for="SellWhenOutOfStock" /> Sell when Out-of-Stock</label>
                            <label><input asp-for="ShowAvailableQty" /> Show Available Qty</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label">Re-Invoice Costs</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ReInvoiceCosts" value="" checked="@(string.IsNullOrEmpty(Model.ReInvoiceCosts))" /> No</label>
                                    <label><input type="radio" name="ReInvoiceCosts" value="At cost" checked="@(Model.ReInvoiceCosts == "At cost")" /> At cost</label>
                                    <label><input type="radio" name="ReInvoiceCosts" value="Sales price" checked="@(Model.ReInvoiceCosts == "Sales price")" /> Sales price</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="EcommerceDescription" class="af-label">Ecommerce Description</label>
                        <textarea asp-for="EcommerceDescription" class="af-input" rows="3"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="QuotationDescription" class="af-label">Quotation Description</label>
                        <textarea asp-for="QuotationDescription" class="af-input" rows="2"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="WarningOnSalesOrders" class="af-label">Warning On Sales Orders</label>
                        <textarea asp-for="WarningOnSalesOrders" class="af-input" rows="2"></textarea>
                    </div>

                    <!-- Packaging -->
                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />
                    <label class="af-label" style="font-weight:700;font-size:.95rem;">Packagings</label>
                    <div style="overflow-x:auto;margin-top:.5rem;">
                        <table class="af-table" id="pkgTable">
                            <thead>
                                <tr>
                                    <th style="width:200px;">Packaging Name</th>
                                    <th style="width:150px;">Quantity</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="pkgBody">
                                @{
                                    var pi = 0;
                                    foreach (var pkg in Model.Packagings)
                                    {
                                        <tr class="pkg-row">
                                            <td><input name="Packagings[@pi].PackagingName" class="af-input" value="@pkg.PackagingName" /></td>
                                            <td><input name="Packagings[@pi].Quantity" class="af-input" type="number" step="1" min="0" value="@pkg.Quantity" /></td>
                                            <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-pkg-row">×</button></td>
                                        </tr>
                                        pi++;
                                    }
                                }
                                @if (!Model.Packagings.Any())
                                {
                                    <tr class="pkg-row">
                                        <td><input name="Packagings[0].PackagingName" class="af-input" placeholder="Packaging" /></td>
                                        <td><input name="Packagings[0].Quantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                        <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-pkg-row" style="display:none;">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addPkgRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Packaging</button>
                </div>

                <!-- ===== TAB 4: PRICES ===== -->
                <div class="tab-pane fade" id="prices" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="priceTable">
                            <thead>
                                <tr>
                                    <th style="width:180px;">Pricelist</th>
                                    <th style="width:180px;">Applied On</th>
                                    <th style="width:150px;">Price (₹)</th>
                                    <th style="width:150px;">Min. Quantity</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="priceBody">
                                @{
                                    var pri = 0;
                                    foreach (var pl in Model.Pricelists)
                                    {
                                        <tr class="price-row">
                                            <td><input name="Pricelists[@pri].Pricelist" class="af-input" value="@pl.Pricelist" /></td>
                                            <td><input name="Pricelists[@pri].AppliedOn" class="af-input" value="@pl.AppliedOn" /></td>
                                            <td><input name="Pricelists[@pri].Price" class="af-input" type="number" step="0.01" min="0" value="@pl.Price" /></td>
                                            <td><input name="Pricelists[@pri].MinQuantity" class="af-input" type="number" step="1" min="0" value="@pl.MinQuantity" /></td>
                                            <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-price-row">×</button></td>
                                        </tr>
                                        pri++;
                                    }
                                }
                                @if (!Model.Pricelists.Any())
                                {
                                    <tr class="price-row">
                                        <td><input name="Pricelists[0].Pricelist" class="af-input" placeholder="Pricelist name" /></td>
                                        <td><input name="Pricelists[0].AppliedOn" class="af-input" placeholder="e.g. Product, Category" /></td>
                                        <td><input name="Pricelists[0].Price" class="af-input" type="number" step="0.01" min="0" value="0" /></td>
                                        <td><input name="Pricelists[0].MinQuantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                        <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-price-row" style="display:none;">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addPriceRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Pricelist</button>
                </div>

                <!-- ===== TAB 5: PURCHASE ===== -->
                <div class="tab-pane fade" id="purchase" role="tabpanel">
                    <div style="overflow-x:auto;">
                        <table class="af-table" id="vendorTable">
                            <thead>
                                <tr>
                                    <th style="width:180px;">Vendor</th>
                                    <th style="width:100px;">Quantity</th>
                                    <th style="width:100px;">Unit</th>
                                    <th style="width:120px;">Unit Price (₹)</th>
                                    <th style="width:100px;">Lead Time (Days)</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody id="vendorBody">
                                @{
                                    var vi = 0;
                                    foreach (var pv in Model.ProductVendors)
                                    {
                                        <tr class="vendor-row">
                                            <td>
                                                <select name="ProductVendors[@vi].VendorId" class="af-input af-select">
                                                    <option value="">— Select —</option>
                                                    @foreach (var v in vendors)
                                                    {
                                                        <option value="@v.Id" selected="@(pv.VendorId == v.Id ? "selected" : null)">@v.VendorName</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input name="ProductVendors[@vi].Quantity" class="af-input" type="number" step="1" min="0" value="@pv.Quantity" /></td>
                                            <td>
                                                <select name="ProductVendors[@vi].Unit" class="af-input af-select">
                                                    <option value="Piece" selected="@(pv.Unit == "Piece" ? "selected" : null)">Piece</option>
                                                    <option value="Meter" selected="@(pv.Unit == "Meter" ? "selected" : null)">Meter</option>
                                                </select>
                                            </td>
                                            <td><input name="ProductVendors[@vi].UnitPrice" class="af-input" type="number" step="0.01" min="0" value="@pv.UnitPrice" /></td>
                                            <td><input name="ProductVendors[@vi].LeadTime" class="af-input" type="number" min="0" value="@pv.LeadTime" /></td>
                                            <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-vendor-row">×</button></td>
                                        </tr>
                                        vi++;
                                    }
                                }
                                @if (!Model.ProductVendors.Any())
                                {
                                    <tr class="vendor-row">
                                        <td>
                                            <select name="ProductVendors[0].VendorId" class="af-input af-select">
                                                <option value="">— Select —</option>
                                                @foreach (var v in vendors)
                                                {
                                                    <option value="@v.Id">@v.VendorName</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input name="ProductVendors[0].Quantity" class="af-input" type="number" step="1" min="0" value="1" /></td>
                                        <td>
                                            <select name="ProductVendors[0].Unit" class="af-input af-select">
                                                <option value="Piece">Piece</option>
                                                <option value="Meter">Meter</option>
                                            </select>
                                        </td>
                                        <td><input name="ProductVendors[0].UnitPrice" class="af-input" type="number" step="0.01" min="0" value="0" /></td>
                                        <td><input name="ProductVendors[0].LeadTime" class="af-input" type="number" min="0" value="0" /></td>
                                        <td><button type="button" class="btn-af btn-af-danger btn-af-sm remove-vendor-row" style="display:none;">×</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" id="addVendorRow" class="btn-af btn-af-ghost btn-af-sm mt-2">+ Add Vendor</button>

                    <hr style="margin:1rem 0;border-color:#e2e8f0;" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="af-form-group">
                                <label class="af-label">Control Policy</label>
                                <div style="display:flex;gap:1rem;padding:.5rem 0;">
                                    <label><input type="radio" name="ControlPolicy" value="On ordered quantities" checked="@(Model.ControlPolicy == "On ordered quantities")" /> On ordered quantities</label>
                                    <label><input type="radio" name="ControlPolicy" value="On received quantities" checked="@(Model.ControlPolicy == "On received quantities")" /> On received quantities</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="PurchaseDescription" class="af-label">Purchase Description</label>
                        <textarea asp-for="PurchaseDescription" class="af-input" rows="2"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="WarningOnPurchaseOrders" class="af-label">Warning On Purchase Orders</label>
                        <textarea asp-for="WarningOnPurchaseOrders" class="af-input" rows="2"></textarea>
                    </div>
                </div>

                <!-- ===== TAB 6: INVENTORY ===== -->
                <div class="tab-pane fade" id="inventory" role="tabpanel">
                    <div class="af-form-group">
                        <label class="af-label">Routes</label>
                        <div style="display:flex;flex-wrap:wrap;gap:1rem;padding:.5rem 0;">
                            <label><input asp-for="RouteBuy" /> Buy</label>
                            <label><input asp-for="RouteManufacture" /> Manufacture</label>
                            <label><input asp-for="RouteResupplySubcontractor" /> Aashana: Resupply Subcontractor</label>
                            <label><input asp-for="RouteResupplySubcontractorOnOrder" /> Resupply Subcontractor on Order</label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="Responsible" class="af-label">Responsible</label>
                                <select asp-for="Responsible" class="af-input af-select">
                                    <option value="">— Select Responsible User —</option>
                                    @if (ViewBag.Users != null)
                                    {
                                        foreach (var u in (List<AashanaFashion.Models.AppUser>)ViewBag.Users)
                                        {
                                            if (Model.Responsible == u.FullName)
                                            {
                                                <option value="@u.FullName" selected>@u.FullName (@u.Role)</option>
                                            }
                                            else
                                            {
                                                <option value="@u.FullName">@u.FullName (@u.Role)</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="CustomerLeadTime" class="af-label">Customer Lead Time (Days)</label>
                                <input asp-for="CustomerLeadTime" class="af-input" type="number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="af-form-group">
                                <label asp-for="SafetyFactor" class="af-label">Safety Factor</label>
                                <input asp-for="SafetyFactor" class="af-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForReceipts" class="af-label">Description For Receipts</label>
                        <textarea asp-for="DescriptionForReceipts" class="af-input" rows="2"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForInternalTransfers" class="af-label">Description For Internal Transfers</label>
                        <textarea asp-for="DescriptionForInternalTransfers" class="af-input" rows="2"></textarea>
                    </div>

                    <div class="af-form-group">
                        <label asp-for="DescriptionForDeliveryOrders" class="af-label">Description For Delivery Orders</label>
                        <textarea asp-for="DescriptionForDeliveryOrders" class="af-input" rows="2"></textarea>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="display:flex;gap:.75rem;margin-top:1rem;">
        <button type="submit" class="btn-af btn-af-primary">Save Changes</button>
        <a asp-action="Index" class="btn-af btn-af-ghost">Cancel</a>
    </div>
</form>

<!-- Quick Create Category Modal -->
<div class="modal fade" id="quickCategoryModal" tabindex="-1" aria-labelledby="quickCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2">
                <h6 class="modal-title fw-bold" id="quickCategoryModalLabel">🗂️ Quick Create Category</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="quickCatError" class="alert alert-danger py-1 px-2 small d-none"></div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Category Name <span class="text-danger">*</span></label>
                    <input type="text" id="quickCategoryName" class="form-control form-control-sm" placeholder="e.g. Kurtis, Sarees" required />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">Short Code</label>
                        <input type="text" id="quickCategoryCode" class="form-control form-control-sm text-uppercase" placeholder="e.g. KRT" maxlength="10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold mb-1">Default HSN/SAC</label>
                        <input type="text" id="quickDefaultHsn" class="form-control form-control-sm font-monospace" placeholder="e.g. 6204" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Default GST Rate</label>
                    <select id="quickDefaultGst" class="form-select form-select-sm">
                        <option value="5.00">5% (Standard Apparel)</option>
                        <option value="12.00">12% (Luxury Apparel)</option>
                        <option value="18.00">18% (Specialized / Synthetics)</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold mb-1">Description (Optional)</label>
                    <textarea id="quickCategoryDesc" class="form-control form-control-sm" rows="2" placeholder="Notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveQuickCategoryBtn" class="btn btn-sm btn-primary px-3">Create Category</button>
            </div>
        </div>
    </div>
</div>

<!-- Configure Extra Charges (Colour & Size) Modal -->
<div class="modal fade" id="extraChargesModal" tabindex="-1" aria-labelledby="extraChargesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light py-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5">⚙️</span>
                    <h6 class="modal-title fw-bold" id="extraChargesModalLabel">Configure Variant Extra Charges (Colour & Size)</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="alert alert-info py-2 px-3 small mb-3">
                    💡 Specify extra charges (surcharges in ₹) for specific colours or sizes (e.g. plus sizes or intricate dye colours). These surcharges will automatically reflect when creating Sales Orders, calculating pricelists, and generating invoices.
                </div>

                <ul class="nav nav-pills mb-3" id="extraChargesTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-1 px-3 small fw-semibold" id="colour-charges-tab" data-bs-toggle="pill" data-bs-target="#colour-charges-pane" type="button" role="tab">🎨 Colour Extra Charges</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-1 px-3 small fw-semibold" id="size-charges-tab" data-bs-toggle="pill" data-bs-target="#size-charges-pane" type="button" role="tab">📏 Size Extra Charges</button>
                    </li>
                </ul>

                <div class="tab-content" id="extraChargesTabContent">
                    <!-- Colour Tab -->
                    <div class="tab-pane fade show active" id="colour-charges-pane" role="tabpanel">
                        <div id="noColoursWarning" class="text-muted small py-2 d-none">No colours are selected yet. Please check colours in the product form first.</div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle mb-0" id="colourChargesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Colour Name</th>
                                        <th style="width: 30%;">Extra Charge (₹)</th>
                                        <th style="width: 35%;">Remarks (Optional)</th>
                                    </tr>
                                </thead>
                                <tbody id="colourChargesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Size Tab -->
                    <div class="tab-pane fade" id="size-charges-pane" role="tabpanel">
                        <div id="noSizesWarning" class="text-muted small py-2 d-none">No sizes are selected yet. Please check sizes in the product form first.</div>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle mb-0" id="sizeChargesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 35%;">Size</th>
                                        <th style="width: 30%;">Extra Charge (₹)</th>
                                        <th style="width: 35%;">Remarks (Optional)</th>
                                    </tr>
                                </thead>
                                <tbody id="sizeChargesBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Live Preview Matrix -->
                <div class="card border-0 bg-light p-2 mt-3 rounded-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small fw-semibold text-dark">Price Calculation Preview:</span>
                        <span id="previewCalculationText" class="small text-primary fw-bold">Base Price: ₹0.00</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="applyExtraChargesBtn" class="btn btn-sm btn-primary px-3">Apply Extra Charges</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/product.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const catSelect = document.getElementById('productCategorySelect');
        const catHidden = document.getElementById('categoryNameHidden');
        const hsnInput = document.getElementById('HsnSacCode');

        catSelect?.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            if (opt && opt.value) {
                if (catHidden) catHidden.value = opt.text.trim();
                const hsn = opt.getAttribute('data-hsn');
                if (hsn && hsnInput) {
                    hsnInput.value = hsn;
                }
            } else {
                if (catHidden) catHidden.value = '';
            }
        });

        document.getElementById('saveQuickCategoryBtn')?.addEventListener('click', function () {
            const nameInput = document.getElementById('quickCategoryName');
            const codeInput = document.getElementById('quickCategoryCode');
            const hsnInputEl = document.getElementById('quickDefaultHsn');
            const gstInput = document.getElementById('quickDefaultGst');
            const descInput = document.getElementById('quickCategoryDesc');
            const errDiv = document.getElementById('quickCatError');

            const name = nameInput?.value?.trim();
            if (!name) {
                if (errDiv) {
                    errDiv.textContent = 'Category Name is required.';
                    errDiv.classList.remove('d-none');
                }
                return;
            }

            const payload = {
                categoryName: name,
                categoryCode: codeInput?.value?.trim() || null,
                defaultHsnCode: hsnInputEl?.value?.trim() || null,
                defaultGstRate: parseFloat(gstInput?.value) || 5.0,
                description: descInput?.value?.trim() || null
            };

            this.disabled = true;
            this.textContent = 'Saving...';

            fetch('/Category/QuickCreate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    let option = catSelect.querySelector(`option[value="${data.id}"]`);
                    if (!option) {
                        option = document.createElement('option');
                        option.value = data.id;
                        option.textContent = data.code ? `${data.name} (${data.code})` : data.name;
                        option.setAttribute('data-hsn', data.hsn || '');
                        option.setAttribute('data-gst', data.gst || '');
                        catSelect.appendChild(option);
                    }
                    catSelect.value = data.id;
                    catSelect.dispatchEvent(new Event('change'));

                    const modalEl = document.getElementById('quickCategoryModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modalInstance.hide();

                    nameInput.value = '';
                    if (codeInput) codeInput.value = '';
                    if (hsnInputEl) hsnInputEl.value = '';
                    if (descInput) descInput.value = '';
                    if (errDiv) errDiv.classList.add('d-none');
                } else {
                    if (errDiv) {
                        errDiv.textContent = data.message || 'Error creating category.';
                        errDiv.classList.remove('d-none');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (errDiv) {
                    errDiv.textContent = 'Server error occurred.';
                    errDiv.classList.remove('d-none');
                }
            })
            .finally(() => {
                this.disabled = false;
                this.textContent = 'Create Category';
            });
        });

        // Extra charges handling
        const extraChargesStore = {
            'Colour': {},
            'Size': {}
        };

        @if (Model.ExtraCharges != null && Model.ExtraCharges.Any())
        {
            foreach (var ec in Model.ExtraCharges)
            {
                <text>
                if (!extraChargesStore['@ec.AttributeType']) extraChargesStore['@ec.AttributeType'] = {};
                extraChargesStore['@ec.AttributeType']['@Html.Raw(ec.AttributeValue)'] = { charge: @ec.ExtraCharge, remarks: '@Html.Raw(ec.Remarks ?? "")' };
                </text>
            }
        }

        const extraChargesModalEl = document.getElementById('extraChargesModal');
        const colourChargesBody = document.getElementById('colourChargesBody');
        const sizeChargesBody = document.getElementById('sizeChargesBody');
        const noColoursWarning = document.getElementById('noColoursWarning');
        const noSizesWarning = document.getElementById('noSizesWarning');
        const previewCalculationText = document.getElementById('previewCalculationText');
        const extraChargesHiddenInputs = document.getElementById('extraChargesHiddenInputs');
        const extraChargesSummaryRow = document.getElementById('extraChargesSummaryRow');
        const extraChargesSummaryText = document.getElementById('extraChargesSummaryText');

        function updatePreviewText() {
            const baseRate = parseFloat(document.getElementById('SalesPrice')?.value) || parseFloat(document.getElementById('Price')?.value) || 0;
            let maxColourExtra = 0;
            let maxColourName = '';
            for (const c in extraChargesStore['Colour']) {
                if (extraChargesStore['Colour'][c].charge > maxColourExtra) {
                    maxColourExtra = extraChargesStore['Colour'][c].charge;
                    maxColourName = c;
                }
            }
            let maxSizeExtra = 0;
            let maxSizeName = '';
            for (const s in extraChargesStore['Size']) {
                if (extraChargesStore['Size'][s].charge > maxSizeExtra) {
                    maxSizeExtra = extraChargesStore['Size'][s].charge;
                    maxSizeName = s;
                }
            }
            if (maxColourExtra > 0 || maxSizeExtra > 0) {
                let formula = `Base: ₹${baseRate.toFixed(2)}`;
                if (maxColourExtra > 0) formula += ` + Colour (${maxColourName}): ₹${maxColourExtra.toFixed(2)}`;
                if (maxSizeExtra > 0) formula += ` + Size (${maxSizeName}): ₹${maxSizeExtra.toFixed(2)}`;
                formula += ` = Total: ₹${(baseRate + maxColourExtra + maxSizeExtra).toFixed(2)}`;
                previewCalculationText.textContent = formula;
            } else {
                previewCalculationText.textContent = `Base Price: ₹${baseRate.toFixed(2)} (No active surcharges)`;
            }
        }

        extraChargesModalEl?.addEventListener('show.bs.modal', function () {
            const checkedColours = Array.from(document.querySelectorAll('.colour-checkbox:checked'));
            colourChargesBody.innerHTML = '';
            if (checkedColours.length === 0) {
                noColoursWarning.classList.remove('d-none');
            } else {
                noColoursWarning.classList.add('d-none');
                checkedColours.forEach(cb => {
                    const name = cb.getAttribute('data-name');
                    const code = cb.getAttribute('data-code');
                    const existing = extraChargesStore['Colour'][name] || { charge: 0, remarks: '' };
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                ${code ? `<span style="display:inline-block;width:14px;height:14px;border-radius:50%;background-color:${code};border:1px solid #ccc;"></span>` : ''}
                                <span class="fw-semibold text-dark">${name}</span>
                            </div>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end ec-colour-charge" data-name="${name}" value="${existing.charge > 0 ? existing.charge.toFixed(2) : '0.00'}" />
                            </div>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm ec-colour-remarks" data-name="${name}" placeholder="e.g. Special dye" value="${existing.remarks || ''}" />
                        </td>
                    `;
                    colourChargesBody.appendChild(tr);
                });
            }

            const checkedSizes = Array.from(document.querySelectorAll('.size-checkbox:checked'));
            sizeChargesBody.innerHTML = '';
            if (checkedSizes.length === 0) {
                noSizesWarning.classList.remove('d-none');
            } else {
                noSizesWarning.classList.add('d-none');
                checkedSizes.forEach(cb => {
                    const name = cb.getAttribute('data-name');
                    const existing = extraChargesStore['Size'][name] || { charge: 0, remarks: '' };
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">${name}</span>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end ec-size-charge" data-name="${name}" value="${existing.charge > 0 ? existing.charge.toFixed(2) : '0.00'}" />
                            </div>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm ec-size-remarks" data-name="${name}" placeholder="e.g. Plus size fabric" value="${existing.remarks || ''}" />
                        </td>
                    `;
                    sizeChargesBody.appendChild(tr);
                });
            }

            updatePreviewText();
        });

        extraChargesModalEl?.addEventListener('input', function (e) {
            if (e.target.classList.contains('ec-colour-charge')) {
                const name = e.target.getAttribute('data-name');
                if (!extraChargesStore['Colour'][name]) extraChargesStore['Colour'][name] = {};
                extraChargesStore['Colour'][name].charge = parseFloat(e.target.value) || 0;
                updatePreviewText();
            }
            if (e.target.classList.contains('ec-size-charge')) {
                const name = e.target.getAttribute('data-name');
                if (!extraChargesStore['Size'][name]) extraChargesStore['Size'][name] = {};
                extraChargesStore['Size'][name].charge = parseFloat(e.target.value) || 0;
                updatePreviewText();
            }
        });

        function syncHiddenInputsAndBadge() {
            extraChargesHiddenInputs.innerHTML = '';
            let count = 0;
            const summaryParts = [];
            let idx = 0;

            for (const type of ['Colour', 'Size']) {
                for (const val in extraChargesStore[type]) {
                    const item = extraChargesStore[type][val];
                    if (item.charge > 0) {
                        count++;
                        summaryParts.push(`${val} (+₹${item.charge.toFixed(2)})`);

                        extraChargesHiddenInputs.innerHTML += `
                            <input type="hidden" name="ExtraCharges[${idx}].AttributeType" value="${type}" />
                            <input type="hidden" name="ExtraCharges[${idx}].AttributeValue" value="${val}" />
                            <input type="hidden" name="ExtraCharges[${idx}].ExtraCharge" value="${item.charge}" />
                            <input type="hidden" name="ExtraCharges[${idx}].Remarks" value="${item.remarks || ''}" />
                        `;
                        idx++;
                    }
                }
            }

            if (count > 0) {
                extraChargesSummaryText.textContent = `${count} surcharge(s) active: ${summaryParts.join(', ')}`;
                extraChargesSummaryRow.style.display = '';
            } else {
                extraChargesSummaryRow.style.display = 'none';
            }
        }

        document.getElementById('applyExtraChargesBtn')?.addEventListener('click', function () {
            document.querySelectorAll('.ec-colour-charge').forEach(input => {
                const name = input.getAttribute('data-name');
                const charge = parseFloat(input.value) || 0;
                const remarks = document.querySelector(`.ec-colour-remarks[data-name="${name}"]`)?.value || '';
                extraChargesStore['Colour'][name] = { charge, remarks };
            });

            document.querySelectorAll('.ec-size-charge').forEach(input => {
                const name = input.getAttribute('data-name');
                const charge = parseFloat(input.value) || 0;
                const remarks = document.querySelector(`.ec-size-remarks[data-name="${name}"]`)?.value || '';
                extraChargesStore['Size'][name] = { charge, remarks };
            });

            syncHiddenInputsAndBadge();

            const modalInstance = bootstrap.Modal.getInstance(extraChargesModalEl) || new bootstrap.Modal(extraChargesModalEl);
            modalInstance.hide();
        });

        // Initialize existing charges badge on load
        syncHiddenInputsAndBadge();

        // Live preview for design photo input
        $('#designPhotoInput').on('change', function(e) {
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(evt) {
                    $('#designPhotoPreview').attr('src', evt.target.result);
                    $('#removePhotoInput').val('false');
                };
                reader.readAsDataURL(file);
            }
        });

        // Colour-wise photos management
        var existingColourImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (Model.ColourImages ?? new List<AashanaFashion.Models.DesignColourImage>()).Select(ci => new { id = ci.Id, colour = ci.Colour, code = ci.ColourCode, photoPath = ci.PhotoPath })
        ));

        function sanitizeColourKey(str) {
            return (str || '').replace(/[^a-zA-Z0-9]/g, '_');
        }

        function updateColourPhotoCards() {
            var checkedColours = [];
            $('.colour-checkbox:checked').each(function() {
                checkedColours.push({
                    id: $(this).val(),
                    name: $(this).data('name'),
                    code: $(this).data('code') || ''
                });
            });

            if (checkedColours.length === 0) {
                $('#noColoursSelectedMsg').show();
                $('#colourPhotosGrid').hide();
                $('#selectedColourCountBadge').text('0 Photos');
                return;
            }

            $('#noColoursSelectedMsg').hide();
            $('#colourPhotosGrid').show();

            // Collect existing cards to avoid wiping file inputs
            var existingCards = {};
            $('.colour-photo-card').each(function() {
                var col = $(this).data('colour');
                existingCards[col] = $(this);
            });

            // Remove cards for unchecked colours
            for (var col in existingCards) {
                var stillChecked = checkedColours.some(function(c) { return c.name.toLowerCase() === col.toLowerCase(); });
                if (!stillChecked) {
                    existingCards[col].remove();
                }
            }

            // Append cards for newly checked colours
            checkedColours.forEach(function(c) {
                var key = sanitizeColourKey(c.name);
                if ($('#card_colour_' + key).length === 0) {
                    var swatchHtml = c.code ? `<span style="display:inline-block; width:14px; height:14px; border-radius:50%; background-color:${c.code}; border:1px solid #cbd5e1;"></span>` : '';
                    var cardHtml = `
                        <div class="col-md-6 col-lg-4 colour-photo-card" id="card_colour_${key}" data-colour="${c.name}">
                            <div class="card h-100 border shadow-sm rounded-3 p-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        ${swatchHtml}
                                        <strong class="fs-6 text-dark">${c.name}</strong>
                                    </div>
                                    <span class="badge bg-primary text-white" id="badge_count_${key}">0 Photos</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mb-2 p-2 bg-light rounded border align-items-center" id="gallery_${key}" style="min-height: 80px;">
                                    <div class="text-muted small w-100 text-center py-2" id="hint_${key}">
                                        <em>No photos for ${c.name}</em>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 align-items-center mt-auto pt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1 py-1" onclick="addColourPhotos('${key}', '${c.name}')">
                                        <span>📷</span> + Add Photos (Multiple)
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Clear all photos for this colour" onclick="clearAllColourPhotos('${key}', '${c.name}')">
                                        ✕
                                    </button>
                                </div>
                                <div id="file_inputs_${key}" class="d-none"></div>
                            </div>
                        </div>
                    `;
                    $('#colourPhotosGrid').append(cardHtml);

                    // Pre-fill existing photos from database
                    var existingForColour = (existingColourImages || []).filter(function(item) {
                        return item.colour.toLowerCase() === c.name.toLowerCase();
                    });
                    if (existingForColour.length > 0) {
                        $('#hint_' + key).hide();
                        existingForColour.forEach(function(img) {
                            var tileHtml = `
                                <div class="position-relative d-inline-block rounded border bg-white shadow-sm overflow-hidden colour-thumb-tile" id="existing_thumb_${img.id}" style="width: 68px; height: 68px;">
                                    <img src="${img.photoPath}" class="w-100 h-100 object-fit-cover" onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" />
                                    <span class="position-absolute bottom-0 start-0 badge bg-secondary" style="font-size: 0.6rem; border-top-right-radius: 4px; padding: 1px 3px;">Saved</span>
                                    <button type="button" class="btn btn-danger btn-sm p-0 position-absolute top-0 end-0 rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 18px; height: 18px; font-size: 10px; margin: 2px;" onclick="removeExistingColourPhoto(${img.id}, '${key}')" title="Delete photo">
                                        ✕
                                    </button>
                                </div>`;
                            $('#gallery_' + key).append(tileHtml);
                        });
                        updateColourThumbCount(key);
                    }
                }
            });
            updateOverallPhotoCount();
        }

        $('.colour-checkbox').on('change', updateColourPhotoCards);
        updateColourPhotoCards();
    });

    window.removeExistingColourPhoto = function(imgId, key) {
        $('#existing_thumb_' + imgId).remove();
        $('#deletedPhotosContainer').append('<input type="hidden" name="deletedColourImageIds" value="' + imgId + '" />');
        updateColourThumbCount(key);
    };

    window.addColourPhotos = function(key, colourName) {
        var picker = document.createElement('input');
        picker.type = 'file';
        picker.multiple = true;
        picker.accept = 'image/*';
        picker.onchange = function(e) {
            if (!picker.files || picker.files.length === 0) return;
            $('#hint_' + key).hide();
            Array.from(picker.files).forEach(function(file) {
                var inputId = 'file_' + key + '_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
                var thumbId = 'thumb_' + inputId;

                var hiddenInput = document.createElement('input');
                hiddenInput.type = 'file';
                hiddenInput.name = 'colourPhotos_' + colourName;
                hiddenInput.id = inputId;
                try {
                    var dt = new DataTransfer();
                    dt.items.add(file);
                    hiddenInput.files = dt.files;
                } catch(err) {}
                document.getElementById('file_inputs_' + key).appendChild(hiddenInput);

                var reader = new FileReader();
                reader.onload = function(evt) {
                    var tileHtml = `
                        <div class="position-relative d-inline-block rounded border bg-white shadow-sm overflow-hidden colour-thumb-tile" id="${thumbId}" style="width: 68px; height: 68px;">
                            <img src="${evt.target.result}" class="w-100 h-100 object-fit-cover" />
                            <span class="position-absolute bottom-0 start-0 badge bg-dark bg-opacity-75" style="font-size: 0.6rem; border-top-right-radius: 4px; padding: 1px 3px;">New</span>
                            <button type="button" class="btn btn-danger btn-sm p-0 position-absolute top-0 end-0 rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 18px; height: 18px; font-size: 10px; margin: 2px;" onclick="removeNewColourPhoto('${thumbId}', '${inputId}', '${key}')" title="Remove photo">
                                ✕
                            </button>
                        </div>`;
                    $('#gallery_' + key).append(tileHtml);
                    updateColourThumbCount(key);
                };
                reader.readAsDataURL(file);
            });
        };
        picker.click();
    };

    window.removeNewColourPhoto = function(thumbId, inputId, key) {
        $('#' + thumbId).remove();
        $('#' + inputId).remove();
        updateColourThumbCount(key);
    };

    window.clearAllColourPhotos = function(key, colourName) {
        $('#gallery_' + key + ' [id^="existing_thumb_"]').each(function() {
            var id = this.id.replace('existing_thumb_', '');
            $('#deletedPhotosContainer').append('<input type="hidden" name="deletedColourImageIds" value="' + id + '" />');
        });
        $('#gallery_' + key + ' .colour-thumb-tile').remove();
        $('#file_inputs_' + key).empty();
        $('#hint_' + key).show();
        updateColourThumbCount(key);
    };

    function updateColourThumbCount(key) {
        var count = $('#gallery_' + key + ' .colour-thumb-tile').length;
        $('#badge_count_' + key).text(count + (count === 1 ? ' Photo' : ' Photos'));
        if (count === 0) {
            $('#hint_' + key).show();
        } else {
            $('#hint_' + key).hide();
        }
        updateOverallPhotoCount();
    }

    function updateOverallPhotoCount() {
        var total = $('.colour-thumb-tile').length;
        $('#selectedColourCountBadge').text(total + (total === 1 ? ' Photo' : ' Photos'));
    }

    // ——— Discontinued Variants Manager ———
    function updateDiscVariantIndices() {
        var rows = $('#discVariantsBody tr');
        rows.each(function(idx) {
            $(this).find('input[name*=".Colour"]').attr('name', 'DiscontinuedVariants[' + idx + '].Colour');
            $(this).find('input[name*=".Size"]').attr('name', 'DiscontinuedVariants[' + idx + '].Size');
            $(this).find('input[name*=".Reason"]').attr('name', 'DiscontinuedVariants[' + idx + '].Reason');
            $(this).find('input[name*=".DiscontinuedDate"]').attr('name', 'DiscontinuedVariants[' + idx + '].DiscontinuedDate');
        });
        var count = rows.length;
        $('#discontinuedVariantCountBadge').text(count + ' Discontinued');
        if (count === 0) {
            $('#noDiscVariantsMsg').show();
        } else {
            $('#noDiscVariantsMsg').hide();
        }
    }

    $(document).on('click', '#btnAddDiscVariant', function() {
        var col = $('#discColourSelect').val() || '';
        var sz = $('#discSizeSelect').val() || '';
        var reason = $('#discReasonInput').val() || '';

        if (!col && !sz) {
            alert('Please select either a Colour, a Size, or both to discontinue a specific variant. To discontinue the entire product, use the "Discontinue Whole Product" checkbox under General Information.');
            return;
        }

        // Check if identical rule already exists
        var exists = false;
        $('#discVariantsBody tr').each(function() {
            var existingCol = $(this).find('input[name*=".Colour"]').val() || '';
            var existingSz = $(this).find('input[name*=".Size"]').val() || '';
            if (existingCol.toLowerCase() === col.toLowerCase() && existingSz.toLowerCase() === sz.toLowerCase()) {
                exists = true;
                return false;
            }
        });

        if (exists) {
            alert('This variant combination is already in the discontinued list.');
            return;
        }

        var nextIdx = $('#discVariantsBody tr').length;
        var colDisplay = col ? '<strong>' + col + '</strong>' : '<span class="text-muted fst-italic">All Colours</span>';
        var szDisplay = sz ? '<span class="badge bg-secondary">' + sz + '</span>' : '<span class="badge bg-light text-dark border">All Sizes</span>';
        var reasonDisplay = reason ? reason : '<span class="text-muted fst-italic">No reason specified</span>';
        var now = new Date();
        var dateFormatted = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        var isoDate = now.toISOString();

        var rowHtml = `
        <tr class="disc-variant-row">
            <td>
                ${colDisplay}
                <input type="hidden" name="DiscontinuedVariants[${nextIdx}].Colour" value="${col}" />
            </td>
            <td>
                ${szDisplay}
                <input type="hidden" name="DiscontinuedVariants[${nextIdx}].Size" value="${sz}" />
            </td>
            <td class="text-muted small">
                ${reasonDisplay}
                <input type="hidden" name="DiscontinuedVariants[${nextIdx}].Reason" value="${reason}" />
            </td>
            <td class="text-muted small">
                ${dateFormatted}
                <input type="hidden" name="DiscontinuedVariants[${nextIdx}].DiscontinuedDate" value="${isoDate}" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 remove-disc-variant" title="Restore this variant">
                    🗑️
                </button>
            </td>
        </tr>`;

        $('#discVariantsBody').append(rowHtml);
        $('#discReasonInput').val('');
        updateDiscVariantIndices();
    });

    $(document).on('click', '.remove-disc-variant', function() {
        $(this).closest('tr').remove();
        updateDiscVariantIndices();
    });

    // ===== COMPONENT & PROCESS VENDOR MATRIX =====
    var allVendors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((List<AashanaFashion.Models.Vendor>)(ViewBag.Vendors ?? new List<AashanaFashion.Models.Vendor>())).Select(v => new { id = v.Id, name = v.VendorName })));
    var componentsList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GetComponentsList()));
    var existingAssignments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.ComponentAssignments ?? new List<AashanaFashion.Models.DesignComponentAssignment>()).Select(a => new { componentName = a.ComponentName, processName = a.ProcessName, vendorId = a.VendorId, estimatedRate = a.EstimatedRate })));
    
    var matrixState = {}; // key: comp + '___' + proc -> { vendorId, rate }
    if (existingAssignments && existingAssignments.length > 0) {
        existingAssignments.forEach(function(a) {
            matrixState[a.componentName + '___' + a.processName] = { vendorId: a.vendorId, rate: a.estimatedRate };
        });
    } else {
        // Fallback pre-fill from legacy workers if no component assignments exist yet
        var legacyHw = '@Model.HandworkWorkerId';
        var legacySt = '@Model.StitchingWorkerId';
        if (legacySt) {
            componentsList.forEach(function(c) {
                matrixState[c + '___Stitching'] = { vendorId: legacySt, rate: '' };
            });
        }
        if (legacyHw) {
            @if (Model.HandworkCholi) { <text>matrixState['Choli___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
            @if (Model.HandworkChaniya) { <text>matrixState['Chaniya___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
            @if (Model.HandworkDupatta) { <text>matrixState['Dupatta___Handwork'] = { vendorId: legacyHw, rate: '' };</text> }
        }
    }

    function getActiveProcesses() {
        var procs = [];
        $('.process-step-checkbox:checked').each(function() {
            procs.push({
                id: $(this).data('id'),
                name: $(this).data('name'),
                order: parseInt($(this).data('order') || 0)
            });
        });
        procs.sort(function(a, b) { return a.order - b.order; });
        return procs;
    }

    function renderComponentBadges() {
        var html = '';
        componentsList.forEach(function(comp) {
            var icon = '🧵';
            var clow = comp.toLowerCase();
            if (clow.includes('chaniya') || clow.includes('lehenga') || clow.includes('skirt')) icon = '👗';
            else if (clow.includes('choli') || clow.includes('blouse') || clow.includes('top')) icon = '👚';
            else if (clow.includes('dupatta') || clow.includes('chunri') || clow.includes('scarf')) icon = '🧣';
            else if (clow.includes('jacket') || clow.includes('shrug') || clow.includes('koti')) icon = '🧥';
            else if (clow.includes('belt')) icon = '🎗️';
            else if (clow.includes('inner') || clow.includes('lining')) icon = '🩱';
            else if (clow.includes('cape')) icon = '✨';

            html += `
                <span class="badge bg-white text-dark border shadow-sm p-2 d-inline-flex align-items-center gap-2">
                    <span>${icon}</span>
                    <span class="fw-semibold">${comp}</span>
                    <button type="button" class="btn-close btn-close-sm remove-component-btn" data-name="${comp}" title="Remove component" style="font-size:0.65rem;"></button>
                </span>
            `;
        });
        $('#componentBadgesContainer').html(html);
        $('#componentsHiddenInput').val(componentsList.join(', '));
        $('#componentCountBadge').text(componentsList.length + (componentsList.length === 1 ? ' Component' : ' Components'));
    }

    function renderMatrixTable() {
        var procs = getActiveProcesses();
        var thead = '<th style="min-width:140px; background:#f1f5f9;">Component Part</th>';
        procs.forEach(function(p) {
            thead += `<th style="min-width:170px; background:#f1f5f9; text-align:center;">${p.name}</th>`;
        });
        thead += '<th style="width:50px; text-align:center; background:#f1f5f9;">Action</th>';
        $('#matrixHeaderRow').html(thead);

        var tbody = '';
        var assignmentIdx = 0;

        componentsList.forEach(function(comp) {
            var icon = '🧵';
            var clow = comp.toLowerCase();
            if (clow.includes('chaniya') || clow.includes('lehenga')) icon = '👗';
            else if (clow.includes('choli') || clow.includes('blouse')) icon = '👚';
            else if (clow.includes('dupatta') || clow.includes('chunri')) icon = '🧣';
            else if (clow.includes('jacket') || clow.includes('shrug')) icon = '🧥';
            else if (clow.includes('belt')) icon = '🎗️';
            else if (clow.includes('inner') || clow.includes('lining')) icon = '🩱';

            tbody += `<tr>
                <td class="fw-bold text-dark" style="white-space:nowrap; vertical-align:middle;">
                    <span class="me-1">${icon}</span> ${comp}
                </td>`;

            procs.forEach(function(p) {
                var key = comp + '___' + p.name;
                var val = matrixState[key] || { vendorId: '', rate: '' };

                var options = '<option value="">— In-house / None —</option>';
                allVendors.forEach(function(v) {
                    var sel = (val.vendorId && String(val.vendorId) === String(v.id)) ? 'selected' : '';
                    options += `<option value="${v.id}" ${sel}>${v.name}</option>`;
                });

                tbody += `
                    <td class="p-2">
                        <select name="ComponentAssignments[${assignmentIdx}].VendorId" class="form-select form-select-sm matrix-vendor-select" data-comp="${comp}" data-proc="${p.name}">
                            ${options}
                        </select>
                        <div class="input-group input-group-sm mt-1">
                            <span class="input-group-text py-0 px-1 text-muted" style="font-size:0.7rem;">₹</span>
                            <input type="number" step="0.01" min="0" name="ComponentAssignments[${assignmentIdx}].EstimatedRate" value="${val.rate || ''}" placeholder="Est. Rate" class="form-control form-control-sm py-0 matrix-rate-input" data-comp="${comp}" data-proc="${p.name}" style="font-size:0.75rem;" />
                        </div>
                        <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ComponentName" value="${comp}" />
                        <input type="hidden" name="ComponentAssignments[${assignmentIdx}].ProcessName" value="${p.name}" />
                    </td>
                `;
                assignmentIdx++;
            });

            tbody += `
                <td class="text-center" style="vertical-align:middle;">
                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 remove-component-btn" data-name="${comp}" title="Remove ${comp}">
                        🗑️
                    </button>
                </td>
            </tr>`;
        });

        if (componentsList.length === 0) {
            tbody = `<tr><td colspan="${procs.length + 2}" class="text-center text-muted py-4">No components defined yet. Click a quick add button or type a component name above.</td></tr>`;
        }

        $('#matrixTableBody').html(tbody);
        syncLegacyWorkerFallbacks();
    }

    function syncLegacyWorkerFallbacks() {
        var hwVendor = '';
        var stVendor = '';
        var hasHwCholi = false;
        var hasHwChaniya = false;
        var hasHwDupatta = false;

        Object.keys(matrixState).forEach(function(key) {
            var parts = key.split('___');
            var c = parts[0];
            var p = parts[1];
            var entry = matrixState[key];
            if (entry && entry.vendorId) {
                if (p.toLowerCase().includes('handwork')) {
                    if (!hwVendor) hwVendor = entry.vendorId;
                    if (c.toLowerCase().includes('choli')) hasHwCholi = true;
                    if (c.toLowerCase().includes('chaniya') || c.toLowerCase().includes('lehenga')) hasHwChaniya = true;
                    if (c.toLowerCase().includes('dupatta')) hasHwDupatta = true;
                }
                if (p.toLowerCase().includes('stitching') && !stVendor) {
                    stVendor = entry.vendorId;
                }
            }
        });

        $('#fallbackHandworkWorkerId').val(hwVendor);
        $('#fallbackStitchingWorkerId').val(stVendor);
        $('#fallbackHwCholi').val(hasHwCholi ? 'true' : 'false');
        $('#fallbackHwChaniya').val(hasHwChaniya ? 'true' : 'false');
        $('#fallbackHwDupatta').val(hasHwDupatta ? 'true' : 'false');
    }

    $(document).on('change', '.matrix-vendor-select', function() {
        var comp = $(this).data('comp');
        var proc = $(this).data('proc');
        var key = comp + '___' + proc;
        if (!matrixState[key]) matrixState[key] = {};
        matrixState[key].vendorId = $(this).val();
        syncLegacyWorkerFallbacks();
    });

    $(document).on('input', '.matrix-rate-input', function() {
        var comp = $(this).data('comp');
        var proc = $(this).data('proc');
        var key = comp + '___' + proc;
        if (!matrixState[key]) matrixState[key] = {};
        matrixState[key].rate = $(this).val();
    });

    function addComponent(name) {
        name = (name || '').trim();
        if (!name) return;
        if (!componentsList.some(function(c) { return c.toLowerCase() === name.toLowerCase(); })) {
            componentsList.push(name);
            renderComponentBadges();
            renderMatrixTable();
        }
    }

    function removeComponent(name) {
        componentsList = componentsList.filter(function(c) { return c.toLowerCase() !== name.toLowerCase(); });
        Object.keys(matrixState).forEach(function(k) {
            if (k.startsWith(name + '___')) delete matrixState[k];
        });
        renderComponentBadges();
        renderMatrixTable();
    }

    $(document).on('click', '.quick-add-comp-btn', function() {
        var name = $(this).data('name');
        addComponent(name);
    });

    $('#btnAddCustomComponent').on('click', function() {
        var name = $('#customComponentInput').val();
        if (name) {
            addComponent(name);
            $('#customComponentInput').val('');
        }
    });

    $('#customComponentInput').on('keypress', function(e) {
        if (e.which === 13) {
            e.preventDefault();
            $('#btnAddCustomComponent').click();
        }
    });

    $(document).on('click', '.remove-component-btn', function() {
        var name = $(this).data('name');
        removeComponent(name);
    });

    // ===== CREATION FLOW (PROCESS MASTER) HANDLERS =====
    function updateCreationFlowFromMaster() {
        var checkedSteps = [];
        $('.process-step-checkbox:checked').each(function() {
            checkedSteps.push({
                id: $(this).data('id'),
                name: $(this).data('name'),
                code: $(this).data('code'),
                order: parseInt($(this).data('order') || 0)
            });
        });

        // Always sort strictly by the master sequence order!
        checkedSteps.sort(function(a, b) {
            return a.order - b.order;
        });

        var names = checkedSteps.map(function(s) { return s.name; });
        var flowString = names.join(' → ');
        $('#creationFlowInput').val(flowString);

        $('#processStepCountBadge').text(checkedSteps.length + (checkedSteps.length === 1 ? ' Step' : ' Steps'));

        var pipelineHtml = '';
        if (checkedSteps.length > 0) {
            checkedSteps.forEach(function(step, idx) {
                pipelineHtml += `
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2">
                            <span class="badge bg-white text-primary rounded-circle" style="width:18px;height:18px;padding:0;display:inline-flex;align-items:center;justify-content:center;font-size:0.75rem;">${step.order}</span>
                            ${step.name}
                            ${step.code ? `<small class="text-white-50">(${step.code})</small>` : ''}
                        </span>
                        ${idx < checkedSteps.length - 1 ? '<span class="text-muted fw-bold fs-5">➔</span>' : ''}
                    </div>`;
            });
        } else {
            pipelineHtml = '<span class="text-muted small fst-italic py-1">No process steps selected. Check one or more steps above to define the creation flow.</span>';
        }
        $('#creationFlowPipeline').html(pipelineHtml);
        renderMatrixTable();
    }

    $(document).on('change', '.process-step-checkbox', function() {
        updateCreationFlowFromMaster();
    });

    $('#btnSelectAllProcesses').on('click', function() {
        $('.process-step-checkbox').prop('checked', true);
        updateCreationFlowFromMaster();
    });

    $('#btnClearProcesses').on('click', function() {
        $('.process-step-checkbox').prop('checked', false);
        updateCreationFlowFromMaster();
    });

    // Initialize creation flow and component matrix on page load
    renderComponentBadges();
    updateCreationFlowFromMaster();
    </script>
}
