@model AashanaFashion.Models.Design
@{
    ViewData["Title"] = $"BOM & Costing — {Model.DesignNumber}";
    var rawMaterials = ViewBag.RawMaterials as List<AashanaFashion.Models.RawMaterial> ?? new();
    var vendors = ViewBag.Vendors as List<AashanaFashion.Models.Vendor> ?? new();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="page-back"><i class="bi bi-arrow-left"></i> Products</a>
        <h1 class="page-title">Bill of Materials &amp; Garment Costing</h1>
        <p class="page-sub">Design <strong class="text-foreground">@Model.DesignNumber</strong>@(string.IsNullOrEmpty(Model.Category) ? "" : $" · {Model.Category}")</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Edit design info</a>
    </div>
</div>

<form asp-action="Bom" asp-route-id="@Model.Id" method="post" id="bomForm">
    @Html.AntiForgeryToken()

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-label">Material cost / pc</div>
            <div class="metric-value" id="kpiMaterialCost">₹@Model.TotalMaterialCost.ToString("N2")</div>
            <div class="metric-meta">Fabrics, linings &amp; trims</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Labor &amp; job-work / pc</div>
            <div class="metric-value" id="kpiLaborCost">₹@Model.TotalLaborCost.ToString("N2")</div>
            <div class="metric-meta">Dying, handwork, stitching</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Total production cost</div>
            <div class="metric-value" id="kpiTotalCost">₹@Model.TotalProductionCost.ToString("N2")</div>
            <div class="metric-meta">COGS per garment piece</div>
        </div>
        <div class="metric-card">
            <label class="metric-label" for="salesPriceInput">Selling price</label>
            <div class="input-group mt-1" style="max-width: 170px;">
                <span class="input-group-text">₹</span>
                <input type="number" step="0.01" min="0" name="SalesPrice" id="salesPriceInput" class="af-input fw-semibold tabular" value="@Model.SalesPrice" />
            </div>
            <div class="metric-meta mt-1">Standard retail / wholesale</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Estimated profit margin</div>
            <div class="metric-value @(Model.GrossProfitMargin < 0 ? "text-danger" : "")" id="kpiMargin">
                ₹@Model.GrossProfitMargin.ToString("N2")
                <span class="metric-suffix" id="kpiMarginPct">(@Model.GrossProfitMarginPercent.ToString("N1")%)</span>
            </div>
            <div class="metric-meta">Per piece markup</div>
        </div>
    </div>

    <!-- 1. Bill of Materials (Raw Materials Recipe) -->
    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <span class="data-card-title">Raw materials consumption (BOM)</span>
                <span class="data-card-sub d-block">Fabrics, trims and components consumed per single piece</span>
            </div>
            <button type="button" id="addBomRowBtn" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> Add material line</button>
        </div>
        <div class="table-scroll">
            <table class="af-table table-edit" id="bomTable" style="min-width: 900px;">
                <thead>
                    <tr>
                        <th style="width: 140px;">Component</th>
                        <th style="min-width: 220px;">Raw Material <span class="req">*</span></th>
                        <th style="width: 110px;" class="text-end">Consumption <span class="req">*</span></th>
                        <th style="width: 80px;" class="text-center">Unit</th>
                        <th style="width: 90px;" class="text-end">Wastage %</th>
                        <th style="width: 100px;" class="text-end">Rate (₹)</th>
                        <th style="width: 110px;" class="text-end">Cost / pc (₹)</th>
                        <th style="min-width: 120px;">Remarks</th>
                        <th style="width: 48px;"></th>
                    </tr>
                </thead>
                <tbody id="bomBody">
                    @if (Model.BomItems.Any())
                    {
                        var bi = 0;
                        foreach (var b in Model.BomItems)
                        {
                            var rate = b.RawMaterial?.Rate ?? 0;
                            var lineCost = b.EffectiveQuantity * rate;
                            <tr class="bom-row">
                                <td>
                                    <select name="BomItems[@bi].Component" class="af-input af-select af-input-sm">
                                        <option value="Chaniya" selected="@(b.Component == "Chaniya" ? "selected" : null)">Chaniya</option>
                                        <option value="Choli" selected="@(b.Component == "Choli" ? "selected" : null)">Choli</option>
                                        <option value="Dupatta" selected="@(b.Component == "Dupatta" ? "selected" : null)">Dupatta</option>
                                        <option value="Blouse" selected="@(b.Component == "Blouse" ? "selected" : null)">Blouse</option>
                                        <option value="Lining" selected="@(b.Component == "Lining" ? "selected" : null)">Lining</option>
                                        <option value="Trims / Lace" selected="@(b.Component == "Trims / Lace" ? "selected" : null)">Trims / Lace</option>
                                        <option value="General" selected="@(b.Component == "General" ? "selected" : null)">General</option>
                                    </select>
                                </td>
                                <td>
                                    <select name="BomItems[@bi].RawMaterialId" class="af-input af-select af-input-sm bom-material-select" required>
                                        <option value="">— Select Material —</option>
                                        @foreach (var rm in rawMaterials)
                                        {
                                            <option value="@rm.Id" data-unit="@rm.Unit" data-rate="@rm.Rate" selected="@(rm.Id == b.RawMaterialId ? "selected" : null)">
                                                @rm.Name (₹@rm.Rate / @rm.Unit)
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0.01" name="BomItems[@bi].QuantityPerPiece" class="af-input af-input-sm text-end bom-qty" value="@b.QuantityPerPiece" required />
                                </td>
                                <td class="text-center text-muted bom-unit">@(b.RawMaterial?.Unit ?? "—")</td>
                                <td>
                                    <input type="number" step="0.5" min="0" max="100" name="BomItems[@bi].WastagePercentage" class="af-input af-input-sm text-end bom-wastage" value="@b.WastagePercentage" />
                                </td>
                                <td class="cell-num text-muted bom-rate">₹@rate.ToString("N2")</td>
                                <td class="cell-num text-foreground fw-semibold bom-line-cost">₹@lineCost.ToString("N2")</td>
                                <td>
                                    <input type="text" name="BomItems[@bi].Remarks" class="af-input af-input-sm" value="@b.Remarks" placeholder="Color / placement" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="row-action danger remove-bom-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            bi++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. Operation Costs (Job-Work & Labor) -->
    <div class="data-card mb-4">
        <div class="data-card-header">
            <div>
                <span class="data-card-title">Labor &amp; job-work operations</span>
                <span class="data-card-sub d-block">Estimated processing rates per single piece</span>
            </div>
            <button type="button" id="addOpRowBtn" class="btn btn-sm btn-secondary"><i class="bi bi-plus-lg"></i> Add operation</button>
        </div>
        <div class="table-scroll">
            <table class="af-table table-edit" id="opTable" style="min-width: 800px;">
                <thead>
                    <tr>
                        <th style="width: 220px;">Operation / Step <span class="req">*</span></th>
                        <th style="width: 140px;" class="text-end">Cost / pc (₹) <span class="req">*</span></th>
                        <th style="width: 220px;">Default Vendor (optional)</th>
                        <th>Process Notes</th>
                        <th style="width: 48px;"></th>
                    </tr>
                </thead>
                <tbody id="opBody">
                    @if (Model.OperationCosts.Any())
                    {
                        var oi = 0;
                        foreach (var o in Model.OperationCosts)
                        {
                            <tr class="op-row">
                                <td>
                                    <select name="OperationCosts[@oi].OperationName" class="af-input af-select af-input-sm">
                                        <option value="Dying" selected="@(o.OperationName == "Dying" ? "selected" : null)">Dying</option>
                                        <option value="Roll Press" selected="@(o.OperationName == "Roll Press" ? "selected" : null)">Roll Press</option>
                                        <option value="Handwork" selected="@(o.OperationName == "Handwork" ? "selected" : null)">Handwork / Embroidery</option>
                                        <option value="Stitching" selected="@(o.OperationName == "Stitching" ? "selected" : null)">Stitching</option>
                                        <option value="Finishing & Ironing" selected="@(o.OperationName == "Finishing & Ironing" ? "selected" : null)">Finishing & Ironing</option>
                                        <option value="Packing" selected="@(o.OperationName == "Packing" ? "selected" : null)">Packing</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" name="OperationCosts[@oi].EstimatedCost" class="af-input af-input-sm text-end op-cost" value="@o.EstimatedCost" required />
                                </td>
                                <td>
                                    <select name="OperationCosts[@oi].VendorId" class="af-input af-select af-input-sm">
                                        <option value="">— No Default Vendor —</option>
                                        @foreach (var v in vendors)
                                        {
                                            <option value="@v.Id" selected="@(v.Id == o.VendorId ? "selected" : null)">
                                                @v.VendorName
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="text" name="OperationCosts[@oi].Remarks" class="af-input af-input-sm" value="@o.Remarks" placeholder="Rate details or special requirements" />
                                </td>
                                <td class="text-center">
                                    <button type="button" class="row-action danger remove-op-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                            oi++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save BOM &amp; cost sheet</button>
    </div>
</form>

<!-- Raw Material Options Template for JS -->
<template id="materialOptionsTemplate">
    <option value="">— Select Material —</option>
    @foreach (var rm in rawMaterials)
    {
        <option value="@rm.Id" data-unit="@rm.Unit" data-rate="@rm.Rate">
            @rm.Name (₹@rm.Rate / @rm.Unit)
        </option>
    }
</template>

<template id="vendorOptionsTemplate">
    <option value="">— No Default Vendor —</option>
    @foreach (var v in vendors)
    {
        <option value="@v.Id">@v.VendorName</option>
    }
</template>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const bomBody = document.getElementById('bomBody');
    const opBody = document.getElementById('opBody');
    const addBomBtn = document.getElementById('addBomRowBtn');
    const addOpBtn = document.getElementById('addOpRowBtn');
    const salesPriceInput = document.getElementById('salesPriceInput');

    const kpiMaterial = document.getElementById('kpiMaterialCost');
    const kpiLabor = document.getElementById('kpiLaborCost');
    const kpiTotal = document.getElementById('kpiTotalCost');
    const kpiMargin = document.getElementById('kpiMargin');

    const materialOptions = document.getElementById('materialOptionsTemplate').innerHTML;
    const vendorOptions = document.getElementById('vendorOptionsTemplate').innerHTML;

    function fmt(val) {
        return '₹' + Number(val || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function reindexBom() {
        const rows = bomBody.querySelectorAll('.bom-row');
        rows.forEach((row, idx) => {
            row.querySelectorAll('select, input').forEach(el => {
                const name = el.getAttribute('name');
                if (name) el.setAttribute('name', name.replace(/\[\d+\]/, '[' + idx + ']'));
            });
        });
    }

    function reindexOp() {
        const rows = opBody.querySelectorAll('.op-row');
        rows.forEach((row, idx) => {
            row.querySelectorAll('select, input').forEach(el => {
                const name = el.getAttribute('name');
                if (name) el.setAttribute('name', name.replace(/\[\d+\]/, '[' + idx + ']'));
            });
        });
    }

    function recalculate() {
        let totalMaterial = 0;
        let totalLabor = 0;

        bomBody.querySelectorAll('.bom-row').forEach(row => {
            const select = row.querySelector('.bom-material-select');
            const qtyInput = row.querySelector('.bom-qty');
            const wastageInput = row.querySelector('.bom-wastage');
            const unitEl = row.querySelector('.bom-unit');
            const rateEl = row.querySelector('.bom-rate');
            const costEl = row.querySelector('.bom-line-cost');

            const opt = select?.selectedOptions[0];
            const rate = parseFloat(opt?.getAttribute('data-rate')) || 0;
            const unit = opt?.getAttribute('data-unit') || '—';
            const qty = parseFloat(qtyInput?.value) || 0;
            const wastage = parseFloat(wastageInput?.value) || 0;

            if (unitEl) unitEl.textContent = unit;
            if (rateEl) rateEl.textContent = fmt(rate);

            const effectiveQty = qty * (1 + (wastage / 100));
            const lineCost = effectiveQty * rate;
            if (costEl) costEl.textContent = fmt(lineCost);

            totalMaterial += lineCost;
        });

        opBody.querySelectorAll('.op-row').forEach(row => {
            const costInput = row.querySelector('.op-cost');
            const cost = parseFloat(costInput?.value) || 0;
            totalLabor += cost;
        });

        const totalCost = totalMaterial + totalLabor;
        const salesPrice = parseFloat(salesPriceInput?.value) || 0;
        const margin = salesPrice - totalCost;
        const marginPct = salesPrice > 0 ? (margin / salesPrice) * 100 : 0;

        if (kpiMaterial) kpiMaterial.textContent = fmt(totalMaterial);
        if (kpiLabor) kpiLabor.textContent = fmt(totalLabor);
        if (kpiTotal) kpiTotal.textContent = fmt(totalCost);
        if (kpiMargin) {
            kpiMargin.innerHTML = fmt(margin) + ' <span class="metric-suffix" id="kpiMarginPct">(' + marginPct.toFixed(1) + '%)</span>';
            kpiMargin.classList.toggle('text-danger', margin < 0);
        }
    }

    function bindBomRow(row) {
        row.querySelector('.bom-material-select')?.addEventListener('change', recalculate);
        row.querySelector('.bom-qty')?.addEventListener('input', recalculate);
        row.querySelector('.bom-wastage')?.addEventListener('input', recalculate);
        row.querySelector('.remove-bom-row')?.addEventListener('click', function () {
            row.remove();
            reindexBom();
            recalculate();
        });
    }

    function bindOpRow(row) {
        row.querySelector('.op-cost')?.addEventListener('input', recalculate);
        row.querySelector('.remove-op-row')?.addEventListener('click', function () {
            row.remove();
            reindexOp();
            recalculate();
        });
    }

    addBomBtn?.addEventListener('click', function () {
        const idx = bomBody.querySelectorAll('.bom-row').length;
        const tr = document.createElement('tr');
        tr.className = 'bom-row';
        tr.innerHTML = `
            <td>
                <select name="BomItems[${idx}].Component" class="af-input af-select af-input-sm">
                    <option value="Chaniya">Chaniya</option>
                    <option value="Choli">Choli</option>
                    <option value="Dupatta">Dupatta</option>
                    <option value="Blouse">Blouse</option>
                    <option value="Lining">Lining</option>
                    <option value="Trims / Lace">Trims / Lace</option>
                    <option value="General" selected>General</option>
                </select>
            </td>
            <td>
                <select name="BomItems[${idx}].RawMaterialId" class="af-input af-select af-input-sm bom-material-select" required>
                    ${materialOptions}
                </select>
            </td>
            <td>
                <input type="number" step="0.01" min="0.01" name="BomItems[${idx}].QuantityPerPiece" class="af-input af-input-sm text-end bom-qty" value="1.00" required />
            </td>
            <td class="text-center text-muted bom-unit">—</td>
            <td>
                <input type="number" step="0.5" min="0" max="100" name="BomItems[${idx}].WastagePercentage" class="af-input af-input-sm text-end bom-wastage" value="0" />
            </td>
            <td class="cell-num text-muted bom-rate">₹0.00</td>
            <td class="cell-num text-foreground fw-semibold bom-line-cost">₹0.00</td>
            <td>
                <input type="text" name="BomItems[${idx}].Remarks" class="af-input af-input-sm" placeholder="Color / placement" />
            </td>
            <td class="text-center">
                <button type="button" class="row-action danger remove-bom-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
            </td>
        `;
        bomBody.appendChild(tr);
        bindBomRow(tr);
        reindexBom();
    });

    addOpBtn?.addEventListener('click', function () {
        const idx = opBody.querySelectorAll('.op-row').length;
        const tr = document.createElement('tr');
        tr.className = 'op-row';
        tr.innerHTML = `
            <td>
                <select name="OperationCosts[${idx}].OperationName" class="af-input af-select af-input-sm">
                    <option value="Dying">Dying</option>
                    <option value="Roll Press">Roll Press</option>
                    <option value="Handwork">Handwork / Embroidery</option>
                    <option value="Stitching" selected>Stitching</option>
                    <option value="Finishing & Ironing">Finishing & Ironing</option>
                    <option value="Packing">Packing</option>
                </select>
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="OperationCosts[${idx}].EstimatedCost" class="af-input af-input-sm text-end op-cost" value="0.00" required />
            </td>
            <td>
                <select name="OperationCosts[${idx}].VendorId" class="af-input af-select af-input-sm">
                    ${vendorOptions}
                </select>
            </td>
            <td>
                <input type="text" name="OperationCosts[${idx}].Remarks" class="af-input af-input-sm" placeholder="Rate details or special requirements" />
            </td>
            <td class="text-center">
                <button type="button" class="row-action danger remove-op-row" title="Remove" aria-label="Remove"><i class="bi bi-trash"></i></button>
            </td>
        `;
        opBody.appendChild(tr);
        bindOpRow(tr);
        reindexOp();
    });

    bomBody.querySelectorAll('.bom-row').forEach(bindBomRow);
    opBody.querySelectorAll('.op-row').forEach(bindOpRow);
    salesPriceInput?.addEventListener('input', recalculate);

    // Initial check
    if (bomBody.querySelectorAll('.bom-row').length === 0) {
        addBomBtn?.click();
    }
    if (opBody.querySelectorAll('.op-row').length === 0) {
        addOpBtn?.click();
    }
    recalculate();
});
</script>
