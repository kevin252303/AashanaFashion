@model IEnumerable<AashanaFashion.Models.Design>
@{
    ViewData["Title"] = "Product Master";
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    bool isAdmin   = role == "Admin" || role == "SuperAdmin";
    bool canCreate = isAdmin || User.HasClaim("Permission.DesignMaster.CanCreate", "true");
    bool canEdit   = isAdmin || User.HasClaim("Permission.DesignMaster.CanEdit",   "true");
    bool canDelete = isAdmin || User.HasClaim("Permission.DesignMaster.CanDelete", "true");
    bool filtered  = !string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.SelectedCompanyId != null || ViewBag.SelectedCategoryId != null
                     || !string.IsNullOrEmpty(ViewBag.SelectedProductType as string) || ViewBag.ActiveOnly == true || ViewBag.ShowDiscontinued == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Product Master</h1>
        <p class="page-sub">Manage all products, variants, pricing and creation flow</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Archive" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-archive"></i> Archive
            @if (ViewBag.ArchivedCount != null && (int)ViewBag.ArchivedCount > 0)
            {
                <span class="count-pill">@ViewBag.ArchivedCount</span>
            }
        </a>
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Product</a>
        }
    </div>
</div>

<div class="table-card">
    <form method="get" asp-action="Index" class="table-toolbar">
        <div class="toolbar-filters">
            <div class="search-field">
                <i class="bi bi-search"></i>
                <input type="text" name="search" class="af-input" placeholder="Search design no, common no, colours…" value="@ViewBag.Search" />
            </div>
            <select name="companyId" class="af-input af-select" title="Filter products by company">
                <option value="">Active + shared</option>
                <option value="0" selected="@(ViewBag.SelectedCompanyId != null && (int)ViewBag.SelectedCompanyId == 0 ? "selected" : null)">All companies</option>
                <option value="-1" selected="@(ViewBag.SelectedCompanyId != null && (int)ViewBag.SelectedCompanyId == -1 ? "selected" : null)">Shared only</option>
                @if (ViewBag.Companies != null)
                {
                    foreach (var comp in (List<AashanaFashion.Models.Company>)ViewBag.Companies)
                    {
                        <option value="@comp.Id" selected="@(ViewBag.SelectedCompanyId != null && (int)ViewBag.SelectedCompanyId == comp.Id ? "selected" : null)">@comp.CompanyName (@comp.CompanyCode)</option>
                    }
                }
            </select>
            <select name="categoryId" class="af-input af-select">
                <option value="">All categories</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var c in (List<AashanaFashion.Models.ProductCategory>)ViewBag.Categories)
                    {
                        <option value="@c.Id" selected="@(ViewBag.SelectedCategoryId != null && (int)ViewBag.SelectedCategoryId == c.Id ? "selected" : null)">@c.CategoryName</option>
                    }
                }
            </select>
            <select name="productType" class="af-input af-select">
                <option value="">All types</option>
                <option value="Storable Product" selected="@(ViewBag.SelectedProductType == "Storable Product" ? "selected" : null)">Storable</option>
                <option value="Service" selected="@(ViewBag.SelectedProductType == "Service" ? "selected" : null)">Service</option>
                <option value="Consumable" selected="@(ViewBag.SelectedProductType == "Consumable" ? "selected" : null)">Consumable</option>
            </select>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="activeOnly" value="true" id="activeOnlyCheck" @(ViewBag.ActiveOnly == true ? "checked" : "") />
                <label class="form-check-label" for="activeOnlyCheck">Active</label>
            </div>
            <div class="form-check m-0">
                <input class="form-check-input" type="checkbox" name="showDiscontinued" value="true" id="showDiscontinuedCheck" @(ViewBag.ShowDiscontinued == true ? "checked" : "") />
                <label class="form-check-label" for="showDiscontinuedCheck">Discontinued</label>
            </div>
        </div>
        <div class="toolbar-actions">
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-ghost">Clear</a>
            }
            <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filter</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <div class="table-scroll">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width: 64px;">Photo</th>
                        <th>Design</th>
                        <th>Type</th>
                        <th class="text-end">Sales Price</th>
                        <th>Category</th>
                        <th>Colours</th>
                        <th>Sizes</th>
                        <th>Creation Flow</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var primaryPhoto = !string.IsNullOrEmpty(item.PhotoPath) ? item.PhotoPath : item.ColourImages?.FirstOrDefault()?.PhotoPath;
                        var colourListJson = System.Text.Json.JsonSerializer.Serialize(
                            (item.ColourImages ?? new List<AashanaFashion.Models.DesignColourImage>()).Select(ci => new { colour = ci.Colour, code = ci.ColourCode, photoPath = ci.PhotoPath })
                        );
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(primaryPhoto))
                                {
                                    <div class="position-relative d-inline-block">
                                        <img src="@primaryPhoto" alt="@item.DesignNumber" class="thumb cursor-pointer" onclick='previewColourGallery("@item.DesignNumber", @Html.Raw(colourListJson), "@primaryPhoto")' onerror="this.onerror=null;this.src='/images/placeholder-product.svg';" title="Click to view colour photos" />
                                        @if (item.ColourImages?.Count > 1)
                                        {
                                            <span class="thumb-count" title="@item.ColourImages.Count colour photos">@item.ColourImages.Count</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="thumb d-flex align-items-center justify-content-center text-placeholder" title="No photo"><i class="bi bi-image"></i></div>
                                }
                            </td>
                            <td>
                                @if (canEdit)
                                {
                                    <span class="cell-title ctx-trigger link-trigger"
                                          data-id="@item.Id"
                                          data-edit="@Url.Action("Edit", "Design", new { id = item.Id })"
                                          data-can-delete="@canDelete.ToString().ToLower()">@item.DesignNumber</span>
                                }
                                else
                                {
                                    <span class="cell-title">@item.DesignNumber</span>
                                }
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (item.CompanyRef != null)
                                    {
                                        <span class="af-badge b-indigo" title="Belongs strictly to @item.CompanyRef.CompanyName"><i class="bi bi-building"></i> @item.CompanyRef.CompanyCode</span>
                                    }
                                    else
                                    {
                                        <span class="af-badge b-gray" title="Shared product — available in all companies"><i class="bi bi-globe"></i> All companies</span>
                                    }

                                    @if (item.Discontinued)
                                    {
                                        <span class="af-badge b-red" title="Discontinued whole product">Discontinued</span>
                                    }
                                    else if (item.DiscontinuedVariants?.Any() == true)
                                    {
                                        <span class="af-badge b-yellow" title="@string.Join(", ", item.DiscontinuedVariants.Select(v => $"{(string.IsNullOrEmpty(v.Colour) ? "All Colours" : v.Colour)}/{(string.IsNullOrEmpty(v.Size) ? "All Sizes" : v.Size)}"))">
                                            @item.DiscontinuedVariants.Count variant@(item.DiscontinuedVariants.Count > 1 ? "s" : "") discontinued
                                        </span>
                                    }
                                </div>
                            </td>
                            <td><span class="af-badge b-blue">@item.ProductType</span></td>
                            <td class="cell-num">
                                <span class="text-foreground">₹@item.SalesPrice.ToString("N2")</span>
                                @if (item.ExtraCharges?.Any() == true)
                                {
                                    <span class="cell-sub" title="@item.ExtraCharges.Count variant charge(s) configured">+@item.ExtraCharges.Count surcharge@(item.ExtraCharges.Count > 1 ? "s" : "")</span>
                                }
                            </td>
                            <td>
                                @if (item.ProductCategory != null)
                                {
                                    <span class="tag">@item.ProductCategory.CategoryName</span>
                                }
                                else if (!string.IsNullOrEmpty(item.Category))
                                {
                                    <span class="tag">@item.Category</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                            </td>
                            <td>@item.Colours</td>
                            <td>@item.Sizes</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CreationFlow))
                                {
                                    <span class="text-foreground">@item.CreationFlow</span>
                                }
                                else
                                {
                                    <span class="text-placeholder">—</span>
                                }
                                @if (item.StitchingWorker != null)
                                {
                                    <span class="cell-sub text-nowrap">Stitch: <strong>@item.StitchingWorker.VendorName</strong></span>
                                }
                                @if (item.HandworkWorker != null)
                                {
                                    <span class="cell-sub text-nowrap">Hand: <strong>@item.HandworkWorker.VendorName</strong> (@item.HandworkComponentsSummary)</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <div class="row-actions">
                                    <a asp-action="Bom" asp-route-id="@item.Id" class="btn btn-sm btn-secondary me-1" title="Bill of materials &amp; costing">BOM</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="row-action" title="Edit" aria-label="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="ToggleDiscontinued" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="row-action @(item.Discontinued ? "success" : "warning")" title="@(item.Discontinued ? "Restore product to active" : "Archive product")" aria-label="@(item.Discontinued ? "Restore" : "Archive")" onclick="return confirm('@(item.Discontinued ? "Restore this product to active list?" : "Discontinue and move this product to Archive?")')">
                                            <i class="bi @(item.Discontinued ? "bi-arrow-counterclockwise" : "bi-archive")"></i>
                                        </button>
                                    </form>
                                    @if (canDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action danger" onclick="return confirm('Delete this product?')" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "product" : "products")</span>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="es-icon"><i class="bi @(filtered ? "bi-search" : "bi-box-seam")"></i></div>
            <div class="es-title">@(filtered ? "No results found" : "No products yet")</div>
            <p>@(filtered ? "No products match your filters. Try adjusting your search." : "Create your first product to start planning production.")</p>
            @if (filtered)
            {
                <a asp-action="Index" class="btn btn-secondary">Clear search</a>
            }
            else if (canCreate)
            {
                <a asp-action="Create" class="btn btn-secondary">New Product</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var menu = document.getElementById('ctxMenu');
        var ctxEdit = document.getElementById('ctxEdit');
        var ctxDeleteForm = document.getElementById('ctxDeleteForm');

        document.querySelectorAll('.ctx-trigger').forEach(function (el) {
            el.addEventListener('click', function (e) {
                e.stopPropagation();
                var canDel = el.dataset.canDelete === 'true';
                ctxEdit.href = el.dataset.edit;
                if (canDel) {
                    ctxDeleteForm.action = '/Design/Delete/' + el.dataset.id;
                    document.getElementById('ctxDeleteItem').style.display = 'block';
                    document.getElementById('ctxDelete').onclick = function (ev) {
                        ev.preventDefault();
                        if (confirm('Delete this product?')) ctxDeleteForm.submit();
                        hideMenu();
                    };
                } else {
                    document.getElementById('ctxDeleteItem').style.display = 'none';
                }
                menu.style.display = 'block';
                menu.style.left = e.clientX + 'px';
                menu.style.top = e.clientY + 'px';
            });
        });

        document.addEventListener('click', hideMenu);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideMenu(); });

        function hideMenu() { menu.style.display = 'none'; }

        window.previewImage = function(url, title) {
            document.getElementById('modalPreviewImg').src = url;
            document.getElementById('modalImageTitle').innerText = title;
            document.getElementById('modalGalleryFooter').style.display = 'none';
            new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
        };

        window.previewColourGallery = function(designNumber, colourImages, fallbackUrl) {
            var titleEl = document.getElementById('modalImageTitle');
            var imgEl = document.getElementById('modalPreviewImg');
            var footerEl = document.getElementById('modalGalleryFooter');

            titleEl.innerText = designNumber;
            imgEl.src = fallbackUrl || '/images/placeholder-product.svg';

            if (colourImages && colourImages.length > 0) {
                var first = colourImages[0];
                titleEl.innerText = designNumber + ' — ' + first.colour;
                imgEl.src = first.photoPath;

                var colourTotal = {};
                colourImages.forEach(function(ci) {
                    colourTotal[ci.colour] = (colourTotal[ci.colour] || 0) + 1;
                });
                var colourCurrent = {};

                var html = '<div class="segmented flex-wrap justify-content-center">';
                colourImages.forEach(function(ci, idx) {
                    colourCurrent[ci.colour] = (colourCurrent[ci.colour] || 0) + 1;
                    var numSuffix = colourTotal[ci.colour] > 1 ? ' #' + colourCurrent[ci.colour] : '';
                    var label = ci.colour + numSuffix;
                    var dot = ci.code ? '<span class="swatch-dot" style="background-color:' + ci.code + ';"></span>' : '';
                    html += '<button type="button" class="segment ' + (idx === 0 ? 'active' : '') + '" onclick="selectGalleryPhoto(\'' + designNumber + '\', \'' + label + '\', \'' + ci.photoPath + '\', this)">' +
                        dot + label +
                    '</button>';
                });
                html += '</div>';
                footerEl.innerHTML = html;
                footerEl.style.display = 'flex';
            } else {
                footerEl.innerHTML = '';
                footerEl.style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
        };

        window.selectGalleryPhoto = function(designNumber, colourName, photoUrl, btn) {
            document.getElementById('modalPreviewImg').src = photoUrl;
            document.getElementById('modalImageTitle').innerText = designNumber + ' — ' + colourName;
            var buttons = document.querySelectorAll('#modalGalleryFooter button');
            buttons.forEach(function(b) { b.classList.remove('active'); });
            if (btn) btn.classList.add('active');
        };
    </script>
}

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalImageTitle">Product Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center bg-raised">
                <img id="modalPreviewImg" src="" class="img-fluid" style="max-height: 75vh;" alt="" />
            </div>
            <div class="modal-footer justify-content-center" id="modalGalleryFooter" style="display:none;"></div>
        </div>
    </div>
</div>

<!-- Context Menu -->
<ul id="ctxMenu" class="dropdown-menu" style="display:none; position:fixed; z-index:9999;">
    <li>
        <a id="ctxEdit" href="#" class="dropdown-item"><i class="bi bi-pencil"></i> Edit</a>
    </li>
    <li id="ctxDeleteItem">
        <hr class="dropdown-divider">
        <a id="ctxDelete" href="#" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</a>
    </li>
</ul>

<form id="ctxDeleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
